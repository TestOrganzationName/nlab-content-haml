                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/quantum+master+equation"} quantum master equation
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/Euler-Arnold+equation"} Euler-Arnold equation
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/Fuchsian+equation"} Fuchsian equation
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/Fokker-Planck+equation"} Fokker-Planck equation
                            %a.existingWikiWord{:href => "/nlab/show/Lax+equation"} Lax equation
                  %div
                    %p
                      %a{:href => "/nlab/edit/equality+and+equivalence+-+contents"} Edit this sidebar
          %h1#section_table_of_contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %li
                %a{:href => "#internalization"} Internalization
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The notion of
            %strong
              equivalence of
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
            is the appropriate notion of
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            between
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorifying
            the notion of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            %a.existingWikiWord{:href => "/nlab/show/pair"} pair
            of
            %a.existingWikiWord{:href => "/nlab/show/2-functors"} 2-functors
            back and forth between 2-categories, which are
            %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
            to each other, up to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pseudonatural+equivalence"} pseudonatural equivalence
          %h2#definition Definition
          %p
          #EquivalenceOf2Categories.num_defn
            %h6 Definition
            %p
              An
              %em equivalence
              between
              %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              consists of
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/2-functors"} 2-functors
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mspace{:width => "thickmathspace"}
                      %annotation{:encoding => "application/x-tex"} \;
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %mi 𝒞
                        %mo →
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} F \,\colon\, \mathcal{C} \to \mathcal{D}
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mspace{:width => "thinmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thinmathspace"}
                          %mi 𝒟
                          %mo →
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} G \,\colon\, \mathcal{D} \to \mathcal{C}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/pseudonatural+transformations"} pseudonatural transformations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                        %mspace{:width => "thickmathspace"}
                        %mi G
                        %mo ∘
                        %mi F
                        %mo →
                        %msub
                          %mi Id
                          %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} {}\;G \circ F \to Id_{\mathcal{C}}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo ∘
                        %mi G
                        %mo →
                        %msub
                          %mi Id
                          %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} F \circ G \to Id_{\mathcal{D}}
                  which are themselves
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              Def.
              %a.maruku-ref{:href => "#EquivalenceOf2Categories"}
              makes sense, and is used, both in the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/strict+2-functor"} strict
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+2-functor"} weak
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              should be allowed to be weak: see
              = succeed "." do
                %a{:href => "#Lack2002"} Lack 2002, Ex, 3.1
          %p
          .num_remark
            %h6 Remark
            %p
              In the literature this sort of equivalence in Def.
              %a.maruku-ref{:href => "#EquivalenceOf2Categories"}
              is often called a
              = succeed "," do
                %strong biequivalence
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bicategories"} bicategories
              = succeed "-category." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
            %p
              There is a stricter notion of equivalence for strict
              = succeed "-categories," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
                \-equivalence
              and which on the nLab is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/strict+2-equivalence"} strict 2-equivalence
          %h2#properties Properties
          %p
          #CharacterizationOfEquivalencesOf2Categories.num_prop
            %h6 Proposition
            %p
              %strong
                (recognition of
                %a.existingWikiWord{:href => "/nlab/show/equivalences+of+2-categories"} equivalences of 2-categories
                assuming the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              %br/
              Assuming the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒞
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F \,\colon\, \mathcal{C} \xrightarrow{\;} \mathcal{D}
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+2-categories"} equivalence of 2-categories
              precisely if it is
            %ol
              %li
                %p
                  %strong> essentially surjective
                  \:
                %p
                  %a.existingWikiWord{:href => "/nlab/show/surjection"} surjective
                  on
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+in+a+2-category"} equivalence
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} classes
                  of
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                          %mo ↠
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi 𝒟
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                        %annotation{:encoding => "application/x-tex"} \pi_0(F) \;\colon\; \pi_0(\mathcal{C}) \twoheadrightarrow \pi_0(\mathcal{D})\;
              %li
                %p
                  %strong fully faithful
                  (e.g.
                  = succeed "):" do
                    %a{:href => "#GabberRamero04"} Gabber &amp; Ramero 2004, Def. 2.4.9 (ii)
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                  of
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi Y
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} X,\, Y \in \mathcal{C}
                  the component functor is an
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of
                  %a.existingWikiWord{:href => "/nlab/show/hom-categories"} hom-categories
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi F
                            %mrow
                              %mi X
                              %mo ,
                              %mi Y
                          %mspace{:width => "thinmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thinmathspace"}
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo →
                            %mo ≃
                          %mi 𝒟
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %annotation{:encoding => "application/x-tex"} F_{X,Y} \,\colon\, \mathcal{C}(X,Y) \xrightarrow{\simeq} \mathcal{D}\big(F(X), F(Y)\big)
                %p
                  which by the analogous theorem for 1-functors (
                  %a{:href => "equivalence+of+categories#ViaEssentiallySurjectiveAndFullyFaithful"}> this Prop.
                  ) means equivalently that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is (e.g.
                  = succeed ")" do
                    %a{:href => "#JohnsonYau20"} Johnson &amp; Yau 2020, Def. 7.0.1
                %ol
                  %li
                    %p
                      %strong> essentially full on 1-cells
                      \:
                    %p
                      namely that each component functor
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi F
                              %mrow
                                %mi X
                                %mo ,
                                %mi Y
                          %annotation{:encoding => "application/x-tex"} F_{X,Y}
                      is an
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective functor
                  %li
                    %p
                      %strong> fully faithful on 2-cells
                      \:
                    %p
                      namely that each component functor
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi F
                              %mrow
                                %mi X
                                %mo ,
                                %mi Y
                          %annotation{:encoding => "application/x-tex"} F_{X,Y}
                      is a
                      = succeed "." do
                        %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
            %p
          %p
            This is classical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/folklore"} folklore
            = succeed ";" do
              %a{:href => "#GabberRamero04"} Gabber &amp; Ramero 2004, Cor. 2.4.30
            = succeed "." do
              %a{:href => "#JohnsonYau20"} Johnson &amp; Yau 2020, Thm. 7.4.1
          %h2#internalization Internalization
          %p
            Just as the notion of
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            can be
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internalized
            in any
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} 2 Cat
            of
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "-functors," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %p
            There is one warning to keep in mind here. Every
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
            %a.existingWikiWord{:href => "/nlab/show/semi-strict+n-category"} semi-strict
            sort of
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Gray-category"} Gray-category
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            over the monoidal category
            %a.existingWikiWord{:href => "/nlab/show/Gray"} Gray
            of strict
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "-functors." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Gray
                %annotation{:encoding => "application/x-tex"} Gray
            itself is a Gray-category, but as such it is
            %a{:href => "http://arxiv.org/abs/math/0612299"} not
            equivalent to the weak
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} 2 Cat
            of weak
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %em weak
            = succeed "-functors." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %p
            In particular, an “internal (bi)equivalence” in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Gray
                %annotation{:encoding => "application/x-tex"} Gray
            consists of
            %em strict
            = succeed "-functors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ,
                  %mi G
                %annotation{:encoding => "application/x-tex"} F,G
            together with pseudonatural equivalences relating
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi F
                %annotation{:encoding => "application/x-tex"} G F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mi G
                %annotation{:encoding => "application/x-tex"} F G
            to identities. This is a semistrict notion of equivalence, intermediate between the fully weak notion and the fully strict one.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equality"}> equality
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"}> weak equivalence
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence+of+toposes"} homotopy equivalence of toposes
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence in an (∞,1)-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"}> equivalence of categories
                ,
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            %li
              %p
                %strong> equivalence of 2-categories
                ,
                %a.existingWikiWord{:href => "/nlab/show/2-adjunction"} 2-adjunction
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%282%2C1%29-categories"} equivalence of (2,1)-categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"}> equivalence of (∞,1)-categories
                ,
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
          %div
            %p
              %strong basic properties of…
            %ul
              %li
                %p
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                %ul
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/full+functor"} full functor
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/injective-on-objects+functor"} injective-on-objects functor
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentially surjective functor
