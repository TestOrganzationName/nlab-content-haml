          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            is to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/terms"} terms
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/equalities"} equalities
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+type+theory"} equivalence in type theory
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
            = succeed "/" do
