                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo =
                            %mi B
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi{:mathvariant => "normal"} ap
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi x
                      %mo ,
                      %mi G
