          %h2#idea Idea
          %p
            The
            %em de Rham complex
            (named after
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Georges+de+Rham"} Georges de Rham
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(X)
            of a
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
            that in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            has the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            = succeed "s)" do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential+form"} Kähler differential form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            is the
            %strong de Rham differential
            or
            = succeed "." do
              %strong exterior derivative
          %p
            As
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            varies this constitutes an
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf"} abelian sheaf
            of complexes.
          %h2#definition Definition
          %h3#for_smooth_manifolds For smooth manifolds
          %p
            The
            %strong de Rham complex
            of a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            is the
            %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
            which in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            has the
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^n(X)
            of degree-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/exterior+derivative"} exterior derivative
          %p
            Explicitly, given a differential
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi ω
                %annotation{:encoding => "application/x-tex"} d\omega
            can be computed as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi v
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi i
                  %msub
                    %mi ℒ
                    %mrow
                      %msub
                        %mi v
                        %mi i
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi v
                    %mrow
                      %mi i
                      %mo −
                      %mn 1
                  %mo ,
                  %msub
                    %mi v
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi v
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo +
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo &lt;
                      %mi j
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo +
                      %mi j
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi v
                    %mi i
                  %mo ,
                  %msub
                    %mi v
                    %mi j
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %msub
                    %mi v
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi v
                    %mrow
                      %mi i
                      %mo −
                      %mn 1
                  %mo ,
                  %msub
                    %mi v
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi v
                    %mrow
                      %mi j
                      %mo −
                      %mn 1
                  %mo ,
                  %msub
                    %mi v
                    %mrow
                      %mi j
                      %mo +
                      %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi v
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} d\omega(v_0,\ldots,v_k)=\sum_i (-1)^i \mathcal{L}_{v_i} \omega(v_0,\ldots,v_{i-1},v_{i+1},\ldots,v_k)+\sum_{i\lt j}(-1)^{i+j}\omega([v_i,v_j],v_0,\ldots,v_{i-1},v_{i+1},\ldots,v_{j-1},v_{j+1},\ldots,v_k),
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi i
                %annotation{:encoding => "application/x-tex"} v_i
            are
            %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [-,-]
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+bracket+of+vector+fields"} Lie bracket of vector fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mi v
                %annotation{:encoding => "application/x-tex"} \mathcal{L}_{v}
            is the
            %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
            of a smooth function with respect to a vector field
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/chain+cohomology"} cohomology
            of the de Rham complex (hence the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of
            %a.existingWikiWord{:href => "/nlab/show/closed+differential+forms"} closed differential forms
            by
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/exact+differential+forms"} exact differential forms
            = succeed "." do
              %strong de Rham cohomology
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/wedge+product"} wedge product
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebra"} differential graded algebra
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The corresponding
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf"} abelian sheaf
            in this case defines a
            %a.existingWikiWord{:href => "/nlab/show/smooth+spectrum"} smooth spectrum
            via the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+Dold-Kan+correspondence"} stable Dold-Kan correspondence
            = succeed "." do
              %em
                %a{:href => "smooth+spectrum#ExamplesDeRhamSpectra"} smooth spectrum – Examples – De Rham spectra
          %h3#for_algebraic_objects For algebraic objects
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/smooth+varieties"} smooth varieties
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hypercohomology
            of the de Rham complex
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \Omega_X^\bullet
          %p
            De Rham cohomology has a rather subtle generalization for possibly singular algebraic varieties due to (
            %a{:href => "#Grothendieck"}> Grothendieck
            ).
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/analytic+spaces"} analytic spaces
          %ul
            %li
              T. Bloom, M. Herrera,
              = succeed "," do
                %em De Rham cohomology of an analytic space
              %strong 7
              (1969), 275-296,
              %a{:href => "http://dx.doi.org/10.1007/BF01425536"} doi
          %h3#ForCohesiveHomotopyTypes For cohesive homotopy types
          %p
            In the general context of
            %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+theory"} cohesive homotopy theory
            in a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} A \in \mathbf{H}
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type"} cohesive homotopy type
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of the
            %a.existingWikiWord{:href => "/nlab/show/counit+of+a+comonad"} counit
            of the
            %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ♭
                    %mi dR
                  %mi A
                  %mo ≔
                  %mi fib
                  %mo{:stretchy => "false"} (
                  %mo ♭
                  %mi A
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\flat_{dR} A \coloneqq fib(\flat A \to A)
          %p
            may be interpreted as the de Rham complex with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            This is the
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            for the
            %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi θ
                    %mrow
                      %mi Ω
                      %mi A
                %annotation{:encoding => "application/x-tex"} \theta_{\Omega A}
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi A
                %annotation{:encoding => "application/x-tex"} \Omega A
            in this generality. The
            %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi θ
                    %mrow
                      %mi Ω
                      %mi A
                %annotation{:encoding => "application/x-tex"} \theta_{\Omega A}
            is the general
            %a.existingWikiWord{:href => "/nlab/show/Chern+character"} Chern character
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(\Omega A)
          %p For more on this see at
          %ul
            %li
              %em
                %a{:href => "cohesive+%28infinity%2C1%29-topos+--+structures#deRhamCohomology"} structures in a cohesive infinity-topos – de Rham cohomology
          %p
            More precisely,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ♭
                    %mi dR
                  %mi Σ
                  %mi A
                %annotation{:encoding => "application/x-tex"} \flat_{dR} \Sigma A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi dR
                  %mi Ω
                  %mi A
                %annotation{:encoding => "application/x-tex"} \Pi_{dR} \Omega A
            play the role of the non-negative degree and negative degree part, respectively of the de Rham complex with coefficients in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %msub
                      %mo ♭
                      %mi dR
                    %mi Σ
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Pi \flat_{dR} \Sigma A
          %ul
            %li
              %em>
                %a{:href => "differential%20cohomology%20diagram#DeRhamCoefficients"} differential cohomology diagram – de Rham coefficients
              \.
          %h2#examples Examples
          %h3#de_rham_cohomology_of_spheres de Rham cohomology of spheres
          .num_prop
            %h6#proposition Proposition
            %p
              For positive
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℝ
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi p
                              %mo =
                              %mn 0
                              %mo ,
                              %mi n
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^p(S^n)
                    \=
                    \\left\{
                    \\array{
                    \\mathbb{R} &amp; if\; p = 0,n
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n=0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℝ
                              %mo ⊕
                              %mi ℝ
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi p
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^p(S^0)
                    \=
                    \\left\{
                    \\array{
                    \\mathbb{R} \oplus \mathbb{R} &amp; if\; p = 0
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
          .proof
            %h6#proof Proof
            %p
              This follows from the
              %a.existingWikiWord{:href => "/nlab/show/Mayer-Vietoris+sequence"} Mayer-Vietoris sequence
              associated to the open cover of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              by the subset excluding just the north pole and the subset excluding just the south pole, together with the fact that the dimension of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 0
                      %mi th
                  %annotation{:encoding => "application/x-tex"} 0^{th}
              de Rham cohomology of a smooth manifold is its number of connected components.
          %h2#properties Properties
          %h3#basic_theorems Basic theorems
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Poincare+lemma"} Poincare lemma
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/nonabelian+de+Rham+cohomology"} nonabelian de Rham cohomology
          %h3#RelaionToPLDeRhamComplex Relation to PL de Rham complex
          #PLdeRhamComplex.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/PL+de+Rham+complex+of+smooth+manifold+is+equivalent+to+de+Rham+complex"}> PL de Rham complex of smooth manifold is equivalent to de Rham complex
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p
              We have the following
              %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
              of
              %a.existingWikiWord{:href => "/nlab/show/dgc-algebra"} dgc-algebra
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
              between the
              %a.existingWikiWord{:href => "/nlab/show/PL+de+Rham+complex"} PL de Rham complex
              of (the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              underlying)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the smooth
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi PLdR
                              %mo •
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi dR
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi i
                                    %mo *
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi poly
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi p
                                    %mo *
                            %mo ↙
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msubsup
                                  %mi Ω
                                  %mi PLdR
                                  %mo •
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                                %mspace{:width => "thickmathspace"}
                                %mo =
                                %mspace{:width => "thickmathspace"}
                            %msubsup
                              %mi Ω
                              %mi PLdR
                              %mo •
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi Sing
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi PSdR
                              %mo •
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;
                    \\Omega^\bullet_{PLdR}
                    \\big(
                    S(X)
                    \\big)
                    \&amp;&amp;
                    \&amp;&amp;
                    \\Omega^\bullet_{dR}(X)
                    \\\
                    \&amp;
                    {}^{
                    \\mathllap{
                    i^\ast
                    }
                    }
                    \\nearrow
