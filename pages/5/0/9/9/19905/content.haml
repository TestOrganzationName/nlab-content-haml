              %ul
                %li
                  %a{:href => "#relation_to_the_little_disk_operad"}
                    Relation to the little
                    = succeed "-disk" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                %li
                  %a{:href => "#deRhamCohomology"} de Rham cohomology
