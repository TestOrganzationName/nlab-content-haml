                        %mi FM
                        %mi n
                      %mrow
                        %mo (
                        %msup
                          %mi ℝ
                          %mi d
                        %mo )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \\pi_n^{n + k}
                    }{\int}
                    \\;\colon\;
                    \\Omega^\bullet_{min}
                    \\left(
                    FM_{n + k}\left( \mathbb{R}^d \right)
                    \\right)
                    \\longrightarrow
                    \\Omega^{\bullet - d \cdot k}_{PA}
                    \\left(
                    FM_n\left( \mathbb{R}^d \right)
                    \\right)
          %p
            (
            %a{:href => "#LambrechtsVolic14"}> Lambrechts-Volic 14, Theorem 5.8 and equation (111)
            )
          #QuasiIsomorphismBetweenGraphComplexAndDeRhamComplexOfFM.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
                between
                %a.existingWikiWord{:href => "/nlab/show/graph+complex"} graph complex
                and
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
                of Fulton-MacPherson compactification)
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi I
                      %mo ¯
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Graphs
                      %mi n
                    %mrow
                      %mo (
                      %msup
                        %mi ℝ
                        %mi d
                      %mo )
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %mo ≃
                        %mphantom
                          %mi AA
                    %msubsup
                      %mi Ω
                      %mi PA
                      %mo •
                    %mrow
                      %mo (
                      %msub
                        %mi FM
                        %mi n
                      %mrow
                        %mo (
                        %msup
                          %mi ℝ
                          %mi d
                        %mo )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{I}
                    \\;\colon\;
                    Graphs_n\left( \mathbb{R}^d\right)
                    \\overset{ \phantom{AA}\simeq \phantom{AA} }{\longrightarrow}
                    \\Omega^\bullet_{PA}\left(  FM_n\left( \mathbb{R}^d \right) \right)
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/graph+complex"} graph complex
              %a.existingWikiWord{:href => "/nlab/show/dgc-algebra"} dgc-algebra
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TheGraphComplexdgcAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/semialgebraic+de+Rham+complex"} semialgebraic de Rham complex
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FiberIntegrationOverInternalVertices"}
              = succeed ")" do
                %a.maruku-ref{:href => "#FultonMacPhersonCompactification"}
              %a.existingWikiWord{:href => "/nlab/show/graphs"} graphs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Graphs
                      %mi n
                    %mrow
                      %mo (
                      %msup
                        %mi ℝ
                        %mi d
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \;\in\; Graphs_{n}\left( \mathbb{R}^d\right)
            %p with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≔
                    %mi int
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    k \coloneqq int(\Gamma)
            %p
              internal vertices by the
              %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
              of the canonical
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              through the
              %a.existingWikiWord{:href => "/nlab/show/span"} span
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi FM
                              %mrow
                                %mi n
                                %mo +
                                %mi k
                            %mrow
                              %mo (
                              %msup
                                %mi ℝ
                                %mi d
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo (
                                  %msub
                                    %mi θ
                                    %mrow
                                      %mi a
                                      %mi b
                                  %mo{:stretchy => "false"} |
                                  %mi a
                                  %mo ≠
                                  %mi b
                                  %mo ∈
                                  %mo{:stretchy => "false"} {
                                  %mn 1
                                  %mo ,
                                  %mi ⋯
                                  %mo ,
                                  %mi n
                                  %mo +
                                  %mi k
                                  %mo{:stretchy => "false"} }
                                  %mo )
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi π
                                    %mi n
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mi k
                        %mtr
                          %mtd
                            %msup
                              %mrow
                                %mo (
                                %msup
                                  %mi S
                                  %mrow
                                    %mi d
                                    %mo −
                                    %mn 1
                                %mo )
                              %mrow
                                %mi n
                                %mo +
                                %mi k
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi FM
                              %mi n
                            %mrow
                              %mo (
                              %msup
                                %mi ℝ
                                %mi d
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;
                    FM_{n + k}\left( \mathbb{R}^d\right)
                    \\\
                    \&amp;
                    {}^{ \mathllap{ \left( \theta_{a b} \vert a \neq b\in \{1, \cdots, n + k\} \right) } }\swarrow
                    \&amp;&amp;
                    \\searrow^{ \mathrlap{ \pi_n^{n + k}  } }
                    \\\
                    \\left(
                    S^{d-1}
                    \\right)^{n + k}
                    \&amp;&amp; &amp;&amp;
                    FM_n\left( \mathbb{R}^d \right)
                    }
            %p where
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                  on the left, to the
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                  of one
                  %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (d-1)-spheres
                  for each pair of distinct vertices, is given by the functions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi θ
                          %mrow
                            %mi a
                            %mi b
                      %annotation{:encoding => "application/x-tex"} \theta_{a b}
                  from
                  %a.maruku-eqref{:href => "#eq:ProjectionsToBoundarySpheres"} (1)
              %li
                %p
                  the function on the right is the canonical forgetful projection from Def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#FiberIntegrationOverInternalVertices"}
            %p hence which sends
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∫
                      %mrow
                        %msubsup
                          %mi π
                          %mi n
                          %mrow
                            %mi n
                            %mo +
                            %mi int
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} )
                    %munder
                      %mo ∧
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo →
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi Γ
                    %msub
                      %mi g
                      %mrow
                        %mi a
                        %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma
                    \\;\mapsto\;
                    \\underset{ \pi_{n}^{n + int(\Gamma)} }{\int}
                    \\underset{
                    (a \to b) \in \Gamma
                    }{\wedge}
                    g_{a b}
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
              over internal vertices (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FiberIntegrationOverInternalVertices"}
              %a.existingWikiWord{:href => "/nlab/show/wedge+product"} wedge product
              of the
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi a
                        %mi b
                    %mo ≔
                    %msubsup
                      %mi θ
                      %mrow
                        %mi a
                        %mi b
                      %mo *
                    %msub
                      %mi dvol
                      %mrow
                        %mo (
                        %msup
                          %mi S
                          %mrow
                            %mi d
                            %mo −
                            %mn 1
                        %mo )
                  %annotation{:encoding => "application/x-tex"}
                    g_{a b} \coloneqq \theta_{a b}^\ast dvol_{\left(S^{d-1}\right)}
            %p
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SphereClassGeneratorsOfDeRhamCohomology"}
              %a.existingWikiWord{:href => "/nlab/show/edge"} edge
              in the graph from vertex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              to vertex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
            %p
              This function constitutes a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/dgc-algebras"} dgc-algebras
              which is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
          %p
            That this is a dgc-algebra-homomorphism compatible with the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/cooperad"} cooperad
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            is proven in
            = succeed "," do
              %a{:href => "#LambrechtsVolic14"} Lambrechts-Volic 14
            %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            is proven in
            = succeed "." do
              %a{:href => "#LambrechtsVolic14"} Lambrechts-Volic 14, section 10
          #AsPerturbativeChernSimonsTheory.num_remark
            %h6#remark_2 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
                )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} g_{i j}
              from Def.
              %a.maruku-ref{:href => "#SphereClassGeneratorsOfDeRhamCohomology"}
              may be understood as being the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              of
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative
              %a.existingWikiWord{:href => "/nlab/show/higher+Chern-Simons+theory"} higher Chern-Simons theory
              regarded equivalently in its incarnation as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitude+on+compactified+configuration+spaces+of+points"} Feynman amplitude on compactified configuration spaces of points
              %em
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+propagator"} Chern-Simons propagator
              for more on this.
            %p
              From this perspective, the
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              in Prop.
              %a.maruku-ref{:href => "#QuasiIsomorphismBetweenGraphComplexAndDeRhamComplexOfFM"}
              sends each
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/graph"} graph
              %a.existingWikiWord{:href => "/nlab/show/Feynman+diagram"} Feynman diagram
              for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/higher+Chern-Simons+theory"} higher Chern-Simons theory
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitude"} Feynman amplitude
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitude+on+compactified+configuration+spaces+of+points"} Feynman amplitude on compactified configuration spaces of points
            %p
              That this should be the case was originally suggested in
              = succeed "." do
                %a{:href => "#Kontsevich94"} Kontsevich 94
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/little+n-disk+operad"} little n-disk operad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitude+on+compactified+configuration+space+of+points"} Feynman amplitude on compactified configuration space of points
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hilbert+scheme"} Hilbert scheme
          %h2#references References
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/compactification"} compactification
            of
            %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
            was first considered for two points in
          %ul
            %li#AxelrodSinger91
              %p
                %a.existingWikiWord{:href => "/nlab/show/Scott+Axelrod"}> Scott Axelrod
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Isadore+Singer"} Isadore Singer
                = succeed "," do
                  %em Chern-Simons Perturbation Theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9110056"} arXiv:hep-th/9110056
            %li#AxelrodSinger93
              %p
                %a.existingWikiWord{:href => "/nlab/show/Scott+Axelrod"}> Scott Axelrod
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Isadore+Singer"} Isadore Singer
                = succeed "," do
                  %em Chern–Simons Perturbation Theory II
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9304087"} arXiv:hep-th/9304087
          %p and then more generally in
          %ul
            %li#FultonMacPherson94
              %a.existingWikiWord{:href => "/nlab/show/William+Fulton"}> William Fulton
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Robert+MacPherson"} Robert MacPherson
              = succeed "," do
                %em A compactification of configuration spaces
              = succeed ")" do
                %a{:href => "https://www.jstor.org/stable/2946631"} jstor:2946631
          %p
            based on the general method of
            %a.existingWikiWord{:href => "/nlab/show/resolution+of+singularities"} resolution of singularities
            due to
          %ul
            %li#Hironaka64
              %a.existingWikiWord{:href => "/nlab/show/Heisuke+Hironaka"}> Heisuke Hironaka
              ,
              = succeed "," do
                %em Resolution of Singularities of an Algebraic Variety Over a Field of Characteristic Zero: I
              = succeed ")" do
                %a{:href => "https://www.jstor.org/stable/1970486"} jstor:1970486
          %p
            More general compactifications of spaces of
            %em subspace arrangements
            are due to
          %ul
            %li#deConciniProcesi95
              %a.existingWikiWord{:href => "/nlab/show/Corrado+de+Concini"}> Corrado de Concini
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Claudio+Procesi"} Claudio Procesi
              = succeed "," do
                %em Wonderful models of subspace arrangements
              = succeed ")" do
                %a{:href => "https://link.springer.com/content/pdf/10.1007/BF01589496.pdf"} pdf
          %p see also
          %ul
            %li#Feichtner05
              Eva Maria Feichner,
              = succeed "," do
                %em De Concini–Procesi Wonderful Arrangement Models: A Discrete Geometer’s Point of View
              = succeed ")" do
                %a{:href => "http://library.msri.org/books/Book52/files/17feich.pdf"} pdf
          %p
            The
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/operad"} operad
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            on Axelrod-Singer Fulton-MacPherson compactifications of
            %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
            was considered in
          %ul
            %li#GetzlerJones94
              %a.existingWikiWord{:href => "/nlab/show/Ezra+Getzler"}> Ezra Getzler
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Jones"} John Jones
              %em Operads, homotopy algebra and iterated integrals for double loop spaces
              (
              %a{:href => "https://arxiv.org/abs/hep-th/9403055"}> arXiv:hep-th/9403055
              )
          %p and alternatively in
          %ul
            %li#Kontsevich99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
                , around Def. 12 of
                = succeed "," do
                  %em Operads and Motives in Deformation Quantization
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/math/9904055"} arXiv:math/9904055
            %li#Kontsevich97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
                , section 5.1 of
                = succeed "," do
                  %em Deformation quantization of Poisson manifolds, I
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/q-alg/9709040"} arXiv:q-alg/9709040
          %p which was corrected in
          %ul
            %li
              Giovanni Gaiffi,
              = succeed "," do
                %em Models for real subspace arrangements and stratified manifolds
              = succeed ")" do
                %a{:href => "http://www.dm.unipi.it/~gaiffi/papers/models.pdf"} pdf
          %p and developed in detail in
          %ul
            %li#Sinha03
              %a.existingWikiWord{:href => "/nlab/show/Dev+Sinha"}> Dev Sinha
              ,
              = succeed "," do
                %em Manifold theoretic compactifications of configuration spaces
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/math/0306385"} arXiv:math/0306385
          %p
            which also shows the equivalence to
            = succeed "." do
              %a{:href => "#FultonMacPherson94"} Fulton-MacPherson 94
          %p Review includes
          %ul
            %li#LambrechtsVolic14
              %a.existingWikiWord{:href => "/nlab/show/Pascal+Lambrechts"}> Pascal Lambrechts
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ismar+Voli%C4%87"} Ismar Volić
              = succeed "," do
                %em Formality of the little N-disks operad
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/0808.0457"} arXiv:0808.0457
              = succeed ")" do
                %a{:href => "http://dx.doi.org/10.1090/memo/1079"} doi:10.1090/memo/1079
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            was determined in
          %ul
            %li#Arnold69
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Arnold"}> Vladimir Arnold
                ,
                = succeed "," do
                  %em The cohomology ring of the colored braid group
                = succeed ")" do
                  %a{:href => "http://mi.mathnet.ru/eng/mz6827"} mathnet:mz6827
            %li#Cohen73
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fred+Cohen"}> Fred Cohen
                ,
                = succeed "," do
                  %em Cohomology of braid spaces
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.bams/1183534761"} euclid:1183534761
          %p
            The equivalence to the
            %a.existingWikiWord{:href => "/nlab/show/little+n-disk+operad"} little n-disk operad
            was established in
          %ul
            %li#Salvatore01
              %a.existingWikiWord{:href => "/nlab/show/Paolo+Salvatore"}> Paolo Salvatore
              ,
              = succeed "," do
                %em Configuration spaces with summable labels
          %p#ReferencesPropagator
            The interpretation of the quasi-isomorphism establishing
            %a.existingWikiWord{:href => "/nlab/show/formality+of+the+little+n-disk+operad"} formality of the little n-disk operad
            as sending edges to
            %a.existingWikiWord{:href => "/nlab/show/Feynman+propagators"} Feynman propagators
            of some
            %a.existingWikiWord{:href => "/nlab/show/topological+quantum+field+theory"} topological quantum field theory
            such as
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            is due to
          %ul
            %li#AxelrodSinger93
              %a.existingWikiWord{:href => "/nlab/show/Scott+Axelrod"}> Scott Axelrod
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Isadore+Singer"} Isadore Singer
              = succeed "," do
                %em Chern–Simons Perturbation Theory II
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9304087"} arXiv:hep-th/9304087
          %p which is recalled and recast in somewhat more generality in
          %ul
            %li#BottCattaneo97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Raoul+Bott"}> Raoul Bott
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"} Alberto Cattaneo
                = succeed "," do
                  %em Integral invariants of 3-manifolds
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/dg-ga/9710001"} arXiv:dg-ga/9710001
            %li#CattaneoMnev10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
                ,
