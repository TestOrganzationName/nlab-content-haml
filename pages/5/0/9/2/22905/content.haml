                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo ,
                        %mi η
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi X
                        %mo ⊙
                        %mi I
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi η
                              %mi X
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        (I, \eta) : X \odot I \xrightarrow{\eta_X} X
              %li
                The composition of a map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo ⊙
                      %mi P
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f : A \odot P \to B
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi B
                      %mo ⊙
                      %mi Q
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} g : B \odot Q \to C
                is defined as
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊙
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ⊗
                        %mi Q
                        %mo{:stretchy => "false"} )
                        %mo ≅
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ⊙
                        %mi P
                        %mo{:stretchy => "false"} )
                        %mo ⊙
                        %mi Q
                        %mover
                          %mo →
                          %mrow
                            %mi f
                            %mo ⊙
                            %mi Q
                        %mi B
                        %mo ⊙
                        %mi Q
                        %mover
                          %mo →
                          %mi g
                        %mi C
                      %annotation{:encoding => "application/x-tex"}
                        A \odot (P \otimes Q) \cong (A \odot P) \odot Q \xrightarrow{f \odot Q} B \odot Q \xrightarrow{g} C
              %li
                The data of associators and unitors for the bicategory, as well as their coherence diagrams, are defined using those of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℳ
                    %annotation{:encoding => "application/x-tex"} \mathcal{M}
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊙
                      %annotation{:encoding => "application/x-tex"} \odot
            %p
          %p
            Again, it is folklore that this bicategory is symmetric monoidal when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊙
                %annotation{:encoding => "application/x-tex"} \odot
            is a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/monoidal+actegory"} symmetric monoidal action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is monoidal,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"} \mathcal{M}
            is symmetric and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊙
                %annotation{:encoding => "application/x-tex"} \odot
            is a symmetric monoidal functor.
          %p
            Also, this construction is 2-functorial from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                  %mstyle{:mathvariant => "bold"}
                    %mi Act
                %annotation{:encoding => "application/x-tex"} \mathcal{M}\mathbf{Act}
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Bicat
                  %annotation{:encoding => "application/x-tex"} \mathbf{Bicat}
          %h3#dual_construction_copara_and_bipara Dual construction: copara and bipara
          %p
            Given a
            %em left
            = succeed "-actegory," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
            %em coparametric morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi P
                  %mo ⊙
                  %mi B
                %annotation{:encoding => "application/x-tex"} f: A \to P \odot B
            by dualizing the above construction in the obvious way. This is known as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Copara
                    %mo{:stretchy => "false"} (
                    %mo ⊙
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Copara}(\odot)
          %p
            Likewise, given an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
            %a.existingWikiWord{:href => "/nlab/show/biactegory"} biactegory
            there is a bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Bipara
                  %mo{:stretchy => "false"} (
                  %mo ⊙
                  %mo ,
                  %mo ⊙
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Bipara}(\odot, \odot')
            whose 1-cells are
            %em biparametric morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo ⊙
                    %mi P
                    %mo →
                    %mi Q
                    %mo ⊙
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f: A \odot P \to Q \odot B
          %h3#generalizations Generalizations
          %p
            The Para construction naturally generalizes in five different ways (with the first four described in (
            %a{:href => "#Myers22"}> Myers 2022
            )):
          %p#AsADoubleCategory
            %strong (1.)
            Move from bicategories to
            %a.existingWikiWord{:href => "/nlab/show/double+categories"} double categories
            (in the weak sense):
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Para
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Para}(\mathcal{C})
            is usefully thought of as a
            %a.existingWikiWord{:href => "/nlab/show/double+category"} double category
            whose
            %a.existingWikiWord{:href => "/nlab/show/tight+map"} tight category
            is still
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/loose+map"} loose maps
            are parametric morphisms, and whose squares are reparametrizations that commute suitably:
