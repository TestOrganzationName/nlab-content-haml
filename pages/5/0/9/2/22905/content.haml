            %ul
              %li
                %p
                  Identity morphisms are given by the right
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/unitors"} unitors
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo ,
                        %mi ρ
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo ⊗
                        %mi I
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi ρ
                              %mi X
                        %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (I, \rho) \colon X \otimes I
                        \\xrightarrow{\rho_X}
                        X
                        \\,.
              %li
                %p
                  The composite of a map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo ⊗
                        %mi P
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} f \colon A \otimes P \to B
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                        %mo ⊗
                        %mi Q
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} g \colon B \otimes Q \to C
                  is given by the animation above. In symbols, this is the
                  = succeed "-parameterised" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                          %mo ⊗
                          %mi Q
                        %annotation{:encoding => "application/x-tex"} P \otimes Q
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊗
                        %mi P
                        %mo ⊗
                        %mi Q
                        %mover
                          %mo →
                          %mrow
                            %mi f
                            %mo ⊗
                            %mi Q
                        %mi B
                        %mo ⊗
                        %mi Q
                        %mover
                          %mo →
                          %mi g
                        %mi C
                      %annotation{:encoding => "application/x-tex"}
                        A \otimes P \otimes Q
                        \\xrightarrow{f \otimes Q}
                        B \otimes Q \xrightarrow{g} C
              %li
                %p
                  The data of
                  %a.existingWikiWord{:href => "/nlab/show/associators"} associators
                  and
                  %a.existingWikiWord{:href => "/nlab/show/unitors"} unitors
                  for the bicategory, as well as their coherence diagrams, are defined using those of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is strict monoidal, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Para
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Para}(\mathcal{C})
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoidal+category"} commutative
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Para
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Para}(\mathcal{C})
            is symmetric monoidal, since commutativity of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            allows one to exhibit an interchange. It is believe this still holds if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is just symmetric, making
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Para
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Para}(\mathcal{C})
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+bicategory"} symmetric monoidal bicategory
          %h3#for_actegories For actegories
          %p
          .num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℳ
                    %mo ,
                    %mi I
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{M}, I, \otimes)
              be a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊙
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \odot)
              be a right
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℳ
                    %annotation{:encoding => "application/x-tex"} \mathcal{M}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/actegory"} actegory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Para
                    %mo{:stretchy => "false"} (
                    %mo ⊙
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Para}(\odot)
              is a
              %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
              with the following data:
            %ul
              %li
                Its 0-cells are the objects of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                A 1-cell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \to B
                is a choice of a parameter object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo :
                      %mi ℳ
                    %annotation{:encoding => "application/x-tex"} P : \mathcal{M}
                and a morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi A
                        %mo ⊙
                        %mi P
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"}
                        f : A \odot P \to B
                %p
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                A 2-cell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (P, f) \Rightarrow (Q, g)
                is a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
