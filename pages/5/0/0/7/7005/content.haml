                        %mn 2
                  %mi B
                %annotation{:encoding => "application/x-tex"} B \xrightarrow{\Delta_B} B\times B \xrightarrow{\pi_2} B
          %p
            is the identity, both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi B
                  %msub
                    %mo ×
                    %mrow
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} /
                        %mrow
                          %mi B
                          %mo ×
                          %mi B
                  %mi E
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Delta_B \times_{\mathcal{C}/_{B \times B}} E \times B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi B
                  %msub
                    %mo ×
                    %mrow
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} /
                        %mrow
                          %mi B
                          %mo ×
                          %mi B
                  %mi B
                  %mo ×
                  %mi E
                %annotation{:encoding => "application/x-tex"} \Delta_B \times_{\mathcal{C}/_{B \times B}} B \times E
            are isomorphic to
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/identity"} identity
            morphism.
          %p
            Now, using the
            %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
            factorization in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                        %mtd
                          %mover
                            %mo ↪
                            %mo ≃
                        %mtd
                        %mtd
                          %msup
                            %mi B
                            %mi I
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi Δ
                                  %mi B
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mrow
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi B
                          %mo ×
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  B &amp;&amp;\stackrel{\simeq}{\hookrightarrow}&amp;&amp; B^I
                  \\\
                  \&amp; {}_{\mathllap{\Delta_B}}\searrow
                  \&amp;&amp; \swarrow_{\mathrlap{}}
                  \\\
                  \&amp;&amp; B \times B
                  }
          %p
            by an acyclic cofibration followed by a fibration, we obtain a fibrant replacement of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi B
                %annotation{:encoding => "application/x-tex"} \Delta_B
            in the
            %a.existingWikiWord{:href => "/nlab/show/slice+model+category"} slice model category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mi B
                        %mo ×
                        %mi B
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{B \times B}
          %p
            Since also
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo ×
                  %mi B
                  %mo ,
                  %mi B
                  %mo ×
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} /
                        %mrow
                          %mi B
                          %mo ×
                          %mi B
                %annotation{:encoding => "application/x-tex"} [E \times B, B \times E]_{\mathcal{C}/_{B \times B}}
            is fibrant by the axioms on the
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+model+category"} locally cartesian closed model category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi q
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat q
            in the
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %msub
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mi B
                      %mo ×
                      %mi B
                %annotation{:encoding => "application/x-tex"} \mathcal{C}/_{B \times B}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %mover
                            %mo →
                            %mi q
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi E
                          %mo ×
                          %mi B
                          %mo ,
                          %mi B
                          %mo ×
                          %mi E
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mrow
                              %mi 𝒞
                              %msub
                                %mo{:stretchy => "false"} /
                                %mrow
                                  %mi B
                                  %mo ×
                                  %mi B
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mover
                                %mi q
                                %mo{:stretchy => "false"} ^
                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msup
                            %mi B
                            %mi I
                        %mtd
                          %mo →
                        %mtd
                          %mi B
                          %mo ×
                          %mi B
                          %mo =
                          %msub
                            %mo *
                            %mrow
                              %mi 𝒞
                              %msub
                                %mo{:stretchy => "false"} /
                                %mrow
                                  %mi B
                                  %mo ×
                                  %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  B &amp;\stackrel{q}{\to}&amp; [E \times B, B \times E]_{\mathcal{C}/_{B \times B}}
                  \\\
                  \\downarrow &amp;{}^{\mathllap{\hat q}}\nearrow&amp; \downarrow
                  \\\
                  B^I &amp;\to&amp; B \times B = *_{\mathcal{C}/_{B \times B}}
                  }
                  \\,.
          %p
            This lift is the interpretation of the
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} path induction
            that deduces a map on all paths
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo ∈
                  %msup
                    %mi B
                    %mi I
                %annotation{:encoding => "application/x-tex"} \gamma \in B^I
            from one on just the identity paths
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi b
                    %mo ∈
                    %mi B
                    %mo ↪
                    %msup
                      %mi B
                      %mi I
                  %annotation{:encoding => "application/x-tex"} id_b \in B \hookrightarrow B^I
          %p
            Finally, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Eq
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo ×
                  %mi B
                  %mo ,
                  %mi B
                  %mo ×
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} /
                        %mrow
                          %mi B
                          %mo ×
                          %mi B
                %annotation{:encoding => "application/x-tex"} Eq(E) \hookrightarrow [E \times B , B \times E]_{\mathcal{C}/_{B \times B}}
            be the
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            on the weak equivalences (…), and observe that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi q
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat q
            factor through this to give a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi q
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %msup
                    %mi B
                    %mi I
                  %mo →
                  %mi Eq
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\hat q : B^I \to Eq(E)
                  \\,.
          %p
            The fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} E \to B
            is
            %strong univalent
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            if this morphism is a weak equivalence. By the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-out-of-3+property"} 2-out-of-3 property
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi Eq
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} q\colon B\to Eq(E)
            be a weak equivalence.
          %p (…)
          %h3#InSimplicialSets In simplicial sets
          %p
            We specialize the
            %a{:href => "#InCategoricalSemantics"} general discussion
            above to the realization in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathcal{C} =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} E \to B
            any fibration (
            %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"}> Kan fibration
            ) between fibrant objects (
            %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"}> Kan complexes
            ), consider first the simplicial set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo ×
                  %mi B
                  %mo ,
                  %mi B
                  %mo ×
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi B
                      %mo ×
                      %mi B
                  %mo ∈
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mi B
                      %mo ×
                      %mi B
                %annotation{:encoding => "application/x-tex"}
                  [E \times B , B \times E]_{B \times B}
                  \\in
                  sSet/_{B \times B}
          %p
            defined as the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            in the
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} /
                      %mrow
                        %mi B
                        %mo ×
                        %mi B
                  %annotation{:encoding => "application/x-tex"} sSet/_{B \times B}
          %p
            Notice that the vertices of this simplicial set over a fixed pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mn 1
                  %mo ,
                  %msub
                    %mi b
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo *
                  %mo →
                  %mi B
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} (b_1, b_2) : * \to B \times B
            of vertices in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            form the set of morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                  %mo →
                  %msub
                    %mi E
                    %mrow
                      %msub
                        %mi b
                        %mn 2
                %annotation{:encoding => "application/x-tex"} E_{b_1} \to E_{b_2}
            between the
            %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
          %p
            This is because – by the defining property of the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            in the
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice
            and using that
            %a.existingWikiWord{:href => "/nlab/show/products"} products
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mi B
                      %mo ×
                      %mi B
                %annotation{:encoding => "application/x-tex"} sSet/_{B \times B}
            are
            %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} sSet
            – the horizontal morphisms of simplcial sets in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi E
                          %mo ×
                          %mi B
                          %mo ,
                          %mi B
                          %mo ×
                          %mi E
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mrow
                              %mi B
                              %mo ×
                              %mi B
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi b
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi b
                                  %mn 2
                                %mo{:stretchy => "false"} )
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi B
                          %mo ×
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  * &amp;&amp;\to&amp;&amp; [E \times B, B \times E]_{B \times B}
                  \\\
                  \&amp; {}_{\mathllap{(b_1,b_2)}}\searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; B \times B
                  }
          %p correspond bijectively to the horizontal morphisms in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi E
                            %mrow
                              %msub
                                %mi b
                                %mn 1
                          %mo ×
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi b
                            %mn 2
                          %mo{:stretchy => "false"} }
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi b
                            %mn 1
                          %mo{:stretchy => "false"} }
                          %mo ×
                          %msub
                            %mi E
                            %mrow
                              %msub
                                %mi b
                                %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi B
                          %mo ×
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  E_{b_1} \times \{b_2\} &amp;&amp;\to&amp;&amp; \{b_1\} \times E_{b_2}
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; B \times B
                  }
          %p
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                    %mo →
                    %msub
                      %mi E
                      %mrow
                        %msub
                          %mi b
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} E_{b_1} \to E_{b_2}
          %p Let then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Eq
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mo{:stretchy => "false"} [
                  %mi E
                  %mo ×
                  %mi B
                  %mo ,
                  %mi B
                  %mo ×
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi B
                      %mo ×
                      %mi B
                  %mo ∈
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mi B
                      %mo ×
                      %mi B
                %annotation{:encoding => "application/x-tex"}
                  Eq(E) \hookrightarrow [E \times B, B \times E]_{B \times B}
                  \\in sSet/_{B \times B}
          %p
            be the full sub-simplicial set on those vertices that correspond to
            %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            ((
            %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"}> weak
            )
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
          %p
            By a similar consideration, one sees that the
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi B
                  %mo :
                  %mi B
                  %mo →
                  %mi B
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Delta_B : B \to B \times B
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} /
                      %mrow
                        %mi B
                        %mo ×
                        %mi B
                  %annotation{:encoding => "application/x-tex"} B \in sSet/_{B \times B}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo →
                  %mi Eq
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  B \to Eq(E)
                  \\,.
          %p
            The fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} E \to B
            is univalent, precisely when this morphism is a weak equivalence.
          %p
            This appears originally as
            %a{:href => "#UnivalentFoundationsProject"} Voevodsky, def. 3.4
          %h3#InSimplicialPresheaves In simplicial presheaves
          %p (…)
          %p
            See (
            %a{:href => "#Shulman12"}> Shulman 12
            ,
            = succeed ")" do
              %a{:href => "UF13"} UF 13
          %p (…)
          %h2#properties Properties
          %h3#relation_to_function_extensionality Relation to function extensionality
          %p
            The univalence axiom implies
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
          %p
            A commented version of a formal proof of this fact can be found in (
            %a{:href => "#BauerLumsdaine"}> Bauer-Lumsdaine
            ).
          %h3#univalence_and_axiom_k Univalence and axiom K
          %p
            In this section we assume that the universe is a Tarski universe.
            %a.existingWikiWord{:href => "/nlab/show/Axiom+K"} Axiom K
            states that for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi U
                %annotation{:encoding => "application/x-tex"} A:U
            the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(A)
            is a set. This means the type reflection of the internal equivalences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msub
                    %mo ≃
                    %mi U
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(A \simeq_U B)
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/h-set"} h-set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-groupoid"} h-groupoid
          %p
            It is frequently stated that the univalence axiom and axiom K are inconsistent with each other. However, this is only true if the Tarski universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            has internal univalent Tarski universes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo :
                  %mi U
                %annotation{:encoding => "application/x-tex"} V:U
            where the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(V)
            has terms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A:T(V)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi V
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T_V(A)
            is an
            %a.existingWikiWord{:href => "/nlab/show/h-set"} h-set
            which is not an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/booleans+type"} booleans type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(V)
            can be proven to not be a set, causing axiom K for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            to be inconsistent with the existence of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo :
                  %mi U
                %annotation{:encoding => "application/x-tex"} V:U
            and univalence.
          %h3#UnivalenceLEM Univalence and excluded middle
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
            is consistent with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            %a.existingWikiWord{:href => "/nlab/show/propositions"} propositions
            or
            %a.existingWikiWord{:href => "/nlab/show/%28-1%29-truncated"} (-1)-truncated
            types.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} lem
                        %mi A
                      %mo :
                      %mi{:mathvariant => "normal"} isProp
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ∨
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo →
                      %mi ∅
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma \vdash \mathrm{lem}_A:\mathrm{isProp}(A) \to (A \vee (A \to \emptyset))}
          %p
            The semantics of dependent type theory with excluded middle and universes satisfying the univalence axiom are
            %a.existingWikiWord{:href => "/nlab/show/boolean+topos"} boolean
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty, 1)
                \-toposes
          %p However, there is a global choice axiom which is inconsistent with univalence:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} gc
                        %mi A
                      %mo :
                      %mi A
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo →
                      %mi ∅
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma \vdash \mathrm{gc}_A:A + (A \to \emptyset)}
          %p
            This is sometimes called “excluded middle” in the
            %a.existingWikiWord{:href => "/nlab/show/propositions+as+types"} propositions as types
            interpretation of type theory, where the principle of excluded middle is reinterpreted so that types are used instead of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/mere+propositions"} mere propositions
            %a.existingWikiWord{:href => "/nlab/show/choice+operator"} choice operator
            and implying that every type is an
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/h-set"} h-set
          %h3#Canonicity Canonicity and homotopy canonicity
          %p
            It is currently open whether the univalence axiom enjoys
            %a.existingWikiWord{:href => "/nlab/show/canonicity"} canonicity
            in general, but for the special case of
            %a.existingWikiWord{:href => "/nlab/show/1-truncated"} 1-truncated
            homotopy types (
            %a.existingWikiWord{:href => "/nlab/show/groupoids"}> groupoids
            ) (and two nested univalent
            %a.existingWikiWord{:href => "/nlab/show/universes"} universes
            and
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
            %a.existingWikiWord{:href => "/nlab/show/homotopy+canonicity"} homotopy canonicity
            has been shown in (
            %a{:href => "#Shulman12"}> Shulman 12, section 13
            \. Thus, in univalent homotopy 1-type theory with two universes, every
            %a.existingWikiWord{:href => "/nlab/show/term"} term
            of
            %a.existingWikiWord{:href => "/nlab/show/type"} type
            of the
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            is
            %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositionally equal
            to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/numeral"} numeral
          %p
            The construction in (
            %a{:href => "#Shulman12"}> Shulman 12, section 13
            ) uses
            %a.existingWikiWord{:href => "/nlab/show/Artin+gluing"} Artin gluing
            of a suitable
            %a.existingWikiWord{:href => "/nlab/show/type-theoretic+model+category"} type-theoretic fibration category
            with the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            = succeed ")" do
              %a{:href => "#Shulman12"} Shulman 12, remark 13.13
            %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
            functor with values in some model for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoids"} infinity-groupoids
            %a.existingWikiWord{:href => "/nlab/show/Christian+Sattler"} Christian Sattler
            and
            %a.existingWikiWord{:href => "/nlab/show/Krzysztof+Kapulkin"} Krzysztof Kapulkin
            (
            %a{:href => "#Sattler19"}> Sattler 19
            ).
          %p
            Notice that this sort of
            %a.existingWikiWord{:href => "/nlab/show/canonicity"} canonicity
            does not yet imply
            = succeed "," do
              %span.newWikiWord
                computational effectiveness
                %a{:href => "/nlab/new/computational+effectiveness"} ?
            %a.existingWikiWord{:href => "/nlab/show/algorithm"} algorithm
            to extract that
            %a.existingWikiWord{:href => "/nlab/show/numeral"} numeral
            from the given
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/term"} term
            %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive
            version of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/proof"} proof
          %p
            It is also a
            %em
              %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositional
            canonicity, as opposed to the
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental
            canonicity which many traditional
            %a.existingWikiWord{:href => "/nlab/show/type+theories"} type theories
            enjoy. Another approach to canonicity for 1-truncated univalence can be found in (
            %a{:href => "#HarperLicata"}> Harper-Licata
            ), which involves modifying the type theory by adding more
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/judgmental+equalities"} judgmental equalities
            %a.existingWikiWord{:href => "/nlab/show/algorithm"} algorithm
            for computing canonical forms has yet been given for this approach either.
          %p
            Canonicity has been proved for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical type theory
          %p
            One might also try to construct the Hoffman-Streicher groupoid model in a constructive framework; Awodey and Bauer have done some work in this direction with an
            %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} impredicative
            %a.existingWikiWord{:href => "/nlab/show/universe"} universe
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-sets"} h-sets
          %h3#a_univalent_universe_inside_a_nonunivalent_universe A univalent universe inside a non-univalent universe
          %p
            In a post to the
            = succeed "," do
              %a{:href => "https://groups.google.com/forum/#!forum/homotopytypetheory"} Homotopy Type Theory Google Group
            = succeed ":" do
              %a{:href => "https://groups.google.com/d/msg/homotopytypetheory/3wp32xV7OX0/2HfAnBt44XoJ"} wrote
          %blockquote
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo :
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_0:X)
              be any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+type"} pointed type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒰
                    %mo ,
                    %mi El
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{U}, El)
              be a universe (with rules as I set out a couple of emails ago). Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} X \times \mathcal{U}
              is again a universe, admitting all the same constructors as
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi El
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi El
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} El(x,A) = El(A)
              ,
              %br/
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo +
                        %mi 𝒰
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 0
                      %mo ,
                      %mi A
                      %msub
                        %mo +
                        %mi 𝒰
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x,A) +_\mathcal{U} (y,B) = (x_0, A +_\mathcal{U} B)
            %p
              and so on; that is, constructor operations on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi 𝒰
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X \times \mathcal{U})
              are constantly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_0
              on the first component, and mirror those of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} \mathcal{U}
              on the second component.
            %p
              Now if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} \mathcal{U}
              is univalent, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has non-trivial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_0
              (e.g.
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X=S^1
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U} \rightarrow (X \times \mathcal{U}
            %p
              Slightly more generally, given any cumulative pair of universes
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒰
                        %mn 0
                      %mo →
                      %msub
                        %mi 𝒰
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}_0 \rightarrow \mathcal{U}_1
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒰
                        %mn 0
                      %mo →
                      %mi A
                      %mo ×
                      %msub
                        %mi 𝒰
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}_0 \rightarrow A \times \mathcal{U}_1
          %p
            %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike Shulman
            = succeed ":" do
              %a{:href => "https://groups.google.com/d/msg/homotopytypetheory/3wp32xV7OX0/kIapR0lo1UEJ"} added
          %blockquote
            %p
              [N]ot only is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} X \times \mathcal{U}
              not univalent, it’s not even “univalent on the image of
              = succeed "\u201D," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
          %h2#univalence_axiom_without_universes Univalence axiom without universes
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory+with+type+variables"} dependent type theory with type variables
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+type#IdentityTypesBetweenTypes"} identity types between types
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+universes"} type universes
          %p
            The
            %strong univalence axiom
            states that the function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} idtoequiv
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo =
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ≃
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{idtoequiv}(A, B):(A = B) \to (A \simeq B)
          %p inductively defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} idtoequiv
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo ,
                  %mi{:mathvariant => "normal"} refl
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathrm{idtoequiv}(A, A, \mathrm{refl}(A)) \coloneqq \mathrm{id}_A
          %p
            is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            for all types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isEquiv
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} idtoequiv
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isEquiv}(\mathrm{idtoequiv}(A, B))
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} id
                    %mi A
                  %mo ≔
                  %mi λ
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi x
                %annotation{:encoding => "application/x-tex"} \mathrm{id}_A \coloneqq \lambda x:A.x
            is the
            %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
            on the type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mo ,
                      %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mo ⊢
                      %mi{:mathvariant => "normal"} ua
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi{:mathvariant => "normal"} isEquiv
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi p
                      %mo :
                      %mi A
                      %mo =
                      %mi B
                      %mo .
                      %mi{:mathvariant => "normal"} idtoequiv
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma, A \; \mathrm{type}, B \; \mathrm{type} \vdash \mathrm{ua}(A, B):\mathrm{isEquiv}(\lambda p:A = B.\mathrm{idtoequiv}(A, B, p))}
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/impredicative+polymorphism"} impredicative polymorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} ua
                      %mo :
                      %mi Π
                      %mi A
                      %mo .
                      %mi Π
                      %mi B
                      %mo .
                      %mi{:mathvariant => "normal"} isEquiv
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi p
                      %mo :
                      %mi A
                      %mo =
                      %mi B
                      %mo .
                      %mi{:mathvariant => "normal"} idtoequiv
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathrm{ua}:\Pi A.\Pi B.\mathrm{isEquiv}(\lambda p:A = B.\mathrm{idtoequiv}(A, B, p))}
          %p
            Unlike the other presentation of dependent type theory in terms of universes, in this presentation of dependent type theory with a type judgment and type variables, it
            %em is consistent
            to assume both the
            %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
            and an
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+set+truncation"} axiom of set truncation
            like
            %a.existingWikiWord{:href => "/nlab/show/UIP"} UIP
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
          %p
            There is one other version of univalence, where we replace the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            between the identity type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mi B
                %annotation{:encoding => "application/x-tex"} A = B
            and the type of equivalences of the universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≃
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \simeq B
            in the univalence axioms with the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %a.existingWikiWord{:href => "/nlab/show/identification"} identification
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} ua
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo =
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ≃
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ua}(A, B):(A = B) = (A \simeq B)
          %p
            This implies the usual version of univalence either through
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identification+elimination"} identification elimination
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/transport"} transport
            %a.existingWikiWord{:href => "/nlab/show/action+on+identifications"} action on identifications
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/resizing+axiom"} resizing axiom
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/univalent+foundations"} univalent foundations
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/univalent+type+theory"} univalent type theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/extensionality"} extensionality
              %ul
                %li
                  %p
                    Univalence is closely related to the “completeness” condition in the theory of
                    = succeed "/" do
                      %a.existingWikiWord{:href => "/nlab/show/Segal+spaces"} Segal spaces
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/semi-Segal+spaces"} semi-Segal spaces
                    = succeed "/_" do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"} complete Segal space
                    %a.existingWikiWord{:href => "/nlab/show/complete+semi-Segal+space"} complete semi-Segal space
                    %em .
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/propositional+extensionality"} propositional extensionality
            %li
              %p
                contrary to univalence is the
                %a.existingWikiWord{:href => "/nlab/show/axiom+UIP"} axiom UIP
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/directed+univalence+axiom"} directed univalence axiom
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+relativity"} axiom of relativity
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/identity+type#IdentityTypesBetweenTypes"} identity type between types
          %h2#References References
          %blockquote
            %p
              For more references see also at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %p Arguably, the earliest occurrence of a version of the univalence axiom is due – under the name “universe extensionality” – to:
          %ul
            %li#HofmannStreicher98
              %a.existingWikiWord{:href => "/nlab/show/Martin+Hofmann"}> Martin Hofmann
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"} Thomas Streicher
              = succeed "," do
                %em The groupoid interpretation of type theory
              %a.existingWikiWord{:href => "/nlab/show/Giovanni+Sambin"} Giovanni Sambin
              et al. (eds.),
              = succeed "," do
                %em Twenty-five years of constructive type theory
              %strong 36
              (1998) 83-111 &amp;lbrack;
              %a{:href => "https://global.oup.com/academic/product/twenty-five-years-of-constructive-type-theory-9780198501275"}> ISBN:9780198501275
              ,
              = succeed "," do
                %a{:href => "http://www.mathematik.tu-darmstadt.de/~streicher/venedig.ps.gz"} ps
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/HofmannStreicherGroupoidInterpretation.pdf", :title => "pdf"} pdf
          %p
            Strictly speaking, univalence for
            %em propositions
            has a much longer pedigree, this that can and does hold even in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set-level+foundations"} set-level foundations
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/h-sets"} h-sets
            %a.existingWikiWord{:href => "/nlab/show/equivalences+in+homotopy+type+theory"} equivalences in homotopy type theory
            (see
            %a{:href => "equivalence+in+type+theory#TheIssueWithQuasiInverses"} there
            for details), which Voevodsky was the first to give.
          %p For comments on the early history see also:
          %ul
            %li#Altenkirch21
              %a.existingWikiWord{:href => "/nlab/show/Thorsten+Altenkirch"}> Thorsten Altenkirch
              ,
              = succeed "," do
                %em Martin Hofmann’s contributions to type theory: Groupoids and univalence
              %strong 31
              9 (2021) 953-957 &amp;lbrack;
              %a{:href => "https://doi.org/10.1017/S0960129520000316"}> doi:10.1017/S0960129520000316
              \&amp;rbrack;
          %p
            It is this notion of
            %a.existingWikiWord{:href => "/nlab/show/equivalence+in+homotopy+type+theory"} equivalence in homotopy type theory
            which was fixed in
          %ul
            %li#Voevodsky10
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"}> Vladimir Voevodsky
              , p. 8, 10-11 of:
              %em Univalent Foundations Project
              (2010) &amp;lbrack;
              %a{:href => "http://www.math.ias.edu/~vladimir/Site3/Univalent_Foundations_files/univalent_foundations_project.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Voevodsky-UFP2010.pdf", :title => "pdf"} pdf
          %p ever since the univalence axiom is widely attributed to Voevodsky. Earlier documentation of the univalence axiom in modern form is hard to come by:
          %p The first technical understanding of (the semantics of) univalence in simplicial sets seems to be due to:
          %ul
            %li#Bousfield06
              %a.existingWikiWord{:href => "/nlab/show/Aldridge+Bousfield"}> Aldridge Bousfield
              ,
              %a{:href => "https://groups.google.com/g/homotopytypetheory/c/K_4bAZEDRvE/m/YSQz-jJ_AAAJ"} email to VV from 01 May 2006 10:10:30 CDT
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              %a.existingWikiWord{:href => "/nlab/files/BousfieldOnUnivalence.jpg", :title => "screenshot"} screenshot
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p
            (which 6 years later came to be written up as
            %a{:href => "#KapulkinLumsdaineVoevodsky12"} Kapulkin, Lumsdaine &amp; Voevodsky12
            and another 10 years later was published as
            = succeed ")." do
              %a{:href => "#KapulkinLumsdaine21"} Kapulkin &amp; Lumsdaine 2021
          %p
            The first mentioning by Voevodsky of the term “univalence” by email is 3.5 years later, from
            %a{:href => "https://groups.google.com/g/homotopytypetheory/c/K_4bAZEDRvE/m/3N2xxxfSAAAJ"} Dec. 30 2009
            (according to
            = succeed ")." do
              %a{:href => "https://groups.google.com/g/homotopytypetheory/c/K_4bAZEDRvE/m/-Lp5dxTTAAAJ"} Grayson, Oct. 2017
          %p
            The earliest recorded statement of the univalence axiom by Voevodsky’s hand date may be
            %a{:href => "#Voevodsky10"} Voevodsky (2010), p. 11
          %p see also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"}> Vladimir Voevodsky
              ,
              %em The equivalence axiom and univalent models of type theory
              (Talk at CMU on February 4, 2010) (
              %a{:href => "https://arxiv.org/abs/1402.5556"}> arXiv:1402.5556
              )
          %p Later in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"}> Vladimir Voevodsky
              ,
              = succeed "," do
                %em
                  %a{:href => "https://www.ias.edu/ideas/2014/voevodsky-origins"} The Origins and Motivations of Univalent Foundations
          %p appears the claim that:
          %blockquote
            %p have been working on the ideas that led to the discovery of univalent models since 2005 and gave the first public presentation on this subject at Ludwig-Maximilians-Universität München in November 2009.
          %p A comprehensive discussion finally appears in the textbook:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/UF-IAS-2012"}> Univalent Foundations Project
              , p. 4 &amp; Sec. 2.10 in:
              %em
                %a.existingWikiWord{:href => "/nlab/show/Homotopy+Type+Theory+--+Univalent+Foundations+of+Mathematics"} Homotopy Type Theory – Univalent Foundations of Mathematics
              (2013) &amp;lbrack;
              %a{:href => "http://homotopytypetheory.org/book/"}> web
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://hottheory.files.wordpress.com/2013/03/hott-online-323-g28e4374.pdf"} pdf
          %p
            Voevodsky’s (
            %a{:href => "#Bousfield06"}> Bousfield’s
            ) original idea for the
            %a.existingWikiWord{:href => "/nlab/show/universal+Kan+fibration"} universal Kan fibration
            as a model for a univalent universe in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            %a.existingWikiWord{:href => "/nlab/show/infinity-groupoids"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-groupoids
            was eventually published as:
          %ul
            %li#KapulkinLumsdaine21
              %a.existingWikiWord{:href => "/nlab/show/Chris+Kapulkin"}> Chris Kapulkin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+LeFanu+Lumsdaine"} Peter LeFanu Lumsdaine
              = succeed "," do
                %em The Simplicial Model of Univalent Foundations (after Voevodsky)
              %strong 23
              (2021) 2071–2126
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1211.2851"} arXiv:1211.2851
              %a{:href => "https://doi.org/10.4171/jems/1050"} doi:10.4171/jems/1050
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p Exposition and survey
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Aczel"}> Peter Aczel
                ,
                = succeed "," do
                  %em On Voevodsky’s Univalence Axiom
                = succeed "," do
                  %a{:href => "http://www.cs.man.ac.uk/~petera/Recent-Slides/Edinburgh-2011-slides_pap.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Aczel-Univalence.pdf", :title => "pdf"} pdf
              %blockquote
                %p
                  (in view of the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/structure+identity+principle"} structure identity principle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
                ,
                %em Homotopy type theory, IV
                (
                %a{:href => "http://golem.ph.utexas.edu/category/2011/04/homotopy_type_theory_iv.html"}> blog post
                )
          %p Additional definition of univalent universes appeared in section 17.1 of
          %ul
            %li#Rijke22
              %a.existingWikiWord{:href => "/nlab/show/Egbert+Rijke"}> Egbert Rijke
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Homotopy+Type+Theory"} Introduction to Homotopy Type Theory
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/2212.11082"} arXiv:2212.11082
          %p as well as in this Google Groups thread:
          %ul
            %li#Licata16
              %a.existingWikiWord{:href => "/nlab/show/Dan+Licata"}> Dan Licata
              ,
              %em weak univalence with “beta” implies full univalence
              (
              %a{:href => "https://groups.google.com/forum/#!msg/homotopytypetheory/j2KBIvDw53s/YTDK4D0NFQAJ"}> web
              )
          %p
            An accessible account of Voevodsky’s proof (following
            = succeed ")" do
              %a{:href => "#Bousfield06"} Bousfield 06
            %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
            in
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            is univalent:
          %ul
            %li#KapulkinLumsdaineVoevodsky12
              %a.existingWikiWord{:href => "/nlab/show/Chris+Kapulkin"}> Chris Kapulkin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+LeFanu+Lumsdaine"} Peter LeFanu Lumsdaine
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"} Vladimir Voevodsky
              %em Univalence in simplicial sets
              \&amp;lbrack;
              %a{:href => "http://arxiv.org/abs/1203.2553"}> arXiv:1203.2553
              \&amp;rbrack;
          %p
            A quick elegant proof of the
            = succeed "/universal" do
              %a.existingWikiWord{:href => "/nlab/show/object+classifier"} object classifier
            %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} associated infinity-bundle
            in simplicial sets/
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-groupoids is in
          %ul
            %li#Moerdijk
              %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
              (notes by Chris Kapulkin),
              %em Fiber bundles and univalence
              (
              %a{:href => "http://www-home.math.uwo.ca/~kkapulki/notes/fiber_bundles_univalence.pdf"}> pdf
              )
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Colin+McLarty"}> Colin McLarty
              ,
              %em A univalent universe in finite order arithmetic
              (
              %a{:href => "http://arxiv.org/abs/1412.6714"}> arXiv:1412.6714
              )
          %p
            Implementation of univalence in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/proof+assistants"} proof assistants
          %p
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Agda"} Agda
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mart%C3%ADn+Escard%C3%B3"}> Martín Escardó
              ,
              = succeed "," do
                %em
                  %a{:href => "https://www.cs.bham.ac.uk/~mhe/HoTT-UF-in-Agda-Lecture-Notes/HoTT-UF-Agda.html#univalence"} Voevodsky’s univalence axiom
              %em Introduction to Univalent Foundations of Mathematics with Agda
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1911.00580"}> arXiv:1911.00580
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://www.cs.bham.ac.uk/~mhe/HoTT-UF-in-Agda-Lecture-Notes/HoTT-UF-Agda.html"} webpage
          %p
            %a.existingWikiWord{:href => "/nlab/show/cubical+Agda"}> cubical Agda
            \:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/1lab"}> 1lab
              ,
              %em
                %a{:href => "https://1lab.dev/1Lab.Univalence.html"} Univalence
          %p
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
          %ul
            %li
              %p
                %em
                  %a{:href => "https://github.com/HoTT/HoTT/blob/master/theories/Types/Universe.v"} HoTT/HoTT theories/Types/Universe.v
            %li
              %p
                %em
                  %a{:href => "https://github.com/HoTT/HoTT/blob/master/theories/UnivalenceAxiom.v"} HoTT/HoTT theories/UnivalenceAxiom.v
          %p
            A guided walk through the formal proof that univalence implies
            %a.existingWikiWord{:href => "/nlab/show/functional+extensionality"} functional extensionality
            is at
          %ul
            %li#BauerLumsdaine
              %a.existingWikiWord{:href => "/nlab/show/Andrej+Bauer"}> Andrej Bauer
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+LeFanu+Lumsdaine"} Peter LeFanu Lumsdaine
              %em
                %a.existingWikiWord{:href => "/nlab/show/Oberwolfach+HoTT-Coq+tutorial"} Oberwolfach HoTT-Coq tutorial
          %p
            Some details regarding the univalence axiom for
            %a.existingWikiWord{:href => "/nlab/show/weakly+Tarski+universes"} weakly Tarski universes
            appeared on MathOverflow in:
          %ul
            %li
              Madeleine Birchfield, Valery Isaev,
              = succeed "," do
                %em Univalence for weakly Tarski universes
              = succeed ")" do
                %a{:href => "https://mathoverflow.net/q/431723"} web
          %p
            A discussion of univalence in categories of
            %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
            over an
            %a.existingWikiWord{:href => "/nlab/show/inverse+category"} inverse category
            with values in a category for which univalence is already established is discussed in
          %ul#Shulman12
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Shulman"}> Michael Shulman
              ,
              %em Univalence for inverse diagrams, oplax limits, and gluing, and homotopy canonicity
              (
              %a{:href => "http://arxiv.org/abs/1203.3253"}> arXiv:1203.3253
              )
          %p
            This discusses
            %a.existingWikiWord{:href => "/nlab/show/canonicity"} canonicity
            of univalence in its section 13. Another approach to showing canonicity is (via
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/cubical+sets"} cubical sets
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"}> Thierry Coquand
              , Simon Huber,
              = succeed "," do
                %em A model of type theory in cubical sets
              = succeed "," do
                %a{:href => "http://www.cse.chalmers.se/~coquand/mod1.pdf"} pdf
              = succeed "," do
                %a{:href => "https://github.com/simhu/cubical"} Haskell code
              = succeed ")" do
                %a{:href => "https://groups.google.com/forum/#!topic/homotopytypetheory/GmXKEArD3HY"} discussion
          %p A proof of canonicity is presented in the talk
          %ul
            %li#Sattler19
              %a.existingWikiWord{:href => "/nlab/show/Christian+Sattler"}> Christian Sattler
              ,
              = succeed "," do
                %em Homotopy Canonicity
              = succeed ")" do
                %a{:href => "http://www.ii.uib.no/~bezem/abstracts/TYPES_2019_paper_110"} abstract
          %p On the issue of strict pullback of the univalent universe see
          %ul
            %li
              Univalent Foundations Mailing List,
              = succeed "," do
                %em
                  %a{:href => "https://groups.google.com/d/msg/univalent-foundations/Glo7NgNvhJA/4j9SewiFvQ0J"} Quotients
          %p
            The computational interpretation of univalence /
            %a.existingWikiWord{:href => "/nlab/show/canonicity"} canonicity
            is discussed in
          %ul#HarperLicata
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dan+Licata"}> Dan Licata
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Harper"} Robert Harper
                %em Computing with Univalence
                (2012) (
                %a{:href => "http://4wft.fmf.uni-lj.si/wp-content/uploads/2012/04/Licata.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Harper"}> Robert Harper
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Licata"} Daniel Licata
                %em Canonicity for 2-dimensional type theory
                (2011) (
                %a{:href => "http://www.cs.cmu.edu/~rwh/papers/2dtt-can/paper.pdf"}> pdf
                )
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Licata"} Daniel Licata
                = succeed "," do
                  %em The computational interpretation of HoTT (in 2D)
                %a.existingWikiWord{:href => "/nlab/show/UF-IAS-2012"} UF-IAS-2012
                (
                %a{:href => "http://video.ias.edu/stream&ref=1674"}> video
                )
            %li
              %p
                Simon Huber (with
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"} Thierry Coquand
                %em Towards a computational justification of the Axiom of Univalence
                , talk at
                %em TYPES 2011
                (
                %a{:href => "http://www.cse.chalmers.se/~simonhu/slides/types11.pdf"}> pdf
                )
            %li
              %p
                Bruno Barras,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"} Thierry Coquand
                %em A Generalization of Takeuti-Gandy Interpretation
                (
                %a{:href => "http://uf-ias-2012.wikispaces.com/file/view/semi.pdf"}> pdf
                )
          %p
            and realized in
            %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical type theory
            in
          %ul
            %li#Coquand13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"} Thierry Coquand
                (with
                %a.existingWikiWord{:href => "/nlab/show/Marc+Bezem"} Marc Bezem
                and
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/Simon+Huber"} Simon Huber
                = succeed "," do
                  %em Computational content of the Axiom of Univalence
                = succeed ")" do
                  %a{:href => "http://www.humboldt-kolleg.iam.unibe.ch/talks/Coquand.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cyril+Cohen"}> Cyril Cohen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"} Thierry Coquand
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Simon+Huber"} Simon Huber
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Anders+M%C3%B6rtberg"} Anders Mörtberg
                %em Cubical Type Theory: a constructive interpretation of the univalence axiom
                (
                %a{:href => "https://hal.inria.fr/hal-01378906/document"}> pdf
                )
            %li#BezemCoquandHuber17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Bezem"}> Marc Bezem
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"} Thierry Coquand
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Simon+Huber"} Simon Huber
                %em The univalence axiom in cubical sets
                (
                %a{:href => "https://arxiv.org/abs/1710.10941"}> arXiv:1710.10941
                )
          %p
            A study of the
            %a.existingWikiWord{:href => "/nlab/show/semantics"} semantic
            side of univalence in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-toposes"} (infinity,1)-toposes
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+%28infinity%2C1%29-categories"} locally cartesian closed (infinity,1)-categories
            is in
          %ul
            %li#GepnerKock12
              %a.existingWikiWord{:href => "/nlab/show/David+Gepner"}> David Gepner
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Joachim+Kock"} Joachim Kock
              %em Univalence in locally cartesian closed infinity-categories
              (
              %a{:href => "http://arxiv.org/abs/1208.1749"}> arXiv:1208.1749
              )
          %p
            This does not yet show that the univalence axiom in its usual form holds in the internal type theory of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-toposes"} (infinity,1)-toposes
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Tarski+universes"} Tarski universes
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/type+universes"} type universes
            %a{:href => "#Shulman12"} Shulman12
            above, and also in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Shulman"}> Michael Shulman
                ,
                = succeed "," do
                  %em The univalence axiom for elegant Reedy presheaves
                = succeed "." do
                  %a{:href => "http://arxiv.org/abs/1203.3253"} arXiv:1307.6248
            %li#Cisinski14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
                ,
                %em Univalent universes for elegant models of homotopy types
                (
                %a{:href => "http://arxiv.org/abs/1406.0058"}> arXiv:1406.0058
                )
          %p
            Finally, full proof that all
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            have
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentations
            by
            %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            which interpret (provide
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            with
            %a.existingWikiWord{:href => "/nlab/show/univalence"} univalent
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/type+universes"} type universes
          %ul
            %li#Shulman19
              %a.existingWikiWord{:href => "/nlab/show/Michael+Shulman"}> Michael Shulman
              ,
              %em
                All
                = succeed "-toposes" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
              (
              %a{:href => "https://arxiv.org/abs/1904.07004"}> arXiv:1904.07004
              ).
          %p
            Application of univalence to
            %a.existingWikiWord{:href => "/nlab/show/proof"} proof
            transfer:
          %ul
            %li
              Cyril Cohen, Enzo Crance, Assia Mahboubi,
              = succeed "," do
                %em Trocq: Proof Transfer for Free, With or Without Univalence
              = succeed "," do
                %em Programming Languages and Systems. ESOP 2024
              = succeed "," do
                %strong 14576
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/2310.14022"} arXiv:2310.14022
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-3-031-57262-3_10"} doi:10.1007/978-3-031-57262-3_10
          %p
            Some discussion about the univalence axiom in
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory+with+type+variables"} dependent type theory with type variables
            occurs in:
          %ul
            %li#CTZulip
              %em> Dependent Type Theory vs Polymorphic Type Theory
              , Category Theory Zulip (
              %a{:href => "https://categorytheory.zulipchat.com/#narrow/stream/229199-learning.3A-questions/topic/Dependent.20Type.20Theory.20vs.20Polymorphic.20Type.20Theory"}> web
              )
        .revisedby
