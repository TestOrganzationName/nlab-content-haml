            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            that is a
            %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
            between fibrant objects.
          %p
            Then the
            %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent
            %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
          .maruku-equation
