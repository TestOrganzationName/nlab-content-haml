          %h3#weaker_versions_of_univalence Weaker versions of univalence
          %p
            In the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
            %a{:href => "http://types2017.elte.hu/proc.pdf#page=93"} here
            that the univalence axiom can be simplified to the following special cases:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi unit
                    %mo :
                    %mi A
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi a
                        %mo :
                        %mi A
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} unit : A = \sum_{a:A} 1
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi flip
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi a
                        %mo :
                        %mi A
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi b
                        %mo :
                        %mi B
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi b
                        %mo :
                        %mi B
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi a
                        %mo :
                        %mi A
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} flip : (\sum_{a:A} \sum_{b:B} C(a,b)) = (\sum_{b:B} \sum_{a:A} C(a,b))
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi contract
                    %mo :
                    %mi IsContr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} contract: IsContr(A) \to (A=1)
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi unit
                      %mi β
                    %mo :
                    %mi coe
                    %mo{:stretchy => "false"} (
                    %mi unit
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} unit_\beta : coe(unit(a)) = (a,\star)
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi flip
                      %mi β
                    %mo :
                    %mi coe
                    %mo{:stretchy => "false"} (
                    %mi flip
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi a
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} flip_\beta : coe(flip(a,b,c)) = (b,a,c)
              \.
          %p
            The proof constructs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ua
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi A
                  %mo =
                  %mi B
                %annotation{:encoding => "application/x-tex"} ua(f): A=B
            (for
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo ≃
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A\simeq B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo =
                    %mi unit
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                  %mn 1
                  %mover
                    %mo =
                    %mi contract
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi b
                      %mo :
                      %mi B
                  %mi f
                  %mi a
                  %mo =
                  %mi b
                  %mover
                    %mo =
                    %mi flip
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi b
                      %mo :
                      %mi B
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                  %mi f
                  %mi a
                  %mo =
                  %mi b
                  %mover
                    %mo =
                    %mi contract
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi b
                      %mo :
                      %mi B
                  %mn 1
                  %mover
                    %mo =
                    %mi unit
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \overset{unit}{=} \sum_{a:A} 1 \overset{contract}{=} \sum_{a:A} \sum_{b:B} f a=b \overset{flip}{=} \sum_{b:B} \sum_{a:A} f a = b \overset{contract}{=} \sum_{b:B} 1 \overset{unit}{=} B
          %p
            and uses
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi unit
                    %mi β
                %annotation{:encoding => "application/x-tex"} unit_\beta
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi flip
                    %mi β
                %annotation{:encoding => "application/x-tex"} flip_\beta
            to compute that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coe
                    %mo{:stretchy => "false"} (
                    %mi ua
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} coe(ua(f))(a) = f(a)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coe
                    %mo{:stretchy => "false"} (
                    %mi ua
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                  %annotation{:encoding => "application/x-tex"} coe(ua(f)) = f
          %p
            This is weaker than univalence because in the absense of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
          %p
            In addition, unlike the definitions above, this definition of univalence cannot be generalized to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/reflexive+graphs"} reflexive graphs
          %h3#resizing_the_identity_types Resizing the identity types
          %p
            Due to the usual
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
            %a.existingWikiWord{:href => "/nlab/show/resize"} resize
            the
            %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            of a universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            to be
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/small+type"} small
          %p
            Resizing the identity types allows for one more version of univalence, where we replace the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            between the identity type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo =
                    %mi U
                  %mi B
                %annotation{:encoding => "application/x-tex"} A =_U B
            and the type of equivalences of the universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≃
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \simeq B
            in the univalence axioms with the
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            of the universe
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi U
                %annotation{:encoding => "application/x-tex"} A:U
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} B:U
            %a.existingWikiWord{:href => "/nlab/show/identification"} identification
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} ua
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi U
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi U
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ua}(A, B):(T(A) =_U T(B)) =_{U} (T(A) \simeq T(B))
          %p
            This implies the usual version of internal univalence either through
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identification+elimination"} identification elimination
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/transport"} transport
            %a.existingWikiWord{:href => "/nlab/show/action+on+identifications"} action on identifications
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
          %h3#internal_univalence Internal univalence
          %p
            Suppose the
            %a.existingWikiWord{:href => "/nlab/show/Tarski+universe"} Tarski universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            has
          %ul
            %li
              internal identity types
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi{:mathvariant => "normal"} Id
                        %mi U
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi A
                          %mo :
                          %mi U
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \mathrm{Id}^U:\prod_{A:U} T(A) \times T(A) \to U
            %li
              internal dependent product types
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mi U
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo .
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mrow
                        %mo (
                        %mi U
                        %mo ×
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi A
                            %mo :
                            %mi U
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi U
                        %mo )
                      %mo →
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \Pi_U (x:(-)).(-)(x):\left(U \times \prod_{A:U} T(A) \to U\right) \to U
            %li
              internal dependent sum types
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi U
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo .
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mrow
                        %mo (
                        %mi U
                        %mo ×
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi A
                            %mo :
                            %mi U
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi U
                        %mo )
                      %mo →
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \Sigma_U (x:(-)).(-)(x):\left(U \times \prod_{A:U} T(A) \to U\right) \to U
          %p
            We assume the weakest notion of Tarski universe, where the type reflection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(A)
            of each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi U
                %annotation{:encoding => "application/x-tex"} A:U
            is only equivalent to the external type, since (judgmentally, propositionally, typally) strict Tarski universes are weakly Tarski universes, because the
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
            and
            %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositional equality
            imply equivalence of types by the structural rules for judgmental and propostional equality, and
            %a.existingWikiWord{:href => "/nlab/show/typal+equality"} typal equality
            in a
            %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
            of types imply equivalence of types by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identification+elimination"} identification elimination
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/transport"} transport
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action+on+identifications"} action on identifications
          %p
            This allows us to define the internal type of equivalences
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msubsup
                      %mo ≃
                      %mi U
                      %mi{:mathvariant => "normal"} in
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \simeq_U^\mathrm{in} B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} canonical
                    %mo ≃
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msubsup
                    %mo ≃
                    %mi U
                    %mi{:mathvariant => "normal"} in
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{canonical}_\simeq(A, B):T(A \simeq_U^\mathrm{in} B) \simeq (T(A) \simeq T(B))
          %p
            This implies that the equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(A) \simeq T(B)
            is
            = succeed "-small," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %a.existingWikiWord{:href => "/nlab/show/transport"} transport
            being an
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            then implies that in any universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            which is closed under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi U
                %annotation{:encoding => "application/x-tex"} A:U
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} B:U
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo =
                    %mi U
                  %mi B
                %annotation{:encoding => "application/x-tex"} A =_U B
            is
            = succeed "-small." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p The internal univalence axiom states that the canonical function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} idtointernalequiv
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msub
                    %mo =
                    %mi U
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msubsup
                    %mo ≃
                    %mi U
                    %mi{:mathvariant => "normal"} in
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{idtointernalequiv}(A, B):(A =_U B) \to T(A \simeq_U^\mathrm{in} B)
          %p is an equivalence of types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} idtoequiv
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msub
                    %mo =
                    %mi U
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msubsup
                    %mo ≃
                    %mi U
                    %mi{:mathvariant => "normal"} in
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{idtoequiv}(A, B):(A =_U B) \simeq T(A \simeq_U^\mathrm{in} B)
          %p
            This is not definable for
            %a.existingWikiWord{:href => "/nlab/show/strongly+predicative"} strongly predicative
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+universes"} type universes
            %a.existingWikiWord{:href => "/nlab/show/strongly+predicative"} strongly predicative
            %a.existingWikiWord{:href => "/nlab/show/type+universes"} type universes
            are by definition not closed under
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
          %p
            In addition, the internal and external versions of univalence imply each other. In order to show that the two axioms imply each other, we need to show that there is an
            %a.existingWikiWord{:href => "/nlab/show/identification"} identification
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} canonical
                    %mo ≃
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} idtoequiv
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi{:mathvariant => "normal"} trans
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i(p):\mathrm{canonical}_\simeq(A, B)(\mathrm{idtoequiv}(A, B)(p)) =_{T(A) \simeq T(B)}  \mathrm{trans}^{T}(A, B)(p)
          %p
            for all identifications
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi A
                    %msub
                      %mo =
                      %mi U
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p:A =_U B
            %a.existingWikiWord{:href => "/nlab/show/J+rule"} J rule
            it is enough to show that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} canonical
                    %mo ≃
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{canonical}_\simeq(A, A)
            maps the identity equivalence of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msubsup
                    %mo ≃
                    %mi U
                    %mi{:mathvariant => "normal"} in
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(A \simeq_U^\mathrm{in} A)
            to the identity equivalence in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(A) \simeq T(A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msubsup
                    %mo ≃
                    %mi U
                    %mi{:mathvariant => "normal"} in
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(A \simeq_U^\mathrm{in} A)
            is just the
            %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} canonical
                    %mo ≃
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi x
                  %mo .
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{canonical}_\simeq^{-1}(A, A)(\lambda x.x)
            the above statement is always true. Thus, if the universe is closed under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product+types"} dependent product types
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            the two univalence axioms imply each other and both define the same notion of univalent universe.
          %h2#stricter_variants_of_univalence Stricter variants of univalence
          %p
            There are a few variants of univalence that are stricter than the usual axiom of univalence in that they use
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equalities"} judgmental equalities
            and thus have to be expressed as (possibly multiple)
            %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
            instead of an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/axiom"} axiom
          %h3#using_definitional_isomorphism Using definitional isomorphism
          %p
            There is a variant of univalence called
            %strong definitional univalence
            or
            = succeed "," do
              %strong judgmental univalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y:A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} idtofam
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{idtofam}(x, y)
            inductively defined in the previous section is a
            %a.existingWikiWord{:href => "/nlab/show/definitional+isomorphism"} definitional isomorphism
            instead of an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
          %p
            Unlike the case for the usual typal variant of univalence, where one can use an element of an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+type"} equivalence type
            %a.existingWikiWord{:href => "/nlab/show/definitional+isomorphism+types"} definitional isomorphism types
            to express definitional univalence, because the large recursion principle of the
            %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
            together with
            %a.existingWikiWord{:href => "/nlab/show/definitional+isomorphism+types"} definitional isomorphism types
            implies
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equality+reflection"} equality reflection
          %p
            %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
            ‘s model of
            %a.existingWikiWord{:href => "/nlab/show/higher+observational+type+theory"} higher observational type theory
            uses the type of
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            in definitional univalence.
          %h3#using_judgmental_equality_of_types Using judgmental equality of types
          %p
            There is another variant of univalence where we replace the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            between the identity type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo =
                    %mi U
                  %mi B
                %annotation{:encoding => "application/x-tex"} A =_U B
            and the type of equivalences of the universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≃
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \simeq B
            in the univalence axioms with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/judgmental+equality+of+types"} judgmental equality of types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi U
                %annotation{:encoding => "application/x-tex"} A:U
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo :
                    %mi U
                  %annotation{:encoding => "application/x-tex"} B:U
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo =
                      %mi U
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ≃
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} type
                  %annotation{:encoding => "application/x-tex"} (A =_U B) \equiv (A \simeq B) \; \mathrm{type}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
            %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
            of universes
            %em are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalences+of+types"} equivalences of types
          %p
            Such univalent Tarski universes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
