                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} U_1\colon D \to C
            satisfies the hypotheses of the crude monadicity theorem and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mn 2
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} U_2\colon C \to B
            is any monadic functor then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mn 2
                  %mo ∘
                  %msub
                    %mi U
                    %mn 1
                %annotation{:encoding => "application/x-tex"} U_2 \circ U_1
            is monadic. Furthermore, if both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mn 1
                %annotation{:encoding => "application/x-tex"} U_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mn 2
                %annotation{:encoding => "application/x-tex"} U_2
            both obey the hypotheses of the crude monadicity theorem, so does
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 2
                    %mo ∘
                    %msub
