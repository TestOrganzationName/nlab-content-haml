              is
              %a.existingWikiWord{:href => "/nlab/show/monadic"} monadic
              (or tripleable) if and only if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
