                = succeed ")" do
                  %a{:href => "https://dx.doi.org/10.4310/HHA.2016.v18.n1.a3"} doi:10.4310/HHA.2016.v18.n1.a3
          %p See also:
          %ul
            %li#Lurie09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , Section A.3.2 of:
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
            %li#Spitzweck10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Markus+Spitzweck"}> Markus Spitzweck
                ,
                = succeed "," do
                  %em Homotopy limits of model categories over inverse index categories
                = succeed ")" do
