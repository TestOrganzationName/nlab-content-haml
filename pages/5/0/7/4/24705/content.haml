                    %a.existingWikiWord{:href => "/nlab/show/quantum+state"} quantum state
                    being measured by
                    %a.existingWikiWord{:href => "/nlab/show/orthogonal+linear+basis"} orthogonal
                    %a.existingWikiWord{:href => "/nlab/show/projection+operator"} projection
                    to the
                    %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
                    of the
                    = succeed "th" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi b
                          %annotation{:encoding => "application/x-tex"} b
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
