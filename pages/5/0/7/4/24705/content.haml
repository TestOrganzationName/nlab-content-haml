                which is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal
                %a.existingWikiWord{:href => "/nlab/show/strong+closed+functor"} strong closed
                and extends to a
                %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
                %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
                (with
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
