            by
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+morphisms"} Kleisli morphisms
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Q
                  %annotation{:encoding => "application/x-tex"} \mathrm{Q}
          %p
            For example for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo =
                  %mi Bit
                %annotation{:encoding => "application/x-tex"} B = Bit
            the type of classical
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bits"} bits
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
