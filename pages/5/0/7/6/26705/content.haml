          %h2#idea Idea
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/algebraic+pattern"} algebraic pattern
            is a blueprint for a notion of functors on a fixed category satisfying a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Segal+condition"} Segal condition
          %h2#definitions Definitions
          %p
          .num_defn{:id => "Algebraic pattern definition"}
            %h6 Definition
            %p
            %p
              An
              %strong
                %a.existingWikiWord{:href => "/nlab/show/algebraic+pattern"} algebraic pattern
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              together with the following data:
            %ul
              %li
                %p
                  a pair of
                  %a.existingWikiWord{:href => "/nlab/show/wide+subcategories"} wide subcategories
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝒪
                            %mi{:mathvariant => "normal"} int
                          %mo ,
                          %msup
                            %mi 𝒪
                            %mi{:mathvariant => "normal"} act
                          %mo ⊂
                          %mi 𝒪
                        %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\mathrm{int}},\mathcal{O}^{\mathrm{act}} \subset \mathcal{O}
                  %em inert
                  and
                  %em active
                  morphisms, and
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝒪
                            %mi{:mathvariant => "normal"} el
                          %mo ⊂
                          %msup
                            %mi 𝒪
                            %mi{:mathvariant => "normal"} int
                        %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\mathrm{el}} \subset \mathcal{O}^{\mathrm{int}}
                  = succeed "," do
                    %em elementary objects
            %p
              subject to the condition that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f:X \rightarrow X'
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mi i
                    %mi Y
                    %mover
                      %mo →
                      %mi a
                    %mi X
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} X \xrightarrow{i} Y \xrightarrow{a} X'
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %msup
                      %mi 𝒪
                      %mi{:mathvariant => "normal"} int
                  %annotation{:encoding => "application/x-tex"} i \in \mathcal{O}^{\mathrm{int}}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %msup
                      %mi 𝒪
                      %mi{:mathvariant => "normal"} act
                  %annotation{:encoding => "application/x-tex"} r \in \mathcal{O}^{\mathrm{act}}
              is contractible.
          %p
            The pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝒪
                    %mi{:mathvariant => "normal"} int
                  %mo ,
                  %msup
                    %mi 𝒪
                    %mi{:mathvariant => "normal"} act
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{O}^{\mathrm{int}},\mathcal{O}^{\mathrm{act}})
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/factorization+system"} factorization system
          %p
            It is customary to abusively refer to the quadruple
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒪
                  %mo ,
                  %msup
                    %mi 𝒪
                    %mi{:mathvariant => "normal"} int
                  %mo ,
                  %msup
                    %mi 𝒪
                    %mi{:mathvariant => "normal"} act
                  %mo ,
                  %msup
                    %mi 𝒪
                    %mi{:mathvariant => "normal"} el
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\mathcal{O},\mathcal{O}^{\mathrm{int}},\mathcal{O}^{\mathrm{act}},
                  \\mathcal{O}^{\mathrm{el}})
            simply as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ↦
                %annotation{:encoding => "application/x-tex"} \mapsto
            and active morphisms as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇝
                  %annotation{:encoding => "application/x-tex"} \rightsquigarrow
            = succeed "." do
              %em Segal objects
          %p
          .num_defn{:id => "Segal object definition"}
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              be an algebraic pattern and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a complete
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              %strong
                Segal
                = succeed "-object" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                      %annotation{:encoding => "application/x-tex"} \mathcal{O}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi 𝒪
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    F:\mathcal{O} \rightarrow \mathcal{C}
            %p
              subject to the condition that, for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo ∈
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} Z \in \mathcal{O}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo →
                    %munder
                      %mi lim
                      %mover
                        %mrow
                          %mi E
                          %mo ∈
                          %msup
                            %mi 𝒪
                            %mi{:mathvariant => "normal"} el
                        %mrow
                          %mi Z
                          %mo ↦
                          %mi E
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F(Z) \rightarrow \lim_{\stackrel{Z \mapsto E}{E \in \mathcal{O}^{\mathrm{el}}}}F(E)
            %p is an equivalence.
          %p
            By Lemma 2.9 of
            = succeed "," do
              %a{:href => "#Chu19"} Chu-Hangseng
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi 𝒪
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} F:\mathcal{O} \rightarrow \mathcal{C}
            whose restriction to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒪
                    %mi{:mathvariant => "normal"} int
                %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\mathrm{int}}
            are right
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Kan+extension"} Kan extended
            from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒪
                      %mi{:mathvariant => "normal"} el
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\mathrm{el}}
          %p
            One example of this is the pattern
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔽
                      %mo *
                      %mo ♭
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_*^{\flat}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_*
            of finite pointed sets with
          %ul
            %li
              %p
                inert morphisms given by those
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mo{:stretchy => "false"} ⟨
                      %mi n
                      %mo{:stretchy => "false"} ⟩
                      %mo →
                      %mo{:stretchy => "false"} ⟨
                      %mi m
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \phi:\langle n \rangle \rightarrow \langle m \rangle
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msup
                        %mi φ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} |\varphi^{-1}(j)| = 1
                for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                        %mo ≠
                        %mo *
                      %annotation{:encoding => "application/x-tex"} j \neq *
            %li
              %p
                active morphisms given by those
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ϕ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mo *
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \phi^{-1}(*) = \{*\}
            %li
              %p
                elementary objects spanned by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mn 1
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} \langle 1 \rangle
          %p
            The resulting
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of Segal
            = succeed "-objects" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔽
                      %mo *
                      %mo ♭
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_*^{\flat}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            consists of the
            %a.existingWikiWord{:href => "/nlab/show/%CE%93-space"} Γ-objects
            in
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebra"} E∞ algebras
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            with the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+%28%E2%88%9E%2C1%29-category"} cartesian symmetric monoidal structure
          %p
            In particular, applying this to the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Cat
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \mathrm{Cat}_\infty
            of small
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
            and applying
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} unstraightening
            yields a distinguished subcategory of
            %a.existingWikiWord{:href => "/nlab/show/cocartesian+fibrations"} cocartesian fibrations
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                %annotation{:encoding => "application/x-tex"} \mathcal{O}
            satisfying
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Segal+conditions"} Segal conditions
            = succeed "." do
              %em Segal fibrations
          %p
            Relaxing the condition that Segal fibrations have underlying
            %a.existingWikiWord{:href => "/nlab/show/cocartesian+fibrations"} cocartesian fibrations
            then yields the following notion,
            %a{:href => "#chu19"} originally
            called
            = succeed "." do
              %em weak Segal fibrations
          %p
          .num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              be an algebraic pattern. A functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mi 𝒫
                    %mo →
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \pi:\mathcal{P} \rightarrow \mathcal{O}
              is called a
              %em fibrous pattern
              if it satisfies the following conditions:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒫
                      %annotation{:encoding => "application/x-tex"} \mathcal{P}
                  has
                  = succeed "-cocartesian" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi π
                        %annotation{:encoding => "application/x-tex"} \pi
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒪
                        %annotation{:encoding => "application/x-tex"} \mathcal{O}
              %li
                %p
                  For all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Z
                          %mo ∈
                          %mi 𝒪
                        %annotation{:encoding => "application/x-tex"} Z \in \mathcal{O}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒫
                        %msub
                          %mo ×
                          %mi 𝒪
                        %msubsup
                          %mi 𝒪
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi Z
                          %mi{:mathvariant => "normal"} act
                        %mo →
                        %msubsup
                          %mi 𝒪
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi Z
                          %mi{:mathvariant => "normal"} act
                        %msub
                          %mo ×
                          %mrow
                            %munder
                              %mi lim
                              %mrow
                                %mi E
                                %mo ↦
                                %mi Z
                            %msubsup
                              %mi 𝒪
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mi E
                              %mi{:mathvariant => "normal"} act
                        %mrow
                          %mo (
                          %munder
                            %mi lim
                            %mrow
                              %mi E
                              %mo ↦
                              %mi Z
                          %mi 𝒫
                          %msub
                            %mo ×
                            %mi 𝒪
                          %msubsup
                            %mi 𝒪
                            %mrow
                              %mo{:stretchy => "false"} /
                              %mi E
                            %mi{:mathvariant => "normal"} act
                          %mo ,
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \mathcal{P} \times_{\mathcal{O}}     \mathcal{O}^{\mathrm{act}}_{/Z}   \rightarrow   \mathcal{O}^{\mathrm{act}}_{/Z}     \times_{     \lim_{E \mapsto Z}     \mathcal{O}^{\mathrm{act}}_{/E}}   \left(\lim_{E \mapsto Z} \mathcal{P}      \times_{\mathcal{O}}       \mathcal{O}^{\mathrm{act}}_{/E},\right)
                %p
                  is an equivalence, where the limits run across all inert maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo ↦
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} E \mapsto Z
                  with elementary domain.
            %p
          %p
            One of the main reasons to use algebraic patterns over the categorical patterns of
            %a{:href => "https://people.math.harvard.edu/~lurie/papers/HA.pdf"} Higher Algbera
            is the relative ease of constructing functoriality in families of examples. The central concept driving this is that of a Segal morphism.
          %p
          .num_defn
            %h6 Definition
            %p
              A functor of algebraic patterns
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi 𝒪
                    %mo →
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} F:\mathcal{O} \rightarrow \mathcal{P}
              is called a
            %ul
              %li
                %p
                  %em Segal morphism
                  if the pullback functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi F
                          %mo *
                        %mo :
                        %mi{:mathvariant => "normal"} Fun
                        %mo{:stretchy => "false"} (
                        %mi 𝒫
                        %mo ,
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi{:mathvariant => "normal"} Fun
                        %mo{:stretchy => "false"} (
                        %mi 𝒪
                        %mo ,
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F^*:\mathrm{Fun}(\mathcal{P}, \mathcal{C}) \rightarrow \mathrm{Fun}(\mathcal{O}, \mathcal{C})
                  preserves Segal objects for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  %em strong Segal morphism
                  if for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Z
                          %mo ∈
                          %mi 𝒪
                        %annotation{:encoding => "application/x-tex"} Z \in \mathcal{O}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi 𝒪
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi Z
                          %mi{:mathvariant => "normal"} el
                        %mo →
                        %msubsup
                          %mi 𝒪
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi Z
                            %mo{:stretchy => "false"} )
                          %mi{:mathvariant => "normal"} el
                      %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\mathrm{el}}_{/Z} \rightarrow \mathcal{O}^{\mathrm{el}}_{/F(Z)}
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/final+%28infinity%2C1%29-functor"} initial
            %p
          %p
            By Lemma 4.5 of
            = succeed "," do
              %a{:href => "#Chu19"} Chu-Haugseng
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F^*
            preserves Segal spaces. As developed in
            = succeed "," do
              %a{:href => "#Barkan22"} Barkan-Haugseng-Steinebrunner
          %h2#examples Examples
          %ul
            %li
              %p
                By Proposition 4.1.7 of
                = succeed "," do
                  %a{:href => "#Barkan22"} Barkan-Haugseng-Steinebrunner
                = succeed "-fibrous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi 𝔽
                          %mo *
                          %mo ♭
                      %annotation{:encoding => "application/x-tex"} \mathbb{F}_*^{\flat}
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-operads"} (∞,1)-operads
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝔽
                        %mo *
                        %mo ♮
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_*^{\natural}
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔽
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_*
                with the usual inert and active morphisms together with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                      %mo ,
                      %mo{:stretchy => "false"} ⟨
                      %mn 1
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \emptyset, \langle 1 \rangle
                as elementary objects, the
                = succeed "-fibrous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi 𝔽
                          %mo *
                          %mo ♮
                      %annotation{:encoding => "application/x-tex"} \mathbb{F}_*^{\natural}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+%28%E2%88%9E%2C1%29-operads"} generalized (∞,1)-operads
            %li
              %p
                More generally, when G is a finite group, the
                %a.existingWikiWord{:href => "/nlab/show/G-category"} G-category
                of finite pointed
                %a.existingWikiWord{:href => "/nlab/show/G-sets"} G-sets
                admits a similar pattern structure
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %munder
                            %mi 𝔽
                            %mo ̲
                          %mrow
                            %mi G
                            %mo ,
                            %mo *
                          %mo ♭
                      %annotation{:encoding => "application/x-tex"} \underline{\mathbb{F}}_{G,*}^{\flat}
                %a.existingWikiWord{:href => "/nlab/show/G-commutative+monoids"} G-commutative monoids
                and whose fibrous patterns are precisely the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/G-%E2%88%9E-operads"} G-∞-operads
          %p
            Both of these examples are more easily presented via span patterns. The theorem relating these is Proposition 5.2.14 of
            = succeed "." do
              %a{:href => "#Barkan22"} Barkan-Haugseng-Steinebrunner
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Span
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Span}(\mathbb{F}_G)
            whose inert maps are backwards, active maps are forwards, and elementary objects are transitive
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orbit+category"} G-sets
          %p
          .num_theorem
            %h6 Theorem
            %p
              The forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mrow
                        %mi G
                        %mo ,
                        %mo *
                    %mo →
                    %mi{:mathvariant => "normal"} Span
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔽
                      %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_{G,*} \rightarrow \mathrm{Span}(\mathbb{F}_G)
              lifts to a Segal morphism of patterns, which induces an equivalence on the categories of Segal objects and fibrous patterns.
          %ul
            %li
              %p
                The category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                    %annotation{:encoding => "application/x-tex"} \Delta^{\op}
                has two pattern structures
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Δ
                          %mrow
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                            %mo ,
                            %mo ♮
                        %mo ,
                        %msup
                          %mi Δ
                          %mrow
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                            %mo ,
                            %mo ♭
                      %annotation{:encoding => "application/x-tex"} \Delta^{\op,\natural}, \Delta^{\op, \flat}
                %a.existingWikiWord{:href => "/nlab/show/Segal+spaces"} Segal spaces
                (i.e.
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-categories"} ∞-categories
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/E-n+algebra"} E1 algebras
            %li
              %p
                The
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mrow
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                          %mo ,
                          %mi n
                          %mo ,
                          %mo ♮
                    %annotation{:encoding => "application/x-tex"} \Delta^{\op, n, \natural}
                parameterizes
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/n-fold+category"} n-fold ∞-categories
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mrow
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                          %mo ,
                          %mi n
                          %mo ,
                          %mo ♭
                    %annotation{:encoding => "application/x-tex"} \Delta^{\op, n, \flat}
                models
                = succeed "-spaces." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔼
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{E}_n
            %li
              %p
                The
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/categorical+wreath+product"} wreath product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Θ
                        %mi n
                      %mo :
                      %mo =
                      %mi Δ
                      %mo ≀
                      %mi ⋯
                      %mo ≀
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Theta_n := \Delta \wr \cdots \wr \Delta
                has on its opposite two interesting pattern structures; the pattern
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Θ
                        %mi n
                        %mrow
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                          %mo ,
                          %mo ♮
                    %annotation{:encoding => "application/x-tex"} \Theta_n^{\op,\natural}
                models
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-categories"} (∞,n)-categories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Θ
                        %mi n
                        %mrow
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                          %mo ,
                          %mo ♭
                    %annotation{:encoding => "application/x-tex"} \Theta_n^{\op,\flat}
                models
                = succeed "-spaces." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔼
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{E}_n
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒮
                        %mi m
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}_m
                denote the
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/m-finite+spaces"} m-finite spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Span
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒮
                        %mi m
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Span}(\mathcal{S}_{m})
                models
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/m-commutative+monoids"} m-commutative monoids
            %li
              %p
                The opposite
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                    %annotation{:encoding => "application/x-tex"} \Omega^{\op}
                of the dendroidal category of
                %a{:href => "https://arxiv.org/abs/math/0701293"} Moerdijk-Weiss
                has a pattern structure
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mrow
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                          %mo ,
                          %mo ♮
                    %annotation{:encoding => "application/x-tex"} \Omega^{\op,\natural}
                whose segal objects are the Dendroidal Segal spaces of
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1010.4956"} Cisinski-Moerdijk
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/operads"} operads
