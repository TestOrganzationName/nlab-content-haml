                %annotation{:encoding => "application/x-tex"} H(x,t)
            which is immersion for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} t \in [0,1]
            and which induces on the level of differentials a homotopy for the tangent bundles) and that any two regular homotopies are themselves homotopic through regular homotopies leaving end points fixed. Then one just uses the homotopy invariance of vector bundles. Thus, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi M
                    %mi n
                %annotation{:encoding => "application/x-tex"} M^n
            admits an embedding into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mrow
                      %mi n
                      %mo +
                      %mi r
                %annotation{:encoding => "application/x-tex"} \mathbf{R}^{n+r}
            with a trivial normal bundle then one says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi M
                    %mi n
                %annotation{:encoding => "application/x-tex"} M^n
            has a
            = succeed "." do
              %strong stably trivial normal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi M
                    %mo +
                    %mi n
                %annotation{:encoding => "application/x-tex"} M^n_+
            is the union of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            with a disjoint base point, then there is a homeomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi M
                    %mi n
                  %mo ×
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mi r
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi Σ
                    %mi r
                  %msubsup
                    %mi M
                    %mo +
                    %mi n
                %annotation{:encoding => "application/x-tex"} T (M^n\times \mathbf{R}^{r})\cong \Sigma^r M^n_+
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mi r
                %annotation{:encoding => "application/x-tex"} \Sigma^r
            denotes the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi r
                    %mo ×
                    %msubsup
                      %mi M
                      %mo +
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi r
                    %mo ∧
                    %msub
                      %mi M
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S^r\times M^n_+)/(S^r\wedge M_+)
