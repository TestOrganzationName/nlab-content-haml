          .num_remark
            %h6#remark Remark
            %p
              There is always an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                    %mo ⊕
                    %msub
                      %mi N
                      %mi i
                    %mi X
                    %mo ≃
                    %mi T
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    T X \oplus N_i X  \simeq T Y|_X
                    \\,,
            %p
              but it is not canonically given, hence in particular cannot it general be chosen
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturally
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is equipped with a
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/vector"} vector
              %em orthogonal
              to (“normal to”) the vectors in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                    %mo :
                    %mo =
