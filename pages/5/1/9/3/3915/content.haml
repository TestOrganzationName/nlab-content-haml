              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %strong normal bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              relative to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is the
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi i
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    N_i X  \to X
            %p
              defined as the
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiberwise
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi i
                    %mi X
                    %mo =
                    %mfrac
                      %mrow
                        %msup
                          %mi i
                          %mo *
                        %mi T
                        %mi Y
                      %mrow
                        %mi T
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    N_i X =\frac{i^* T Y}{T X}
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is equipped with
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              structure then this is equivalently the space of
              %a.existingWikiWord{:href => "/nlab/show/tangent+vectors"} tangent vectors
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              which are
              %a.existingWikiWord{:href => "/nlab/show/normal+vectors"} normal vectors
              to the
              %a.existingWikiWord{:href => "/nlab/show/tangent+vectors"} tangent vectors
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            The pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mi T
                  %mi Y
                %annotation{:encoding => "application/x-tex"} i^* T Y
            can be of course interpreted as the restriction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi X
                  %annotation{:encoding => "application/x-tex"} T Y|_X
            = succeed "wise" do
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of the fiber of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            by the fiber of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x \in X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi x
                  %mo =
                  %msub
                    %mi T
