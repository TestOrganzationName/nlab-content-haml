            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            constitute a
            %a.existingWikiWord{:href => "/nlab/show/linear+homotopy+type+theory"} linear homotopy type theory
            (
            %a{:href => "#Schreiber14"}> Schreiber 14
            ).
