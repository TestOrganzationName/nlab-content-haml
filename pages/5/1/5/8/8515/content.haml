              %li
                %a{:href => "#judgmental_equality_of_types"} Judgmental equality of types
              %ul
                %li
                  %a{:href => "#inference_rules_2"} Inference rules
                %li
                  %a{:href => "#congruence_rules_for_judgmental_equality_of_types"} Congruence rules for judgmental equality of types
              %li
                %a{:href => "#judgmental_equality_of_contexts"} Judgmental equality of contexts
