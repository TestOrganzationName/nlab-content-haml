              %a.existingWikiWord{:href => "/nlab/show/judgment"} judgment
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ≡
