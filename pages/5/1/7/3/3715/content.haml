          %p write this out and we get the equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi μ
                  %mi c
                  %mo +
                  %mi c
                  %mo ∘
                  %mi c
                  %mo =
                  %mn 0
                  %mo ,
                %annotation{:encoding => "application/x-tex"} d_\mu c + c \circ c = 0,
          %p
            or
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi μ
                    %mi c
                    %mo +
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo{:stretchy => "false"} [
                    %mi c
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d_\mu c + \frac{1}{2}[c,c] = 0
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+equation"} Maurer-Cartan equation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} C^\ast(A,A)[ [ t ] ]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi μ
                %annotation{:encoding => "application/x-tex"} d_\mu
            is actually a
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            = succeed "." do
