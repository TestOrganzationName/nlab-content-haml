                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d_\mu : C^{p}(V,V) \to C^{p+1}(V,V)
              be defined by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi μ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi μ
                      %mo ⊗
                      %mi x
                      %mo ±
                      %mi x
                      %mo ⊗
                      %mi μ
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi μ
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} d_\mu(x) = \mu \otimes x \pm x \otimes \mu = [\mu, x]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi μ
                    %mo ∘
                    %msub
                      %mi d
                      %mi μ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d_\mu \circ d_\mu = 0
              so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi d
                      %mi μ
                    %mo{:stretchy => "false"} )
