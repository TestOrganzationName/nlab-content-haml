              becomes a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebra"} differential graded algebra
              %a.existingWikiWord{:href => "/nlab/show/Hochschild+cochain+complex"} Hochschild cochain complex
              of the
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
