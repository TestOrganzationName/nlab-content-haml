            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi BD
                      %mi n
                  %annotation{:encoding => "application/x-tex"} BD_n
            = succeed "-algebras" do
