          #HKR.num_theorem
            %h6#theorem_6 Theorem
            %p
              %strong>
                (
                %a.existingWikiWord{:href => "/nlab/show/HKR+theorem"}> HKR theorem
                )
              \.
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi HH
                        %mi p
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ,
                      %msup
                        %mi Λ
                        %mi p
                      %mi TM
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} HH^p(A,A) = \Gamma(M, \Lambda^p TM)
          %p
            (Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi p
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^p(C^\infty(M),C^\infty(M))
            should be interpreted as
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                      %mi diff
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
