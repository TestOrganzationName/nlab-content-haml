          #UniversalEnvelopingAlgebraProvidesDeformationQuantizationAtLeastToOrder3.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (universal enveloping algebra provides
                %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
                at least up to order 3)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ( Sym(V), \{-,-\} )
              be a polynomial Poisson algebra (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PolynomialPoissonAlgebra"}
              = succeed ")" do
                %a.maruku-ref{:href => "#UniversalEnvelopingAlgebraOfPolynomialPoissonAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective
              up to order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}\cup \{\infty\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℏ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
