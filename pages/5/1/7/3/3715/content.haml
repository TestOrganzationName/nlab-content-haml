                    %mi g
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi h
                    %mo −
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ∘
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_f(g,h) = (f \circ g) \circ h - f \circ (g \circ h)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∘
                %annotation{:encoding => "application/x-tex"} \circ
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi f
                  %mo ∘
                  %mi g
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} |
                      %mi f
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} |
                      %mi g
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mi g
                  %mo ∘
                  %mi f
                %annotation{:encoding => "application/x-tex"} [f,g] = f \circ g - (-1)^{(|f| - 1)(|g|-1)} g \circ f
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi f
                  %mo{:stretchy => "false"} |
                  %mo =
                  %mi p
                %annotation{:encoding => "application/x-tex"} |f| = p
            when
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^p(V,V)
            %em
              graded
              %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            of degree -1.
          .num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo ∈
                    %msup
                      %mi C
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu \in C^2(V,V)
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mi V
                    %mo ⊗
                    %mi V
                    %mo →
                    %mi V
