              ). Note that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is associative iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo ∘
                    %mi μ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mu \circ \mu = 0
              iff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi μ
                      %mo ,
                      %mi μ
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} [\mu, \mu] = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi μ
                    %mo :
                    %msup
                      %mi C
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
