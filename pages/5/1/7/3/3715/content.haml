          #UniversalEnvelopingAlgebraOfPolynomialPoissonAlgebra.num_defn
            %h6#definition_6 Definition
            %p
              %strong (universal enveloping algebra of polynomial Poisson algebra)
            %p
              Given a polynomial Poisson algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Sym(V), \{-,-\})
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#PolynomialPoissonAlgebra"}
              %em universal enveloping algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{U}(V,\{-,-\})
              is the
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              which is the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of the
              %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              with a
              %a.existingWikiWord{:href => "/nlab/show/power+series"} formal variable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              adjoined by the two-sided ideal which is generated by the the
              = succeed "-Poisson" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⊗
                    %mi y
                    %mo −
                    %mi y
                    %mo ⊗
                    %mi x
                    %mo −
                    %mi ℏ
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} |
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{U}(V,\{-,-\})
                    \\;\coloneqq\;
                    T(V)/( x \otimes y - y \otimes x - \hbar \{x,y\} \vert x,y \in V )
                    \\,.
            %p This comes with the quotient projection linear map which we denote by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi 𝒰
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi ℏ
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho \;\colon\; T(V)[ [ \hbar ] ] \longrightarrow \mathcal{U}(V,\hbar\{-,-\})
                    \\,.
          %p
            (
            %a{:href => "#PenkavaVanhaecke00"}> Penkava-Vanhaecke 00, def. 3.1
            )
