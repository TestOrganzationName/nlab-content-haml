                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Hom_{diff}(C^\infty(M), C^\infty(M))
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+tensor"} Poisson tensor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo ⋅
                  %mo ,
                  %mo ⋅
                  %mo{:stretchy => "false"} }
                  %mo ∈
                  %msup
                    %mi HH
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mo ↦
                  %mspace{:width => "1em"}
                  %mi P
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %msup
                    %mi Λ
                    %mn 2
                  %mi TM
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \{ \cdot , \cdot \} \in HH^2(A,A) \quad \mapsto \quad P \in \Gamma(M, \Lambda^2 TM).
          %p
            The bracket in Hochschild cohomology (
            %a.existingWikiWord{:href => "/nlab/show/Gerstenhaber+bracket"}> Gerstenhaber bracket
            ) goes to the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo ⋅
                  %mo ,
                  %mo ⋅
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi G
                  %mspace{:width => "1em"}
                  %mo ↦
                  %mspace{:width => "1em"}
                  %mo{:stretchy => "false"} [
                  %mo ⋅
                  %mo ,
                  %mo ⋅
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi S
                  %mo .
                %annotation{:encoding => "application/x-tex"} [ \cdot , \cdot ]_G \quad \mapsto \quad [ \cdot, \cdot ]_S.
          %p
            For vector fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                %annotation{:encoding => "application/x-tex"} \xi
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
            %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
            satisfies (1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi ξ
                  %mo ,
                  %mi η
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi S
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi ξ
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\xi,\eta]_S = [\xi,\eta]
            (the Lie bracket), and (2)
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo ,
                    %mi β
                    %mo ∧
                    %mi γ
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo ,
                    %mi β
                    %mo{:stretchy => "false"} ]
                    %mo ∧
                    %mi γ
                    %mo ±
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo ,
                    %mi γ
                    %mo{:stretchy => "false"} ]
                    %mo ∧
                    %mi β
                  %annotation{:encoding => "application/x-tex"} [\alpha, \beta \wedge \gamma] = [\alpha,\beta] \wedge \gamma \pm [\alpha,\gamma] \wedge \beta
          %p
            In the Hochschild cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi HH
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} HH^\ast(A,A)
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi μ
                  %mi P
                  %mo ↦
                  %mn 0
                %annotation{:encoding => "application/x-tex"} d_\mu P \mapsto 0
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi P
                    %mo ,
                    %mi P
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi S
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} [P,P]_S = 0
            = succeed "." do
              %em
                we have a solution to M-C in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi t
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} H^\ast(A,A)[ [ t ] ]
          %h4#in_terms_of_differential_graded_lie_algebras In terms of differential graded Lie algebras
          .num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} L_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} L_2
              be
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+Lie+algebras"} differential graded Lie algebras
              (dgL). A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi L
                      %mn 1
                    %mo →
                    %msub
                      %mi L
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f : L_1 \to L_2
              is a homomorphism of dgLs that induces an isomorphism on homology.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} L_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} L_2
              are
              %strong quasi-isomorphic
              if there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              with quasi-isomorphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn 1
                      %mo ←
                      %mi M
                      %mo →
                      %msub
                        %mi L
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} L_1 \leftarrow M \rightarrow L_2
          #KontsevichDeformationTheorem.num_theorem
            %h6#theorem_7 Theorem
            %p
              %strong>
                (
                %a.existingWikiWord{:href => "/nlab/show/Kontsevich"}> Kontsevich
                )
              \. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} L_1
              is quasi-isomorphic to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} L_2
              then there is a solution to the M-C equation in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} L_1
              iff there is a solution to the M-C equation in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} L_2
          #KontsevichFormality.num_theorem
            %h6#theorem_8 Theorem
            %p
              %strong>
                (
                %a.existingWikiWord{:href => "/nlab/show/Kontsevich+formality"}> Kontsevich formality
                )
              \.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} C^\ast(A,A)[ [ t ] ]
              is quasi-isomorphic to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi t
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} H^\ast(A,A)[ [ t ] ]
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A = C^\infty(M)
          %p
            Hence there is a solution to M-C in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} C^\ast(A,A)[ [ t ] ]
          %h4#the_deligne_conjecture The Deligne conjecture
          %p
            We have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi d
                      %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C^*(A,A), d_\mu)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Gerstenhaber+bracket"} Gerstenhaber bracket
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ∪
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi a
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi a
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi a
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f \cup g) (a_1, \ldots, a_{p+q}) = \mu(f(a_1,\ldots,a_p), g(a_{p+1},\ldots,a_{p+q}))
          %p
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msup
                      %mi A
                      %mrow
                        %mo ⊗
                        %mi p
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f : A^{\otimes p} \to A
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %msup
                      %mi A
                      %mrow
                        %mo ⊗
                        %mi q
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} g : A^{\otimes q} \to A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi μ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∪
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi μ
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mi g
                    %mo ±
                    %mi f
                    %mo ∪
                    %msub
                      %mi d
                      %mi μ
                    %mi g
                  %annotation{:encoding => "application/x-tex"} d_\mu(f \cup g) = (d_\mu f) \cup g \pm f \cup d_\mu g
            %a.existingWikiWord{:href => "/nlab/show/Deligne+conjecture"} Deligne conjecture
            gives a relationship between these things.
          %p
            In
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi HH
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} HH^*(A,A)
          %ol
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo ⋅
                    %mo ,
                    %mo ⋅
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\cdot, \cdot]
              is a graded Lie bracket of degree -1.
            %li
              The cup product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∪
                  %annotation{:encoding => "application/x-tex"} \cup
              is graded commutative.
            %li
              The
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo ⋅
                      %mo ,
                      %mo ⋅
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\cdot,\cdot]
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∪
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo ∪
                    %mi c
                    %mo ±
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo ∪
                    %mi b
                  %annotation{:encoding => "application/x-tex"} [a, b \cup c] = [a,b] \cup c \pm [a,c] \cup b
              \.
          %p
            Such a thing is called a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Gerstenhaber+algebra"} Gerstenhaber algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^*(A,A)
          #Deligne.num_theorem
            %h6#theorem_9 Theorem
            %p
              %strong>
                (
                %a.existingWikiWord{:href => "/nlab/show/Deligne+conjecture"}> Deligne conjecture
                )
              \.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^*(A,A)
              is a
              = succeed "-algebra," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} G_\infty
              = succeed "." do
                %em up to coherent homotopy
          %h4#RelationToUniversalEnvelopingAlgebras Deformation by universal enveloping algebras
          %p
            It is a classical fact &amp;lbrack;
            %a{:href => "#Gutt83"}> Gutt 1983, §4 (4.2)
            , cf.
            = succeed "&rbrack;" do
              %a{:href => "#Gutt11"} Gutt 2011, §2.2
            %a.existingWikiWord{:href => "/nlab/show/universal+enveloping+algebra"} universal enveloping algebra
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            provides a deformation quantization of the corresponding
            %a.existingWikiWord{:href => "/nlab/show/Lie-Poisson+structure"} Lie-Poisson structure
            (example
            %a.maruku-ref{:href => "#DeformationQuantizationOfLiePoissonStructuresByUniversalEnvelopingAlgebras"}
            below). Remarkably, this statement generalizes to more general
            %a.existingWikiWord{:href => "/nlab/show/polynomial+Poisson+algebras"} polynomial Poisson algebras
            (def.
            %a.maruku-ref{:href => "#PolynomialPoissonAlgebra"}
            below) for a suitable generalized concept of universal enveloping algebra (def.
            %a.maruku-ref{:href => "#DeformationQuantizationOfLiePoissonStructuresByUniversalEnvelopingAlgebras"}
            below): it is
            %em always
            true up to third order in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
            = succeed "," do
              %a{:href => "#PenkavaVanhaecke00"} Penkava-Vanhaecke 00, theorem 3.2
            %a.maruku-ref{:href => "#UniversalEnvelopingAlgebraProvidesDeformationQuantizationAtLeastToOrder3"}
            below). In particular it also holds true for restrictions of
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+algebras"} Poisson bracket Lie algebras
            to their
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+Lie+algebras"} Heisenberg Lie algebras
            (example
            %a.maruku-ref{:href => "#DeformationQuantizationOfLiePoissonStructuresByUniversalEnvelopingAlgebras"}
            below).
          #PolynomialPoissonAlgebra.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mo ⋅
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((A,\cdot), \{-,-\})
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/polynomial+Poisson+algebra"} polynomial Poisson algebra
              if the underlying
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mo ⋅
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,\cdot)
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/polynomial+algebra"} polynomial algebra
              %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⊗
                    %mi y
                    %mo −
                    %mi y
                    %mo ⊗
                    %mi x
                    %mo{:stretchy => "false"} |
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Sym(V) \coloneqq T(V)/(x \otimes y - y \otimes x \vert x,y \in V)
            %p
              on some
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mo ⊕
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi V
                      %mrow
                        %msup
                          %mo ⊗
                          %mi n
                  %annotation{:encoding => "application/x-tex"}
                    T(V) \coloneqq \underset{n \in \mathbb{N}}{\oplus} V^{\otimes^n}
            %p
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mu \;\colon\; T(V) \longrightarrow Sym(V)
            %p
              for the canonical
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              map (which is an algebra
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma \;\colon\; Sym(V) \longrightarrow T(V)
            %p
              for its
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              inverse (symmetrization, which is not in general an algebra
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            %p
              Notice that by its bi-
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              property the Poisson bracket on a polynomial Poisson algebra is fixed by its restriction to linear elements
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %mo ⊗
                    %mi V
                    %mo ⟶
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{-,-\} \;\colon\; V \otimes V \longrightarrow Sym(V)
                    \\,.
          #PolynomialLiePoissonStructure.num_example
            %h6#example_2 Example
            %p
              %strong
                (polynomial
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Lie-Poisson+structure"} Lie-Poisson structure
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
