                  %annotation{:encoding => "application/x-tex"} E_n
          %p (…)
          %p
            (
            %a{:href => "#CostelloGwilliam"}> Costello-Gwilliam, section 2.3, 2.4
            )
          %p (…)
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/algebraic+deformation+quantization"} algebraic deformation quantization
            %table
              %thead
                %tr
