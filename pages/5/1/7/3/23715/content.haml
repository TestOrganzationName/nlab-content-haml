                      %mn ∞
                  %msub
                    %mi g
                    %mn ∞
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \ln(x) \coloneqq \lim_{i \to \infty} g_\infty'(i)(x)
          %p
            called the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+logarithm"} natural logarithm
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi a
                    %mi i
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g_\infty(a^i-1)
            goes to infinity as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            goes to infinity, the domain of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ln
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \ln(x)
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0, \infty)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/exponential+function"} exponential function
            is defined as as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mi lim
                    %mrow
                      %mi n
                      %mo →
                      %mn ∞
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %mi n
                  %mfrac
                    %mrow
                      %msup
                        %mi x
                        %mi i
                    %mrow
                      %mi i
                      %mo !
                %annotation{:encoding => "application/x-tex"} \exp(x) \coloneqq \lim_{n \to \infty} \sum_{i = 0}^{n} \frac{x^i}{i!}
          %p and the reciprocal function is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mi x
                  %mo ≔
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %mo −
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi ln
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi x
                            %mo ∈
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn ∞
                            %mo ,
                            %mn 0
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi ln
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi x
                            %mo ∈
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{x} \coloneqq
                  \\begin{cases}
                  \-\exp(- \ln(-x)) &amp; x \in (-\infty, 0) \\
                  \\exp(- \ln(x)) &amp; x \in (0, \infty)
                  \\end{cases}
