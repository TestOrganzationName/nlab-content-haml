                    %msubsup
                      %mi Mod
                      %mi ℚ
                      %mrow
                        %msubsup
                          %mi Orb
                          %mi G
                          %mi op
                  %annotation{:encoding => "application/x-tex"} P \,\in\, Mod_{\mathbb{Q}}^{Orb_G^{op}}
              is a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of projective generators as in Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#TheProjectiveGenerators"}
          %p
          .proof
            %h6 Proof
            %p We make a bunch of choices:
            %p
              First, in each
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+class"} conjugacy class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi H
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [H]
              of
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              choose one representative
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ⊂
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H \subset G
            %p
              For that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ↪
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H \hookrightarrow G
              %a.existingWikiWord{:href => "/nlab/show/span"} span
              of the
              %a.existingWikiWord{:href => "/nlab/show/images"} images
              of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
