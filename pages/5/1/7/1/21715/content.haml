                        %mi k
                    %mo ∘
                    %mi p
                    %msub
                      %mo ′
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi K
                    %mo{:stretchy => "false"} (
                    %mi w
