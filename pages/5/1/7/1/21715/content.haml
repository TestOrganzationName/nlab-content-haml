              admits a
              %a.existingWikiWord{:href => "/nlab/show/projective+cover"} projective cover
              in the sense of a
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊕
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi H
                        %mo{:stretchy => "false"} ]
                    %msub
                      %munder
                        %mi V
