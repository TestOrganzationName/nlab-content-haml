            %p
          %p
          #CharacterizationOfInjectives.num_prop
            %h6 Proposition
            %p
              (dual to
              = succeed ")" do
                %a{:href => "#Triantafillou82"} T82, Prop. 3.4
              %br/
              Every
              %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi Mod
                      %mi ℚ
                      %mrow
                        %msub
                          %mi Orb
                          %mi G
                  %annotation{:encoding => "application/x-tex"} I \,\in\, Mod_{\mathbb{Q}}^{Orb_G}
              is a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of injective generators as in Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#TheInjectiveGenerators"}
          %p
          .proof
            %h6 Proof
            %p We make a bunch of choices:
            %p
              First, in each
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+class"} conjugacy class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi H
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [H]
              of
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              choose one representative
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ⊂
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H \subset G
            %p
              For that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ↪
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H \hookrightarrow G
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              of the
              %a.existingWikiWord{:href => "/nlab/show/kernels"} kernels
              of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo ↠
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    I(G/H \twoheadrightarrow G/H')
                    \\;\colon\;
                    I(G/H) \to I(G/H')
            %p
              for all intermediate
              = succeed "-inclusions" do
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ↪
                      %mi H
                      %mo ′
                      %mo ↪
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H \hookrightarrow H' \hookrightarrow G
            %p
              and an
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} N(H)/H
            #eq:TheSplittingForInjectiveEnvelopes.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi H
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
