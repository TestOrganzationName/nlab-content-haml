                    %mrow
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}
                the
                %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Mod
                        %mi ℚ
                        %mrow
                          %msub
                            %mi Orb
                            %mi G
                    %annotation{:encoding => "application/x-tex"} Mod_{\mathbb{Q}}^{Orb_G}
                the
                %a.existingWikiWord{:href => "/nlab/show/copresheaf"} copresheaf
                %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Orb
