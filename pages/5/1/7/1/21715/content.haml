                %path{:d => "M -22.607409 -18.333102 L 1.883218 5.842938 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-dasharray:3.34735,1.91277;stroke-miterlimit:10;", :transform => "matrix(0.993365,0,0,-0.993365,41.937871,35.401825)"}
                %path{:d => "M -2.487829 2.868613 C -2.03162 1.147514 -1.019658 0.336596 0.000327038 -0.00153557 C -1.020809 -0.336363 -2.033248 -1.149429 -2.486373 -2.868146 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.706968,-0.697759,-0.697759,-0.706968,43.979166,29.432736)"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "22.120245", "xlink:href" => "#Oa7hwLCo47WrT4UTIepaWFpA934=-glyph2-2", :y => "37.104452"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "26.354959", "xlink:href" => "#Oa7hwLCo47WrT4UTIepaWFpA934=-glyph4-1", :y => "34.311111"}
            %p
              Hence if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ,
                    %mi w
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v,w \,\in\, P(G/K)
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %msub
