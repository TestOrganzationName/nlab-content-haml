          %p
            %br/
          %p
          #TheInjectiveGenerators.num_defn
            %h6 Definition
            %p
              (dual to
              = succeed ")" do
                %a{:href => "#Triantafillou82"} T82, Def. 3.1
              %br/
            %p For
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi H
                        %mo ⊂
                        %mi G
                      %annotation{:encoding => "application/x-tex"} H \subset G
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi V
                          %mi H
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi Mod
                          %mrow
                            %mi ℚ
                            %mo{:stretchy => "false"} [
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi H
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi H
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} V^H \,\in\, Mod_{ \mathbb{Q}[N(H)/H] }
            %p define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
