                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi K
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi p
                      %mrow
                        %mi G
