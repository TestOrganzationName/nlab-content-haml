          #FiniteDimensionalRationalVectorGSpaces.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/rational+vector+space"} rational
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/vector+G-spaces"} vector G-spaces
            %p
              We say that the
              %em category of finite-dimensional vector G-spaces
              is the
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} category of functors
              from the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of the
              %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
              to the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/rational+vector+spaces"} rational vector spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Vector
                            %mi G
                            %msubsup
                              %mi Spaces
                              %mi ℚ
                              %mi fin
                          %mtd
                            %mo ≔
                            %mspace{:width => "thickmathspace"}
                            %mi PSh
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mi G
                            %mi Orbits
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %msubsup
                              %mi VectorSpaces
                              %mi ℚ
                              %mi{:mathvariant => "normal"} fin
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %mspace{:width => "thickmathspace"}
                            %mi Functors
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mi G
                            %msup
                              %mi Orbits
                              %mi op
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %msubsup
                              %mi VectorSpaces
                              %mi ℚ
                              %mi{:mathvariant => "normal"} fin
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Vector G Spaces^{fin}_{\mathbb{Q}}
                    \&amp;
                    \\coloneqq
                    \\;
                    PSh
                    \\Big(
                    G Orbits
                    \\,,\,
                    VectorSpaces_{\mathbb{Q}}^{\mathrm{fin}}
                    \\Big)
                    \\\
                    \&amp;
                    \\coloneqq
                    \\;
                    Functors
                    \\Big(
                    G Orbits^{op}
                    \\,,\,
                    VectorSpaces_{\mathbb{Q}}^{\mathrm{fin}}
                    \\Big)
                    \\end{aligned}
            %p
              Its
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              we call the
              = succeed ":" do
                %em category of finite-dimensional dual vector G-spaces
            #eq:FunctorCategoryFromOrbitCategoryToOppositeRationalVectorSpaces.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi Vector
                            %mi G
                            %msubsup
                              %mi Spaces
                              %mi ℚ
                              %mi fin
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mi op
                          %mtd
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mi PSh
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mi G
                            %msup
                              %mi Orbits
                              %mi op
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %msubsup
                              %mi VectorSpaces
                              %mi ℚ
                              %mi{:mathvariant => "normal"} fin
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mi Functors
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mi G
                            %mi Orbits
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %msubsup
                              %mi VectorSpaces
                              %mi ℚ
                              %mi{:mathvariant => "normal"} fin
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\big(
                    Vector G Spaces^{fin}_{\mathbb{Q}}
                    \\big)^{op}
                    \&amp;
                    \\simeq
                    \\;
                    PSh
                    \\Big(
