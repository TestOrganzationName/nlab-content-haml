                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P(G/H \twoheadrightarrow G/H')
                    \\;\colon\;
                    P(G/H') \to P(G/H)
            %p
