            %p
              Since all the direct summands on the left are projective by Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ProjectiveGeneratorsAreIndeedProjective"}
              %a.maruku-eqref{:href => "#eq:ComparisonMorphismForProjectiveDecomposition"} (6)
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/functor+categories"} functor categories
              are detected objectwise and since
              %a.existingWikiWord{:href => "/nlab/show/rational+vector+spaces"} rational vector spaces
              form a
              %a.existingWikiWord{:href => "/nlab/show/balanced+category"} balanced category
              (see
              = succeed ")" do
                %a{:href => "balanced+category#AbelianCategoriesAreBalanced"} there
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} K \subset G
              the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi K
                  %annotation{:encoding => "application/x-tex"} p_{G/K}
              %a.maruku-eqref{:href => "#eq:ComparisonMorphismForProjectiveDecomposition"} (6)
              is both an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              and a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            %p
              First to see that that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi K
                  %annotation{:encoding => "application/x-tex"} p_{G/K}
              is an epimorphism: To start with, it is clearly surjective onto the summand
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi K
                    %annotation{:encoding => "application/x-tex"} V_K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi K
                    %mo ∈
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v_K \in P(G/K)
              which is in the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi K
                    %mo ↠
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(G/K \twoheadrightarrow G/H)
              of some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi v
                        %mo ^
                      %mi H
                    %mo ∈
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widehat{v}_H \in P(G/H)
              then it is also in the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mrow
                          %mi G
