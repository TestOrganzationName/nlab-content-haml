                      %mi H
                  %annotation{:encoding => "application/x-tex"} \underset{[H]}{\oplus} \underline{V}_H
              and an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mspace{:width => "thinmathspace"}
