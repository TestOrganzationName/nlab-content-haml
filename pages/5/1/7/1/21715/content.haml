                the “
                %a{:href => "Weyl+group#InEquivariantHomotopyTheory"}> Weyl group
                ” of a
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo ⊂
                        %mi G
                      %annotation{:encoding => "application/x-tex"} H \subset G
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Orb
                        %mi G
                    %annotation{:encoding => "application/x-tex"} Orb_G
                the
                %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                of
                %a.existingWikiWord{:href => "/nlab/show/G-sets"} G-sets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G/H
                of
                %a.existingWikiWord{:href => "/nlab/show/cosets"} cosets
                for
                %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo ⊂
                        %mi G
                      %annotation{:encoding => "application/x-tex"} H \subset G
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}
                the
                %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Mod
                        %mi ℚ
                        %mrow
                          %msubsup
                            %mi Orb
                            %mi G
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Mod_{\mathbb{Q}}^{Orb_G^{op}}
                the
                %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Orb
                        %mi G
                    %annotation{:encoding => "application/x-tex"} Orb_G
                with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in
                = succeed "," do
