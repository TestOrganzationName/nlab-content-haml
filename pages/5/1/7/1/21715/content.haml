                  %annotation{:encoding => "application/x-tex"} p_{G/K} \circ  p'_{G/K}(v) = p_{G/k} \circ p'_{G/K}(w)
              hence
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo =
                      %mi w
                    %annotation{:encoding => "application/x-tex"} v = w
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %msub
                      %mo ′
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi K
                  %annotation{:encoding => "application/x-tex"} p'_{G/K}
              is injective.
          %p
          .num_cor
            %h6 Corollary
            %p
              (
              %a{:href => "#Triantafillou82"}> T82, Prop. 3.6
              ) Every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mspace{:width => "thinmathspace"}
