                            %mi G
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                          %mo ,
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                          %munder
                            %mo ⊗
                            %mrow
                              %mi ℚ
                              %mo{:stretchy => "false"} [
                              %mi N
                              %mo{:stretchy => "false"} (
                              %mi H
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mi H
                              %mo{:stretchy => "false"} ]
                          %msub
                            %mi V
                            %mi H
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                        %mtd
                          %msub
                            %mi V
                            %mi H
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccl}
                    \\underline{V}_H(G/H)
                    \&amp;\equiv&amp;
                    \\mathbb{Q}\big[
                    Orb_G(G/H,G/H)
                    \\big]
                    \\underset{
                    \\mathbb{Q}[N(H)/H]
                    }{\otimes}
                    V_H
                    \\\
                    \&amp;\simeq&amp;
                    V_H
                    \\mathrlap{\,.}
                    \\end{array}
            %p
          %p
          #ProjectiveGeneratorsAreIndeedProjective.num_prop
            %h6 Proposition
            %p
              (
              %a{:href => "#Triantafillou82"}> T82, Prop. 3.2
              )
              %br/
              The objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %munder
                        %mi V
                        %mo ̲
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \underline{V}_H
              from Def.
              %a.maruku-ref{:href => "#TheProjectiveGenerators"}
              are
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Mod
                        %mi ℚ
                        %mrow
                          %msubsup
                            %mi Orb
                            %mi G
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Mod_{\mathbb{Q}}^{Orb_G^{op}}
