                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo ↠
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi G
