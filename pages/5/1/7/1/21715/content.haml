          #CharacterizationOfProjectives.num_prop
            %h6 Proposition
            %p
              (
              %a{:href => "#Triantafillou82"}> T82, Prop. 3.4
              )
              %br/
              Every
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
