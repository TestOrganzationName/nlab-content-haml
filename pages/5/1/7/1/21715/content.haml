                      %mrow
                        %mi H
                        %mo ′
                        %mo ⊃
                        %mi H
                    %mi ker
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo ↠
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
