                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
          %p
            %br/
          %p
          #TheProjectiveGenerators.num_defn
            %h6 Definition
            %p
              (
              %a{:href => "#Triantafillou82"}> T82, Def. 3.1
              )
              %br/
            %p For
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi H
                        %mo ⊂
                        %mi G
                      %annotation{:encoding => "application/x-tex"} H \subset G
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mi H
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi Mod
                          %mrow
                            %mi ℚ
                            %mo{:stretchy => "false"} [
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi H
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi H
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} V_H \,\in\, Mod_{ \mathbb{Q}[N(H)/H] }
            %p define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %munder
                              %mi V
                              %mo ̲
                            %mi H
                          %mspace{:width => "thickmathspace"}
                          %mo ∈
                          %mspace{:width => "thickmathspace"}
                          %msubsup
                            %mi Mod
                            %mi ℚ
                            %mrow
                              %msubsup
                                %mi Orb
                                %mi G
                                %mi op
                      %mtr
                        %mtd
                          %msub
                            %munder
                              %mi V
                              %mo ̲
                            %mi H
                          %mspace{:width => "thickmathspace"}
                          %mo ≡
                          %mspace{:width => "thickmathspace"}
                          %mi ℚ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                          %msub
                            %mi Orb
                            %mi G
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                          %munder
                            %mo ⊗
                            %mrow
                              %mi ℚ
                              %mo{:stretchy => "false"} [
                              %mi N
                              %mo{:stretchy => "false"} (
                              %mi H
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mi H
                              %mo{:stretchy => "false"} ]
                          %msub
                            %mi V
                            %mi H
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\underline{V}_H
                    \\;\in\;
                    Mod_{\mathbb{Q}}^{Orb_G^{op}}
                    \\\
                    \\underline{V}_H
                    \\;\equiv\;
                    \\mathbb{Q}\big[
                    Orb_G(-,G/H)
                    \\big]
                    \\underset{
                    \\mathbb{Q}[N(H)/H]
                    }{\otimes}
                    V_H
                    \\mathrlap{\,.}
                    \\end{array}
            %p
          %p
          #UnderlineVHatStageH.num_remark
            %h6 Remark
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/Weyl+group"} Weyl group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is (see
              = succeed ")" do
                %a{:href => "Weyl+group#eq:AsAutomorphismGroupInOrbitCategory"} there
              %a.existingWikiWord{:href => "/nlab/show/endomorphism+monoid"} endomorphism monoid
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G/H
              in the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %msub
                        %mi Orb
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    N(H)/H
                    \\;\simeq\;
                    {Orb_G}(G/H,G/H)
                    \\;\;
            %p
              we have with Def.
              %a.maruku-ref{:href => "#TheProjectiveGenerators"}
              canonical isomorphism:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %munder
                              %mi V
                              %mo ̲
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≡
                        %mtd
                          %mi ℚ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
