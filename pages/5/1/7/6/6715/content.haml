          %h2#idea Idea
          %p
            A
            %em Bockstein homomorphism
            is a
            %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
            induced from a
            %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            whose injective map is given by multiplication with an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
          %p The archetypical examples are the Bockstein homomorphisms induced this way from the short exact sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mover
                    %mo →
                    %mrow
                      %mo ⋅
                      %mn 2
                  %mi ℤ
                  %mover
                    %mo →
                    %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{Z}
                  \\stackrel{\cdot 2}{\to}
                  \\mathbb{Z}
                  \\stackrel{}{\to}
                  \\mathbb{Z}/2\mathbb{Z}
                  \\,.
          %p
            These relate notably degree-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            (such as
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+classes"} Stiefel-Whitney classes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n+1
            (such as
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/integral+Stiefel-Whitney+classes"} integral Stiefel-Whitney classes
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo →
                    %mrow
                      %mi m
                      %mo ⋅
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  A \stackrel{m\cdot}{\to} A
          %p
            induces a
            %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            of abelian groups
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi A
                    %mrow
                      %mi m
                      %mo −
                      %mi tors
                  %mover
                    %mo →
                    %mrow
                      %mi m
                      %mo ⋅
                  %mi A
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} /
                  %mi m
                  %mi A
                  %mo →
                  %mn 0
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  0\to A/A_{m-tors} \stackrel{m\cdot}{\to} A \to A/m A\to 0,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mrow
                      %mi m
                      %mo −
                      %mi tors
                %annotation{:encoding => "application/x-tex"} A_{m-tors}
            is the subgroup of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion elements
            of
