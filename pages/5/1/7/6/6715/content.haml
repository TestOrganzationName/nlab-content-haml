                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    2 \hat H \hat \cup \hat H \;\simeq\; 0
            %p hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo{:stretchy => "false"} [
                    %mi H
                    %mo{:stretchy => "false"} ]
                    %mo ∪
                    %mo{:stretchy => "false"} [
                    %mi H
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    2 [H] \cup [H] \;\simeq\; 0
            %p
              hence that the ordinary
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi H
                    %mo{:stretchy => "false"} ]
                    %mo ∪
                    %mo{:stretchy => "false"} [
                    %mi H
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [H] \cup [H]
              is a 2-torsion class. Let then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mn 4
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                    %mover
                      %mo ↪
                      %mrow
                        %msup
                          %mi B
                          %mrow
                            %mn 4
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi ι
                        %mo{:stretchy => "false"} )
                    %mo ♭
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mn 4
                        %mi n
                        %mo +
                        %mn 1
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mn 4
                        %mi n
                        %mo +
                        %mn 1
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    j
                    \\;\colon\;
                    \\mathbf{B}^{4n+1} \mathbb{Z}/2\mathbb{Z}
                    \\overset{
                    B^{4n+1} (\iota)
                    }{\hookrightarrow}
                    \\flat \mathbf{B}^{4n+1}  U(1)
                    \\longrightarrow
                    \\mathbf{B}^{4n+1} U(1)_{conn}
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#Mod2BocksteinAndExponentialExactSequence"}
            %p Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi H
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo ∪
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mi H
                      %mo{:stretchy => "false"} ^
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi j
                    %msup
                      %mi Sq
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi H
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi mod
                        %mspace{:width => "thinmathspace"}
                        %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hat H  \hat \cup \hat H
                    \\;\simeq\;
                    j Sq^{2n}([H]_{mod\,2})
                    \\,.
            %p
              This is a
              = succeed "-refinement" do
                %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
              %a.existingWikiWord{:href => "/nlab/show/Adem+relation"} Adem relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Sq
                      %mn 1
                    %mo ∘
                    %msup
                      %mi Sq
                      %mrow
                        %mn 2
                        %mi n
                    %mo =
                    %msup
                      %mi Sq
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} Sq^1 \circ Sq^{2n} = Sq^{2n+1}
              on the
              %a.existingWikiWord{:href => "/nlab/show/Steenrod+squares"} Steenrod squares
              (
              %a{:href => "Steenrod+square#CompositionWithSq1"}> this example
              ) in that, by example
              = succeed "," do
                %a.maruku-ref{:href => "#Mod2BocksteinAndExponentialExactSequence"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2\mathbb{Z}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mi H
                            %mo{:stretchy => "false"} ]
                            %mo ∪
                            %mo{:stretchy => "false"} [
                            %mi H
                            %mo{:stretchy => "false"} ]
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi mod
                                %mn 2
                          %mtd
                            %mo ≃
                          %mtd
                            %munder
                              %munder
                                %mrow
                                  %msup
                                    %mi Sq
                                    %mn 1
                                %mo ⏟
                              %mi β
                            %mo ∘
                            %msup
                              %mi Sq
                              %mrow
                                %mn 2
                                %mi n
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mi H
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mi mod
                                %mspace{:width => "thinmathspace"}
                                %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo =
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi H
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mi mod
                                %mspace{:width => "thinmathspace"}
                                %mn 2
                            %mo ∪
                            %mo{:stretchy => "false"} [
                            %mi H
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mi mod
                                %mo ,
                                %mn 2
                        %mtr
                          %mtd
                            %mo =
                        %mtr
                          %mtd
                            %msup
                              %mi Sq
                              %mrow
                                %mn 2
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mi H
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mi mod
                                %mspace{:width => "thinmathspace"}
                                %mn 2
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    ([H]  \cup [H])_{mod 2}
                    \&amp; \simeq &amp;
                    \\underset{
                    \\beta
                    }{
                    \\underbrace{
                    Sq^1
                    }}
                    \\circ Sq^{2n}([H]_{mod\,2})
                    \\\
                    \=
                    \\\
                    [H]_{mod\, 2} \cup [H]_{mod,2}
                    \\\
                    \=
                    \\\
                    Sq^{2n+1}([H]_{mod\, 2})
                    }
                    \\,.
          %p
            This was first observed in (
            %a{:href => "#Gomi08"}> Gomi 08
            ). Streamlined proofs are given in (
            %a{:href => "#Bunke12"}> Bunke 12, propblem 3.106
            ,
            = succeed ")." do
              %a{:href => "#GradySati16"} Grady-Sati 16, prop. 22
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steenrod+squares"}> Steenrod squares
                ,
                %a.existingWikiWord{:href => "/nlab/show/cohomology+operation"} cohomology operation
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bockstein+spectral+sequence"} Bockstein spectral sequence
          %h2#references References
          %p Original references include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Meyer+Bockstein"}> Meyer Bockstein
                ,
              %p
                %em>
                  Universal systems of
                  = succeed "-homology" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∇
                        %annotation{:encoding => "application/x-tex"} \nabla
                , C. R. (Doklady) Acad. Sci. URSS (N.S.) 37 (1942), 243–245, MR0008701
              %p
                %em
                  A complete system of fields of coefficients for the
                  = succeed "-homological" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∇
                        %annotation{:encoding => "application/x-tex"} \nabla
                , C. R. (Doklady) Acad. Sci. URSS (N.S.) (1943), 38: 187–189, MR0009115
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Meyer+Bockstein"}> Meyer Bockstein
                ,
                %em Sur la formule des coefficients universels pour les groupes d’homologie
                , Comptes Rendus de l’académie des Sciences. Série I. Mathématique (1958), 247: 396–398, MR0103918
          %p
            The relation to the
            %a.existingWikiWord{:href => "/nlab/show/Beilinson-Deligne+cup+product"} Beilinson-Deligne cup product
            is discussed in
          %ul
