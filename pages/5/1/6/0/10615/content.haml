                  \\underset{s \,\colon\,S^{n+1}}{\prod}
                  \\,
                  D\big( \phi(s) \big)
                  \\,,
                  \\;
                  s \,\colon\, S^{n+1}
                  \\;\;\vdash\;\;
                  hmt_D^{\phi_D}(s)
                  \\,\colon\,
                  Id_{D\big(hub_X^{\phi}\big)}\Big(
                  \\big(hmt^{\phi}_X(s)\big)_\ast
                  \\phi_D(s)
                  ,\,
                  hub_D^{\phi_D}
                  \\Big)
                  \\mathclap{\phantom{\vert^{\vert^{\vert}}}}
                  \\end{array}
                  }{
                  \\mathclap{\phantom{\vert^{\vert_{\vert}}}}
                  ind_{\big(D,\,\eta_D,\, hub_D,\, hmt_D \big)}
