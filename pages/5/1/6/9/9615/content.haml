          %h2#definitions_and_framework Definitions and framework
          %p
            A
            %em bineary linear code
            is a
            %a.existingWikiWord{:href => "/nlab/show/linear+code"} linear code
            over the
            %a.existingWikiWord{:href => "/nlab/show/prime+field"} prime field
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
          %h3#linear_codes Linear codes
          %p
            A (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            \-ary)
            %em
              %a.existingWikiWord{:href => "/nlab/show/linear+code"} linear code
            of length
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and rank
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is a
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝔽
                    %mi q
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_q^n
            over a
            %a.existingWikiWord{:href => "/nlab/show/prime+field"} prime field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi q
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_q
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            elements, or of any
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi q
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_q
            that comes equipped with a “standard” basis. A principal application is in the construction of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/error-correcting+codes"} error-correcting codes
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/species"} Joyal species
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Code
                    %mrow
                      %mi q
                      %mo ,
                      %mi k
                  %mo :
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %mi FinSet
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Code_{q, k}: Core(FinSet) \to Set
            of
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            the set of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            as basis. The corresponding
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            of
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Code
                      %mrow
                        %mi q
                        %mo ,
                        %mi k
                  %annotation{:encoding => "application/x-tex"} Code_{q, k}
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            of linear codes, where an isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi V
                  %mo ⊆
                  %msub
                    %mi 𝔽
                    %mi q
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi W
                  %mo ⊆
                  %msub
                    %mi 𝔽
                    %mi q
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (S, V \subseteq \mathbb{F}_q S) \to (T, W \subseteq \mathbb{F}_q T)
            is a bijection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi S
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} \phi: S \to T
            such that the linear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi q
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_q \phi
            carries
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            onto
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            in this sense are given by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/permutation+matrices"} permutation matrices
          %p
            An alternative notion that recurs in coding theory is that an isomorphism (often called an
            = succeed ")" do
              %em equivalence
            %a.existingWikiWord{:href => "/nlab/show/monomial+matrix"} monomial matrix
            which, when interpreted as a linear isomorphism using the assigned linear bases, carries
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            onto
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
          %p
            Each assigned basis
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi e
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi e
                    %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{e_1, \ldots, e_n\}
            of a vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            can be construed as a self-dual basis with respect to a bilinear form, so that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi e
                      %mi i
                    %mo ,
                    %msub
                      %mi e
                      %mi j
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %msub
                      %mi δ
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} \langle e_i, e_j \rangle = \delta_{i j}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} →
                  %mo ,
                  %mover
                    %mi y
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msub
                    %mi x
                    %mn 1
                  %msub
                    %mi y
                    %mn 1
                  %mo +
                  %mi …
                  %mo +
                  %msub
                    %mi x
                    %mi n
                  %msub
                    %mi y
                    %mi n
                %annotation{:encoding => "application/x-tex"} (\vec{x}, \vec{y}) \mapsto x_1 y_1 + \ldots + x_n y_n
          %p
            and this bilinear form is used to define the notion of
            %em dual code
            (see below).
          %h3#binary_linear_codes Binary linear codes
          %p
            The following is largely adapted from
            = succeed "." do
              %a{:href => "#FLM"} Frenkel, Lepowsky, Meurman
          %p
            A
            %strong (binary linear) code
            is a
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} q = 2
          %p
            As a combinatorial structure on a finite set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(\Omega)
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/atoms"} atoms
          %p
            In that case, the standard dot product can be identified with the nondegenerate symmetric
            = succeed "-bilinear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(\Omega)
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                  %msub
                    %mi 𝔽
                    %mn 2
                %annotation{:encoding => "application/x-tex"} P(\Omega) \times P(\Omega) \stackrel{\langle -, - \rangle}{\to} \mathbb{F}_2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi S
                    %mo ∩
                    %mi T
                    %mo{:stretchy => "false"} |
                  %mrow
                    %mo{:lspace => "mediummathspace"} (
                    %mo{:rspace => "thinmathspace"} mod
                    %mn 2
                    %mo{:rspace => "mediummathspace"} )
                %annotation{:encoding => "application/x-tex"} (S, T) \mapsto {|S \cap T|} \pmod 2
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi C
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|C|}
            is the
            %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            of a set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Ω
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n = {|\Omega|} = \dim(P(\Omega))
          %p
            To each code
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo ⊂
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{C} \subset P(\Omega)
            there is a
            %strong dual code
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}^\perp
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ⊥
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi S
                  %mo ∈
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo ∀
                  %mi T
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} ⟨
                  %mi S
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathbf{C}^\perp = \{S \in P(\Omega): \forall T \in \mathbf{C} \; \langle S, T \rangle = 0\}.
          %p
            Notice that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo ⊥
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi n
                    %mo −
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \dim(\mathbf{C}^\perp) = n - \dim(\mathbf{C})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is
            %strong self-dual
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \mathbf{C} = \mathbf{C}^\perp
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is even and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi n
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \dim(\mathbf{C}) = n/2
          %p
            Now suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            is a set with an even number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            of elements. The collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(\Omega)
            of subsets of even cardinality is a vector subspace of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(\Omega)
            of dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mn 1
                    %mo ⊥
                  %mo ,
                %annotation{:encoding => "application/x-tex"} E(\Omega) = 1^\perp,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is the multiplicative unit of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(\Omega)
            (the subset
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is even. On
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(\Omega)
            we may define a quadratic form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo :
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi 𝔽
                    %mn 2
                %annotation{:encoding => "application/x-tex"} q: E(\Omega) \to \mathbb{F}_2
          %p
            taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ∈
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S \in E(\Omega)
            to
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi S
                        %mo{:stretchy => "false"} |
                      %mn 2
                    %mrow
                      %mo{:lspace => "mediummathspace"} (
                      %mo{:rspace => "thinmathspace"} mod
                      %mn 2
                      %mo{:rspace => "mediummathspace"} )
                  %annotation{:encoding => "application/x-tex"} \frac{{|S|}}{2} \pmod 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            gives rise to the bilinear form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -, - \rangle
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(\Omega)
            via
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi S
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo +
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \langle S, T \rangle = q(S + T) - q(S) - q(T).
          %p
            A code
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo ⊂
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{C} \subset P(\Omega)
            is of
            %strong type II
            if
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} 4
              divides
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi C
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|C|}
              for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} C \in \mathbf{C}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \Omega \in \mathbf{C}
          %p
            and of
            %strong type I
            if
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ⊂
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{C} \subset E(\Omega)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \Omega \in \mathbf{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              is not of type II.
          %p
            Notice that the quadratic form (hence the bilinear form) vanishes on a type II code
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo ⊂
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} \mathbf{C} \subset \mathbf{C}^\perp
            (i.e.,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is isotropic). If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is maximal isotropic – has half the dimension of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(\Omega)
            – then it follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is self-dual.
          %h2#examples Examples
          .num_example
            %h6#example Example
            %p
              %strong
                (Hamming
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 8
                      %mo ,
                      %mn 4
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (8, 4)
                code)
              Up to isomorphism, there is a unique type II self-dual code
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{C} \subset P(\Omega)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              is an 8-element set. Such a code may be constructed as follows: let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              be the projective line
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℙ
                        %mn 1
                      %msub
                        %mi 𝔽
                        %mn 7
                    %annotation{:encoding => "application/x-tex"} \mathbb{P}^1 \mathbb{F}_7
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo ,
                      %mn 3
                      %mo ,
                      %mn 4
                      %mo ,
                      %mn 5
                      %mo ,
                      %mn 6
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \Omega = \{0, 1, 2, 3, 4, 5, 6, \infty\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              be the set of squares
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} 0, 1, 2, 4
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              be its complement in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Omega
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi N
                    %mo +
                    %mi i
                    %mo :
                    %mi i
                    %mo ∈
                    %msub
                      %mi 𝔽
                      %mn 7
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{N + i: i \in \mathbb{F}_7\}
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mo +
                    %mi i
                    %mo =
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty + i = \infty
              for each
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ∅
                            %mo ,
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 3
                            %mo ,
                            %mn 5
                            %mo ,
                            %mn 6
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} }
                            %mo ,
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 4
                            %mo ,
                            %mn 6
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} }
                            %mo ,
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo ,
                            %mn 5
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mn 2
                            %mo ,
                            %mn 6
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} }
                            %mo ,
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 2
                            %mo ,
                            %mn 3
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} }
                            %mo ,
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mn 3
                            %mo ,
                            %mn 4
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} }
                            %mo ,
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 2
                            %mo ,
                            %mn 4
                            %mo ,
                            %mn 5
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 3
                            %mo ,
                            %mn 4
                            %mo ,
                            %mn 5
                            %mo{:stretchy => "false"} }
                            %mo ,
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mn 4
                            %mo ,
                            %mn 5
                            %mo ,
                            %mn 6
                            %mo{:stretchy => "false"} }
                            %mo ,
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 2
                            %mo ,
                            %mn 5
                            %mo ,
                            %mn 6
                            %mo{:stretchy => "false"} }
                            %mo ,
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo ,
                            %mn 3
                            %mo ,
                            %mn 6
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo ,
                            %mn 2
                            %mo ,
                            %mn 4
                            %mo{:stretchy => "false"} }
                            %mo ,
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mn 2
                            %mo ,
                            %mn 3
                            %mo ,
                            %mn 5
                            %mo{:stretchy => "false"} }
                            %mo ,
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 2
                            %mo ,
                            %mn 3
                            %mo ,
                            %mn 4
                            %mo ,
                            %mn 6
                            %mo{:stretchy => "false"} }
                            %mo ,
                          %mtd
                            %mi Ω
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\emptyset, &amp; \{3, 5, 6, \infty\}, &amp; \{0, 4, 6, \infty\}, &amp; \{0, 1, 5, \infty\} \\
                    \\{1, 2, 6, \infty\}, &amp; \{0, 2, 3, \infty\}, &amp; \{1, 3, 4, \infty\}, &amp; \{2, 4, 5, \infty\} \\
                    \\{0, 3, 4, 5\}, &amp; \{1, 4, 5, 6\}, &amp; \{0, 2, 5, 6\}, &amp; \{0, 1, 3, 6\} \\
                    \\{0, 1, 2, 4\}, &amp; \{1, 2, 3, 5\}, &amp; \{2, 3, 4, 6\}, &amp; \Omega.
                    }
            %p
              For this subspace
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo ⊂
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{C} \subset P(\Omega)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} 4
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 8
                    %annotation{:encoding => "application/x-tex"} 8
            %p
              There is a second Hamming code
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}'
              (isomorphic to
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi N
                      %mo −
                      %mi i
                      %mo :
                      %mi i
                      %mo ∈
                      %msub
                        %mi 𝔽
                        %mn 7
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{-N - i: i \in \mathbb{F}_7\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo +
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ′
                    %mo =
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "2em"}
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ∩
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ′
                    %mo =
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mi Ω
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \mathbf{C} + \mathbf{C}' = E(\Omega), \qquad \mathbf{C} \cap \mathbf{C}' = \mathbb{F}_2 \Omega,
            %p
              so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}/\mathbb{F}_2 \Omega
              is complementary to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ′
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}'/\mathbb{F}_2 \Omega
              in the 6-dimensional space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi 𝔽
                        %mn 2
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} E(\Omega)/\mathbb{F}_2 \Omega
          %p
            In the theory of error-correcting codes, this is related to the Hamming
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 7
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (7, 4)
            code, but with an extra parity bit. The Hamming
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 7
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (7, 4)
            code is one of an infinite family of Hamming codes of type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mn 2
                      %mi r
                    %mo −
                    %mn 1
                    %mo ,
                    %msup
                      %mn 2
                      %mi r
                    %mo −
                    %mi r
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2^r - 1, 2^r - r - 1)
          .num_example
            %h6#example_2 Example
            %p
              (The
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/binary+Golay+code"} binary Golay code
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} 3 \Omega
              denote the disjoint union of three copies of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Omega
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mi Ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{D} \subset P(3\Omega)
              that is spanned by elements of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊔
                    %mi S
                    %mo ⊔
                    %mi ∅
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi S
                    %mo ⊔
                    %mi ∅
                    %mo ⊔
                    %mi S
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi T
                    %mo ⊔
                    %mi T
                    %mo ⊔
                    %mi T
                  %annotation{:encoding => "application/x-tex"} S \sqcup S \sqcup \emptyset, \qquad S \sqcup \emptyset \sqcup S, \qquad T \sqcup T \sqcup T
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              ranges over elements of the Hamming code
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              ranges over elements of the Hamming code
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}'
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊔
                      %mi S
                      %mo ⊔
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} S \sqcup S \sqcup \emptyset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ′
                      %mo ⊔
                      %mi ∅
                      %mo ⊔
                      %mi S
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} S' \sqcup \emptyset \sqcup S'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ⊔
                    %mi T
                    %mo ⊔
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T \sqcup T \sqcup T
              are mutually orthogonal in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P(\Omega)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                  %annotation{:encoding => "application/x-tex"} \mathbf{D}
              is an orthogonal direct sum of three 4-dimensional isotropic spaces, making
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                  %annotation{:encoding => "application/x-tex"} \mathbf{D}
              an isotropic subspace of dimension 12, hence maximal isotropic. Each element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                  %annotation{:encoding => "application/x-tex"} \mathbf{D}
              has cardinality a multiple of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} 4
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                  %annotation{:encoding => "application/x-tex"} \mathbf{D}
              has no elements of weight 4, argue as follows. Note that combinations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ⊔
                    %mi S
                    %mo ⊔
                    %mi ∅
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ′
                    %mo ⊔
                    %mi ∅
                    %mo ⊔
                    %mi S
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S \sqcup S \sqcup \emptyset) + (S' \sqcup \emptyset \sqcup S')
              are of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                    %mo ⊔
                    %msub
                      %mi S
                      %mn 2
                    %mo ⊔
                    %msub
                      %mi S
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} S_1 \sqcup S_2 \sqcup S_3
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 1
                      %mo +
                      %msub
                        %mi S
                        %mn 2
                      %mo +
                      %msub
                        %mi S
                        %mn 3
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} S_1 + S_2 + S_3 = 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi S
                        %mn 1
                      %mo +
                      %mi T
                      %mo{:stretchy => "false"} |
                    %mo +
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi S
                        %mn 2
                      %mo +
                      %mi T
                      %mo{:stretchy => "false"} |
                    %mo +
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi S
                        %mn 3
                      %mo +
                      %mi T
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mn 4
                    %mo .
                  %annotation{:encoding => "application/x-tex"} {|S_1 + T|} + {|S_2 + T|} + {|S_3 + T|} = 4.
            %p
              Since all the summands are even, one must be zero, so say
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 3
                      %mo +
                      %mi T
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} S_3 + T = 0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo ∩
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo ′
                      %mo =
                      %msub
                        %mi 𝔽
                        %mn 2
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \mathbf{C} \cap \mathbf{C}' = \mathbb{F}_2 \Omega
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ∈
                      %msub
                        %mi 𝔽
                        %mn 2
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} T \in \mathbb{F}_2 \Omega
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi S
                        %mn 1
                      %mo +
                      %mi T
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|S_1 + T|}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi S
                        %mn 2
                      %mo +
                      %mi T
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|S_2 + T|}
              are multiples of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} 4
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 2
                      %mo +
                      %mi T
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} S_2 + T = 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                    %mo =
                    %msub
                      %mi S
                      %mn 1
                    %mo −
                    %mn 2
                    %mi T
                    %mo =
                    %msub
                      %mi S
                      %mn 1
                    %mo +
                    %msub
                      %mi S
                      %mn 2
                    %mo +
                    %msub
                      %mi S
                      %mn 3
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} S_1 = S_1 - 2 T = S_1 + S_2 + S_3 = 0
            %p
              whence we infer that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi S
                        %mn 1
                      %mo +
                      %mi T
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|S_1 + T|}
              is a multiple of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 8
                    %annotation{:encoding => "application/x-tex"} 8
