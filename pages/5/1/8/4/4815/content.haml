          %p
            Careful discussion in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+gravity"} perturbative quantum gravity
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Donoghue"}> John Donoghue
                \:
                = succeed "," do
                  %em The cosmological constant and the use of cutoffs
                %strong 104
                045005 (2021) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2009.00728"}> arXiv:2009.00728
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1103/PhysRevD.104.045005"} doi:10.1103/PhysRevD.104.045005
            %li
