                , Section 5 of:
                = succeed "," do
                  %em Local Systems on Configuration Spaces, KZ Connections and Conformal Blocks
                = succeed "," do
                  %a{:href => "doi:10.1007/s40306-014-0088-6"} doI;10.1007/s40306-014-0088-6
                = succeed ")" do
