                          %mo +
                          %mi t
                    %annotation{:encoding => "application/x-tex"}
                      F^{s+1}C^{s+t} = F^{s+1}C^{(s+1)+(t-1)}
                      \\underoverset{\simeq}{i^{-(t-1)}}{\longrightarrow} F^{s+t}C^{(s+1)+(t-1)} = F^{s+t}C^{s+t}
            %p
              Moreover, by the assumption that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} t \lt 0
              then
