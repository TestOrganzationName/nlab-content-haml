              need not vanish; while by the
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              property, it does vanish on the actual unit
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∈
                      %msup
                        %mi H
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ;
