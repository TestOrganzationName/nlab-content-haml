          .proof
            %h6#proof_2 Proof
            %p
              By definition of convergence of a spectral sequence, the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                  %annotation{:encoding => "application/x-tex"} E_{\infty}^{s,t}
              sit in
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi F
                      %mrow
                        %mi s
                        %mo +
                        %mn 1
                    %msup
                      %mi C
                      %mrow
                        %mi s
                        %mo +
                        %mi t
                    %mover
                      %mo ⟶
                      %mi i
                    %msup
                      %mi F
                      %mi s
                    %msup
                      %mi C
                      %mrow
                        %mi s
                        %mo +
                        %mi t
                    %mo ⟶
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to F^{s+1}C^{s+t} \overset{i}{\longrightarrow} F^s C^{s+t} \longrightarrow E_\infty^{s,t} \to 0
                    \\,.
            %p
              So when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} E_\infty^{s,t} = 0
              then the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              above is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p We may use this to either shift away the filtering degree
            %ul
              %li
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ≥
                      %mi n
                    %annotation{:encoding => "application/x-tex"} t \geq n
                then
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi F
                          %mi s
                        %msup
                          %mi C
                          %mrow
                            %mi s
                            %mo +
                            %mi t
                        %mo =
                        %msup
                          %mi F
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mn 1
                        %msup
                          %mi C
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %munderover
                          %mo ⟶
                          %mo ≃
                          %mrow
                            %msup
                              %mi i
                              %mrow
                                %mi s
                                %mo −
                                %mn 1
                        %msup
                          %mi F
                          %mn 0
                        %msup
                          %mi C
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi F
                          %mn 0
                        %msup
                          %mi C
                          %mrow
                            %mi s
                            %mo +
                            %mi t
                        %mo ≃
                        %msup
                          %mi C
                          %mrow
                            %mi s
                            %mo +
                            %mi t
                      %annotation{:encoding => "application/x-tex"} F^s C^{s+t} = F^{(s-1)+1}C^{(s-1)+(t+1)} \underoverset{\simeq}{i^{s-1}}{\longrightarrow} F^0 C^{(s-1)+(t+1)} = F^0 C^{s+t} \simeq C^{s+t}
            %p or to shift away the offset of the filtering to the total degree:
            %ul
              %li
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi t
                      %mo −
                      %mn 1
                      %mo ≤
                      %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 0 \leq t-1 \leq n-1
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi F
                        %mrow
                          %mi s
                          %mo +
                          %mn 1
                      %msup
                        %mi C
                        %mrow
                          %mi s
                          %mo +
                          %mi t
                      %mo =
                      %msup
                        %mi F
                        %mrow
                          %mi s
                          %mo +
                          %mn 1
                      %msup
                        %mi C
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %munderover
                        %mo ⟶
                        %mo ≃
                        %mrow
                          %msup
                            %mi i
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} (
                              %mi t
                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} )
                      %msup
                        %mi F
                        %mrow
                          %mi s
                          %mo +
                          %mi t
                      %msup
                        %mi C
                        %mrow
