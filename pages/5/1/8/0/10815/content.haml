                                %mo ,
                                %mn 0
                          %mtd
                            %mo ≃
                          %mtd
                            %msup
                              %mi H
                              %mrow
                                %mo •
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo ;
                            %mi R
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E_{n+1}^{\bullet,n} &amp; \simeq &amp; H^\bullet(B;R)
                    \\\
                    {}^{\mathllap{d_{n+1}}}\downarrow
                    \\\
                    E_{n+1}^{\bullet+n+1,0} &amp; \simeq &amp;  H^{\bullet+n+1}(B;R)
                    }
                    \\,.
            %p
              Now since the
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre spectral sequence
              is
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+spectral+sequence"} multiplicative
              under
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
              and the
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              is a
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              (of total degree 1) with respect to this product. (See at
              = succeed ".)" do
                %em
                  %a{:href => "multiplicative+spectral+sequence#AHSSForMultiplicativeCohomology"} multiplicative spectral sequence – Examples – AHSS for multiplicative cohomology
            %p To make use of this, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
