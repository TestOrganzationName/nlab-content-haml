                    %annotation{:encoding => "application/x-tex"} \iota \cdot(-) \colon H^\bullet(B;R) \simeq E_{n+1}^{0,0} \to E^{0,n}_{n+1} \simeq H^\bullet(B;R)
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
