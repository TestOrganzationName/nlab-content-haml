                  %annotation{:encoding => "application/x-tex"}
                    H^t(S^n; R)
                    \=
                    \\left\{
                    \\array{
                    R &amp; for \; t= 0 \; and \; t = n
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
            %p
              the only possibly non-vanishing terms on the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_2
              page of this spectral sequence, and hence on all the further pages, are in bidegrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo •
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
