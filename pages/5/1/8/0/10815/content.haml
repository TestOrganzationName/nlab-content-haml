            %p
              (Because the
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+spectral+sequence"} multiplicative structure
              gives a group homomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ι
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ;
                      %mi R
                      %mo{:stretchy => "false"} )
