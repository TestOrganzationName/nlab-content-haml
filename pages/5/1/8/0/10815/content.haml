            %h6#lemma Lemma
            %p
              Consider a cohomology
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              converging to some
              %a.existingWikiWord{:href => "/nlab/show/filtered+object"} filtered
              %a.existingWikiWord{:href => "/nlab/show/graded+abelian+group"} graded abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
