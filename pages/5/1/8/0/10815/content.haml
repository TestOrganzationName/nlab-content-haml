                          %mi s
                          %mo +
                          %mi t
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} F^{s}C^{s+t} = 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi s
                    %msup
                      %mi C
                      %mi s
                    %mo ≃
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mi s
                        %mo ,
                        %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F^{s}C^{s} \simeq E_\infty^{s,0}
                    \\,.
            %p In summary this yields the vertical isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
