                          %mi n
                          %mo +
                          %mn 1
                        %mrow
                          %mn 0
                          %mo ,
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} 1 \in H^0(B;R) \simeq E_{n+1}^{0,0}
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ≔
                    %msub
                      %mi d
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ι
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msubsup
