          %h2#idea Idea
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ⊗
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \otimes b
            and
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [b,c]
            are related by the defining
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊗
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C(a \otimes b, c) \simeq C(a, [b,c])
                  \\,.
          %p
            The notion of
            %strong copowering
            generalizes this to the situation where a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            does not act on itself by tensors, but where another category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            acts on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/formal+duality"} dual
            notion is that of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/powering"} powering
          %h2#definition Definition
          %p
          #CopowerDefinition.num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              serving as the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cosmos+for+enrichment"} cosmos for enrichment
            %p
              In a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %strong copower
              of an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} c \in \mathbf{C}
              by an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v \in V
              is an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ⋅
                    %mi c
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} v \cdot c \in \mathbf{C}
              with a (
              %a.existingWikiWord{:href => "/nlab/show/enriched+natural+transformation"}>
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                \-enriched
              \-)
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi v
                    %mo ⋅
                    %mi c
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi c
                    %mo ′
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≅
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi V
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi v
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{C}\big(
                    v \cdot c,\, c'
                    \\big)
                    \\;\;\cong\;\;
                    \\mathbf{V}\big(
                    v
                    ,\,
                    \\mathbf{C}(c,c')
                    \\big)
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{C}(-,-)
                  denotes the
                  = succeed "-valued" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi V
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{V}(-,-)
                  denotes correspondingly the
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  (i.e. the
                  %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
                  with respect to its canonical self-enrichment).
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              %strong (terminology)
              %br/
              Copowers are frequently called
              %em tensors
              and a
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %em tensored
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} V=Set
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/power"} power
          %h2#copowers_as_colimits Copowers as colimits
          %h3#conical_colimits Conical colimits
          %p
            For a
            = succeed "-enriched" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ⋅
                  %mi c
                %annotation{:encoding => "application/x-tex"} v \cdot c
            is the colimit of the constant functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} v \to C
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            is viewed as a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete category
          %h3#weighted_colimits Weighted colimits
          %p
            A copower
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ⋅
                  %mi c
                %annotation{:encoding => "application/x-tex"} v \cdot c
            is the colimit of the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} 1 \to C
            picking out
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            %a.existingWikiWord{:href => "/nlab/show/weighted+colimit"} weighted by
            the presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mn 1
                    %mi op
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} 1^{op} \to V
            picking out
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
          %h2#properties Properties
          %ul
            %li
              As described above, copowers are a kind of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weighted+limit"} weighted colimit
              %a.existingWikiWord{:href => "/nlab/show/conical+colimits"} conical colimits
              (i.e., ordinary
              = succeed "-based" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
              = succeed "-universal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/power"} power
          %h2#examples Examples
          %p
          #GeneralBasicExamples.num_remark
            %h6 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/B%C3%A9nabou+cosmos"} Bénabou cosmos
            %ul
              %li
                %p
                  In
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  regarded as a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
                  over itself, the copower is just the given
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                  is
                  = succeed "-copowered" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is
                  = succeed "-small," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi B
                          %mi A
                      %annotation{:encoding => "application/x-tex"} B^A
                  is
                  = succeed "-copowered." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is
                  = succeed "-copowered" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} B \to C
                  is a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective full embedding
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                  is also copowered.
            %p
          (e.g.
          %a{:href => "#Kelly82"}> Kelly 1982, Sec. 3.7
          )
          %p
          #CopoweringOfSmallCategoriesOverSet.num_remark
            %h6 Example
            %p
              %strong (copowering of small categories over set)
              %br/
              Every
              %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with all
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              is canonically copowered over
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋅
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi Set
                    %mo ×
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\cdot \,\colon\, Set \times C \to C
            %p
              sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S,b)
              to the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of
              = succeed "-many" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi S
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} |S|
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} b \in C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⋅
                    %mi b
                    %mo ≔
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \cdot b \coloneqq \coprod_{s \in S} b
                    \\,.
            %p
              The defining
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              in this situation is then just the fact that the
              %a.existingWikiWord{:href => "/nlab/show/hom+functor"} hom functor
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/hom-functor+preserves+limits"} sends colimits in its first argument to limits
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Set
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C(\coprod_{s \in S} b , c)
                    \\simeq
                    \\prod_{s \in S} C(b,c)
                    \\simeq
                    Set(S, C(b,c))
                    \\,.
            %p
          %p
          .num_remark
            %h6 Example
            %p
              %strong (copowering of the category of monoids)
              %br/
              A particularly illuminating instance of Example
              %a.maruku-ref{:href => "#CopoweringOfSmallCategoriesOverSet"}
              occurs when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is the
              %a.existingWikiWord{:href => "/nlab/show/category+of+monoids"} category of monoids
              (or that
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Groups"} of groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⋅
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X\cdot A
              of a
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              by a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+product"} free product
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              copies of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+commutative+monoids"} tensor product of commutative monoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⋅
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X\cdot A
              is the monoid consisting of
            %ul
              %li
                The set given by the quotient of the free (noncommutative) monoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Free
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Free(X\times A)
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi A
                    %annotation{:encoding => "application/x-tex"} X\times A
                by the congruence relation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∼
                    %annotation{:encoding => "application/x-tex"} \sim
                generated by the relations
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ,
                                %mi a
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ,
                                %mi b
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo ∼
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ,
                                %mi a
                                %mi b
                                %mo{:stretchy => "false"} )
                                %mo ,
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo ,
                                %msub
                                  %mn 1
                                  %mi A
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo ∼
                                %mo{:stretchy => "false"} (
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        (x,a)(x,b) &amp;\sim (x,a b),\\
                        (x,1_A)    &amp;\sim ()
                        \\end{aligned}
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x\in X
                  and each
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo ,
                          %mi b
                          %mo ∈
                          %mi A
                        %annotation{:encoding => "application/x-tex"} a,b\in A
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} ()
                  is the unit of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Free
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi A
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Free(X\times A)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x\in X
                  and each
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo ∈
                          %mi A
                        %annotation{:encoding => "application/x-tex"} a\in A
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ⋅
                        %mi a
                      %annotation{:encoding => "application/x-tex"} x\cdot a
                  for the equivalence class of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi a
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (x,a)
              %li
                The product given by concatenation, i.e. by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ⋅
                        %mi a
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⋅
                          %mrow
                            %mi X
                            %mo ⋅
                            %mi A
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ⋅
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ⋅
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ⋅
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        (x\cdot a)\cdot_{X\cdot A}(y\cdot b)
                        \=
                        (x\cdot a)(y\cdot b),
                %p
                  for each
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ⋅
                          %mi a
                          %mo ,
                          %mi y
                          %mo ⋅
                          %mi b
                          %mo ∈
                          %mi X
                          %mo ⋅
                          %mi A
                        %annotation{:encoding => "application/x-tex"} x\cdot a,y\cdot b\in X\cdot A
              %li
                The unit given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mn 1
                          %mrow
                            %mi X
                            %mo ⋅
                            %mi A
                        %mo =
                        %mi x
                        %mo ⋅
                        %msub
                          %mn 1
                          %mi A
                        %mo ,
                      %annotation{:encoding => "application/x-tex"} 1_{X\cdot A}=x\cdot 1_A,
                %p
                  which is independent of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                        %annotation{:encoding => "application/x-tex"} x
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ⋅
                        %msub
                          %mn 1
                          %mi A
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi y
                        %mo ⋅
                        %msub
                          %mn 1
                          %mi A
                      %annotation{:encoding => "application/x-tex"} x\cdot 1_A=()=y\cdot 1_A
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ,
                          %mi y
                          %mo ∈
                          %mi A
                        %annotation{:encoding => "application/x-tex"} x,y\in A
            %p
              Explicitly,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \coprod_{x\in X}A
              is isomorphic to the above monoid via the isomorphism sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi a
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo ⋅
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_{1}\cdot a_{1})\cdots(x_{n}\cdot a_{n})
              to the element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \coprod_{x\in X}A
              given by the word
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi a
                        %mn 1
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mi ⋯
                      %msubsup
                        %mi a
                        %mi n
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mi n
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a^{(x_{1})}_{1}\cdots a^{(x_{n})}_{n}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi a
                      %mi i
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mi i
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a^{(x_{i})}_{i}
              is the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                  %annotation{:encoding => "application/x-tex"} a_{i}
              in the
              = succeed "-th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi i
                    %annotation{:encoding => "application/x-tex"} x_{i}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in the expression
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi x
                          %mo ∈
                          %mi X
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \coprod_{x\in X}A
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the copower
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⋅
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X\cdot A
              states that a morphism of monoids from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⋅
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X\cdot A
              to a monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is the same data as a “left-bilinear” map of sets
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ×
                      %mi X
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f\colon A\times X\to B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mi b
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                        %mtr
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mn 1
                              %mi A
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mn 1
                              %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    f(a b,x) &amp;= f(a,x)f(b,x),\\
                    f(1_A,x) &amp;= 1_B
                    \\end{aligned}
            %p
              for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x\in X
            %p
              The copower
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋅
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Set
                    %mo ×
                    %mi Mon
                    %mo →
                    %mi Mon
                  %annotation{:encoding => "application/x-tex"} \cdot\colon Set\times Mon\to Mon
              also endows
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mon
                  %annotation{:encoding => "application/x-tex"} Mon
              with
              %a.existingWikiWord{:href => "/nlab/show/skew+monoidal"} skew monoidal
              structures
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ◃
                  %annotation{:encoding => "application/x-tex"} \triangleleft
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ▹
                    %annotation{:encoding => "application/x-tex"} \triangleright
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi A
                            %mo ◃
                            %mi B
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} |
                            %mi B
                            %mo{:stretchy => "false"} |
                            %mo ⋅
                            %mi A
                            %mo ,
                        %mtr
                          %mtd
                            %mi A
                            %mo ▹
                            %mi B
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} |
                            %mi A
                            %mo{:stretchy => "false"} |
                            %mo ⋅
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A\triangleleft B  &amp;= |B| \cdot A,\\
                    A\triangleright B &amp;= |A| \cdot B
                    \\end{aligned}
            %p
              for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi Mon
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A,B\in Obj(Mon)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |A|
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi B
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |B|
              are the underlying sets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                  %annotation{:encoding => "application/x-tex"} CMon
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+commutative+monoids"} tensor product of commutative monoids
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/semirings"} semirings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mon
                  %annotation{:encoding => "application/x-tex"} Mon
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ◃
                  %annotation{:encoding => "application/x-tex"} \triangleleft
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ▹
                  %annotation{:encoding => "application/x-tex"} \triangleright
              recover left and right
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/near-semirings"} near-semirings
