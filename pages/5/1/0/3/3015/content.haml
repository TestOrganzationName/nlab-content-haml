          %title Structured sets
          %h1#structured_sets Structured sets
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %ul
                %li
                  %a{:href => "#abstract"} Abstract
                %li
                  %a{:href => "#Concrete"} Concrete
              %li
                %a{:href => "#conversions"} Conversions
              %ul
                %li
                  %a{:href => "#abstract_to_concrete"} Abstract to concrete
                %li
                  %a{:href => "#concrete_to_abstract"} Concrete to abstract
                %li
                  %a{:href => "#back_and_forth"} Back and forth
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#structured_objects"} Structured objects
              %li
