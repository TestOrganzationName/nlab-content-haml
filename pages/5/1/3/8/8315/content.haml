                        %mi n
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} X_n/X_{n-1}
            %p This implies in particular that
            %ul
              %li
                %p
                  a
                  %strong
                    cellular
                    = succeed "-chain" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                  is a singular
                  = succeed "-chain" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed ";" do
