                          %mi i
                          %mi j
                    %annotation{:encoding => "application/x-tex"} M_{i j}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              refers to the attaching map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f_j \colon S^n \to X_n
              for the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mi th
                  %annotation{:encoding => "application/x-tex"} j^{th}
              disk
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
