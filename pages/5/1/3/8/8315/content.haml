              can be described as a
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              with
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              entries
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
