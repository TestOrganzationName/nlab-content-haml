                          %mn 1
                    %annotation{:encoding => "application/x-tex"} D^{n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} M_{i j}
              corresponds to a map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo ≅
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ,
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %mo ,
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z} \cong H_{n+1}(D^{n+1}, S^n) \to H_n(S^n) \to H_n(D^n, S^{n-1}) \cong H_n(S^n) \cong \mathbb{Z}
            %p
              and is computed as the
              %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degree of a continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mi j
                    %msub
                      %mi X
                      %mi n
                    %mo →
