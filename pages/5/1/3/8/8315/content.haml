          %h3#relation_to_singular_homology Relation to singular homology
          .num_theorem
            %h6#theorem Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mo •
                      %mi CW
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{CW}_\bullet(X)
              agrees with its
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H_\bullet(X)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mo •
                      %mi CW
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^{CW}_\bullet(X)
                    \\simeq
                    H_\bullet(X)
                    \\,.
          %p
            This appears for instance as (
            %a{:href => "#Hatcher"}> Hatcher, theorem 2.35
            ). A proof is below as the proof of cor.
            = succeed "." do
              %a.maruku-ref{:href => "#CelluarEquivalentToSingularFromSpectralSequence"}
          %h3#RelationToSpectralSequenceOfFilteredSingularComplex Relation to the spectral sequence of the filtered singular complex
          %p
            The structure of a
            %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
            on a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.maruku-ref{:href => "#CWComplex"}
            naturally induces on its
            %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_\bullet(X)
            the structure of a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtered chain complex
          .num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                    %mo ↪
                    %msub
                      %mi X
                      %mn 1
                    %mo ↪
                    %mi ⋯
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_0 \hookrightarrow X_1 \hookrightarrow \cdots \hookrightarrow X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F_p C_\bullet(X) \coloneqq C_\bullet(X_p)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/singular+chain+complex"} singular chain complex
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi p
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X_p \hookrightarrow X
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi p
                    %mo ↪
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_p \hookrightarrow X_{p+1}
              induce
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi F
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_p C_\bullet(X) \hookrightarrow F_{p+1} C_\bullet(X)
              and these equip the singular chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet(X)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the structure of a bounded
              %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtered chain complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ↪
                    %msub
                      %mi F
                      %mn 0
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi F
                      %mn 1
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi F
                      %mn 2
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi ⋯
                    %mo ↪
                    %msub
                      %mi F
                      %mn ∞
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\hookrightarrow
                    F_0 C_\bullet(X)
                    \\hookrightarrow
                    F_1 C_\bullet(X)
                    \\hookrightarrow
                    F_2 C_\bullet(X)
                    \\hookrightarrow
                    \\cdots
                    \\hookrightarrow
                    F_\infty C_\bullet(X)
                    \\coloneqq
                    C_\bullet(X)
                    \\,.
            %p
              (If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is of finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mi X
                  %annotation{:encoding => "application/x-tex"} dim X
              then this is a bounded filtration.)
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}(X)\}
              for the
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+complex"} spectral sequence of a filtered complex
              corresponding to this filtering.
          %p We identify various of the pages of this spectral sequences with structures in singular homology theory.
          #PagesInTheSpectralSequenceOfTheFilteredSingularComplex.num_prop
            %h6#proposition_3 Proposition
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} r = 0
                  –
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mi p
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mrow
                            %mi p
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E^0_{p,q}(X) \simeq C_{p+q}(X_p)/C_{p+q}(X_{p-1})
                  is the group of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mrow
                              %mi p
                              %mo −
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} X_{p-1}
                  %a.existingWikiWord{:href => "/nlab/show/relative+homology"} relative (p+q)-chains
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mi p
                        %annotation{:encoding => "application/x-tex"} X_p
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} r = 1
                  –
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi H
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mi p
                        %mo ,
                        %msub
                          %mi X
                          %mrow
                            %mi p
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E^1_{p,q}(X) \simeq H_{p+q}(X_p, X_{p-1})
                  is the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mrow
                              %mi p
                              %mo −
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} X_{p-1}
                  %a.existingWikiWord{:href => "/nlab/show/relative+singular+homology"} relative singular homology
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mi p
                        %annotation{:encoding => "application/x-tex"} X_p
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} r = 2
                  –
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msubsup
                                    %mi H
                                    %mi p
                                    %mi CW
                                  %mo{:stretchy => "false"} (
                                  %mi X
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %mi for
                                  %mspace{:width => "thickmathspace"}
                                  %mi q
                                  %mo =
                                  %mn 0
                              %mtr
                                %mtd
                                  %mn 0
                                %mtd
                                  %mi otherwise
                      %annotation{:encoding => "application/x-tex"} E^2_{p,q}(X) \simeq \left\{ \array{ H_p^{CW}(X) &amp; for\; q = 0 \\ 0 &amp; otherwise }  \right.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo =
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} r = \infty
                  –
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi E
                            %mrow
                              %mi p
                              %mo ,
                              %mi q
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %msub
                            %mi F
                            %mi p
                          %msub
                            %mi H
                            %mrow
                              %mi p
                              %mo +
                              %mi q
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi F
                            %mrow
                              %mi p
                              %mo −
                              %mn 1
                          %msub
                            %mi H
                            %mrow
                              %mi p
                              %mo +
                              %mi q
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} E^\infty_{p,q}(X) \simeq F_p H_{p+q}(X) / F_{p-1} H_{p+q}(X)
          .proof
            %h6#proof_2 Proof
            %p (…)
          %p
            This now directly implies the isomorphism between the cellular homology and the singular homology of a CW-complex
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          #CelluarEquivalentToSingularFromSpectralSequence.num_cor
            %h6#corollary Corollary
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mo •
                      %mi CW
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^{CW}_\bullet(X) \simeq H_\bullet(X)
          .proof
            %h6#proof_3 Proof
            %p
              By the third item of prop.
              %a.maruku-ref{:href => "#PagesInTheSpectralSequenceOfTheFilteredSingularComplex"}
              the
              = succeed "-page" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo =
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (r = 2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}(X)\}
              is concentrated in the
              = succeed "-row." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo =
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (q = 0)
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo &gt;
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} r \gt 2
              vanish, since their domain and codomain groups necessarily have different values of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^\infty_{p,q}(X) \simeq E^2_{p,q}(X)
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %annotation{:encoding => "application/x-tex"} p,q
              %a.maruku-ref{:href => "#PagesInTheSpectralSequenceOfTheFilteredSingularComplex"}
              this is equivalently
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi H
                      %mi p
                      %mi CW
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G_p H_{p}(X) \simeq H^{CW}_p(X)
                    \\,.
            %p
              Finally observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_p H_p(X) \simeq H_p(X)
              by the definition of the filtering on the homology as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∶−
                    %mi image
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_p H_p(X) \coloneq image(H_p(X_p) \to H_p(X))
              and by standard properties of singular homology of
              %a.existingWikiWord{:href => "/nlab/show/CW+complexes"} CW complexes
              discusses at
              = succeed "." do
                %em
                  %a{:href => "CW+complex#SingularHomology"} CW complex – singular homology
            %h2#software Software
            %p
              There are convenient software implementations for large-scale computations of cellular homology: one may use
              = succeed "," do
                %a{:href => "http://www.linalg.org"} LinBox
              %a{:href => "http://chomp.rutgers.edu"} CHomP
              or
              = succeed "." do
                %a{:href => "http://www.sas.upenn.edu/~vnanda/perseus"} Perseus
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/singular+homology"}> singular homology
                ,
                %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+homology"} Čech homology
          %h2#references References
          %div
            %h3#early_references_on_cohomology Early references on (co)homology
            %p
              The original references on
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              and
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              in the form of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/cellular+cohomology"} cellular cohomology
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Andrei+Kolmogoroff"}> Andrei Kolmogoroff
                ,
                = succeed "," do
                  %em Über die Dualität im Aufbau der kombinatorischen Topologie
                = succeed ")" do
                  %a{:href => "http://mi.mathnet.ru/msb5361"} mathnet
            %p
              A footnote on the first page reads as follows, giving attribution to
              = succeed "," do
                %a{:href => "#Alexander35a"} Alexander 35a
              = succeed ":" do
                %a{:href => "#Alexander35a"} 35b
            %blockquote
              %p
                Die Resultate dieser Arbeit wurden für den Fall gewöhnlicher Komplexe vom Verfasser im Frühling und im Sommer 1934 erhalten und teilweise an der Internationalen Konferenz für Tensoranalysis (Moskau) im Mai 1934 vorgetragen. Die hier dargestellte allgemeinere Theorie bildete den Gegenstand eines Vortrages, den der Verfasser an der Internationalen Topologischen Konferenz (Moskau, September 1935) hielt; bei letzterer Gelegenheit erfuhr er, dass ein grosser Teil dieser Resultate im Falle von Komplexen indessen von Herrn Alexander erhalten worden ist. Vgl. die inzwischen erschienenen Noten von Herrn
                %a.existingWikiWord{:href => "/nlab/show/J.+W.+Alexander"} Alexander
                in den «Proceedings of the National Academy of Sciences U.S.A.», 21, (1935), 509—512. Herr Alexander trug über seine Resultate ebenfalls an der Moskauer Topologischen Konferenz vor. Verallgemeinerungen für abgeschlossene Mengen und die Konstruktion eines Homologieringes für Komplexe und abgeschlossene Mengen, über welche der Verfasser ebenso an der Tensorkonferenz 1934 vorgetragen hat, werden in einer weiteren Publikation dargestellt. Diese weitere Begriffsbildungen sind übrigens ebenfalls von Herrn Alexander gefunden und teilweise in den erwähnten Noten publiziert.
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Andrei+Kolmogoroff"}> Andrei Kolmogoroff
                  ,
                  = succeed "," do
                    %em Homologiering des Komplexes und des lokal-bicompakten Raumes
                  = succeed "." do
                    %a{:href => "http://mi.mathnet.ru/msb5475"} mathnet
              %li#Alexander35a
                %p
                  %a.existingWikiWord{:href => "/nlab/show/J.+W.+Alexander"}> J. W. Alexander
                  ,
                  = succeed "," do
                    %em On the chains of a complex and their duals
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1073/pnas.21.8.50"} doi:10.1073/pnas.21.8.50
              %li#Alexander35b
                %p
                  %a.existingWikiWord{:href => "/nlab/show/J.+W.+Alexander"}> J. W. Alexander
                  ,
                  = succeed "," do
                    %em On the ring of a compact metric space
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1073/pnas.21.8.511"} doi:10.1073/pnas.21.8.511
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/J.+W.+Alexander"}> J. W. Alexander
                  ,
                  = succeed "," do
                    %em On the connectivity ring of an abstract space
                  = succeed "," do
                    %a{:href => "https://doi.org/10.2307/1968484"} doi:10.2307/1968484
                  = succeed ")" do
                    %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/alexcon.pdf"} pdf
            %p
              The term “cohomology” was introduced by
              %a.existingWikiWord{:href => "/nlab/show/Hassler+Whitney"} Hassler Whitney
              in
            %ul
              %li#Whitney37
                %a.existingWikiWord{:href => "/nlab/show/Hassler+Whitney"}> Hassler Whitney
                ,
                = succeed "." do
                  %em On matrices of integers and combinatorial topology
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/journals/duke-mathematical-journal/volume-3/issue-1/On-matrices-of-integers-and-combinatorial-topology/10.1215/S0012-7094-37-00304-1.short"} doi:10.1215/S0012-7094-37-00304-1
            %p See also
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Hassler+Whitney"}> Hassler Whitney
                ,
                = succeed "," do
                  %em On products in a complex
                = succeed ")" do
                  %a{:href => "https://doi.org/10.2307/1968795"} doi:10.2307/1968795
            %p
              The notion of
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
              is due to
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
                ,
                = succeed "," do
                  %em Singular homology theory
                = succeed ")" do
                  %a{:href => "https://doi.org/10.2307/1969185"} doi:10.2307/1969185
            %p
              The notion of
              %a.existingWikiWord{:href => "/nlab/show/monadic+cohomology"} monadic cohomology
              via
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/canonical+resolutions"} canonical resolutions
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Jon+Beck"} Jon Beck
                  = succeed "," do
                    %em Homology and Standard Constructions
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Seminar+on+Triples+and+Categorical+Homology+Theory"} Seminar on Triples and Categorical Homology Theory
                  = succeed "," do
                    %strong 80
                  %strong 18
                  (2008) 186-248 [
                  %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/18/tr18abs.html"}> tac:18
                  ,
                  = succeed "]" do
                    %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/18/tr18.pdf"} pdf
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                  ,
                  = succeed "," do
                    %em Cartan-Eilenberg cohomology and triples
                  %strong 112
                  3 (1996) 219–238 [
                  %a{:href => "https://doi.org/10.1016/0022-4049(95)00138-7"}> doi:10.1016/0022-4049(95)00138-7
                  ,
                  = succeed "," do
                    %a{:href => "https://www.math.mcgill.ca/barr/papers/coho.pdf"} pdf
                  = succeed "]" do
                    %a.existingWikiWord{:href => "/nlab/files/Barr-CECohomology.pdf", :title => "pdf"} pdf
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
                  ,
                  = succeed "," do
                    %em Algebraic cohomology: the early days
                  = succeed "," do
                    %em Galois Theory, Hopf Algebras, and Semiabelian Categories
                  %strong 43
                  (2004) 1–26 [
                  %a{:href => "https://doi.org/10.1090/fic/043"}> doi:10.1090/fic/043
                  ,
                  = succeed "," do
                    %a{:href => "https://www.math.mcgill.ca/barr/papers/algcohom.pdf"} pdf
                  = succeed "]" do
                    %a.existingWikiWord{:href => "/nlab/files/Barr-AlgebraicCohomology.pdf", :title => "pdf"} pdf
            %p
              The general abstract perspective on
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
              (subsuming
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+cohomology"} sheaf cohomology
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hypercohomology
              %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian cohomology
              and indications of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology"} Whitehead-generalized cohomology
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Kenneth+Brown"}> Kenneth Brown
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/BrownAHT"} Abstract homotopy theory and generalized sheaf cohomology
                (1973)
          %h3#general General
          %p Textbook accounts:
          %ul
            %li#Bredon93
              %p
                %a.existingWikiWord{:href => "/nlab/show/Glen+Bredon"}> Glen Bredon
                , Section IV.10 of:
                = succeed "," do
                  %em Topology and Geometry
                = succeed "," do
                  %strong 139
                = succeed "," do
                  %a{:href => "https://link.springer.com/book/10.1007/978-1-4757-6848-0"} doi:10.1007/978-1-4757-6848-0
                = succeed "&rbrack;" do
                  %a{:href => "http://virtualmath1.stanford.edu/~ralph/math215b/Bredon.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Allen+Hatcher"}> Allen Hatcher
                , pp. 139
                = succeed "," do
                  %em
                    %a{:href => "http://www.math.cornell.edu/~hatcher/AT/ATpage.html"} Algebraic topology
          %p Lecture notes:
          %ul
            %li
              Lisa Jeffrey,
              %em Homology of CW-complexes and Cellular homology
              (
              %a{:href => "http://www.math.toronto.edu/~mat1300/oldnotes/cellular-homology.pdf"}> pdf
              )
          %p
            Formulation in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrik+Buchholtz"}> Ulrik Buchholtz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Favonia"} Kuen-Bang Hou (Favonia)
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Cellular+Cohomology+in+Homotopy+Type+Theory"} Cellular Cohomology in Homotopy Type Theory
                %strong 16
                2 (2020) (
                %a{:href => "https://arxiv.org/abs/1802.02191"}> arXiv:1802.02191
                ,
                = succeed ")" do
                  %a{:href => "https://lmcs.episciences.org/6518"} lmcs:6518
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Axel+Ljungstr%C3%B6m"}> Axel Ljungström
                \:
                = succeed "," do
                  %em More cellular (co)homology in HoTT
                %a{:href => "CQTS#LjungströmApr2024"} talk at
                = succeed "," do
                  %em
                    %a{:href => "CQTS#RunningHoTT2024"} Running HoTT 2024
                = succeed "@NYUAD" do
                  %a.existingWikiWord{:href => "/nlab/show/CQTS"} CQTS
                = succeed "&rbrack;" do
