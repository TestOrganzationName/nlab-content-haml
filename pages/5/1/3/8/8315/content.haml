          .proof
            %h6#proof Proof
            %p
              On representative singular
              %a.existingWikiWord{:href => "/nlab/show/chains"} chains
              the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
