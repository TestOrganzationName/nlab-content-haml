              and equipped with the induced
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒳
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}_\bullet
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+action"} groupoid action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒫
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                          %mtd
                            %msup
                              %mi p
                              %mo *
                            %msub
                              %mi 𝒳
                              %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi f
                              %mo *
                            %msub
                              %mi 𝒢
                              %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi 𝒢
                              %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo{:lspace => "0em", :rspace => "thinmathspace"} pb
                              %mn ∞
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                          %mtd
                            %msub
                              %mi pb
                              %mn ∞
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi 𝒳
                              %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi 𝒳
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi 𝒢
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{P}(f)&amp; \coloneqq&amp; p^* \mathcal{X}_0 &amp;\to&amp;
                    f^* \mathcal{G}_0&amp;\to&amp; \mathcal{G}_0
                    \\\
                    \&amp;&amp; \downarrow &amp;\pb_\infty&amp; \downarrow^{\mathrlap{p}} &amp;pb_\infty&amp; \downarrow
                    \\\
                    \&amp;&amp; \mathcal{X}_0
                    \&amp;\to&amp;
                    \\mathcal{X}
                    \&amp;\stackrel{f}{\to}&amp;
                    \\mathcal{G}
                    }
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              Here the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}(f)
              is principal over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒳
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}_0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi 𝒢
                    %mo ≃
                    %msub
                      %mi 𝒳
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{P}(f) \to \mathcal{P}(f)//\mathcal{G} \simeq \mathcal{X}_0
                    \\,,
            %p
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}(f)
              is the pullback of a
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
            %p
              On the other hand the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒳
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}_\bullet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}(f)
              is not principal over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_0
              – unless
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalence in an (infinity,1)-category
              (hence a (
              %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"}> Morita equivalence
              ) from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒳
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}_\bullet
              to
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %msub
                        %mi 𝒢
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} f^\ast \mathcal{G}_0
          %p Thus we arrive at an equivalent, however more basic definition of Lie groupoid bibundle:
          .num_defn
            %h6#definition_5 Definition
            %p
              Given Lie groupoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mo =
                    %msub
                      %mi G
                      %mn 1
                    %mo ⇒
                    %msub
                      %mi G
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} G:=G_1\Rightarrow G_0
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo :
                      %mo =
                      %msub
                        %mi H
                        %mn 1
                      %mo ⇒
                      %msub
                        %mi H
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} H:=H_1\Rightarrow H_0
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %strong bibundle
              is a principal
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi π
                          %mi G
                    %msub
                      %mi G
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} E \xrightarrow{\pi_G} G_0
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} G_0
              with anchor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi π
                          %mi H
                    %msub
                      %mi H
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} E\xrightarrow{\pi_H} H_0
              together with a left
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a{:href => "http://ncatlab.org/nlab/show/groupoid+principal+bundle#lie_groupoid_principal_bundles"} here
              ) with anchor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mi G
                    %annotation{:encoding => "application/x-tex"} \pi_G
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} H_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              induces a
              %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalence
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              and it is sometimes called a
              %strong Morita bibundle
              in this case.
          .num_example
            %h6#example_5 Example
            %p
              Given a manifold
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i\}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi V
                        %mi α
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{V_\alpha\}
              %a{:href => "http://ncatlab.org/nlab/show/Lie+groupoid#examples_for_lie_groupoids"} here
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊔
                    %msub
                      %mi U
                      %mi ij
                    %mo ⇒
                    %mo ⊔
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \sqcup U_{ij} \Rightarrow \sqcup U_i
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊔
                      %msub
                        %mi V
                        %mrow
                          %mi α
                          %mi β
                      %mo ⇒
                      %mo ⊔
                      %msub
                        %mi V
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \sqcup V_{\alpha \beta} \Rightarrow \sqcup V_\alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ,
                        %mi α
                    %msub
                      %mi U
                      %mi i
                    %msub
                      %mo ×
                      %mi M
                    %msub
                      %mi V
                      %mi α
                  %annotation{:encoding => "application/x-tex"}
                    \\sqcup_{i, \alpha} U_i \times_{M} V_\alpha
              (which is a common refinement of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i\}
              and
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi V
                        %mi α
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{V_\alpha\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ,
                    %msub
                      %mi x
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi j
                    %mo ,
                    %msub
                      %mi x
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ,
                    %msub
                      %mi x
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "1em"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ,
                    %msub
                      %mi x
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi α
                    %mo ,
                    %msub
                      %mi x
                      %mi β
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ,
                    %msub
                      %mi x
                      %mi β
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} (x_i, x_j)\cdot (x_j, x_\alpha)=(x_i, x_\alpha), \quad (x_i, x_\alpha)\cdot (x_\alpha, x_\beta)=(x_i, x_\beta).
            %p
              Obviously these actions are free. Moreover, it is also not hard to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊔
                    %msub
                      %mi U
                      %mi i
                    %msub
                      %mo ×
                      %mi M
                    %msub
                      %mi V
                      %mi α
                    %mo{:stretchy => "false"} /
                    %mo ⊔
                    %msub
                      %mi V
                      %mrow
                        %mi α
                        %mi β
                    %mo =
                    %mo ⊔
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \sqcup U_i\times_M V_\alpha/\sqcup V_{\alpha \beta} = \sqcup U_i
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊔
                      %msub
                        %mi U
                        %mi i
                      %msub
                        %mo ×
                        %mi M
                      %msub
                        %mi V
                        %mi α
                      %mo{:stretchy => "false"} /
                      %mo ⊔
                      %msub
                        %mi U
                        %mi ij
                      %mo =
                      %mo ⊔
                      %msub
                        %mi V
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \sqcup U_i\times_M V_\alpha/\sqcup U_{ij} = \sqcup V_\alpha
          %h5#composition Composition
          %p
            Given a bibundle functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo :
                  %mi G
                  %mo →
                  %mi H
                %annotation{:encoding => "application/x-tex"} E: G\to H
            and a bibundle functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi H
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} F: H\to K
            between Lie groupoids, the composition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ∘
                  %mi F
                  %mo :
                  %mi G
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} E\circ F: G\to K
            is the quotient manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi H
                        %mn 0
                  %mi F
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi H
                    %mn 1
                %annotation{:encoding => "application/x-tex"} E\times_{H_0} F/H_1
            equipped with the remaining
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            action. Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            acts on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi H
                        %mn 0
                  %mi F
                %annotation{:encoding => "application/x-tex"} E\times_{H_0} F
            from right by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi h
                      %mn 1
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⋅
                    %msubsup
                      %mi h
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi y
                    %mo ⋅
                    %msub
                      %mi h
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, y)\cdot h_1=(x\cdot h_1^{-1}, y \cdot h_1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is so. Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            action and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            action descend to the quotient
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mi H
                          %mn 0
                    %mi F
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi H
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E\times_{H_0} F/H_1
          %p Thus bibundle functors compose to a bibundle functor, and Morita bibundles compose to a Morita bibundle.
          %p
            Then we see that there is a
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi BUN
                %annotation{:encoding => "application/x-tex"} BUN
            with objects Lie groupoids, 1-morphisms bibundle functors, and 2-morphisms isomorphisms of bibundles. It is
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,1)
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,1)
          %h5#bundlisation Bundlisation
          %p
            Given a strict morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mover
                      %mo →
                      %mi f
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G\xrightarrow{f} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo :
                  %mo =
                  %msub
                    %mi G
                    %mn 0
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi f
                        %mn 0
                      %mo ,
                      %msub
                        %mi H
                        %mn 0
                      %mo ,
                      %mi t
                  %msub
                    %mi H
                    %mn 1
                %annotation{:encoding => "application/x-tex"} E:= G_0\times_{f_0, H_0, t} H_1
            with right
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            action induced by
            = succeed "-multiplication" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            action induced by
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} G_0
          #TruncationOfBibundle.num_remark
            %h6#remark_3 Remark
            %p
              If both
              %a.existingWikiWord{:href => "/nlab/show/atlases"} atlases
              are
              %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncated
              objects (
              %a.existingWikiWord{:href => "/nlab/show/smooth+spaces"}> smooth spaces
              )
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒳
                        %mn 0
                      %mo ,
                      %msub
                        %mi 𝒢
                        %mn 0
                      %mo ∈
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi CartSp
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi τ
                        %mn 1
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo ↪
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}_0, \mathcal{G}_0 \in Sh(CartSp) \simeq \tau_1 \mathbf{H} \hookrightarrow \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              for
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}(f)
              is
              %a.existingWikiWord{:href => "/nlab/show/n-truncated"} (n-1)-truncated
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-truncated"} n-truncated
            %p
              In particular therefore the total space of a
              %a.existingWikiWord{:href => "/nlab/show/smooth+groupoid"} smooth 1-groupoid
              bibundle is 0-truncated hence is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
          .num_example
            %h6#example_6 Example
            %p
              In order to discuss Lie-groupoid bibundles we continue the discussion in example
              %a.maruku-ref{:href => "#LieGroupoidPrincipalBundle"}
              of Lie-groupoid principal bundles. Proceeding for the second homotopy pullback diagram as discussed there for the first one, one finds that the total space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
              of the bibundle is presented by the sheaf of groupoids whose schematic depiction is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mi 𝒢
                      %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi g
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi γ
                                      %mn 0
                              %mo ↙
                            %mtd
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi γ
                                      %mn 1
                            %mtd
                            %mtd
                            %mtd
                              %mo ∈
                              %mi 𝒢
                          %mtr
                            %mtd
                              %mi f
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 0
                              %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mi f
                                  %mo{:stretchy => "false"} (
                                  %mi ξ
                                  %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                              %mi f
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 1
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msub
                                %mi x
                                %mn 0
                            %mtd
                            %mtd
                              %mover
                                %mo →
                                %mi ξ
                            %mtd
                            %mtd
                              %msub
                                %mi x
                                %mn 1
                          %mtr
                            %mtd
                            %mtd
                              %mo ↘
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                            %mtd
                            %mtd
                              %mo ∈
                              %mi 𝒳
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi x
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f^\ast \mathcal{G}_0
                    \\;\simeq\;
                    \\left\{
                    \\array{
                    \&amp;&amp; g
                    \\\
                    \&amp; {}^{\mathllap{\gamma_0}}\swarrow &amp;&amp;   \searrow^{\mathrlap{\gamma_1}} &amp; &amp;&amp; \in \mathcal{G}
                    \\\
                    f(x_0) &amp;&amp; \stackrel{f(\xi)}{\to} &amp;&amp; f(x_1)
                    \\\
                    x_0 &amp;&amp; \stackrel{\xi}{\to}&amp;&amp; x_1
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow &amp;  &amp;&amp; \in \mathcal{X}
                    \\\
                    \&amp;&amp; x
                    }
                    \\right\}
                    \\,.
            %p
              Here the vertically-running morphisms are the
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              and two such are related by a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              if they fit into a commuting diagram complete by horizontal morphisms as indicated. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒳
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}_\bullet
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              both are groupoids, these morphisms are unique if they exist, and hence, as predicted by remark
              = succeed "," do
                %a.maruku-ref{:href => "#TruncationOfBibundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}(f)
              is 0-truncated, hence is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              here is free, the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
              is actually a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              (since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒳
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}_\bullet
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              are
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
            %p This then recovers the definition of bibundles for Lie groupoids as often found in the literature.
            %p
              The right
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}
          %p
            Conversely, given a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒳
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}_\bullet
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi 𝒫
                        %mtd
                          %mo →
                        %mtd
                          %mi ℬ
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi 𝒢
                            %mn 0
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi 𝒳
                            %mn 0
                        %mtd
                          %mo →
                        %mtd
                          %mi 𝒳
                        %mtd
                        %mtd
                          %mi 𝒢
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathcal{P} &amp;\to&amp; \mathcal{B} &amp;\to&amp; \mathcal{G}_0
                  \\\
                  \\downarrow &amp;&amp; &amp;&amp; \downarrow
                  \\\
                  \\mathcal{X}_0 &amp;\to&amp; \mathcal{X} &amp;&amp; \mathcal{G}
                  }
          %p
            we recover the Morita morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            that it coresponds to by the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Giraud-Rezk-Lurie+axioms"} Giraud-Rezk-Lurie axioms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is the induced map between the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
            of the Cech nerves of the two left horizontal maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi 𝒫
                        %mtd
                          %mo →
                        %mtd
                          %mi ℬ
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi 𝒢
                            %mn 0
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi 𝒳
                            %mn 0
                        %mtd
                          %mo →
                        %mtd
                          %mi 𝒳
                        %mtd
                        %mtd
                          %mi 𝒢
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathcal{P} &amp;\to&amp; \mathcal{B} &amp;\to&amp; \mathcal{G}_0
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{p}} &amp;&amp; \downarrow
                  \\\
                  \\mathcal{X}_0 &amp;\to&amp; \mathcal{X} &amp;&amp; \mathcal{G}
                  }
          %p
            and then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is similarly the map between the homotopy colimits of the Cech nerves of the two right vertical maps.
          %p (…)
          %h3#RelationToGroupoidConvolutionBimodules Relation to groupoid convolution bimodules
          %p
            There should be a
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            from
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
            to
            %a.existingWikiWord{:href => "/nlab/show/C-star-algebras"} C-star-algebras
            and
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+C-star-bimodules"} Hilbert C-star-bimodules
            between them given by forming
            %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebras"} groupoid convolution algebras
            and naturally exhibited by Lie groupoid bibundles: the
            %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebra"} groupoid convolution algebra
            of the total space of the bibindle becomes a
            %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
            over the two other groupoid convolution algebras.
          %p
            Some aspects of this are in the literature, e.g. (
            %a{:href => "#Mrcun99"}> Mrčun 99
            ) for
            %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+Lie+groupoids"} étale Lie groupoids
            and (
            %a{:href => "#Landsman00"}> Landsman 00
            ) for general
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
          #BundleOfVertical.num_defn
            %h6#definitionnotation Definition/Notation
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon E \to X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              between smooth manifolds, we write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mi p
                    %mi E
                    %mo ↪
                    %mi T
                    %mi E
                  %annotation{:encoding => "application/x-tex"} T^p E \hookrightarrow T E
              for the bundle of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vertical+vector+fields"} vertical vector fields
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              on those vectors in the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the
              %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
              maps
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi p
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi e
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi T
                        %mi e
                      %mi E
                      %mo →
                      %msub
                        %mi T
                        %mrow
                          %mi τ
                          %mo{:stretchy => "false"} (
                          %mi e
                          %mo{:stretchy => "false"} )
                      %mi X
                    %annotation{:encoding => "application/x-tex"} d p|_{e} \colon T_e E \to T_{\tau(e)} X
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Λ
                      %msup
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mi τ
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} {\vert \Lambda\vert^{1/2}}(T^\tau E)
              for the bundle of
              %a.existingWikiWord{:href => "/nlab/show/half-densities"} half-densities
              on vertical vector fields.
          #ActionOnVerticalVectors.num_remark
            %h6#remark_4 Remark
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              and let (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi τ
                    %msub
                      %mi 𝒢
                      %mn 0
                    %mo ,
                    %mi ρ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E \stackrel{\tau}{\to} \mathcal{G}_0, \rho)
              be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔾
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathbb{G}_\bullet
              %a.existingWikiWord{:href => "/nlab/show/groupoid-principal+bundle"} groupoid-principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} E \to E//\mathcal{G}
              (with anchor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
              and action map
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
            %p
              Then the bundle of
              %a.existingWikiWord{:href => "/nlab/show/vertical+vector+fields"} vertical vector fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mi τ
                    %mi E
                  %annotation{:encoding => "application/x-tex"} T^\tau E
              equipped with the anchor map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mi τ
                    %mi E
                    %mover
                      %mo →
                      %mrow
                        %mi d
                        %mi τ
                    %mi T
                    %msub
                      %mi 𝒢
                      %mn 0
                    %mo →
                    %msub
                      %mi 𝒢
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} T^\tau E \stackrel{d \tau}{\to} T \mathcal{G}_0 \to \mathcal{G}_0
              inherits a canonical
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Λ
                      %msup
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mi τ
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi 𝒢
                    %mo →
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"}
                    {\vert \Lambda\vert^{1/2}}(T^\tau E)/\mathcal{G} \to E/\mathcal{G}
            %p exists and is naturall a vector bundle again.
          #TwoVersionsOfHalfDensities.num_defn
            %h6#definition_6 Definition
            %p
              In the situation of remark
              = succeed "," do
                %a.maruku-ref{:href => "#ActionOnVerticalVectors"}
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi C
                          %mrow
                            %mi c
                            %mo{:stretchy => "false"} /
                            %mi G
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ,
                        %msup
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi Λ
                            %mo{:stretchy => "false"} |
                          %mrow
                            %mn 1
                            %mo{:stretchy => "false"} /
                            %mn 2
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi T
                          %mi τ
                        %mo{:stretchy => "false"} )
                        %mi E
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi G
                      %annotation{:encoding => "application/x-tex"} C^\infty_{c/G}(E, {\vert\Lambda\vert}^{1/2}(T^\tau) E)^G
                %p
                  for the space of
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
                  %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                  of the
                  = succeed "-bundle" do
                    %a.existingWikiWord{:href => "/nlab/show/half-density"} half-density
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi T
                          %mi τ
                        %mi E
                      %annotation{:encoding => "application/x-tex"} T^\tau E
                  which are
                  = succeed "-equivariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒢
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}
                  %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
                  up to
                  = succeed "-action;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒢
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi C
                          %mi c
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} /
                        %mi 𝒢
                        %mo ,
                        %msup
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi Λ
                            %mo{:stretchy => "false"} |
                          %mrow
                            %mn 1
                            %mo{:stretchy => "false"} /
                            %mn 2
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi T
                          %mi τ
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\infty_c(E/\mathcal{G}, {\vert \Lambda\vert}^{1/2}(T^\tau E))
                %p for the space of smooth sections with compact support of the quotient bundle.
          %p The following constructions work by repeatedly applying the following identification:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              In the situation of def.
              = succeed "," do
                %a.maruku-ref{:href => "#TwoVersionsOfHalfDensities"}
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mrow
                        %mi c
                        %mo{:stretchy => "false"} /
                        %mi G
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Λ
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mi τ
                    %mo{:stretchy => "false"} )
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi G
                    %mo ≃
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi 𝒢
                    %mo ,
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Λ
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mi τ
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C^\infty_{c/G}(E, {\vert\Lambda\vert}^{1/2}(T^\tau) E)^G
                    \\simeq
                    C^\infty_c(E/\mathcal{G}, {\vert \Lambda\vert}^{1/2}(T^\tau E)  )
                    \\,.
          %p The central definition here is now:
          #BisectionsOnFiberProductOfTwoGActionSpaces.num_defn
            %h6#definition_7 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mn 1
                      %mo ,
                      %msub
                        %mi τ
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E_1, \tau_1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 2
                    %mo ,
                    %msub
                      %mi τ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_2, \tau_2)
              two principal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              manifolds, set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo ,
                    %msub
                      %mi E
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi 𝒢
                    %mo ≔
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %munder
                      %mo ×
                      %mrow
                        %msub
                          %mi 𝒢
                          %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi E
                      %mn 2
                    %mo ,
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Λ
                      %msup
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi T
                        %mi τ
                      %msub
                        %mi E
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Λ
                      %msup
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi T
                        %mi τ
                      %msub
                        %mi E
                        %mn 2
                      %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (E_1, E_2)_{\mathcal{G}}
                    \\coloneqq
                    C^\infty_c( E_1 \underset{\mathcal{G}_0}{\times}) E_2, {\vert\Lambda\vert^{1/2}(T^\tau E_1)} \otimes  {\vert\Lambda\vert^{1/2}(T^\tau E_2)}
          %p And the central fact is:
          #TheBimdoduleConvolutionProduct.num_prop
            %h6#proposition_3 Proposition
            %p
              Given 3
              = succeed "-manifolds" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mi i
                      %mo ,
                      %msub
                        %mi τ
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E_i, \tau_i)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo ,
                      %mn 3
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} i \in \{1,2,3\}
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo ,
                    %msub
                      %mi E
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi 𝒢
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 2
                    %mo ,
                    %msub
                      %mi E
                      %mn 3
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi 𝒢
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo ,
                    %msub
                      %mi E
                      %mn 3
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi 𝒢
                  %annotation{:encoding => "application/x-tex"}
                    \\star
                    \\;\colon\;
                    (E_1, E_2)_{\mathcal{G}}
                    \\times
                    (E_2, E_3)_{\mathcal{G}}
                    \\to
                    (E_1, E_3)_{\mathcal{G}}
            %p
              given on sections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 1
                    %mo ,
                    %msub
                      %mi σ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \sigma_1, \sigma_2
              and points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %msub
                      %mi e
                      %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e_1, e_3)
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 1
                    %mo ⋆
                    %msub
                      %mi σ
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %msub
                      %mi e
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msub
                      %mo ∫
                      %mrow
                        %msubsup
                          %mi τ
                          %mn 2
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi τ
                          %mn 1
                        %msub
                          %mi e
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi σ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi σ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi e
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_1 \star \sigma_2
                    \\colon
                    (e_1, e_3)
                    \\mapsto
                    \\int_{\tau_2^{-1}(\tau_1 e_1)}
                    \\sigma_1(e_1, -)  \otimes \sigma_2(-,e_3)
                    \\,,
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/integration"} integration
              is against the
              %a.existingWikiWord{:href => "/nlab/show/measure"} measure
              that appears by tensoring two (of the four)
              %a.existingWikiWord{:href => "/nlab/show/half-densities"} half-densities
              in the integrand.
            %p
              This operation is an associative and invoutive partial composition operation and hence defines a
              %a.existingWikiWord{:href => "/nlab/show/star-category"} star-category
              whose
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              = succeed "." do
                %a.maruku-ref{:href => "#BisectionsOnFiberProductOfTwoGActionSpaces"}
          %p In particular one has the following identifications.
          #GroupoidConvolutionAlgebraFromBibundleCase.num_example
            %h6#example_7 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo →
                    %msub
                      %mi 𝒢
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_1 \to \mathcal{G}_0
              regarded as a
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msub
                      %mi 𝒢
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi 𝒢
                    %mo ≃
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Λ
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mi s
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Λ
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mi t
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\mathcal{G}_1, \mathcal{G}_1)_{\mathcal{G}}
                    \\simeq
                    C^\infty_c(\mathcal{G}_1, {\vert\Lambda\vert}^{1/2}(T^s \mathcal{G}_1) \otimes {\vert\Lambda\vert}^{1/2}(T^t \mathcal{G}_1))
            %p
              and the algebra structure on this by prop.
              %a.maruku-ref{:href => "#TheBimdoduleConvolutionProduct"}
              is isomorphic to the
              %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebra"} groupoid convolution algebra
              of smooth sections over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
          %p More generally:
          .num_example
            %h6#example_8 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi τ
                    %msub
                      %mi 𝒢
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} E \stackrel{\tau}{\to} \mathcal{G}_0
              any
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi 𝒢
                    %mo ≃
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo ,
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Λ
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mi G
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Λ
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi τ
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathcal{G}_1, E)_{\mathcal{G}}
                    \\simeq
                    C^\infty_c(E_1, {\vert\Lambda\vert}^{1/2}(T^G E) \otimes {\vert\Lambda\vert}^{1/2}(T\tau E))
                    \\,.
          %blockquote
            %p
              We consider
              %a.existingWikiWord{:href => "/nlab/show/completion"} completion
              of all this to the
              %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} C-star-algebra
              context (…)
          %p
            Now we can put the pieces together and sends groupoid-bindunles to
            = succeed "-bimodules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebras"} groupoid convolution algebras
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Given two
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒦
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}_\bullet
              and given a
              %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalence
              groupoid
              %a.existingWikiWord{:href => "/nlab/show/bibundle"} bibundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              between them, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi 𝒢
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi 𝒦
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi 𝒦
                  %annotation{:encoding => "application/x-tex"}
                    N \coloneqq (\mathcal{G}_1, E)_{\mathcal{G}} \simeq (E, \mathcal{K})_{\mathcal{K}}
            %p
              and this identification makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              into a
              = succeed "-pre-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒢
                        %mo •
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msup
                        %mi C
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒦
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\ast(\mathcal{G}_\bullet)-C^\ast(\mathcal{K}_\bullet)
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+bimodule"} Hilbert bimodule
              as follows:
            %ol
              %li
                %p
                  The identification
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo ≃
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ,
                        %msub
                          %mi 𝒦
                          %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi 𝒦
                      %annotation{:encoding => "application/x-tex"} N \simeq (E, \mathcal{K}_1)_{\mathcal{K}}
                  defines the right
                  = succeed "-action" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi 𝒦
                            %mo •
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} C^\ast(\mathcal{K}_\bullet)
                  = succeed ";" do
                    %a.maruku-ref{:href => "#GroupoidConvolutionAlgebraFromBibundleCase"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo ≃
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝒢
                          %mn 1
                        %mo ,
                        %mi E
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi 𝒢
                      %annotation{:encoding => "application/x-tex"} N \simeq (\mathcal{G}_1, E)_{\mathcal{G}}
                  defines a left
                  = succeed "-action." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi 𝒢
                            %mo •
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} C^\ast(\mathcal{G}_\bullet)
              %li
                %p
                  The
                  = succeed "-valued" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                          %mo{:stretchy => "false"} (
                          %mi 𝒦
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} C^\ast(\mathcal{K})
                  %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is that induced by the composite
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ,
                        %msub
                          %mi 𝒦
                          %mn 1
                        %msubsup
                          %mo{:stretchy => "false"} )
                          %mi 𝒦
                          %mo *
                        %mo ×
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ,
                        %msub
                          %mi 𝒦
                          %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi 𝒦
                        %mover
                          %mo →
                          %mo ≃
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝒦
                          %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi 𝒦
                            %mo ,
                            %mi E
                        %mo ×
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ,
                        %msub
                          %mi 𝒦
                          %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi 𝒦
                        %mo →
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝒦
                          %mn 1
                        %mo ,
                        %msub
                          %mi 𝒦
                          %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi 𝒦
                        %mo ↪
                        %msup
                          %mi C
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝒦
                          %mo •
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (E,\mathcal{K}_1)_{\mathcal{K}}^\ast
                        \\times
                        (E,\mathcal{K}_1)_{\mathcal{K}}
                        \\stackrel{\simeq}{\to}
                        (\mathcal{K}_1)_{\mathcal{K}, E}
                        \\times
                        (E,\mathcal{K}_1)_{\mathcal{K}}
                        \\to
                        (\mathcal{K}_1, \mathcal{K}_1)_{\mathcal{K}}
                        \\hookrightarrow
                        C^\ast(\mathcal{K}_\bullet)
                        \\,.
          %h2#References References
          %h3#general General
          %p
            Groupoid bibundles were first considered for
            %a.existingWikiWord{:href => "/nlab/show/foliation+groupoids"} foliation groupoids
            in
          %ul
            %li#HilsumSkandalis87
              %a.existingWikiWord{:href => "/nlab/show/Michel+Hilsum"}> Michel Hilsum
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Georges+Skandalis"} Georges Skandalis
              = succeed "." do
                %em Morphismes K-orientés d’espaces de feuilles et functorialité en théorie de Kasparov
              = succeed ")" do
                %a{:href => "http://www.numdam.org/item?id=ASENS_1987_4_20_3_325_0"} numdam:ASENS_1987_4_20_3_325_0
          %p
            The generalization to arbitrary
            %a.existingWikiWord{:href => "/nlab/show/topological+groupoids"} topological groupoids
            was considered in
          %ul
            %li#Haefliger84
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Haefliger"}> André Haefliger
                ,
                = succeed "," do
                  %em Groupoïdes d’holonomie et classifiants
            %li#Pradines89
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean+Pradines"}> Jean Pradines
                ,
                = succeed "." do
                  %em Morphisms between spaces of leaves viewed as fractions
                = succeed ")" do
                  %a{:href => "http://www.numdam.org/item/?id=CTGDC_1989__30_3_229_0"} numdam:CTGDC_1989__30_3_229_0
          %p
            and independently in
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            in
          %ul
            %li#Bunge90
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marta+Bunge"}> Marta Bunge
                ,
                %em An application of descent to a classification theorem. Math. Proc. Cambridge Phil. Soc. 107 (1990), 59–79.
            %li#Moerdijk91
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"}> Ieke Moerdijk
                ,
                = succeed "." do
                  %em Classifying toposes and foliations
          %p
            Groupoid bibundles are used in the context of
            %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebras"} groupoid convolution algebras
            as geometric analogs of
            %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
            in
          %ul#Landsman
            %li#MuhlyRenaultWilliams
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Muhly"}> Paul Muhly
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jean+Renault"} Jean Renault
                = succeed "," do
                  %em
                    Equivalence and isomorphism for groupoid
                    = succeed "-algebras" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi C
                              %mo *
                          %annotation{:encoding => "application/x-tex"} C^\ast
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Klaas+Landsman"}> Klaas Landsman
                ,
                = succeed "," do
                  %em The Muhly-Renault-Williams theorem for Lie groupoids and its classical counterpart
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math-ph/0008005"} arXiv:math-ph/0008005
          %ul
            %li#Mrcun05
              %a.existingWikiWord{:href => "/nlab/show/Janez+Mrcun"}> Janez Mrcun
              ,
              %em Stability and invariants of Hilsum-Skandalis maps
              (
              %a{:href => "http://arxiv.org/abs/math/0506484"}> arXiv:math/0506484
              )
          %p
            A review of
            = succeed "-bibundles" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
            is in section 2 of
          %ul
            %li#Blohmann
              %a.existingWikiWord{:href => "/nlab/show/Christian+Blohmann"}> Christian Blohmann
              ,
              = succeed "," do
                %em Stacky Lie groups
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/math/0702399"} arXiv:math/0702399
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/Lie+group+cohomology"} Lie group cohomology
            and the
            %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
            %a.existingWikiWord{:href => "/nlab/show/infinity-group+extension"} infinity-group extension
            in terms of Lie groupoid bibundles is in
          %ul#Sp
            %li
              %a.existingWikiWord{:href => "/nlab/show/Chris+Schommer-Pries"} Chris Schommer-Pries
              %em Central Extensions of Smooth 2-Groups and a Finite-Dimensional String 2-Group
              %a{:href => "http://arxiv.org/abs/0911.2483/"} arXiv:0911.2483
          %p Talk notes on bibundles include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Murray"}> Michael Murray
                ,
                %em Bispaces and bibundles
                (
                %a{:href => "http://www.mpim-bonn.mpg.de/digitalAssets/7050_Murray.pdf"}> pdf slides
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jeffrey+Morton"}> Jeffrey Morton
                , (
                %a{:href => "http://www.math.uwo.ca/~jmorton9/seminar/gpdrep.pdf"}> pdf slides
                )
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Murray"}> Michael Murray
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Roberts"} David Roberts
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
              %em On the existence of bibundles
              LMS (2012)(
              %a{:href => "http://arxiv.org/abs/1102.4388"}> arXiv:1102.4388
              )
          %h3#convolution_to_bimodules
            Convolution to
            = succeed "-bimodules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
          %p
            For groupoid bibundles between
            %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+Lie+groupoids"} étale Lie groupoids
            the assignment of the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebra"} groupoid convolution algebra
            %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
            to them is shown to be
            %a.existingWikiWord{:href => "/nlab/show/functor"} functorial
            in
          %ul
            %li#Mrcun99
              %a.existingWikiWord{:href => "/nlab/show/Janez+Mrcun"}> Janez Mrcun
              ,
              = succeed "." do
                %em Functoriality of the bimodule associated to a Hilsum-Skandalis map
          %p
            For more references along these lines see for the moment at
            %a{:href => "http://ncatlab.org/nlab/show/category+algebra#ExtensionToBibundlesAndBimodules"} groupoid convolution algebra – Extension to bibundles and bimodules
        .revisedby
