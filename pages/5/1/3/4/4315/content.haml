                  %div
                    %p
                      %a{:href => "/nlab/edit/cohomology+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#Idea"} Idea
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#LieGroupoidBibundlesAndMoritaMorphisms"} Lie groupoid bibundles and Morita/stack morphisms
                %ul
                  %li
