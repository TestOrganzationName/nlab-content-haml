              %a.existingWikiWord{:href => "/nlab/show/mean+value+theorem"} mean value theorem
              applied to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ↦
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo −
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t \mapsto g(x + t(y - x))
              says:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
