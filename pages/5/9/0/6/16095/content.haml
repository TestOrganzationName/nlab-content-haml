                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo =
                    %mi c
                    %mo{:stretchy => "false"} |
