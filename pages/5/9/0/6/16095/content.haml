            The former is stronger than the latter, although they are equivalent in the presence of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            satisfies the locally uniformly continuous inverse function axiom, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+closed+field"} real closed field
          %p
            There is also a third possible axiom in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %mo ≔
                  %msub
                    %mi L
                    %mi R
                %annotation{:encoding => "application/x-tex"} \esh \coloneqq L_R
            be the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+type"} localization
            at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is shapewise contractible if its shape is contractible. Given an open interval
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊆
                    %mi R
                  %annotation{:encoding => "application/x-tex"} I \subseteq R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi I
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} f:I \to R
            is shapewise continuous if the graph of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x, y)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ×
                  %mi R
                %annotation{:encoding => "application/x-tex"} I \times R
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y = f(x)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isShapewiseContinuous
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi{:mathvariant => "normal"} isContr
                  %mrow
                    %mo (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo :
                          %mi I
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi y
                          %mo :
                          %mi R
                      %mi y
                      %msub
                        %mo =
                        %mi R
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{isShapewiseContinuous}(f) \coloneqq \mathrm{isContr}\left(\esh\left(\sum_{x:I} \sum_{y:R} y =_{R} f(x)\right)\right)
          %ul
            %li
              For any Archimedean ordered field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %strong shapewise continuously differentiable inverse function axiom
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              states that given any differentiable function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi I
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} f:I \to R
              on an open subinterval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊆
                    %mi R
                  %annotation{:encoding => "application/x-tex"} I \subseteq R
              such that its derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mi d
                        %mi f
                      %mrow
                        %mi d
                        %mi x
                    %mo :
                    %mi I
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \frac{d f}{d x}:I \to R
              is shapewise continuous and always apart from zero, there is a unique differentiable function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo :
                    %mi{:mathvariant => "normal"} im
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} f^{-1}:\mathrm{im}(f) \to R
              called the
              %strong inverse function
              with shapewise continuous derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mi d
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                      %mrow
                        %mi d
                        %mi x
                    %mo :
                    %mi{:mathvariant => "normal"} im
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \frac{d f^{-1}}{d x}:\mathrm{im}(f) \to R
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} f^{-1}(f(a)) = a
              and for all elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi{:mathvariant => "normal"} im
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \in \mathrm{im}(f)
              and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mi d
                          %mi f
                        %mrow
                          %mi d
                          %mi x
                      %mrow
                        %mo (
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo ⋅
                      %mfrac
                        %mrow
                          %mi d
                          %msup
                            %mi f
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                        %mrow
                          %mi d
                          %mi x
                      %mrow
                        %mo (
                        %mi a
                        %mo )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \frac{d f}{d x}\left(f^{-1}(a)\right) \cdot \frac{d f^{-1}}{d x}\left(a\right) = 1
