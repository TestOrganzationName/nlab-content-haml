                    %mo ,
                    %mi r
                    %mo ′
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F : [-r, r] \to [-r', r']
            %p
              defined as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                    %mo −
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(x) = y - g(x)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
