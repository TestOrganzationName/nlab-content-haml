                    %mo −
                    %mi x
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \vert g(y) - g(x) \vert = c \vert y - x \vert
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
