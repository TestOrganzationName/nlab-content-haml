                    %mrow
                      %mi X
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} X \to [0,1]
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi X
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} Top/X^\circ
              be the corresponding
              = succeed "-categoty" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "." do
                %a{:href => "#OverTopModelStructure"} above proposition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sing
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sing_X(-,-)
              constitutes an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi X
                      %mo ∘
                    %mo ≃
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Top/X^\circ \simeq Sh_{(\infty,1)}(X)
                    \\,.
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, corollary 7.1.4.4
          %h3#DiffToOthers
            Difference to more general
            = succeed "-toposes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            The
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/topological+localization"} topological localization
            from an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            = succeed "-toposes," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "es." do
              %a.existingWikiWord{:href => "/nlab/show/hypercomplete+%28%E2%88%9E%2C1%29-topos"} hypercomplete (∞,1)-topos
          %p
            The following lists these properties. (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"}> HTT, section 6.5.4
            \.)
          %h4#universal_property Universal property
          %p
            The construction of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf"} (∞,1)-sheaf
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            is singled out over the construction of other kinds of
            = succeed "-toposes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "es)" do
              %a.existingWikiWord{:href => "/nlab/show/hypercomplete+%28%E2%88%9E%2C1%29-topos"} hypercomplete (∞,1)-topos
          %p
            forming
            = succeed "-sheaves" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            to the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mrow
                      %mo ≤
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \tau_{\leq -1}
            that sends each
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, item 1) of section 6.5.4
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X,Y
            two
            = succeed "-toposes," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Geom
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Geom(X,Y) \subset Func(X,Y)
            for the full
            %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
            on those that are
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
          .num_lemma
            %h6#lemma_2 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              an
              %a.existingWikiWord{:href => "/nlab/show/essentially+small+%28%E2%88%9E%2C1%29-category"} small
              %a.existingWikiWord{:href => "/nlab/show/%28n%2C1%29-category"} (n,1)-category
              with
              %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-limits"} finite (∞,1)-limits
              and equipped with the structure of an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %a.existingWikiWord{:href => "/nlab/show/truncated"} truncation functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mo ≤
                        %mi n
                        %mo −
                        %mn 1
                    %mo :
                    %mi Geom
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Geom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi τ
                      %mrow
                        %mo ≤
                        %mi n
                        %mo −
                        %mn 1
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %mo ≤
                        %mi n
                        %mo −
                        %mn 1
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{\leq n-1} :
                    Geom(Y, Sh(C)) \to Geom(\tau_{\leq n-1} Y, \tau_{\leq n-1} Sh(C))
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+a+quasi-category"} equivalence
              (of
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, lemma 6.4.5.6
          %p
            See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/n-localic+%28%E2%88%9E%2C1%29-topos"} n-localic (∞,1)-topos
          %h4#compact_generation Compact generation
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/coherent+topological+space"} coherent topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Op(X)
              be its
              %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
              with the standard structure of an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(X) := Sh_{(\infty,1)}(Op(X))
              is
              %em compactly generated
              in that it is generated by
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact object
            %p
              Moreover, the compact objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(X)
              are those that are
              = succeed "wise" do
                %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              and
              %a.existingWikiWord{:href => "/nlab/show/locally+constant+%E2%88%9E-stack"} locally constant
              along a suitable
              %a.existingWikiWord{:href => "/nlab/show/stratification"} stratification
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 6.5.4.4
          %p
            This statement is false for the
            %a.existingWikiWord{:href => "/nlab/show/hypercompletion"} hypercompletion
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(X)
          %h4#NonabelianCohomology Nonabelian cohomology
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi LConst
                  %mo ⊣
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %munder
                      %mo →
                      %mi Γ
                    %mover
                      %mo ←
                      %mi LConst
                %annotation{:encoding => "application/x-tex"}
                  (LConst \dashv \Gamma) :  Sh_{(\infty,1)}(X)
                  \\stackrel{\overset{LConst}{\leftarrow}}{\underset{\Gamma}{\to}}
          %p
            be the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} A \in \infty Grpd
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is usually defined in
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi Sing
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  H(X,A) := \pi_0 Func(Sing X, A)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sing
                  %mi X
                %annotation{:encoding => "application/x-tex"} Sing X
            is the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(X)
            via
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LConst
                  %annotation{:encoding => "application/x-tex"} LConst
            %em intrinsic
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            of the
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi LConst
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H'(X,A) := \pi_0 Sh_{(\infty,1)}(X)(X, LConst A)
                  \\,.
          %p
            Noticing that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is in fact the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(X)
            and that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(X)(X,-)
            is in fact that
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo ≃
                  %msub
                    %mi π
                    %mn 0
                  %mi Γ
                  %mi LConst
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots \simeq \pi_0 \Gamma LConst A
                  \\,.
          .num_theorem
            %h6#theorem Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact space
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/constant+%E2%88%9E-stack"} constant coefficients
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} A \in \infty Grpd
              agree:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi Sing
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi LConst
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H(X,A) := \pi_0 \infty Grpd(Sing X,A)  \simeq Sh_{(\infty,1)}(X)(X,LConst A)
                    \\,.
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, theorem 7.1.0.1
          %h2#models Models
          %p
            The topological localizations of an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            are
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
            by the
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
            of the global
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            at the set of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Cech+cover"} Cech cover
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/hypercompletion"} hypercomplete
            = succeed "-sheaf" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presented
            by the local Joyal-Jardine
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
          %p
            Detailed discussion of this
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            presentation is at
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/models+for+infinity-stack+%28infinity%2C1%29-toposes"} models for (infinity,1)-category of (infinity,1)-sheaves
              \.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+type+theory"} geometric homotopy type theory
          %h2#references References
          %p The study of simplicial presheaves apparently goes back to
          %ul
            %li
              K. Brown,
              %a.existingWikiWord{:href => "/nlab/show/BrownAHT"} Abstract Homotopy Theory and Generalized Sheaf Cohomology
          %p
            which considers locally
            %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaves
            as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
          %p
            This was later conceived in terms of a
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            and on simplicial sheaves by Joyal and Jardine. Toën summarizes the situation and emphasizes the interpretation in terms of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stacks"} ∞-stacks
            living in
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            B. Toën,
            %em Higher and derived stacks: a global overview
            (
            %a{:href => "http://arxiv.org/abs/math/0604504"}> arXiv
            ) .
          %p
            This concerns mostly
            %a.existingWikiWord{:href => "/nlab/show/hypercomplete"} hypercomplete
            = succeed "-sheaves," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            The full picture in terms of Grothendieck-
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"}> (∞,1)-topos
            es of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-sheaves
            is the topic of
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
                \.
              %ul
                %li
                  %p
                    localization
                    = succeed "-functors" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\infty,1)
                    = succeed "-sheafification" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\infty,1)
                %li
                  %p
                    local objects (
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                    \-sheaves for the present purpose) and
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/local+isomorphism"} local isomorphism
                %li
                  %p
                    the definition of
                    = succeed "-topoi" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\infty,1)
                    = succeed "-sheaves" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\infty,1)
                %li
                  %p
                    the characterization of
                    = succeed "-sheaves" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\infty,1)
                    %a.existingWikiWord{:href => "/nlab/show/descent"} descent
                    is in section 6.1.3
                %li
                  %p
                    the relation between the
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} Brown–Joyal–Jardine model
                    and the general story is discussed at length in section 6.5.4
          %p An overview is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
              ,
              = succeed "," do
                %em Catégories supérieures et théorie des topos
              = succeed "." do
                %a{:href => "http://www.math.univ-toulouse.fr/~dcisinsk/1097.pdf"} pdf
