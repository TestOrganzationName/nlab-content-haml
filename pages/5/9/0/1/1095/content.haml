                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              be the set of
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi σ
                    %annotation{:encoding => "application/x-tex"} F_\sigma
                \-open subsets
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "s" do
