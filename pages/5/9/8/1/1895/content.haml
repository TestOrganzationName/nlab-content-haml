                      %mi i
                    %msup
                      %mi σ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %msub
                      %mi y
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma y_i \sigma^{-1} = y_{\sigma(i)}
              and
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
