                        %mrow
                          %mi k
                          %mo ≠
                          %mi i
                          %mo ,
                          %mi j
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mi i
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mi j
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [y_i,y_j] = \sum_{k \neq i,j} (k i j)-(k j i)
              = succeed "\u2018s" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
