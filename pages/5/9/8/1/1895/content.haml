              %a.existingWikiWord{:href => "/nlab/show/George+Lusztig"} George Lusztig
              showed, the representation theory of the affine Hecke algebra is related to the graded or degenerate case.
            %li
              There is a geometric construction of the representations of Weyl algebras when realized as certain Hecke convolution algebras by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Victor+Ginzburg"} Victor Ginzburg
          %h2#generalized_hecke_algebras Generalized Hecke algebras
          %p
            To each
            %a.existingWikiWord{:href => "/nlab/show/Coxeter+group"} Coxeter group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            one may associate a Hecke algebra, a certain
            %a.existingWikiWord{:href => "/nlab/show/deformation"} deformation
            of the
            %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi W
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} k[W]
            over a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            is
            %a.existingWikiWord{:href => "/nlab/show/group+presentation"} presented
            by generators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi s
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} ⟩
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} \langle s_i \rangle_{i \in I}
            and relations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi s
                    %mi i
                  %msub
                    %mi s
                    %mi j
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi m
                        %mrow
                          %mi i
                          %mi j
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} (s_i s_j)^{m_{i j}} = 1
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mrow
                      %mi i
                      %mi j
                  %mo =
                  %msub
                    %mi m
                    %mrow
                      %mi j
                      %mi i
                %annotation{:encoding => "application/x-tex"} m_{i j} = m_{j i}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mrow
                      %mi i
                      %mi i
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} m_{i i} = 1
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i, j \in I
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi s
                    %mi i
                    %mn 2
                  %mo =
                  %mn 1
                  %mo ,
                  %mspace{:width => "2em"}
                  %msub
                    %mi s
                    %mi i
                  %msub
                    %mi s
                    %mi j
                  %mi …
                  %mo =
                  %msub
                    %mi s
                    %mi j
                  %msub
                    %mi s
                    %mi i
                  %mi …
                %annotation{:encoding => "application/x-tex"} s_{i}^{2} = 1, \qquad s_i s_j \ldots = s_j s_i \ldots
          %p
            where each of the words in the second equation alternate in the letters
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi i
                  %annotation{:encoding => "application/x-tex"} s_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi j
                %annotation{:encoding => "application/x-tex"} s_j
            and has length
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} m_{i j}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mrow
                        %mi i
                        %mi j
                    %mo &lt;
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} m_{i j} \lt \infty
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi s
                    %mi i
                    %mn 2
                  %mo =
                  %mfrac
                    %mrow
                      %mi q
                      %mo −
                      %mn 1
                    %mi q
                  %msub
                    %mi s
                    %mi i
                  %mo +
                  %mfrac
                    %mn 1
                    %mi q
                  %mo ,
                  %mspace{:width => "2em"}
                  %msub
                    %mi s
                    %mi i
                  %msub
                    %mi s
                    %mi j
                  %mi …
                  %mo =
                  %msub
                    %mi s
                    %mi j
                  %msub
                    %mi s
                    %mi i
                  %mi …
                %annotation{:encoding => "application/x-tex"} s_{i}^{2} = \frac{q-1}{q} s_i + \frac1{q}, \qquad s_i s_j \ldots = s_j s_i \ldots
          %p
            These relations may be interpreted structurally as follows (for simplicity, we will consider only finite, aka spherical Coxeter groups). A Coxeter group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            may be associated with a suitable
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/BN-pair"} BN-pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+group"} algebraic group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a
            %a.existingWikiWord{:href => "/nlab/show/Borel+subgroup"} Borel subgroup
            (maximal solvable subgroup), and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is the normalizer of a
            %a.existingWikiWord{:href => "/nlab/show/maximal+torus"} maximal torus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            typically arise as automorphism groups of thick
            = succeed "-buildings," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a stabilizer of a point of the building. The coset space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi B
                %annotation{:encoding => "application/x-tex"} G/B
            may then be interpreted as a space of flags for a suitable geometry. The Coxeter group itself arises as the quotient
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ≅
                    %mi N
                    %mo{:stretchy => "false"} /
                    %mi T
                  %annotation{:encoding => "application/x-tex"} W \cong N/T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo →
                  %mi B
                  %mo \
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi B
                  %mo :
                  %mi w
                  %mo ↦
                  %mi B
                  %mi w
                  %mi B
                %annotation{:encoding => "application/x-tex"} W \to B\backslash G/B: w \mapsto B w B
          %p
            which is a bijection to the set of double cosets of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            in which the points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G(R)
            are instantiated.)
          %p
            When one takes points of the algebraic group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            over the coefficient ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            elements, the flag manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mi q
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi B
                    %mi q
                  %mo ≔
                  %mi G
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔽
                    %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G_q/B_q \coloneqq G(\mathbb{F}_q)/B(\mathbb{F}_q)
            is also finite. One may calculate
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
