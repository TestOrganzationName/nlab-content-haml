          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            what has come to be known as the
            %em holographic principle
            is the fact that the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/correlators"} correlators
            %a.existingWikiWord{:href => "/nlab/show/partition+functions"} partition functions
            of some
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theories"} quantum field theories
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            may be identified with
            %a.existingWikiWord{:href => "/nlab/show/states"} states
            of a
            %a.existingWikiWord{:href => "/nlab/show/TQFT"} TQFT
            of dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n + 1
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/holographic+principle"} holographic principle
                in
                %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
