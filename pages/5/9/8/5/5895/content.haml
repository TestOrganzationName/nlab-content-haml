            to yield a notion of
            = succeed "." do
              %em internal site
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %strong internal site
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is an
              %a.existingWikiWord{:href => "/nlab/show/internal+category"} internal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo =
                    %msub
                      %mi C
                      %mn 1
                    %mo ⇉
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{C} = C_1 \rightrightarrows C_0
              equipped with an internal
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
          %p
            Spelled out in components, this means the following (as in (
            %a{:href => "#Johnstone"}> Johnstone
            ), we shall only define
            %em sifted
            coverages). First, we define the
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sv
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msub
                    %mi PC
                    %mn 1
                %annotation{:encoding => "application/x-tex"} Sv(\mathbb{C}) \hookrightarrow PC_1
            of
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/sieves"} sieves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ↪
                  %msub
                    %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S \hookrightarrow C_1
            is a sieve if the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi C
                        %mn 0
                  %msub
                    %mi C
                    %mn 1
                  %mo →
                  %msub
                    %mi C
                    %mn 1
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi C
                        %mn 0
                  %msub
                    %mi C
                    %mn 1
                  %mo →
                  %msub
                    %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  S\times_{C_0} C_1 \to C_1\times_{C_0} C_1 \to C_1
          %p
            factors through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∈
                      %mrow
                        %msub
                          %mi C
                          %mn 1
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi e
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi PC
                      %mn 1
                    %mo ×
                    %msub
                      %mi C
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \in_{C_1} \stackrel{(n,e)}{\to} PC_1 \times C_1
          .num_defn
            %h6#definition_3 Definition
            %p
              An
              %em internal sifted coverage
              is given by a span
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                    %mover
                      %mo ←
                      %mi b
                    %mi T
                    %mover
                      %mo →
                      %mi c
                    %mi Sv
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_0 \stackrel{b}{\leftarrow} T \stackrel{c}{\to} Sv(\mathbb{C})
              subject to:
            %ul
              %li
                %p The square
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi T
                                %msub
                                  %mo ×
                                  %mrow
                                    %msub
                                      %mi PC
                                      %mn 1
                                %msub
                                  %mo ∈
                                  %mrow
                                    %msub
                                      %mi C
                                      %mn 1
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mi e
                                    %msub
                                      %mi pr
                                      %mn 2
                              %mtd
                                %msub
                                  %mi C
                                  %mn 1
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mrow
                                    %msub
                                      %mi pr
                                      %mn 1
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mrow
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mi s
                            %mtr
                              %mtd
                                %mi T
                              %mtd
                                %mover
                                  %mo →
                                  %mi b
                              %mtd
                                %msub
                                  %mi C
                                  %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        T \times_{PC_1} \in_{C_1} &amp; \stackrel{e pr_2}{\to} &amp; C_1 \\
                        {}^{pr_1}\downarrow   &amp; {}                &amp; \downarrow^{s} \\
                        T                  &amp; \stackrel{b}{\to} &amp; C_0
                        }
                %p
                  commutes, where the pullback in the top left corner is of the map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∈
                          %mrow
                            %msub
                              %mi C
                              %mn 1
                        %mo →
                        %msub
                          %mi PC
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \in_{C_1} \to PC_1
                  along
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi T
                          %mo →
                          %mi Sv
                          %mo{:stretchy => "false"} (
                          %mi ℂ
                          %mo{:stretchy => "false"} )
                          %mo ↪
                          %msub
                            %mi PC
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} T \to Sv(\mathbb{C}) \hookrightarrow PC_1
              %li
                %p
                  If we define the subobject
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mo ↪
                        %mi T
                        %msub
                          %mo ×
                          %mrow
                            %msub
                              %mi C
                              %mn 0
                        %msub
                          %mi C
                          %mn 1
                        %msub
                          %mo ×
                          %mrow
                            %msub
                              %mi C
                              %mn 0
                        %mi T
                      %annotation{:encoding => "application/x-tex"} Q\hookrightarrow T\times_{C_0} C_1 \times_{C_0} T
                  as
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mo :
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo ′
                        %mo ,
                        %mi a
                        %mo ,
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                        %mi aa
                        %mo ′
                        %mo ∈
                        %mi t
                        %mo ∀
                        %mi a
                        %mo ′
                        %mo ∈
                        %mi t
                        %mo ′
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"}
                        Q := \{(t',a,t) | aa' \in t \forall a'\in t'\}
                %p
                  (in the internal language), the composite
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mo ↪
                        %mi T
                        %msub
                          %mo ×
                          %mrow
                            %msub
                              %mi C
                              %mn 0
                        %msub
                          %mi C
                          %mn 1
                        %msub
                          %mo ×
                          %mrow
                            %msub
