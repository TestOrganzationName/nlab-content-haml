                              %mn 0
                        %mi T
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi pr
                              %mn 23
                        %msub
                          %mi C
                          %mn 1
                        %msub
                          %mo ×
                          %mrow
                            %msub
                              %mi C
                              %mn 0
                        %mi T
                      %annotation{:encoding => "application/x-tex"} Q \hookrightarrow T\times_{C_0} C_1 \times_{C_0} T \stackrel{pr_{23}}{\to} C_1 \times_{C_0} T
                  is required to be an epimorphism.
          %p
            We can additionally ask that more saturation conditions (as discussed at
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
          %p (…)
          %h2#properties Properties
          %h3#externalization Externalization
          %p
            We discuss how to every internal site there is a corresponding external site such that the
            %a.existingWikiWord{:href => "/nlab/show/internal+sheaf+topos"} internal sheaf topos
            on the former agrees with the external sheaf topos on the latter.
          #TheExternalizedSite.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{E} := [\mathcal{C}^{op}, Set]
              be its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathbb{D} \in \mathcal{E}
              be an internal site. Regarded, by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔻
                      %mo :
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo →
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} \mathbb{D} : \mathcal{C}^{op} \to Cat
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
              a
              %a.existingWikiWord{:href => "/nlab/show/fibered+category"} fibered category
              which we denote
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ⋊
                    %mi 𝔻
                    %mo →
                    %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C} \rtimes \mathbb{D} \to \mathcal{C}
                    \\,.
          %p
            This is reviewed for instance in (
            %a{:href => "#Johnstone"}> Johnstone, p. 596
            ).
          %p The notation is motivated from the following example.
          .num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              (in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo :
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} := \mathbf{B}G
              be its
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E} \simeq [\mathbf{B}G , Set]
            %p
              is the topos of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} H \in \mathcal{E}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              equipped with a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/action"} action
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                    %mo :
                    %mo =
                    %mi ℬ
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbb{D} := \mathcal{B}H
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %p In this case we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ⋊
                    %mi 𝔻
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ⋊
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C} \rtimes \mathbb{D} \simeq \mathbf{B}(G \rtimes H)
            %p
              is the delooping groupoid of the
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product"} semidirect product
              group of the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
          %p Generally we have
          .num_remark
            %h6#remark Remark
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ⋊
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \rtimes \mathbb{D}
              from def.
              %a.maruku-ref{:href => "#TheExternalizedSite"}
              is described as follows:
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/object"}> object
                  s are pairs
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ,
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (U,V)
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∈
                        %mi Ob
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} U \in Ob \mathcal{C}
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                          %mo ∈
                          %mi Ob
                          %mi 𝔻
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} V \in Ob \mathbb{D}(U)
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphism"}> morphism
                  s
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ′
                        %mo ,
                        %mi V
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ,
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (U',V') \to (U,V)
                  are pairs
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (a,b)
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo :
                        %mi U
                        %mo ′
                        %mo →
                        %mi U
                      %annotation{:encoding => "application/x-tex"} a : U' \to U
                  is in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo :
                        %mi V
                        %mo ′
                        %mo →
                        %mi 𝔻
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} b : V' \to \mathbb{D}(a)(V)
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔻
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ′
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbb{D}(U')
          .num_prop
            %h6#proposition Proposition
            %p
              We have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝔻
                      %mi op
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ⋊
                    %mi 𝔻
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [\mathbb{D}^{op}, [\mathcal{C}^{op}, Set]]
                    \\simeq
                    [(\mathcal{C} \rtimes \mathbb{D})^{op}, Set]
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/category+of+internal+presheaves"} category of internal presheaves
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              over the internal category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔻
                    %annotation{:encoding => "application/x-tex"} \mathbb{D}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo ⋊
                      %mi 𝔻
                    %annotation{:encoding => "application/x-tex"} \mathcal{C} \rtimes \mathbb{D}
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, lemma C2.5.3
            ).
          %p This result generalizes straightforwardly to an analogous statement for internal sheaves.
          #CoverageOnTheExternalizedSite.num_defn
            %h6#definition_5 Definition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is equipped with a
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}
              is equipped with an internal coverage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              , define a coverage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⋊
                    %mi K
                  %annotation{:encoding => "application/x-tex"} J \rtimes K
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ⋊
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \rtimes \mathbb{D}
              by declaring that a
              %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              on an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U,V)
              is
              = succeed "-covering" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo ×
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (J \times K)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \in K(U)
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi V
                    %annotation{:encoding => "application/x-tex"} b(S) = V
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo =
                    %msub
                      %mi Sh
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E} = Sh_J(\mathcal{C})
              be a
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝔻
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{D}, K)
              an internal site in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %a.maruku-ref{:href => "#CoverageOnTheExternalizedSite"}
              we have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi 𝔻
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Sh
                      %mrow
                        %mi J
                        %mo ⋊
                        %mi K
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ⋊
                    %mi 𝔻
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Sh_{K}(\mathbb{D})
                    \\simeq
                    Sh_{J \rtimes K}(\mathcal{C} \rtimes \mathbb{D})
            %p
              between
              %a.existingWikiWord{:href => "/nlab/show/internal+sheaves"} internal sheaves
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}
              and
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} external sheaves
              on the semidirect product site
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo ⋊
                      %mi K
                    %annotation{:encoding => "application/x-tex"} J \rtimes K
            %p
              Moreover, the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %mi 𝒞
                    %mo ⋊
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} P : \mathcal{C} \rtimes \mathbb{D}
              is
              %a.existingWikiWord{:href => "/nlab/show/cover-reflecting"} cover-reflecting
              and induces a
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Sh
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi 𝔻
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                    %mi ℰ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma
                    \\colon
                    Sh_K(\mathbb{D})
                    \\stackrel{}{\to}
                    \\mathcal{E}
                    \\,.
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, prop. C2.5.4
            ).
