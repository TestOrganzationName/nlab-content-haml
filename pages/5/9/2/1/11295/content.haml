            %p
          %h2#properties Properties
          %h3#RelationToStrongMonads Relation to strong and monoidal monads
          %p
          #EquivalenceBetweenStrengthAndEnrichment.num_prop
            %h6 Proposition
            %p
              %strong
                (equivalence between
                = succeed "-strength" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                = succeed "-enrichment)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
              For
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  a
                  %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                      %annotation{:encoding => "application/x-tex"} \mathbf{C}
                  ,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi D
                      %annotation{:encoding => "application/x-tex"} \mathbf{D}
                  a
                  %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                  of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
                %p
                  which are also
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensored
                  (=
                  %a.existingWikiWord{:href => "/nlab/show/copower"}> copowered
                  )
            %p
              then there is a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              between the
              %a.existingWikiWord{:href => "/nlab/show/structures"} structures
              of
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                \-
                %a.existingWikiWord{:href => "/nlab/show/strong+functors"} strong functors
                and
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                %a.existingWikiWord{:href => "/nlab/show/enriched+functors"} enriched functors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi D
                    %annotation{:encoding => "application/x-tex"} \mathbf{C} \to \mathbf{D}
            %p
              on the
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            %p
              and for any pair
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              of such a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              between
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                \-
                %a.existingWikiWord{:href => "/nlab/show/strong+natural+transformations"} strong natural transformations
                and
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                %a.existingWikiWord{:href => "/nlab/show/enriched+natural+transformation"} enriched natural transformation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo →
                      %mi G
                    %annotation{:encoding => "application/x-tex"} F \to G
            %p
              It follows in particular that there is a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              between
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                \-
                %a.existingWikiWord{:href => "/nlab/show/strong+monads"} strong monads
                and
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                %a.existingWikiWord{:href => "/nlab/show/enriched+monads"} enriched monads
            %p
              on such
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
          (
          %a{:href => "#Ratkovic12"}> Ratkovic 2012, §3.2
          ;
          = succeed ")" do
            %a{:href => "#McDermottUustalu22"} McDermott &amp; Uustalu 2022, Prop. 5.4, 5.8
          %p
          .num_remark
            %h6 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              the further assumptions in Prop.
              %a.maruku-ref{:href => "#EquivalenceBetweenStrengthAndEnrichment"}
              apply to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mo ≔
                    %mstyle{:mathvariant => "bold"}
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbf{C} = \mathbf{D} \coloneqq \mathbf{V}
              being the canonical self-enrichment of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
          %p Moreover:
          %p
          #RelationBetweenCommutativeStrongMonadsAndSymmetricMonoidalMonads.num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+closed+category"} symmetric monoidal closed category
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              between the
              %a.existingWikiWord{:href => "/nlab/show/structures"} structures
              of
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/commutative+monad"} commutative
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mspace{:width => "thickmathspace"}
                    %annotation{:encoding => "application/x-tex"} \;
                %a.existingWikiWord{:href => "/nlab/show/strong+monads"} strong monads
                and
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric
                %a.existingWikiWord{:href => "/nlab/show/monoidal+monads"} monoidal monads
            %p
              on
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/monads"} monads
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
          (
          %a{:href => "monoidal+monad#Kock72"}> Kock 1972, Thm. 3.2
          , review in
          = succeed "," do
            %a{:href => "monoidal+monad#GLLN08"} GLLN08, §7.3, §A.4
          = succeed ")" do
            %a{:href => "#Ratkovic12"} Ratkovic 2012, Prop. 3.3.9
          %p
            Hence from combining Prop.
            %a.maruku-ref{:href => "#EquivalenceBetweenStrengthAndEnrichment"}
            with Prop.
            %a.maruku-ref{:href => "#RelationBetweenCommutativeStrongMonadsAndSymmetricMonoidalMonads"}
            we get:
          .num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbf{V}
              denoting its self-
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"}> enriched category
              , every
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric
              %a.existingWikiWord{:href => "/nlab/show/monoidal+monad"} monoidal monad
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              gives the
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              of a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/enriched+monad"} enriched monad
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi V
                    %annotation{:encoding => "application/x-tex"} \mathbf{V}
          %h2#examples Examples
          %p
          .num_remark
            %h6 Example
            %p
              In the case in of enrichment by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/truth+values"} truth values
              %a.existingWikiWord{:href => "/nlab/show/closure+operator"} closure operator
              on a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/poset"} poset
          %p
          .num_remark
            %h6 Remark
            %p
              In the application of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monads+in+computer+science"} monads in computer science
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbf{C} = \mathbf{V}
              is typically the
              %a.existingWikiWord{:href => "/nlab/show/base+of+enrichment"} base of enrichment
              itself, canonically enriched over itself. For classical computing this is typically a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
            %p
              Since declaring a monad in a
              %a.existingWikiWord{:href => "/nlab/show/functional+programming+language"} functional programming language
              means to define it in the
              %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/monads+in+computer+science"} monads in computer science
              are actually enriched, see the discussion
              = succeed "." do
                %a{:href => "monad+in+computer+science#RefinedIdea"} there
            %p
              For example, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is the
              %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
              of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/programming+language"} programming language
              = succeed "-enriched." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
