                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} i
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathrm{i}/2
            %a.existingWikiWord{:href => "/nlab/show/associator"} associator
            of the Jordan product to the Lie bracket, which makes
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/order-theoretic+structure+in+quantum+mechanics"} order-theoretic structure in quantum mechanics
          %h2#definitions_and_elementary_properties Definitions and elementary properties
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            be a
            %a.existingWikiWord{:href => "/nlab/show/formally+real+field"} formally real field
            (in particular,
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} 1/2 \in K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo ∈
                  %mi K
                %annotation{:encoding => "application/x-tex"} q \in K
            be a scalar. (Most of what we say here works over more general fields or even
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
            %a.existingWikiWord{:href => "/nlab/show/Jordan+algebra"} Jordan algebra
            is inappropriate already for fields of characteristic
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            to the field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            of
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            is either zero or invertible, and some things will depend on which it is.
          %p
            A
            %strong Jordan–Lie algebra
            (over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            with deformation constant
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            equipped with two
            %a.existingWikiWord{:href => "/nlab/show/bilinear+operators"} bilinear operators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (-)\circ(-)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [{-},{-}]
            %em
              %a.existingWikiWord{:href => "/nlab/show/Jordan+product"} Jordan product
            and the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
          %ul
            %li
              commutativity of the Jordan product:
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∘
                      %mi y
                      %mo =
                      %mi y
                      %mo ∘
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x \circ y = y \circ x
            %li
              alternation (anticommutativity) of the Lie bracket:
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} [x, x] = 0
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo ∈
                      %mi K
                    %annotation{:encoding => "application/x-tex"} 1/2 \in K
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} [
                      %mi y
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [x, y] = -[y, x]
            %li
              the Jacobi identity (self-derivation of the Lie bracket):
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} ]
                      %mo +
                      %mo{:stretchy => "false"} [
                      %mi y
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [x, [y, z]] = [[x, y], z] + [y, [x, z]]
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo +
                      %mo{:stretchy => "false"} [
                      %mi y
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi z
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo +
                      %mo{:stretchy => "false"} [
                      %mi z
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} [x, [y, z]] + [y, [z, x]] + [z, [x, y]] = 0
            %li
              derivation of the Lie bracket over the Jordan product:
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∘
                      %mi z
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} ]
                      %mo ∘
                      %mi z
                      %mo +
                      %mi y
                      %mo ∘
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [x, y \circ z] = [x, y] \circ z + y \circ [x, z]
            %li
              the associator identity:
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ∘
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ∘
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi z
                      %mo +
                      %msup
                        %mi q
                        %mn 2
                      %mo{:stretchy => "false"} [
                      %mi y
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} x \circ (y \circ z) = (x \circ y) \circ z + q^2 [y, [x, z]]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ∘
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi z
                      %mo −
                      %mi x
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ∘
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi q
                        %mn 2
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} (x \circ y) \circ z - x \circ (y \circ z) = q^2 [[x, z], y]
          %p Note that the last two axioms (and alternation) prove the Jordan identity: first,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi x
                  %mo ∘
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo ∘
                  %mi x
                  %mo +
                  %mi x
                  %mo ∘
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mn 0
                  %mo ;
                %annotation{:encoding => "application/x-tex"} [x, x \circ x] = [x, x] \circ x + x \circ [x, x] = 0 ;
          %p
            then (writing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} x^2
            for
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∘
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x \circ x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ∘
                  %msup
                    %mi x
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ∘
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msup
                    %mi x
                    %mn 2
                  %mo =
                  %msup
                    %mi q
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %mi y
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %msup
                    %mi x
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"} x \circ (y \circ x^2) - (x \circ y) \circ x^2 = q^2 [y, [x, x^2]] = 0 .
          %p
            Thus,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/Jordan+algebra"} Jordan algebra
            under the Jordan product, and of course
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            under the Lie bracket. (In a similar way, we can prove the Jacobi identity from the associator identity if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            is cancellable; but we state the Jacobi identity separately to cover when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} q = 0
            as well.)
          %p
            As usual for Jordan algebras, we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mi n
                %annotation{:encoding => "application/x-tex"} x^n
            for an
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            under the Jordan product; this is unambiguous since Jordan algebras are always power-associative. (And of course, an
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \gt 1
            = succeed "ed" do
              %a.existingWikiWord{:href => "/nlab/show/bias"} bias
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mi m
                %annotation{:encoding => "application/x-tex"} x^m
            and by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mi n
                %annotation{:encoding => "application/x-tex"} x^n
            commute:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi x
                    %mi m
                  %mo ∘
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msup
                    %mi x
                    %mi n
                  %mo =
                  %msup
                    %mi x
                    %mi m
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ∘
                  %msup
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x^m \circ y) \circ x^n = x^m \circ (y \circ x^n)
          %p
            (which may be proved by
            %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            using only the usual Jordan identity). We similarly have that powers of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            commute with each other under the bracket:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi x
                    %mi m
                  %mo ,
                  %msup
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"} [x^m, x^n] = 0 .
          %p
            The proof is similar to the proof above that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %msup
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} [x, x^2] = 0
          %p
            A Jordan–Lie algebra is
            %strong unital
            if the Jordan product has an
            %a.existingWikiWord{:href => "/nlab/show/identity+element"} identity element
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %ul
            %li
              multiplicative identity:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∘
                      %mi x
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} 1 \circ x = x
          %p
            Then we may also interpret
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mn 0
                %annotation{:encoding => "application/x-tex"} x^0
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} [x, 1] = 0
            too (a special case of
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi x
                      %mi m
                    %mo ,
                    %msup
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} [x^m, x^n] = 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mn 1
                    %mo ∘
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [x, 1 \circ 1]
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/normed+field"} normed field
            %strong Jordan–Lie–Banach algebra
            consists of a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/Banach+space"} Banach space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/short+linear+operator"} short
            %a.existingWikiWord{:href => "/nlab/show/bilinear+operator"} bilinear operator
            (as the Jordan product) and a
            %span.newWikiWord
              densely defined
              %a{:href => "/nlab/new/densely+defined+linear+operator"} ?
            bilinear operator (as the Lie bracket) making the domain of the Lie bracket into a Jordan–Lie algebra as above.
          %p
            Typically, although the Lie bracket is allowed to be unbounded, it will be bounded when
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q \gt 0
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is also a
            %a.existingWikiWord{:href => "/nlab/show/Jordan%E2%80%93Banach+algebra"} Jordan–Banach algebra
            under the Jordan product. A Jordan–Lie–Banach algebra is
            %strong unital
            if the Jordan algebra has a unit and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mn 1
                    %mo{:stretchy => "false"} ‖
                  %mo ≤
                  %mn 1
                %annotation{:encoding => "application/x-tex"} {\|1\|} \leq 1
            (in which case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mn 1
                    %mo{:stretchy => "false"} ‖
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} {\|1\|} = 1
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is nontrivial). Note that Jordan–Lie–Banach algebras (besides the
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
          %p
            A
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
              \-algebra
            is a Jordan–Lie–Banach algebra satisfying the following additional identities:
          %ul
            %li
              the
              = succeed "-identity:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %msup
                        %mo{:stretchy => "false"} ‖
                        %mn 2
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %msup
                        %mi x
                        %mn 2
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} {\|x\|^2} = {\|x^2\|}
              (compare the
              = succeed "-identity" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mo *
                    %annotation{:encoding => "application/x-tex"} B^*
              = succeed "-identity" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
              = succeed ");" do
                %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} algebra
            %li
              positivity:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %msup
                          %mi x
                          %mn 2
                        %mo{:stretchy => "false"} ‖
                      %mo ≤
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %msup
                          %mi x
                          %mn 2
                        %mo +
                        %msup
                          %mi y
                          %mn 2
                        %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} {\|x^2\|} \leq {\|x^2 + y^2\|}
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %a.existingWikiWord{:href => "/nlab/show/JB-algebra"} JB-algebra
            under the Jordan product.
          %p
            As with any
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mn 1
                    %mo{:stretchy => "false"} ‖
                  %mo ≤
                  %mn 1
                %annotation{:encoding => "application/x-tex"} {\|1\|} \leq 1
            in the unital case), as this can be proved using the
            = succeed "-identity" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/polarization+identities"} polarization identities
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            half of the
            = succeed "-identity" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %msup
                        %mo{:stretchy => "false"} ‖
                        %mn 2
                    %mo ≤
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %msup
                        %mi x
                        %mn 2
                      %mo +
                      %msup
                        %mi y
                        %mn 2
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} {\|x\|^2} \leq {\|x^2 + y^2\|}
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⌈
                    %msub
                      %mi log
                      %mn 2
                    %mi n
                    %mo{:stretchy => "false"} ⌉
                  %annotation{:encoding => "application/x-tex"} \lceil\log_2 n\rceil
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %msup
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ‖
                  %mo =
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi x
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mi n
                %annotation{:encoding => "application/x-tex"} {\|x^n\|} = {\|x\|^n}
            (except for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n = 0
            in the trivial algebra).
          %p
            When
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q \gt 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi q
                  %annotation{:encoding => "application/x-tex"} 1/q
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mn 2
                    %mo{:stretchy => "false"} /
                    %mi q
                  %annotation{:encoding => "application/x-tex"} \sqrt{2}/q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [[x,z],y]
            is sufficently general to prove this.) Then extending by continuity, we may assume that the Lie bracket is defined everywhere.
          %p
            Positivity generalizes to any number of terms on either side (as long as the right-hand side has more, of course). (However, I don't see how to prove this without going through the
            %a.existingWikiWord{:href => "/nlab/show/functional+calculus"} functional calculus
            to prove that every sum of squares has a
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/formally+real+algebra"} formally real
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msubsup
                      %mi x
                      %mi i
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \sum_i x_i^2 = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} x_i = 0
            (because the norms lie in a formally real field).
          %p
            Following the established terminology for
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi JLC
                  %annotation{:encoding => "application/x-tex"} JLC
              \-algebra
            may be defined as a
            %em concrete
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed ")" do
              %a{:href => "#representations"} below
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            %span.newWikiWord
              subalgebra
              %a{:href => "/nlab/new/subalgebra"} ?
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SA
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SA(H)
            (see
            = succeed ")" do
              %a{:href => "#examples"} below
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/operator+topology"} operator topology
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-algebras)," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
          %p
            Finally, a
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
              \-algebra
            is a unital
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/predual"} predual
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi JLW
                  %annotation{:encoding => "application/x-tex"} JLW
              \-algebra
            is further equipped with a faithful representation (or equivalently is a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JC
                  %annotation{:encoding => "application/x-tex"} JC
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/weak+operator+topology"} weak operator topology
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
          %h2#poisson Relation to Poisson algebras
          %p
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} q = 0
            is precisely a commutative
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            is invertible, then dividing the Lie bracket by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            gives a Jordan–Lie algebra with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} q = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            (at least over a field) is whether or not it is zero. In this way, a Jordan–Lie algebra may be seen as a
            %span.newWikiWord
              quantum deformation
              %a{:href => "/nlab/new/quantum+deformation"} ?
            of a Poisson algebra. (In the
            %a.existingWikiWord{:href => "/nlab/show/physics"} physical
            interpretation,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            here is the
            %a.existingWikiWord{:href => "/nlab/show/Dirac+constant"} Dirac constant
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
          %p
            Similarly, a Jordan–Banach algebra with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} q = 0
            is a commutative Banach algebra equipped with a Poisson bracket (typically unbounded), and similarly for the more specialized versions; then the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo ≠
                  %mn 0
                %annotation{:encoding => "application/x-tex"} q \ne 0
            case is a quantum deformation of such Poisson–Banach algebras. We can see from this why the Lie bracket cannot be expected to be defined on an entire
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q = 0
          %h2#cstar
            Relation to
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
          %p
            For a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q \gt 0
            %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} algebra
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} q \gt 0
            consisting of its
            %a.existingWikiWord{:href => "/nlab/show/Hermitian+operator"} Hermitian
            elements. (With
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q = 0
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo{:stretchy => "false"} /
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0/0
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebras"} von Neumann algebras
          %p
            Specifically, starting with a Jordan–Lie algebra or
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (possibly unital) with deformation constant
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            over a formally real commutative ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊕
                  %mi A
                %annotation{:encoding => "application/x-tex"} A \oplus A
            formally as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A + \mathrm{i} A
          %ul
            %li
              addition:
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo +
                      %mi{:mathvariant => "normal"} i
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo +
                      %mi{:mathvariant => "normal"} i
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo +
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi{:mathvariant => "normal"} i
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo +
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a + \mathrm{i} b) + (c + \mathrm{i} d) \coloneqq (a + c) + \mathrm{i} (b + d)
            %li
              opposite:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} -(a + \mathrm{i} b) \coloneqq (-a) + \mathrm{i} (-b)
              (which we write as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi a
                    %mo −
                    %mi{:mathvariant => "normal"} i
                    %mi b
                  %annotation{:encoding => "application/x-tex"} -a - \mathrm{i} b
              as usual),
            %li
              zero:
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≔
                      %mn 0
                      %mo +
                      %mi{:mathvariant => "normal"} i
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0 \coloneqq 0 + \mathrm{i} 0
            %li
              scalar multiplication:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mi a
                    %mo −
                    %mi y
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mi b
                    %mo +
                    %mi y
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x + \mathrm{i} y) (a + \mathrm{i} b) = (x a - y b) + \mathrm{i} (x b + y a)
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x + \mathrm{i} y
              a scalar in
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} [
                      %mi{:mathvariant => "normal"} i
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} K[\mathrm{i}]
            %li
              involution:
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo +
                      %mi{:mathvariant => "normal"} i
                      %mi b
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo ≔
                      %mi a
                      %mo +
                      %mi{:mathvariant => "normal"} i
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi a
                      %mo −
                      %mi{:mathvariant => "normal"} i
                      %mi b
                    %annotation{:encoding => "application/x-tex"} (a + \mathrm{i} b)^* \coloneqq a + \mathrm{i} (-b) = a - \mathrm{i} b
            %li
              multiplication:
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo +
                      %mi{:mathvariant => "normal"} i
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo +
                      %mi{:mathvariant => "normal"} i
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ∘
                      %mi c
                      %mo +
                      %mi q
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} ]
                      %mo +
                      %mi q
                      %mo{:stretchy => "false"} [
                      %mi b
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} ]
                      %mo −
                      %mi b
                      %mo ∘
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi{:mathvariant => "normal"} i
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi q
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} ]
                      %mo +
                      %mi a
                      %mo ∘
                      %mi d
                      %mo +
                      %mi b
                      %mo ∘
                      %mi c
                      %mo +
                      %mi q
                      %mo{:stretchy => "false"} [
                      %mi b
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a + \mathrm{i} b) (c + \mathrm{i} d) \coloneqq (a \circ c + q [a, d] + q [b, c] - b \circ d) + \mathrm{i} (-q [a, c] + a \circ d + b \circ c + q [b, d])
            %li
              unit (in the unital case):
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ≔
                      %mn 1
                      %mo +
                      %mi{:mathvariant => "normal"} i
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 1 \coloneqq 1 + \mathrm{i} 0
          %p
            This makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo +
                  %mi{:mathvariant => "normal"} i
                  %mi A
                %annotation{:encoding => "application/x-tex"} A + \mathrm{i} A
            into an associative
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %a.existingWikiWord{:href => "/nlab/show/star-algebra"} algebra
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} [
                  %mi{:mathvariant => "normal"} i
                  %mo{:stretchy => "false"} ]
                  %mo ≔
                  %mi K
                  %mo{:stretchy => "false"} [
                  %mi{:mathvariant => "normal"} x
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} ⟨
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} ⟨
                  %msup
                    %mi{:mathvariant => "normal"} x
                    %mn 2
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} K[\mathrm{i}] \coloneqq K[\mathrm{x}]/\lang\!\lang\mathrm{x}^2 + 1\rang\!\rang
            (which is a proper extension of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is, because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is formally real). If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo +
                  %mi{:mathvariant => "normal"} i
                  %mi A
                %annotation{:encoding => "application/x-tex"} A + \mathrm{i} A
            becomes a
            = succeed "-algebra;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo +
                  %mi{:mathvariant => "normal"} i
                  %mi A
                %annotation{:encoding => "application/x-tex"} A + \mathrm{i} A
            becomes a von Neumann algebra.
          %p
            The intermediate Jordan–Lie–Banach case doesn't seem to work. For one thing, if we allow the Lie bracket to be unbounded (except when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} q = 0
            so that it is irrelevant), then we might not be able to define multiplication everywhere. Even assuming that the Lie bracket is bounded (at least when
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q \ne 0
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
          %p
            Conversely, starting with a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (possibly unital, possibly a Banach
            = succeed "-algebra)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} [
                  %mi{:mathvariant => "normal"} i
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} K[\mathrm{i}]
            and an
            %em invertible
            scalar
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            is invertible in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sa
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi x
                      %mo *
                    %mo =
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} sa(A) = \{x\colon A \;|\; x^* = x\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sa
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} sa(A)
            is closed):
          %ul
            %li
              addition, opposite, zero, scalar multiplication (by scalars in
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
            %li
              Jordan product:
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∘
                      %mi b
                      %mo ≔
                      %mfrac
                        %mn 1
                        %mn 2
                      %mi a
                      %mi b
                      %mo +
                      %mfrac
                        %mn 1
                        %mn 2
                      %mi b
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a \circ b \coloneqq \frac{1}{2} a b + \frac{1}{2} b a
            %li
              Lie bracket:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} ]
                      %mo ≔
                      %mfrac
                        %mn 1
                        %mrow
                          %mn 2
                          %mi{:mathvariant => "normal"} i
                          %mi q
                      %mi a
                      %mi b
                      %mo −
                      %mfrac
                        %mn 1
                        %mrow
                          %mn 2
                          %mi{:mathvariant => "normal"} i
                          %mi q
                      %mi b
                      %mi a
                    %annotation{:encoding => "application/x-tex"} [a, b] \coloneqq \frac{1} {2 \mathrm{i} q} a b - \frac{1} {2 \mathrm{i} q} b a
          %p
            In the Banach case, we may also define the norm by restriction. (There is no difficulty in this direction for arbitrary Banach
            = succeed "-algebras.)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
          %p
            We can write the resulting Jordan–Lie algebra as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sa
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} sa_q(A)
            or simply
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sa
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} sa(A)
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} q = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a Banach
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sa
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} sa_q(A)
            is a Jordan–Lie–Banach algebra (with the Lie bracket defined everywhere); if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sa
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} sa_q(A)
            is a
            = succeed "-algebra;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a von Neumann algebra, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sa
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} sa_q(A)
            is a
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
          %p
            (If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is a formally real
            = succeed "," do
              %em field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            must be invertible; but for more general rings, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            is not invertible in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            is invertible. If you leave out the divisions by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is, the Jordan product could have a norm as high as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            in the Banach case, and the
            = succeed "-identity" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "-case," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            somewhere.)
          %p
            This all defines a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            each way between the
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q \ne 0
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} adjoint equivalence
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            (not just
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi JLB
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} JLB Alg
            equivalent to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} C^* Alg
          %p
            In particular, for fixed
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q \ne 0
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            is equivalent to the category of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            (since both are equivalent to complex
            = succeed "-algebras)," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} q = 0
            to any of these other categories. (And this is not a very interesting functor, since it simply throws away the original Lie bracket and replaces it with zero.)
          %p
            Similarly, real
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q \ne 0
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^*
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/W-star-algebra"} algebras
          %h2#examples Examples
          %p
            Any commutative
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            is a trivial example of a Jordan–Lie algebra with the Lie bracket set to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/zero"} zero
            %a.existingWikiWord{:href => "/nlab/show/Banach+algebra"} Banach algebra
            is a Jordan–Lie–Banach algebra, any commutative
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} algebra
            with trivial involution is a
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^*
            %a.existingWikiWord{:href => "/nlab/show/W-star-algebra"} algebra
            with trivial involution is a
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            is irrelevant in these examples.
          %p
            More interestingly, given any
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} algebra
            (
            %em not
            assumed commutative or with trivial involution), the
            %a.existingWikiWord{:href => "/nlab/show/self-adjoint+elements"} self-adjoint elements
            form a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} q = 1
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^*
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/W-star-algebra"} algebra
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
            %em every
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed "-algebra)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} q = 1
            has this form; more generally, every
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo ≠
                  %mn 0
                %annotation{:encoding => "application/x-tex"} q \ne 0
            has this form upon dividing the Lie bracket by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            = succeed ")." do
              %a{:href => "#cstar"} above
          %p
            More specifically, given a
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operators"} self-adjoint operators
            form a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SA
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SA(H)
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} q = 1
            %em every
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed "-algebra)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} q = 1
            is a subalgebra of some
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SA
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SA(H)
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo ≠
                  %mn 0
                %annotation{:encoding => "application/x-tex"} q \ne 0
            has this form upon dividing the Lie bracket by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
          %p
            As for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q = 0
            %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
            is a Jordan–Lie algebra with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} q = 0
            has this form. This settles the purely algebraic case.
          %p
            For the topological case with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q = 0
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            (or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and take the unital Banach
            %span.newWikiWord
              algebra of bounded continuous functions
              %a{:href => "/nlab/new/algebra+of+bounded+continuous+functions"} ?
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            whose derivatives of all orders are bounded, but the Poisson bracket is still unbounded and not defined everywhere, since there are bounded smooth functions with unbounded derivatives, unless
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q = 0
            %em every
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} q = 0
            has this form.)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a (real)
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            of finite dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
            of a
            = succeed "," do
              %span.newWikiWord
                classical system
                %a{:href => "/nlab/new/classical+system"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
            on the dual
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊗
                    %msup
                      %mi V
                      %mo *
                    %mo ≅
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                  %annotation{:encoding => "application/x-tex"} V \otimes V^* \cong \mathbb{R}^{2n}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as consisting of (commutative)
            %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
            in the variables
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msup
                      %mi x
                      %mi n
                    %mo ,
                    %msub
                      %mi p
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi p
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x^1, \ldots, x^n, p_1, \ldots, p_n
            %em noncommutative
            polynomials consisting only of terms in which the variables come in order. Fixing a scalar
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            so that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi i
                    %mo ∘
                    %msup
                      %mi x
                      %mi j
                    %mo =
                    %msup
                      %mi x
                      %mrow
                        %mi min
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi x
                      %mrow
                        %mi max
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x^i \circ x^j = x^{\min(i,j)} x^{\max(i,j)}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mo ∘
                    %msub
                      %mi p
                      %mi j
                    %mo =
                    %msub
                      %mi p
                      %mrow
                        %mi min
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi p
                      %mrow
                        %mi max
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p_i \circ p_j = p_{\min(i,j)} p_{\max(i,j)}
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi i
                    %mo ∘
                    %msub
                      %mi p
                      %mi j
                    %mo =
                    %msup
                      %mi x
                      %mi i
                    %msub
                      %mi p
                      %mi j
                    %mo +
                    %mi q
                    %msubsup
                      %mi δ
                      %mi j
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x^i \circ p_j = x^i p_j + q \delta^i_j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∘
                %annotation{:encoding => "application/x-tex"} \circ
            from a product, we must add a term with a factor of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"} x^i
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi i
                %annotation{:encoding => "application/x-tex"} p_i
            appear on opposite sides of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∘
                  %annotation{:encoding => "application/x-tex"} \circ
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi x
                      %mi i
                    %mo ,
                    %msup
                      %mi x
                      %mi j
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} [x^i, x^j] = 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi p
                      %mi i
                    %mo ,
                    %msub
                      %mi p
                      %mi j
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} [p_i, p_j] = 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi x
                      %mi i
                    %mo ,
                    %msub
                      %mi p
                      %mi j
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mfrac
                      %mn 1
                      %mn 2
                    %msubsup
                      %mi δ
                      %mi j
                      %mi i
                  %annotation{:encoding => "application/x-tex"} [x^i, p_j] = -\frac{1}{2} \delta^i_j
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the usual symmetric algebra of commutative polynomials again, while for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q \ne 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            becomes
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sa
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sa_q(W)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            is the
            %a.existingWikiWord{:href => "/nlab/show/Weyl+algebra"} Weyl algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A + \mathrm{i} A
          %h2#representations Representations
          %p
            In general, a
            %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            of a Jordan–Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in a Jordan–Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is simply a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            (in the usual sense of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/universal+algebra"} universal algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q \gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to be an associative
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %a.existingWikiWord{:href => "/nlab/show/star-algebra"} algebra
            and represent
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in it with a homomorphism to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sa
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sa(B)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            (see
            = succeed ")." do
              %a{:href => "#examples"} above
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a Jordan–Lie–Banach algebra, then we generally want
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to be the same, or to be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Banach+%2A-algebra"} Banach algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/short+map"} short
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is unital, we generally want
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to be the same, and to have the homomorphism preserve the unit. When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to be the same, or to be a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to be the same or to be a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^*
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/W-star-algebra"} algebra
          %p
            Instead of a representation
            %em in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %em on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is an
            %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
            over the
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            (or the complexification of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            more generally). This is a representation in the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %a.existingWikiWord{:href => "/nlab/show/linear+operators"} linear operators
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a Jordan–Lie–Banach algebra (especially a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
            = succeed "-algebra)," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLBW
                  %annotation{:encoding => "application/x-tex"} JLBW
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            to be a
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            and look only at the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bounded+operators"} bounded operators
          %h2#references References
          %p A definition is in section 1.1 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hans+Halvorson"} Hans Halvorson
              and
              %span.newWikiWord
                Rob Clifton
                %a{:href => "/nlab/new/Rob+Clifton"} ?
              (1999).
              = succeed "." do
                %em Maximal Beable Subalgebras of Quantum-Mechanical Observables
              = succeed "." do
                %a{:href => "http://philsci-archive.pitt.edu/65/1/beables.pdf"} PDF
          %p A brief remark is on page 80 of
          %ul
            %li
              %span.newWikiWord
                Sean Bates
                %a{:href => "/nlab/new/Sean+Bates"} ?
              and
              %a.existingWikiWord{:href => "/nlab/show/Alan+Weinstein"} Alan Weinstein
              (1995?).
              = succeed "." do
                %em Lectures on the geometry of quantization
              = succeed "." do
                %a{:href => "http://www.math.berkeley.edu/~alanw/GofQ.pdf"} PDF
