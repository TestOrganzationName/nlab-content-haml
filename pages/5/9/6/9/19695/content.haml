              on the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(H)
