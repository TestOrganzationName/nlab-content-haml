            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is a fixed locus for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ⊂
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H \subset N(H)
              %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariance
              this restriction has to factor through the
              = succeed "-fixed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
