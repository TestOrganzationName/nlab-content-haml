                        %mrow
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi H
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi H
                    %annotation{:encoding => "application/x-tex"} Y \subset G/H \times_{N(H)/H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              already determines
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              uniquely.
            %p
              Since this construction is manifestly
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ↔
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} f \leftrightarrow \tilde f
