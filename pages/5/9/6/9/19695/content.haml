              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi H
                        %mo ∈
                        %mi Topological
                        %mi G
                        %mi Spaces
                      %annotation{:encoding => "application/x-tex"} G/H \in Topological G Spaces
            %li
