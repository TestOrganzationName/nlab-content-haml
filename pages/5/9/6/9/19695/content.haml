                    %msub
                      %mo ×
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi H
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi H
                    %mi Y
                    %mover
                      %mo ⟶
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi f
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G/H \times_{N(H)/H}  Y
                    \\overset{
