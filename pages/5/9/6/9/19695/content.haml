                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} /
                                %mi H
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
