                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi G
                            %mo{:stretchy => "false"} /
                            %mi H
                            %msub
                              %mo ×
                              %mrow
                                %mi N
                                %mo{:stretchy => "false"} (
                                %mi H
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} /
                                %mi H
                            %mi Y
                        %mtr
                          %mtd
                            %mi y
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                            %mi e
                            %mi H
                            %mo ,
                            %mi y
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
