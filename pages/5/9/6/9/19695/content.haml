          .proof
            %h6 Proof
            %p
            %p
              To see the
              %a{:href => "adjoint+functor#InTermsOfHomIsomorphism"} hom-isomorphism
              characterizing this
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
