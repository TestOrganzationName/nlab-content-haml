                        %mo{:stretchy => "false"} /
                        %mi H
                        %mo ∈
                        %mi TopologicalGroups
                      %annotation{:encoding => "application/x-tex"} W_H(G) \coloneqq N_G(H)/H \in TopologicalGroups
          %p
            Observing that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi Topological
                  %mi G
                  %mi Spaces
                %annotation{:encoding => "application/x-tex"} X \in Topological G Spaces
            the
            = succeed "-fixed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
