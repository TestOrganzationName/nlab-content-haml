                    }
            %p
              But given that and since every other point of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %msub
                      %mo ×
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi H
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi H
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} G/H \times_{N(H)/H} Y
              is an image under the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo ⊂
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                      %msub
