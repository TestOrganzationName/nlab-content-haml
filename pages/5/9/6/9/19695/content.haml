                    %mi Σ
                    %mover
                      %mo ↪
                      %mi ι
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma \overset{\iota}{\hookrightarrow} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth
              %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
              inside the
