                        %mtd
                          %mn 1
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mo *
                      %mtr
                        %mtd
                          %msup
                            %mi X
                            %mrow
                              %msup
                                %mi S
                                %mn 1
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %msup
                                %mi X
                                %mi pt
                        %mtd
                          %msup
                            %mi X
                            %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Omega X &amp; \to &amp; 1\\
                  \\downarrow &amp; &amp; \downarrow *\\
                  X^{S^1} &amp; \underset{X^{pt}}{\to} &amp; X^1
                  }
          %p
            (using
            %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponentials
            to denote internal homs in
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
            %a.existingWikiWord{:href => "/nlab/show/function+set"} function space
            of basepoint-preserving maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S^1 \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} S^1 \to X
            at the basepoint of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mo *
                %annotation{:encoding => "application/x-tex"} Top_*
            is
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
            monoidal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+closed+category"} closed
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                  %annotation{:encoding => "application/x-tex"} \wedge
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo =
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi pt
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi Top
                    %mo *
                  %mo →
                  %msub
                    %mi Top
                    %mo *
                %annotation{:encoding => "application/x-tex"} \Omega = hom((S^1, pt), -): Top_* \to Top_*
          %p
            has a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            obtained by taking the smash product with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi pt
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S^1, pt)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo :
                  %msub
                    %mi Top
                    %mo *
                  %mo →
                  %msub
                    %mi Top
                    %mo *
                %annotation{:encoding => "application/x-tex"} S: Top_* \to Top_*
            is called the
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
                functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mi X
                %annotation{:encoding => "application/x-tex"} S X
            is formed as the
            %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %mn 1
                          %mo ×
                          %mi X
                          %mo +
                          %msup
                            %mi S
                            %mn 1
                          %mo ×
                          %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %mn 1
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi pt
                          %mo ×
                          %mi X
                          %mo ,
                          %msup
                            %mi S
                            %mn 1
                          %mo ×
                          %mo *
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mi S
                            %mn 1
                          %mo ×
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mi S
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; 1 \times X + S^1 \times 1&amp; \to &amp; 1\\
                  (pt \times X, S^1 \times *) &amp; \downarrow &amp; &amp; \downarrow \\
                  \&amp; S^1 \times X &amp; \to &amp; S X
                  }
          %p with basepoint provided by the right vertical arrow.
          %h2#properties Properties
          %h3#AInfinityStructure Homotopy-associative structure
          %p
            A loop space is an example of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+space"} A-∞ space
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/H-space"} H-space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            carries a correspondingly rich co-algebraic structure, starting from the fact that the based space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            is an H-
            %a.existingWikiWord{:href => "/nlab/show/cogroup"}> cogroup
            \.
          %p
            The description of this structure on loop spaces was the very motivation for the introduction of the notion of an
            %a.existingWikiWord{:href => "/nlab/show/operad"} operad
            and an
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
            in (
            %a{:href => "#May"}> May
            ).
          %p
            An important theoretical consideration is when an H-space, and particularly one having the type of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %mi Ω
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \simeq \Omega Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            carries a
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            structure
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            The most basic fact about deloopings is the shift in
            = succeed "s:" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi π
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(\Omega Y) \cong \pi_{n+1}(Y)
          %p
            which follows straight from the
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊣
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} S \dashv \Omega
            plus the fact that the suspension of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S^n
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{n+1}
          %p
            The modern study of the question “when can an H-space be
            = succeed "?\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooped
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
          .num_theorem
            %h6#theorem Theorem
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/H-space"} H-space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              admits a delooping if and only if the
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(X)
              induced from the H-space structure is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              structure can be extended to a structure of
              %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
              over
              = succeed "\u2018s" do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Stasheff
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+operad"} A-∞ operad
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
          %p
            This is due to (
            %a{:href => "#Stasheff"}> Stasheff
            ). The analogous statement holds true in every
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            other than
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            and at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object in an (∞,1)-category
          %h3#local_homotopy_properties Local homotopy properties
          %p
            Let the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be
            %a.existingWikiWord{:href => "/nlab/show/locally+connected+space"} locally 0-connected
            and
            %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply+connected+space"} semi-locally 1-connected
            (i.e. it admits a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega X
            for any basepoint is locally path connected, as is the free loop space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} X^{S^1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is locally 1-connected and admits a basis of open sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_2(U) \to \pi_2(X)
            is the zero map, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega X
            is locally 0-connected and semi-locally 1-connected, and so admits a universal covering space.
          %p
            In general, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is locally
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-connected+space"} connected
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega X
            is locally
            = succeed "-connected." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            times, so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi n
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega^n X
            is locally 0-connected. This can be weakened to locally
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            = succeed "-connected:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n=1
            case but replacing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \pi_1
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                %annotation{:encoding => "application/x-tex"} \pi_n
            (as was done in the previous paragraph with
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \pi_2
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-connected." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi P
                %annotation{:encoding => "application/x-tex"} X^P
            and various subspaces when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is Hausdorff and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            a finite
            %a.existingWikiWord{:href => "/nlab/show/polyhedron"} polyhedron
            in (
            %a{:href => "#Wada"}> Wada
            ) but a much simpler and direct proof for general
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo =
                  %mi I
                %annotation{:encoding => "application/x-tex"} P = I
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo =
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} P= S^1
            is possible.
          .un_theorem
            %h6#conjecture Conjecture
            %p
              The fundamental
              = succeed "-groupoid" do
