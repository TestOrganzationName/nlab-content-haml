          %h2#idea Idea
          %p
            In the strict sense of the word, a
            %em loop space
            in
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            for a given
            %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            (with its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
            = succeed ")" do
              %a{:href => "compact-open+topology#LoopSpace"} there
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Maps
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Maps_\ast(S^1, X)
            of
            %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            from the
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (or if one drops this condition, then one speaks of the
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
