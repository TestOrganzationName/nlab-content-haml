          %title Relevance logics
          %h1#relevance_logics Relevance logics
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#general_description"} General description
              %li
                %a{:href => "#some_relevance_logics"} Some relevance logics
