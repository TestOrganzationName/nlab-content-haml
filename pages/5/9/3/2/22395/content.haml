            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Zariski+spectrum"} Zariski spectrum
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/modules+over+a+ring+are+equivalent+to+quasicoherent+sheaves+over+its+spectrum"} modules over a ring are equivalent to quasicoherent sheaves over its spectrum
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Serre-Swan+theorem"}> Serre-Swan theorem
                ,
                %a.existingWikiWord{:href => "/nlab/show/smooth+Serre-Swan+theorem"} smooth Serre-Swan theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
            %li
