                          %mtd
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi v
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi C
                              %mi I
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
