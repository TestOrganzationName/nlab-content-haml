                            %msub
                              %mo ×
                              %mi C
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi v
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi u
                          %mtd
                            %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \times_C C^I \times_C B &amp;\to&amp; B
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{v}}
                    \\\
                    A &amp;\stackrel{u}{\to}&amp; C
                    }
            %p
              commute up to
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              (see the section on homotopies for more on that).
          .num_remark
            %h6#remark_2 Remark
            %p
              These homotopy pullbacks present indeed the correct
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-limits"} (infinity,1)-limits
              %a.maruku-ref{:href => "#PullbacksAlongFibrationsAreCorrectHomotopyPullbacks"}
              below.
          .num_lemma
            %h6#lemma_9 Lemma
            %p The projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ×
                      %mi C
                    %msup
                      %mi C
                      %mi I
                    %msub
                      %mo ×
                      %mi C
                    %mi B
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    A \times_C C^I \times_C B \to A
            %p
              out of a homotopy fiber product is a fibration. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} v : B \to C
              is a weak equivalence, then this is an acyclic fibration.
          %p
            The same is of course true for the map to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and the morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %mi A
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} u : A \to C
          .proof
            %h6#proof_9 Proof
            %p
              One may compute this
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              in terms of two consecutive
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            %p On the one hand we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %msub
                              %mo ×
                              %mi C
                            %msup
                              %mi C
                              %mi I
                            %msub
                              %mo ×
                              %mi C
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi E
                              %mi v
                            %mi C
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi v
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi C
                              %mi I
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mn 1
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi u
                          %mtd
                            %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \times_C C^I \times_C B &amp;\to&amp; \mathbf{E}_v C &amp;\to
                    \&amp; B
                    \\\
                    \&amp;&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{v}}
                    \\\
                    \&amp; &amp;C^I &amp; \stackrel{d_0}{\to}&amp; C
                    \\\
                    \\downarrow &amp;&amp;
                    \\downarrow^{\mathrlap{d_1}}
                    \\\
                    A &amp;\stackrel{u}{\to}&amp; C
                    }
            %p
              where both squares are
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              squares.
            %p
              By the above lemma on generalized universal bundles, the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi v
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}_v C \to C
              is a fibration. The first claim follows then since fibrations are stable under pullback.
            %p On the other hand we can rewrite the limit diagram also as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %msub
                              %mo ×
                              %mi C
                            %msup
                              %mi C
                              %mi I
                            %msub
                              %mo ×
                              %mi C
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi v
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi E
                              %mi u
                            %mi C
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo ∈
                                %mi W
                                %mo ∩
                                %mi F
                          %mtd
                            %msup
                              %mi C
                              %mi I
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                                %mo ∈
                                %mi W
                                %mo ∩
                                %mi F
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi F
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mn 1
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi F
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi u
                          %mtd
                            %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \times_C C^I \times_C B &amp;\to&amp; &amp;&amp; B
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow^{\mathrlap{v}}
                    \\\
                    \\mathbf{E}_u C &amp; \stackrel{\in W \cap F}{\to} &amp;C^I &amp;
                    \\stackrel{d_0 \in W \cap F}{\to}&amp; C
                    \\\
                    \\downarrow^{\mathrlap{\in W \cap F}}
                    \&amp;&amp;
                    \\;\;\downarrow^{\mathrlap{d_1\in W \cap F}}
                    \\\
                    A &amp;\stackrel{u}{\to} &amp; C
                    }
            %p
              where again both inner squares are
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              squares.
            %p
              Again by the above statement on generalized universal bundles, we have that the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi u
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}_u C \to C
              is a fibration. By one of the above propositions, weak equivalences are stable under pullback along fibrations, hence the pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ×
                      %mi C
                    %msup
                      %mi C
                      %mi I
                    %msub
                      %mo ×
                      %mi C
                    %mi B
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi u
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A \times_C C^I \times_C B \to \mathbf{E}_u C
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is a weak equivalence. Since also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi u
                    %mi C
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}_u C \to A
              is a weak equivalence (being the pullback of an acyclic fibration) the entire morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ×
                      %mi C
                    %msup
                      %mi C
                      %mi I
                    %msub
                      %mo ×
                      %mi C
                    %mi B
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \times_C C^I \times_C B  \to A
              is.
          %h3#Homotopies Homotopies
          .num_defn
            %h6#definition_6 Definition
            %p
              Two morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f,g : A \to B
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(A,B)
              are
            %ul
              %li
                %p
                  %strong>
                    right
                    %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
                  , denoted
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo ≃
                          %mi g
                        %annotation{:encoding => "application/x-tex"} f \simeq g
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi B
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mi f
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↑
                                  %mrow
                                    %msub
                                      %mi d
                                      %mn 0
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                                %mover
                                  %mo →
                                  %mi η
                              %mtd
                                %msup
                                  %mi B
                                  %mi I
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mrow
                                  %mi g
                                %mo ↘
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi d
                                        %mn 1
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi B
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; B
                        \\\
                        \&amp; {}^f\nearrow &amp; \uparrow^{d_0}
                        \\\
                        A &amp;\stackrel{\eta}{\to}&amp;
                        B^I
                        \\\
                        \&amp; {}_g\searrow &amp; \downarrow^{\mathrlap{d_1}}
                        \\\
                        \&amp;&amp; B
                        }
                %p
                  for some
                  %a.existingWikiWord{:href => "/nlab/show/path+object"} path space object
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi B
                            %mi I
                        %annotation{:encoding => "application/x-tex"} B^I
              %li
                %p
                  %strong>
                    %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
                  , denoted
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo ∼
                          %mi g
                        %annotation{:encoding => "application/x-tex"} f \sim g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mi w
                                %mo ∈
                                %mi W
                            %mo ↗
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                        %mtr
                          %mtd
                            %mover
                              %mi A
                              %mo{:stretchy => "false"} ^
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi η
                          %mtd
                          %mtd
                            %msup
                              %mi B
                              %mi I
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mi w
                                %mo ∈
                                %mi W
                            %mo ↘
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi d
                                  %mn 1
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;
                    A
                    \&amp;\stackrel{f}{\to}&amp; B
                    \\\
                    \&amp;{}^{w \in W}\nearrow&amp;&amp;&amp; \uparrow^{d_0}
                    \\\
                    \\hat A
                    \&amp;&amp;
                    \\stackrel{\eta}{\to}
                    \&amp;&amp;
                    B^I
                    \\\
                    \&amp;{}_{w\in W}\searrow &amp; &amp;&amp;
                    \\downarrow^{d_1}
                    \\\
                    \&amp;&amp;
                    A
                    \&amp;\stackrel{g}{\to}&amp;
                    B
                    }
            %p
              for some object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat A
              and for some
              %a.existingWikiWord{:href => "/nlab/show/path+object"} path space object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi I
                  %annotation{:encoding => "application/x-tex"} B^I
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          .num_remark
            %h6#remark_3 Remark
            %p
              So this says that there is a right
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              between the two morphisms after both are pulled back to a sufficiently good resolution of their domain.
          .num_lemma
            %h6#lemma_10 Lemma
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} A,B \in \mathbf{C}
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}(A,B)
          .proof
            %h6#proof_10 Proof
            %p This follows by “piecing path spaces together”:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mrow
                        %msub
                          %mi I
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} B^{I_1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mrow
                        %msub
                          %mi I
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} B^{I_2}
              be two path space objects of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi B
                              %mrow
                                %msub
                                  %mi I
                                  %mn 1
                                %mo ∨
                                %msub
                                  %mi I
                                  %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi B
                              %mrow
                                %msub
                                  %mi I
                                  %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                        %mtr
                          %mtd
                            %msup
                              %mi B
                              %mrow
                                %msub
                                  %mi I
                                  %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi d
                                  %mn 1
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    B^{I_1 \vee I_2} &amp;\to&amp;  B^{I_2}
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{d_0}
                    \\\
                    B^{I_1} &amp;\stackrel{d_1}{\to}&amp; B
                    }
            %p defines a new path object, with structure maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi σ
                          %mn 1
                        %mo ×
                        %msub
                          %mi σ
                          %mn 2
                    %msup
                      %mi B
                      %mrow
                        %msub
                          %mi I
                          %mn 1
                        %mo ∨
                        %msub
                          %mi I
                          %mn 2
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi d
                          %mn 0
                        %mo ∘
                        %msub
                          %mi p
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi d
                          %mn 1
                        %mo ∘
                        %msub
                          %mi p
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mi B
                    %mo ×
                    %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    B
                    \\stackrel{\sigma_1 \times \sigma_2}{\to}
                    B^{I_1 \vee I_2}
                    \\stackrel{(d_0 \circ p_1) \times (d_1\circ p_2)}{\to}
                    B \times B
                    \\,.
            %p
              So given two right homotopies with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mrow
                        %msub
                          %mi I
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} B^{I_1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mrow
                        %msub
                          %mi i
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} B^{i_2}
              we can paste them next to each other and deduce a homotopy through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mrow
                        %msub
                          %mi I
                          %mn 1
                        %mo ∨
                        %msub
                          %mi I
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} B^{I_1 \vee I_2}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mi f
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mrow
                                %msubsup
                                  %mi d
                                  %mn 0
                                  %mn 1
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi η
                                  %mn 1
                          %mtd
                            %msup
                              %mi B
                              %mrow
                                %msub
                                  %mi I
                                  %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mi g
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi d
                                    %mn 1
                                    %mn 1
                          %mtd
                            %mo ↖
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                          %mtd
                          %mtd
                            %msup
                              %mi B
                              %mrow
                                %msub
                                  %mi I
                                  %mn 1
                                %mo ∨
                                %msub
                                  %mi I
                                  %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mi g
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi d
                                    %mn 0
                                    %mn 2
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi η
                                  %mn 2
                          %mtd
                            %msup
                              %mi B
                              %mrow
                                %msub
                                  %mi I
                                  %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mi h
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi d
                                    %mn 1
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; B
                    \\\
                    \&amp; {}^f\nearrow &amp;  \uparrow^{d_0^1}
                    \\\
                    A &amp;\stackrel{\eta_1}{\to}&amp;
                    B^{I_1}
                    \\\
                    \&amp; {}_{g}\searrow&amp; \downarrow^{\mathrlap{d_1^1}}
                    \&amp; \nwarrow
                    \\\
                    \&amp;&amp; B &amp;&amp; B^{I_1 \vee I_2}
                    \\\
                    \&amp; {}^{g}\nearrow &amp; \downarrow^{\mathrlap{d_0^2}}
                    \&amp; \swarrow
                    \\\
                    A &amp;\stackrel{\eta_2}{\to}&amp; B^{I_2}
                    \\\
                    \&amp; {}_h\searrow &amp; \downarrow^{\mathrlap{d_1^2}}
                    \\\
                    \&amp;&amp;B
                    }
          %p
            We next similarly want to deduce that not only right homotopy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ≃
                  %mi g
                %annotation{:encoding => "application/x-tex"} f \simeq g
            but also true homtopy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∼
                  %mi g
                %annotation{:encoding => "application/x-tex"} f \sim g
            defines an equivalence relation on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}(A,B)
          .num_lemma
            %h6#lemma_11 Lemma
            %p Every diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi W
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi p
                                  %mo ∈
                                  %mi F
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\to&amp; E
                    \\\
                    \\;\;\downarrow^{\mathrlap{i \in W}}
                    \&amp;&amp;
                    \\;\;\downarrow^{\mathrlap{p \in F}}
                    \\\
                    X
                    \&amp;\to&amp;
                    B
                    }
            %p may be refined to a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                            %mo ′
                          %mtd
                            %mo →
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mi i
                            %mo ↘
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi t
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi F
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi p
                                  %mo ∈
                                  %mi F
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\to &amp; X' &amp;\to&amp; E
                    \\\
                    \&amp; {}_{i}\searrow &amp;
                    \\;\;\downarrow^{\mathrlap{t \in W \cap F}}
                    \&amp;&amp;
                    \\;\;\downarrow^{\mathrlap{p \in F}}
                    \\\
                    \&amp;&amp; X
                    \&amp;\to&amp;
                    B
                    }
          .proof
            %h6#proof_11 Proof
            %p Consider the pullback square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                            %msub
                              %mo ×
                              %mi B
                            %mi E
                          %mtd
                            %mo →
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mi i
                                %mo ∈
                                %mi W
                            %mo ↘
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi F
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi F
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\to&amp;
                    X \times_B E &amp;\to&amp; E
                    \\\
                    \&amp;{}_{i \in W}\searrow&amp; \;\; \downarrow^{\mathrlap{\in F}}
                    \&amp;&amp;
                    \\;\; \downarrow^{\mathrlap{\in F}}
                    \\\
                    \&amp;&amp; X &amp;\to&amp; B
                    }
            %p
              and apply the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              = succeed "," do
                %a.maruku-ref{:href => "#FactorizationLemma"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi X
                    %msub
                      %mo ×
                      %mi B
                    %mi E
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} A \to X \times_B E \to E
              into the pullback as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi W
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi E
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi F
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    A \stackrel{\in W}{\to} \mathbf{E} E \stackrel{\in F}{\to}
                    E
            %p to obtain the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi E
                            %mi E
                          %mtd
                            %mo →
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mi i
                                %mo ∈
                                %mi W
                            %mo ↘
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi F
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi F
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\stackrel{\simeq}{\to}&amp;
                    \\mathbf{E} E &amp;\to&amp; E
                    \\\
                    \&amp;{}_{i \in W}\searrow&amp;
                    \\;\; \downarrow^{\mathrlap{\in F}}
                    \&amp;&amp;
                    \\;\; \downarrow^{\mathrlap{\in F}}
                    \\\
                    \&amp;&amp; X &amp;\to&amp; B
                    }
                    \\,,
            %p
              where the middle vertical morphism is still a fibration, being the composite of two fibrations. By
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} 2-out-of-3
              it follows that it is also a weak equivalence.
          .num_lemma
            %h6#lemma_12 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} u : B \to C
              a morphism and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mi I
                    %annotation{:encoding => "application/x-tex"} B^I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi I
                  %annotation{:encoding => "application/x-tex"} C^I
              choices of path objects, there is always another path object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mrow
                        %mi I
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} B^{I'}
              with an acyclic fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi I
                    %mover
                      %mo ←
                      %mrow
                        %mo ∈
                        %mi W
                        %mo ∩
                        %mi F
                    %msup
                      %mi B
                      %mrow
                        %mi I
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} B^I \stackrel{\in W \cap F}{\leftarrow} B^{I'}
              and a span of morphisms of path space objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo ←
                              %mo =
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mi u
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi σ
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %mi σ
                                %mo ′
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi σ
                                    %mi C
                        %mtr
                          %mtd
                            %msup
                              %mi B
                              %mi I
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %mo ∈
                                %mi W
                                %mo ∩
                                %mi F
                          %mtd
                            %msup
                              %mi B
                              %mrow
                                %mi I
                                %mo ′
                          %mtd
                            %mover
                              %mo →
                              %mover
                                %mi u
                                %mo{:stretchy => "false"} ¯
                          %mtd
                            %msup
                              %mi C
                              %mi I
                        %mtr
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                                %mo ×
                                %msub
                                  %mi d
                                  %mn 1
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi d
                                  %msub
                                    %mo ′
                                    %mn 0
                                  %mo ×
                                  %mi d
                                  %msub
                                    %mo ′
                                    %mn 1
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi d
                                    %mn 0
                                    %mi C
                                  %mo ×
                                  %msubsup
                                    %mi d
                                    %mn 1
                                    %mi C
                        %mtr
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                          %mtd
                            %mover
                              %mo ←
                              %mo =
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi u
                                %mo ×
                                %mi u
                          %mtd
                            %mi C
                            %mo ×
                            %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    B &amp;\stackrel{=}{\leftarrow}&amp; B &amp;\stackrel{u}{\to}&amp; C
                    \\\
                    \\downarrow^{\mathrlap{\sigma}} &amp;&amp; \downarrow^{\sigma'} &amp;&amp; \downarrow^{\mathrlap{\sigma_C}}
                    \\\
                    B^I &amp;\stackrel{\in W \cap F}{\leftarrow}&amp; B^{I'} &amp;\stackrel{\bar u}{\to}&amp; C^I
                    \\\
                    \\;\;\downarrow^{d_0 \times d_1}
                    \&amp;&amp; \;\;\downarrow^{\mathrlap{d'_0 \times d'_1}}
                    \&amp;&amp; \;\;\downarrow^{\mathrlap{d_0^C \times d_1^C}}
                    \\\
                    B \times B
                    \&amp;\stackrel{=}{\leftarrow}&amp;
                    B \times B
                    \&amp;\stackrel{u \times u}{\to}&amp;
                    C \times C
                    }
          .proof
            %h6#proof_12 Proof
            %p Apply the lemma above to the square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mi u
                          %mtd
                            %mi C
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi σ
                                  %mi C
                          %mtd
                            %msup
                              %mi C
                              %mi I
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi σ
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mn 0
                                  %mo ×
                                  %msub
                                    %mi d
                                    %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mi B
                              %mi I
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                                %mo ×
                                %msub
                                  %mi d
                                  %mn 1
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi u
                                %mo ×
                                %mi u
                          %mtd
                            %mi C
                            %mo ×
                            %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    B &amp;\stackrel{u}{\to}&amp; C
                    \&amp;\stackrel{\sigma_C}{\to}&amp;
                    C^I
                    \\\
                    \\downarrow^{\mathrlap{\sigma}} &amp;&amp;&amp;&amp; \downarrow^{\mathrlap{d_0 \times d_1}}
                    \\\
                    B^I &amp;\stackrel{d_0 \times d_1}{\to}&amp; B \times B
                    \&amp;\stackrel{u \times u}{\to}&amp; C \times C
                    }
                    \\,.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Right homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ≃
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \simeq g
              between morphisms is preserved under pre- and postcomposition with a given morphism.
            %p
              More precisely, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f, g : B \to C
              be two homotopic morphisms. Then
            %ul
              %li
                %p
                  for all morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A \to B
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo →
                        %mi D
                      %annotation{:encoding => "application/x-tex"} C \to D
                  the composites
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo →
                        %mi B
                        %mover
                          %mo →
                          %mi f
                        %mi C
                        %mo →
                        %mi D
                      %annotation{:encoding => "application/x-tex"} A \to B \stackrel{f}{\to} C \to D
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo →
                        %mi B
                        %mover
                          %mo →
                          %mi g
                        %mi C
                        %mo →
                        %mi D
                      %annotation{:encoding => "application/x-tex"} A \to B \stackrel{g}{\to} C \to D
                  are still right homotopic.
              %li
                %p
                  moreover, the right homotopy may be realized with every given choice of
                  %br/
                  %a.existingWikiWord{:href => "/nlab/show/path+object"} path space object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi D
                          %mi I
                      %annotation{:encoding => "application/x-tex"} D^I
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                        %annotation{:encoding => "application/x-tex"} D
          .proof
            %h6#proof_13 Proof
            %p We decompose this into two statements:
            %ol
              %li
                %p
                  for any
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A \to B
                  the morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo →
                        %mi B
                        %mover
                          %mo →
                          %mrow
                            %mi f
                            %mo ,
                            %mi g
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A \to B \stackrel{f,g}{\to} B
                  are right homotopic.
              %li
                %p
                  for any
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mo :
                        %mi C
                        %mo →
                        %mi D
                      %annotation{:encoding => "application/x-tex"} u : C \to D
                  and choice
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi D
                          %mi I
                      %annotation{:encoding => "application/x-tex"} D^I
                  of path object there is an acyclic fibration
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ′
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"}
                        B' \to B
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ′
                        %mo →
                        %mi B
                        %mover
                          %mo →
                          %mi f
                        %mi C
                        %mo →
                        %mi D
                      %annotation{:encoding => "application/x-tex"} B' \to B \stackrel{f}{\to} C \to D
                  is right homotopic to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ′
                        %mo →
                        %mi B
                        %mover
                          %mo →
                          %mi g
                        %mi C
                        %mo →
                        %mi D
                      %annotation{:encoding => "application/x-tex"} B' \to B \stackrel{g}{\to} C \to D
                  by a right homotopy
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi η
                          %mo :
                          %mi B
                          %mo ′
                          %mo →
                          %msup
                            %mi D
                            %mi I
                        %annotation{:encoding => "application/x-tex"} \eta : B' \to D^I
            %p The first of these follows trivially.
            %p
              The second one follows by using the weak functoriality property of path objects from above: let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ′
                    %mo :
                    %mo =
                    %mi B
                    %msub
                      %mo ×
                      %mrow
                        %msup
                          %mi C
                          %mi I
                    %msup
                      %mi C
                      %mrow
                        %mi I
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} B' := B \times_{C^I} C^{I'}
              be the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              in the following diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi B
                            %mo ′
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi C
                              %mrow
                                %mi I
                                %mo ′
                          %mtd
                            %mover
                              %mo →
                              %mover
                                %mi u
                                %mo{:stretchy => "false"} ¯
                          %mtd
                            %msup
                              %mi D
                              %mi I
                        %mtr
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi F
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi F
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mi η
                          %mtd
                            %msup
                              %mi C
                              %mi I
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mi f
                                %mo ×
                                %mi g
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi C
                            %mo ×
                            %mi C
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi u
                                %mo ×
                                %mi u
                          %mtd
                            %mi D
                            %mo ×
                            %mi D
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    B'
                    \&amp;\to&amp;
                    C^{I'}
                    \&amp;\stackrel{\bar u}{\to}&amp;
                    D^I
                    \\\
                    \\;\;\;\downarrow^{\mathrlap{\in W \cap F}}
                    \&amp;&amp;
                    \\;\;\;\downarrow^{\mathrlap{\in W \cap F}}
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    B
                    \&amp;\stackrel{\eta}{\to}&amp;
                    C^I
                    \\\
                    \&amp;{}_{f \times g}\searrow
                    \&amp; \downarrow
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    \&amp;&amp;
                    C \times C
                    \&amp;\stackrel{u \times u}{\to}&amp;
                    D \times D
                    }
          %p We need one more intermediate result for seeing that homotopy is an equivalence relation
          .num_lemma
            %h6#lemma_13 Lemma
            %ul
              %li
                %p Every diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi B
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi w
                                      %mo ∈
                                      %mi W
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                                %mo →
                              %mtd
                                %mi C
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; B
                        \\\
                        \&amp;&amp; \downarrow^{\mathrlap{w \in W}}
                        \\\
                        A &amp;\to&amp; C
                        }
                %p
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                      %annotation{:encoding => "application/x-tex"} \mathbf{C}
                  extends to a (right) homtopy-commutative diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi A
                                %mo ′
                              %mtd
                                %mo →
                              %mtd
                                %mi B
                            %mtr
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi w
                                      %mo ′
                                      %mo ∈
                                      %mi W
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi w
                                      %mo ∈
                                      %mi W
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                                %mo →
                              %mtd
                                %mi C
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        A' &amp;\to &amp; B
                        \\\
                        \\downarrow^{\mathrlap{w' \in W}} &amp;&amp; \downarrow^{\mathrlap{w \in W}}
                        \\\
                        A &amp;\to&amp; C
                        }
                        \\,.
              %li
                %p For every pair of morphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ,
                        %mi g
                        %mo ,
                        %mi A
                        %mover
                          %mo →
                          %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"}
                        f, g, A \stackrel{\to}{\to} B
                %p
                  and weak equivalence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo :
                        %mi B
                        %mover
                          %mo →
                          %mrow
                            %mo ∈
                            %mi W
                        %mi C
                      %annotation{:encoding => "application/x-tex"} t : B \stackrel{\in W}{\to} C
                  such that there is a right homotopy
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi t
                          %mo ∘
                          %mi f
                          %mo ≃
                          %mi t
                          %mo ∘
                          %mi g
                        %annotation{:encoding => "application/x-tex"} t \circ f \simeq t \circ g
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ′
                        %mo :
                        %mi A
                        %mo ′
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} t' : A' \to A
                  such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo ∘
                          %mi t
                          %mo ′
                          %mo ≃
                          %mi g
                          %mo ∘
                          %mi t
                          %mo ′
                        %annotation{:encoding => "application/x-tex"} f \circ t' \simeq g \circ t'
          .proof
            %h6#proof_14 Proof
            %ul
              %li
                %p
                  The first point we accomplish this by letting
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ′
                        %mo :
                        %mo =
                        %mi A
                        %msub
                          %mo ×
                          %mi C
                        %msup
                          %mi C
                          %mi I
                        %msub
                          %mo ×
                          %mi C
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A' := A \times_C C^I \times_C B
                  be the homotopy fiber product in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  of a representative of the pullback diagram. The lemma about morphisms out of the homotopy fiber product says that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ′
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A' \to A
                  is a weak equivalence.
              %li
                %p
                  The second point is more work. Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo :
                        %mi A
                        %mo →
                        %msup
                          %mi C
                          %mi I
                      %annotation{:encoding => "application/x-tex"} \eta : A \to C^I
                  the right homotopy in question. We start by considering the homotopy fiber product
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi D
                                %mo :
                                %mo =
                                %mi B
                                %msub
                                  %mo ×
                                  %mi C
                                %msup
                                  %mi C
                                  %mi I
                                %msub
                                  %mo ×
                                  %mi C
                                %mi B
                              %mtd
                                %mo →
                              %mtd
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mo ∈
                                    %mi W
                              %mtd
                                %mi B
                            %mtr
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mo ∈
                                      %mi W
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi t
                                      %mo ∈
                                      %mi W
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msup
                                  %mi C
                                  %mi I
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %msub
                                      %mi d
                                      %mn 0
                              %mtd
                                %mi C
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mrow
                                    %msub
                                      %mi d
                                      %mn 1
                            %mtr
                              %mtd
                                %mi B
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mi t
                                    %mo ∈
                                    %mi W
                              %mtd
                                %mi C
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        D := B \times_C C^I \times_C B
                        \&amp;\to&amp;&amp;\stackrel{\in W}{\to}&amp; B
                        \\\
                        \\downarrow^{\mathrlap{\in W}} &amp;&amp;&amp;&amp;
                        \\downarrow^{\mathrlap{t \in W}}
                        \\\
                        \&amp;&amp; C^I &amp;\stackrel{d_0}{\to}&amp;
                        C
                        \\\
                        \\downarrow &amp;&amp; \downarrow^{d_1}
                        \\\
                        B &amp;\stackrel{t \in W}{\to}&amp; C
                        }
                        \\,,
                %p where the long morphisms are weak equivalences by the lemma on morphisms out of homotopy fiber products.
            %p Then consider the two universal morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi η
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                    %msub
                      %mo ×
                      %mi C
                    %msup
                      %mi C
                      %mi I
                    %msub
                      %mo ×
                      %mi C
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    (f,\eta,g) : A \to B \times_C C^I \times_C B
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Id
                    %mo ,
                    %mi σ
                    %mo ∘
                    %mi t
                    %mo ,
                    %mi Id
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi B
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi W
                    %mi B
                    %msub
                      %mo ×
                      %mi C
                    %msup
                      %mi C
                      %mi I
                    %msub
                      %mo ×
                      %mi C
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    (Id, \sigma \circ t, Id) :
                    B \stackrel{\in W}{\to} B \times_C C^I \times_C B
            %p into that. It follows by 2-out-of-3 that the latter is a weak equivalence. Factoring this using the factorization lemma produces hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi W
                    %mi D
                    %mo ′
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi W
                        %mo ∩
                        %mi F
                    %mi D
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    B \stackrel{\in W}{\to} D' \stackrel{\in W \cap F}{\to}
                    D
                    \\,.
            %p
              We know moreover that the product map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi F
                    %mi B
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} D \stackrel{\in F}{\to} B \times B
              is a fibration, as we can rewrite the homotopy limit as the pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi D
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi C
                              %mi I
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi F
                        %mtr
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi f
                                %mo ×
                                %mi g
                          %mtd
                            %mi C
                            %mo ×
                            %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D &amp;\to&amp; C^I
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\in F}}
                    \\\
                    B \times B &amp;\stackrel{f \times g}{\to}&amp;
                    C \times C
                    }
                    \\,.
            %p
              It follows that the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ′
                    %mo →
                    %mi D
                    %mo →
                    %mi B
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} D' \to D \to B \times B
              is a fibration and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} D'
              a path space object for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              Finally, by setting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ′
                    %mo =
                    %mi A
                    %msub
                      %mo ×
                      %mi D
                    %mi D
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} A' = A \times_D D'
              we obtaine the desired right homotopy
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %mi t
                      %mo ′
                      %mo ≃
                      %mi g
                      %mo ∘
                      %mi t
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} f \circ t' \simeq g \circ t'
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ′
                          %mtd
                            %mo →
                          %mtd
                            %mi D
                            %mo ′
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi t
                                  %mo ′
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mi D
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi C
                              %mi I
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mi f
                                %mo ×
                                %mi g
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi t
                                %mo ×
                                %mi t
                          %mtd
                            %mi C
                            %mo ×
                            %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A' &amp;\to&amp; D'
                    \\\
                    \\downarrow^{\mathrlap{t'}} &amp;&amp; \downarrow
                    \\\
                    A &amp;\to &amp; D &amp;\to &amp; C^I
                    \\\
                    \&amp; {}_{f \times g}\searrow &amp; \downarrow
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; B \times B
                    \&amp;\stackrel{t \times t}{\to}&amp;
                    C \times C
                    }
                    \\,.
          .num_lemma
            %h6#lemma_14 Lemma
            %p
              The relation “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo ∈
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f, g \in C(A,B)
              are homotopic”,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∼
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f \sim g
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(A,B)
          .proof
            %h6#proof_15 Proof
            %p The nontrivial part is to show transitivity. This now follows with the above lemma about homtopy commutative composition of pullback diagrams and then using the “piecing together of path objects” used above to show that right homotopy is an equivalence relation.
          .num_defn
            %h6#definition_7 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a category of fibrant objects the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \pi C
              is defined to be the category
            %ul
              %li
                %p
                  with the same objects as
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
              %li
                %p
                  with
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} /
                          %mo ∼
                      %annotation{:encoding => "application/x-tex"}
                        \\pi C(A,B) := C(A,B)/_\sim
                %p under the above equivalence relation.
              %li
                %p
                  Composition in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                        %mi C
                      %annotation{:encoding => "application/x-tex"} \pi C
                  is given by composition of representatives in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
          .num_defn
            %h6#definition_8 Definition
            %p The obvious functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi π
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    C \to \pi C
            %p
              is the identity on objects and the projection to
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence classes
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mi W
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi W \subset Mor(\pi C)
              be the image of the weak equivalences of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \pi C
              under this functor, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \pi F
              the image of the fibrations.
          .num_theorem
            %h6#theorem Theorem
            %p
              The weak equivalences in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \pi C
              form a left multiplicative system.
          .proof
            %h6#proof_16 Proof
            %p This is now a direct consequence of the above lemma on homotopy-commutative completions of diagrams.
          %h3#HomotopyCategory The homotopy category
          %p
            We discuss now that the structure of a category of fibrant objects on a
            %a.existingWikiWord{:href => "/nlab/show/homotopical+category"} homotopical category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            induces
          %ul
            %li
              %p
                a related category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \pi C
            %li
              %p
                with a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %mi π
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C \to \pi C
              %ul
                %li
                  %p that is the identity on objects,
                %li
                  %p
                    and induces on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi π
                          %mi C
                        %annotation{:encoding => "application/x-tex"} \pi C
                    a notion of weak equivalences
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi π
                          %mi W
                          %mo ⊂
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi π
                          %mi C
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          \\pi W \subset Mor(\pi C)
                  %p and fibrations
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi π
                          %mi F
                          %mo ⊂
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi π
                          %mi C
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          \\pi F \subset Mor(\pi C)
            %li
              %p such that
              %ul
                %li
                  the weak equivalences in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                        %mi C
                      %annotation{:encoding => "application/x-tex"} \pi C
                  form a
                  %a.existingWikiWord{:href => "/nlab/show/calculus+of+fractions"} left multiplicative system
                  \.
          %p
            This implies the following convenient construction of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a category of fibrant objects, its
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              is (
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to) the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ho
                      %mi C
                  %annotation{:encoding => "application/x-tex"} Ho_C
              with
            %ul
              %li
                %p
                  the same objects as
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Ho
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ho_C(A,B)
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A, B \in Obj(C)
                  given naturally by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %msub
                                  %mi Ho
                                  %mi C
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mo ,
                                %mi B
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo ≃
                                %msub
                                  %mi colim
                                  %mrow
                                    %mover
                                      %mi A
                                      %mo{:stretchy => "false"} ^
                                    %mover
                                      %mo →
                                      %mrow
                                        %mi w
                                        %mo ∈
                                        %mi π
                                        %mi W
                                    %mi A
                                %mi π
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi A
                                  %mo{:stretchy => "false"} ^
                                %mo ,
                                %mi B
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %mo =
                                %msub
                                  %mi colim
                                  %mrow
                                    %mover
                                      %mi A
                                      %mo{:stretchy => "false"} ^
                                    %mover
                                      %mo →
                                      %mrow
                                        %mi f
                                        %mo ∈
                                        %mi π
                                        %mi W
                                        %mo ∩
                                        %mi F
                                    %mi A
                                %mi π
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi A
                                  %mo{:stretchy => "false"} ^
                                %mo ,
                                %mi B
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        Ho_C(A,B)
                        \&amp; \simeq
                        colim_{\hat A \stackrel{w\in \pi W}{\to} A}
                        \\pi C (\hat A,B)
                        \\\
                        \&amp; =
                        colim_{\hat A \stackrel{f\in \pi W\cap F}{\to} A}
                        \\pi C (\hat A,B)
                        \\end{aligned}
                        \\,.
          %p
            Here the colimit is, as described at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/calculus+of+fractions"} multiplicative system
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %msub
                    %mi W
                    %mi A
                %annotation{:encoding => "application/x-tex"} \pi W_A
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi π
                  %mi F
                  %mo ∩
                  %mi π
                  %mi W
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi A
                %annotation{:encoding => "application/x-tex"} (\pi F\cap \pi W)_A
            whose objects are weak equivalences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ^
                  %mover
                    %mo →
                    %mrow
                      %mi w
                      %mo ∈
                      %mi π
                      %mi W
                  %mi A
                %annotation{:encoding => "application/x-tex"} \hat A \stackrel{w \in \pi W}{\to} A
            or acyclic fibrations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ^
                  %mover
                    %mo →
                    %mrow
                      %mi f
                      %mo ∈
                      %mi π
                      %mi W
                      %mo ∩
                      %mi F
                  %mi A
                %annotation{:encoding => "application/x-tex"} \hat A \stackrel{f \in \pi W\cap F}{\to} A
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \pi C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi A
                            %mo{:stretchy => "false"} ^
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mi h
                        %mtd
                        %mtd
                          %mover
                            %mi A
                            %mo{:stretchy => "false"} ^
                          %mo ′
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\hat A &amp;&amp;\stackrel{h}{\to}&amp;&amp; \hat A'
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp;
                  A
                  }
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mi C
                %annotation{:encoding => "application/x-tex"} \pi C
            (i.e. for arbitrary
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
          %p So more in detail the above colimit is over the functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi A
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi π
                  %msub
                    %mi W
                    %mi A
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi π
                  %mi C
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mover
                    %mo →
                    %mrow
                      %mi π
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mi Set
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\pi C(-, B)_A :
                  (\pi W_A)^{op} \to (\pi C)^{op}
                  \\stackrel{\pi C(-, B)}{\to}
                  Set
                  \\,,
          %p where the first functor is the obvious forgetful functor.
          .num_remark
            %h6#remark_4 Remark
            %p
              It is again the factorization lemma above (and using 2-out-of-3 that implies that inverting just the acyclic fibrations in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is already equivalent to inverting all weak equivalences. This means that the above theorem remains valid if the weak equivalences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo :
                    %mi A
                    %mo ′
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} t : A' \to A
              are replaced by
              = succeed ":" do
                %em acyclic fibrations
            %p
              every cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mo ≃
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y &amp;\stackrel{g}{\to}&amp; A
                    \\\
                    {}^\simeq \downarrow^{\mathrlap{f}}
                    \\\
                    X
                    }
            %p out of a weak equivalence is refines by a cocycle out of an acyclic fibrantion, namely
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi E
                              %mi f
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mo ∈
                                %mi F
                                %mo ∩
                                %mi W
                            %mo ↘
                          %mtd
                            %msup
                              %mrow
                              %mo ≃
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{E}_f X &amp;\stackrel{\simeq}{\to}&amp;
                    Y &amp;\stackrel{g}{\to}&amp; A
                    \\\
                    \&amp;{}_{\in F \cap W}\searrow&amp; {}^\simeq \downarrow^{\mathrlap{f}}
                    \\\
                    \&amp;&amp; X
                    }
                    \\,.
            %p
              Using acyclic fibrations has the advantage that these are preserved under
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
            %p
              A discussion of this point of using weak equivalences versus acyclic fibrations in the construction of the homotopy category is also in Jardine:
              = succeed "." do
                %a{:href => "http://www.math.uiuc.edu/K-theory/0782/"} Cocycle categories
          %p We now provide the missing definitions and then the proof of this theorem.
          .num_lemma
            %h6#lemma_15 Lemma
            %p
              The homotopy categories of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \pi C
              coincide:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ho
                      %mi C
                    %mo ≃
                    %msub
                      %mi Ho
                      %mrow
                        %mi π
                        %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ho_C \simeq Ho_{\pi C}
                    \\,.
          .proof
            %h6#proof_17 Proof
            %p
              By one of the lemmas above, the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                    %mo :
                    %msup
                      %mi B
                      %mi I
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} d_i : B^I \to B
              are weak equivalences and become
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ho
                        %mi C
                    %annotation{:encoding => "application/x-tex"} Ho_C
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %mi B
                    %mo →
                    %msup
                      %mi B
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \sigma : B \to B^I
              then becomes an
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              for both of them, hence the images of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} d_0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} d_1
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ho
                      %mi C
                  %annotation{:encoding => "application/x-tex"} Ho_C
              coincide. Therefore the above diagram says that homotopic morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              become equal in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ho
                        %mi C
                    %annotation{:encoding => "application/x-tex"} Ho_C
            %p But this means that the localization morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mi C
                    %mo :
                    %mi C
                    %mo →
                    %msub
                      %mi Ho
                      %mi C
                  %annotation{:encoding => "application/x-tex"}
                    Q_C : C \to Ho_C
            %p
              factors through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \pi C
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mi C
                    %mo :
                    %mi C
                    %mo →
                    %mi π
                    %mi C
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi Q
                          %mrow
                            %mi π
                            %mi C
                    %msub
                      %mi Ho
                      %mi C
                  %annotation{:encoding => "application/x-tex"}
                    Q_C : C \to \pi C \stackrel{Q_{\pi C}}{\to} Ho_C
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mrow
                        %mi π
                        %mi C
                  %annotation{:encoding => "application/x-tex"} Q_{\pi C}
              sends weak equivalences in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \pi C
              to isomorphisms in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ho
                        %mi C
                    %annotation{:encoding => "application/x-tex"} Ho_C
            %p
              The universal property of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              then implies the universal property for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mrow
                        %mi π
                        %mi C
                  %annotation{:encoding => "application/x-tex"} Q_{\pi C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mo →
                          %mtd
                            %mi π
                            %mi C
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi Q
                                    %mi C
                          %mtd
                            %msup
                              %mo ↙
                              %mrow
                                %msub
                                  %mi Q
                                  %mrow
                                    %mi π
                                    %mi C
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                            %msub
                              %mi Ho
                              %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C &amp;\to&amp; \pi C &amp;\to &amp; A
                    \\\
                    \\downarrow^{\mathrlap{Q_C}} &amp; \swarrow^{Q_{\pi C}} &amp;&amp; \swarrow
                    \\\
                    Ho_C
                    }
                    \\,.
          %p
            The above theorem on the description of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ho
                    %mi C
                %annotation{:encoding => "application/x-tex"} Ho_C
            now follows from the general formula for
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            at a
            %a.existingWikiWord{:href => "/nlab/show/calculus+of+fractions"} left multiplicative system
            of weak equivalences.
          %h3#pointed_category_of_fibrant_objects Pointed category of fibrant objects
          %p
            If the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            of fibrant objects has an initial object which
            %em coincides
            with the terminal object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pointed+category"} pointed category
          %h3#fibers Fibers
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} p : Y \to X
            a fibration, the pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi F
                        %mtd
                          %mover
                            %mo →
                            %mi i
                        %mtd
                          %mi Y
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi e
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  F &amp;\stackrel{i}{\to}&amp; Y
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  e &amp;\to&amp; X
                  }
          %p
            is the
            %strong fibre
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is the
            = succeed "." do
              %em fibre inclusion
            %em kernel
            of the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            of
            = succeed "s)" do
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
          %h3#fibration_sequences Fibration Sequences
          %p
            (See also
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/fibration+sequence"} fibration sequence
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            any object and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mi I
                %annotation{:encoding => "application/x-tex"} B^I
            any of its
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mi I
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi d
                        %mn 0
                      %mo ×
                      %msub
                        %mi d
                        %mn 1
                  %mi B
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} B^I \stackrel{d_0 \times d_1}{\to} B \times B
            is the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Omega^{(I)} B
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            with respect to the chosen path object. This construction becomes independent up to canonical isomorphism of the chosen path space after mapping to the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            and hence there is a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo :
                  %msub
                    %mi Ho
                    %mi C
                  %mo →
                  %msub
                    %mi Ho
                    %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\Omega : Ho_C \to Ho_C
          %p
            which sends any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to its canonical loop object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \Omega B
          %p
            Any loop object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Omega B
            becomes a group object in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ho
                      %mi C
                  %annotation{:encoding => "application/x-tex"} Ho_C
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ho
                    %mi C
                %annotation{:encoding => "application/x-tex"} Ho_C
            in a natural way.
          %h3#DerivedHomSpaces Derived hom-spaces
          %p
            There is an explicit simplicial construction of the
            %a.existingWikiWord{:href => "/nlab/show/derived+hom+spaces"} derived hom spaces
            for a homotopical category that is equipped with the structure of a category of fibrant objects. This is described in (
            %a{:href => "#Cisinski10"}> Cisinksi 10
            ) and (
            %a{:href => "#NSS12"}> Nikolaus-Schreiber-Stevenson 12, section 3.6.2
            ).
          #CocycleCategories.num_defn
            %h6#definition_9 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a category of fibrant objects, write for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi A
                    %mo ∈
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X, A \in Obj(\mathcal{C})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cocycle
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi wCocycle
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    Cocycle(X,A) , wCocycle(X,A) \in Cat
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              (“categories of
              %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              = succeed "\u201D)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are
              %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟵
                      %mo ≃
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo ⟶
                      %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    X \stackrel{\simeq}{\longleftarrow}
                    \\hat X
                    \\stackrel{}{\longrightarrow}
                    A
            %p
              with the left leg an acyclic fibration (for
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cocycle
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cocycle(X,A)
              = succeed ");" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi wCocycle
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} wCocycle(X,A)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ↖
                          %mtd
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ^
                            %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \hat X
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    X &amp;&amp; \downarrow &amp;&amp; A
                    \\\
                    \&amp; \nwarrow &amp;&amp; \nearrow
                    \\\
                    \&amp;&amp; \hat X'
                    }
          #CocycleCategoriesPresentDerivedHomSpaces.num_prop
            %h6#proposition_3 Proposition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi L
                      %mi we
                      %mi H
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} L^H_{we} \mathcal{C}
              for the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
              of the category of fibrant objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              at its weak equivalences (hence essentially the
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (infinity,1)-category
              that it presents). Then for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi A
                    %mo ∈
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X,A \in Obj(\mathcal{C})
              the canonical maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mi Cocycle
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi N
                    %mi wCocycle
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi L
                      %mi we
                      %mi H
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    N Cocycle(X,A)
                    \\to
                    N wCocycle(X,A)
                    \\to
                    L^H_{we} \mathcal{C}(X,A)
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              (on the left the
              %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
              of the cocycle categories of def.
              = succeed "," do
                %a.maruku-ref{:href => "#CocycleCategories"}
              %a.existingWikiWord{:href => "/nlab/show/derived+hom+space"} derived hom space
              given by the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
          %p
            In other words,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mi Cocycle
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ≃
                    %mi whe
                  %mi N
                  %mi wCocycle
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N Cocycle(X,A) \simeq_{whe} N wCocycle(X,A)
            is a model for the correct
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/derived+hom+space"} derived hom space
          %p From this it follows for instance that
          #PullbacksAlongFibrationsAreCorrectHomotopyPullbacks.num_prop
            %h6#proposition_4 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+products"} homotopy fiber products
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              as defined in def.
              %a.maruku-ref{:href => "#HomotopyFiberProducts"}
              present indeed the correct
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-limits"} (infinity,1)-limits
          .proof
            %h6#proof_18 Proof
            %p
              Observe that for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              the 2-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mi Cocycle
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} N Cocycle(X,-) \colon \mathcal{C} \to sSet
              of def.
              %a.maruku-ref{:href => "#CocycleCategories"}
              sends fibrations to
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibrations"} Kan fibrations
              of simplicial sets (the
              = succeed "-filling" do
                %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mi Cocycle
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N Cocycle(X,-)
              preserves ordinary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mi Cocycle
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N Cocycle(X,-)
              takes pullbacks along a fibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              to pullbacks in
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              one of whose maps is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+proper+model+category"} right proper model category
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
              (as discussed there) in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              %a.maruku-ref{:href => "#CocycleCategoriesPresentDerivedHomSpaces"}
              this means that the
              %a.existingWikiWord{:href => "/nlab/show/derived+hom-space"} derived hom-space
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}Hom(X,-)
              sends pullbacks along fibrations to
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
              of the correct derived hom-spaces. This means (as discussed for instance at
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+Kan+extension"} homotopy Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              are the correct homotopy pullbacks.
          %h2#application_in_cohomology_theory Application in cohomology theory
          %p
            When the catgegory of fibrant objects is that of locally Kan simplicial sheaves, the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            compute generalized notions of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
          %p
            At
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
            is a detailed discussion of how the ordinary notion of sheaf cohomology arises as a special case of that.
          %h2#related_concept Related concept
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/category+of+cofibrant+objects"} category of cofibrant objects
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Waldhausen+category"} Waldhausen category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
          %h2#references References
          %p
            The notion of
            %em category of fibrant objects
            was introduced and the above results obtained in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Kenneth+Brown"}> Kenneth Brown
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/files/BrownAbstractHomotopyTheory.pdf", :title => "Abstract Homotopy Theory and Generalized Sheaf Cohomology"} Abstract Homotopy Theory and Generalized Sheaf Cohomology
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/BrownAHT"} BrownAHT
          %p
            for application to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopical+cohomology+theory"} homotopical cohomology theory
          %p
            A review is in
            %a{:href => "http://www.maths.abdn.ac.uk/~bensondj/papers/g/goerss-jardine/ch-1.dvi"} section I.9
            of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"} Paul Goerss
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Rick+Jardine"} Rick Jardine
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Simplicial+homotopy+theory"} Simplicial homotopy theory
              = succeed ")" do
                %a{:href => "http://www.maths.abdn.ac.uk/~bensondj/html/archive/goerss-jardine.html"} ps
          %p There is a description and discussion of this theory and its dual (using cofibrant objects) in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/K.+H.+Kamps"} K. H. Kamps
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"} Tim Porter
              %em Abstract Homotopy and Simple Homotopy Theory
              (
              %a{:href => "http://books.google.de/books?id=7JYKxInRMdAC&dq=Porter+Kamps&printsec=frontcover&source=bl&ots=uuyl_tIjs4&sig=Lt8I92xQBZ4DNKVXD0x76WkcxCE&hl=de&sa=X&oi=book_result&resnum=3&ct=result#PPP1,M1"}> GoogleBooks
              )
          %p Discussion of embeddings of categories of fibrant objects into model categories is in
          %ul
            %li#Cisinski10
              %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
              ,
              %em Invariance de la K-Théorie
              %p
                par équivalences dérivées_ (
                %a{:href => "http://www.math.univ-toulouse.fr/~dcisinsk/eqderkth.pdf"}> pdf
                )
          %p
            Also discussion of the
            %a.existingWikiWord{:href => "/nlab/show/derived+hom+spaces"} derived hom spaces
            in categories of fibrant objects is in that article, as well as in section 6.3.2 of
          %ul
            %li#NSS12
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"}> Thomas Nikolaus
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Principal+%E2%88%9E-bundles+--+theory%2C+presentations+and+applications"} Principal ∞-bundles – Presentations
              (
              %a{:href => "http://arxiv.org/abs/1207.0249"}> arXiv:1207.0249
              )
          %p and also in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Geoffroy+Horel"}> Geoffroy Horel
              ,
              = succeed "," do
                %em Brown categories and bicategories
              %a{:href => "https://arxiv.org/abs/1506.02851"} arxiv
          %p
            Usage of categories of fibrant objects for the
            %a.existingWikiWord{:href => "/nlab/show/homotopical+structure+on+C%2A-algebras"} homotopical structure on C*-algebras
            is in :
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Otgonbayar+Uuye"}> Otgonbayar Uuye
              ,
              = succeed "," do
                %em
                  Homotopy theory for
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^\ast
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1011.2926"} arxiv:1011.2926
          %p
            Categories of fibrant objects form a convenient setting for the study of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li
              Jeremy Avigad, Chris Kapulkin, Peter LeFanu Lumsdaine,
              %em Homotopy limits in type theory
              %a{:href => "http://arxiv.org/abs/1304.0680"} 1304.0680
          %p
            It is shown in the following paper that categories of fibrant objects are themselves fibrant in the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+categories+with+weak+equivalences"} model structure on categories with weak equivalences
          %ul#Meier
            %li
              Lennart Meier,
              = succeed "," do
                %em Fibration Categories are Fibrant Relative Categories
              %a{:href => "https://arxiv.org/abs/1503.02036"} arxiv
        .revisedby
