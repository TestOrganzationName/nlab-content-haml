                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi Δ
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi colim
                              %mrow
                                %mi U
                                %mo ∋
                                %mi x
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi k
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi Δ
                              %mn 1
                            %mo ,
                            %msub
                              %mi colim
                              %mrow
                                %mi U
                                %mo ∋
                                %mi x
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi Δ
                              %mn 1
                            %mo ,
                            %msup
                              %mi x
                              %mo *
                            %mi A
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    x^* [\Delta^1,A] &amp;\simeq colim_{U \ni x} [\Delta^1,A(U)]
                    \\\
                    \&amp;\simeq colim_{U \ni x}
                    SSet(\Delta^1 \times \Delta^\bullet, A(U))
                    \\\
                    \&amp;\simeq
                    ([n] \mapsto colim_{U \ni x}
                    SSet(\Delta^1 \times \Delta^\n, A(U))
                    \\\
                    \&amp;
                    \\simeq  ([n] \mapsto colim_{U \ni x}
                    \\int_{[k] \in \Delta}
                    Set(\Delta([k],[1])\times\Delta([k],[n]), A(U)_k)
                    \\\
                    \&amp; \simeq
                    ([n] \mapsto
                    \\int_{[k \leq n+1] \in \Delta}(
                    colim_{U \ni x}
                    Set(\Delta([k],[1])\times\Delta([k],[n]), A(U)_k
                    )
                    \\\
                    \&amp;\simeq
                    ([n] \mapsto
                    \\int_{[k] \in \Delta|_{n+1}}(
                    Set(\Delta([k],[1])\times\Delta([k],[n]),
                    colim_{U \ni x} A(U)_k
                    )
                    \\\
                    \&amp;\simeq
                    ([n] \mapsto
                    \\int_{[k] \in \Delta|_{n+1}}(
                    Set(\Delta([k],[1])\times\Delta([k],[n]),
                    (colim_{U \ni x} A(U))_k
                    )
                    \\\
                    \&amp;\simeq
                    [\Delta^1, colim_{U \ni x} A(U)]
                    \\\
                    \&amp; \simeq
                    [\Delta^1, x^* A]
                    )
                    \\end{aligned}
            %p Where the
            %ul
              %li
                %p
                  first step is the general formula for the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
              %li
                %p
                  second step is the formula for the
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  in the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves"} closed monoidal structure on simplicial sets
              %li
                %p
                  third step is the fact that colimits of presheaves are computed objectwise (see examples at
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              %li
                %p
                  the fourth step is the definition of the
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
                  %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
                  by an
                  %a.existingWikiWord{:href => "/nlab/show/end"} end
              %li
                %p the fifth step uses that
                %ul
                  %li
                    %p
                      the end truncates to a finite limit with
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi k
                            %mo ≤
                            %mi n
                            %mo +
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} k \leq n+1
                      since
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi Δ
                              %mn 1
                            %mo ×
                            %msup
                              %mi Δ
                              %mi n
                          %annotation{:encoding => "application/x-tex"} \Delta^1 \times \Delta^n
                      is
                      = succeed "-" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} (n+1)
                      %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} skeletal
                  %li
                    %p
                      and that the colimit is over a
                      %a.existingWikiWord{:href => "/nlab/show/filtered+category"} filtered category
                  %li
                    %p
                      and that
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/limits+and+colimits+by+example"} filtered colimits commute with finite limits
              %li
                %p
                  the sixth step uses that the set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi Δ
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Delta([k],[1])\times \Delta([k],[n])
                  is finite, hence a
                  %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact object
                  so that the colimit can be taken into the hom;
              %li
                %p the seventh step uses again that colimits of presheaves are computed objectwise
              %li
                %p
                  the remaining steps then just rewind the first ones, only that now
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A(U)
                  has been replaced by
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi colim
                            %mrow
                              %mi U
                              %mo ∋
                              %mi x
                          %mi A
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} colim_{U \ni x} A(U)
            %p
              That the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A \to [\Delta^1,A]
              is a weak equivalence and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mn 0
                        %mo ×
                        %msub
                          %mi d
                          %mn 1
                    %mi A
                    %mo ×
                    %mi A
                  %annotation{:encoding => "application/x-tex"} [\Delta^1,A] \stackrel{d_0 \times d_1}{\to} A \times A
              is a fibration follows similarly by taking the
              %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
              colimit inside to reduce to the statement that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %mi A
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %msup
                      %mi x
                      %mo *
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} x^* A \to [\Delta^1,x^* A]
              is a weak equivalence and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %msup
                      %mi x
                      %mo *
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mn 0
                        %mo ×
                        %msub
                          %mi d
                          %mn 1
                    %msup
                      %mi x
                      %mo *
                    %mi A
                    %mo ×
                    %msup
                      %mi x
                      %mo *
                    %mi A
                  %annotation{:encoding => "application/x-tex"} [\Delta^1,x^* A] \stackrel{d_0 \times d_1}{\to} x^*A \times x^* A
              is a fibration, using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %msup
                      %mi x
                      %mo *
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Delta^1,x^*A]
              is a
              %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
              for the
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mo *
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x^* A
          %p
            The category of fibrant objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SSh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SSh(X)
            is in fact the motivating example in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/BrownAHT"} BrownAHT
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            in question coincides with that using the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/infinity-stack"} infinity-stack
          %h4#example Example
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a topogical
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            and recall that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B} G
            denotes the corresponding one-object
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            an open subset, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Set
                %annotation{:encoding => "application/x-tex"} C(U, G) \in Set
            be the set of continuous maps from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊂
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \subset X
            we may associuate the one-object groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ↦
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  U \mapsto \mathbf{B} C(U,G)
                  \\,.
          %p
            By postcomposition this with the
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            operation we obtain an assignment of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ↦
                  %mi N
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  U \mapsto N \mathbf{B} C(U,G)
                  \\,.
          %p
            In degree 0 this is the constant
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                  %mo :
                  %mi U
                  %mo ↦
                  %mo *
                %annotation{:encoding => "application/x-tex"}
                  (N \mathbf{B}(-,G))_0 : U \mapsto {*}
          %p
            while in degree 1 this is the
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            of
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 1
                  %mo :
                  %mi U
                  %mo ↦
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (N \mathbf{B}(-,G))_1 : U \mapsto C(U,G)
                  \\,.
          %p
            When the context is understood, we will just write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            again for this
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo :
                  %mo =
                  %mi N
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}G := N \mathbf{B} C(-,G)
                  \\,.
          %h3#slice_categories Slice categories
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            be a category of fibrant objects, with fibrations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ⊂
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F \subset Mor(\mathbf{C})
            and weak equivalences
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W \subset Mor(\mathbf{C})
          %p
            For any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mi B
                    %mi F
                %annotation{:encoding => "application/x-tex"} \mathbf{C}_B^F
            be the category of fibrations over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            (a full subcategory of the
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            = succeed "):" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} /
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}/B
          %ul
            %li
              %p
                objects are fibrations
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \to B
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                      %annotation{:encoding => "application/x-tex"} \mathbf{C}
            %li
              %p morphisms are commuting triangles
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                            %mtd
                              %mo →
                            %mtd
                            %mtd
                              %mi A
                              %mo ′
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mrow
                                  %mo ∈
                                  %mi F
                              %mo ↘
                            %mtd
                            %mtd
                              %msub
                                %mo ↙
                                %mrow
                                  %mo ∈
                                  %mi F
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi B
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;&amp;\to&amp;&amp; A'
                      \\\
                      \&amp; {}_{\in F}\searrow &amp;&amp; \swarrow_{\in F}
                      \\\
                      \&amp;&amp; B
                      }
              %p
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                      %annotation{:encoding => "application/x-tex"} \mathbf{C}
          %p
            There is an obvious
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mi B
                      %mi F
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}_B^F \to \mathbf{C}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mi B
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}_B^F
          .num_lemma
            %h6#lemma_2 Lemma
            %p
              With this structure,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mi B
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}_B^F
              becomes a category of fibrant objects.
          .proof
            %h6#proof_3 Proof
            %p
              Below is proven the
              %em
                %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              that holds in any category of fibrant objects. This implies in particular that every morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi Id
                                %mo ×
                                %mi Id
                          %mtd
                          %mtd
                            %mi A
                            %msub
                              %mo ×
                              %mi B
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mo ∈
                                %mi F
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mrow
                                %mo ∈
                                %mi F
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;&amp;\stackrel{Id \times Id}{\to}&amp;&amp; A \times_B A
                    \\\
                    \&amp; {}_{\in F}\searrow &amp;&amp; \swarrow_{\in F}
                    \\\
                    \&amp;&amp;
                    B
                    }
            %p may be factored as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo ∈
                                %mi W
                          %mtd
                            %msup
                              %mi A
                              %mi I
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo ∈
                                %mi F
                          %mtd
                            %mi A
                            %msub
                              %mo ×
                              %mi B
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                                %mo ∈
                                %mi F
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mrow
                                %mo ∈
                                %mi F
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\stackrel{\in W}{\to}&amp; A^I &amp;\stackrel{\in F}{\to}&amp;
                    A \times_B A
                    \\\
                    \&amp; {}_{\in F}\searrow &amp;&amp; \swarrow_{\in F}
                    \\\
                    \&amp;&amp;
                    B
                    }
                    \\,.
            %p
              This provides the
              %a.existingWikiWord{:href => "/nlab/show/path+object"} path space objects
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mi B
                        %mi F
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}^F_B
          %h2#properties Properties
          %h3#SimpleConsequences Simple consequences of the definition
          %p Before looking at more sophisticated constructions, we record the following direct consequences of the definition of a category of fibrant objects.
          .num_lemma
            %h6#lemma_3 Lemma
            %p
              For every two objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                      %mo ,
                      %msub
                        %mi A
                        %mn 2
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} A_1, A_2 \in \mathbf{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mo :
                    %msub
                      %mi A
                      %mn 1
                    %mo ×
                    %msub
                      %mi A
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi F
                    %msub
                      %mi A
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    p_i : A_1 \times A_2 \stackrel{\in F}{\to} A_i
            %p
              out of their
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              are fibrations.
          .proof
            %h6#proof_4 Proof
            %p
              Because by assumption both morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi i
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} A_i \to {*}
              are fibrations and fibrations are preserved under pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 1
                            %mo ×
                            %msub
                              %mi A
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi A
                              %mn 2
                        %mtr
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ⇒
                                  %mo ∈
                                  %mi F
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi F
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A_1 \times A_2 &amp;\to&amp; A_2
                    \\\
                    \\;{}^{p_1}\downarrow^{\mathrlap{\Rightarrow \in F}} &amp;&amp; \downarrow^{\mathrlap{\in F}}
                    \\\
                    A_1 &amp;\to&amp;  {*}
                    }
                    \\,.
          .num_lemma
            %h6#lemma_4 Lemma
            %p
              For every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} B \in \mathbf{C}
              and every
              %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi I
                  %annotation{:encoding => "application/x-tex"} B^I
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                    %mo :
                    %msup
                      %mi B
                      %mi I
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi W
                        %mo ∩
                        %mi F
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    d_i : B^I \stackrel{\in W \cap F}{\to} B
            %p
              (whose product
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 0
                      %mo ×
                      %msub
                        %mi d
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} d_0 \times d_1
          .proof
            %h6#proof_5 Proof
            %p
              By the above lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                    %mo :
                    %msup
                      %mi B
                      %mi I
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi d
                          %mn 0
                        %mo ×
                        %msub
                          %mi d
                          %mn 1
                    %mi B
                    %mo ×
                    %mi B
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mi i
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    d_i : B^I \stackrel{d_0 \times d_1}{\to} B \times B
                    \\stackrel{p_i}{\to} B
              is the composite of two fibrations and hence itself a fibration.
            %p Moreover, from the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %msup
                              %mi B
                              %mi I
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                                %mo ×
                                %msub
                                  %mi d
                                  %mn 1
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mrow
                                %msub
                                  %mi d
                                  %mi i
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi i
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mi Id
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    B
                    \&amp;\stackrel{\simeq}{\to}&amp;
                    B^I
                    \&amp;\stackrel{d_0 \times d_1}{\to}&amp;
                    B \times B
                    \\\
                    \&amp;&amp;&amp;\searrow^{d_i}&amp; \downarrow^{\mathrlap{p_i}}
                    \\\
                    \&amp; \searrow^{Id}&amp;&amp;&amp; B
                    }
            %p
              one reads off that the 2-out-of-3 property for weak equivalences implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                  %annotation{:encoding => "application/x-tex"} d_i
              is also a weak equivalence.
          %h3#generalized_universal_bundles_and_the_factorization_lemma Generalized universal bundles and the factorization lemma
          %p
            A central lemma in the theory of categories of fibrant objects is the following
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
          #FactorizationLemma.num_lemma
            %h6#lemma_factorization_lemma Lemma (factorization lemma)
            %p
              For every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f : C \to D
              in a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              of fibrant objects, there is an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi f
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}_f B
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              factors as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi E
                              %mi f
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mi σ
                                  %mi f
                                %mo ∈
                                %mi W
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mrow
                                %msub
                                  %mi p
                                  %mi f
                                %mo ∈
                                %mi F
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbf{E}_f B
                    \\\
                    \&amp; {}^{\sigma_f \in W}\nearrow &amp;&amp; \searrow^{p_f \in F}
                    \\\
                    C &amp;&amp;\stackrel{f}{\to}&amp;&amp; B
                    }
            %p with
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mi f
                      %annotation{:encoding => "application/x-tex"} p_f
                  a fibration
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mi f
                      %annotation{:encoding => "application/x-tex"} \sigma_f
                  a weak equivalence that is a
                  %a.existingWikiWord{:href => "/nlab/show/section"} section
                  ( a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/inverse"} right inverse
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Id
                          %mi C
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi σ
                              %mi f
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %mi f
                        %mi B
                        %mover
                          %mo →
                          %mo ≃
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Id_{C}
                        \=
                        (
                        C
                        \\stackrel{\sigma_f}{\to}
                        \\mathbf{E}_f B \stackrel{\simeq}{\to}
                        C
                        )
                        \\,.
          .num_remark
            %h6#remarks Remarks
            %p
              This is the analog of one of the
              %em factorization axioms
              in a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              which says that every map factors as an acyclic cofibration followed by a fibration.
            %p
              Notice that by
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} 2-out-of-3
              this in particular implies that every weak equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mover
                      %mo →
                      %mrow
                        %mo ∈
                        %mi W
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : C \stackrel{\in W}{\to} B
              is given by a span of acyclic fibrations.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi E
                              %mi f
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mi σ
                                  %mi f
                                %mo ∈
                                %mi W
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mrow
                                %msub
                                  %mi p
                                  %mi f
                                %mo ∈
                                %mi F
                                %mo ∩
                                %mi W
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi f
                                %mo ∈
                                %mi W
                          %mtd
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbf{E}_f B
                    \\\
                    \&amp; {}^{\sigma_f \in W}\nearrow &amp;&amp;
                    \\searrow^{p_f \in F\cap W}
                    \\\
                    C &amp;&amp;\stackrel{f \in W}{\to}&amp;&amp; B
                    }
                    \\,.
            %p
              In the context of
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              theory these are known as the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalence
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
          %p
            The way the proof of this lemma works, one sees that this really arises in the wider context of computing
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : C \to B
              a morphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi f
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi f
                    %mi B
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p_f : \mathbf{E}_f B \to B
              defined as the composite vertical morphism in the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi E
                              %mi f
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi B
                              %mi I
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mn 1
                        %mtr
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{E}_f B &amp;\stackrel{\simeq}{\to}&amp; C
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    B^I &amp;\stackrel{d_0}{\to}&amp; B
                    \\\
                    \\downarrow^{\mathrlap{d_1}}
                    \\\
                    B
                    }
            %p
              for some
              %a.existingWikiWord{:href => "/nlab/show/path+object"} path space object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi I
                  %annotation{:encoding => "application/x-tex"} B^I
              is the
              %a.existingWikiWord{:href => "/nlab/show/generalized+universal+bundle"} generalized universal bundle
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              relative to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          %p The universal bundle terminology is best understood from the following example
          .num_example
            %h6#example_2 Example
            %p
              Consider the category of fibrant objects given by
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/strict+omega-groupoid"} strict omega-groupoid
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              an ordinary
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} G
              for the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              as a constant
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              is often denoted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \bar W G
              (see
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} G
              also for this Kan complex, for simplicity.
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              (or its corresponding Kan complex)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi I
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi G
                    %mo \
                    %mo \
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbf{B} G)^I
                    \=
                    [\Delta^1, \mathbf{B} G ]
                    \=
                    G \backslash \backslash G//G
            %p
              where the right denotes the
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ×
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G \times G
              acting on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              by left and right multiplication.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo :
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} {*} : {*} \to \mathbf{B} G
              be the unique morphism from the
              %a.existingWikiWord{:href => "/nlab/show/point"} point
              into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mo *
                    %mi G
                    %mo =
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{E}_{*} G = G//G
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              acting on itself from just the right. (The corresponding
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              is traditionally denoted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G
              when thought of as a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G//G \to \mathbf{B}G
              is indeed the universal
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              (under the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} Quillen equivalence of
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed "s)" do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/generalized+universal+bundle"} generalized universal bundle
          .num_lemma
            %h6#lemma_5 Lemma
            %p
              The morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi f
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi f
                    %mi B
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p_f : \mathbf{E}_f B \to B
              is a fibration.
          .proof
            %h6#proof_6 Proof
            %p
              The defining
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagram for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi f
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}_f B
              can be refined to a double pullback diagram as follows
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi E
                              %mi f
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo ∈
                                %mi F
                          %mtd
                            %mi C
                            %mo ×
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi f
                                  %mo ×
                                  %mi Id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi B
                              %mi I
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi d
                                  %mn 0
                                %mo ×
                                %msub
                                  %mi d
                                  %mn 1
                                %mo ∈
                                %mi F
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mn 1
                          %mtd
                            %msub
                              %mo ↙
                              %mrow
                                %msub
                                  %mi p
                                  %mn 2
                                %mo ∈
                                %mi F
                        %mtr
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{E}_f B
                    \&amp;\stackrel{\in F}{\to}&amp;
                    C \times B
                    \&amp;\stackrel{p_1}{\to}&amp;
                    C
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{f \times Id}} &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    B^I &amp;\stackrel{d_0 \times d_1 \in F}{\to}&amp;
                    B \times B &amp;\stackrel{p_1}{\to}&amp;
                    B
                    \\\
                    \\downarrow^{\mathrlap{d_1}} &amp; \swarrow_{p_2 \in F}
                    \\\
                    B
                    }
                    \\,.
            %p
              Both squares are pullback squares. Since pullbacks of fibrations are fibrations, the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi f
                    %mi B
                    %mo →
                    %mi C
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}_f B  \to C \times B
              is a fibration.
            %p
              By one of the lemmas above, also the projection map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mo :
                    %mi B
                    %mo ×
                    %mi B
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p_i : B \times B \to B
              is a fibration.
            %p
              The above diagram exibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi f
                  %annotation{:encoding => "application/x-tex"} p_f
              as the the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi p
                              %mi f
                          %mtd
                            %mo :
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi E
                              %mi f
                            %mi B
                            %mo →
                            %mi C
                            %mo ×
                            %mi B
                            %mover
                              %mo →
                              %mrow
                                %mi f
                                %mo ×
                                %mi Id
                            %mi B
                            %mo ×
                            %mi B
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mn 2
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi E
                              %mi f
                            %mi B
                            %mo →
                            %mi C
                            %mo ×
                            %mi B
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mn 2
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p_f &amp;: \mathbf{E}_f B \to C \times B
                    \\stackrel{f \times Id}{\to}
                    B \times B
                    \\stackrel{p_2}{\to}
                    B
                    \\\
                    \&amp; =
                    \\mathbf{E}_f B \to C \times B
                    \\stackrel{p_2}{\to}
                    B
                    \\end{aligned}
            %p of two fibrations. Therefore it is itself a fibration.
          .num_lemma
            %h6#lemma_6 Lemma
            %p
              The morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi f
                    %mi B
                    %mover
                      %mo →
                      %mo ≃
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}_f B \stackrel{\simeq}{\to} C
              has a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              (a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/inverse"} right inverse
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi f
                    %mo :
                    %mi C
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi f
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_f : C \stackrel{\simeq}{\to}
                    \\mathbf{E}_f B
              and its composite with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi f
                  %annotation{:encoding => "application/x-tex"} p_f
              is
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi E
                              %mi f
                            %mi B
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msub
                                  %mi σ
                                  %mi f
                          %mtd
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi f
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mi f
                        %mtr
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{E}_f B &amp;\stackrel{\sigma_f}{\leftarrow}&amp;&amp;
                    C
                    \\\
                    \\downarrow^{\mathrlap{p_f}} &amp;&amp; \swarrow_{f}
                    \\\
                    B
                    }
          .proof
            %h6#proof_7 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/section"} section
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi f
                    %mo =
                    %mi Id
                    %mo ×
                    %mi σ
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_f = Id \times \sigma \circ f
            %p
              is the morphism induced via the universal property of the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              by the
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %mi B
                    %mo →
                    %msup
                      %mi B
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \sigma : B  \to B^I
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 0
                      %mo :
                      %msup
                        %mi B
                        %mi I
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} d_0 : B^I \to B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi σ
                                  %mi f
                                %mo ∈
                                %mi W
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi E
                              %mi f
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo ∈
                                %mi W
                                %mo ∩
                                %mi F
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
