                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              of the Hopf construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi f
                  %annotation{:encoding => "application/x-tex"} H_f
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed "," do
                %a.maruku-ref{:href => "#HopfConstruction"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi f
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi α
                    %mi β
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    h(H_f) = \alpha \beta
                    \\,.
          %p
            (
            %a{:href => "#MosherTangora"}> Mosher-Tangora, exercises to section 4, page 38
            )
          %h3#RealizationAsAQuasiFibration Realization as a quasi-fibration
          %p
            Beware that
            %a{:href => "#Stasheff70"} Stasheff 70, theorem 1.2
            claims that Sugawara claimed that the Hopf construction for any
            %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW
            H-space is necessarily a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasifibration"} quasifibration
            = succeed ")" do
              %a{:href => "https://nforum.ncatlab.org/discussion/3391/hopf-fibration/?Focus=75986#Comment_75986"} here
            = succeed ")" do
              %a{:href => "https://nforum.ncatlab.org/discussion/3391/hopf-fibration/?Focus=75985#Comment_75985"} here
          %p
            A different but homotopy-equivalent realization of the Hopf construction, which over grouplike H-spaces is guaranteed to be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasifibration"} quasifibration
            = succeed "," do
              %a{:href => "#DoldLashof59"} Dold-Lashof 59
            = succeed "." do
              %a{:href => "#Stasheff70"} Stasheff 70, theorem 1.4
          %h2#examples Examples
          %h3#HopfFibrations Hopf fibrations
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
            that is an
            = succeed "-space," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 0
                  %mo =
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} S^0 = \mathbb{Z}/2
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+of+order+2"} group of order 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                  %mo =
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S^1 = U(1)
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
            %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 3
                    %mo =
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^3 = SU(2)
            %a.existingWikiWord{:href => "/nlab/show/7-sphere"} 7-sphere
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 7
                %annotation{:encoding => "application/x-tex"} S^7
            with its
            %a.existingWikiWord{:href => "/nlab/show/Moufang+loop"} Moufang loop
            structure, then the Hopf construction produces the four
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hopf+fibrations"} Hopf fibrations
          %ol
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 0
                    %mo ↪
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^0 \hookrightarrow S^1 \to S^1
              –
              %a.existingWikiWord{:href => "/nlab/show/real+Hopf+fibration"} real Hopf fibration
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ↪
                    %msup
                      %mi S
                      %mn 3
                    %mo →
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^1 \hookrightarrow S^3 \to S^2
              –
              %a.existingWikiWord{:href => "/nlab/show/complex+Hopf+fibration"} complex Hopf fibration
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 3
                    %mo ↪
                    %msup
                      %mi S
                      %mn 7
                    %mo →
                    %msup
                      %mi S
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} S^3 \hookrightarrow S^7 \to S^4
              –
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+Hopf+fibration"} quaternionic Hopf fibration
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 7
                    %mo ↪
                    %msup
                      %mi S
                      %mn 15
                    %mo →
                    %msup
                      %mi S
                      %mn 8
                  %annotation{:encoding => "application/x-tex"} S^7 \hookrightarrow S^{15} \to S^8
              –
              %a.existingWikiWord{:href => "/nlab/show/octonionic+Hopf+fibration"} octonionic Hopf fibration
          %p
            In detail, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mi ℝ
                  %mo ,
                  %mi ℂ
                  %mo ,
                  %mi ℍ
                  %mo ,
                  %mi 𝕆
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} A \in \{\mathbb{R}, \mathbb{C}, \mathbb{H}, \mathbb{O}\}
            be one of the real
            %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            and write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≔
                  %msub
                    %mi dim
                    %mi ℝ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 4
                  %mo ,
                  %mn 8
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  n \coloneqq dim_{\mathbb{R}}(A) \in \{1,2,4,8\}
          %p
            for its
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            as a real vector space. Then the
            = succeed "-sphere" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{n-1}
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo ≃
                  %mrow
                    %mo {
                    %mi x
                    %mo ∈
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ;
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi x
                        %mo{:stretchy => "false"} |
                      %mn 2
                    %mo =
                    %mn 1
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  S^{n-1} \simeq
                  \\left\{
                  x \in A
                  \\,;
                  {\vert x\vert}^2 = 1
                  \\right\}
                  \\,.
          %p Consider then the pairing map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo ×
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo ⟶
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  f \colon S^{n-1}\times S^{n-1} \longrightarrow S^{n-1}
          %p
            which is the restriction to these unit norm elements of the product in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi x
                  %mo ⋅
                  %mi y
                %annotation{:encoding => "application/x-tex"}
                  f \colon (x,y) \mapsto x \cdot y
          %p
            This is well defined by the very property that for
            %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            the norm is multiplicative.
          %p
            Accordingly, the
            %a.existingWikiWord{:href => "/nlab/show/join+of+topological+spaces"} join
            of two such spheres is naturally parameterized as follows
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo *
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo ×
                  %mi I
                  %mo ×
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mo ∼
                  %mo ≃
                  %mrow
                    %mo {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi t
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi x
                        %mo{:stretchy => "false"} |
                      %mn 2
                    %mo =
                    %mn 2
                    %mi t
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi y
                        %mo{:stretchy => "false"} |
                      %mn 2
                    %mo =
                    %mn 2
                    %mo −
                    %mn 2
                    %mi t
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  S^{n-1}\ast S^{n-1}
                  \=
                  (S^{n-1}\times I \times S^{n-1})_{/\sim}
                  \\simeq
                  \\left\{
                  (x,t,y)
                  \\,,
                  {\vert x \vert}^2 = 2t
                  \\,,\;
                  {\vert y\vert}^2 = 2 - 2t
                  \\right\}
          %p which makes manifest that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo *
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo ≃
                  %msup
                    %mi S
                    %mrow
                      %mn 2
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  S^{n-1} \ast S^{n-1} \simeq S^{2n-1}
          %p
            Similarly, the
            %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
            is parameterized by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo ×
                  %mi I
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mo ∼
                  %mo ≃
                  %mrow
                    %mo {
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi z
                        %mo{:stretchy => "false"} |
                      %mn 2
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mn 2
                    %mi t
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo =
                    %mn 1
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\Sigma S^{n-1}
                  \=
                  (S^{n-1}\times I)_{/\sim}
                  \\simeq
                  \\left\{
                  (z,t)
                  \\,,\;
                  {\vert z \vert}^2 + (1 - 2t)^2   = 1
                  \\right\}
          %p
            where we take
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} I = [0,1]
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} t \in I
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo ≃
                  %msup
                    %mi S
                    %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Sigma S^{n-1} \simeq S^n
                  \\,.
          %p
            Moreover, in this parameterization the Hopf construction, def.
            = succeed "," do
              %a.maruku-ref{:href => "#HopfConstruction"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi x
                  %mo ⋅
                  %mover
                    %mi y
                    %mo ¯
                %annotation{:encoding => "application/x-tex"}
                  (x,y) \mapsto x \cdot \overline{y}
          %p manifestly gives the Hopf fibration map.
          %p
            Notice that it is again the multiplicativity of the norm in division algebras which makes this work: if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} |
                    %mn 2
                  %mo =
                  %mn 2
                  %mi t
                %annotation{:encoding => "application/x-tex"} {\vert x \vert}^2 = 2t
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi y
                      %mo{:stretchy => "false"} |
                    %mn 2
                  %mo =
                  %mn 2
                  %mo −
                  %mn 2
                  %mi t
                %annotation{:encoding => "application/x-tex"} {\vert y\vert}^2 = 2 - 2t
            then it follows that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi x
                              %mo ⋅
                              %mover
                                %mi y
                                %mo ¯
                              %mo{:stretchy => "false"} |
                            %mn 2
                          %mo +
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo −
                          %mn 2
                          %mi t
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                        %mtd
                          %mo =
                          %msup
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi x
                              %mo{:stretchy => "false"} |
                            %mn 2
                          %msup
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi y
                              %mo{:stretchy => "false"} |
                            %mn 2
                          %mo +
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo −
                          %mn 2
                          %mi t
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mn 2
                          %mi t
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo −
                          %mn 2
                          %mi t
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo −
                          %mn 2
                          %mi t
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  {\vert x \cdot \overline{y}\vert}^2 + (1- 2t)^2
                  \&amp; =
                  {\vert x \vert}^2 {\vert y \vert}^2
                  + (1-2t)^2
                  \\\
                  \&amp; = 2t (2-2t) + (1 - 2t)^2
                  \\\
                  \&amp; = 1
                  \\end{aligned}
                  \\,,
          %p hence that indeed we have a well-defined map like so:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi S
                            %mn 7
                        %mtd
                          %mo ⟶
                        %mtd
                          %msup
                            %mi S
                            %mn 4
                      %mtr
                        %mtd
                          %mrow
                            %mo {
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi t
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                            %msup
                              %mrow
                                %mo{:stretchy => "false"} |
                                %mi x
                                %mo{:stretchy => "false"} |
                              %mn 2
                            %mo =
                            %mn 2
                            %mi t
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                            %mspace{:width => "thickmathspace"}
