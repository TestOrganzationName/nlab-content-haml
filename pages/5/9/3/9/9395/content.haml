                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ⟶
                    %msup
                      %mi S
