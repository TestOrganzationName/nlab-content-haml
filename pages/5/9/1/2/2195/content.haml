              = succeed "," do
                %a.maruku-ref{:href => "#CompactlySupportedDistributionFourierTransform"}
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
              on 1:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mi δ
                              %mo ^
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
                              %mrow
                                %mi x
                                %mo ∈
                                %msup
                                  %mi ℝ
                                  %mi n
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %mi k
                                %mi x
                            %mspace{:width => "thinmathspace"}
                            %mi d
                            %mi x
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\widehat {\delta}(k)
