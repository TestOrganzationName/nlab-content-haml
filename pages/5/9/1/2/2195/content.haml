                                %mi k
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn 2
                                %mi π
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\delta(x)
