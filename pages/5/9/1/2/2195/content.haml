                  %mi μ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi χ
                  %mo ∈
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\hat{f}(\chi) = \int_G f(x) \widebar{\chi(x)} d\mu(x),\,\,\,\chi\in\hat{G}.
          %p
            The Fourier transform of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
