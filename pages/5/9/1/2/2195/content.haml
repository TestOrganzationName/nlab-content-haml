                                %mi f
                                %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\widehat{u_f}(g)
                    \&amp; \coloneqq
                    u_f\left( \widehat{g}\right)
                    \\\
                    \&amp; =
                    \\underset{x \in \mathbb{R}^n}{\int} f(x) \hat g(x)\, d^n x
                    \\\
                    \&amp; =
                    \\underset{x \in \mathbb{R}^n}{\int} \hat f(x) g(x) \, d^n x
                    \\\
                    \&amp; =
                    u_{\hat f}(g)
                    \\end{aligned}
            %p
              Here all equalities hold by definition, except for the third: this is property
              %a.maruku-eqref{:href => "#eq:FourierTransformInIntegralOfProductMayBeShiftedToOtherFactor"} (4)
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#BasicPropertiesOfFourierTransformOverCartesianSpaces"}
