            )
          #FourierTransformOfDeltaDistribution.num_defn
            %h6#example_8 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/delta-distribution"} delta-distribution
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FourierTransformOnTemperedDistributions"}
              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              (def.
              = succeed ")," do
