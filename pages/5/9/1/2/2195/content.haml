                              %mi u
                              %mi f
                            %mrow
                              %mo (
                              %mover
                                %mi g
                                %mo ^
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
                              %mrow
                                %mi x
                                %mo ∈
                                %msup
                                  %mi ℝ
                                  %mi n
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mover
                              %mi g
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi d
                              %mi n
                            %mi x
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
                              %mrow
                                %mi x
                                %mo ∈
                                %msup
                                  %mi ℝ
                                  %mi n
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi d
                              %mi n
                            %mi x
                        %mtr
