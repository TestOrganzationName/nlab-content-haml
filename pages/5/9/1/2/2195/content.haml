                %annotation{:encoding => "application/x-tex"} f^\ast \in C^\infty(\mathbb{R}^n)
            for its pointwise
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugate"} complex conjugate
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
