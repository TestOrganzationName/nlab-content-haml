              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              itself has equivalently the following expression as a
              %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
