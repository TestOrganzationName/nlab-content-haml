                    %mi χ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn 1
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
