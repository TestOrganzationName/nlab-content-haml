                  f^\ast(x) \coloneqq (f(x))^\ast
                  \\,.
          %h4#on_functions_with_rapidly_decreasing_partial_derivatives On functions with rapidly decreasing partial derivatives
          #SchwartzSpace.num_defn
            %h6#definition Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Schwartz+space"} Schwartz space
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/functions+with+rapidly+decreasing+partial+derivatives"} functions with rapidly decreasing partial derivatives
            %p
              A
              = succeed "-valued" do
                %a.existingWikiWord{:href => "/nlab/show/complex+number"} complex
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R}^n)
              is said to have
              %em
                %a.existingWikiWord{:href => "/nlab/show/rapidly+decreasing+function"} rapidly decreasing
                %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ,
                    %mi β
                    %mo ∈
                    %msup
                      %mi ℕ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \alpha,\beta \in \mathbb{N}^{n}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi sup
                      %mrow
                        %mi x
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mi n
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msup
                        %mi x
                        %mi β
                      %msup
                        %mo ∂
                        %mi α
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo &lt;
                    %mspace{:width => "thickmathspace"}
                    %mn ∞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{x \in \mathbb{R}^n}{sup} {\vert  x^\beta \partial^\alpha f(x) \vert}
                    \\;\lt\; \infty
                    \\,.
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}(\mathbb{R}^n) \hookrightarrow C^\infty(\mathbb{R}^n)
            %p
              for the sub-
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              on the functions with rapidly decreasing partial derivatives regarded as a
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
              for the
              %a.existingWikiWord{:href => "/nlab/show/Frechet+space"} Frechet space
              struzcture induced by the
              %a.existingWikiWord{:href => "/nlab/show/seminorms"} seminorms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mi sup
                      %mrow
                        %mi x
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mi n
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msup
                        %mi x
                        %mi β
                      %msup
                        %mo ∂
                        %mi α
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p_{\alpha, \beta}(f) \coloneqq \underset{x \in \mathbb{R}^n}{sup} {\vert  x^\beta \partial^\alpha f(x) \vert}
                    \\,.
            %p
              This is also called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Schwartz+space"} Schwartz space
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Hoermander90"} Hörmander 90, def. 7.1.2
          #CompactlySupportedSmoothFunctionsAreFunctionsWithRapidlyDecreasingDerivatives.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+function"} compactly supported
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                are
                = succeed ")" do
