                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi γ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi β
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi f
                      %mi α
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
