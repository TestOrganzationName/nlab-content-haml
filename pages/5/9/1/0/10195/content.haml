                          %mi β
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \alpha \lt f_\beta(\alpha)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
                is the least ordinal less than
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo ≤
                        %msub
                          %mi f
                          %mi β
                        %mo{:stretchy => "false"} (
                        %mi γ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \alpha \leq f_\beta(\gamma)
          %p
            The resulting binary tree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                %annotation{:encoding => "application/x-tex"} \tau
            is finite for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo &lt;
                    %msub
                      %mi Γ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \alpha \lt \Gamma_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo &gt;
                  %msub
                    %mi α
                    %mn 1
                  %mo &gt;
                  %msub
                    %mi α
                    %mn 2
                  %mo &gt;
                  %mi …
                %annotation{:encoding => "application/x-tex"} \alpha \gt \alpha_1 \gt \alpha_2 \gt \ldots
            with no least element, contradicting well-orderedness).
          %p
            This finite binary tree notation is one of many possible ordinal notations for naming countable ordinals. It is more expressive the Cantor normal form that provides a notation for ordinals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            less than
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            uniquely in the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo =
                  %msup
                    %mi ω
                    %mi β
                  %mo +
                  %mi γ
                %annotation{:encoding => "application/x-tex"} \alpha = \omega^\beta + \gamma
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo ,
                  %mi γ
                  %mo &lt;
                  %mi α
                %annotation{:encoding => "application/x-tex"} \beta, \gamma \lt \alpha
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo &lt;
                    %mi γ
                    %mo +
                    %msup
                      %mi ω
                      %mi β
                  %annotation{:encoding => "application/x-tex"} \gamma \lt \gamma + \omega^\beta
          .num_remark
            %h6#remark Remark
            %p
              However, Cantor normal form has the virtue of uniqueness. For the binary operation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo ,
                      %mi γ
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %msub
                        %mi f
                        %mi β
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\beta, \gamma) \mapsto f_\beta(\gamma)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo ,
                      %mi γ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\beta, \gamma)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo ′
                    %mo ,
                    %mi γ
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\beta', \gamma')
              which are equivalent in the sense that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi β
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi f
                      %mrow
                        %mi β
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ;
                  %annotation{:encoding => "application/x-tex"} f_\beta(\gamma) = f_{\beta'}(\gamma');
            %p
              we counteracted this by using the pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo ,
                    %mi γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\beta, \gamma)
              which was least in its equivalence class with respect to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/lexicographic+order"} lexicographic order
          %h2#fundamental_sequences_and_the_bachmannhoward_ordinal Fundamental sequences and the Bachmann-Howard ordinal
          %h3#fastgrowing_functions_on_
            Fast-growing functions on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
          %h2#recursive_ordinals Recursive ordinals
          %p
            Of course, having reached
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \Gamma_0
            as the least fixed point of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %msub
                      %mi f
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \mapsto f_x(1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi f
                    %mi x
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g_0(x) = f_x(1)
            and defining
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mi α
                %annotation{:encoding => "application/x-tex"} g_\alpha
            analogously to how we defined
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi α
                  %annotation{:encoding => "application/x-tex"} f_\alpha
          %p In one or another way we can continue extending ordinal notation schemes, but all such schemes are recursive by definition, and at some point we cannot go any further:
          .num_defn
            %h6#definition_2 Definition
            %p
              A countable ordinal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              is
              %strong recursive
              if there is a computable relation on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
              (or a
              %a.existingWikiWord{:href => "/nlab/show/recursive+subset"} recursive subset
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                      %mo ×
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N} \times \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
          %p
            There are countably many computable relations on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \omega_1
            exists. It is called the
            = succeed "." do
              %strong Church-Kleene ordinal
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/uncountable+ordinal"} uncountable ordinal
            %li
              %a.existingWikiWord{:href => "/nlab/show/countable+set"} countable set
            %li
              %a.existingWikiWord{:href => "/nlab/show/ordinal+analysis"} ordinal analysis
          %h2#references References
          %p For a light-hearted introduction with many useful references, see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
              , Week 236, This Week’s Finds in Mathematical Physics, July 26, 2006. (
              %a{:href => "http://math.ucr.edu/home/baez/week236.html"}> web
              )
          %p A very readable account of countable ordinals up to the Feferman-Schütte ordinal is
          %ul
            %li
              Jean Gallier,
              = succeed "," do
                %em
                  What’s so Special about Kruskal’s Theorem and the Ordinal
                  = succeed "?," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Γ
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} \Gamma_0
              = succeed ")" do
                %a{:href => "ftp://ftp.cis.upenn.edu/pub/papers/gallier/kruskal2.pdf"} Part II
          %p An application of coalgebra theory to ordinal notation systems is described here:
          %ul
            %li
              Peter Hancock, Ordinal notation systems. (
              %a{:href => "http://homepages.inf.ed.ac.uk/v1phanc1/ordinal-notations.html"}> web
              )
          %p
            %a.existingWikiWord{:href => "/nlab/show/ordinal+analysis"} Ordinal analysis
            as measuring consistency strengths of theories is well-described in this paper:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Rathjen"}> Michael Rathjen
              , The art of ordinal analysis, International Congress of Mathematicians, II, Eur. Math. Soc., Zurich, pp. 45–69. (
              %a{:href => "http://www.icm2006.org/proceedings/Vol_II/contents/ICM_Vol_2_03.pdf"}> pdf
              )
