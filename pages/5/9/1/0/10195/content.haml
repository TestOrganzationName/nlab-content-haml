          #inflat.num_lemma
            %h6#lemma_3 Lemma
            %p
              For all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %msub
                        %mi ω
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} y \in \omega_1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ≤
                      %msub
                        %mi f
                        %mi y
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y \leq f_y(1)
          .proof
            %h6#proof_5 Proof
            %p
              By induction. Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ≤
                    %msub
                      %mi f
                      %mi α
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \leq f_\alpha(1)
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo &lt;
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \alpha \lt \beta
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ≤
                      %msub
                        %mi f
                        %mi β
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 1 \leq f_\beta(1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ≤
                    %msub
                      %mi f
                      %mi α
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %msub
                      %mi f
                      %mi α
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi β
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi f
                      %mi β
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \leq f_\alpha(1) \leq f_\alpha(f_\beta(1)) = f_\beta(1)
            %p
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi β
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_\beta(1)
              is by the preceding lemma a fixed point of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi α
                    %annotation{:encoding => "application/x-tex"} f_\alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi β
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_\beta(1)
              is both a limit ordinal and an upper bound for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo &lt;
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \alpha \lt \beta
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo ≤
                      %msub
                        %mi f
                        %mi β
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \beta \leq f_\beta(1)
          %p
            Notice that by definition,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi β
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_\beta(\gamma)
            is continuous in the argument
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi β
                  %mo =
                  %msub
                    %mi sup
                    %mrow
                      %mi α
                      %mo &lt;
                      %mi β
                  %msub
                    %mi f
                    %mi α
                %annotation{:encoding => "application/x-tex"} f_\beta = \sup_{\alpha \lt \beta} f_\alpha
            at limit ordinals
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %msub
                    %mi f
                    %mi x
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \mapsto f_x(1)
            is inflationary (by lemma
            = succeed ")" do
              %a.maruku-ref{:href => "#inflat"}
            = succeed "," do
              %a.maruku-ref{:href => "#fix"}
            = succeed "," do
              %strong Feferman-Schütte ordinal
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
