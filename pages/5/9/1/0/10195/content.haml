                        %mo &lt;
                        %mi γ
                        %mo &lt;
                        %mi β
                    %msub
                      %mi f
                      %mi α
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi γ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mi sup
                      %mrow
                        %mi α
                        %mo &lt;
                        %mi γ
                        %mo &lt;
                        %mi β
                    %msub
                      %mi f
                      %mi γ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
