            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+H.+H.+Fantham"}> Peter H. H. Fantham
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Eric+J.+Moore"} Eric J. Moore
              = succeed "," do
                %em Groupoid Enriched Categories and Homotopy Theory
              %strong 35
              3 (1983) 385-416 (
              %a{:href => "https://doi.org/10.4153/CJM-1983-022-8"}> doi:10.4153/CJM-1983-022-8
              )
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/Toda+bracket"} Toda bracket
            understood as
            %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+diagram"} homotopy-coherent
            %a.existingWikiWord{:href => "/nlab/show/pasting+diagrams"} pasting diagrams
            in a
            %a.existingWikiWord{:href => "/nlab/show/pointed+%28infinity%2C1%29-category"} pointed
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+2-category"} homotopy 2-category
          %ul
            %li#HardieKampsKieboom99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Keith+Hardie"}> Keith Hardie
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Klaus+Heiner+Kamps"} Klaus Heiner Kamps
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Rudger+Kieboom"} Rudger Kieboom
                = succeed "," do
                  %em Higher homotopy groupoids and Toda brackets
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.hha/1139840198"} euclid:hha/1139840198
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Keith+Hardie"}> Keith Hardie
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Howard+Marcum"} Howard Marcum
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nobuyuki+Oda"} Nobuyuki Oda
                = succeed "," do
                  %em Bracket operations in the homotopy theory of a 2-category
                = succeed ")" do
                  %a{:href => "https://rendiconti.dmi.units.it/volumi/33/02.pdf"} rendiconti:33/02
            %li#HardieKampsMarcum02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Keith+Hardie"}> Keith Hardie
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Klaus+Heiner+Kamps"} Klaus Heiner Kamps
                = succeed "," do
