          %h2#idea Idea
          %p
            The
            %em homotopy 2-category
            of an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category"} (∞,n)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ho
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ho_2(\mathcal{C})
            with the same
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            and
            %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            and with the
            %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
            being the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
            of 2-morphisms of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            In other words, for every
            %a.existingWikiWord{:href => "/nlab/show/pair"} pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X,Y
            of
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/hom-category"} hom-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ho
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ho_2(\mathcal{C})(X,Y)
            is the ordinary
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n-1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(X,Y)
