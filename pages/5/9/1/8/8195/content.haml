            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Howard+Marcum"}> Howard Marcum
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nobuyuki+Oda"} Nobuyuki Oda
                = succeed "," do
                  %em Long Box Bracket Operations in Homotopy Theory
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s10485-009-9186-3"} doi:10.1007/s10485-009-9186-3
          %p
            In the context of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+2-category+of+%28%E2%88%9E%2C1%29-categories"} homotopy 2-category of (∞,1)-categories
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/formal+%28infinity%2C1%29-category+theory"}
                formal
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li#Joyal08
              %p
