          %h2#idea Idea
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            of a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            (usually a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
            %em internally projective
            if it satisfies the
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internalization
            of the condition on a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
          %h2#definition Definition
          %p
            An object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            of a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \mathcal{T}
            is called
            %strong internally projective
            if the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi E
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒯
                  %mo →
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"}
                  (-)^E \colon \mathcal{T} \to \mathcal{T}
          %p
            preserves
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
          %h2#equivalent_characterizations Equivalent characterizations
          %p
            Some of these facts, and more, can be found stated in Exercises 15 and 16 in Chapter IV of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Sheaves+in+Geometry+and+Logic"} Sheaves in Geometry and Logic
          #DepProd.num_theorem
            %h6#theorem Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is internally projective if and only if the
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
              functor (the
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi E
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒯
                    %mo{:stretchy => "false"} /
                    %mi E
                    %mo →
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \Pi_E \colon \mathcal{T}/E \to \mathcal{T}
            %p preserves epimorphisms.
          .proof
            %h6#proof Proof
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi E
                  %annotation{:encoding => "application/x-tex"} (-)^E
              is the composite
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mi E
                      %mo ∘
                      %msup
                        %mi E
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \Pi_E \circ E^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒯
                    %mo →
                    %mi 𝒯
                    %mo{:stretchy => "false"} /
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E^*\colon \mathcal{T} \to \mathcal{T}/E
              preserves epis, so if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \Pi_E
              preserves epis then so does
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi E
                    %annotation{:encoding => "application/x-tex"} (-)^E
            %p
              Conversely, for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A\to B
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                      %mo{:stretchy => "false"} /
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \mathcal{T}/E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Π
                              %mi E
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi A
                              %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Π
                              %mi E
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi B
                              %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi id
                                  %mi E
                          %mtd
                            %msup
                              %mi E
                              %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Pi_E A &amp; \to &amp; A^E \\
                    \\downarrow &amp; &amp; \downarrow\\
                    \\Pi_E B &amp; \to &amp; B^E \\
                    \\downarrow &amp; &amp; \downarrow\\
                    1 &amp; \xrightarrow{id_E} &amp; E^E
                    }
            %p The lower square and outer rectangle are easily seen to be pullbacks, hence so is the upper square. Since epimorphisms are closed under pullback, the other implication follows.
          #Stable.num_lemma
            %h6#lemma Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is internally projective in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                    %annotation{:encoding => "application/x-tex"} \mathcal{T}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mo *
                    %mi E
                  %annotation{:encoding => "application/x-tex"} I^* E
              is internally projective in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                      %mo{:stretchy => "false"} /
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \mathcal{T}/I
          .proof
            %h6#proof_2 Proof
            %p
              This proof was given by
              %a.existingWikiWord{:href => "/nlab/show/Alex+Simpson"} Alex Simpson
              = succeed "." do
                %a{:href => "http://mathoverflow.net/a/140262/49"} here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi B
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} q:B\to A
              be an epimorphism from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo :
                    %mi B
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} v:B\to I
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo :
                      %mi A
                      %mo →
                      %mi I
                    %annotation{:encoding => "application/x-tex"} u:A\to I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mrow
                        %msup
                          %mi I
                          %mo *
                        %mi E
                  %annotation{:encoding => "application/x-tex"} u^{I^*E}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}/I
              is the equalizer of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ×
                    %msup
                      %mi A
                      %mi E
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi pr
                          %mn 2
                    %msup
                      %mi A
                      %mi E
                    %mover
                      %mo →
                      %mi u
                    %msup
                      %mi I
                      %mi E
                  %annotation{:encoding => "application/x-tex"} I\times A^E \xrightarrow{pr_2} A^E \xrightarrow{u} I^E
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ×
                    %msup
                      %mi A
                      %mi E
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi pr
                          %mn 1
                    %mi I
                    %mover
                      %mo →
                      %mi const
                    %msup
                      %mi I
                      %mi E
                  %annotation{:encoding => "application/x-tex"} I\times A^E \xrightarrow{pr_1} I \xrightarrow{const} I^E
            %p
              equipped with the obvious projection to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi v
                              %mrow
                                %msup
                                  %mi I
                                  %mo *
                                %mi E
                          %mtd
                            %mo →
                          %mtd
                            %mi I
                            %mo ×
                            %msup
                              %mi B
                              %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi u
                              %mrow
                                %msup
                                  %mi I
                                  %mo *
                                %mi E
                          %mtd
                            %mo →
                          %mtd
                            %mi I
                            %mo ×
                            %msup
                              %mi A
                              %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    v^{I^*E} &amp; \to &amp; I\times B^E \\
                    \\downarrow &amp; &amp; \downarrow \\
                    u^{I^*E} &amp; \to &amp; I\times A^E
                    }
            %p
              in which the right-hand map is epi since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is internally projective; hence so is the left-hand map.
          #StackSem.num_theorem
            %h6#theorem_2 Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is internally projective if and only if the statement “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is projective” is true in the
              %a.existingWikiWord{:href => "/nlab/show/stack+semantics"} stack semantics
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                    %annotation{:encoding => "application/x-tex"} \mathcal{T}
          .proof
            %h6#proof_3 Proof
            %p
              By definition, truth of “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is projective” in the stack semantics means that for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              and any epimorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi I
                      %mo ×
                      %mi E
                    %annotation{:encoding => "application/x-tex"} A\to I\times E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi J
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} p:J\to I
              and a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ×
                      %mi id
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mi A
                      %mo →
                      %mi J
                      %mo ×
                      %mi E
                    %annotation{:encoding => "application/x-tex"} (p\times id)^*A \to J\times E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is projective just when every epimorphism with codomain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is split.)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is internally projective, then given an epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi I
                    %mo ×
                    %mi E
                  %annotation{:encoding => "application/x-tex"} A\to I\times E
              as above, let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo =
                      %msub
                        %mi Π
                        %mrow
                          %msub
                            %mi pr
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J = \Pi_{pr_1}(A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi pr
                      %mn 1
                    %mo :
                    %mi I
                    %mo ×
                    %mi E
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} pr_1:I\times E \to I
              is the projection. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ×
                    %mi E
                  %annotation{:encoding => "application/x-tex"} I\times E
              is internally projective in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}/I
              by Lemma
              = succeed "," do
                %a.maruku-ref{:href => "#Stable"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi J
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} p:J\to I
              is an epimorphism. And
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ×
                    %mi id
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi A
                    %mo →
                    %mi J
                    %mo ×
                    %mi E
                  %annotation{:encoding => "application/x-tex"} (p\times id)^*A \to J\times E
              is split by the
              %a.existingWikiWord{:href => "/nlab/show/counit"} counit
              of the adjunction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi pr
                        %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo ⊣
                      %msub
                        %mi Π
                        %mrow
                          %msub
                            %mi pr
                            %mn 1
                    %annotation{:encoding => "application/x-tex"} (pr_1)^* \dashv \Pi_{pr_1}
            %p
              Conversely, suppose the above condition holds, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo :
                    %mi B
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} e:B\to A
              be an epimorphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                      %mo{:stretchy => "false"} /
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \mathcal{T}/E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %msub
                        %mi Π
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} I = \Pi_E(A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be the pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              along the counit
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi E
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \Pi_E(A) \times E\to A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_E(B)
              is equivalently
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mrow
                          %msub
                            %mi pr
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi_{pr_1}(C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi pr
                      %mn 1
                    %mo :
                    %mi I
                    %mo ×
                    %mi E
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} pr_1:I \times E \to I
              is the projection.
            %p
              Moreover,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi I
                    %mo ×
                    %mi E
                  %annotation{:encoding => "application/x-tex"} C \to I\times E
              is epi, so by assumption there is an epi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi J
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} p:J\to I
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ×
                    %mi id
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi C
                    %mo →
                    %mi J
                    %mo ×
                    %mi E
                  %annotation{:encoding => "application/x-tex"} (p\times id)^*C \to J\times E
              is split. Since pullback along epis reflects epis, it suffices to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                    %msub
                      %mi Π
                      %mrow
                        %msub
                          %mi pr
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p^* \Pi_{pr_1}(C)
              is split. However, we have a pullback square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi J
                            %mo ×
                            %mi E
                          %mtd
                            %mo →
                          %mtd
                            %mi I
                            %mo ×
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mrow
                                %msub
                                  %mi pr
                                  %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi pr
                                  %mn 1
                        %mtr
                          %mtd
                            %mi J
                          %mtd
                            %mo →
                          %mtd
                            %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    J\times E &amp; \to &amp; I\times E \\
                    ^{pr_1}\downarrow &amp; &amp; \downarrow^{pr_1} \\
                    J &amp; \to &amp; I
                    }
            %p
              so by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Beck-Chevalley+condition"} Beck-Chevalley condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                    %msub
                      %mi Π
                      %mrow
                        %msub
                          %mi pr
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p^* \Pi_{pr_1}(C)
              is equivalently
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mrow
                          %msub
                            %mi pr
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ×
                      %mi id
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \Pi_{pr_1}(p\times id)^* C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ×
                    %mi id
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi C
                  %annotation{:encoding => "application/x-tex"} (p\times id)^*C
              is split, and all functors preserve split epis.
          %p
            Note that Lemma D4.5.3(iii) of
            %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Sketches of an Elephant
            is the special case of the above stack-semantics version of internal projectivity when
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} I=1
            = succeed "(ii)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
          %h2#projectivity_versus_internal_projectivity Projectivity versus internal projectivity
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                %annotation{:encoding => "application/x-tex"} \mathcal{T}
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective
          #enough.num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
              has
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} enough projectives
              and projectives are closed under binary
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/products"} products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
              are projective then all objects are internally projective.)
          .proof
            %h6#proof_4 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              be a projective object. To show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi P
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi E
                      %mi P
                    %mo →
                    %msup
                      %mi B
                      %mi P
                  %annotation{:encoding => "application/x-tex"} e^P \colon E^P \to B^P
              is epic whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} e \colon E \to B
              is epic, choose an epi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi P
                    %mo ′
                    %mo →
                    %msup
                      %mi B
                      %mi P
                  %annotation{:encoding => "application/x-tex"} \phi \colon P' \to B^P
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} P'
              is projective (using the assumption of enough projectives). Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ×
                    %mi P
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} P \times P'
              is projective, there exists a lift through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              of the horizontal composite as shown:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi e
                        %mtr
                          %mtd
                            %mi P
                            %mo ′
                            %mo ×
                            %mi P
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %mi ϕ
                                %mo ×
                                %mn 1
                          %mtd
                            %msup
                              %mi B
                              %mi P
                            %mo ×
                            %mi P
                          %mtd
                            %munder
                              %mo →
                              %mi eval
                          %mtd
                            %mi B
                            %mo ;
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; &amp; &amp; &amp; E \\
                    \&amp; &amp; &amp; &amp; \downarrow ^\mathrlap{e} \\
                    P' \times P &amp; \underset{\phi \times 1}{\to} &amp; B^P \times P &amp; \underset{eval}{\to} &amp; B;
                    }
            %p
              this, by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/currying"} currying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi P
                    %mo ′
                    %mo →
                    %msup
                      %mi B
                      %mi P
                  %annotation{:encoding => "application/x-tex"} \phi \colon P' \to B^P
              through
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mi P
                    %annotation{:encoding => "application/x-tex"} e^P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is epic, this immediately implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi P
                  %annotation{:encoding => "application/x-tex"} e^P
              is epic, as desired.
          .num_remark
            %h6#remark Remark
            %p
              Proposition
              %a.maruku-ref{:href => "#enough"}
              may fail without the assumption that projective objects are closed under binary products. An example is given
              = succeed "." do
                %a{:href => "/nlab/show/presentation+axiom#counter"} here
          .num_remark
            %h6#remark_2 Remark
            %p
              The
              %em internal axiom of choice
              (that is, the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              interpreted in the
              %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
              of the topos) is equivalent to the statement that every object is internally projective. This is strictly weaker than the “external” axiom of choice that every
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              in the topos is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split
          #presheaf.num_cor
            %h6#corollary Corollary
            %p
              In a presheaf topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi C
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Set^{C^{op}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has binary products, then every projective presheaf is internally projective.
          .proof
            %h6#proof_5 Proof
            %p
              Representables, and arbitrary coproducts of representables, are projective, and every presheaf is covered by some coproduct of representables. This implies that projective presheaves are precisely retracts of coproducts of representables. Under the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has binary products, coproducts of representables, and also their retracts, are also closed under binary products. Thus projective presheaves are closed under binary products. Now apply Proposition
              = succeed "." do
                %a.maruku-ref{:href => "#enough"}
          %h2#discussion Discussion
          %ul
            %li
              Forum discussions
              = succeed "," do
                %a{:href => "http://nforum.ncatlab.org/discussion/3008/internally-projective-objects/"} one
              = succeed "." do
                %a{:href => "http://nforum.ncatlab.org/discussion/4342/internally-projective-objects/"} two
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/projective+object"}> projective object
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/projective+presentation"} projective presentation
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/projective+cover"} projective cover
                %a.existingWikiWord{:href => "/nlab/show/projective+resolution"} projective resolution
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/internally+projective+object"} internally projective object
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/injective+object"}> injective object
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/injective+presentation"} injective presentation
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/injective+envelope"} injective envelope
                %a.existingWikiWord{:href => "/nlab/show/injective+resolution"} injective resolution
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/injective+module"} injective module
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+object"}> free object
                ,
                %a.existingWikiWord{:href => "/nlab/show/free+resolution"} free resolution
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
            %li
              %p
                flat object,
                %a.existingWikiWord{:href => "/nlab/show/flat+resolution"} flat resolution
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/flat+module"} flat module
          %h2#references References
          %ul
            %li{:id => "Wärn24"}
              %a.existingWikiWord{:href => "/nlab/show/David+W%C3%A4rn"}> David Wärn
              ,
              %em On internally projective sheaves of groups
              (
              %a{:href => "https://arxiv.org/pdf/2409.12835"}> arXiv:2409.12835
              )
