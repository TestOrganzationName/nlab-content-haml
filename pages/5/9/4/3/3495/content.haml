                  %annotation{:encoding => "application/x-tex"} \hom_C(f, i(X)): \hom_C(B, i(X)) \stackrel{\sim}{\to} \hom_C(A, i(X))
            %p
              Since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
