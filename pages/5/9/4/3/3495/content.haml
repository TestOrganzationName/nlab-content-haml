          %h2#idea Idea
          %p
            The
            %strong orthogonal subcategory problem
            for a
            %a.existingWikiWord{:href => "/nlab/show/class"} class
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            in a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            asks whether the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} \Sigma^\perp
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
            %a.existingWikiWord{:href => "/nlab/show/orthogonal"} orthogonal
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
          %p
            Here, an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is said to be orthogonal to a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:A\to B
            if every morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} A\to X
            factors uniquely through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} X:C^{op}\to Set
            is orthogonal to the canonical map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi colim
                    %mi i
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mi a
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} colim
                    %mi i
                  %msub
                    %mi a
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} colim_i C(-,a_i)\to C(-,\colim_i a_i)
            if it preserves the limit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi lim
                    %mi i
                  %msub
                    %mi a
                    %mi i
                %annotation{:encoding => "application/x-tex"} \lim_i a_i
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
          %p
            This problem is related to the problem of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} \Sigma^\perp
            is indeed a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo :
                  %mi C
                  %mo →
                  %msup
                    %mi Σ
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} r: C \to \Sigma^\perp
            be the reflector (the
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to the inclusion
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %msup
                      %mi Σ
                      %mo ⊥
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} i: \Sigma^\perp \to C
          %h2#properties Properties
          .un_lemma
            %h6#lemma Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi a
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} f: a \to b
              belongs to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r(f): r(a) \to r(b)
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Σ
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \Sigma^\perp
          .proof
            %h6#proof Proof
            %p
              By definition of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/orthogonality"} orthogonality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Σ
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \Sigma^\perp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              induces an isomorphism of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ∼
                    %msub
                      %mi hom
                      %mi C
                    %mo{:stretchy => "false"} (
