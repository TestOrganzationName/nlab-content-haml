              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is finitely
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi sat
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
