              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
