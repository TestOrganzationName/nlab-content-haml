          %h1#the_axiom_of_union The axiom of union
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#statement"} Statement
              %ul
                %li
                  %a{:href => "#in_material_set_theory"}  In material set theory
                %ul
                  %li
                    %a{:href => "#axiom_union"} Axiom (union)
                %li
                  %a{:href => "#in_dependent_type_theory"}  In dependent type theory
              %li
