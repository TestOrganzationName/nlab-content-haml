                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    y^* X &amp;\to&amp; &amp;\to&amp; \mathbf{\Pi} X
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow
                    \\\
                    * &amp;\stackrel{y}{\to}&amp; Y &amp;\stackrel{}{\to}&amp; \mathbf{\Pi}Y
