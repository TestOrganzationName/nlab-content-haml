                    %mo →
                    %mi Γ
                    %mi Disc
                    %mi Π
                    %mi X
                    %mo ≃
                    %mi Π
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma X \to \Gamma Disc \Pi X \simeq \Pi X
            %p
