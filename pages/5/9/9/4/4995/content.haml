          #ThickenedPoint.num_remark
            %h6#remark_4 Remark
            %p
              This says that a cohesive
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
