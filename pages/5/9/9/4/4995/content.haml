                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            A cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            with good
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            and
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            properties. We list fundamental structures and constructions that exist in every cohesvive
            = succeed "-topos." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p This section is at
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos+--+structures"} cohesive (∞,1)-topos – structures
          %h2#types_of_cohesion Types of cohesion
          %h3#infinitesimal_cohesion Infinitesimal cohesion
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+cohesion"} infinitesimal cohesion
          %h3#DifferentialCohesion Differential cohesion
          %p
            We discuss
            %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra structure
            on a cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
