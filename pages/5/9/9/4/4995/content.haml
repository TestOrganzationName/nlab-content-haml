                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H} \simeq ([C^{op}, sSet]_{proj,loc})^\circ
                    \\,.
            %p
              Moreover, picking a
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              presentation for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi const
                    %mi A
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} const A \in [C^{op}, sSet]_{proj, loc}
              is fibrant. Therefore by
              %a{:href => "http://ncatlab.org/nlab/show/model+structure+on+an+over+category#PresentationOfSliceInfinityCat"} this proposition
              the induced
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+an+overcategory"} model structure on an overcategory
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi const
                    %mi A
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]/const A
              presents the given
              %a.existingWikiWord{:href => "/nlab/show/over+%28%E2%88%9E%2C1%29-category"} over (∞,1)-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi Disc
                        %mi A
                    %mo ≃
                    %msup
                      %mrow
                        %mo (
                        %msub
                          %mrow
                            %mo (
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mi op
                            %mo ,
                            %mi sSet
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} /
                            %mi const
                            %mi A
                            %mo )
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi proj
                            %mo ,
                            %mi loc
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi const
                            %mi A
                        %mo )
                      %mo ∘
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}_{/ Disc A}
                    \\simeq
                    \\left(
                    \\left([C^{op}, sSet]/const A\right)_{(proj,loc)/const A}
                    \\right)^\circ
                    \\,.
            %p
              Now observe that we have an ordinary
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi const
                    %mi A
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [C^{op}, sSet]/const A
                    \\simeq
                    [C^op, sSet/A]
            %p
              under which the model structure becomes that of the local projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
              with values in the model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} /
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi Quillen
                        %mo{:stretchy => "false"} /
                        %mi A
                  %annotation{:encoding => "application/x-tex"} (sSet/A)_{Quillen/A}
              that presents
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %msub
                        %mi Grpd
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi A
                    %annotation{:encoding => "application/x-tex"} \infty Grpd_{/ A}
            %p
              Let then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} sSet^+/A
              denote the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+left+fibrations"} model structure for left fibrations
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %msub
                        %mi Grpd
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi A
                    %annotation{:encoding => "application/x-tex"} \infty Grpd_{/ A}
              %a{:href => "http://ncatlab.org/nlab/show/model+structure+on+functors#PresentationOfInfinityFunctors"} this proposition
              we have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mi Disc
                                %mi A
                          %mtd
                            %mo ≃
                            %msup
                              %mrow
                                %mo (
                                %mo{:stretchy => "false"} [
                                %msup
                                  %mi C
                                  %mi op
                                %mo ,
                                %mi sSet
                                %mo{:stretchy => "false"} /
                                %mi A
                                %msub
                                  %mo{:stretchy => "false"} ]
                                  %mrow
                                    %mi proj
                                    %mo ,
                                    %mi loc
                                %mo )
                              %mo ∘
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mrow
                                %mo (
                                %mo{:stretchy => "false"} [
                                %msup
                                  %mi C
                                  %mi op
                                %mo ,
                                %msup
                                  %mi sSet
                                  %mo +
                                %mo{:stretchy => "false"} /
                                %mi A
                                %msub
                                  %mo{:stretchy => "false"} ]
                                  %mrow
                                    %mi proj
                                    %mo ,
                                    %mi loc
                                %mo )
                              %mo ∘
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{H}_{Disc A}
                    \&amp; \simeq
                    \\left(
                    [C^{op}, sSet/A]_{proj,loc}
                    \\right)^\circ
                    \\\
                    \&amp; \simeq
                    \\left(
                    [C^{op}, sSet^+/A]_{proj,loc}
                    \\right)^\circ
                    \\end{aligned}
                    \\,.
            %p
              This allows now to apply
              %a{:href => "http://ncatlab.org/nlab/show/model%20structure%20for%20left%20fibrations#GrothendieckConstruction"} this presentation
              of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
              to find
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi C
                          %mi op
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi w
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi sSet
                          %mi Quillen
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi proj
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mrow
                            %mi proj
                            %mo ,
                            %mi loc
                        %mo )
                      %mo ∘
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq
                    \\left(
                    [C^{op}, [w(A), sSet_{Quillen}]_{proj}]_{proj,loc}
                    \\right)^\circ
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} w(A)
              is the
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicially enriched category
              corresponding to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (as discussed at
              %em
                %a.existingWikiWord{:href => "/nlab/show/relation+between+quasi-categories+and+simplicial+categories"} relation between quasi-categories and simplicial categories
              ) and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi w
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [w(A), sSet_{Quillen}]_{proj}
              is the global
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+sSet-enriched+presheaves"} model structure on sSet-enriched presheaves
            %p
              Then using the
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closure
              of the category of simplicial presheaves (which is a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} (-)^\circ
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} [
                        %mi w
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi C
                          %mi op
                        %mo ,
                        %msub
                          %mi sSet
                          %mi Quillen
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mrow
                            %mi proj
                            %mo ,
                            %mi loc
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi proj
                        %mo )
                      %mo ∘
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\simeq
                    \\left(
                    [w(A), [C^{op}, sSet_{Quillen}]_{proj,loc}]_{proj}
                    \\right)^\circ
                    \\,.
            %p
              Finally this implies the claim using
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-functors#PresentationByModelStructuresOnFunctors"} this proposition
          %p
            With this lemma we can now give the proof of prop.
            = succeed "." do
              %a.maruku-ref{:href => "#PiPreservesPullbacksOverDiscretes"}
          .proof
            %h6#proof_5 Proof
            %p
              By the discussion at
              %a{:href => "http://ncatlab.org/nlab/show/adjoint+%28infinity,1%29-functor#OnSlices"} adjoint (∞,1)-functors on slices
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo ⊣
                    %mi Disc
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Pi \dashv Disc)
              induces an adjoint pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} /
                    %mi Disc
                    %mi A
                    %mo ⊣
                    %mi Disc
                    %mo{:stretchy => "false"} /
                    %mi Disc
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mi Disc
                        %mi A
                    %mo →
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi/Disc A \dashv Disc / Disc A)
                    \:
                    \\mathbf{H}_{Disc A}
                    \\to
                    \\infty Grpd_{/A}
                    
                    \\,.
            %p
              Under the equivalence from lemma
              %a.maruku-ref{:href => "#GrothendieckConstrInCohesivefinityTopos"}
              the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} /
                    %mi Disc
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Pi/Disc A
              maps to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi Π
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Func(A, \Pi) :
                    Func(A, \mathbf{H}) \to
                    Func(A, \infty Grpd)
                    \\,.
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/products"} products
              of
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              preserves finite products by the axioms of cohesion, also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi Π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func(A, \Pi)
              preserves finite products, and hence so does
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} /
                      %mi Disc
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \Pi/Disc A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi A
                  %annotation{:encoding => "application/x-tex"} Disc A
              are
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullbacks"} (∞,1)-pullbacks
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                      %mi A
                    %annotation{:encoding => "application/x-tex"} Disc A
          %h3#OverArbitraryBases Base of discrete and codiscrete objects
          %p
            In the
            %a{:href => "#InternalDefinition"} internal definition
            the base of discrete/codiscrete objects is not explicitly axiomatized to be an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            itself (the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/base+%28%E2%88%9E%2C1%29-topos"} base (∞,1)-topos
          %p
            In the following, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            equipped with an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
            of functors to an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathbf{B}
            – the
            = succeed "," do
              %em base of cohesion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Disc
                %annotation{:encoding => "application/x-tex"} Disc
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi coDisc
                %annotation{:encoding => "application/x-tex"} coDisc
            are full and faithful.
          #LimitsInBase.num_prop
            %h6#proposition_6 Proposition
            %p
              The base
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}
              of cohesion has all
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
          .proof
            %h6#proof_6 Proof
            %p
              This is a general property of a reflectively and coreflectively embedded subcategory. The limits are computed by computing them in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              and then applying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              and the colimits are computed by computing them in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              and then applying
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                    %annotation{:encoding => "application/x-tex"} \Pi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo :
                    %mi I
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"} X : I \to \mathbf{B}
              any
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Γ
                            %munder
                              %mi lim
                              %mrow
                                %msub
                                  %mo ←
                                  %mi i
                            %mi Disc
                            %msub
                              %mi X
                              %mi i
                          %mtd
                            %mo ≃
                            %munder
                              %mi lim
                              %mrow
                                %msub
                                  %mo ←
                                  %mi i
                            %mi Γ
                            %mi Disc
                            %msub
                              %mi X
                              %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %munder
                              %mi lim
                              %mrow
                                %msub
                                  %mo ←
                                  %mi i
                            %msub
                              %mi X
                              %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Gamma \lim_{\leftarrow_i} Disc X_i
                    \&amp; \simeq
                    \\lim_{\leftarrow_i} \Gamma Disc X_i
                    \\\
                    \&amp; \simeq
                    \\lim_{\leftarrow_i}  X_i
                    \\end{aligned}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Π
                            %munder
                              %mi lim
                              %mrow
                                %msub
                                  %mo →
                                  %mi i
                            %mi Disc
                            %msub
                              %mi X
                              %mi i
                          %mtd
                            %mo ≃
                            %munder
                              %mi lim
                              %mrow
                                %msub
                                  %mo ←
                                  %mi i
                            %mi Π
                            %mi Disc
                            %msub
                              %mi X
                              %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %munder
                              %mi lim
                              %mrow
                                %msub
                                  %mo ←
                                  %mi i
                            %msub
                              %mi X
                              %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Pi \lim_{\to_i} Disc X_i
                    \&amp; \simeq
                    \\lim_{\leftarrow_i} \Pi Disc X_i
                    \\\
                    \&amp; \simeq
                    \\lim_{\leftarrow_i}  X_i
                    \\end{aligned}
                    \\,.
          .num_remark
            %h6#remark_5 Remark
            %p
              Since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                    %annotation{:encoding => "application/x-tex"} Disc
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              as well as a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              preserves limits and colimits, it follows that a (co)limit of discrete objects computed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is itself again discrete and is the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              of the coresponding (co)limit computed in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}
          .num_example
            %h6#example Example
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/loop+space+objects"} loop space objects
              are
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
              it follows that the loop space object of any discrete object is itself again a discrete object.
          %p We have also the following stronger statement.
          .num_prop
            %h6#proposition_7 Proposition
            %p
              The base of cohesion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}
              is a
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
              and in fact an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              itself.
          .proof
            %h6#proof_7 Proof
            %p
              By one of the equivalent characterizations of
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-categories"} presentable (∞,1)-categories
              these are
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-categories"} reflective sub-(∞,1)-categories
              of
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-categories of (∞,1)-presheaves
              where the embedding is by an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/accessible+%28%E2%88%9E%2C1%29-functor"} accessible (∞,1)-functor
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is itself accessibly and reflectively embedded into the presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(C)
              on a
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
              of definition, we have a composite reflective inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mover
                      %mo ↪
                      %mi Disc
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ↪
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}
                    \\stackrel{Disc}{\hookrightarrow}
                    \\mathbf{H}
                    \\hookrightarrow
                    PSh(C)
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              even preserves all
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/accessible+%28%E2%88%9E%2C1%29-functor"} accessible (∞,1)-functor
            %p
              Finally, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              preserves all
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi coDisc
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma, coDisc)
              is a
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
              that exhibits an sub-
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"}> (∞,1)-topos
              \.
          %p
            Notice that the reflection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo ⊣
                  %mi Disc
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Pi \dashv Disc)
            does not in general constitute a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            is only required to preserve finite products (and in interesting examples rarely preserves more limits than that).
          %p
            The following statement and its proof about
            %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive 1-toposes
            should hold verbatim also for cohesive
            = succeed "-toposes." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .num_prop
            %h6#proposition_8 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategories"} reflective subcategories
              of discrete objects and of codiscrete objects are both
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exponential+ideals"} exponential ideals
          .proof
            %h6#proof_8 Proof
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/exponential+ideal"} exponential ideal
              a reflective subcategories of a
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
              is an exponential ideal precisely if the
              %a.existingWikiWord{:href => "/nlab/show/reflector"} reflector
              preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/products"} products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              preserves even all
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and for the discrete objects the reflector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              does so by assumotion of strong connectedness.
          %h3#FactorizationSystemsForPi
            Factorization systems associated to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Π
                %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}
          %p
            We discuss
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system+in+an+%28infinity%2C1%29-category"} orthogonal factorization systems
            in a cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28infinity%2C1%29-category"} reflective subcategory
            of dicrete objects, with reflector
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mo →
                      %mi Π
                    %mn ∞
                    %mi Grpd
                    %mover
                      %mo ↪
                      %mi Disc
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi} : \mathbf{H} \stackrel{\Pi}{\to} \infty Grpd \stackrel{Disc}{\hookrightarrow} \mathbf{H}
          #PiClosure.num_defn
            %h6#definition_7 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              a morphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                    %mi f
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} c_{\mathbf{\Pi}} f \to Y
              for the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi c
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                            %mi f
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mstyle{:mathvariant => "bold"}
                                    %mi Π
                                  %mi f
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    c_{\mathbf{\Pi}} f &amp;\to &amp; \mathbf{\Pi} X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\mathbf{\Pi} f}}
                    \\\
                    Y &amp;\to&amp; \mathbf{\Pi} Y
                    }
                    \\,,
            %p
              where the bottom morphism is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mo ⊣
                      %mi Disc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Pi \dashv Disc)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                    %mi f
                  %annotation{:encoding => "application/x-tex"} c_{\mathbf{\Pi}} f
              is the
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}
                \-closure
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}
                %a.existingWikiWord{:href => "/nlab/show/Pi-closed+morphism"} -closed
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ≃
                      %msub
                        %mi c
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                      %mi f
                    %annotation{:encoding => "application/x-tex"} X \simeq c_{\mathbf{\Pi}} f
          #FactorizationPiEquivalencePiClosed.num_prop
            %h6#proposition_9 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              has an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
              of definition, then every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              factors as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi c
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                            %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp;\stackrel{f}{\to}&amp;&amp; Y
                    \\\
                    \&amp; \searrow &amp;&amp; \nearrow
                    \\\
                    \&amp;&amp; c_{\mathbf{\Pi}}f
                    }
                    \\,,
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi c
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                    %mi f
                  %annotation{:encoding => "application/x-tex"} X \to c_{\mathbf{\Pi}} f
              is a
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}
                \-equivalence
              in that it is inverted by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}
          .proof
            %h6#proof_9 Proof
            %p
              The factorization is given by the naturality of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}
              and the universal property of the
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
