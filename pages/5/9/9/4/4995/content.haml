          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/differential+cohesive+%28%E2%88%9E%2C1%29-topos"} differential cohesive (∞,1)-topos
          %h3#locally_ringed_cohesion Locally ringed cohesion
          %p
            Every cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
