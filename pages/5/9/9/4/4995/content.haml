              = succeed "-closed." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mi Y
                            %mspace{:width => "thinmathspace"}
                            %mo .
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\to&amp; X &amp;\to&amp; \mathbf{\Pi}X
                    \\\
                    \\downarrow &amp;&amp; \downarrow  &amp;&amp; \downarrow
                    \\\
                    B &amp;\to&amp; Y &amp;\to&amp; \mathbf{\Pi}Y
