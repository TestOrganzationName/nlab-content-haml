                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              We establish this via a
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presentation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
