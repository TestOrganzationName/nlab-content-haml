          #PiPreservesPullbacksOverDiscretes.num_prop
            %h6#proposition_5 Proposition
            %p
              For a cohesive
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
