                    }
                    \\,.
            %p
              By naturality of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} adjunction unit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
