            %h6#observation Observation
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              a
              = succeed "-closed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mo *
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y : * \to Y
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/global+element"} global element
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi y
                    %mo :
                    %mo =
                    %msup
                      %mi y
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_y := y^* X
              is a discrete object.
          .proof
            %h6#proof_11 Proof
            %p
              By the def.
              %a.maruku-ref{:href => "#PiClosure"}
              and the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi y
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} y^* X
              is equivalently the
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
