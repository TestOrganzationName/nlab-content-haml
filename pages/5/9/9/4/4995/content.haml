                  %annotation{:encoding => "application/x-tex"} (\Pi \dashv Disc)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Disc
                %annotation{:encoding => "application/x-tex"} Disc
            is
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful
            in a
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/local+%28%E2%88%9E%2C1%29-topos"} local (∞,1)-topos
          #DiscreteObjectsAreConcrete.num_defn
            %h6#definition_4 Definition
            %p
              We say
              %strong discrete objects are concrete
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} S \in
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi S
                    %mo →
                    %mi coDisc
                    %mi Γ
                    %mi Disc
                    %mi S
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi coDisc
                    %mi S
                  %annotation{:encoding => "application/x-tex"}
                    Disc S \to coDisc \Gamma Disc S \stackrel{\simeq}{\longrightarrow} coDisc S
            %p
              induces
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/categorical+homotopy+groups+in+an+%28infinity%2C1%29-topos"} homotopy sheaves
          %p
            The following extra condition ensures that the
            %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            is explicitly given by a geometric
            %a.existingWikiWord{:href => "/nlab/show/path+%E2%88%9E-groupoid"} path ∞-groupoid
            construction.
          #A1ExhibitingCohesion.num_defn
            %h6#definition_5 Definition
            %p
              Given a cohesive
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              and an object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1 \in \mathbf{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              %em exhibits the cohesion
              if the
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              is equivalent to “
              %a.existingWikiWord{:href => "/nlab/show/A1-homotopy+theory"}> A1-localization
              ”
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mrow
                          %msup
                            %mi 𝔸
                            %mn 1
                    %annotation{:encoding => "application/x-tex"} L_{\mathbb{A}^1}
              %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              at the class of
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              morphisms of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msup
                        %mi 𝔸
                        %mn 1
                      %mo ⟶
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-)\times \mathbb{A}^1 \longrightarrow (-)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo ≃
                    %msub
                      %mi L
                      %mrow
                        %msup
                          %mi 𝔸
                          %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi \simeq L_{\mathbb{A}^1}
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              In the example of
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth cohesion
              and its variants such as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+topological+infinity-groupoid"} Euclidean topological cohesion
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                    %mo =
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1 = \mathbb{R}^1
              exhibits cohesion in the sense of def.
              %a.maruku-ref{:href => "#A1ExhibitingCohesion"}
              (by
              = succeed ")." do
                %a{:href => "cohesive+%28infinity%2C1%29-topos+--+structures#RealLineIsTheContinuum"} this discussion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              in a cohesive
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %em
                the
                %a.existingWikiWord{:href => "/nlab/show/continuum"} continuum
              in analogy of the traditional use of this term in geometry. See also at
              = succeed "." do
                %em
                  %a{:href => "continuum#InCohesiveHomotopyTypeTheory"} continuum – In cohesive homotopy theory
          %p
            Another extra axiom is (see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
            for more):
          #AufhebungOfBecoming.num_defn
            %h6#definition_6 Definition
            %p
              Say that a cohesive
              = succeed "-topos," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %a.maruku-ref{:href => "#CohesiveInfinTopos"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
                of
                %a.existingWikiWord{:href => "/nlab/show/becoming"} becoming
              if the
              %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
              preserves the
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♯
                    %mi ∅
                    %mo ≃
                    %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sharp \emptyset \simeq \emptyset
                    \\,.
          %h3#InternalDefinition Internally
          %p
            We reformulate the
            %a{:href => "#ExternalDefinition"} above axioms
            for a cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %em on
            it, and instead entirely in terms of structures
            %em in
            it.
          #ReflectiveEmbeddingInternally.num_lemma
            %h6#lemma Lemma
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} \hookrightarrow \mathbf{H}
              is
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflectively embedded
                  precisely if for every
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi loc
                          %mi X
                        %mo :
                        %mi X
                        %mo →
                        %mi L
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        loc_X : X \to L X
                %p
                  (the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                          %mi X
                          %mo ∈
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo ↪
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                        %annotation{:encoding => "application/x-tex"} L X \in \mathbf{B} \hookrightarrow \mathbf{H}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mo ↪
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} Y \in \mathbf{B} \hookrightarrow \mathbf{H}
                  the value of the
                  = succeed "-functor" do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categorical+hom-space"} (∞,1)-categorical hom-space
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi loc
                          %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ≃
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbf{H}(loc_X, Y) :
                        \\mathbf{H}(L X, Y)
                        \\stackrel{\simeq}{\longrightarrow}
                        \\mathbf{H}(X, Y)
                %p
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
                  (of
                  = succeed "s)." do
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              %li
                %p
                  coreflectively embedded precisely if for every
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} Y \in \mathbf{H}
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi coloc
                          %mi Y
                        %mo :
                        %mi R
                        %mi Y
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"}
                        coloc_Y : R Y \to Y
                %p
                  (the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mi Y
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mo ↪
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} R Y \in \mathbf{B} \hookrightarrow \mathbf{H}
                  such that for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mo ↪
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} X \in \mathbf{B} \hookrightarrow \mathbf{H}
                  the value of the
                  = succeed "-functor" do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categorical+hom-space"} (∞,1)-categorical hom-space
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi coloc
                          %mi Y
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi R
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mo ≃
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbf{H}(X, coloc_Y) :
                        \\mathbf{H}(X, R Y)
                        \\stackrel{\simeq}{\to}
                        \\mathbf{H}(X, Y)
                %p
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
                  (of
                  = succeed "s)." do
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          %p
            This is proven
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/reflective+sub-%28infinity,1%29-category#CharacterizationOfReflectors"} here
          .num_lemma
            %h6#lemma_2 Lemma
            %p A reflective embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi cod
                    %mover
                      %munder
                        %mo ↪
                        %mi coDisc
                      %mover
                        %mo ←
                        %mover
                          %mi Γ
                          %mo{:stretchy => "false"} ˜
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    coDisc : \mathbf{B}_{cod} \stackrel{\overset{\tilde \Gamma}{\leftarrow}}{\underset{coDisc}{\hookrightarrow}} \mathbf{H}
            %p and a coreflective embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi disc
                    %mover
                      %munder
                        %mo ←
                        %mi Γ
                      %mover
                        %mo ↪
                        %mi Disc
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    Disc : \mathbf{B}_{disc} \stackrel{\overset{Disc}{\hookrightarrow}}{\underset{\Gamma}{\leftarrow}} \mathbf{H}
            %p
              fit into a single
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mover
                        %munder
                          %mo ↩
                          %mi coDisc
                        %mover
                          %mo →
                          %mi Γ
                      %mover
                        %mo ↩
                        %mi Disc
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}
                    \\stackrel{
                    \\overset{Disc}{\hookleftarrow}
                    }{
                    \\stackrel{
                    \\overset{\Gamma}{\to}
                    }{
                    \\underset{coDisc}{\hookleftarrow}
                    }
                    }
                    \\mathbf{B}
            %p
              (hence there is an equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi disc
                    %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi cod
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}_{disc} \simeq \mathbf{B}_{cod}
              that moreover makes the coreflector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde\Gamma
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              coincide with the reflector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi coDisc
                    %annotation{:encoding => "application/x-tex"} coDisc
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              and counit given by lemma
              %a.maruku-ref{:href => "#ReflectiveEmbeddingInternally"}
              we have that the morphisms on the left of
            #eq:FirstNaturalEquivalence.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi Disc
                    %mi Γ
                    %mi X
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi coDisc
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mi Disc
                    %mi Γ
                    %mi X
                    %mover
                      %mo →
                      %mo ≃
                    %mi coDisc
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    coDisc \tilde \Gamma (Disc \Gamma X \to X)
                    \\;
                    \=:
                    \\;
                    (coDisc \tilde \Gamma Disc \Gamma X
                    
                    \\stackrel{\simeq}{\to}
                    coDisc \tilde \Gamma X)
            #eq:SecondNaturalEquivalence.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo →
                    %mi coDisc
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi Disc
                    %mi Γ
                    %mi X
                    %mover
                      %mo →
                      %mo ≃
                    %mi Disc
                    %mi Γ
                    %mi coDisc
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Disc \Gamma (X \to coDisc \tilde \Gamma X)
                    \\;\;
                    \=:
                    \\;\;
                    (
                    Disc \Gamma X
                    \\stackrel{\simeq}{\to}
                    Disc \Gamma coDisc \tilde \Gamma
                    )
            %p
              are (natural)
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalences
              for all objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
          .proof
            %h6#proof Proof
            %p
              It is clear that if we have an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              %a.maruku-eqref{:href => "#eq:FirstNaturalEquivalence"} (1)
              and
              %a.maruku-eqref{:href => "#eq:SecondNaturalEquivalence"} (2)
              are implied. We discuss now the converse.
            %p First notice that the two embeddings always combine into an adjunction of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi disc
                    %mover
                      %munder
                        %mo ←
                        %mi Γ
                      %mover
                        %mo ↪
                        %mi Disc
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %munder
                        %mo ↩
                        %mi coDisc
                      %mover
                        %mo →
                        %mover
                          %mi Γ
                          %mo{:stretchy => "false"} ˜
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi cod
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}_{disc}
                    \\stackrel{\overset{Disc}{\hookrightarrow}}{\underset{\Gamma}{\leftarrow}}
                    \\mathbf{H}
                    \\stackrel{\overset{\tilde \Gamma}{\to}}{\underset{coDisc}{\hookleftarrow}}
                    \\mathbf{B}_{cod}
                    \\,.
            %p
              The natural equivalence
              %a.maruku-eqref{:href => "#eq:FirstNaturalEquivalence"} (1)
              applied to a codiscrete object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo :
                    %mo =
                    %mi coDisc
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X := coDisc A
              gives that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                  %annotation{:encoding => "application/x-tex"} coDisc
              of the counit of this composite adjunction is an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mi Disc
                    %mi Γ
                    %mi coDisc
                    %mi A
                    %mover
                      %mo →
                      %mo ≃
                    %mi coDisc
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mi coDisc
                    %mi A
                    %mover
                      %mo →
                      %mo ≃
                    %mi coDisc
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    coDisc \tilde \Gamma Disc \Gamma coDisc A
                    \\stackrel{\simeq}{\to}
                    coDisc \tilde \Gamma coDisc A
                    \\stackrel{\simeq}{\to}
                    coDisc A
            %p
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                  %annotation{:encoding => "application/x-tex"} coDisc
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28infinity%2C1%29-functor"} full and faithful
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mi Disc
                    %mi Γ
                    %mi coDisc
                    %mi A
                    %mover
                      %mo →
                      %mo ≃
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mi coDisc
                    %mi A
                    %mover
                      %mo →
                      %mo ≃
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde \Gamma Disc \Gamma coDisc A
                    \\stackrel{\simeq}{\to}
                    \\tilde \Gamma coDisc A
                    \\stackrel{\simeq}{\to}
                    A
            %p
              itself. Analogously,
              %a.maruku-eqref{:href => "#eq:SecondNaturalEquivalence"} (2)
              implies that the unit of the composite adjunction is an equivalence. Therefore
              %a.maruku-eqref{:href => "#eq:FirstNaturalEquivalence"} (1)
              and
              %a.maruku-eqref{:href => "#eq:SecondNaturalEquivalence"} (2)
              together imply that the adjunction itself exhibits an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi disc
                      %mo ≃
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi cod
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}_{disc} \simeq \mathbf{B}_{cod}
            %p
              Using this we then find for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              a composite natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mi X
                    %mover
                      %mo →
                      %mo ≃
                    %mi Disc
                    %mi Γ
                    %mi coDisc
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mi X
                    %mover
                      %mo →
                      %mo ≃
                    %mi Disc
                    %mi Γ
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    Disc \tilde \Gamma X
                    \\stackrel{\simeq}{\to}
                    Disc \Gamma coDisc \tilde \Gamma X
                    \\stackrel{\simeq}{\to}
                    Disc \Gamma X
            %p
              where the first morphism uses the above equivalence on the codiscrete object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \tilde \Gamma X
              and the second is a choice of natural inverse of
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:SecondNaturalEquivalence"} (2)
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              is full and faithful, this mean that we have equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Γ
                      %mo{:stretchy => "false"} ˜
                    %mi X
                    %mo ≃
                    %mi Γ
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde \Gamma X
                    \\simeq
                    \\Gamma X
            %p
              natural in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Γ
                        %mo{:stretchy => "false"} ˜
                      %mo ≃
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \tilde \Gamma \simeq \Gamma
          #AdjunctionIsoFromInternalReflectionCoreflection.num_remark
            %h6#remark_3 Remark
            %p
              In the above situation, the defining
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjunction equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ♭
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}(\mathbf{\Pi} X , A)
                    \\simeq
                    \\mathbf{H}(X, \flat A)
            %p
              exhibiting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mo ⊣
                    %mo ♭
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbf{\Pi} \dashv \flat)
              is given by the composite of natural equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo →
                      %mo ≃
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mi X
                        %mo ,
                        %msub
                          %mi coloc
                          %mi A
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mi X
                    %mo ,
                    %mo ♭
                    %mi A
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo →
                      %mo ≃
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi loc
                          %mi X
                        %mo ,
                        %mo ♭
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ♭
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}(\mathbf{\Pi}X, A)
                    \\underoverset{\simeq}{\mathbf{H}(\mathbf{\Pi}X, coloc_A)^{-1}}{\to}
                    \\mathbf{H}(\mathbf{\Pi} X, \flat A)
                    \\underoverset{\simeq}{\mathbf{H}(loc_X, \flat A)}{\to}
                    \\mathbf{H}(X, \flat A)
            %p
              from lemma
              = succeed "," do
                %a.maruku-ref{:href => "#ReflectiveEmbeddingInternally"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi} X
              as well as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \flat A
              are discrete.
          %p Using these lemmas we can now restate cohesiveness internally.
          .num_corollary
            %h6#corollary Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} Disc : \mathbf{B} \hookrightarrow \mathbf{H}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mover
                        %mover
                          %munder
                            %mo ↩
                            %mi coDisc
                          %mover
                            %mo →
                            %mi Γ
                        %mover
                          %mo ↩
                          %mi Disc
                      %mover
                        %mo →
                        %mi Π
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}
                    \\stackrel{\overset{\Pi}{\to}}{\stackrel{\overset{Disc}{\hookleftarrow}}{\stackrel{\overset{\Gamma}{\to}}{\underset{coDisc}{\hookleftarrow}}}}
                    \\mathbf{B}
            %p
              precisely if there exists for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            %ol
              %li
                %p
                  a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \to \mathbf{\Pi}(X)
                  with
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi Π
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mover
                            %mo ↪
                            %mi Disc
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                        %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}(X) \in \mathbf{B} \stackrel{Disc}{\hookrightarrow} \mathbf{H}
              %li
                %p
                  a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mo ♭
                        %mi X
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \mathbf{\flat} X \to X
                  with
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mo ♭
                          %mi X
                          %mo ∈
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mover
                            %mo ↪
                            %mi Disc
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                        %annotation{:encoding => "application/x-tex"} \mathbf{\flat} X \in \mathbf{B} \stackrel{Disc}{\hookrightarrow} \mathbf{H}
              %li
                %p
                  a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mo #
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X \to #X
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo #
                        %mi X
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mover
                          %mo ↪
                          %mi coDisc
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} # X \in \mathbf{B} \stackrel{coDisc}{\hookrightarrow} \mathbf{H}
            %p
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mover
                      %mo ↪
                      %mi Disc
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} Y \in \mathbf{B} \stackrel{Disc}{\hookrightarrow} \mathbf{H}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Y
                      %mo{:stretchy => "false"} ˜
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mover
                      %mo ↪
                      %mi coDisc
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \tilde Y \in \mathbf{B} \stackrel{coDisc}{\hookrightarrow} \mathbf{H}
              the induced morphisms
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mo ≃
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}(\mathbf{\Pi}X , Y) \stackrel{\simeq}{\to} \mathbf{H}(X,Y)
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mo ♭
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mo ≃
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}(Y, \mathbf{\flat}X) \stackrel{\simeq}{\to} \mathbf{H}(Y,X)
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mo #
                        %mi X
                        %mo ,
                        %mover
                          %mi Y
                          %mo{:stretchy => "false"} ˜
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mo ≃
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mover
                          %mi Y
                          %mo{:stretchy => "false"} ˜
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}(# X , \tilde Y) \stackrel{\simeq}{\to} \mathbf{H}(X,\tilde Y)
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo #
                        %mo{:stretchy => "false"} (
                        %mo ♭
                        %mi X
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} )
