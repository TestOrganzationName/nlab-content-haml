          %h3#arithmetic_left_shifts Arithmetic left shifts
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/binary+operation"} binary operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ≪
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi{:mathvariant => "normal"} Dec
                  %mo ×
                  %mi{:mathvariant => "normal"} Dec
                  %mo →
                  %mi{:mathvariant => "normal"} Dec
                %annotation{:encoding => "application/x-tex"} (-) \ll (-):\mathrm{Dec} \times \mathrm{Dec} \to \mathrm{Dec}
            called the
            %strong arithmetic left shift
            inductively defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≪
                  %mn 0
                  %mo ≔
                  %mi a
                %annotation{:encoding => "application/x-tex"} a \ll 0 \coloneqq a
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ≪
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ≪
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mn 0
                %annotation{:encoding => "application/x-tex"} a \ll s(b) \coloneqq (a \ll b) 0
          %p
            This binary operation is also called
            = succeed "." do
              %strong multiplication by a power of ten
          %p
            Arithmetic left shifts of digits is left distributive over addition: given
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi D
                  %annotation{:encoding => "application/x-tex"} a:D
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo :
                    %mi D
                  %annotation{:encoding => "application/x-tex"} b:D
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %mi{:mathvariant => "normal"} Dec
                  %annotation{:encoding => "application/x-tex"} c:\mathrm{Dec}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≪
                    %mi c
                    %mo +
                    %mi b
                    %mo ≪
                    %mi c
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo +
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ≪
                    %mi c
                  %annotation{:encoding => "application/x-tex"} a \ll c + b \ll c = (a + b) \ll c
          %h3#digit_decompositions Digit decompositions
          %p
            Given a decimal numeral representation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} digitsNotLast
                  %mo :
                  %mi{:mathvariant => "normal"} Dec
                  %mo →
                  %mi{:mathvariant => "normal"} Dec
                %annotation{:encoding => "application/x-tex"} \mathrm{digitsNotLast}:\mathrm{Dec} \to \mathrm{Dec}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} lastDigit
                  %mo :
                  %mi{:mathvariant => "normal"} Dec
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \mathrm{lastDigit}:\mathrm{Dec} \to D
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo =
                  %mi{:mathvariant => "normal"} digitsNotLast
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} lastDigit
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} b = \mathrm{digitsNotLast}(b) \mathrm{lastDigit}(b)
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} numDigits
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} digitsNotLast
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{numDigits}(b) = s(\mathrm{digitsNotLast}(b))
          %h3#addition_of_general_decimal_representations Addition of general decimal representations
          %p
            Given a decimal numeral representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} lastDigit
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathrm{lastDigit}(b) = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            and a digit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo +
                  %mi d
                  %mo ≔
                  %mi{:mathvariant => "normal"} digitsNotLast
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mi d
                %annotation{:encoding => "application/x-tex"} b + d \coloneqq \mathrm{digitsNotLast}(b) d
          %p
            Given two decimal numeral representations of the natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 0
                  %msub
                    %mi d
                    %mn 0
                %annotation{:encoding => "application/x-tex"} a_0 d_0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                  %msub
                    %mi d
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a_1 d_1
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 0
                %annotation{:encoding => "application/x-tex"} d_0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 1
                %annotation{:encoding => "application/x-tex"} d_1
            being digits and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 0
                %annotation{:encoding => "application/x-tex"} a_0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a_1
            being decimal numeral representations, addition is inductively defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 0
                  %msub
                    %mi d
                    %mn 0
                  %mo +
                  %msub
                    %mi a
                    %mn 1
                  %msub
                    %mi d
                    %mn 1
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 0
                  %mo +
                  %msub
                    %mi a
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mn 0
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mn 0
                  %mo +
                  %msub
                    %mi d
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a_0 d_0 + a_1 d_1 \coloneqq (a_0 + a_1) 0 + (d_0 + d_1)
          %p
            The decimal numeral representation of the natural numbers is a
            %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+object"} commutative monoid object
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p Addition is left unital:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo +
                  %mi a
                  %mi d
                  %mo =
                  %mn 0
                  %mo +
                  %mi a
                  %mn 0
                  %mo +
                  %mi d
                  %mo =
                  %mi a
                  %mn 0
                  %mo +
                  %mi d
                  %mo =
                  %mi a
                  %mi d
                %annotation{:encoding => "application/x-tex"} 0 + a d = 0 + a 0 + d = a 0 + d = a d
          %p Addition is right unital:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi d
                  %mo +
                  %mn 0
                  %mo =
                  %mi a
                  %mn 0
                  %mo +
                  %mi d
                  %mo +
                  %mn 0
                  %mo =
                  %mi a
                  %mn 0
                  %mo +
                  %mi d
                  %mo =
                  %mi a
                  %mi d
                %annotation{:encoding => "application/x-tex"} a d + 0 = a 0 + d + 0 = a 0 + d = a d
