          %h2#kinds_of_filters Kinds of filters
          %p
            A filter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is
            %strong proper
            if there exists an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∉
                    %mi F
                  %annotation{:encoding => "application/x-tex"} A \notin F
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                    %mo ∉
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \bot \notin F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is proper iff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ∉
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \empty \notin F
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            of subsets of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is
            %strong proper
            if every element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi F
                %annotation{:encoding => "application/x-tex"} A \in F
            for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (in particular if
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \empty \in F
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/improper+filter"} improper filter
            %a.existingWikiWord{:href => "/nlab/show/proper+subset"} proper subset
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/improper+subset"} improper subset
          %p
            Filters are often assumed to be proper by default in analysis and topology, where proper filters correspond to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nets"} nets
          %p
            If the complement of a filter is an ideal, then we say that the filter is
            %strong prime
            (and equivalently that the ideal is prime). A prime filter is necessarily proper; a proper filter in a lattice is prime iff, whenever
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∨
                    %mi B
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} A \vee B \in F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi F
                %annotation{:encoding => "application/x-tex"} A \in F
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} B \in F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi L
                  %mo →
                  %mi TV
                %annotation{:encoding => "application/x-tex"} F: L \to TV
            must be a homomorphism of lattices. The generalisation to arbitrary joins gives a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/completely+prime+filter"} completely prime filter
          %p
            A filter is an
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/ultrafilter"} ultrafilter
            = succeed "," do
              %strong maximal filter
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean lattice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi L
                  %mo →
                  %mi TV
                %annotation{:encoding => "application/x-tex"} F: L \to TV
            is a homomorphism of Boolean lattices.
          %p
            Given an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %strong principal ultrafilter
            (of subsets of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            consists of every subset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            belongs. A principal ultrafilter is also called a
            = succeed ";" do
              %strong fixed ultrafilter
            %strong fixed
            if its
            %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is an filter whose meet (of all elements) exists and is a
            %a.existingWikiWord{:href => "/nlab/show/bottom"} bottom
            element (the
            %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
            for a filter of subsets), then we call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            = succeed "." do
              %strong free
          %p
            Free ultrafilters on Boolean algebras are important in
            %a.existingWikiWord{:href => "/nlab/show/nonstandard+analysis"} nonstandard analysis
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+theory"} model theory
          %h2#filterbases Filterbases
          %p
            A subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            of a lattice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is a
            %strong
              filter
              %a.existingWikiWord{:href => "/nlab/show/base"} base
            if it becomes a filter when closed under axiom (1). Equivalently, a filterbase is any downward-directed subset. Any subset of a meet-semilattice may be used as a filter
            = succeed ";" do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/subbase"} subbase
          %p
            A filterbase
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            of sets is proper (that is, it generates a proper filter of sets) iff each set in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is inhabited. A filter subbase of sets is proper iff it satisfies the finite intersection property (well known in topology from a criterion for
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/compact+spaces"} compact spaces
          %h2#the_poset_of_filters_and_pushforwards The poset of filters and push-forwards
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mi L
                    %mn 1
                  %mo →
                  %msub
                    %mi L
                    %mn 2
                %annotation{:encoding => "application/x-tex"} f:L_1\to L_2
            is a
            %a.existingWikiWord{:href => "/nlab/show/monotone+map"} monotone map
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ⊆
                  %msub
                    %mi L
                    %mn 1
                %annotation{:encoding => "application/x-tex"} F\subseteq L_1
            a filter, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi A
                  %mo ∈
                  %mi F
                  %mo{:stretchy => "false"} }
                  %mo ⊆
                  %msub
                    %mi L
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \lbrace f(A) \mid A\in F\rbrace\subseteq L_2
            is a filter base. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_\ast(F)
            be the filter generated by this filter base. The set of filters
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Filters
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Filters(L)
            is a poset in its own right w.r.t. inclusion and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi Filters
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi L
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo ⊆
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Filters
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi L
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo ⊆
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_\ast: (Filters(L_1),\subseteq)\to(Filters(L_2),\subseteq)
            is monotone. Therefore
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo ↦
                  %mi Filters
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi f
                  %mo ↦
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} L\mapsto Filters(L), f\mapsto f_\ast
            is a functor from the category of posets to itself.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            satisfies stronger properties than mere monotony, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f_\ast
            will be better behaved as well:
          %ul
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                is a meet-
                %a.existingWikiWord{:href => "/nlab/show/semilattice"}> semilattice
                , then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Filters
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Filters(L)
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Moore+collection"} Moore collection
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msub
                          %mi F
                          %mi i
                        %mo =
                        %mrow
                          %mo ↑
                          %mrow
                            %mo {
                            %msub
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                              %mrow
                                %mi j
                                %mo ∈
                                %mi J
                            %msub
                              %mi A
                              %mi j
                            %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                            %mi J
                            %mo ⊆
                            %mi I
                            %mtext finite
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi A
                              %mi j
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi j
                                %mo ∈
                                %mi J
                            %mo ∈
                            %msub
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi j
                                %mo ∈
                                %mi J
                            %msub
                              %mi F
                              %mi j
                            %mo }
                      %annotation{:encoding => "application/x-tex"} \bigvee_{i\in I} F_i = \left\uparrow\left\{ \bigwedge_{j\in J} A_j \mid J\subseteq I\text{ finite}, (A_j)_{j\in J}\in \prod_{j\in J}F_j \right\}\right.
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msub
                          %mi F
                          %mi i
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msub
                          %mi F
                          %mi i
                      %annotation{:encoding => "application/x-tex"} \bigwedge_{i\in I} F_i = \bigcap_{i\in I}F_i
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %msub
                        %mi L
                        %mn 1
                      %mo →
                      %msub
                        %mi L
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f:L_1\to L_2
                respects finite meets, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f_\ast
                respects all joins. If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is merely monotone, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f_\ast
                respects all filtered joins.
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                has all
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi I
                        %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} |I|
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Filters
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Filters(L)
                has
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi I
                        %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} |I|
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msub
                          %mi F
                          %mi i
                        %mo =
                        %mrow
                          %mo {
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi A
                            %mi i
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi A
                            %mi i
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %mo ∈
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi F
                            %mi i
                          %mo }
                      %annotation{:encoding => "application/x-tex"} \bigwedge_{i\in I} F_i = \left\{ \bigvee_{i\in I} A_i \mid (A_i)_{i\in I}\in \prod_{i\in I}F_i \right\}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                respects
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi I
                        %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} |I|
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f_\ast
                respects
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi I
                        %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} |I|
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/distributive+lattice"} distributive lattice
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Filters
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Filters(L)
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/frame"} frame
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ∧
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi G
                        %mi i
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo ∧
                      %msub
                        %mi G
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F \wedge \bigvee_{i\in I} G_i = \bigvee_{i\in I} (F\wedge G_i)
                holds. The other distributive law also holds for finite meets:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ∨
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi G
                        %mi i
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo ∨
                      %msub
                        %mi G
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F \vee \bigwedge_{i\in I} G_i = \bigwedge_{i\in I} (F\vee G_i)
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                is finite. It holds more generally if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                has all
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi I
                        %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} |I|
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi I
                        %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} |I|
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∧
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi B
                        %mi i
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ∧
                      %msub
                        %mi B
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A\wedge \bigvee_{i\in I} B_i = \bigvee_{i\in I} (A\wedge B_i)
                holds in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is closed under
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi I
                        %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} |I|
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                is a complete join-semilattice, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Filters
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Filters(L)
                is a complete lattice. If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                respects all joins, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f_\ast
                respects all meets. In this case
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f_\ast
                has a
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo :
                      %mi Filters
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi L
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Filters
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi L
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^\ast: Filters(L_2)\to Filters(L_1)
                which is given by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %mo{:stretchy => "false"} {
                      %mi F
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo ⊆
                      %msub
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} f^\ast(G) = \bigwedge \lbrace F | G\subseteq f_\ast(F)\rbrace
                so that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %mi F
                      %mo ⇔
                      %mi G
                      %mo ⊆
                      %msub
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^\ast(G)\subseteq F \iff G\subseteq f_\ast(F)
                holds. As a left adjoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^\ast
                respects all joins.
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f,g)
                is an adjoint pair between
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} L_1
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} L_2
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo :
                        %msub
                          %mi L
                          %mn 1
                        %mo →
                        %msub
                          %mi L
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} : L_1 \to L_2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %msub
                        %mi L
                        %mn 2
                      %mo →
                      %msub
                        %mi L
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} g: L_2\to L_1
                monotone and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi y
                      %mo ⇔
                      %mi x
                      %mo ≤
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(x) \leq y \iff x\leq g(y)
                for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %msub
                          %mi L
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} x\in L_1
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %msub
                          %mi L
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} y\in L_2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mo *
                      %mo ,
                      %msub
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (g_\ast,f_\ast)
                is an adjoint pair between
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Filters
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi L
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Filters(L_2)
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Filters
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi L
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Filters(L_1)
          %h3#examples Examples
          %ul
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⊆
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi L
                      %mn 2
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⊆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L_1=(P(X),\subseteq), L_2=(P(Y),\subseteq)
              for some sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X,Y
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \alpha:X\to Y
              is any map, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi L
                      %mn 1
                    %mo →
                    %msub
                      %mi L
                      %mn 2
                    %mo ,
                    %mi A
                    %mo ↦
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:L_1\to L_2, A\mapsto \alpha(A)
              is monotone and respects arbitrary joins. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo :
                    %mi Filters
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Filters
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_\ast: Filters(L_1)\to Filters(L_2)
              respects arbitrary meets. Note that even though
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 1
                    %mo ,
                    %msub
                      %mi L
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} L_1, L_2
              are meet-semilattices,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              does not respect meets in general, because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ∩
                    %mi A
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha(A\cap A')\subseteq \alpha(A)\cap\alpha(A')
              holds, but equality is equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              being injective.
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is the left adjoint of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %msub
                        %mi L
                        %mn 2
                      %mo →
                      %msub
                        %mi L
                        %mn 1
                      %mo ,
                      %mi B
                      %mo ↦
                      %msup
                        %mi α
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g: L_2\to L_1, B\mapsto \alpha^{-1}(B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_\ast
              is the right adjoint of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo =
                    %msub
                      %mi g
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast=g_\ast
              which is given by taking preimage filters:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %msup
                        %mi α
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %mi B
                      %mo ∈
                      %mi G
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} g_\ast(G) = \langle \alpha^{-1}(B) | B\in G\rangle
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              has not only the left adjoint
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo :
                      %msub
                        %mi L
                        %mn 1
                      %mo →
                      %msub
                        %mi L
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} h:L_1\to L_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A\subseteq X
              is called
              = succeed "-saturated" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi α
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi A
