          %ul
            %li
              The
              %a.existingWikiWord{:href => "/nlab/show/counit"} counit
              has as components morphisms of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %msup
                      %mi C
                      %mo *
                    %msup
                      %mi Alg
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \sigma C^*Alg^{op}
              in the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϵ
                        %mi op
                      %mo :
                      %msup
                        %mi ℒ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Sp
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \epsilon^{op}:\mathcal{L}^\infty(Sp(A))\to A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} \sigma C^*Alg
              of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo :
                      %mi A
                      %mo →
                      %msup
                        %mi ℒ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Sp
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \epsilon:A\to \mathcal{L}^\infty(Sp(A))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∈
                    %mi A
