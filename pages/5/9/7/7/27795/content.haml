            We equip
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sp(A)
            with the coarsest σ-algebra making the maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϵ
                    %mi h
                %annotation{:encoding => "application/x-tex"} \epsilon_h
            measurable for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} h\in A
            (cf. the σ-algebra of the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Giry+monad"} Giry monad
          %p
            Given a σ-C*-homomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \phi:A\to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ↦
                  %mi p
                  %mo ∘
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} p\mapsto p\circ\phi
            gives a function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mo *
                    %mo :
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi^*:Sp(B)\to Sp(A)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo :
                    %mi σ
                    %msup
                      %mi C
                      %mo *
                    %msup
                      %mi Alg
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                    %mo →
                    %mi Meas
                  %annotation{:encoding => "application/x-tex"} Sp:\sigma C^*Alg^\op\to Meas
          %h3#the_adjunction The adjunction
          %p
            The functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℒ
                    %mn ∞
                  %mo :
                  %msup
                    %mi Meas
                    %mi op
                  %mo →
                  %mi σ
                  %msup
                    %mi C
                    %mo *
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} \mathcal{L}^\infty:Meas^{op}\to \sigma C^*Alg
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sp
                  %mo :
                  %mi σ
                  %msup
                    %mi C
                    %mo *
                  %msup
                    %mi Alg
                    %mi op
                  %mo →
                  %mi Meas
                %annotation{:encoding => "application/x-tex"} Sp:\sigma C^*Alg^{op}\to Meas
            form a (contravariant)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/idempotent+adjunction"} idempotent adjunction
          %ul
            %li
              The
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              has as components measurable functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %mi X
