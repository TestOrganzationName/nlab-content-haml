              = succeed "," do
                %a{:href => "Dp-Dpplus2-brane+bound+state#HLPY08"} HLPY 08
              = succeed ")" do
                %a{:href => "Dp-Dpplus2-brane+bound+state#GZZ09"} GZZ 09
            %p
              More explicitly, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} y \in (0,\infty ]
              the transversal distance along the stack of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              = succeed "-branes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} D
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \mathrm{D}p
              = succeed "-brane," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} D
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{D}(p+2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi i
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mphantom
                      %mi AAA
                    %mi i
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mn 3
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    X^i \in C^\infty\big( (0,\infty], \mathfrak{u}(N) \big)
                    \\phantom{AAA}
                    i \in \{1,2,3\}
            %p
              the three scalar fields on the worldvolume, the
              %a.existingWikiWord{:href => "/nlab/show/boundary+condition"} boundary condition
              is:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi y
                    %msup
                      %mi X
                      %mn 3
                    %mo +
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi X
                      %mn 1
                    %mo ,
                    %msup
                      %mi X
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi y
                    %msup
                      %mi X
                      %mn 1
                    %mo +
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi X
                      %mn 2
                    %mo ,
                    %msup
                      %mi X
                      %mn 3
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi y
                    %msup
                      %mi X
                      %mn 2
                    %mo +
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi X
                      %mn 3
                    %mo ,
                    %msup
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{d}{d y}
                    X^3
                    +
                    [X^1, X^2]
                    \\;=\;
                    0
                    \\,,
                    \\;\;\;
                    \\frac{d}{d y}
                    X^1
                    +
                    [X^2, X^3]
                    \\;=\;
                    0
                    \\,,
                    \\;\;\;
                    \\frac{d}{d y}
                    X^2
                    +
                    [X^3, X^1]
                    \\;=\;
                    0
            %p
              as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} y \to 0
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Nahm%27s+equations"} Nahm's equations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mn 1
                      %mi y
                    %msup
                      %mi ρ
                      %mi i
                    %mo +
                    %mtext non-singular
                  %annotation{:encoding => "application/x-tex"}
                    X^i(y) = \frac{1}{y} \rho^i + \text{non-singular}
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔰𝔲
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\rho \;\colon\; \mathfrak{su}(2) \longrightarrow \mathfrak{u}(N)
            %p
              is a Lie algebra homomorphism from
              %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
              to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/unitary+Lie+algebra"} unitary Lie algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ρ
                      %mi i
                    %mo ≔
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi σ
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\rho^i \coloneqq \rho(\sigma^i)
            %p
              is its complex-linear combination of values on the canonical
              %a.existingWikiWord{:href => "/nlab/show/Pauli+matrix"} Pauli matrix
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/linear+basis"} basis
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/FuzzyFunnelFromChordDiagram.jpg", :width => "420"}/
            %p#FuzzyFunnelEmerges
              Equivalently.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              is an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
              %a.existingWikiWord{:href => "/nlab/show/reducible+representation"} reducible
              as a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of
              %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mn 5
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{N}^{(M5)}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi N
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mn 5
                          %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} N^{(M5)} \in \mathbb{N}
            #eq:rhoAsADirectSumOfsu2Irreps.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mi i
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi N
                      %mi i
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi N
                      %mi i
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mn 5
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho
                    \\;\simeq\;
                    \\underset{
                    i
                    }{\bigoplus}
                    \\big(
                    N_i^{(M2)}
                    \\cdot
                    \\mathbf{N}_i^{(M5)}
                    \\big)
                    \\,.
            %p
              (Here the notation follows the discussion at
              = succeed "," do
                %em
                  %a{:href => "BMN+matrix+model#M2M5BraneBoundStatesInTheBMNMatrixModel"} M2/M5-brane bound states in the BMN model
              %a.existingWikiWord{:href => "/nlab/show/duality+between+M-theory+and+type+IIA+string+theory"} M-theory lift
              of the present situation).
            %p
              Now each
              %a.existingWikiWord{:href => "/nlab/show/irrep"} irrep
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi N
                      %mi i
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mn 5
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{N}_i^{(M5)}
              may be interpreted as a
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
              of
              %a.existingWikiWord{:href => "/nlab/show/radius"} radius
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∝
                      %msqrt
                        %mrow
                          %msup
                            %mrow
                              %mo (
                              %msubsup
                                %mi N
                                %mi i
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi M
                                  %mn 5
                                  %mo{:stretchy => "false"} )
                              %mo )
                            %mn 2
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \propto \sqrt{ \left( N_i^{(M5)}\right)^2 - 1 }
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+funnel"} fuzzy funnel
              at given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo =
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} y = \epsilon
              %a.maruku-eqref{:href => "#eq:rhoAsADirectSumOfsu2Irreps"} (1)
              represents a system of concentric
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-spheres"} fuzzy 2-spheres
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fuzzy+funnels"} fuzzy funnels
            %blockquote
              %p
                graphics from
                %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
            %p
              %br/
            %p
              Moreover, since the
              %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
              of
              %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
              is the
              %a.existingWikiWord{:href => "/nlab/show/sl%282%29"} complex special linear Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔩
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{sl}(2,\mathbb{C})
              (
              %a{:href => "su2#Complexification"}> here
              ) the solutions to the boundary conditions are also identified with
              %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔩
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{sl}(2,\mathbb{C})
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representations"} Lie algebra representations
            #eq:RhoAsAnsl2Rep.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔰𝔩
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mi Rep
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho \;\in\; \mathfrak{sl}(2,\mathbb{C}) Rep
                    \\,.
            %p
              %br/
            %p This is what many authors state, but it is not yet the full picture:
            %p#ParallelCPField
              Also the worldvolume
              %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
              component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              participates in the brane intersection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    A \in C^\infty\big( (0,\infty], \mathfrak{u}(N) \big)
            %p its boundary condition being that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %msup
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mphantom
                      %mi AAAA
                    %mtext for all
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mn 3
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    [A, X^i] \;=\; 0
                    \\phantom{AAAA}
                    \\text{for all}\; i \in \{1,2,3\}
            %p
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} y \to 0
              (
              %a{:href => "Dp-Dpplus2-brane+bound+state#ConstableMyers99"}> Constable-Myers 99, Section 3.3
              ,
              = succeed "," do
                %a{:href => "Dp-Dpplus2-brane+bound+state#ThomasWard06"} Thomas-Ward 06, p. 16
              = succeed ")" do
                %a{:href => "Dp-Dpplus2-brane+bound+state#GaiottoWitten08"} Gaiotto-Witten 08, Section 3.1.1
            %p
              Together with
              %a.maruku-eqref{:href => "#eq:RhoAsAnsl2Rep"} (2)
              this means that the quadruple of fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mn 1
                    %mo ,
                    %msup
                      %mi X
                      %mn 2
                    %mo ,
                    %msup
                      %mi X
                      %mn 3
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X^1,X^2,X^3,A)
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
              of the
              %a.existingWikiWord{:href => "/nlab/show/general+linear+Lie+algebra"} general linear Lie algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤𝔩
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mi 𝔰𝔩
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mi ℂ
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %msup
                          %mi X
                          %mn 1
                        %mo ,
                        %msup
                          %mi X
                          %mn 2
                        %mo ,
                        %msup
                          %mi X
                          %mn 3
                        %mo{:stretchy => "false"} ⟩
                    %mo ⊕
                    %munder
                      %munder
                        %mi ℂ
                        %mo ⏟
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mi A
                        %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{gl}(2,\mathbb{C})
                    \\;\simeq\;
                    \\underset{
                    \\langle
                    X^1, X^2, X^3
                    \\rangle
                    }{
                    \\underbrace{
                    \\mathfrak{sl}(2,\mathbb{C})
                    }
                    }
                    \\oplus
                    \\underset{
                    \\langle A \rangle
                    }{
                    \\underbrace{
                    \\mathbb{C}
                    }
                    }
            %p
              This makes little difference as far as bare
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representations"} Lie algebra representations
              are concerned, but it does make a crucial difference when these are regarded as
              %a.existingWikiWord{:href => "/nlab/show/metric+Lie+representations"} metric Lie representations
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+Lie+algebras"} metric Lie algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤𝔩
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{gl}(2,\mathbb{C})
              admits further invariant metrics…
            %p
              %br/
          %h3#brane_intersections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} D
                  %mn 6
                  %mo ⊥
                  %mi{:mathvariant => "normal"} D
                  %mn 8
                %annotation{:encoding => "application/x-tex"} \mathrm{D}6 \perp \mathrm{D}8
            \-brane intersections
          %p
            Specifically for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %mn 6
                  %annotation{:encoding => "application/x-tex"} p = 6
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/D6-D8+brane+intersections"} D6-D8 brane intersections
            %a.existingWikiWord{:href => "/nlab/show/Witten-Sakai-Sugimoto+model"} Witten-Sakai-Sugimoto model
            %a.existingWikiWord{:href => "/nlab/show/geometric+engineering+of+QFT"} geometrically engineering
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+chromodynamics"} quantum chromodynamics
            %a.existingWikiWord{:href => "/nlab/show/geometric+engineering+of+QFT"} geometric engineering
            of the
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+monopoles"} Yang-Mills monopoles
            in actual
            %a.existingWikiWord{:href => "/nlab/show/QCD"} QCD
            (
            %a{:href => "#HLPY08"}> HLPY 08, p. 16
            ).
          %center
            %img{:src => "https://ncatlab.org/nlab/files/WSSBraneConfigurationEngineeringQCDII.jpg", :width => "740"}/
          %div{:style => "float:right;margin:0 10px 10px 0;"}
            %img{:src => "https://ncatlab.org/nlab/files/D8D6NS5.jpg", :width => "350"}/
          %p Here we are showing
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/color+charge"} color
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/D4-branes"} D4-branes
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/flavour+%28particle+physics%29"} flavor
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/D8-branes"} D8-branes
              %p with
              %ol
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/5d+Chern-Simons+theory"} 5d Chern-Simons theory
                    on their
                    %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
                %li
                  %p
                    the corresponding
                    %a.existingWikiWord{:href => "/nlab/show/4d+WZW+model"} 4d WZW model
                    on the boundary
              %p
                both exhibiting the
                %a.existingWikiWord{:href => "/nlab/show/meson+fields"} meson fields
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/baryon"} baryon
                %a.existingWikiWord{:href => "/nlab/show/D4-branes"} D4-branes
              %p
                (see below at
                = succeed ")" do
                  %em
                    %a{:href => "Witten-Sakai-Sugimoto+model#Baryons"} WSS – Baryons
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+monopole"} Yang-Mills monopole
                %a.existingWikiWord{:href => "/nlab/show/D6-branes"} D6-branes
              %p
                (see at
                = succeed ")" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/D6-D8-brane+bound+state"} D6-D8-brane bound state
            %li
              %p
                the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/NS5-branes"} NS5-branes
          %h3#the_srule The s-rule
          %p
            What has come to be known as the
            %em
              %a.existingWikiWord{:href => "/nlab/show/s-rule"} s-rule
            is the conjecture that the configuration of
            %a.existingWikiWord{:href => "/nlab/show/Dp-D%28p%2B2%29-brane+bound+states"} Dp-D(p+2)-brane bound states
            with the
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} Dp-branes
            stretching from the
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D(p+2)-branes
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/NS5-branes"} NS5-branes
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetric
            only if at most one D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            \-brane ends on any one D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo +
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p+2)
            \-brane.
          %p
            For
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D4-D6+brane+intersections"} D4-D6 brane intersections
          %center
            %img{:src => "https://ncatlab.org/nlab/files/D4D6BraneInsersectionSubjectToSRule.jpg", :width => "700"}/
          %blockquote
            %p
              graphics grabbed from
              %a{:href => "D4-D6-brane+intersection#Fazzi17"} Fazzi 17
          %p
            For
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D6-D8+brane+intersections"} D6-D8 brane intersections
          %center
            %img{:src => "https://ncatlab.org/nlab/files/D6D8BraneIntersectionsSubjetToSRule.jpg", :width => "600"}/
          %blockquote
            %p
              graphics grabbed from
              %a{:href => "D6-D8-brane+intersection#Fazzi17"} Fazzi 17
          %p
            %img{:src => "https://ncatlab.org/nlab/files/GaiottoNS5D6.jpg", :width => "600"}/
          %blockquote
            %p
              graphics grabbed from
              %a{:href => "D6-D8-brane+intersection#GaiottoTomasiello14"} Gaiotto-Tomasiello 14
          %p
            %br/
          %p
            %br/
          %h3#SingleTraceObservablesAsWeightSystemsOnChordDiagrams
            Single trace observables as
            = succeed "-weight" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔲
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{su}(2)
          %p
            We discuss how the
            %a.existingWikiWord{:href => "/nlab/show/single+trace+observables"} single trace observables
            on the
            = succeed "-sections" do
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
            %a.existingWikiWord{:href => "/nlab/show/Dp-D%28p%2B2%29+brane+intersection"} Dp-D(p+2) brane intersection
            %a.existingWikiWord{:href => "/nlab/show/fuzzy+funnels"} fuzzy funnels
            are given by
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+systems"} Lie algebra weight systems
            on
            %a.existingWikiWord{:href => "/nlab/show/chord+diagrams"} chord diagrams
            (following
            = succeed "," do
              %a{:href => "#RamgoolamSpenceThomas04"} Ramgoolam-Spence-Thomas 04
            = succeed "," do
              %a{:href => "#McNamaraPapageorgakis05"} McNamara-Papageorgakis 05
            %a{:href => "#McNamara06"} McNamara 06, Section 4
            for review).
          %p
            For more see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/weight+systems+on+chord+diagrams+in+physics"} weight systems on chord diagrams in physics
          %div{:style => "float:right;margin:0 10px 10px 0;"}
            %img{:src => "https://ncatlab.org/nlab/files/WeightSystemsAsShapeObservabesOnFuzzySphere.jpg", :width => "400"}/
          %blockquote
            %p
              graphics from
              %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
          %p
            %br/
          %p
            While in the commutative
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/large+N+limit"} large N limit
            %a.existingWikiWord{:href => "/nlab/show/radius"} radius
            function on the
            %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
            are equal
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mrow
                      %mi N
                      %mo →
                      %mn ∞
                  %msub
                    %mo ∫
                    %mrow
                      %msubsup
                        %mi S
                        %mi N
                        %mn 2
                  %msup
                    %mi R
                    %mrow
                      %mn 2
                      %mi k
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 4
                  %mi π
                  %mspace{:width => "thinmathspace"}
                  %mo ;
                %annotation{:encoding => "application/x-tex"}
                  \\underset{N\to \infty}{\lim}
                  \\int_{S^2_N} R^{2 k}
                  \\;=\;
                  4 \pi
                  \\,;
          %p
            for
            %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            there is an ordering ambiguity: In fact, the number of functions on the
            %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
            at
            %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            that all go to the same function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mrow
                      %mn 2
                      %mi k
                %annotation{:encoding => "application/x-tex"} R^{2k}
            in the
            %a.existingWikiWord{:href => "/nlab/show/large+N+limit"} large N limit
            grows rapidly with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            At
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k = 1
            there is the single radius observable
            %a.maruku-eqref{:href => "#eq:RadiusOfFuzzy2Sphere"} (?)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %msubsup
                        %mi S
                        %mi N
                        %mn 2
                  %msup
                    %mi R
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ∫
                    %mrow
                      %msubsup
                        %mi S
                        %mi N
                        %mn 2
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi X
                    %mi i
                  %mo ⋅
                  %msub
                    %mi X
                    %mi i
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 4
                  %mi π
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mi N
                      %msqrt
                        %mrow
                          %msup
                            %mi N
                            %mn 2
                          %mo −
                          %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\int_{S^2_N} R^2
                  \\;=\;
                  \\int_{S^2_N}
                  \\underset{i}{\sum} X_i \cdot X_i
                  \\;=\;
                  4 \pi \tfrac{ N }{ \sqrt{N^2 -1} }
          %p
            At
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} k = 2
            there are, under the integral
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:FuzzyS2Integration"} (?)
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %msubsup
                            %mi S
                            %mi N
                            %mn 2
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %msub
                        %mi X
                        %mi i
                      %msub
                        %mi X
                        %mi i
                      %msub
                        %mi X
                        %mi j
                      %msub
                        %mi X
                        %mi j
                    %annotation{:encoding => "application/x-tex"} \int_{S^2_N} \underset{i,j}{\sum} X_i X_i X_j X_j
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %msubsup
                            %mi S
                            %mi N
                            %mn 2
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %msub
                        %mi X
                        %mi i
                      %msub
                        %mi X
                        %mi j
                      %msub
                        %mi X
                        %mi j
                      %msub
                        %mi X
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \int_{S^2_N} \underset{i,j}{\sum} X_i X_j X_j X_i
          %p
            (Here we are using that under the integral/trace, a
            %a.existingWikiWord{:href => "/nlab/show/cyclic+permutation"} cyclic permutation
            of the factors in the integrand does not change the result).
          %p
            Similarly for higher
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/combinatorics"} combinatorics
            that appears here is familiar in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/knot+theory"} knot theory
          %p
            Every ordering of operators, up to cyclic permutation, in the
            %a.existingWikiWord{:href => "/nlab/show/single+trace+observable"} single trace observable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tr
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi R
                    %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                %annotation{:encoding => "application/x-tex"} Tr(R^2)^n
            is encoded in a
            %a.existingWikiWord{:href => "/nlab/show/chord+diagram"} chord diagram
            and the value of the corresponding
            %a.existingWikiWord{:href => "/nlab/show/single+trace+observable"} single trace observable
            is the value of the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+system"} Lie algebra weight system
            on this chord diagram.
          %h3#parallel_intersection Parallel intersection
          %p
            Parallel: dissolves (
            %a{:href => "#GavaNarainSarmadi97"}> Gava-Narain-Sarmadi 97
            )
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+funnel"} fuzzy funnel
          %p
            %br/
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/brane+intersections"}> brane intersections
                \/
                %a.existingWikiWord{:href => "/nlab/show/bound+states"}> bound states
                \/
