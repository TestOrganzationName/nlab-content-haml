          %h2#idea Idea
          %h3#in_mathematics In mathematics
          %p
            Consider a complex projective
            %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifold"} Calabi-Yau 3-manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with volume form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi vol
                      %mi X
                  %annotation{:encoding => "application/x-tex"} vol_X
            %a.existingWikiWord{:href => "/nlab/show/Casson+invariant"} Casson invariant
            which may be defined using the holomorphic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons functional
          %p
            For a holomorphic connection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi A
                      %mn 0
                    %mo +
                    %mi α
                  %annotation{:encoding => "application/x-tex"} A = A_0 +\alpha
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CS
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mi X
                  %mi Tr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mover
                      %mo ∇
                      %mo{:stretchy => "false"} ¯
                    %mrow
                      %msub
                        %mi A
                        %mn 0
                  %mi α
                  %mo ∧
                  %mi α
                  %mo +
                  %mfrac
                    %mn 1
                    %mn 2
                  %mi α
                  %mo ∧
                  %mi α
                  %mo ∧
                  %mi α
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi vol
                    %mi X
                %annotation{:encoding => "application/x-tex"} CS(A) = \int_X Tr(\bar\nabla_{A_0} \alpha\wedge\alpha +\frac{1}{2}\alpha\wedge\alpha\wedge\alpha) vol_X
          %p
            Its critical points are holomorphically flat connections:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mi A
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} F^{0,2}_A = 0
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/BPS+state"} BPS state
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"} Kähler form
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/wall+crossing"} wall crossing
          %p
            Under the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mirror+symmetry"} mirror symmetry
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+submanifold"} Lagrangian submanifold
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/special+Lagrangian+submanifold"} special Lagrangian submanifold
          %h3#in_string_theory In string theory
          %p
