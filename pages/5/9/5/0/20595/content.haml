              %a.existingWikiWord{:href => "/nlab/show/Brendan+Fong"}> Brendan Fong
              ,
              = succeed "," do
                %em Decorated Cospans
              = succeed ")." do
                %a{:href => "http://arxiv.org/abs/1502.00872"} arXiv:1502.00872
