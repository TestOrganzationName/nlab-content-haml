          %title Decorated cospan
          %h1#decorated_cospan Decorated cospan
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %ul
                %li
                  %a{:href => "#categories_of_cospans"} Categories of cospans
                %li
                  %a{:href => "#categories_of_decorated_cospans"} Categories of decorated cospans
                %li
                  %a{:href => "#the_monoidal_and_hypergraph_structures"} The monoidal and hypergraph structures
