                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi p
                    %mo −
                    %mi{:mathvariant => "normal"} ramp
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo −
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \min(p,q) \coloneqq p - \mathrm{ramp}(p - q)
            %p
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 10
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{Z}[1/10]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 10
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} q \in \mathbb{Z}[1/10]
          .num_defn
            %h6#definition_21 Definition
            %p
              %strong (Maximum)
            %p
              There exists a binary operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi max
                    %mo :
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \max:\mathbb{Z}[1/10] \times \mathbb{Z}[1/10] \to \mathbb{Z}[1/10]
              called
              %strong maximum
              defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi p
                    %mo +
                    %mi{:mathvariant => "normal"} ramp
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo −
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} max(p, q) \coloneqq p + \mathrm{ramp}(q - p)
            %p
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 10
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{Z}[1/10]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 10
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} q \in \mathbb{Z}[1/10]
          .num_defn
            %h6#definition_22 Definition
            %p
              %strong (Absolute value)
            %p
              There exists a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo :
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \vert(-)\vert:\mathbb{Z}[1/10] \to \mathbb{Z}[1/10]
              called
              %strong absolute value
              and defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi p
                    %mo{:stretchy => "false"} |
                    %mo ≔
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \vert p \vert \coloneqq max(p, -p)
            %p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 10
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{Z}[1/10]
          .num_prop
            %h6#proposition_28 Proposition
            %p
              %strong (total order)
            %p
              The decimal fractions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mn 0
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mn 1
                    %mo ,
                    %mo ⋅
                    %mo ,
                    %mo &lt;
                    %mo ,
                    %mo &gt;
                    %mo ,
                    %mo ≤
                    %mo ,
                    %mo ≥
                    %mo ,
                    %mi min
                    %mo ,
                    %mi max
                    %mo ,
                    %mi{:mathvariant => "normal"} ramp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{Z}[1/10], 0, +, -, 1, \cdot, \lt, \gt, \leq, \geq, \min, \max, \mathrm{ramp})
              are a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/totally+ordered+ring"} totally ordered ring
          %h3#scientific_notation Scientific notation
          .num_prop
            %h6#proposition_29 Proposition
            %p
              %strong (scientific notation)
            %p
              For all decimal fractions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 10
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{Z}[1/10]
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo &lt;
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0 \lt p)
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} b \in \mathbb{Z}
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi a
                    %mo ⋅
                    %msup
                      %mn 10
                      %mi b
                  %annotation{:encoding => "application/x-tex"} 1 \leq a \cdot 10^b
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ⋅
                      %msup
                        %mn 10
                        %mi b
                      %mo &lt;
                      %mn 10
                    %annotation{:encoding => "application/x-tex"} a \cdot 10^b \lt 10
          %h3#algebraic_closure Algebraic closure
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/algebraic+closure"} algebraic closure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 10
                      %mo{:stretchy => "false"} ]
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{\mathbb{Z}[1/10]}
            of the rational numbers is called the
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/algebraic+numbers"} algebraic numbers
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
          %h3#topologies Topologies
          %p
            There are several interesting
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topologies
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 10
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/10]
            that make
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 10
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/10]
            into a
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            under addition, allowing us to define interesting fields by taking the
            %a.existingWikiWord{:href => "/nlab/show/complete+space"} completion
            with respect to this topology:
          %ol
            %li
              %p
                The
                %em
                  %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} discrete topology
                is the most obvious, which is already complete.
            %li
              %p
                The
                %em absolute-value topology
                is defined by the
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi x
                          %mo −
                          %mi y
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} d(x,y) \coloneqq {|x - y|}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %p
                (This topology is
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+space"} totally disconnected
            %li
              %p
                For
                %a.existingWikiWord{:href => "/nlab/show/prime+numbers"} prime numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 5
                      %annotation{:encoding => "application/x-tex"} 5
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
                  \-adic topology
                and
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn 5
                      %annotation{:encoding => "application/x-tex"} 5
                  \-adic topology
                are defined by the
                %a.existingWikiWord{:href => "/nlab/show/ultrametric"} ultrametric
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi n
                    %annotation{:encoding => "application/x-tex"} d(x,y) \coloneqq 1/n
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                is the highest exponent on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 5
                    %annotation{:encoding => "application/x-tex"} 5
                respectively in the
                %a.existingWikiWord{:href => "/nlab/show/prime+factorization"} prime factorization
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi x
                          %mo −
                          %mi y
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} {|x - y|}
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
                %a.existingWikiWord{:href => "/nlab/show/adic+number"} adic numbers
                and
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 5
                      %annotation{:encoding => "application/x-tex"} 5
                %a.existingWikiWord{:href => "/nlab/show/adic+number"} adic numbers
                respectively.
          %h3#approximate_division Approximate division
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ÷
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi ℤ
                  %mo ×
                  %msub
                    %mi ℤ
                    %mrow
                      %mo ≠
                      %mn 0
                  %mo →
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} (-)\div(-):\mathbb{Z} \times \mathbb{Z}_{\neq 0} \to \mathbb{Z}
            be a
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+domain"} Euclidean division function
            on the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %strong approximate division
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi ℤ
                  %mo ×
                  %msub
                    %mi ℤ
                    %mrow
                      %mo ≠
                      %mn 0
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi ℕ
                  %mo →
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 10
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (-)/(-): \mathbb{Z} \times \mathbb{Z}_{\neq 0} \to (\mathbb{N} \to \mathbb{Z}[1/10])
          %p
            to a sequence of decimal fractions called the
            %strong infinite decimal representation
            of the
            %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo{:stretchy => "false"} /
                  %mi b
                %annotation{:encoding => "application/x-tex"} a/b
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} /
                  %mi b
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⋅
                  %msup
                    %mn 10
                    %mi n
                  %mo ÷
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msup
                    %mn 10
                    %mi n
                %annotation{:encoding => "application/x-tex"} (a/b)_n \coloneqq (a \cdot 10^n \div b)/10^n
          %p
            This sequence in general does not
            %a.existingWikiWord{:href => "/nlab/show/converge"} converge
            in the decimal rational numbers; the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            %a.existingWikiWord{:href => "/nlab/show/archimedean+integral+domain"} archimedean integral domain
            in which every infinite decimal representation of a rational number converges is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
          %h2#related_entries Related entries
