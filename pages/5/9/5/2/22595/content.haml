                        %mo +
                        %mi f
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((a \cdot 10^d) \cdot e + (c \cdot 10^b) \cdot e)/10^{(b + d) + f)} = (a \cdot (10^d \cdot e) + c \cdot (10^b \cdot e))/10^{(b + d) + f)}
            %p and by commutativity of multiplication of integers,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
