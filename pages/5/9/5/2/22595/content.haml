          %h2#idea Idea
          %p
            A
            %strong decimal rational number
            or
            %strong decimal fraction
            is a
            %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ∈
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} r \in \mathbb{Q}
            such that the
            %a.existingWikiWord{:href => "/nlab/show/decimal+number"} decimal
            expansion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            has finitely many digits.
          %h2#definition Definition
          %h3#as_a_subset_of_the_rational_numbers As a subset of the rational numbers
          %p
            A
            %strong decimal rational number
            or
            %strong decimal fraction
            is a
            %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ∈
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} r \in \mathbb{Q}
            such that there exists
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} a \in \mathbb{Z}
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mfrac
                      %mi a
                      %mrow
                        %msup
                          %mn 10
                          %mi n
                  %annotation{:encoding => "application/x-tex"} r = \frac{a}{10^n}
          %h3#as_the_localisation_of_the_integers_at_10 As the localisation of the integers at 10
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            of decimal rational numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 10
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/10]
            is the
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+commutative+ring"} localization
            of the
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/localisation+of+a+commutative+ring+away+from+an+element"} away from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 10
                  %annotation{:encoding => "application/x-tex"} 10
          %h3#as_an_initial_object_of_a_category As an initial object of a category
          %p
            For lack of a better name, let us define a
            %em set with decimal fractions
            to be a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with a function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo ∈
                    %mi ℤ
                    %mo ×
                    %mi ℕ
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \iota \in \mathbb{Z} \times \mathbb{N} \to A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi a
                  %mo ∈
                  %mi ℤ
                  %mo .
                  %mo ∀
                  %mi b
                  %mo ∈
                  %mi ℕ
                  %mo .
                  %mo ∀
                  %mi c
                  %mo ∈
                  %mi ℤ
                  %mo .
                  %mo ∀
                  %mi d
                  %mo ∈
                  %mi ℕ
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⋅
                  %msup
                    %mn 10
                    %mi d
                  %mo =
                  %mi c
                  %mo ⋅
                  %msup
                    %mn 10
                    %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %mo{:stretchy => "false"} (
                  %mi ι
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ι
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall a \in \mathbb{Z}. \forall b \in \mathbb{N}. \forall c \in \mathbb{Z}. \forall d \in \mathbb{N}. (a \cdot 10^d = c \cdot 10^b) \implies (\iota(a, b) = \iota(c, d))
          %p
            The integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} a:\mathbb{Z}
            represents the integer if one ignores the decimal separator in the
            %a.existingWikiWord{:href => "/nlab/show/decimal+number"} decimal numeral representation
            of the decimal fraction, and the natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} b:\mathbb{N}
            represents the number of digits to the left of the final digit where the decimal separator ought to be placed after in the decimal numeral representation of the decimal fraction. The axiom above is used to state that equivalent decimals are equal: i.e. 1.00 = 1.000 with decimal numeral representations.
          %p
            A
            %em homomorphism of sets with decimal fractions
            between two decimal fraction algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:A \to B
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi a
                  %mo ∈
                  %mi ℤ
                  %mo .
                  %mo ∀
                  %mi b
                  %mo ∈
                  %mi ℕ
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ι
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi ι
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall a \in \mathbb{Z}. \forall b \in \mathbb{N}. f(\iota_A(a, b)) = \iota_B(a, b)
          %p
            The
            %em category of sets with decimal fractions
            is the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SwDF
                %annotation{:encoding => "application/x-tex"} SwDF
            whose objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mi SwDF
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ob(SwDF)
            are sets with decimal fractions and whose morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mor(A,B)
            for sets with decimal fractions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi SwDF
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Ob(SwDF)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ∈
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mi SwDF
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B \in Ob(SwDF)
            are homomorphisms of sets with decimal fractions. The set of
            = succeed "," do
              %strong decimal fractions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/10]
          %h3#as_a_higher_inductive_type As a higher inductive type
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            = succeed "," do
              %strong decimal numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/10]
            %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
            generated by:
          %ul
            %li
              A function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %msup
                        %mn 10
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo :
                      %mi ℤ
                      %mo ×
                      %mi ℕ
                      %mo →
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 10
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} (-)/10^{(-)}:\mathbb{Z} \times \mathbb{N} \rightarrow \mathbb{Z}[1/10]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} a:\mathbb{Z}
              represents the integer if one ignores the decimal separator in the decimal numeral representation of the decimal number, and the natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo :
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} b:\mathbb{N}
              represents the number of digits to the left of the final digit where the decimal separator ought to be placed after in the decimal numeral representation of the decimal number.
            %li
              A dependent product of functions between identities representing that equivalent decimals are equal:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi equivdec
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo :
                          %mi ℤ
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi b
                          %mo :
                          %mi ℕ
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi c
                          %mo :
                          %mi ℤ
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi d
                          %mo :
                          %mi ℕ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ⋅
                      %msup
                        %mn 10
                        %mi d
                      %mo =
                      %mi c
                      %mo ⋅
                      %msup
                        %mn 10
                        %mi b
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} /
                      %msup
                        %mn 10
                        %mi b
                      %mo =
                      %mi c
                      %mo{:stretchy => "false"} /
                      %msup
                        %mn 10
                        %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} equivdec : \prod_{a:\mathbb{Z}} \prod_{b:\mathbb{N}} \prod_{c:\mathbb{Z}} \prod_{d:\mathbb{N}} (a \cdot 10^d = c \cdot 10^b) \to (a/10^b = c/10^d)
              %p (i.e. 1.00 = 1.000 with decimal numeral representations)
            %li
              A set-truncator
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mn 0
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo :
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mn 10
                          %mo{:stretchy => "false"} ]
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi b
                          %mo :
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mn 10
                          %mo{:stretchy => "false"} ]
                      %mi isProp
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo =
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tau_0: \prod_{a:\mathbb{Z}[1/10]} \prod_{b:\mathbb{Z}[1/10]} isProp(a=b)
          %h2#properties Properties
          %h3#decidability Decidability
          .num_prop
            %h6#proposition Proposition
            %p
              %strong (Decidability of equality)
            %p
              For every decimal fraction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 10
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{Z}[1/10]
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 10
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} q \in \mathbb{Z}[1/10]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p = q
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo =
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \neg(p = q)
          .num_defn
            %h6#definition_2 Definition
            %p
              %strong (Inequality)
            %p
              For every decimal fraction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℤ
