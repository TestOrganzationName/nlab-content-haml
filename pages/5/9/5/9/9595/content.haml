          %h2#idea Idea
          %p
            By
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Gelfand+duality"} Gelfand duality
            %a.existingWikiWord{:href => "/nlab/show/commutative+C%2A-algebras"} commutative C*-algebras
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %a.existingWikiWord{:href => "/nlab/show/noncommutative+topology"} noncommutative topology
            one may therefore regard general
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            %a.existingWikiWord{:href => "/nlab/show/Isbell+duality"} formal dual
            to generalized topological spaces and ask if the standard
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of topological spaces – as notably expressed by the standard
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+topological+spaces"} model structure on topological spaces
            – generalizes to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+topology"} noncommutative topology
          %p
            By the general discussion at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            to present a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            it is sufficient to equip it with the structure of a
            %em
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            \/
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopical+category"} homotopical category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
            %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            and
            %a.existingWikiWord{:href => "/nlab/show/E-theory"} E-theory
            of
            = succeed "-algebras" do
