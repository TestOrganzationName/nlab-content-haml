                          %msub
                            %mi k
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mtext by a bicharacteristic strip
                          %mo )
                      %annotation{:encoding => "application/x-tex"}
                        \\left((x_1,k_1) \sim (x_2, k_2)\right)
                        \\;\coloneqq\;
                        \\left(
                        q(x_i,k_i) = 0
                        \\;\;\text{and}\;\;
                        (x_1,k_1) \,\text{is connected to}\,
                        (x_2,k_2) \,\text{by a bicharacteristic strip}
                        \\right)
                %p
                  is called the
                  = succeed "." do
                    %em bicharacteristic relation
          %h2#examples Examples
          %h3#OfTheKleinGordonOperator Of the Klein-Gordon operator
          #BicharachteristicFlowOfKleinGordonOperator.num_example
            %h6#example Example
            %p
              %strong
                (bicharacteristic curves of
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/wave+operator"} wave operator
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operators"} Klein-Gordon operators
                are the
                %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/geodesics"} geodesics
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,g)
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lorentzian+manifold"} Lorentzian manifold
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ≔
                    %msub
                      %mo □
                      %mi g
                    %mo −
                    %msup
                      %mi m
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} D \coloneqq \Box_g - m^2
              be its
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/wave+operator"} wave operator
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
            %p
              Then the bicharacteristic curves of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BicharacteristicFlow"}
              %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
              %a.existingWikiWord{:href => "/nlab/show/geodesics"} geodesics
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,e)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cotangent+vectors"} cotangent vectors
            %p
              Accordingly two cotangent vectors are bicharacteristically related
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi k
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∼
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo ,
                    %msub
                      %mi k
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_1,k_1) \sim (x_2,k_2)
              precisely if there is a
              %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
              %a.existingWikiWord{:href => "/nlab/show/geodesic"} geodesic
              connecting the points, with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} k_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} k_2
              the corresponding cotangents, hence one the result of
              %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
              of the other along the geodesic.
          %p
            (
            %a{:href => "#Radzikowski96"}> Radzikowski 96, prop. 4.2 and below (6)
            )
          %p
            Specifically on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
          .num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/bicharacteristic+flow"} bicharacteristic flow
                of
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
              be
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p+1
              consider the
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi μ
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi ν
                    %mo −
                    %msup
                      %mrow
                        %mo (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %mi m
                              %mi c
                            %mi ℏ
                        %mo )
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    D
                    \\;=\;
                    \\eta^{\mu \nu} \frac{\partial}{\partial x^\mu} \frac{\partial}{\partial x^\nu}
                    \-
                    \\left(\tfrac{m c}{\hbar}\right)^2
                    \\,.
            %p
              Its
              %a.existingWikiWord{:href => "/nlab/show/principal+symbol"} principal symbol
              is the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi T
                              %mo *
                            %msup
                              %mi ℝ
                              %mrow
                                %mi p
                                %mo ,
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi q
                          %mtd
                            %mi ℝ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi η
                              %mrow
                                %mi μ
                                %mi ν
                            %msub
                              %mi k
                              %mi μ
                            %msub
                              %mi k
                              %mi ν
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T^\ast \mathbb{R}^{p,1}
                    \&amp;\overset{q}{\longrightarrow}&amp;
                    \\mathbb{R}
                    \\\
                    (x,k) &amp;\mapsto&amp; \eta^{\mu \nu} k_\mu k_\nu
                    }
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q(k) = 0
              is the condition that the
              %a.existingWikiWord{:href => "/nlab/show/wave+vector"} wave vector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
              corresponding to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi v
                              %mi q
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %msup
                              %mi η
                              %mrow
                                %mi μ
                                %mi ν
                            %msub
                              %mi k
                              %mi μ
                            %msub
                              %mo ∂
                              %mrow
                                %msup
                                  %mi x
                                  %mi ν
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %msup
                              %mi k
                              %mi μ
                            %msub
                              %mo ∂
                              %mrow
                                %msup
                                  %mi x
                                  %mi μ
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    v_q
                    \&amp; =
                    \-\tfrac{1}{2} \eta^{\mu \nu} k_\mu \partial_{x^\nu}
                    \\\
                    \&amp; =
                    \-\tfrac{1}{2} k^\mu \partial_{x^\mu}
                    \\end{aligned}
            %p in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mi q
                            %mi d
                            %msub
                              %mi k
                              %mi μ
                            %mo ∧
                            %mi d
                            %msup
                              %mi x
                              %mi μ
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %msup
                              %mi η
                              %mrow
                                %mi μ
                                %mi ν
                            %msub
                              %mi k
                              %mi μ
                            %mi d
                            %msub
                              %mi k
                              %mi μ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi d
                            %mi q
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\iota_{v_q} d k_\mu \wedge d x^\mu
                    \&amp;=
                    \\tfrac{1}{2} \eta^{\mu \nu} k_\mu d k_\mu
                    \\\
                    \&amp; =
                    d q(k)
                    \\end{aligned}
            %p
              It follows that the
              %a.existingWikiWord{:href => "/nlab/show/bicharacteristic+curves"} bicharacteristic curves
              are precisely the
              %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
              %a.existingWikiWord{:href => "/nlab/show/curves"} curves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℝ
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi γ
                                  %mi k
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mi p
                                %mo ,
                                %mn 1
                        %mtr
                          %mtd
                            %mi τ
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi γ
                              %mi μ
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi τ
                            %msup
                              %mi k
                              %mi μ
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R} &amp;\overset{\gamma_k}{\longrightarrow}&amp; \mathbb{R}^{p,1}
                    \\\
                    \\tau &amp;\mapsto&amp; (\gamma^\mu(0) +  \tau k^\mu)
                    }
            %p
              and the corresponding
              %a.existingWikiWord{:href => "/nlab/show/bicharacteristic+strips"} bicharacteristic strips
              are these with their lightlike contangent vector constantly carried along
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℝ
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi γ
                                  %mi k
                          %mtd
                            %msup
                              %mi T
                              %mo *
                            %msup
                              %mi ℝ
                              %mrow
                                %mi p
                                %mo ,
                                %mn 1
                        %mtr
                          %mtd
                            %mi τ
                          %mtd
                            %mo ↦
                          %mtd
                            %mrow
                              %mo (
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi γ
                                %mi μ
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo +
                              %mi τ
                              %msup
                                %mi k
                                %mi μ
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi k
                                %mi μ
                              %mo{:stretchy => "false"} )
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R} &amp;\overset{\gamma_k}{\longrightarrow}&amp; T^\ast\mathbb{R}^{p,1}
                    \\\
                    \\tau &amp;\mapsto&amp; \left((\gamma^\mu(0) +  \tau k^\mu),(k_\mu)\right)
                    }
          %h2#properties Properties
          %h3#propagation_of_singularities Propagation of singularities
          %p
            The
            %em
              %a.existingWikiWord{:href => "/nlab/show/propagation+of+singularities+theorem"} propagation of singularities theorem
            says that the
            %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
            of a
            %a.existingWikiWord{:href => "/nlab/show/distribution"} distributional
            solution to the
            %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
            of a sufficiently nice
            %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
            (or generally of a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/properly+supported+pseudo-differential+operator"} properly supported pseudo-differential operator
          %h2#references References
          %ul
            %li#DuistermaatHoermander72
              %a.existingWikiWord{:href => "/nlab/show/Johann+Duistermaat"}> Johann Duistermaat
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lars+H%C3%B6rmander"} Lars Hörmander
              = succeed "," do
                %em Fourier integral operators II
              = succeed ")" do
                %a{:href => "https://projecteuclid.org/euclid.acta/1485889724"} Euclid
          %p
            Review in the context of the
            %a.existingWikiWord{:href => "/nlab/show/free+field"} free
            %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
