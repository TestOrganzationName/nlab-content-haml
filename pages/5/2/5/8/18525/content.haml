                            %mi k
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo (
                          %mi q
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mi i
                          %mo ,
                          %msub
                            %mi k
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mtext and
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 1
                          %mo ,
                          %msub
                            %mi k
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mtext is connected to
