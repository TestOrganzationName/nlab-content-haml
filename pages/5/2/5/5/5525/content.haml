              %a.existingWikiWord{:href => "/nlab/show/decalage"} decalage
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi W
                        %mo{:stretchy => "false"} ¯
