                  %mrow
                    %mi W
                    %mi G
                  %annotation{:encoding => "application/x-tex"} W G
          .num_cor
            %h6#corollary Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
