            = succeed ")" do
              %a{:href => "http://ncatlab.org/nlab/show/cohesive+%28infinity%2C1%29-topos+--+structures#Cohomology"} here
          .num_defn
            %h6#definition_4 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} sGrp
                    %mo =
                    %mi{:mathvariant => "normal"} Grp
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{sGrp} = \mathrm{Grp}(\mathrm{sSet})
              for the category of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
          %p
            A classical reference is section 17 of
            = succeed "." do
              %a{:href => "#May"} May
          .num_prop
            %h6#DiscreteLoopingDelooping Proposition
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} sGrpd
                  %annotation{:encoding => "application/x-tex"} \mathrm{sGrpd}
              inherits a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred
              along the forgetful functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi{:mathvariant => "normal"} sGrp
                      %mo →
                      %mi{:mathvariant => "normal"} sSet
                    %annotation{:encoding => "application/x-tex"} F : \mathrm{sGrp} \to \mathrm{sSet}
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} sSet
                      %mn 0
                    %mo ↪
                    %mi{:mathvariant => "normal"} sSet
                  %annotation{:encoding => "application/x-tex"} \mathrm{sSet}_0 \hookrightarrow \mathrm{sSet}
              of reduced simplicial sets (simplicial sets with a single vertex) carries a model category structure whose weak equivalences and cofibrations are those of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} sSet
                        %mi{:mathvariant => "normal"} Quillen
                    %annotation{:encoding => "application/x-tex"} \mathrm{sSet}_{\mathrm{Quillen}}
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ⊣
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi sGrp
                    %mover
                      %munder
                        %mo →
                        %mover
                          %mi W
                          %mo{:stretchy => "false"} ¯
                      %mover
                        %mo ←
                        %mi G
                    %msub
                      %mi sSet
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    (G \dashv \bar W)
                    \:
                    sGrp
                    \\stackrel{\overset{G}{\leftarrow}}{\underset{\bar W}{\to}}
                    sSet_{0}
            %p
              which
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presents
              the abstract
              %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
              equivalence of
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo ⊣
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mn ∞
                    %mi Grpd
                    %mover
                      %munder
                        %mo →
                        %mi B
                      %mover
                        %mo ←
                        %mi Ω
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mi connected
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\Omega \dashv \mathbf{B})
                    \:
                    \\infty Grpd
                    \\stackrel{\overset{\Omega}{\leftarrow}}{\underset{B}{\to}}
                    \\infty Grpd_{connected}
                    \\,,
          %p
            The model structures and the Quillen equivalence are classical, discussed in (
            %a{:href => "#GoerssJardine"}> GoerssJardine, section V
            )
          %p
            This means on abstract grounds that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
