                %li
                  %a{:href => "#cohomology_and_principal_bundles"}
                    Cohomology and principal
                    = succeed "-bundles" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The term
            %em
              discrete
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            or
            %em
              bare
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            or
            %em
              geometrically
              %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete
              %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+type"} geometric homotopy type
            is essentially synonymous to just
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            or just
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+type"} geometric structure
            (e.g.
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} structure
            %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete
            such structure is considered.
          %h2#definition Definition
          .un_observation
            %h6#observation Observation
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+an+%28%E2%88%9E%2C1%29-category"} terminal
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-sheaf (∞,1)-topos
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              is trivially a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo ⊣
                    %mi Disc
                    %mo ⊣
                    %mi Γ
                    %mo ⊣
                    %mi coDisc
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mn ∞
                    %mi Grpd
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} (\Pi \dashv Disc \dashv \Gamma \dashv coDisc) : \infty Grpd \to \infty Grpd
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
          .un_defn
            %h6#definition_2 Definition
            %p
              In the context of
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              defines
              %strong discrete cohesion
              and refer to its objects as
              = succeed "." do
                %strong
                  discrete
                  = succeed "-groupoids" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
            %p
              More generally, given any other
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo ⊣
                    %mi Disc
                    %mo ⊣
                    %mi Γ
                    %mo ⊣
                    %mi codisc
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %munder
                        %mo →
                        %mi Γ
                      %mover
                        %mo ←
                        %mi Disc
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi \dashv Disc \dashv \Gamma \dashv codisc) : \mathbf{H}  \stackrel{\overset{Disc}{\leftarrow}}{\underset{\Gamma}{\to}}
                    \\infty Grpd
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              of the
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              functor is a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
              and hence embeds
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              as a full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is a
              %em
                cohesive
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              \. We say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              is a
              %strong
                discrete
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              if it is in the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                    %annotation{:encoding => "application/x-tex"} Disc
          .un_remark
            %h6#remark Remark
            %p
              This generalizes the traditional use of the terms
              %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete space
              and
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete space
                  is equivalently a 0-
                  %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
                  discrete
                  = succeed "-groupoid;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
                  is equivalently a 0-
                  %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
                  %a.existingWikiWord{:href => "/nlab/show/group+object+in+an+%28%E2%88%9E%2C1%29-category"} group object
                  in discrete
                  = succeed "-groupoids." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
          %h2#structures_in_
            Structures in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Disc
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} Disc\infty Grpd
          %p
            We discuss now some of the general abstract
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos+--+structures"} structures in a cohesive (∞,1)-topos
            realized in discrete
            = succeed "-groupoids." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %h3#TopAsCohesiveInfinTopos Geometric homotopy and Galois theory
          %p
            We discuss the general absatract notion of geometric homotopy in cohesive
            = succeed "-toposes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed ")" do
              %a{:href => "http://ncatlab.org/nlab/show/cohesive+%28infinity%2C1%29-topos+--+structures#Homotopy"} here
          %p
            By the
            = succeed "-theorem" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            and
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalent
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos+theory"} (∞,1)-topos theory
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentations
            for an equivalence class of
            = succeed "-toposes." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p For that purposes consider the following
          .un_defn
            %h6#definition_3 Definition
            %p
              Define the
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo :
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi Quillen
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"}
                    Top := N(Top_{Quillen})^\circ
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Grpd
                    %mo :
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\infty Grpd := N(sSet_{Quillen})^\circ
                    \\,,
            %p
              where on the right we have the standard
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+topological+spaces"} model structure on topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} Top_{Quillen}
              and the standard
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N((-)^\circ)
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
              of the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+category"} simplicial category
              given by the full
              = succeed "-subcategory" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
              on fibrant-cofibrant objects.
          %p For
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                    %mo ⊣
                    %mi Sing
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi Top
                    %mi Quillen
                  %mover
                    %munder
                      %mo →
                      %mi Sing
                    %mover
                      %mo ←
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %mo{:stretchy => "false"} |
                  %msub
                    %mi sSet
                    %mi Quillen
                %annotation{:encoding => "application/x-tex"}
                  ({|-| \dashv Sing}) : Top_{Quillen} \stackrel{\overset{{|-|}}{\leftarrow}}{\underset{Sing}{\to}} sSet_{Quillen}
          %p
            the standard
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            of the
            = succeed "-theorem" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
            = succeed "-functor" do
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝕃
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                  %mo ⊣
                  %mi ℝ
                  %mi Sing
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Top
                  %mover
                    %munder
                      %mo →
                      %mrow
                        %mi ℝ
                        %mi Sing
                    %mover
                      %mo ←
                      %mrow
                        %mi 𝕃
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} |
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"}
                  (\mathbb{L} {|-|} \dashv \mathbb{R}Sing) :
                  Top
                  \\stackrel{\overset{\mathbb{L}{|-|}}{\leftarrow}}{\underset{\mathbb{R}Sing}{\to}}
                  \\infty Grpd
          %p
            for the corresponding
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
            %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
            of the restriction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|-|}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sing
                %annotation{:encoding => "application/x-tex"} Sing
            to fibrant-cofibrant objects followed by functorial fibrant-cofibrant replacement) that constitute a pair of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
          %p
            Since this is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            either functor serves as the
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            and
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            and so we have
          .un_observation
            %h6#observation_2 Observation
            %p
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              is exhibited a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              over
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              by setting
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo ⊣
                    %mi Disc
                    %mo ⊣
                    %mi Γ
                    %mo ⊣
                    %mi coDisc
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Top
                    %mover
                      %mover
                        %mover
                          %munder
                            %mo ←
                            %mrow
                              %mi 𝕃
                              %mrow
                                %mo{:stretchy => "false"} |
                                %mo −
                                %mo{:stretchy => "false"} |
                          %mover
                            %mo →
                            %mrow
                              %mi ℝ
                              %mi Sing
                        %mover
                          %mo ←
                          %mrow
                            %mi 𝕃
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mo −
                              %mo{:stretchy => "false"} |
                      %mover
                        %mo →
                        %mrow
                          %mi ℝ
                          %mi Sing
                    %mn ∞
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi \dashv Disc \dashv \Gamma \dashv coDisc)
                    \:
                    Top
                    \\stackrel{\overset{\mathbb{R}Sing}{\to}}{\stackrel{\overset{\mathbb{L}{|-|}}{\leftarrow}}{\stackrel{\overset{\mathbb{R}Sing}{\to}}{\underset{\mathbb{L}{|-|}}{\leftarrow}}}}
                    \\infty Grpd
                    \\,.
                    \\,.
            %p
              In particular a presentation of the intrinsic
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
              is given by the familiar
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              construction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℝ
                    %mi Sing
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi(X) \simeq \mathbb{R} Sing X
                    \\,.
          .un_remark
            %h6#remark_2 Remark
            %p
              While degenerate, it is sometimes useful to make this example of a
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              explicit. For instance it allows to think of simplicial models for topological fibrations in terms of topological
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/higher+parallel+transport#FlatInTop"} Flat higher parallel transport in Top
          .un_remark
            %h6#remark_3 Remark
            %p
              Notice that the
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
              that enters the explicit construction of the objects in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              here does
              %em not
              show up as
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive structure
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              here is a model for a
              %em discrete
              = succeed "-groupoid," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
              only serves to allow the construction of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sing
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Sing X
              = succeed "-groupoids" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %em topological cohesion
              see
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean-topological+%E2%88%9E-groupoid"} Euclidean-topological ∞-groupoid
          %h3#cohomology_and_principal_bundles
            Cohomology and principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We discuss the general abstract notion of cohomology and principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-toposes" do
