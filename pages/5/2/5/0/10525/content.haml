          %title JordanBanach algebras
          %h1#jordanbanach_algebras Jordan–Banach algebras
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#properties"} Properties
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
              %li
                %a{:href => "#related_pages"} Related pages
          %h2#idea Idea
          %p
            Jordan–Banach algebras,
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/analogy"} analogy
          %table
            %thead
              %tr
                %th
                %th
                %th
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} *
                  %a.existingWikiWord{:href => "/nlab/show/star-algebra"} algebra
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Jordan+algebra"} Jordan algebra
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Jordan%E2%80%93Lie+algebra"} Jordan–Lie algebra
              %tr
                %td{:style => "text-align: left;"}
                  associative
                  %a.existingWikiWord{:href => "/nlab/show/Banach+algebra"} Banach
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} *
                %td{:style => "text-align: left;"} Jordan–Banach algebra
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Jordan%E2%80%93Lie%E2%80%93Banach+algebra"} Jordan–Lie–Banach algebra
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^*
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} algebra
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi JB
                      %annotation{:encoding => "application/x-tex"} JB
                  \-algebra
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi JLB
                      %annotation{:encoding => "application/x-tex"} JLB
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/JLB-algebra"} algebra
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"} von Neumann algebra
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi JBW
                      %annotation{:encoding => "application/x-tex"} JBW
                  \-algebra
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi JLBW
                      %annotation{:encoding => "application/x-tex"} JLBW
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/JLBW-algebra"} algebra
          %p
            Just as a
            %a.existingWikiWord{:href => "/nlab/show/Jordan+algebra"} Jordan algebra
            that happens to be associative is the same thing as an
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %a.existingWikiWord{:href => "/nlab/show/star-algebra"} algebra
            with trivial
            %a.existingWikiWord{:href => "/nlab/show/involution"} involution
            (aka simply an associative algebra) that happens to be
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative
          %p
            One can also consider Jordan
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} algebras
            have analogues already for
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            structure to a Jordan algebra; then even
            %em without
            assuming associativity or commutativity, a
            %a.existingWikiWord{:href => "/nlab/show/Jordan%E2%80%93Lie+algebra"} Jordan–Lie algebra
            over the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            is the same thing as an associative
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
          %p
            The right column is discussed at
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/Jordan%E2%80%93Lie%E2%80%93Banach+algebra"} Jordan–Lie–Banach algebra
          %h2#definitions Definitions
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Banach+space"} Banach space
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %a.existingWikiWord{:href => "/nlab/show/topological+field"} topological field
            (or possibly even more general). We will generally assume the real numbers, and some theorems may rely on this, or at least on the divisibility of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
          .num_defn
            %h6#definition Definition
            %p
              The Banach space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              becomes a
              %strong Jordan–Banach algebra
              if it is equipped with a
              %a.existingWikiWord{:href => "/nlab/show/binary+operation"} binary operation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ×
                      %mi A
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A \times A \to A
              %em Jordan multiplication
              and often written infix as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∘
                    %annotation{:encoding => "application/x-tex"} \circ
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/short+map"}> shortness
                \:
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %mo ∘
                          %mi y
                          %mo{:stretchy => "false"} ‖
                        %mo ≤
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %mo{:stretchy => "false"} ‖
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi y
                          %mo{:stretchy => "false"} ‖
                      %annotation{:encoding => "application/x-tex"} {\|x \circ y\|} \leq {\|x\|} {\|y\|}
              %li
                %a.existingWikiWord{:href => "/nlab/show/bilinear+map"}> bilinearity
                \:
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mi x
                        %mo +
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mi u
                        %mo +
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi a
                        %mi b
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ∘
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi a
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ∘
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi b
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ∘
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi y
                        %mo ∘
                        %mi v
                      %annotation{:encoding => "application/x-tex"} (a x + y) \circ (b u + v) = a b (x \circ u) + a (x \circ v) + b (y \circ u) + y \circ v
              %li
                commutativity:
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∘
                        %mi y
                        %mo =
                        %mi y
                        %mo ∘
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x \circ y = y \circ x
              %li
                Jordan identity:
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ∘
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ∘
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi x
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ∘
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (x \circ y) \circ (x \circ x) = x \circ (y \circ (x \circ x))
          %p
            For motivation of the first two, see
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/Banach+algebra"} Banach algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Jordan+algebra"} Jordan algebra
          .num_defn
            %h6#definition_2 Definition
            %p
              The Jordan–Banach algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              %strong unital
              if the Jordan multiplication has an
              %a.existingWikiWord{:href => "/nlab/show/identity+element"} identity element
              in its unit ball, usually denoted
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∘
                      %mi x
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} 1 \circ x = x
                ,
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi x
                      %mo ∘
                      %mn 1
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x \circ 1 = x
                ,
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mn 1
                        %mo{:stretchy => "false"} ‖
                      %mo ≤
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} {\|1\|} \leq 1
                \.
          %p
            People might state the last clause as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mn 1
                      %mo{:stretchy => "false"} ‖
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} {\|1\|} = 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x \ne 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mn 1
                    %mo{:stretchy => "false"} ‖
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} {\|1\|} = 0
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/trivial+ring"} trivial algebra
          .num_defn
            %h6#definition_3 Definition
            %p
              The Jordan–Banach algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi JB
                    %annotation{:encoding => "application/x-tex"} JB
                \-algebra
              if it satisfies these identities:
            %ul
              %li
                %strong>
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                  \-identity
                \:
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %mo ∘
                          %mi x
                          %mo{:stretchy => "false"} ‖
                        %mo =
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %msup
                            %mo{:stretchy => "false"} ‖
                            %mn 2
                      %annotation{:encoding => "application/x-tex"} {\|x \circ x\|} = {\|x\|^2}
              %li
                %em>
                  %a.existingWikiWord{:href => "/nlab/show/formally+real+algebra"} positivity
                \:
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %mo ∘
                          %mi x
                          %mo{:stretchy => "false"} ‖
                        %mo ≤
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %mo ∘
                          %mi x
                          %mo +
                          %mi y
                          %mo ∘
                          %mi y
                          %mo{:stretchy => "false"} ‖
                      %annotation{:encoding => "application/x-tex"} {\|x \circ x\|} \leq {\|x \circ x + y \circ y\|}
          %p
            Shortness of the multiplication follows from the
            = succeed "-identity" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %a.existingWikiWord{:href => "/nlab/show/polarization+identities"} polarization identities
            and the triangle identity), so it may be left out of a direct definition of
            = succeed "-algebras;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            in the unital case. (Compare the analogous results for
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi x
                      %mo{:stretchy => "false"} ‖
                    %mn 2
                  %mo ≤
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi x
                    %mo ∘
                    %mi x
                    %mo +
                    %mi y
                    %mo ∘
                    %mi y
                    %mo{:stretchy => "false"} ‖
                  %mo .
                %annotation{:encoding => "application/x-tex"} {\|x\|}^2 \leq {\|x \circ x + y \circ y\|} .
          %p
            Also, positivity implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/formally+real+algebra"} formally real
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %msup
                      %mi y
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x^2 + y^2 = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ,
                  %mi y
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} x, y = 0
            (and so on for any number of terms). Given this, the Jordan identity is equivalent to
            %a.existingWikiWord{:href => "/nlab/show/power-associative+algebra"} power-associativity
            (which it implies regardless) in a direct definition of
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
          .num_defn
            %h6#definition_4 Definition
            %p
              The
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi JB
                    %annotation{:encoding => "application/x-tex"} JB
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi JBW
                    %annotation{:encoding => "application/x-tex"} JBW
                \-algebra
              if it is unital and if its
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              Banach space has a
              %a.existingWikiWord{:href => "/nlab/show/predual"} predual
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mo *
                    %annotation{:encoding => "application/x-tex"} A_*
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"} von Neumann algebra
            for motivation of the predual. As with
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/unique+up+to+unique+isomorphism"} unique up to unique isomorphism
          .num_defn
            %h6#definition_5 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              from a Jordan–Banach algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to a Jordan–Banach algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is a
              %a.existingWikiWord{:href => "/nlab/show/bounded+linear+map"} bounded linear map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} T\colon A \to B
              of Banach spaces (everywhere defined) such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∘
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(x \circ y) = T(x) \circ T(y)
              always holds. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              are unital, then the homomorphism is
              %strong unital
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} T(1) = 1
          %p
            To get the right notion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            in the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of Jordan–Banach algebras should be the
            %em
              %a.existingWikiWord{:href => "/nlab/show/short+linear+map"} short
            homomorphisms (see
            %a{:href => "Ban#morphisms"} Ban#morphisms
            for discussion). However, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            = succeed "-algebras);" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is bounded. Similarly, a morphism of unital Jordan–Banach algebras should be unital.
          .num_defn
            %h6#definition_6 Definition
            %p
              Given a Jordan–Banach algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and a
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %strong
                %a.existingWikiWord{:href => "/nlab/show/representation"} representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is a homomorphism from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to the algebra of
              %a.existingWikiWord{:href => "/nlab/show/Hermitian+operators"} Hermitian operators
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              (which is a
              = succeed "-algebra," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi JB
                    %annotation{:encoding => "application/x-tex"} JB
              = succeed "-algebra," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi JBW
                    %annotation{:encoding => "application/x-tex"} JBW
              %strong
                %a.existingWikiWord{:href => "/nlab/show/faithful+representation"} faithful
              if it's an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective function
          %p
            Again, we should really look only at the short representations (which is automatic for a
            = succeed "-algebra)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
          %p
            Recall that a Jordan algebra is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/special+Jordan+algebra"} special
            if it has a faithful representation on a
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            (which follows if it has any injective homomorphism to the Jordanization of any associative algebra).
          .num_defn
            %h6#definition_7 Definition
            %p
              A
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi JC
                    %annotation{:encoding => "application/x-tex"} JC
                \-algebra
              is a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi JB
                    %annotation{:encoding => "application/x-tex"} JB
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi JW
                    %annotation{:encoding => "application/x-tex"} JW
                \-algebra
              is a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi JBW
                    %annotation{:encoding => "application/x-tex"} JBW
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi JC
                    %annotation{:encoding => "application/x-tex"} JC
          %p
            This follows if the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            %a.existingWikiWord{:href => "/nlab/show/Hermitian+operators"} Hermitian operators
            in any
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            %em not
            itself have an analogue for
            = succeed "-algebras;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            %a.existingWikiWord{:href => "/nlab/show/Albert+algebra"} Albert algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔥
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi 𝕆
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{h}_3(\mathbb{O})
            is a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            = succeed "-algebra)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JBW
                  %annotation{:encoding => "application/x-tex"} JBW
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JC
                  %annotation{:encoding => "application/x-tex"} JC
          %p
            This is probably unfortunate terminology (compare ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mo *
                %annotation{:encoding => "application/x-tex"} B^*
            \-algebra’ vs ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mo *
                %annotation{:encoding => "application/x-tex"} C^*
            \-algebra’ and ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mi W
                    %mo *
                %annotation{:encoding => "application/x-tex"} W^*
            \-algebra’ vs ‘von Neumann algebra’); it would probably be better just to call such
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            %strong special
            (but somebody might think that this just means that the underlying Jordan algebra is special, which is weaker). We do need some term, however, thanks to the Albert algebra.
          %h2#examples Examples
          %p
            The main example of a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operators"} self-adjoint operators
            in a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} algebra
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JBW
                  %annotation{:encoding => "application/x-tex"} JBW
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"} von Neumann algebra
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            is a
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JBW
                  %annotation{:encoding => "application/x-tex"} JBW
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JW
                  %annotation{:encoding => "application/x-tex"} JW
            %a.existingWikiWord{:href => "/nlab/show/trivial+ring"} trivial algebra
            (which is the algebra of self-adjoint operators on the zero Hilbert space) is a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JW
                  %annotation{:encoding => "application/x-tex"} JW
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mn 1
                      %mo{:stretchy => "false"} ‖
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} {\|1\|} = 1
          %p
            Every
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/formally+real+algebra"} formally real
            %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+space"} finite dimensions
            are
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JBW
                  %annotation{:encoding => "application/x-tex"} JBW
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JW
                  %annotation{:encoding => "application/x-tex"} JW
            %a.existingWikiWord{:href => "/nlab/show/Albert+algebra"} Albert algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔥
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi O
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{h}_3(O)
            as the basic example of a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JBW
                  %annotation{:encoding => "application/x-tex"} JBW
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JW
                  %annotation{:encoding => "application/x-tex"} JW
            %a{:href => "Jordan+algebra#frc"} Jordan algebra#frc
            for the classification of the finite-dimensional formally real Jordan algebras.)
          %h2#properties Properties
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi JB
                %annotation{:encoding => "application/x-tex"} JB
            \-algebras have nice properties like those of
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JBW
                  %annotation{:encoding => "application/x-tex"} JBW
          %p
            An associative
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            vanishing at infinity on a
            %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
            %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
            if and only if the algebra is unital, and then every continuous map vanishes at infinity.
          %p
            Like any Jordan algebra, a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/power-associative+algebra"} power-associative
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            generates an associative (and of course commutative)
            %a.existingWikiWord{:href => "/nlab/show/subalgebra"} subalgebra
            and hence a locally compact Hausdorff space. In a unital
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(x)
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f\colon Spec(x) \to \mathbb{R}
            therefore defines an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x)
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            generates a compact Hausdorff space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(X)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spec(X)
            defines an element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (in fact belonging to
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/functional+calculus"} functional calculus
            on
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JBW
                  %annotation{:encoding => "application/x-tex"} JBW
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/localizable+measure+space"} localizable measure space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            identified as the algebra of
            %a.existingWikiWord{:href => "/nlab/show/essentially+bounded+function"} essentially bounded
            %a.existingWikiWord{:href => "/nlab/show/measurable+functions"} measurable functions
            (modulo
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/almost+equality"} almost equality
          %p
            Since every
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/formally+real+algebra"} formally real
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \leq y
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo −
                  %mi x
                %annotation{:encoding => "application/x-tex"} y - x
            is a sum of squares.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/order-theoretic+structure+in+quantum+mechanics"} order-theoretic structure in quantum mechanics
            fixes the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JB
                  %annotation{:encoding => "application/x-tex"} JB
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi JLB
                  %annotation{:encoding => "application/x-tex"} JLB
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/JBW-algebraic+quantum+mechanics"} JBW-algebraic quantum mechanics
          %h2#references References
          %p Basic stuff is at
          %ul
            %li
              %a{:href => "https://en.wikipedia.org/wiki/Jordan_operator_algebra"} Jordan operator algebra
              on the English Wikipedia;
          %p and most of that appears to be from
          %ul
            %li
              Harald Hanche-Olsen and Erling Størmer (1984);
              = succeed ";" do
                %em Jordan operator algebras
              = succeed "," do
                %a{:href => "http://www.math.ntnu.no/~hanche/joa/"} web
          %p which I have only begun to read.
          %p There is also
          %ul
            %li
              Harald Upmeier (1987);
              = succeed ";" do
                %em Jordan Algebras in Analysis, Operator Theory, and Quantum Mechanics
          %p of which a lot is already on pages 1–4 (the only ones that Google Books would show me).
          %h2#related_pages Related pages
          %ul
