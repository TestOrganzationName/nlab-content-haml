                %use{:x => "254.04625", "xlink:href" => "#pYNncBR5naRD7RtBPTFo0ph1Ep4=-glyph-5-2", :y => "11.174"}
              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "258.1625", "xlink:href" => "#pYNncBR5naRD7RtBPTFo0ph1Ep4=-glyph-4-4", :y => "11.174"}
              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "266.39625", "xlink:href" => "#pYNncBR5naRD7RtBPTFo0ph1Ep4=-glyph-5-3", :y => "11.174"}
              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "248.46", "xlink:href" => "#pYNncBR5naRD7RtBPTFo0ph1Ep4=-glyph-4-6", :y => "23.217"}
            %p
              and since right inverses of isomorphisms are unique (
              %a{:href => "inverse#InversesAreUnique"}> this Prop.
              ), it follows that these two morphisms on the left are in fact equal, and therefore that their equalizer, hence the core of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              (by Rem.
              = succeed ")," do
                %a.maruku-ref{:href => "#CoreAsEqualizerAndAsRegularImage"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %p
              In the other direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ⊗
                    %mi r
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi r
                    %mo ⊗
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 \otimes r \,=\, r \otimes 1
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} r \in R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi r
                              %mn 1
                            %mspace{:width => "thinmathspace"}
                            %mo ⊗
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi r
                              %mn 2
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi r
                              %mn 1
                            %mspace{:width => "thinmathspace"}
                            %mo ⊗
                            %mspace{:width => "thinmathspace"}
                            %mn 1
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo ⋅
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mn 1
                            %mo ⊗
                            %msub
                              %mi r
                              %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mn 1
                            %mspace{:width => "thinmathspace"}
                            %mo ⊗
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi r
                              %mn 1
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo ⋅
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mn 1
                            %mo ⊗
                            %msub
                              %mi r
                              %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mn 1
                            %mspace{:width => "thinmathspace"}
                            %mo ⊗
                            %mspace{:width => "thinmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi r
                              %mn 1
                            %mo ⋅
                            %msub
                              %mi r
                              %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    r_1 \,\otimes\, r_2
                    \&amp; \;=\;
                    \\big( r_1 \,\otimes\, 1 \big)
                    \\cdot
                    \\big( 1 \otimes r_2 \big)
                    \\\
                    \&amp; \;=\;
                    \\big( 1 \,\otimes\, r_1 \big)
                    \\cdot
                    \\big( 1 \otimes r_2 \big)
                    \\\
                    \&amp; \;=\;
                    1
                    \\,\otimes\,
                    \\big(
                    r_1 \cdot r_2
                    \\big)
                    \\,,
                    \\end{aligned}
            %p
              and therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-)\cdot(-)
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of rings.
          %h2#properties Properties
          %p
          #CoresAreSolid.num_prop
            %h6 Proposition
            %p
              %strong (cores are solid)
              %br/
              The core (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CoreOfARing"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is solid (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#SolidRing"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mi c
                    %mi R
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi c
                    %mi R
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c c R
                    \\;\simeq\;
                    c R
                    \\,.
            %p
          (
          %a{:href => "#BousfieldKan72"}> Bousfield-Kan 72, prop. 2.2
          )
          %h2#examples Examples
          .num_theorem
            %h6#theorem Theorem
            %p
              The following is the complete list of solid rings (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SolidRing"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} localization
                  of the ring of
                  %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                  at a
                  %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Pr
                      %annotation{:encoding => "application/x-tex"} Pr
                  of
                  %a.existingWikiWord{:href => "/nlab/show/prime+numbers"} prime numbers
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                        %msup
                          %mi Pr
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbb{Z}\big[Pr^{-1}\big]
                        \\,;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/integers+modulo+n"} integers modulo n
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi n
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbb{Z}/n\mathbb{Z}
                %p
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ≥
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} n \geq 2
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} product
                  rings
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi J
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ×
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi n
                        %mi ℤ
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbb{Z}[J^{-1}]
                        \\times
                        \\mathbb{Z}/n\mathbb{Z}
                        \\,,
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n \geq 2
                  such that each
                  %a.existingWikiWord{:href => "/nlab/show/prime+factor"} prime factor
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  is contained in the set of primes
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi J
                        %annotation{:encoding => "application/x-tex"} J
              %li
                %p the ring cores of product rings
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi J
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ×
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi p
                            %mo ∈
                            %mi K
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi p
                          %mrow
                            %mi e
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        c(\mathbb{Z}[J^{-1}] \times \underset{p \in K}{\prod} \mathbb{Z}/p^{e(p)})
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo ⊂
                        %mi J
                      %annotation{:encoding => "application/x-tex"} K \subset J
                  are infinite sets of primes and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} e(p)
                  are positive natural numbers.
          %p
            (
            %a{:href => "#BousfieldKan72"}> Bousfield-Kan 72, prop. 3.5
            ,
            = succeed ")" do
              %a{:href => "#Bousfield79"} Bousfield 79, p. 276
          %p In particular:
          %p
          #RationalNumbersFormASolidRing.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
                form a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/solid+ring"} solid ring
              %br/
              The ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              of
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/solid+ring"} solid ring
          .proof
            %h6 Proof
            %p
              Since every
              %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational number
              may be written as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi q
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mi p
                    %mo ⋅
                    %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"}
                    r \,=\,q / p \,=\, \tfrac{1}{p} \cdot q \,\in\, \mathbb{Q}
            %p
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} p, q \,\in\, \mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mn 1
                            %mo ⊗
                            %mi r
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mn 1
                            %mspace{:width => "thinmathspace"}
                            %mo ⊗
                            %mspace{:width => "thinmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mi p
                            %mo ⋅
                            %mi q
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mi p
                            %mo ⋅
                            %mi p
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ⊗
                            %mspace{:width => "thinmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mi p
                            %mo ⋅
                            %mi q
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mi p
                            %mspace{:width => "thinmathspace"}
                            %mo ⊗
                            %mspace{:width => "thinmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi p
                            %mo ⋅
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mi p
                            %mo ⋅
                            %mi q
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mi p
                            %mspace{:width => "thinmathspace"}
                            %mo ⊗
                            %mspace{:width => "thinmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi q
                            %mo ⋅
                            %mn 1
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mi p
                            %mo ⋅
                            %mi q
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ⊗
                            %mspace{:width => "thinmathspace"}
                            %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mi r
                            %mspace{:width => "thinmathspace"}
                            %mo ⊗
                            %mspace{:width => "thinmathspace"}
                            %mn 1
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ∈
                            %mspace{:width => "thickmathspace"}
                            %mi ℚ
                            %msub
                              %mo ⊗
                              %mrow
                                %msub
                                  %mrow
                                  %mi ℤ
                            %mi ℚ
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    1 \otimes r
                    \&amp;
                    \\;=\;
                    1
                    \\,\otimes\,
                    \\big( \tfrac{1}{p} \cdot q \big)
                    \\\
                    \&amp; \;=\;
                    \\big( \tfrac{1}{p} \cdot p \big)
                    \\,\otimes\,
                    \\big( \tfrac{1}{p} \cdot q \big)
                    \\\
                    \&amp; \;=\;
                    \\tfrac{1}{p}
                    \\,\otimes\,
                    \\big(
                    p \cdot \tfrac{1}{p} \cdot q
                    \\big)
                    \\\
                    \&amp; \;=\;
                    \\tfrac{1}{p}
                    \\,\otimes\,
                    \\big(
                    q \cdot 1
                    \\big)
                    \\\
                    \&amp; \;=\;
                    \\big(
                    \\tfrac{1}{p} \cdot q
                    \\big)
                    \\,\otimes\,
                    1
                    \\\
                    \&amp; \;=\;
                    r \,\otimes\, 1
                    \\;\;\;\;\;\;
                    \\in
                    \\;
                    \\mathbb{Q} \otimes_{{}_{\mathbb{Z}}} \mathbb{Q}
                    \\,.
                    \\end{aligned}
            %p
              Here the third and the fifth line use the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              defining the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
              for the case of rings:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ⊗
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi n
                    %mo ⋅
                    %msub
                      %mi r
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
