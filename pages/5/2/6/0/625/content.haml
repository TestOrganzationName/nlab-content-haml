                          %msup
                            %mi i
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo )
                      %annotation{:encoding => "application/x-tex"} l_{x'}(i) \circ f(r) \circ l_{x}\left(i^{-1}\right)
            %p
              It is immediately checked that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                  %annotation{:encoding => "application/x-tex"} l
              is well-defined, is indeed a functor, and fits into the required commutative diagram.
            %p
          %h2#properties Properties
          %h3#general General
          %p
            Isofibrations have a number of good properties. For example, any
            %a.existingWikiWord{:href => "/nlab/show/strict+2-limit"} strict pullback
            of an isofibration is also a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-limit"} weak pullback
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/canonical+model+structures"} canonical model structures
            = succeed ".)" do
              %a{:href => "#AsFibrationsInCanonicalModelStructures"} below
          %p
          #GrothendieckFibrationsAreIsofibrations.num_remark
            %h6 Example
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
              or opfibration is an isofibration (take the lifts to be the Cartesian lifts), but not in general conversely, unless
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
          %p
          #GrothIsIsoFibBetweenGroupoids.num_remark
            %h6 Example
            %p
              For
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo ,
                    %mi ℬ
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}, \mathcal{B} \,\in\,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi ℰ
                    %mo →
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} P \,\colon\, \mathcal{E} \to \mathcal{B}
              the following are equivalent:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                  is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/isofibration"} isofibration
            %p
          .proof
            %h6 Proof
            %p
              The implication
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi IsoFib
                    %mo ⇒
                    %mi GrothFib
                  %annotation{:encoding => "application/x-tex"} IsoFib \Rightarrow GrothFib
              is Ex.
              = succeed "." do
                %a.maruku-ref{:href => "#GrothendieckFibrationsAreIsofibrations"}
            %p
              Conversely, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is an isofibration, it is sufficient to show that any of the lifts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              it provides is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              More explicitly (in the notation
              = succeed ")" do
                %a{:href => "Grothendieck+fibration#CartesianMorphism"} there
              %svg{:height => "134.33pt", :version => "1.2", :viewbox => "0 0 202.682 134.33", :width => "202.682pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
