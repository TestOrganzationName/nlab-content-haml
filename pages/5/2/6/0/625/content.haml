                %annotation{:encoding => "application/x-tex"} F: E \rightarrow B
            between
            %a.existingWikiWord{:href => "/nlab/show/category"} categories
            such that every
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            can be ‘lifted’ to an isomorphism in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                  %annotation{:encoding => "application/x-tex"} F(g) = f
          %p
            Alternatively, an isofibration is the analogue of a
            %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibration"} Hurewicz fibration
            for the
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Cat
                  %annotation{:encoding => "application/x-tex"} \mathsf{Cat}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} category of categories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/free-standing+isomorphism"} free-standing isomorphism
          %p It is the second of these definitions that often generalises better to higher categories.
          %p
          %h2#section_Definition Definition
          %p
          .num_defn
            %h6 Definition
            %p
              An
              %strong isofibration
              is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi E
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p:E\to B
              such that for any
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              and any
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %mi b
                    %annotation{:encoding => "application/x-tex"} \phi:p(e) \cong b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo :
                    %mi e
                    %mo ≅
                    %mi e
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \psi:e \cong e'
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} p(\psi)=\phi
          %p
