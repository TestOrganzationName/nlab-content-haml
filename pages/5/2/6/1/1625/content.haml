        #revision
          %p
            Here are notes by
            %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
            for Thursday, June 11, from
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Oberwolfach+Workshop%2C+June+2009+--+Strings%2C+Fields%2C+Topology"} Oberwolfach
          %h2#henriques_invertible_conformal_nets Henriques: Invertible conformal nets
          %p
            André Henriques has notes on this work available on
            = succeed ";" do
              %a{:href => "http://www.math.uu.nl/people/henrique/"} his website
          %ul
            %li
              Chris Douglas, André Henriques, Michael Hill,
              %em
                Geometric String structures – notes on
                = succeed "-graded" do
                  %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              (
              %a{:href => "http://www.math.uu.nl/people/henrique/TringWP.ps"}> ps
              )
          %p today: classification of invertible objects in a 3-category
          %p
            %strong theorem
            (André Henriques, Arthur Bartels, Chris Douglas):
            %em Conformal nets form the objects of a symmetric monoidal 3-category CN3
            \.
          %ul
            %li there is something about this written up to be found on Henriques’ webpage.
          %p
            %strong definition
            A conformal net is a
            %a.existingWikiWord{:href => "/nlab/show/factorization+algebra"} factorization algebra
            on the category of 1-dimensional balls with values in von Neumann algebras.
          %ul
            %li
              %p 1-dim ball is just an interval, of course
            %li
              %p so a conformal net associates to each interval a vN algebra, and for each inclusion of intervals there is an inclusion of vN algebras
          %p
            for
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ,
                  %mi J
                %annotation{:encoding => "application/x-tex"} I, J
            two intervals equipped with an embedding into interval
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            the net assigns
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_4.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo ,
                  %mi K
                  %mo ⊂
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A : (J,K \subset I) \mapsto (A(J) \otimes A(K) \to A(I))
          %blockquote
            %p Freed: why do you call this conformal ?
            %p André: (as far as I understand the reply he gives after my question) the usual covariance condition under Moebius group imposed on conformal nets is taken care of here by havin not intervals in the real line on the line but abstract intervals with maps between them being embeddings. The claim is that this automatically implies the right kind of covariance that is otherwise imposed by hand.
          %p
            %strong claim
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_5.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi unitary
                  %mi full
                  %mi CFTs
                  %mo{:stretchy => "false"} }
                  %mo ≃
                  %mo{:stretchy => "false"} {
                  %mi conformal
                  %mi nets
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\{unitary full CFTs\} \simeq \{conformal nets\}
          %blockquote
            %p
              question: do you really mean
              %em full
              instead of
              %em chiral
              CFTs on the right?
            %p answer: yes
          %p symmetric monoidal structure is objectwise the tensor product
          %p
            %strong theorem
            aa conformal net
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is invertible in CN3 iff its
            = succeed "-index" do
              %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mu(A)
            equals 1.
          %p
            It is fully dualizable iff
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo &lt;
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \mu(A) \lt \infty
          %p
            in general
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo ∪
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mu(A) \in \{0\} \cup [1, \infty]
          %h3#von_neumann_algebras von Neumann algebras
          %p in the 2-category of vN algebras, a morphism
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_11.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"}
                  A \to B
          %p
            is a bimodule
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi A
                  %msub
                    %mi H
                    %mi B
                %annotation{:encoding => "application/x-tex"} {}_A H_B
            where
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is a Hilbert space
          %p the unit
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_14.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mi A
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  Id_A : A \to A
          %p
            is given by the bimodule called
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L^2(A)
          %p
            this comes from the following: if
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a measure space and
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            arises as
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L^\infty(X)
            then
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L^2(A)
            is
            = succeed "." do
              %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L^2(X)
          %p
            the general
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L^2(A)
            is a non-commutative analog of this construction, for
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            which are not of the form “measurable functions on a measure space”.
          %p One word about composition, if
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_23.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo →
                    %mi H
                  %mi B
                  %mover
                    %mo →
                    %mi K
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  A \stackrel{H}{\to} B  \stackrel{K}{\to} C
          %p
            given by
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %msub
                    %mo ⊗
                    %mi Connes
                  %mi K
                %annotation{:encoding => "application/x-tex"} H \otimes_{Connes} K
            is the Connes-Fusion operation
          %p
            associated to
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi A
                  %msub
                    %mi H
                    %mi B
                %annotation{:encoding => "application/x-tex"} {}_A H_B
            is
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_26.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mo{:stretchy => "false"} (
                  %msub
                    %mrow
                    %mi A
                  %msub
                    %mi H
                    %mi B
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo ∪
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  dim({}_A H_B) \in \{0\} \cup [1,\infty]
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_27.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi iff
                            %mi H
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mi iff
                            %mi H
                            %mi is
                            %mi invertible
                        %mtr
                          %mtd
                            %mo &lt;
                            %mn ∞
                          %mtd
                            %mi iff
                            %mi H
                            %mi has
                            %mi a
                            %mi dual
                %annotation{:encoding => "application/x-tex"}
                  dim = \left\{
                  \\array{
                  0 &amp; iff H=0
                  \\\
                  1 &amp; iff H is invertible
                  \\\
                  \\lt \infty &amp; iff H has a dual
                  }
                  \\right.
          %p
            %strong fact
            think of an interval
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            as the upper semicircle. The two actions of
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A(I)
            on
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 0
                  %mo =
                  %msup
                    %mi L
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_0 = L^2(A(I))
            can be used to define an action of
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A(J)
            on
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 0
                %annotation{:encoding => "application/x-tex"} H_0
            for every
            = succeed "." do
              %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} usbset
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} J \usbset S^1
          %p
            Because if
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            is in the upper semicircle, use the left action, if in the lowwer semicircle use the right action, if it is neither, do something else (not explained here)
          %p
            so
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 0
                %annotation{:encoding => "application/x-tex"} H_0
            has an action of
            = succeed "." do
              %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(S^1)
          %p so now everything is invariant projectively with respect to diffeomorphism group
          %p
            %strong definition
          %p
            given two circles
            = succeed "," do
              %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi a
                    %mo ,
                    %msub
                      %mi S
                      %mi b
                  %annotation{:encoding => "application/x-tex"} S_a, S_b
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi nw
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} nw(S_a)
            be north west quarter cicle, etc
          %p
            consider
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 0
                %annotation{:encoding => "application/x-tex"} H_0
            as a bimodule over
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_40.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi sw
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ne
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A(sw(S_a)) \otimes A(ne(S_a))
          %p and
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_41.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi nw
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi se
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A(nw(S_b)) \otimes A(se(S_b))
          %p
            claim:
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi dim
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi H
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mu(A) = dim(H_0)
          %p now some ideas on the proof of the first theorem
          %p define always
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_43.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi I
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo =
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi I
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\bar A(I) = A(I)^{op} = A(\bar I)
          %ul
            %li
              %p
                if
                %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is dualizable, then
                %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} \bar A
                is its dual
            %li
              %p
                if
                %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is invertible, then
                %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} \bar A
                is its inverse
          %p
            a 1-morphism in CN3, to be called a
            %em defect
            is
          %p consider the category of bi-colored 1-dimensional manifold is a 1-d manifolds (decomposition into intervals labeled by two things) with morphisms being color-preserving maps
          %p sufficient to look at intervals
          %ul
            %li
              %p completely blue
            %li
              %p half blue, half orange
            %li
              %p completely orange
          %p now a defect/1-morphism is a conformal net as above on bi-colored 1d manifolds
          %p so suppose three nets and two defects
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_48.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo →
                    %mi D
                  %mi B
                  %mover
                    %mo →
                    %mi E
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  A \stackrel{D}{\to} B \stackrel{E}{\to} C
          %p then define the composition defect net by
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_49.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ⊗
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi blue
                  %mo −
                  %mi interval
                  %mi glued
                  %mi to
                  %mi yellow
                  %mi interval
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi insert
                  %mi orange
                  %mi interval
                  %mi in
                  %mi the
                  %mi middle
                  %mi and
                  %mi average
                  %mi over
                  %mi all
                  %mi local
                  %mi evaluations
                %annotation{:encoding => "application/x-tex"}
                  D \otimes E ( blue-interval glued to yellow interval)
                  \=
                  insert orange interval in the middle and average over all local evaluations
          %p the diffeomorphism group of the orange interval does act on the space of all possible compositions here, which one shows to all be coherently isomorphic
          %p now construct a defect
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_50.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo :
                  %mi A
                  %mo ⊗
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"}
                  D:  A \otimes \bar A \to 1
          %p by setting
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_51.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi interval
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi bent
                  %mo −
                  %mi around
                  %mi interval
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  D(interval)
                  \:= A(bent-around interval)
          %p (whatever that means)
          %h2#henriques_informal_evening_session Henriques: informal evening session
          %p things we could talk aout:
          %ul
            %li
              %p composition of defects
            %li
              %p examples of conformal nets
            %li
              %p
                %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                \-graded version of all that
          %blockquote
            %p Mike Hopkins: could we talk about relation full CFT to chiral CFT?
          %h3#examples_for_conformal_nets examples for conformal nets
          %ul
            %li from the standard chiral positive energy nets that are usually called “conformal nets” in the literature we get the more general considered here by tensoring two chiral bits (“left” and “right”) and choosing an extension
          %p examples can be obtained as follows
          %ul
            %li
              %p
                loop group nets (
                %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                      %mo →
                      %mover
                        %mrow
                          %mi L
                          %mi G
                        %mo{:stretchy => "false"} ˜
                      %mo →
                      %mi L
                      %mi G
                    %annotation{:encoding => "application/x-tex"} S^1 \to \tilde {L G} \to L G
                )
            %li
              %p integral lattice
              %ul
                %li
                  %p moonshine net: take the Leech lattice and do some orbifolding
                  %ul
                    %li its full automorphism group is isomorphic to the Monster
            %li
              %p free fermion
            %li
              %p minimal model = Virasoro
          %p general remarks:
          %ul
            %li
              %p
                recall the Hillber space
                %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} H_0
                obtained from the full cnformal net as the algebra of the upper semi circle
            %li
              %p
                but in practice one first constructs
                %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} H_0
                and then from that the net
            %li
              %p a functor
              .maruku-equation
                %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_56.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo {
                        %mi subintervals
                        %mi of
                        %msup
                          %mi S
                          %mn 1
                        %mo ,
                        %mi diffeos
                        %mi between
                        %mi them
                        %mo }
                      %mo →
                      %mi V
                      %mi N
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      subintervals of S^1,
                      diffeos between them
                      \\right\}
                      \\to V N
              %p is already the same as a functor on all abstract intervals, since that category is equivalent to intervals in the circle
          %p
            so given an interval
            = succeed "," do
              %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_58.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ↦
                  %mi Maps
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mo ∂
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi e
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  I \mapsto Maps((I, \partial I), (G, \{e\}))
          %p
            if
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            happens to be thought of as embedded in the circle, then this group could be identified with the subgroup of the loop group whose elements send the complement of
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            to
            = succeed "." do
              %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_61.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
          %p
            but the point is there is way to get a conformal net here without assuming embedding into
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_62.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
          %p
            so the algebra we will assign to
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is just the group algebra
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_64.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ↦
                  %mi 𝒞
                  %mo{:stretchy => "false"} (
                  %mi Maps
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mo ∂
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi e
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  I \mapsto \mathcal{C}(Maps((I, \partial I), (G, \{e\}))]
          %p
            forgetting all topology, but this still depends on the central extension and it sits densely in the vN algebra obtained by taking the group, letting it act on the vacuum in the Hilbert space
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_65.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 0
                %annotation{:encoding => "application/x-tex"} H_0
            through a rep of
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_66.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mi L
                      %mi G
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde {L G}
          %p
            so
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_67.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A(I)
            is now defined to be the completion of that algebra in
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_68.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi H
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(H_0)
          %p this here gives a chiral theory
          %blockquote
            %p audience: one should think of intervals here as thickened points and of the vN algebras as what is assigned to the point in an extended CFT
          %h3#algebra_assigned_to_the_circle algebra assigned to the circle
          %p here is how to get the algebra assigned to the circle:
          %p
            puff up the circle to an annulus, cut this vertically in two pieces; call the two intervals where the cut goes
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_69.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            and
            = succeed "," do
              %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_70.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
          %p
            let
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_71.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 0
                %annotation{:encoding => "application/x-tex"} H_0
            be the Hilbert space assigned to the boundary circles of the two pieces of the cut annulus. Then the algebra in question is the Connes fusion product of
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_72.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 0
                %annotation{:encoding => "application/x-tex"} H_0
            with itself over
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_73.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A(I) \otimes A(J)
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_74.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi circle
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi H
                    %mn 0
                  %msubsup
                    %mo ⊗
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo{:stretchy => "false"} )
                    %mi Connes
                  %msub
                    %mi H
                    %mn 0
                %annotation{:encoding => "application/x-tex"}
                  A(circle) := H_0 \otimes^{Connes}_{A(I) \otimes A(J)} H_0
          %blockquote
            %p audience: so the circle doesn’t really appear in this formula, it’s just a thing to help us think about this
            %p answer: yes
          %p now recall the definition of tensor product of nets
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_75.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mi A
                    %mo ⊗
                    %msup
                      %mi A
                      %mi op
                    %mo )
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi I
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  A \otimes A^{op}
                  \\right)(I)
                  \:=
                  A(I) \otimes A(I)^{op}
          %p
            then consider extensions
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_76.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            of nets of the following form
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_77.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊗
                  %msup
                    %mi A
                    %mi op
                  %mo ↪
                  %mi B
                %annotation{:encoding => "application/x-tex"}
                  A \otimes A^{op} \hookrightarrow B
          %p
            such is cooked up from every Frobenius algebra object
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_78.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            in
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_79.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rep
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊗
                  %msup
                    %mi A
                    %mi op
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Rep(A \otimes A^{op})
            (in vN theorists jargon this is a “
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_80.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            \-system”)
          %p
            in the 3-category VN3 this
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_81.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rep
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Rep(A)
            can be written as
          .maruku-equation
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_82.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rep
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi End
                    %mrow
                      %mi VN
                      %mn 3
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Id
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                            %mo ↘
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %msup
                              %mo ⇓
                              %mi ρ
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                            %mo ↗
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  Rep(A)
                  \=
                  End_{VN3}(Id_A)
                  \=
                  \\left\{
                  \\array{
                  \&amp; \nearrow \searrow
                  \\\
                  A &amp;\Downarrow^{\rho}&amp; A
                  \\\
                  \&amp; \searrow \nearrow
                  }
                  \\right\}
          %p
            to the circle
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_83.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            assigns
            %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_84.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
          %h2#schreiber Schreiber
          %p detailed notes with further links and backgeound information are here:
          %ul
            %li
              %a.existingWikiWord{:href => "/schreiber/show/Background+fields+in+twisted+differential+nonabelian+cohomology"} Background fields in twisted differential nonabelian cohomology
          %p
            The point of this is to define a notion of twisted differential nonabelian cohomology for every fibration sequence of smooth
            = succeed "-groupoids" do
              %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_85.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p We now
          %ul
            %li
              %p
                list fibration sequence of smooth
                = succeed "-groupoids" do
                  %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_86.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            %li
              %p and indicate properties of the corresponding differential twisted nonabelian cohomology
          %p
            %strong Examples / Claim
          %ul
            %li
              %p
                fibration sequence:
                %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_87.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi PU
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mn 2
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}U(n) \to \mathbf{B} PU(n) \to \mathbf{B}^2 U(1)
              %ul
                %li
                  %p twisting cocycle: lifting gerbe;
                %li
                  %p twisted cocycle: twisted bundles / gerbe modules
                %li
                  %p
                    twisted Bianchi identity:
                    %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_88.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %msub
                            %mi F
                            %mo ∇
                          %mo =
                          %msub
                            %mi H
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} d F_\nabla = H_3
                %li
                  %p
                    occurence: Freed-Witten anomaly cancellation on
                    %a.existingWikiWord{:href => "/nlab/show/brane"} D-brane
            %li
              %p
                fibration sequence:
                %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_89.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi String
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %mfrac
                            %mn 1
                            %mn 2
                          %msub
                            %mi p
                            %mn 1
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mn 3
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}String(n) \to \mathbf{B} Spin(n) \stackrel{\frac{1}{2}p_1}{\to} \mathbf{B}^3 U(1)
              %ul
                %li
                  %p twisting cocycle: Chern-Simons 2-gerbe;
                %li
                  %p twisted cocycle: twisted nonabelian String-gerbe with conection
                %li
                  %p
                    twisted Bianchi identity:
                    %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_90.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %msub
                            %mi H
                            %mn 3
                          %mo ∝
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi F
                            %mo ∇
                          %mo ∧
                          %msub
                            %mi F
                            %mo ∇
                          %mo{:stretchy => "false"} ⟩
                        %annotation{:encoding => "application/x-tex"} d H_3 \propto \langle F_\nabla \wedge F_\nabla \rangle
                %li
                  %p
                    occurence:
                    %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz anomaly cancellation
                %li
                  %p Proof.
                  %ul
                    %li
                      %p
                        (with Danny Stevenson and Christoph Wockel: (
                        %a{:href => "http://www.math.uni-hamburg.de/home/schreiber/nactwist.pdf"}> SSSS
                        )) use BCSS model (
                        %a{:href => "http://arxiv.org/abs/math/0504123"}> BCSS
                        ) of
                        %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_91.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi String
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} String(n)
                        with
                        %a{:href => "http://golem.ph.utexas.edu/category/2008/02/construction_of_cocycles_for_c.html"} Brylinski-McLaughlin construction
                        of
                        %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_92.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mfrac
                                %mn 1
                                %mn 2
                              %msub
                                %mi p
                                %mn 1
                            %annotation{:encoding => "application/x-tex"} \frac{1}{2}p_1
                    %li
                      %p
                        (using (
                        %a{:href => "http://arxiv.org/abs/0801.3480"}> SaScSt I
                        ,
                        = succeed "):)" do
                          %a{:href => "http://www.math.uni-hamburg.de/home/schreiber/5twist.pdf"} SaScSt III
                        = succeed "-groupoids" do
                          %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_93.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mn ∞
                              %annotation{:encoding => "application/x-tex"} \infty
                        %a.existingWikiWord{:href => "/nlab/show/Lie+infinity-algebroid"} L-infinity algebroids
                        using the formalism of (
                        %a{:href => "http://arxiv.org/abs/0801.3480"}> SaScSt I
                        )
                %li
                  %p for aspects of the twisted case see also
                  %ul
                    %li
                      %p
                        %a{:href => "http://arxiv.org/abs/hep-th/0409200"} AsJu
                    %li
                      %p
                        for aspects of the untwisted case see also (
                        %a{:href => "http://arxiv.org/abs/0906.0117"}> Wa
                        )
            %li
              %p
                fibration sequence:
                %math#mathml_e5df8e3c24030c184b8269fae78784510b6ba147_94.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi Fivebrane
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
