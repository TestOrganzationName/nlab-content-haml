          %h2#definition Definition
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/univalent+type+theory"} univalent type theory
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pushout+types"} pushout types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an
            %strong acyclic type
            if its
            %a.existingWikiWord{:href => "/nlab/show/suspension+type"} suspension type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mi A
                %annotation{:encoding => "application/x-tex"} \Sigma A
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+theorem"} Whitehead's principle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is acyclic if its reduced integral homology vanishes.
