                = succeed ")" do
                  %a{:href => "https://www.phys.uniroma1.it/fisica/sites/default/files/allegati/Risoli_0.pdf"} pdf
          %h3#tfolds T-Folds
          %p
            %a.existingWikiWord{:href => "/nlab/show/T-folds"}> T-folds
            \:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chris+Hull"}> Chris Hull
                ,
                %em A Geometry for Non-Geometric String Backgrounds
                (
                %a{:href => "https://arxiv.org/abs/hep-th/0406102"}> arXiv:hep-th/0406102
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chris+Hull"}> Chris Hull
                ,
                %em Global Aspects of T-Duality, Gauged Sigma Models and T-Folds
                (
                %a{:href => "http://arxiv.org/abs/hep-th/0604178"}> arXiv:hep-th/0604178
                )
            %li
              %p
                Aaron Bergman, Daniel Robbins,
                %em Ramond-Ramond Fields, Cohomology and Non-Geometric Fluxes
                (
                %a{:href => "http://arxiv.org/abs/0710.5158"}> arXiv:0710.5158
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dieter+L%C3%BCst"}> Dieter Lüst
                , Stefano Massai, Valentí Vall Camell,
