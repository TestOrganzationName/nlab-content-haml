                  over the
                  %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  whose total space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  is equipped with a
                  %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
                  %a.existingWikiWord{:href => "/nlab/show/involution"} involution
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mtext -
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %mi E
                        %mo →
                        %mi E
                      %annotation{:encoding => "application/x-tex"} (\text{-})^\ast \,\colon\, E \to E
            %p such that:
            %ol
              %li
                %p
                  the bundle projection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ℤ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/equivariant+map"} equivariant map
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi E
                              %mtd
                                %mover
                                  %mo ⟶
