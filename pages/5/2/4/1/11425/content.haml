                        \\,\colon\,
                        X \longrightarrow X
                        ,\;\;\;\;\;
                        \\sigma \circ \sigma = id_X
            %p
              is (according to
              = succeed "):" do
                %a{:href => "#Atiyah66"} Atiyah 1966 p. 368
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundle"} complex vector bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:lspace => "verythinmathspace"} :
