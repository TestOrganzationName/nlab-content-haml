                        }
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of such Real vector bundles is a homomorphism of the underlying complex vector bundles which respects all the involutions.
          %p
          .num_remark
            %h6 Remark
            %p
              The complex numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              equipped with their
              %a.existingWikiWord{:href => "/nlab/show/involution"} involution
              by
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              under their usual multiplication operation form a
              %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
              to the category of
              = succeed "-vector" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              = succeed "\u201D" do
                %a{:href => "Hermitian+form#RealComplexNumbers"} Real numbers
            #eq:RealComplexNumbers.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ↷
                    %mi ℂ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi Mon
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ,
                    %msub
                      %mi Mod
                      %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}_2 \curvearrowright \mathbb{C}
                    \\;\;\;
                    \\in
                    \\;\;
                    Mon\big(
                    Func(\mathbf{B}\mathbb{Z}_2, Mod_{\mathbb{R}})
                    \\big)
                    \\,.
            %p
              The Real vector bundles of Def.
              %a.maruku-ref{:href => "#AtiyahRealVectorBundle"}
              are equivalently the vector bundles
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
              to the
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %a.existingWikiWord{:href => "/nlab/show/G-set"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2 Set
              with the “
              %a.existingWikiWord{:href => "/nlab/show/ground+ring"}> ground monoid
              ” taken to be the Real numbers
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:RealComplexNumbers"} (1)
          %p
          #RealVectorBundlesAsRealVectorBundles.num_remark
            %h6 Example
            %p
              %strong (real vector bundles as Real vector bundles)
              %br/
              In the special case that the involution on the base space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is trivial,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo =
                      %msub
                        %mi id
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \sigma = id_X
              %a.maruku-ref{:href => "#AtiyahRealVectorBundle"}
              is a complex vector bundle over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped continuously with a complex
              %a.existingWikiWord{:href => "/nlab/show/anti-linear+map"} anti-linear
              involution on each fiber
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mtext -
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi E
                        %mi x
                      %mo →
                      %msub
                        %mi E
                        %mi x
                    %annotation{:encoding => "application/x-tex"} (\text{-})^\ast \,\colon\, E_x \to E_x
            %p
              The resulting
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ±
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \pm 1
              = succeed "-decomposition" do
                %a.existingWikiWord{:href => "/nlab/show/eigenspace"} eigenspace
              %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi V
                      %mi x
                    %mo ⊕
                    %mi{:mathvariant => "normal"} i
                    %msub
                      %mi V
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi V
                      %mi x
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    E_x
                    \\;\simeq\;
                    V_x \oplus \mathrm{i} V_x
                    \\;\simeq\;
                    V_x \otimes_{\mathbb{R}} \mathbb{C}
            %p
              of a
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                \-vector space
              and this decomposition is preserved by homomorphisms of Real vector bundles over such
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Therefore the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of Real vector bundles over a
              %a.existingWikiWord{:href => "/nlab/show/Real+space"} Real space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              whose
              %a.existingWikiWord{:href => "/nlab/show/involution"} involution
              is trivial is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to that of plain real vector bundles over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as
              = succeed "." do
                %a{:href => "#PlainNotion"} above
              = succeed ")" do
                %a{:href => "#Atiyah66"} Atiyah 1966, p. 369
            %p
              In fact, more is true: the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of Real vector bundles on all objects whose base carries the trivial
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              %a.existingWikiWord{:href => "/nlab/show/VectBund"} VectBund
              of real vector bundles over varying base spaces
            #eq:RealVectorBundlesOverVaryingBaseSpaces.maruku-equation
              %span.maruku-eq-number (2)
