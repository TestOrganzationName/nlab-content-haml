                              %mtd
                              %mtd
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msup
                                      %mrow
                                      %mi p
                            %mtr
                              %mtd
                                %mi X
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mi σ
                              %mtd
                                %mi X
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        E &amp;\overset{(\text{-})^\ast}{\longrightarrow}&amp; E
                        \\\
                        \\mathllap{{}^p}\big\downarrow
                        \&amp;&amp;
                        \\big\downarrow\mathrlap{{}^p}
                        \\\
                        X &amp;\underset{\sigma}{\longrightarrow}&amp; X
                        }
              %li
                %p
                  the involution on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  is
                  = succeed "-wise" do
                    %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/anti-linear+map"} anti-linear
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  the following
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi ℂ
                                %mo ×
                                %msub
                                  %mi E
                                  %mi x
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mtext -
                                    %mo{:stretchy => "false"} )
                                    %mo ⋅
                                    %mo{:stretchy => "false"} (
                                    %mtext -
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %msub
                                  %mi E
                                  %mi x
                            %mtr
                              %mtd
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msup
                                      %mrow
                                      %mrow
                                        %mover
                                          %mrow
                                            %mo{:stretchy => "false"} (
                                            %mtext -
                                            %mo{:stretchy => "false"} )
                                          %mo ¯
                                        %mo ×
                                        %mo{:stretchy => "false"} (
                                        %mtext -
                                        %msup
                                          %mo{:stretchy => "false"} )
                                          %mo *
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mtd
                              %mtd
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                                %mpadded{:width => "0"}
