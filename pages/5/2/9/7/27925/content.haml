          %h2#idea Idea
          %p
            An
            %strong exponentiable morphism
            (sometimes called a
            = succeed ")" do
              %strong powerful morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f \colon A \to B
            in a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            that is
            %a.existingWikiWord{:href => "/nlab/show/exponentiable+object"} exponentiable
            as an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            of the
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} /
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}/B
            %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            exist, giving rise to a
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo :
                    %mi 𝒞
                    %mo{:stretchy => "false"} /
                    %mi B
                    %mo →
                    %mi 𝒞
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f^* : \mathcal{C}/B \to \mathcal{C}/A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            to have a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi f
                  %mo :
                  %mi 𝒞
                  %mo{:stretchy => "false"} /
                  %mi A
                  %mo →
                  %mi 𝒞
                  %mo{:stretchy => "false"} /
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Pi_f : \mathcal{C}/A \to \mathcal{C}/B
            (called the
            = succeed ")," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            is explicitly described by that of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/distributivity+pullback"} distributivity pullback
          %h2#relation_to_exponentiable_objects Relation to exponentiable objects
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            has a
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an object in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo !
                    %mi X
                  %mo :
                  %mi X
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} !_X : X \to 1
            is exponentiable, then, for every object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            for which the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \times Y
            exists, the
            %a.existingWikiWord{:href => "/nlab/show/exponentiable+object"} exponentiable object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Y
                    %mi X
