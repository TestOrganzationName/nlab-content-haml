                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi z
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
