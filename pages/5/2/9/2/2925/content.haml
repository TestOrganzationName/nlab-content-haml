                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi b
                        %mo −
                        %mi a
                        %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mn 2
                          %mrow
                            %mi m
                            %mo +
                            %mn 1
                    %mo &lt;
                    %mfrac
                      %mi δ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \frac{\vert b - a \vert}{2^{m + 1}} \lt \frac{\delta}{2}
            %p
              If there exists a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
