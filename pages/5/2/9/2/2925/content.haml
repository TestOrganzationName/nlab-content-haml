              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \vert f(c_j) \lt \epsilon
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi m
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f(a_m) \lt 0
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
