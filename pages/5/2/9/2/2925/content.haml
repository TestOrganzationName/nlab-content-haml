          .proof
            %h6 Proof
            %p
              We construct
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+cuts"} Dedekind cuts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} |
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} L = \{y \in [0,1] \vert f(y) \lt 0\}
              and
