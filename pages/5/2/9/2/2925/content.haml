                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi b
                            %mrow
                              %mi m
                              %mo +
                              %mn 1
                          %mo &gt;
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} b_{m + 1} \gt 0
              %li
                %p
                  If
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi f
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi c
                            %mi m
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} |
                          %mo &gt;
                          %mi ϵ
                        %annotation{:encoding => "application/x-tex"} \vert f(c_m) \vert \gt \epsilon
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                        %mo ≤
                        %mi m
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} j \leq m + 1
                  such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi f
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi c
                            %mi j
                          %mo{:stretchy => "false"} )
                          %mo &lt;
                          %mi ϵ
                        %annotation{:encoding => "application/x-tex"} \vert f(c_j) \lt \epsilon
            %p Thus, the above lemma is true.
            %p
              Now, by pointwise continuity at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              be such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi x
                    %mo −
                    %mi y
                    %mo{:stretchy => "false"} |
