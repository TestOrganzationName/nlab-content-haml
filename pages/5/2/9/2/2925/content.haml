                      %mi m
                    %mo{:stretchy => "false"} |
                    %mo &lt;
                    %mo{:stretchy => "false"} |
                    %mi c
                    %mo −
                    %msub
                      %mi c
                      %mi m
                    %mo{:stretchy => "false"} |
