                      %msup
                        %mi Σ
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} /
                      %mi 𝕊
                    %annotation{:encoding => "application/x-tex"} fib\big( \Sigma^{n} e^E \big) \,\simeq\, \Sigma^{n-1} (E/\mathbb{S}
