          %h2#idea Idea
          %p Let
          #eq:TheMap.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mi X
                  %mover
                    %mo ⟶
                    %mi f
                  %mi Y
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\big[
                  X \overset{f}{\longrightarrow} Y
                  \\big]
          %p
            be a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            in the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            (for instance the
            %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
            of a morphism in the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be a
            %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology+theory"} Whitehead-generalized cohomology theory
            (usually assumed to be at least
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative
          %p
            Then the
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              \-invariant of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            (
            %a{:href => "#Adams66"}> Adams 66, Sec. 3, p. 26
            , short for “degree invariant”, see Example
            %a.maruku-ref{:href => "#DInvariantSpecializesToDegreeOfAContinuousFunction"}
            below) is the class of the corresponding
            %a.existingWikiWord{:href => "/nlab/show/pullback+in+cohomology"} pullback
            morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi f
                      %mi E
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast_E
            %a.existingWikiWord{:href => "/nlab/show/Ext-group"} Ext-group
            (i.e. the plain
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
            = succeed "-cohomologies" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          #eq:ThePullbackInECohomology.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi f
                    %mi E
                    %mo *
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ext
                    %mn 0
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ;
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d(f)
                  \\;\coloneqq\;
                  f^\ast_E
                  \\;\in\;
                  \\big(
                  E^\bullet(Y);
                  \\,
                  E^\bullet(X)
                  \\big)
                  \\;=\;
                  Ext^0
                  \\big(
                  E^\bullet(Y);
                  \\,
                  E^\bullet(X)
                  \\big)
                  \\,.
          %p
            The fancy name is justified by the fact that this is beginning of a hierarchy of more interesting invariants of stable maps seen in
            = succeed "-cohomology," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/e-invariant"} e-invariant
            %em
              %a.existingWikiWord{:href => "/nlab/show/f-invariant"} f-invariant
            (e.g.
            = succeed ")." do
              %a{:href => "#BL09"} BL 09, Section 2
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
