                  %annotation{:encoding => "application/x-tex"} [X,Y]_\bullet
          %h2#properties Properties
          %h3#RelationToHopfDegree Relation to the Hopf degree
          #DInvariantSpecializesToDegreeOfAContinuousFunction.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/d-invariant"} d-invariant
                specializes to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degree of a continuous function
            %p In the special case that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo =
                        %mi H
