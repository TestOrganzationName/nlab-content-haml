                        %mo +
                        %mi d
                        %mo −
                        %mn 1
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \Sigma^{n+d-1}\mathbb{S}
              to
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi fib
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
