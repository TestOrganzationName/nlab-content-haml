              %path#path2385{:d => "M 116.78571,250.16591 L 156.78571,206.23734", :style => "fill: none; fill-rule: evenodd; stroke: #000000; stroke-width: 1px; stroke-linecap: butt; stroke-linejoin: miter; stroke-opacity: 1;"}
