                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_n
            equipped with the quandle operation
            = succeed "," do
              %math#mathml_97d871a90076ba9ee1a41044592d45e7c6b1d091_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⊳
                    %mi b
                    %mo =
                    %mn 2
                    %mi b
                    %mo −
                    %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi mod
                    %mspace{:width => "thinmathspace"}
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \rhd b = 2b - a\,(mod\,n)
