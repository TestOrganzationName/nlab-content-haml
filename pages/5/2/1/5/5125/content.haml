                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (K)
            \:
            = succeed ";" do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
