          %p
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (N)
            , in the form,
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %msub
                    %mo ⋄
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mo ⊥
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \neg \Diamond_i(\bot)
          %p and monotonicity :
          %p
            if
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
