                      %mo ⋄
                      %mi i
                    %mi ψ
                    %mo →
                    %msub
                      %mo ⋄
                      %mi i
                    %mi χ
                    %mo ∈
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Diamond_i \psi \to \Diamond_i \chi \in \Lambda
          %p imply
          .un_lemma
            %h6#lemma Lemma
            %p
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_40.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mi i
                  %annotation{:encoding => "application/x-tex"} m_i
              is a normal operator.
          .proof
            %h6#proof Proof
            %p
              We first note that
              = succeed "," do
                %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
