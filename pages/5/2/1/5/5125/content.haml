          %h2#idea Idea
          %p
            The
            %strong Lindenbaum–Tarski algebra
            of a
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            in
            %a.existingWikiWord{:href => "/nlab/show/propositional+logic"} propositional logic
            is an algebraic (and order-theoretic) structure built out of its
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/formula"} formula
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connectives"} connectives
            %a.existingWikiWord{:href => "/nlab/show/free"} free
            such structure generated by the axioms of the theory.
          %h2#examples Examples
          %ul
            %li
              %p
                The Lindenbaum–Tarski algebra of a
                %a.existingWikiWord{:href => "/nlab/show/theory"} theory
                in
                %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic
                propositional logic is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Heyting+algebra"} Heyting algebra
            %li
              %p
                The Lindenbaum–Tarski algebra of a theory in classical propositional logic is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean algebra
          %h2#the_lindenbaumtarski_algebra_of_a_normal_modal_logic The Lindenbaum–Tarski algebra of a normal modal logic
          %p
            Associated to any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/normal+modal+logic"} normal modal logic
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                %annotation{:encoding => "application/x-tex"} \Lambda
            in
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mi ω
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{L}_\omega(n)
            (and more generally) is an algebra
            = succeed ",which" do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔄
                      %mi ω
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathfrak{A}^\Lambda_\omega
            %a.existingWikiWord{:href => "/nlab/show/algebraic+models+for+modal+logics"} BAO
            of type
            = succeed "," do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            (modal) operators,
            = succeed "." do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mi i
                  %annotation{:encoding => "application/x-tex"} m_i
            %strong Lindenbaum–Tarski algebra
            of
            = succeed "," do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
            %span.newWikiWord
              term algebra
              %a{:href => "/nlab/new/term+algebra"} ?
            of
            = succeed "," do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi ω
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}_\omega(n)
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            formed by the
            = succeed "-formulae" do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi ω
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}_\omega(n)
            = succeed "," do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∨
                  %annotation{:encoding => "application/x-tex"} \vee
            = succeed "," do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                  %annotation{:encoding => "application/x-tex"} \wedge
            = succeed "," do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \neg
            = succeed "," do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \bot
            = succeed "," do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
            = succeed "." do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋄
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \Diamond_i
            = succeed "," do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ≃
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \simeq_\Lambda
          .maruku-equation
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_18.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %msub
                    %mo ≃
                    %mi Λ
                  %mi ψ
                  %mo ⇔
                  %msub
                    %mo ⊢
                    %mi Λ
                  %mi ϕ
                  %mo ↔
                  %mi ψ
                  %mo .
                %annotation{:encoding => "application/x-tex"} \phi \simeq_\Lambda\psi  \iff  {\vdash}_\Lambda \phi\leftrightarrow \psi.
          %p
            (Recall the usual rules of notation:
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo →
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \phi \to \psi
            is
            = succeed ";" do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi ϕ
                    %mo ∨
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \neg\phi\vee\psi
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo ↔
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \phi\leftrightarrow \psi
            is
            = succeed ";" do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo →
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo →
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\phi\to \psi)\wedge (\psi\to\phi)
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊢
                    %mi Λ
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} {\vdash}_\Lambda \phi
            means
            = succeed ".)" do
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ∈
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \phi \in \Lambda
          %p
            The elements of
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝔄
                    %mi ω
                    %mi Λ
                %annotation{:encoding => "application/x-tex"} \mathfrak{A}^\Lambda_\omega
            are the equivalence classes:
          .maruku-equation
            %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_26.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo ‖
                    %mi ϕ
                    %mo ‖
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi ψ
