                  %msub
                    %mo ⊢
                    %mi Λ
                  %mi ϕ
                  %mo ↔
                  %mi ψ
                  %mo{:stretchy => "false"} }
                  %mo ,
                %annotation{:encoding => "application/x-tex"} {\left\|\phi\right\|} = \{\psi \mid \vdash_\Lambda \phi\leftrightarrow \psi\},
          %p with the operations
          %ul
            %li
              %p
                %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mrow
                        %mo ‖
                        %mi ϕ
                        %mo ‖
                      %mo +
                      %mrow
                        %mo ‖
                        %mi ψ
                        %mo ‖
                      %mo =
                      %mrow
                        %mo ‖
                        %mi ϕ
                        %mo ∨
                        %mi ψ
                        %mo ‖
                    %annotation{:encoding => "application/x-tex"} {\left\|\phi\right\|} + {\left\|\psi\right\|} = {\left\|\phi \vee \psi\right\|}
                ;
            %li
              %p
                %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mrow
                        %mo ‖
                        %mi ϕ
                        %mo ‖
                      %mo ⋅
                      %mrow
                        %mo ‖
                        %mi ψ
                        %mo ‖
                      %mo =
                      %mrow
                        %mo ‖
                        %mi ϕ
                        %mo ∧
                        %mi ψ
                        %mo ‖
                    %annotation{:encoding => "application/x-tex"} {\left\|\phi\right\|} \cdot {\left\|\psi\right\|}= {\left\|\phi \wedge \psi\right\|}
                ;
            %li
              %p
                %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi ϕ
                        %msup
                          %mo{:stretchy => "false"} ‖
                          %mo −
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mo ¬
                        %mi ϕ
                        %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} {\|\phi\|^-} = {\|\neg\phi\|}
                ;
            %li
              %p
                %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 0
