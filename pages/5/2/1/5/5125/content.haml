                        %mo{:stretchy => "false"} ‖
                        %mo ⊥
                        %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} 0 = {\|\bot\|}
                ;
            %li
              %p
                %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 1
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mo ⊤
                        %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} 1 = {\|\top\|}
                ;
          %p and
          %ul
            %li
              %math#mathml_ebb3fc64f7a6839b45ae0069647fc37fb84ecc20_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
