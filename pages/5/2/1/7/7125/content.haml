            %strong gluing construction
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %h2#the_toposic_case The toposic case
          %p
            Now suppose given
            %a.existingWikiWord{:href => "/nlab/show/topos"} toposes
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ′
                %annotation{:encoding => "application/x-tex"} E'
            and a
            %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \Phi \colon E \to E'
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ×
                  %mi E
                  %mo ′
                  %mover
                    %mo →
                    %mrow
                      %mi δ
                      %mo ×
                      %mn 1
                  %mi E
                  %mo ×
                  %mi E
                  %mo ×
                  %mi E
                  %mo ′
                  %mover
                    %mo →
                    %mrow
                      %mn 1
                      %mo ×
                      %mi Φ
                      %mo ×
                      %mn 1
                  %mi E
                  %mo ×
                  %mi E
                  %mo ′
                  %mo ×
                  %mi E
                  %mo ′
