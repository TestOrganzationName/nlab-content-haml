                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            %strong Artin gluing
            is a fundamental construction in
            %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            theory and
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            theory. The original example is the way in which a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            or
            %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            may be glued together from an
            %a.existingWikiWord{:href => "/nlab/show/open+subspace"} open subspace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi U
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} i \colon U \hookrightarrow X
            and its
            %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %mi K
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} j \colon K \hookrightarrow X
            %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(X)
            via a gluing together of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(U)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(K)
            %a.existingWikiWord{:href => "/nlab/show/open+geometric+morphism"} open
            %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
            and the other a
            %a.existingWikiWord{:href => "/nlab/show/closed+subtopos"} closed subtopos
            of the gluing.
          %h2#TheTopologicalCase The topological case
          %p Let us consider first the case of topological spaces. Let
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi U
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} i \colon U \hookrightarrow X
                an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/open+subspace"} open subspace
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo{:lspace => "verythinmathspace"} :
                      %mi K
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} j \colon K \hookrightarrow X
                the
                %a.existingWikiWord{:href => "/nlab/show/complement"} complementary
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(X)
            denote the topology of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/injective"} injective
            %a.existingWikiWord{:href => "/nlab/show/map"} map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ⟨
                          %msup
                            %mi i
                            %mo *
                          %mo ,
                          %msup
                            %mi j
                            %mo *
                          %mo{:stretchy => "false"} ⟩
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                        %mtd
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi K
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi V
                        %mtd
                          %mo ↦
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ∩
                          %mi V
                          %mo ,
                          %mi K
                          %mo ∩
                          %mi V
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\langle i^\ast, j^\ast \rangle
                  \&amp;\colon\;&amp;
                  O(X) &amp;\longrightarrow&amp; O(U) \times O(K)
                  \\\
                  \&amp;&amp;
                  V
                  \&amp;\mapsto&amp;
                  (U \cap V, K \cap V)
                  }
          %p
            that is a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/frame"} frames
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of this map: in terms of structure pertaining to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(U)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(K)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo ,
                  %mi W
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (W, W')
            of relatively open sets in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            “glue together” to form an open set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ∪
                  %mi W
                  %mo ′
                %annotation{:encoding => "application/x-tex"} W \cup W'
            in
            = succeed "?" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi int
                    %mi X
                  %mo{:lspace => "verythinmathspace"} :
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} int_X \colon P(X) \to P(X)
            denote the
            %a.existingWikiWord{:href => "/nlab/show/interior"} interior
            operation, assigning to a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            its interior. This is a
            %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are in
            %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            with
            %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
            %a.existingWikiWord{:href => "/nlab/show/comonads"} comonads
            on
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ∪
                  %mi W
                  %mo ′
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mo ↪
                    %mphantom
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi int
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo ∪
                  %mi W
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  W \cup W'
                  \\;\xhookrightarrow{\phantom{--}}\;
                  int_X(W \cup W')
          %p
            obtains. Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ∈
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W \in O(U)
            is already open when considered as a subset of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          #eq:ConditionOne.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ′
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mo ↪
                    %mphantom
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi int
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo ∪
                  %mi W
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  W'
                  \\;\xhookrightarrow{\phantom{--}}\;
                  int_X(W \cup W')
          .un_thm
            %h6#proposition Proposition
            %p
              A necessary and sufficient condition for
              %a.maruku-eqref{:href => "#eq:ConditionOne"} (1)
              is that the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ′
                    %mo ↪
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W' \hookrightarrow int_X(W \cup K)
              obtains.
          .proof
            %h6#proof Proof
            %p
              The necessity is clear since
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo ′
                      %mo ⊆
                      %mi K
                    %annotation{:encoding => "application/x-tex"} W' \subseteq K
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ′
                    %mo ∩
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ↪
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi W
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    W' \cap int_X(W \cup K)
                    \\;\xhookrightarrow{\phantom{--}}\;
                    int_X(W \cup W')
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} W'
              is relatively open in the subspace
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ′
                    %mo =
                    %mi K
                    %mo ∩
                    %mi V
                  %annotation{:encoding => "application/x-tex"} W' = K \cap V
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∈
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V \in O(X)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ∩
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ↪
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ∩
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (K \cap V) \cap int_X(W \cup K)
                    \\;\xhookrightarrow{\phantom{--}}\;
                    int_X(W \cup (K \cap V))
            %p
              or in other words – using distributivity and the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi int
                      %mi X
                  %annotation{:encoding => "application/x-tex"} int_X
              preserves intersections – an inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∩
                    %mi V
                    %mo ∩
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ↪
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K \cap V \cap int_X(W \cup K)
                    \\;\xhookrightarrow{\phantom{--}}\;
                    int_X(W \cup K) \cap int_X(W \cup V)
                    \\,.
            %p But this is clear, since we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∩
                    %mi V
                    %mo ∩
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ↪
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    K \cap V \cap int_X(W \cup K)
                    \\;\xhookrightarrow{\phantom{--}}\;
                    int_X(W \cup K)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∩
                    %mi V
                    %mo ∩
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ↪
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ↪
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                    %mspace{:width => "thickmathspace"}
                    %mi W
                    %mo ∪
                    %mi V
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    K \cap V \cap int_X(W \cup K)
                    \\;\xhookrightarrow{\phantom{--}}\;
                    V
                    \\;\xhookrightarrow{\phantom{--}}\;
                    W \cup V
                    \\;=\;
                    int_X(W \cup V)
                    \\,,
            %p
              where to derive the last equation, we use the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ∈
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W \in O(U)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              are open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .un_thm
            %h6#proposition_2 Proposition
            %p The operation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ∋
                    %mi W
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi int
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∪
                    %mo ¬
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    O(U) \ni W
                    \\;\mapsto\;
                    int_X(W \cup K)
                    \\;=\;
                    int_X(W \cup \neg U) \in O(X)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i_\ast
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %mo{:lspace => "verythinmathspace"} :
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i^\ast \colon O(X) \to O(U)
          %p This is well-known.
          .proof
            %h6#proof_2 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \in O(X)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mi V
                        %mo ⊆
                        %msub
                          %mi int
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi W
                        %mo ∪
                        %mo ¬
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "2em"}
                        %mtext in
                        %mspace{:width => "mediummathspace"}
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi V
                        %mo ⊆
                        %mi W
                        %mo ∪
                        %mo ¬
                        %mi U
                        %mspace{:width => "2em"}
                        %mtext in
                        %mspace{:width => "mediummathspace"}
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\frac
                    {V \subseteq int_X(W \cup \neg U) \qquad \text{in} \: O(X)}
                    {V \subseteq W \cup \neg U \qquad \text{in} \: P(X)}
                    \\,,
            %p
              but the last condition is equivalent to having
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∩
                    %mi V
                    %mo ⊆
                    %mi W
                  %annotation{:encoding => "application/x-tex"} U \cap V \subseteq W
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi U
                    %mo ∩
                    %mi V
                    %mo ⊆
                    %mi W
                  %annotation{:encoding => "application/x-tex"} i^\ast(V) = U \cap V \subseteq W
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(X)
          %p
            Summarizing, the gluing condition (1) above (for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ′
                    %mo ∈
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W' \in O(K)
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ∈
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W \in O(U)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ′
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mo ↪
                    %mphantom
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi j
                    %mo *
                  %msub
                    %mi i
                    %mo *
                  %mi W
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  W'
                  \\;\xhookrightarrow{\phantom{--}}\;
                  j^\ast i_\ast W
                  \\,.
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo ,
                  %msup
                    %mi j
                    %mo *
                %annotation{:encoding => "application/x-tex"} i^\ast, j^\ast
            are
            %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
            maps and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mo ⊣
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i^\ast \dashv i_\ast
          %p
            For future reference, observe that the operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mo *
                  %msub
                    %mi i
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j^\ast i_\ast \colon O(U) \to O(K)
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
          %p
            We can turn all this around. Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            are topological spaces, and suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \colon O(U) \to O(K)
            is left exact. Then we can manufacture a topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            which contains
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            as an open subspace and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            as its closed complement, and (letting
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            being the inclusions as above) such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %msup
                      %mi j
                      %mo *
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f = j^\ast i_\ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            may be identified with pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo ,
                  %mi W
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (W, W') \in O(U) \times O(K)
            such that
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ′
                    %mo ⊆
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W' \subseteq f(W)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo ,
                  %mi W
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (W, W')
            as a stand-in for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ∪
                    %mi W
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} W \cup W'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            give open sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo ,
                  %mo ∅
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (W, \varnothing)
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ′
                %annotation{:encoding => "application/x-tex"} W'
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            also give open sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∪
                  %mi W
                  %mo ′
                %annotation{:encoding => "application/x-tex"} U \cup W'
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h2#the_localic_case The localic case
          %p
            The development given above generalizes readily to the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locales"} locales
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a locale, with corresponding
            %a.existingWikiWord{:href => "/nlab/show/frame"} frame
            denoted by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U \in O(X)
            gives rise to two distinct frames:
          %ul
            %li
              %p
                The frame whose elements are
                %a.existingWikiWord{:href => "/nlab/show/algebra+for+a+monad"} algebras
                (
                %a.existingWikiWord{:href => "/nlab/show/fixed+point"}> fixed points
                ) of the left exact
                %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent monad
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:lspace => "verythinmathspace"} :
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U \vee - \colon O(X) \to O(X)
                %a.existingWikiWord{:href => "/nlab/show/closed+sublocale"} closed sublocale
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \neg U
                (more exactly, the frame surjection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Alg
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ∨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(X) \to Alg(U \vee -)
                is identified with a sublocale
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ¬
                        %mi U
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \neg U \to X
            %li
              %p
                The frame whose elements are algebras of the left exact idempotent monad
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⇒
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:lspace => "verythinmathspace"} :
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U \Rightarrow - \colon O(X) \to O(X)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⇒
                        %mi V
                        %mo =
                        %msub
                          %mi int
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo ∪
                        %mo ¬
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U \Rightarrow V = int_X(V \cup \neg U)
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(X)
                %a.existingWikiWord{:href => "/nlab/show/principal+ideal"} principal ideal
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(X)
                generated by
                = succeed "," do
