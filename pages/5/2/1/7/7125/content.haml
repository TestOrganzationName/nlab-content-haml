                            %mrow
                              %msub
                                %mi f
                                %mn 1
                        %mtd
                          %mi Φ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi e
                            %mn 1
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  e_0^' &amp;\overset{f_0}{\to} &amp; \Phi (e_0)
                  \\\
                  g'\downarrow &amp;&amp;\downarrow \Phi(g)
                  \\\
                  e_1^' &amp;\underset{f_1}{\to} &amp; \Phi(e_1)
                  }
          %p
            In other words, the Artin gluing is just the
            %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ′
                    %mo{:stretchy => "false"} ↓
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} E' \downarrow \Phi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            preserves pullbacks.)
          %p
            On the other hand, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is a topos and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                  %mi E
                %annotation{:encoding => "application/x-tex"} U\in E
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subterminal+object"} subterminal object
            %a.existingWikiWord{:href => "/nlab/show/subtoposes"} subtoposes
            that are
            %a.existingWikiWord{:href => "/nlab/show/complement"} complements
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/lattice+of+subtoposes"} lattice of subtoposes
            %a.existingWikiWord{:href => "/nlab/show/open+subtopos"} open subtopos
            whose
            %a.existingWikiWord{:href => "/nlab/show/reflector"} reflector
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi U
                  %annotation{:encoding => "application/x-tex"} (-)^U
            %a.existingWikiWord{:href => "/nlab/show/closed+subtopos"} closed subtopos
            whose reflector is the
            %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %mi A
                    %msub
                      %mo +
                      %mrow
                        %mi A
                        %mo ×
                        %mi U
                    %mi U
                  %annotation{:encoding => "application/x-tex"} A\mapsto A +_{A\times U} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E=Sh(X)
            is the topos of sheaves on a locale, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            corresponds to an element of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            (say), and the open subtopos can be identified with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(U)
            and the closed one with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(K)
          %p
            Returning to the general case, let us denote the
            %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            of the open subtopos by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi E
                    %mi U
                  %mo ↪
                  %mi E
                %annotation{:encoding => "application/x-tex"} i\colon E_U \hookrightarrow E
            and that of the closed subtopos by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi E
                      %mrow
                        %mo ¬
                        %mi U
                    %mo ↪
                    %mi E
                  %annotation{:encoding => "application/x-tex"} j\colon E_{\neg U}\hookrightarrow E
            = succeed "," do
              %strong fringe functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi U
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi i
                        %mo *
                  %mi E
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi j
                        %mo *
                  %msub
                    %mi E
                    %mrow
                      %mo ¬
                      %mi U
                %annotation{:encoding => "application/x-tex"} E_U \xrightarrow{i_*} E \xrightarrow{j^*} E_{\neg U}
          %p which is left exact.
          .un_thm
            %h6#theorem_2 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              be a subterminal object of a topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msup
                      %mi i
                      %mo *
                    %mo ,
                    %msup
                      %mi j
                      %mo *
                    %mo{:stretchy => "false"} ⟩
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %msub
                      %mi E
                      %mi U
                    %mo ×
                    %msub
                      %mi E
                      %mrow
                        %mo ¬
                        %mi U
                  %annotation{:encoding => "application/x-tex"} \langle i^\ast, j^\ast \rangle \colon E \to E_U \times E_{\neg U}
            %p
              is canonically identified with the comonadic gluing construction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Gl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi j
                        %mo *
                      %msub
                        %mi i
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi E
                        %mi U
                      %mo ×
                      %msub
                        %mi E
                        %mrow
                          %mo ¬
                          %mi U
                    %annotation{:encoding => "application/x-tex"} \mathbf{Gl}(j^\ast i_\ast) \to E_U \times E_{\neg U}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              can be recovered from
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi U
                    %annotation{:encoding => "application/x-tex"} E_U
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mrow
                          %mo ¬
                          %mi U
                    %annotation{:encoding => "application/x-tex"} E_{\neg U}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi j
                        %mo *
                      %msub
                        %mi i
                        %mo *
                    %annotation{:encoding => "application/x-tex"} j^* i_*
          %p
            For a proof, see A4.5.6 in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Elephant"} Elephant
          %p
            Once again, the import of this theorem may be turned around. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} f \colon E \to F
            is any left exact functor, then the projection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi E
                  %mo ×
                  %mi F
                  %mover
                    %mo →
                    %mi proj
                  %mi E
                %annotation{:encoding => "application/x-tex"} \mathbf{Gl}(f) \to E \times F \stackrel{proj}{\to} E
          %p
            is easily identified with a
            %a.existingWikiWord{:href => "/nlab/show/logical+functor"} logical functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{Gl}(f) \to \mathbf{Gl}(f)/X
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/subterminal+object"} subterminal object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1, 0, 0 \to f(1))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            as an
            %a.existingWikiWord{:href => "/nlab/show/open+subtopos"} open subtopos
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Gl
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Gl}(f)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↪
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} X \hookrightarrow 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:lspace => "verythinmathspace"} :
                  %mn 1
                  %mo →
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} [X] \colon 1 \to \Omega
          %p
            induces a
            %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo ≅
                  %mn 1
                  %mo ×
                  %mi Ω
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ×
                      %mn 1
                  %mi Ω
                  %mo ×
                  %mi Ω
                  %mover
                    %mo →
                    %mo ∧
                  %mi Ω
                  %mo .
                %annotation{:encoding => "application/x-tex"} \Omega \cong 1 \times \Omega \stackrel{[X] \times 1}{\to} \Omega \times \Omega \stackrel{\wedge}{\to} \Omega.
          %p
            Then, the category of sheaves
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(j)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Gl}(f) \to Sh(j)
            to the category of sheaves, is naturally identified with the projection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi E
                  %mo ×
                  %mi F
                  %mover
                    %mo →
                    %mi proj
                  %mi F
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \mathbf{Gl}(f) \to E \times F \stackrel{proj}{\to} F,
          %p
            thus realizing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            as equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/closed+subtopos"} closed subtopos
            (
            %a.existingWikiWord{:href => "/nlab/show/Elephant"}> Elephant
            , A.4.5, pp. 205-206) attached to the subterminal object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h3#some_details_and_further_adjunctions Some details and further adjunctions
          %p
            The sheaves in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Gl}(f)
            corresponding to the open resp. closed subtoposes can be described explicitly. Recall that the objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Gl}(f)
            have the form
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ,
                    %mi u
                    %mo :
                    %mi Y
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, Y, u:Y\to f(X))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            corresponds to the subcategory on those objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ,
                  %mi u
                  %mo :
                  %mi Y
                  %mo →
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, Y, u:Y\to f(X))
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            an isomorphism in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and the closed copy of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            to the subcategory with objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ,
                  %mi u
                  %mo :
                  %mi Y
                  %mo →
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, Y, u:Y\to f(X))
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ≃
                  %mn 1
                %annotation{:encoding => "application/x-tex"} X\simeq 1
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/open+subtopos"} open subtopos
            corresponding to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is
            %a.existingWikiWord{:href => "/nlab/show/dense+subtopos"} dense
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Gl}(f)
            precisely if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi E
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} f:E\to F
            preserves the initial object since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 0
                  %mo ,
                  %mn 0
                  %mo →
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (0,0,0\to f(0))
            is the initial object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Gl}(f)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 0\to f(0)
            is an isomorphism precisely if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            preserves
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          %p
            To summarize: given a left exact
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} f\colon E\to F
            we get an open inclusion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            with a further left adjoint:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "2em"}
                  %mi X
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi id
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i_\ast \colon E\to \mathbf{Gl}(f) \qquad X\mapsto (X,f(X),id_{f(X)})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi E
                  %mspace{:width => "2em"}
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi X
                %annotation{:encoding => "application/x-tex"} i^\ast\colon \mathbf{Gl}(f)\to E \qquad (X,Y,u)\mapsto X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo !
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "2em"}
                  %mi X
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mn 0
                  %mo ,
                  %mn 0
                  %mo →
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"} i_{!} \colon E\to \mathbf{Gl}(f) \qquad X\mapsto (X,0,0\to f(X)) \quad ,
          %p
            and a closed inclusion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Gl}(f)
            with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %mi F
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "2em"}
                  %mi X
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi X
                  %mo ,
                  %mi X
                  %mo →
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j_\ast \colon F\to \mathbf{Gl}(f) \qquad X\mapsto (1,X,X\to 1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mspace{:width => "2em"}
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi Y
                %annotation{:encoding => "application/x-tex"} j^\ast\colon\mathbf{Gl}(f)\to F \qquad (X,Y,u)\mapsto Y
          %p
            that will lack the left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo !
                %annotation{:encoding => "application/x-tex"} j_!
            in general. The situation when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo !
                %annotation{:encoding => "application/x-tex"} j_!
            exists is characterized by the following observation:
          .un_thm
            %h6#proposition_3 Proposition
            %p
              The closed inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is essential i.e.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mo *
                  %annotation{:encoding => "application/x-tex"} j^\ast
              has a left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mo !
                  %annotation{:encoding => "application/x-tex"} j_!
              precisely if the fringe functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has a left adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                    %annotation{:encoding => "application/x-tex"} l
          .proof
            %h6#proof_3 Proof
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mo !
                  %annotation{:encoding => "application/x-tex"} j_!
              exists. The fringe functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is up to natural isomorphism just
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mo *
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} j^\ast i_\ast
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %msub
                      %mi j
                      %mo !
                    %mo ⊣
                    %msup
                      %mi j
                      %mo *
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i^\ast j_!\dashv j^\ast i_\ast
              since adjoints compose.
            %p
              Conversely, suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo ⊣
                    %mi f
                  %annotation{:encoding => "application/x-tex"} l\dashv f
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi id
                    %mo →
                    %mi f
                    %mi l
                  %annotation{:encoding => "application/x-tex"} \eta\colon id\to f{l}
              the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mo !
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Gl
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "2em"}
                    %mi Y
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi l
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Y
                    %mo ,
                    %msub
                      %mi η
                      %mi Y
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi f
                    %mi l
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "1em"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"} j_{!} \colon F\to \mathbf{Gl}(f) \qquad Y\mapsto (l(Y),Y,\eta_Y\colon Y\to f{l}(Y)) \quad .
            %p
              Now given morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Y
                      %mn 1
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \alpha\colon Y_1\to Y
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u\colon Y\to f(X)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              by general properties of a unit there is precisely one morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi u
                        %mo ∘
                        %mi α
                      %mo ¯
                    %mo{:lspace => "verythinmathspace"} :
                    %mi l
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \overline{u\circ\alpha}\colon l(Y_1)\to X
              corresponding to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∘
                    %mi α
                  %annotation{:encoding => "application/x-tex"} u\circ\alpha
              under the adjunction such that the following diagram commutes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Y
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi η
                                  %mrow
                                    %msub
                                      %mi Y
                                      %mn 1
                          %mtd
                            %mi f
                            %mi l
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Y
                              %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi α
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mover
                              %mrow
                                %mi u
                                %mo ∘
                                %mi α
                              %mo ¯
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %munder
                              %mo →
                              %mi u
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y_1 &amp;\overset{\eta_{Y_1}}{\to} &amp; f{l}(Y_1)
                    \\\
                    \\alpha\downarrow &amp;&amp;\downarrow f(\overline{u\circ\alpha})
                    \\\
                    Y &amp;\underset{u}{\to} &amp; f(X)
                    }
            %p
              This establishes a bijective correspondence between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 1
                    %mo →
                    %msup
                      %mi j
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ,
                    %mi u
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y_1\to j^\ast(X,Y,u)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mo !
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ,
                    %mi u
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j_!(Y_1)\to (X,Y,u)
              which is natural since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is.
          %p
            In particular, the left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo !
                %annotation{:encoding => "application/x-tex"} j_!
            exists if the fringe functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is the
            %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
            of a geometric morphism, or the
            %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            of an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mo !
                  %mo ⊣
                  %msup
                    %mi j
                    %mo *
                  %mo ⊣
                  %msub
                    %mi j
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mspace{:width => "1em"}
                  %mo .
                %annotation{:encoding => "application/x-tex"} j_!\dashv j^\ast\dashv j_\ast \colon \mathbf{Gl}(f)\to F\quad .
          %p
            The existence of a
            %em right
            adjoint for the fringe functor:
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⊣
                    %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} f\dashv r\colon F\to E
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                    %mo ⊣
                    %msup
                      %mi i
                      %mo !
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi Gl
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} i_\ast\dashv i^!:\mathbf{Gl}(f)\to E
          %p
            One direction follows again from the composition of adjoints:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mo *
                  %msub
                    %mi i
                    %mo *
                  %mo ⊣
                  %msup
                    %mi i
                    %mo !
                  %msub
                    %mi j
                    %mo *
                %annotation{:encoding => "application/x-tex"} j^\ast i_\ast\dashv i^! j_\ast
            , whereas for the other direction we define:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo !
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi E
                  %mspace{:width => "2em"}
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi r
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mrow
                      %mi rf
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mi X
                  %mspace{:width => "1em"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  i^!\colon \mathbf{Gl}(f)\to E \qquad (X,Y,u)\mapsto r(Y) \times_{rf(X)} X\quad .
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is fully faithful, the unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi rf
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \to rf(X)
            is an iso, and so we can instead use
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo !
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi E
                  %mspace{:width => "2em"}
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ,
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi r
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  i^!\colon \mathbf{Gl}(f)\to E \qquad (X,Y,u)\mapsto r(Y)\quad .
          %p
            Note that in this case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is dense and we get a ‘co-cohesive’ adjoint string
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo !
                  %mo ⊣
                  %msup
                    %mi i
                    %mo *
                  %mo ⊣
                  %msub
                    %mi i
                    %mo *
                  %mo ⊣
                  %msup
                    %mi i
                    %mo !
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} i_!\dashv i^\ast\dashv i_\ast \dashv i^!\colon \mathbf{Gl}(f)\to E
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo !
                %annotation{:encoding => "application/x-tex"} i_!
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mo *
                %annotation{:encoding => "application/x-tex"} i_\ast
            are fully faithful.
          %h3#examples Examples
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mo *
                  %mo ↪
                  %mi E
                %annotation{:encoding => "application/x-tex"} i:\ast\hookrightarrow E
            is left exact where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} \ast
            is the degenerate topos with one identity morphism,
            %em every
            topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is trivially a result of Artin gluing:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≃
                    %mi E
                    %mo{:stretchy => "false"} ↓
                    %mi i
                  %annotation{:encoding => "application/x-tex"} E\simeq E\downarrow i
          %p Of course, more interesting examples of the gluing construction abound as well. Here are a few:
          %ul
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                be an (elementary, not necessarily Grothendieck) topos, and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi E
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} \hom(1, -): E \to Set
                represent the terminal object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                – this of course is left exact. The gluing construction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Gl
                      %mo{:stretchy => "false"} (
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{Gl}(\hom(1, -))
                is called the
                %strong scone
                (Sierpinski cone), or the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Freyd+cover"} Freyd cover
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                is a Grothendieck topos and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Set
                      %mo →
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \Delta \colon Set \to E
                is the (essentially unique) left exact left adjoint, then we have a gluing construction
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} ↓
                        %mi Δ
                      %annotation{:encoding => "application/x-tex"} E \downarrow \Delta
                %em attaching a generic open point
                to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
            %li
              %p
                A concrete instance of the constructions in both the preceding examples is the
                %a.existingWikiWord{:href => "/nlab/show/Sierpinski+topos"} Sierpinski topos
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mo →
                    %annotation{:encoding => "application/x-tex"} Set^{\to}
                corresponding e.g. to
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                        %mo{:stretchy => "false"} ↓
                        %msub
                          %mi id
                          %mi Set
                      %annotation{:encoding => "application/x-tex"} Set\downarrow id_{Set}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X\to Y
                between sets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X,Y
                and the closed copy of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
                sits on the objects of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} X\to 1
                and the open copy on the objects
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mover
                          %mo →
                          %mo ≃
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X\overset{\simeq}{\to}Y
            %li
              %p
                Since a topos
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
                is finitely bicomplete, the product functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊓
                      %mo :
                      %mi ℰ
                      %mo ×
                      %mi ℰ
                      %mo →
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \sqcap:\mathcal{E}\times\mathcal{E}\to\mathcal{E}
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} (X,Y)\mapsto X\times Y
                is part of an adjoint string
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊔
                      %mo ⊣
                      %mo ▵
                      %mo ⊣
                      %mo ⊓
                    %annotation{:encoding => "application/x-tex"} \sqcup\dashv\triangle\dashv\sqcap
                involving the
                %a.existingWikiWord{:href => "/nlab/show/diagonal+functor"} diagonal functor
                and the coproduct functor. Since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊓
                    %annotation{:encoding => "application/x-tex"} \sqcap
                is left exact, Artin gluing applies. In the case
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                      %mo =
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}=Set
                ,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔾𝕝
                      %mo{:stretchy => "false"} (
                      %mo ⊓
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{Gl}(\sqcap)
                yields the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/hypergraph"} topos of hypergraphs
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/hypergraph"} hypergraph
          %h3#remarks Remarks
          %ul
            %li
              %p
                Artin gluing for toposes carries over in some slight extra generality, replacing left exact functors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                by
                = succeed "." do
                  %em pullback-preserving functors
            %li
              %p
                Artin gluing applies also to other
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/doctrine"} doctrines
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular categories
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretoposes
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/quasitopos"} quasitoposes
                = succeed ")" do
                  %a{:href => "#CJ"} Carboni-Johnstone
                = succeed ")." do
                  %a{:href => "#JLS07"} Johnstone-Lack-Sobocinski
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Freyd+cover"} Freyd cover
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/recollement"} recollement
          %h2#references References
          %ul#CJ
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/M.+Artin"}> M. Artin
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/A.+Grothendieck"} A. Grothendieck
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/J.+L.+Verdier"} J. L. Verdier
                = succeed "," do
                  %em
                    Théorie des Topos et Cohomologie Etale des Schémas (
                    %a.existingWikiWord{:href => "/nlab/show/SGA4"}> SGA4
                    )
                %strong 269
                Springer Heidelberg 1972. (exposé IV, sect. 9; in particular: sect. 9.5)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gavin+Wraith"}> Gavin Wraith
                ,
                %em Artin Glueing
                , JPAA
                %strong 4
                (1974) pp.345-358
                = succeed "." do
                  %a{:href => "http://www.sciencedirect.com/science/article/pii/0022404974900140"} link
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aurelio+Carboni"}> Aurelio Carboni
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"} Peter Johnstone
                %em Connected limits, familial representability and Artin glueing
                , Mathematical Structures in Computer Science
                %strong 5
                (1995) pp.441-459. (
                %a{:href => "http://journals.cambridge.org/article_S0960129500001183"}> pdf
                )
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aurelio+Carboni"}> Aurelio Carboni
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"} Peter Johnstone
                %em Corrigenda to ‘Connected limits…’
                , Mathematical Structures in Computer Science
                %strong 14
                (2004) pp.185-187.
            %li
              %p
                Peter F. Faul, Graham R. Manuell,
                %em Artin Glueings of Frames as Semidirect Products
                , arXiv:1907.05104 (2019). (
                %a{:href => "https://arxiv.org/abs/1907.05104"}> abstract
                )
            %li
              %p
                Peter F. Faul, Graham Manuell, José Siqueira,
                %em Artin glueings of toposes as adjoint split extensions
                , arXiv:2012.04963 (2020). (
                %a{:href => "https://arxiv.org/abs/2012.04963"}> abstract
                )
            %li
              %p
                %span.newWikiWord>
                  Matthias Hutzler
                  %a{:href => "/nlab/new/Matthias+Hutzler"} ?
                ,
                = succeed "," do
                  %em Syntactic presentations for glued toposes and for crystalline toposes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/2206.11244"} arXiv:2206.11244
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mamuka+Jibladze"}> Mamuka Jibladze
                ,
                %em Lower Bagdomain as a Glueing
                , Proc. A. Razmadze Math. Inst.
                %strong 118
                (1998) pp.33-41. (
                %a{:href => "http://www.rmi.ge/~jib/pubs/baglue.pdf"}> pdf
