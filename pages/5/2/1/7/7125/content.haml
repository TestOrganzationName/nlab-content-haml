                %mrow
                  %msub
                    %mn 1
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                  %mo ×
                  %mo ∧
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ×
                  %msub
                    %mn 1
