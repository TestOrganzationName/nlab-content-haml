                                %mo +
                                %mn 1
                            %mi b
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi p
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mrow
                                %mi p
                                %mo +
                                %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi q
