                    %annotation{:encoding => "application/x-tex"} q
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %mi K
                        %mo ,
                        %mi L
                  %annotation{:encoding => "application/x-tex"} \mu_{K,L}
              defined this way is indeed a cochain map.
          .proof
            %h6#proof_4 Proof
            %p
              We have to check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              respect the coboundary maps in that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a,b
              as above we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∘
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ⊗
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi μ
                    %mo ∘
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ⊗
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \circ \mu (a \otimes b) = \mu \circ d (a \otimes b)
                    \\,.
            %p By definition of the cup product and the differential on the Moore cochain complex we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi d
                            %mo ∘
                            %mi μ
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ⊗
                            %mi b
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi d
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ⌣
                            %mi b
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi d
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mrow
                                %mi p
                                %mo +
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi q
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mn 0
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi p
                            %mi b
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi i
                                %mo =
                                %mn 0
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi i
                            %msub
                              %mi d
                              %mi i
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mrow
                                %mi p
                                %mo +
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi q
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mn 0
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi p
                            %mi b
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d \circ \mu (a \otimes b)
                    \&amp;=
                    d (a \smile b)
                    \\\
                    \&amp;= d ( ((d_{p+1})^q a) \otimes ((d_0)^p b) )
                    \\\
                    \&amp;=
                    \\sum_{i=0}^{p+q+1}
                    (-1)^i  d_i((d_{p+1})^q a) \otimes ((d_0)^p b)
                    \\end{aligned}
            %p
              By definition the face maps on the tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊗
                    %mi L
                  %annotation{:encoding => "application/x-tex"} K \otimes L
              are just the tensor products of the face maps of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi q
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi p
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \=
                    \\sum_{i=0}^{p+q+1}
                    (-1)^i  (d_i (d_{p+1})^q a) \otimes (d_i (d_0)^p b)
                    \\,.
            %p Break up this sum in three parts
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi q
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi p
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi q
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi p
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mi p
                        %mo +
                        %mn 2
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi q
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi p
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \=
                    \\sum_{i=0}^{p}
                    (-1)^i  (d_i (d_{p+1})^q a) \otimes (d_i (d_0)^p b)
                    +
                    (-1)^{p+1}  (d_{p+1} (d_{p+1})^q a) \otimes (d_{p+1} (d_0)^p b)
                    +
                    \\sum_{i=p+2}^{p+q+1}
                    (-1)^i  (d_i (d_{p+1})^q a) \otimes (d_i (d_0)^p b)
            %p
              Now repeatedly use the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
              for face maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo &lt;
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi d
                      %mi i
                    %mo ∘
                    %msub
                      %mi d
                      %mi j
                    %mo =
                    %msub
                      %mi d
                      %mi j
                    %mo ∘
                    %msub
                      %mi d
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    (i \lt j) \;\;\Rightarrow \;\; d_i \circ d_j = d_j \circ d_{i-1}
            %p to pass face maps from the left to the right. This yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi q
                    %msub
                      %mi d
                      %mi i
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi p
                    %msub
                      %mi d
                      %mn 1
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mi p
                        %mo +
                        %mn 2
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi p
                    %msub
                      %mi d
                      %mrow
                        %mi i
                        %mo −
                        %mi p
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \=
                    \\sum_{i=0}^{p}
                    (-1)^i  ( (d_{p+2})^q d_i a) \otimes ( (d_0)^{p+1} b)
                    +
                    (-1)^{p+1}  ((d_{p+1})^{q+1} a) \otimes ((d_0)^p d_1 b)
                    +
                    \\sum_{i=p+2}^{p+q+1}
                    (-1)^i  ((d_{p+1})^{q+1} a) \otimes ((d_0)^p d_{i-p}b)
                    \\,.
            %p Observe that the second term may now be naturally included in the sum in the third term, leaving two sums
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi q
                    %msub
                      %mi d
                      %mi i
                    %mi a
