                        %mi V
                        %mi p
                      %mo ⊗
                      %msup
                        %mi W
                        %mi q
                    %annotation{:encoding => "application/x-tex"} \nu \otimes \omega\in V^p \otimes W^q
                by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi ν
                      %mo ⊗
                      %mi ω
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mi V
                      %mi ν
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi ω
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi p
                      %mi ν
                      %mo ⊗
                      %msub
                        %mi d
                        %mi W
                      %mi ω
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d (\nu \otimes \omega) = (d_V \nu) \otimes \omega + (-)^{p} \nu \otimes d_W \omega
                      \\,.
          %p
            With respect to these standard monoidal structures the
            %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore cochain complex
            functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo :
                  %mi CoS
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi Ch
                    %mo +
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C : CoS(A) \to Ch_+^\bullet(A)
            becomes a
            %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
            with the following lax monoidal
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ⊗
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi CoS
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi CoS
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi Ch
                    %mo +
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mu : C(-) \otimes C(-) \to C(-\otimes -) : CoS(A) \times CoS(A) \to Ch_+^\bullet(A)
            \.
          .num_defn
            %h6#definition_lax_monoidal_structure_on_moore_cochain_complex_functor Definition (lax monoidal structure on Moore cochain complex functor)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ,
                    %mi L
                    %mo ∈
                    %mi CoS
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K,L \in CoS(A)
              define the component map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %mi K
                        %mo ,
                        %mi L
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ⊗
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_{K,L} : C(K)\otimes C(L) \to C(K \otimes L)
            %p by defining it on homogeneous elements
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⊗
                    %mi b
                    %mo ∈
                    %msup
                      %mi C
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi C
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi p
                        %mo +
                        %mi k
                  %annotation{:encoding => "application/x-tex"} a\otimes b \in C^p(K)\otimes C^q(L) \subset (C(K)\otimes C(L))^{p+k}
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mrow
                        %mi K
                        %mo ,
                        %mi L
                    %mo :
                    %mi a
                    %mo ⊗
                    %mi b
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %msub
