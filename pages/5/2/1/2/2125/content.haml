                            %mi b
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi p
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi i
