                      %msup
                        %mi L
                        %mi n
                    %annotation{:encoding => "application/x-tex"} (K \otimes L)^n = K^n \otimes L^n
                and with cosimplicial maps the tensor product of the cosimplicial maps in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ,
                      %mi W
                      %mo ∈
                      %msubsup
                        %mi Ch
                        %mo +
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V,W \in Ch_+^\bullet(A)
                their
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ⊗
                      %mi W
                    %annotation{:encoding => "application/x-tex"} V \otimes W
                the
                = succeed "," do
                  %em graded tensor product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ⊗
                      %mi W
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mo =
                      %msub
                        %mo ⊕
                        %mrow
                          %mi p
                          %mo +
                          %mi q
                          %mo =
                          %mi n
                      %msup
                        %mi V
                        %mi p
                      %mo ⊗
                      %msup
                        %mi W
                        %mi q
                    %annotation{:encoding => "application/x-tex"} (V \otimes W)^n = \oplus_{p+q = n} V^p \otimes W^q
                whose coboundary map is given on homogeneous elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
