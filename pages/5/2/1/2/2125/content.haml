                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mn 0
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi p
                            %msub
                              %mi d
                              %mi i
                            %mi b
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\cdots
                    \=&amp;
                    \\sum_{i=0}^{p}
                    (-1)^i  ( (d_{p+2})^q d_i a) \otimes ( (d_0)^{p+1} b)
                    +
                    (-1)^{p+1}  ( (d_{p+2})^q d_{p+1} a) \otimes ( (d_0)^{p+1} b)
                    \\\
                    \&amp;
                    +
                    (-1)^{p}  ( (d_{p+2})^q d_{p+1} a) \otimes ( (d_0)^{p+1} b)
                    +
                    (-1)^p
                    \\sum_{i=1}^{q+1}
                    (-1)^i  ((d_{p+1})^{q+1} a) \otimes ((d_0)^p d_{i}b)
                    \\end{aligned}
                    \\,.
            %p One last application of the simplicial identities in the third tirm shows that indeed this is the missing term in the sum in the fourth term. Comparing the result with the definition of coboundary map and cup product we find finally
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mi a
                            %mo{:stretchy => "false"} )
                            %mo ⌣
                            %mi b
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi p
                            %mi a
                            %mo ⌣
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mi b
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi μ
                            %mo ∘
                            %mi d
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ⊗
                            %mi b
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\cdots &amp;= (d a) \smile b + (-1)^p a \smile (d b)
                    \\\
                    \&amp;=
                    \\mu \circ d (a \otimes b)
                    \\end{aligned}
                    \\,.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              This
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is indeed natural in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo ,
                      %mi L
                    %annotation{:encoding => "application/x-tex"} K,L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi K
                    %mo →
                    %mi K
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f : K \to K'
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi L
                    %mo →
                    %mi L
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} g : L\to L'
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi μ
                                  %mrow
                                    %mi K
                                    %mo ,
                                    %mi L
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo ⊗
                            %mi L
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi g
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo ⊗
                                %mi g
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo ′
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi μ
                                  %mrow
                                    %mi K
                                    %mo ′
                                    %mo ,
                                    %mi L
                                    %mo ′
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo ′
                            %mo ⊗
                            %mi L
                            %mo ′
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C(K) \otimes C(L) &amp;\stackrel{\mu_{K,L}}{\to}&amp; C(K \otimes L)
                    \\\
                    \\;\;\;\downarrow^{C(f)\otimes C(g)} &amp;&amp; \;\;\;\downarrow^{C(f \otimes g)}
                    \\\
                    C(K') \otimes C(L') &amp;\stackrel{\mu_{K',L'}}{\to}&amp; C(K' \otimes L')
                    }
          .proof
            %h6#proof_5 Proof
            %p
              This is immediate from the fact that the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f, g
              of cosimplicial objects respect the face maps.
          .num_prop
            %h6#proposition_6 Proposition
            %p
              The natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is indeed a lax monoidal transformation in that it is associative and unital in the required sense.
          .proof
            %h6#proof_6 Proof
            %p
              We need to show that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ,
                    %mi K
                    %mo ,
                    %mi L
                    %mo ∈
                    %mi CoS
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J,K,L \in CoS(A)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi Id
                                  %mrow
                                    %mi C
                                    %mo{:stretchy => "false"} (
                                    %mi J
                                    %mo{:stretchy => "false"} )
                                %mo ⊗
                                %msub
                                  %mi μ
                                  %mrow
                                    %mi K
                                    %mo ,
                                    %mi L
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo ⊗
                            %mi L
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo ⊗
                            %mi K
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi μ
                                  %mrow
                                    %mi J
                                    %mo ,
                                    %mi K
                                %mo ⊗
                                %msub
                                  %mi Id
                                  %mrow
                                    %mi C
                                    %mo{:stretchy => "false"} (
                                    %mi L
                                    %mo{:stretchy => "false"} )
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo ⊗
                            %mi K
                            %mo ⊗
                            %mi L
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C(J) \otimes C(K) \otimes C(L) &amp;\stackrel{Id_{C(J)} \otimes \mu_{K,L}}{\to}&amp;
                    C(J)\otimes C(K \otimes L)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    C(J \otimes K) \otimes C(L)
                    \&amp;\stackrel{\mu_{J,K} \otimes Id_{C(L)}}{\to}&amp;
                    C(J\otimes K \otimes L)
                    }
                    \\,.
            %p
              it is sufficient to check this on all homogeneous elements
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ⊗
                      %mi b
                      %mo ⊗
                      %mi c
                      %mo ∈
                      %msup
                        %mi C
                        %mi o
                      %mo{:stretchy => "false"} (
                      %mi J
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %msup
                        %mi C
                        %mi p
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %msup
                        %mi C
                        %mi q
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \otimes b \otimes c \in C^o(J)\otimes C^p(K) \otimes C^q(L)
          .num_remark
            %h6#remark_4 Remark
            %p
              The above statement is obvious when one observes the geometric interpretation of the above remark: the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⊗
                    %mi b
                    %mo ⊗
                    %mi c
                  %annotation{:encoding => "application/x-tex"} a \otimes b \otimes c
              along both ways around the above square is the
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi o
                      %mo +
                      %mi p
                      %mo +
                      %mi q
                    %annotation{:encoding => "application/x-tex"} o+p+q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              on the leftmost
              = succeed "-face," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi o
                    %annotation{:encoding => "application/x-tex"} o
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              on the middle
              = succeed "-face" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              on the rightmost
              = succeed "-face" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
          .num_cor
            %h6#corollary_2 Corollary
            %p The Moore cochain complex functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo :
                    %mi CoS
                    %mo{:stretchy => "false"} (
                    %mi Ab
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ch
                      %mo +
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Ab
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C : CoS(Ab) \to Ch_+^\bullet(Ab)
            %p
              can be equipped with a lax monoidal structure with respect to the standard monoidal structure on
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+abelian+groups"} cosimplicial abelian groups
              and on connective cochain complexes of abelian groups.
          %h4#EooCup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} E_\infty
            \-cup product on cochains on simplicial sets
          %p
            At least for those
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+algebra"} cosimplicial algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            that are algebras of
            %a.existingWikiWord{:href => "/nlab/show/cochains+on+simplicial+sets"} cochains on simplicial sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo •
                    %mo ∈
                    %mi SSet
                  %annotation{:encoding => "application/x-tex"} S^\bullet \in SSet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mo •
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A = C(S^\bullet, R)
            it is known that the Moore complex
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi N
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N^\bullet(A)
            equipped with the
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            is an
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/E-k-operad"} E-∞
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra
            %a.existingWikiWord{:href => "/nlab/show/cochains+on+simplicial+sets"} cochains on simplicial sets
            for details on this.
          %h3#DualDoldKanQuillenEquivalences Quillen equivalences
          .num_theorem
            %h6#theorem_4 Theorem
            %p There is a Quillen equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Γ
                      %mi mon
                    %mo ⊣
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi Ring
                      %mi Δ
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi N
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi Γ
                            %mi mon
                    %mi dgRing
                  %annotation{:encoding => "application/x-tex"}
                    (\Gamma^{mon} \dashv N) :  Ring^{\Delta}
                    \\underoverset{\underset{N}{\longrightarrow}}{\overset{\Gamma^{mon}}{\longleftarrow}}{\bot}  dgRing
            %p between connective cochain dg-rings and cosimplicial rings.
          %p
            This is the main theorem in
            = succeed "." do
              %a{:href => "#CastiglioniCortinas"} CastiglioniCortinas
          %p
            A version of this equivalence (refined to an equivalence between dg-dg-algebras and cosimplicial dg-algebras) is in (
            %a{:href => "#Pridham"}> Pridham, theorem 4.26
            ). There is also discussed how this is a Quillen eqivalence between two realizations of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+L-infinity+algebras"} model structure for L-infinity algebras
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            %li
              %p
                %strong monoidal Dold-Kan corespondence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/operadic+Dold-Kan+correspondence"} operadic Dold-Kan correspondence
          %h2#references References
          %p Original results are in
          %ul#EilenbergMacLane
            %li
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"} Saunders MacLane
              %em
                On the groups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H(\Pi, n)
                II. Methods of computation
              , Ann. Math. (2) 60 (1954), 49 - 139
          %ul#MacLaneHomology
            %li
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
              ,
              %em Homology
          %p A classical textbook reference is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"}> Charles Weibel
              ,
              = succeed "," do
                %em An introduction to homological algebra
          %p This discusses the symmetric monoidalness of the chains functor in section 8.5.4.
          %p The bilax monoidalness and Frobenius monoidalness of the normalized chains/Moore complex functor is discussed in section 5.4.2 of
          %ul#AguiarMahajan
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marcelo+Aguiar"}> Marcelo Aguiar
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Swapneel+Mahajan"} Swapneel Mahajan
              %p
                %em Coxeter Groups and Hopf Algebras
                Fields Institute Monographs, vol. 23 (
                %a{:href => "http://www.math.tamu.edu/~maguiar/monograph.pdf"}> pdf
                )
              %p
                %em>
                  %a.existingWikiWord{:href => "/nlab/show/Monoidal+Functors%2C+Species+and+Hopf+Algebras"} Monoidal Functors, Species and Hopf Algebras
                ,
          %p Explicit details on many constructions of the lax/oplax structure are given in section 11 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim Porter
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Crossed+Menagerie"} Crossed Menagerie
          %p The Quillen equivalence between connective chain dg-algebras and simplicial algebras is discussed in
          %ul
            %li#SchwedeShipley
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
              %em Equivalences of monoidal model categories
              , Algebr. Geom. Topol. 3 (2003), 287–334 (
              %a{:href => "http://arxiv.org/abs/math.AT/0209342"}> arXiv:math.AT/0209342
              )
          %p The equivalence between connected cochain dg-algebras and cosimplicial algebras is discussed in
          %ul
            %li#CastiglioniCortinas
              J.L. Castiglioni, G. Cortiñas,
              %em Cosimplicial versus DG-rings: a version of the Dold-Kan correspondence
              , J. Pure Appl. Algebra 191 (2004), no. 1-2, 119–142, (
              %a{:href => "http://arxiv.org/abs/math/0306289"}> arXiv:math.KT/0306289
              ,
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/j.jpaa.2003.11.009"} doi:10.1016/j.jpaa.2003.11.009
          %p The equivalence between cosimplicial commutative algebras and commutative cochain dg-algebras in non-negative degree, over a field of char 0 is discussed in
          %ul
            %li#HinichSchechtman
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Hinich"}> Vladimir Hinich
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Vadim+Schechtman"} Vadim Schechtman
                = succeed "," do
                  %em Homotopy limits of homotopy algebras
                = succeed "," do
                  %em K-theory: algebra, geometry, arithmetic
            %li#Pridham
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Pridham"}> Jonathan Pridham
                ,
                = succeed "," do
                  %em Unifying derived deformation theories
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0705.0344"} arXiv:0705.0344
          %p and the analogous statement for the simplicial case, with hints for its proof, is also in
          %ul
            %li#Fresse
              %a.existingWikiWord{:href => "/nlab/show/Benoit+Fresse"}> Benoit Fresse
              ,
              = succeed "," do
                %em
                  %a{:href => "http://math.univ-lille1.fr/~fresse/OperadHomotopyBook/"} Homotopy of Operads and Grothendieck-Teichmüller Groups
              %em Differential graded commutative algebras and cosimplicial algebras
              (
              %a{:href => "http://math.univ-lille1.fr/~fresse/OperadHomotopyBook/CommutativeAlgebraHomotopy.pdf"}> pdf
              )
          %p The Quillen equivalence between connected simplicial commutative algebras and connected commutative dg-algebras in characteristic 0 is indicated all the way back on p. 223 of
          %ul
            %li#Quillen69
              %a.existingWikiWord{:href => "/nlab/show/Dan+Quillen"}> Dan Quillen
              ,
              %em Rational homotopy theory
              The Annals of Mathematics,
              %p
                Second Series, Vol. 90, No. 2 (Sep., 1969), pp. 205-295 (
                %a{:href => "http://www.jstor.org/stable/1970725"}> JSTOR
                )
          %p
            The Quillen equivalence between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} E_\infty
            dg-algebras and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} E_\infty
            simplicial algebras is in
          %ul
            %li#Mandell
              %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"}> Michael Mandell
              ,
              %em
                Topological André-Quillen Cohomology and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} E_\infty
                André-Quillen Cohomology
              Adv. in Math., Adv. Math. 177 (2) (2003) 227–279
          %p and
          %ul
            %li#Richter
              %p
                %a.existingWikiWord{:href => "/nlab/show/Birgit+Richter"} Birgit Richter
              %p
                %em Symmetry properties of the Dold-Kan correspondence
                (
                %a{:href => "http://www.math.uni-hamburg.de/home/richter/doldkan.pdf"}> pdf
                )
              %p
                %em Homotopy algebras and the inverse of the normalization functor
                (
                %a{:href => "http://www.math.uni-hamburg.de/home/richter/invjpaa.pdf"}> pdf
                )
          %p
            The Alexander–Whitney/Eilenberg–Zilber equivalences for the normalized chains functor are a special case of the strong
            %a.existingWikiWord{:href => "/nlab/show/deformation+retract"} deformation retract
            of chain complexes that was constructed
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"} Saunders MacLane
              %em
                On the groups
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi π
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H(\pi, n)
              Annals of Mathematics (1954 )
          %p
            For any commutative ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p See also the appendix in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Pavol+Severa"}> Pavol Severa
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Willwacher"} Thomas Willwacher
              = succeed "," do
                %em Equivalence of formalities of the little discs operad
              %a{:href => "http://arxiv.org/abs/0905.1789"} arXiv:0905.1789
