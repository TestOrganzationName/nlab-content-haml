                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi p
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi q
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo :
                    %mi a
                    %mo ⌣
                    %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mu_{K,L} : a\otimes b \mapsto (d_{p+1})^p a) \otimes
                    ((d_0)^q b) =: a \smile b
                    \\,.
          .num_remark
            %h6#remark_3 Remark
            %p
              The iterated application of cosimplicial face maps on the right is to be thought of as producing a
              = succeed "-cosimplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+q)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ⊗
                    %mi L
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo =
                    %msup
                      %mi K
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo ⊗
                    %msup
                      %mi L
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"} C(K \otimes L)^{p+q} = K^{p+q}\otimes L^{p+q}
              by evaluating the
              = succeed "-cosimplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              on “leftmost” simplicial
              = succeed "-faces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              on “rightmost” simplicial
              = succeed "-faces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
