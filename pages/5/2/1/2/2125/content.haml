          %ul
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo ,
                      %mi L
                      %mo ∈
                      %mi CoS
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K,L \in CoS(A)
                their
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo ⊗
                      %mi L
                    %annotation{:encoding => "application/x-tex"} K \otimes L
                is the
                = succeed "," do
                  %em degreewise tensor product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
