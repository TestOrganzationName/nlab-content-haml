                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} higher dimensional Chern-Simons theory
            and its
            %a.existingWikiWord{:href => "/nlab/show/holographic+principle"} holographically dual
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual higher gauge theory
          %h3#the_solution_field_bundles_and_moduli_stacks_of_fields
            The solution: Field
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            By the
            = succeed "," do
              %a{:href => "#IdeaOfFieldBundlesAndItsProblems"} above
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
          %p
            Below in
            %em
              %a{:href => "#Definition"} Definition
            we discuss a natural unified formulation of the notion of physical field in terms of
            %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            (the central definition being def.
            %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
            ) and then we spell out many
            = succeed "." do
              %a{:href => "#Examples"} Examples
          %p
            This definition turns out to be equivalent, at least under mild conditions, to a formulation where fields are sections of an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated ∞-bundle
            = succeed "-bundle\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %em
                %a{:href => "#RelationOfFieldsToSections"} Properties – Relation of fields to sections of ∞-bundles
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            and indeed one equivalent characterization of fields is as
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            in the general sense of
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            in an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "." do
              %em
                %a{:href => "#RelationToTwistedCohomology"} Relation to twisted cohomology
          %p In summary we find and discuss that
          %table
            %thead
              %tr
                %th fields
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ≃
                      %annotation{:encoding => "application/x-tex"} \simeq
                %th
                  %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
                  %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative
                  %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesive
                  %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            %tbody
          %h2#Definition Definition
          %p We give a general abstract definition of physical fields in
          %ul
            %li
              %em
                %a{:href => "#DefinitionPhysicalField"} Physical fields
          %p Then we consider some general abstract operations on fields in
          %ul
            %li
              %em
                %a{:href => "#RestrictionAndPullback"} Restriction and pullback of fields
          %h3#DefinitionPhysicalField Physical fields
          %p
            A notion of
            %em field
            in physics is part of a specification of
            %em
              %a.existingWikiWord{:href => "/nlab/show/theory+%28physics%29"} physical theory
            or
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} physical model
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/prequantum+field+theory"} prequantum field theory
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/theory+%28physics%29"} theory
            %a.existingWikiWord{:href => "/nlab/show/model+%28physics%29"} model
            is specified by (or at least comes with) an
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %em field
            content of the theory is part of the specification of the
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            of the action functional. Therefore in def.
            %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
            below we define
            %em action functionals
            and the fields relative to this notion.
          %p We work in the following context.
