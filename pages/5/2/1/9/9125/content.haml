              of bulk and defect fields in def.
              %a.maruku-ref{:href => "#ModuliOfBulkAndBoundaryFields"}
              sits in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
