                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi d
                      %mi log
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}U(1)_{conn}
                  \\coloneqq
                  \\Omega^1//U(1)
                  \\simeq
                  DK(U(1) \stackrel{d log}{\to} \Omega^1)
          %p
            be the
            %a.existingWikiWord{:href => "/nlab/show/quotient+stack"} quotient stack
            of the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1)
            on the
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            of the sheaf of
            %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            given by the
            %a.existingWikiWord{:href => "/nlab/show/Deligne+complex"} Deligne complex
            for degree-2
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %p
            This is the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            for
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi BgFields
                  %mo ≃
                  %mo *
                %annotation{:encoding => "application/x-tex"} \mathbf{BgFields} \simeq *
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo ≔
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields} \coloneqq \mathbf{B}U(1)_{conn}
          %p
            in def.
            %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
            yields the type of the electromagnetic field.
          %h5#YangMillsField Yang-Mills field
          %p
            More generally, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^1(-,\mathfrak{g})
            the sheaf of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+1-forms"} Lie algebra valued 1-forms
          #ModuliStackOfGPrincipalConnection.num_defn
            %h6#definition_13 Definition
            %p
              The
              %strong
                moduli stack of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+stack"} quotient stack
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo ≔
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G_{conn}
                    \\coloneqq
                    \\Omega^1(-,\mathfrak{g})//G
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on it
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+forms"} Lie algebra valued differential forms
              by
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi A
                      %mi g
                    %mo ≔
                    %mo ↦
                    %msup
                      %mi A
                      %mi g
                    %msub
                      %mi Ad
                      %mi g
                    %mi A
                    %mo +
                    %msup
                      %mi g
                      %mo *
                    %mi θ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g \colon A^g \coloneqq \mapsto A^g Ad_g A + g^* \theta
                    \\,.
          %p
            This is the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi BgFields
                  %mo ≃
                  %mo *
                %annotation{:encoding => "application/x-tex"} \mathbf{BgFields} \simeq *
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo ≔
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields} \coloneqq \mathbf{B}G_{conn}
          %p
            in def.
            %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
            yields
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+fields"} Yang-Mills fields
          %h5#KalbRamondBField
            Kalb-Ramond
            = succeed "-field" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mrow
                      %msup
                        %mi B
                        %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo ≔
                  %msup
                    %mi Ω
                    %mrow
                      %mn 2
                      %mo ≤
                      %mo •
                      %mo ≤
                      %mn 1
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi d
                      %mi log
                  %msup
                    %mi Ω
                    %mn 1
                  %mover
                    %mo →
                    %mi d
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B^2}U(1)_{conn}
                  \\coloneqq
                  \\Omega^{2 \leq \bullet \leq 1} // \mathbf{B}U(1)
                  \\simeq
                  DK(U(1) \stackrel{d log}{\to} \Omega^1 \stackrel{d}{\to} \Omega^2)
          %p
            be the image under the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            of the
            %a.existingWikiWord{:href => "/nlab/show/Deligne+complex"} Deligne complex
            for degree-3
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            %a.existingWikiWord{:href => "/nlab/show/moduli+infinity-stack"} moduli 2-stack
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 2-bundle with connections
          %p
            Setting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi BgFields
                  %mo ≃
                  %mo *
                %annotation{:encoding => "application/x-tex"} \mathbf{BgFields} \simeq *
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo ≔
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields} \coloneqq \mathbf{B}^2 U(1)_{conn}
          %p
            in def.
            %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
            yields the 2-form gauge field known as the
            %em
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            or the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Kalb-Ramond+field"} Kalb-Ramond field
          %h5#KalbRamondBField
            Supergeometric
            = succeed "-field" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            appears both in
            %a.existingWikiWord{:href => "/nlab/show/bosonic+string+theory"} bosonic string theory
            as well as in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+II+superstring+theory"} type II superstring theory
            = succeed ")" do
              %a{:href => "#Precis"} Distler-Freed-Moore
            %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
            the plain formulation
            %a{:href => "#KalbRamondBField"} above
            needs to be refined. We discuss here the natural formulation of this observation in
            %a.existingWikiWord{:href => "/nlab/show/smooth+super+infinity-groupoid"} higher supergeometry
            as in (
            %a{:href => "#FiorenzaSatiSchreiberCSIntroAndSurvey"}> FSS CSIntroAndSurvey, section 4.3
            ).
          %p
            Generally instead of the
            %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1)
            one can consider the
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℂ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathbb{C}^\times
            of non-zero
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msup
                    %mi ℂ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} U(1) \hookrightarrow \mathbb{C}^\times
            induces for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            a canonical morphism of
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stacks"} moduli ∞-stacks
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msup
                    %mi ℂ
                    %mo ×
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}^n U(1) \to \mathbf{B}^n \mathbb{C}^\times
                  \\,.
          %p
            This is not quite an
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stacks"} ∞-stacks
            but it is a
            = succeed "-equivalence" do
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+cohesive+%E2%88%9E-groupoids"} geometric realization of cohesive ∞-groupoids
            sends it to an equivalence as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %mo ≃
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %msup
                      %mi ℂ
                      %mo ×
                    %mo{:stretchy => "false"} |
                  %mo ≃
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  {\vert \mathbf{B}^n U(1)\vert}
                  \\simeq
                  {\vert \mathbf{B}^n \mathbb{C}^\times\vert}
                  \\simeq
                  K(\mathbb{Z}, n+1)
                  \\,.
          %p
            For instance smooth
            %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundles"} principal U(1)-bundles
            and
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^\times
            %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            are both classified by the universal
            %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^2(-, \mathbb{Z})
            but the
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge
            %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
            of the trivial
            %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
            form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(-,U(1))
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^\times
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msup
                      %mi ℂ
                      %mo ×
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(-,\mathbb{C}^\times)
          %p
            Both versions of the moduli
            = succeed "-stack" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msup
                    %mi ℂ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^n \mathbb{C}^\times
            has the advantage that it is actually equivalent to the moduli
            = succeed "-stack" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-bundles." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msup
                    %mi ℂ
                    %mo ×
                  %mo ≃
                  %mi n
                  %msub
                    %mi Line
                    %mi ℂ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}^n \mathbb{C}^\times \simeq n Line_\mathbb{C}
                  \\,.
          %p
            Specifically for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            it is equivalent to the moduli 2-stack of
            %a.existingWikiWord{:href => "/nlab/show/line+2-bundles"} line 2-bundles
          .maruku-equation
