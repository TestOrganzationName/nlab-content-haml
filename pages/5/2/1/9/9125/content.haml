                  \\;\;
                  \\in SmoothSuper\infty Grpd
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
          %h5#SupergravityCField
            Supergravity
            = succeed "-field" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p Proceeding in this fashion, let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mrow
                      %msup
                        %mi B
                        %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo ≔
                  %msup
                    %mi Ω
                    %mrow
                      %mn 3
                      %mo ≤
                      %mo •
                      %mo ≤
                      %mn 1
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi DK
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi d
                      %mi log
                  %msup
                    %mi Ω
                    %mn 1
                  %mover
                    %mo →
                    %mi d
                  %msup
                    %mi Ω
                    %mn 2
                  %mover
                    %mo →
                    %mi d
                  %msup
                    %mi Ω
                    %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B^3}U(1)_{conn}
                  \\coloneqq
                  \\Omega^{3 \leq \bullet \leq 1} // \mathbf{B}^2 U(1)
                  \\simeq
                  DK(U(1) \stackrel{d log}{\to} \Omega^1 \stackrel{d}{\to} \Omega^2 \stackrel{d}{\to}\Omega^3)
          %p
            be the image under the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            of the
            %a.existingWikiWord{:href => "/nlab/show/Deligne+complex"} Deligne complex
            for degree-4
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            %a.existingWikiWord{:href => "/nlab/show/moduli+infinity-stack"} moduli 3-stack
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 3-bundle with connections
          %p Fields whose moduli stack is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
