                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
            %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundles"} associated ∞-bundles
            are an example of the general definition
            = succeed "." do
              %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∈
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Grp
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \in \Grp(\mathbf{H})
            a geometric
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Act
                  %mo ≃
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                %annotation{:encoding => "application/x-tex"}
                  G Act \simeq \mathbf{H}_{/\mathbf{B}G}
          %p
            between that of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-actions"} ∞-actions
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and the
            %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            over the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-representation"} ∞-representation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} V \in \mathbf{H}
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi V
                        %mtd
                          %mo →
                        %mtd
                          %mi V
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mover
                              %mi ρ
                              %mo ¯
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  V &amp;\to&amp; V//G
                  \\\
                  \&amp;&amp; \downarrow^{\overline \rho}
                  \\\
                  \&amp;&amp; \mathbf{B}G
                  }
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/universal+associated+%E2%88%9E-bundle"} universal rho-associated ∞-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            any
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            with modulating map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} g_X \;\colon\; X \to \mathbf{B}G
            the corresponding
            %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/fiber+%E2%88%9E-bundle"} fiber ∞-bundle
            is naturally equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ρ
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{\rho}
            along
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %msub
                    %mo ×
                    %mi G
                  %mi V
                  %mo ≃
                  %msubsup
                    %mi g
                    %mi X
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi ρ
                    %mo ¯
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  P \times_G V \simeq g_X^*(\overline{\rho})
                  \\,.
          %p
            From this and the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            one finds that a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of the
            %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated ∞-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %msub
                    %mo ×
                    %mi G
                  %mi V
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \times_G V \to X
            is equivalently a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %msub
                    %mi g
                    %mi X
                  %mo →
                  %mover
                    %mi ρ
                    %mo ¯
                %annotation{:encoding => "application/x-tex"}
                  \\phi : g_X \to \overline{\rho}
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}G}
          %p
            This means that such sections are fields in the sense of def.
            %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
            where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi BgFields
                      %mo ≃
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{BgFields} \simeq \mathbf{B}G
                ;
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
                is the moduli
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mi X
                      %annotation{:encoding => "application/x-tex"} g_X
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
                of fields is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi ρ
                          %mo ¯
                        %mo ∈
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                      %annotation{:encoding => "application/x-tex"} \overline{\rho} \in \mathbf{H}_{/\mathbf{B}G}
          %h4#Fermions Fermions
          %p
            %a.existingWikiWord{:href => "/nlab/show/fermion"}> fermion
            \:
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            a
            %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi Spin
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi Spin
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}
                  \\;\colon\;
                  S//Spin
                  \\to
                  \\mathbf{B}Spin
          %p
            in
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            (…)
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/electron"}> electron
                ,
                %a.existingWikiWord{:href => "/nlab/show/quark"} quark
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/gravitino"} gravitino
                (
                %a.existingWikiWord{:href => "/nlab/show/Rarita-Schwinger+field"}> Rarita-Schwinger field
                ),
                %a.existingWikiWord{:href => "/nlab/show/gluino"} gluino
          %h4#TensorFields Tensor fields
          %p
            While the term
            %em physical field
            probably orignates from
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/tensor+field"} tensor field
            %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            of a
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of copies of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            and the
            %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
            are certainly examples of the general notion of field as in def.
            = succeed "." do
              %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %a.existingWikiWord{:href => "/nlab/show/tensor+field"} tensor field
            of rank
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p,q)
            is a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mo ⊗
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mi p
                  %msub
                    %mo ⊗
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi T
                    %mo *
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ⊗
                      %mi q
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma(T X)^{\otimes_{C^\infty(X)} p} \otimes_{C^\infty(X)} \Gamma(T^* X)^{\otimes q}
                  \\,.
          %p
            This is canonically the
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
            to the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n)
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            which to which the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            is also canonically associated, by the given
            %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(n)
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo +
                        %mi q
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n(p+q)}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/universal+associated+%E2%88%9E-bundle"} universal associated ∞-bundle
            of this representation is
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mrow
                      %mi n
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mi q
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}
                  \\;\colon\; \mathbb{R}^{n (p+q)}//GL(n) \to \mathbf{B}GL(n)
            \.
          %p
            Hence for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi X
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_X \colon X \to \mathbf{B}GL(n)
            the canonical map, the space of
            = succeed "-tensor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi τ
                    %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [\tau_X, \mathbf{Fields}]_{\mathbf{H}}
                  \\in
                  \\mathbf{H}
                  \\,.
          %p
            By passing to
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
            in the above, we obtain specifically the corresponding subclasses of tensor fields, such as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
          %h3#FieldCombiningVariousProperties Fields combining these properties
          %p
            The above distinction of types of physical fields into into
            = succeed "," do
              %a{:href => "SigmaModelFields"} Sigma-model fields
            = succeed "," do
              %a{:href => "#FieldsOfGravityAndGeneralizedGeometry"} Force fields of gravity
            %a{:href => "#GaugeFields"} Gauge force fields
            and
            %a{:href => "#MatterFields"} Matter fields
            can be helpful for reasoning about fields and types of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/theories+%28physics%29"} theories in physics
            %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
            of which all these types are examples reflects that. In fact, one way to read that definition and the above list of examples is to say that it shows that in
            %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            %em all
            types of fields are
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            fields: they are all given as maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                %annotation{:encoding => "application/x-tex"} \Phi_X \to \mathbf{Fields}
            from a domain
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed "+" do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mi X
                %annotation{:encoding => "application/x-tex"} \Phi_X
            to a generalized
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}
            (the
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
            of fields in the given
            %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
            characterized by the nature of the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/background+fields"} background fields
          %p
            Accordingly, a general physical field in a general
            %a.existingWikiWord{:href => "/nlab/show/theory+%28physics%29"} theory
            does not fall squarely into one of the above categories, but combines aspects of all of these. Here we discuss such examples.
          %h4#TwistedDifferentialcStructurs
            %strong General
            – Twisted differential-cocycles and -
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi c
                %annotation{:encoding => "application/x-tex"} \mathbf{c}
            \-structures
          %p
            We have seen that the
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
            of a field of plain
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            or general geometry is a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi c
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{c} \colon \mathbf{B}\hat G \to \mathbf{B}G
            of
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
            %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
