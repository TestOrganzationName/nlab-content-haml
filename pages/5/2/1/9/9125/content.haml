              with
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϕ
                        %mi a
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi a
                          %mo =
                          %mn 1
                        %mi s
                    %annotation{:encoding => "application/x-tex"} (\phi^a)_{a = 1}^s
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              a natural number, the
              %em
                order-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
