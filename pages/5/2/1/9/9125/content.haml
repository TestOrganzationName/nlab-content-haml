          %p
            but now in the
            %a.existingWikiWord{:href => "/nlab/show/arrow+%28%E2%88%9E%2C1%29-topos"} arrow (∞,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
