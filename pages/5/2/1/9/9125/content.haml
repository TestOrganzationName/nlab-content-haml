            (the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor+%28%E2%88%9E%2C1%29-category"} (∞,1)-functor (∞,1)-category
            from the
            = succeed "/1-" do
              %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            to
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p
            A generic object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^{(\Delta^1)}
            here is a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi X
                %annotation{:encoding => "application/x-tex"} \iota_X
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi X
                    %mi def
                  %mo →
                  %msub
                    %mi X
                    %mi bulk
                %annotation{:encoding => "application/x-tex"}
                  \\iota_X
                  \\;\colon\;
                  X_{def}
                  \\to
                  X_{bulk}
          %p
            where the subscripts are for “bulk” and for “defect” (as in
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/QFT+with+defects"} QFT with defects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^{(\Delta^1)}
            which is given by a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi ι
                    %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                %annotation{:encoding => "application/x-tex"}
                  \\phi
                  \\;\colon\;
                  \\iota_X \to \mathbf{Fields}
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}^{(\Delta^1)}
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mi def
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ϕ
                                %mi def
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mi def
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi ι
                                  %mi X
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mstyle{:mathvariant => "bold"}
                                %mi Fields
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mi bulk
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ϕ
                                %mi bulk
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mi bulk
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X_{def} &amp;\stackrel{\phi_{def}}{\to}&amp; \mathbf{Fields}_{def}
                  \\\
                  {}^{\mathllap{\iota_X}}\downarrow
                  \&amp;\swArrow&amp;
                  \\downarrow^{\mathrlap{\mathbf{Fields}}}
                  \\\
                  X_{bulk} &amp;\stackrel{\phi_{bulk}}{\to}&amp; \mathbf{Fields}_{bulk}
                  }
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
