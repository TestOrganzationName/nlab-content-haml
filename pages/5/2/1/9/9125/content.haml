              be the canonical differential refinement of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi OrthStruc
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbf{OrthStruc}_n
              %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
              of
              %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
              appear. For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a manifold as above, let then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi τ
                        %mo{:stretchy => "false"} ^
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\hat \tau_X
                    \\;\colon\;
                    X
                    \\to
                    \\mathbf{B}GL(n)_{conn}
            %p
              modulate an
              %a.existingWikiWord{:href => "/nlab/show/affine+connection"} affine connection
              on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mi τ
                        %mo{:stretchy => "false"} ^
                      %mi X
                    %mo →
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi OrthStruc
                        %mo ^
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \;\colon\; \hat \tau_X \to \widehat \mathbf{OrthStruc}_n
            %p
              is now still equivalently just a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                    %msub
                      %mover
                        %mi τ
                        %mo{:stretchy => "false"} ^
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\mathbf{B}GL(n)_{conn}}{\sum} \hat \tau_X
                    \\;\colon\;
                    X \to \mathbf{B}O(n)_{conn}
            %p
              now captures the orthognal connection which in the physics literature is often called (inaccurately) the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/spin+connection"} spin connection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
              %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
              then exhibits the original
              %a.existingWikiWord{:href => "/nlab/show/affine+connection"} affine connection
              as that whose components are the
              %a.existingWikiWord{:href => "/nlab/show/Christoffel+symbols"} Christoffel symbols
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              of the
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              defined as above, a relation that is familiar from the physics literature in the form of the
              %a.existingWikiWord{:href => "/nlab/show/equation"} equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi Γ
                    %mi e
                    %mo +
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi d
                    %mi e
                  %annotation{:encoding => "application/x-tex"}
                    \\omega = e^{-1}\Gamma e + e^{-1} d e
            %p between local connection 1-form components.
          %p
            But both these examples do not fully accurately reflect the field content of
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            yet. This is because the
            %a.existingWikiWord{:href => "/nlab/show/theory+%28physics%29"} theory
            of
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            is supposed to by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/general+covariance"} generally covariant
            %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
            field configurations as in example
            %a.maruku-ref{:href => "#RiemannianVielbein"}
            such that one goes into the other under a
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            of
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            between them.
          #GenerallyCovariantFieldOfGravity.num_example
            %h6#example_6 Example
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Diff
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mstyle{:mathvariant => "bold"}
                      %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Diff}(X) \coloneqq \mathbf{Aut}(X) \in Grp(\mathbf{H})
              for the
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism+group"} diffeomorphism group
              of the
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              of the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-group"} automorphism ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Diff
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Diff}(X)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              itself, exhibited by the universal
              %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated ∞-bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi Diff
                      %mrow
                        %mo (
                        %mi X
                        %mo )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mstyle{:mathvariant => "bold"}
                        %mi Diff
                      %mrow
                        %mo (
                        %mi X
                        %mo )
                      %mo )
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mstyle{:mathvariant => "bold"}
                          %mi Diff
                        %mrow
                          %mo (
                          %mi X
                          %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(X // \mathbf{Diff}\left(X\right) \to \mathbf{B}\mathbf{Diff}\left(X\right) \right)
                    \\in
                    \\mathbf{H}_{/\mathbf{B}\mathbf{Diff}\left(X\right)}
                    \\,.
            %p
              This induces also an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              also on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            %p Moreover the trivial bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Diff
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi OrthStruc
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mstyle{:mathvariant => "bold"}
                      %mi Diff
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mstyle{:mathvariant => "bold"}
                          %mi Diff
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Fields}
                    \\coloneqq
                    (\mathbf{Diff}(X)\times \mathbf{OrthStruc} \to \mathbf{B}\mathbf{Diff}(X) )
                    \\in
                    \\mathbf{H}_{/\mathbf{B}\mathbf{Diff}(X)}
            %p corresponds to the trivial action.
            %p Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi Diff
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mo{:stretchy => "false"} (
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi τ
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\mathbf{B}Diff(n)}{\sum}
                    \\underset{\mathbf{B}(GL(n))}{\prod}
                    [\tau_X, \mathbf{Fields}]
                    \\in \mathbf{H}
            %p
              is the accurate space of
              %a.existingWikiWord{:href => "/nlab/show/general+covariance"} generally covariant
              fields of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
          %h5#SpinStructures
