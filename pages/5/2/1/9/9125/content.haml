                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              = succeed ":" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/universal+associated+%E2%88%9E-bundle"} universal rho-associated ∞-bundle
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              with modulating map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g_X \;\colon\; X \to \mathbf{B}G
              there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence in an (∞,1)-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mi G
                    %mi V
                    %mo ≃
                    %msubsup
                      %mi g
                      %mi X
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi ρ
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P \times_G V \simeq g_X^*(\overline{\rho})
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
          .num_remark
            %h6#remark_5 Remark
            %p
              In summary this means that an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              of an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on any object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} V \in \mathbf{H}
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi V
                          %mtd
                            %mo →
                          %mtd
                            %mi V
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mi ρ
                                  %mo ¯
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    V &amp;\to&amp; V//G
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{\overline{\rho}}}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
                    \\,.
            %p
              Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              any
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              modulated by a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ;
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g ;\colon\; X \to \mathbf{B}G
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                            %msub
                              %mo ×
                              %mi G
                            %mi V
                          %mtd
                            %mo →
                          %mtd
                            %mi V
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mi ρ
                                  %mo ¯
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P \times_G V
                    \&amp;\to&amp;
                    V//G
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\overline{\rho}}}
                    \\\
                    X &amp;\stackrel{g}{\to}&amp; \mathbf{B}G
                    }
                    \\,.
          %p
            Due to the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            this has the following consequence which, basic as it is, is fundamental for the interpretation of fields in def.
            = succeed "." do
              %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
          .num_prop
            %h6#proposition_9 Proposition
            %p
              There is a canonical
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence in an (∞,1)-category
              between the
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
              %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated ∞-bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mi X
                    %mi G
                  %annotation{:encoding => "application/x-tex"} P \times_X G
              and maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi X
                    %mo →
                    %mover
                      %mi ρ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} g_X \to \overline{\rho}
              in the slice, hence fields in the sense of def.
              %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
              with background field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi X
                  %annotation{:encoding => "application/x-tex"} g_X
              and moduli stack
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi ρ
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{\rho}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi P
                    %msub
                      %mo ×
                      %mi G
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi g
                      %mi X
                    %mo ,
                    %mover
                      %mi ρ
                      %mo ¯
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Gamma}_X(P \times_G V)
                    \\simeq
                    [g_X, \overline{\rho}]_{\mathbf{H}}
                    \\,.
          .num_remark
            %h6#remark_6 Remark
            %p
              This equivalence is constituted simply by forming the
              %a.existingWikiWord{:href => "/nlab/show/pasting+diagram"} pasting diagram
              of the
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              with the above
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi P
                            %msub
                              %mo ×
                              %mi G
                            %mi V
                          %mtd
                            %mo →
                          %mtd
                            %mi V
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi σ
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mi ρ
                                  %mo ¯
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi id
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi σ
                          %mtd
                          %mtd
                            %mi V
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi g
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mover
                                %mi ρ
                                %mo ¯
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; P \times_G V
                    \&amp;\to&amp;
                    V//G
                    \\\
                    \&amp;{}^{\mathllap{\sigma}}\nearrow&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{\overline{\rho}}}
                    \\\
                    X &amp;\stackrel{id}{\to}&amp; X &amp;\stackrel{g}{\to}&amp; \mathbf{B}G
                    }
                    \\;\;\;\;\;\;
                    \\simeq
                    \\;\;\;\;\;\;
                    \\array{
                    X &amp;&amp;\stackrel{\sigma}{\to}&amp;&amp; V//G
                    \\\
                    \&amp; {}_{\mathllap{g}}\searrow &amp;&amp; \swarrow_{\overline{\rho}}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
                    \\,.
          %p
            The following further central property leads in the
            %a{:href => "#RelationToTwistedCohomology"} following section
            to an equivalent re-formulation of this in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
          .num_prop
            %h6#proposition_10 Proposition
            %p
              Every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is
              %em locally trivizable
              in that there exists a
              %a.existingWikiWord{:href => "/nlab/show/1-epimorphism"} 1-epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \;\colon\; U \to X
              and an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                            %mo ×
                            %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mi P
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                            %mover
                              %mo →
                              %mi p
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U \times G &amp;\to&amp; P
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    U &amp;\stackrel{p}{\to}&amp; X
                    }
            %p or equivalently a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U &amp;\to&amp; *
                    \\\
                    \\downarrow^{\mathrlap{p}}
                    \&amp;\swArrow_{\simeq}&amp;
                    \\downarrow
                    \\\
                    X &amp; \stackrel{g}{\to} &amp; \mathbf{B}G
                    }
                    \\,.
          .num_remark
            %h6#remark_7 Remark
            %p Together the above facts imply that for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi P
                            %msub
                              %mo ×
                              %mi G
                            %mi V
                          %mtd
                            %mo →
                          %mtd
                            %mi V
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi σ
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mi ρ
                                  %mo ¯
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi id
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; P \times_G V &amp;\to&amp; V//G
                    \\\
                    \&amp; {}^{\mathllap{\sigma}}\nearrow &amp; \downarrow
                    \&amp;&amp; \downarrow^{\mathrlap{\overline{\rho}}}
                    \\\
                    X &amp;\stackrel{id}{\to}&amp; X &amp;\stackrel{g}{\to}&amp; \mathbf{B}G
                    }
            %p
              a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated ∞-bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                  %annotation{:encoding => "application/x-tex"} \sigma|_U
              of the section along the trivializing cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \;\colon\; U \to X
              factors through
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo →
                      %mi V
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi G
                    %annotation{:encoding => "application/x-tex"} V \to V//G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi V
                          %mtd
                            %mo →
                          %mtd
                            %mi V
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi σ
                                  %msub
                                    %mo{:stretchy => "false"} |
                                    %mi U
                            %mo ↗
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mi ρ
                                  %mo ¯
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                            %mover
                              %mo →
                              %mi p
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; V &amp;\to&amp; V//G
                    \\\
                    \&amp; {}^{\mathllap{\sigma|_U}}\nearrow &amp;  &amp;&amp; \downarrow^{\mathrlap{\overline{\rho}}}
                    \\\
                    U &amp;\stackrel{p}{\to}&amp; X &amp;\stackrel{g}{\to}&amp; \mathbf{B}G
                    }
                    \\,.
            %p
              This means that a section of an
              %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/fiber+%E2%88%9E-bundle"} fiber ∞-bundle
              is locally a
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              in
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mi V
                    %annotation{:encoding => "application/x-tex"} \Omega V
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
          %p
            And so we say that
            %em globally
            it is a “twisted”
            = succeed "-cocycle." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \Omega V
          %h3#RelationToTwistedCohomology Relation to twisted cohomology
          %p
            We discuss here how def.
            %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
            of fields has an entirely equivalent expression in terms of
            %em
              %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in general
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            and in fact, if the background field is nontrivial, in
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            and
            %em
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            as discussed there (
            %a{:href => "#NSS"}> NSS
            ). The unification of notions seen this way gives a natural home for instance to the familiar observations such as that
            %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+fields"} Chan-Paton gauge fields
            on
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            are identified with
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in (
            %a.existingWikiWord{:href => "/nlab/show/differential+K-theory"}> differential
            )
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            (see
            %em
              %a{:href => "#ChanPatonGaugeFields"} Chan-Paton gauge fields
            below).
          %p First observe the following
          .num_remark
            %h6#remark_8 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Φ
                      %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                  %annotation{:encoding => "application/x-tex"} \phi \;\colon\; \Phi_X \to \mathbf{Fields}
              a field configuration as in def.
              %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
              in the corresponding
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi ϕ
                          %mtd
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mstyle{:mathvariant => "bold"}
                                %mi BgFields
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi Φ
                                    %mi X
                            %mo ↘
                          %mtd
                            %mo ⇙
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mstyle{:mathvariant => "bold"}
                                  %mi Fields
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi BgFields
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp;\stackrel{\phi}{\to}&amp;&amp; \underset{\mathbf{BgFields}}{\sum} \mathbf{Fields}
                    \\\
                    \&amp; {}_{\mathllap{\Phi_X}}\searrow
                    \&amp;\swArrow&amp;
                    \\swarrow_{\mathrlap{\mathbf{Fields}}}
                    \\\
                    \&amp;&amp; \mathbf{BgFields}
                    }
            %p
              we have the following equivalently identifications when interpreting this as a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            %ul
              %li
                %p
                  the object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Fields
                        %mo ∈
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} matbbf
                        %msub
                          %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mstyle{:mathvariant => "bold"}
                              %mi BgFields
                      %annotation{:encoding => "application/x-tex"} \mathbf{Fields} \in \matbbf{H}_{/\mathbf{BgFields}}
                  is the
                  = succeed ";" do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/local+coefficient+%E2%88%9E-bundle"} local coefficient ∞-bundle
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi ϕ
                            %mo ∈
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mo{:stretchy => "false"} ]
                        %mstyle{:mathvariant => "bold"}
                          %mi Fields
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi BgFields
                      %annotation{:encoding => "application/x-tex"} \underset{\phi \in [X, \mathbf{Fields}]}{\sum}\mathbf{Fields} \to \mathbf{BgFields}
                  is the
                  %strong
                    local
                    %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
                  for a
                  %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                  theory;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Φ
                          %mi X
                      %annotation{:encoding => "application/x-tex"} \Phi_X
                  is the
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twist
              %li
                %p
                  the field
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi Φ
                          %mi X
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi Fields
                      %annotation{:encoding => "application/x-tex"} \phi \colon \Phi_X \to \mathbf{Fields}
                  is
                %ul
                  %li
                    %p
                      a
                      %strong
                        %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
                      in
                      = succeed "-" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi Φ
                                %mi X
                            %annotation{:encoding => "application/x-tex"} \Phi_X
                      %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
                      on
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X
                      with local
                      %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi V
                          %annotation{:encoding => "application/x-tex"} V
                  %li
                    %p
                      equivalently: a
                      %strong
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                          %semantics
                            %mrow
                              %msub
                                %mi Φ
                                %mi X
                            %annotation{:encoding => "application/x-tex"} \Phi_X
                        \-twisted
                        %a.existingWikiWord{:href => "/nlab/show/G-structure"} V-structure
                      on
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi X
                            %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
                  is a
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
                  in
                  = succeed "-twisted" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Φ
                            %mi X
                        %annotation{:encoding => "application/x-tex"} \Phi_X
                  = succeed "-cohomology;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
                  of fields are the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Φ
                            %mi X
                        %annotation{:encoding => "application/x-tex"} \Phi_X
                  %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                  of
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi H
                          %mrow
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Φ
                              %mi X
                            %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi τ
                          %mn 0
                        %mi Γ
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi Fields
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        H_{[\Phi_X]}(X,V) \simeq \tau_0\Gamma[X,\mathbf{Fields}]_{\mathbf{H}}
                        \\,.
          %p
            We see several illustrations of these identifications in the list of
            %em
              %a{:href => "#Examples"} Examples
            below. More generally, there is a canonical identification of physical fields in the presence of background fields
            %em and
            boundary/defect with twisted and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative cohomology
            = succeed "." do
              %em
                %a{:href => "#RelationToRelativeCohomology"} Relation to relative cohomology
          %h3#RelationToRelativeCohomology Relation to relative cohomology
          %p
            When we refine background fields to dynamical fields as discussed above in
            %em
              %a{:href => "#BoundaryAndDefectFields"} Boundary and defect fields
            then the identification of fields with
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            as discussed above in
            %em
              %a{:href => "#RelationToTwistedCohomology"} Relation to twisted cohomology
            accordingly generalized a bit: it becomes a combination of twisted cohomology and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative cohomology
          %p For consider the special case that the moduli of defect fields are trivial, hence that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:lspace => "verythinmathspace"} :
                  %mo *
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi pt
                        %mi Q
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mi bulk
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields} \colon * \stackrel{pt_Q}{\to} \mathbf{Fields}_{bulk}
          %p
            is the global point inclusion into the bulk field moduli (the trivial bulk field). By prop.
            %a.maruku-ref{:href => "#ModuliOfBulkAndDefectFieldsAsPullback"}
            it follows that
          .num_prop
            %h6#proposition_11 Proposition
            %p There is a natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ι
                      %mi X
                    %mo ,
                    %msub
                      %mi pt
                      %mi A
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mi bulk
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %munder
                      %mo ×
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi X
                          %mi def
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} ]
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [\iota_X, pt_A]
                    \\simeq
                    [X_{bulk}, A] \underset{[X_{def}, A]}{\times} {*}
                    \\,,
            %p
              hence a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ι
                      %mi X
                    %mo ,
                    %msub
                      %mi pt
                      %mi A
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mi bulk
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mi def
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [\iota_X, pt_A]
                    \\to
                    [X_{bulk}, A]
                    \\to
                    [X_{def}, A]
          .num_remark
            %h6#remark_9 Remark
            %p
              This identifies the equivalence classes of global points in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ι
                      %mi X
                    %mo ,
                    %msub
                      %mi pt
                      %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\iota_X, pt_A]
              as the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \iota_X
              %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative A-cohomology
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            In general, if the defect fields are not trivial, the fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                %annotation{:encoding => "application/x-tex"} \iota_X \to \mathbf{Fields}
            (hence ordinary cocycles in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^{(\Delta^1)}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            that are a combination of relative and twisted cocycles: instead with their pullback to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi def
                %annotation{:encoding => "application/x-tex"} X_{def}
            being equipped with a trivialization, it is equipped with a “twisted trivialization” in the sense of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/twisted+differential+c-structure"} twisted c-structures
            = succeed "." do
              %a{:href => "#TwistedDifferentialcStructurs"} below
          %h2#Examples Examples
          %p
            We distinguish four broad classes of examples of physical fields, according to def.
            = succeed ":" do
              %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
          %ol
            %li
              %p
                %a{:href => "#SclarModuliFields"} Scalar and moduli fields
              %p
                The simplest type of field is a (
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"}> smooth
                )
                %a.existingWikiWord{:href => "/nlab/show/function"} function
                on
