                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi Φ
                            %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi Fields
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                        %annotation{:encoding => "application/x-tex"} [\Phi_X,\mathbf{Fields}]_{\mathbf{H}}
                  %a.maruku-ref{:href => "#GlobalPointsOfModuliOfFields"}
                  below) the morphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Φ
                          %mi X
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi Fields
                      %annotation{:encoding => "application/x-tex"}
                        \\phi \;\colon\; \Phi_X \to \mathbf{Fields}
                %p
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mrow
                              %mo{:stretchy => "false"} /
