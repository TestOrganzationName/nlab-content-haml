              of such field configurations is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi ι
                              %mi Σ
                            %mo ,
                            %msub
                              %mi ι
                              %mi X
                            %mo{:stretchy => "false"} ]
                          %mtd
