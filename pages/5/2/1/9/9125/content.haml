            with
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
          %table
            %thead
              %tr
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
