                        %msub
                          %mi ϕ
                          %mi def
                      %annotation{:encoding => "application/x-tex"} \phi_{def}
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
                that relates the restriction (or more generally: pullback to
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi def
                      %annotation{:encoding => "application/x-tex"} X_{def}
          .num_remark
            %h6#remark_3 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi bulk
                  %annotation{:encoding => "application/x-tex"} \phi_{bulk}
              is regarded as fixed, then this is equivalently a field configuration as in def.
              %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
              defined on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi def
                  %annotation{:encoding => "application/x-tex"} X_{def}
              and for background field the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %msub
                          %mi X
                          %mi def
                    %mo ≔
                    %msubsup
                      %mi ι
                      %mi X
                      %mo *
                    %msub
                      %mi ϕ
                      %mi bulk
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mi def
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ι
                          %mi X
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ϕ
                          %mi bulk
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                      %mi bulk
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi_{X_{def}}
                    \\coloneqq
                    \\iota_X^* \phi_{bulk}
                    \\;\colon\;
                    X_{def} \stackrel{\iota_X}{\to}
                    X \stackrel{\phi_{bulk}}{\to}
                    \\mathbf{Fields}_{bulk}
                    \\,.
          %p
            This “fixing of bulk fields to background fields for defect fields” we discuss in more detail below in
            = succeed "." do
              %em
                %a{:href => "#ModuliStacksOfFields"} Properties – Moduli stacks of fields
          %p
            We formalize the moduli
            = succeed "-stack" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .num_defn
            %h6#definition_9 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi Γ
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi Disc
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}^{(\Delta^1)}
                    \\stackrel{\overset{Disc_{\mathbf{H}}}{\leftarrow}}{\underset{\Gamma_{\mathbf{H}}}{\to}}
                    \\mathbf{H}
            %p
              for the canonical
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
          #ModuliOfBulkAndBoundaryFields.num_defn
            %h6#definition_10 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi X
                    %mo ;
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mi def
                    %mo →
                    %msub
                      %mi X
                      %mi bulk
                  %annotation{:encoding => "application/x-tex"} \iota_X ;\colon\; X_{def} \to X_{bulk}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                      %mi def
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                      %mi bulk
                  %annotation{:encoding => "application/x-tex"} \mathbf{Fields} \;\colon\; \mathbf{Fields}_{def} \to \mathbf{Fields}_{bulk}
              morphisms in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ι
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo ≔
                    %msub
                      %mi Γ
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ι
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    [\iota_X, \mathbf{Fields}]_{\mathbf{H}}
                    \\coloneqq
                    \\Gamma_{\mathbf{H}}[\iota_X, \mathbf{Fields}]
                    \\;\;
                    \\in \mathbf{H}
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
              of bulk and boundary fields on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \iota_X
          %p Several examples of this are discussed below.
          %h2#FieldsProperties Properties
          %p
            The definition of fields in def.
            %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
            is in fact the central part of a general theory of
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            and
            %em
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
            in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos+theory"} (∞,1)-topos theory
            and various insights into
            %a.existingWikiWord{:href => "/nlab/show/prequantum+field+theory"} prequantum field theory
            follow by making this perspective explicit. This is what we do here
          %ol
            %li
              %p
                %a{:href => "#ModuliStacksOfFields"} Moduli ∞-stacks of fields
            %li
              %p
                %a{:href => "#RelationOfFieldsToSections"} Relation of fields to sections of ∞-bundles
            %li
              %p
                %a{:href => "#RelationToTwistedCohomology"} Relation of fields to twisted cohomology
            %li
              %p
                %a{:href => "#RelationToRelativeCohomology"} Relation of fields to relative cohomology
          %p
            The central results that underlie these identifications are in (
            %a{:href => "#NSS"}> NSS
            ), also
            = succeed "." do
              %a{:href => "#dcct"} dcct, section 3.6.10, 3.6.11, 3.6.12, 3.6.15
          %h3#ModuliStacksOfFields
            Moduli
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            The object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Φ
                    %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} [\Phi_X, \mathbf{Fields}]_{\mathbf{H}} \in \mathbf{H}
            of def.
            %a.maruku-ref{:href => "#FieldsInAnActionFunctional"}
            we may call the
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
            of fields. Here we discuss various properties of this object.
          #GlobalPointsOfModuliOfFields.num_prop
            %h6#proposition_3 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              of global
              %a.existingWikiWord{:href => "/nlab/show/elements"} elements
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                  %annotation{:encoding => "application/x-tex"} [X, \mathbf{Fields}]_{\mathbf{H}}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Φ
                      %mi X
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Γ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Φ
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi BgFields
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Φ
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}(*,[\Phi_X, \mathbf{Fields}_{\mathbf{H}}])
                    \\simeq
                    \\Gamma [\Phi_X, \mathbf{Fields}]_{\mathbf{H}}
                    \\simeq
                    \\mathbf{H}_{/\mathbf{BgFields}}(\Phi_X, \mathbf{Fields})
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              Using the
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Φ
                              %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mstyle{:mathvariant => "bold"}
                                %mi BgFields
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Φ
                              %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi BgFields
                            %mo{:stretchy => "false"} (
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi BgFields
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Φ
                              %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi BgFields
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Φ
                              %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi BgFields
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Φ
                              %mi X
                            %mo ,
