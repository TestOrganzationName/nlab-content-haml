                    \&amp; \vdots &amp;&amp; \vdots &amp;&amp; \vdots
                    }
                    \\,.
            %p
              This is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} variational bicomplex
          %p
            %strong
              derivatives on
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
          %table
            %thead
              %tr
                %th symbols
                %th name
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %annotation{:encoding => "application/x-tex"} \mathbf{d}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ≔
                        %mi d
                        %msup
                          %mi x
                          %mi μ
                        %mfrac
                          %mi d
                          %mrow
                            %mi d
                            %msup
                              %mi x
                              %mi μ
                      %annotation{:encoding => "application/x-tex"} d \coloneqq d x^\mu \frac{d}{d x^\mu}
                %td{:style => "text-align: left;"}
                  (
                  %a.existingWikiWord{:href => "/nlab/show/total+derivative"}> total
                  )
                  %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"} horizontal derivative
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac
                          %mi d
                          %mrow
                            %mi d
                            %msup
                              %mi x
                              %mi μ
                        %mo ≔
                        %mfrac
                          %mo ∂
                          %mrow
                            %mo ∂
                            %msup
                              %mi x
                              %mi μ
                        %mo +
                        %msubsup
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi μ
                          %mi a
                        %mfrac
                          %mo ∂
                          %mrow
                            %mo ∂
                            %msup
                              %mi ϕ
                              %mi a
                        %mo +
                        %mi ⋯
                      %annotation{:encoding => "application/x-tex"} \frac{d}{d x^\mu} \coloneqq \frac{\partial}{\partial x^\mu} +  \phi^a_{,\mu} \frac{\partial}{\partial \phi^a}  + \cdots
                %td{:style => "text-align: left;"}
                  (
                  %a.existingWikiWord{:href => "/nlab/show/total+derivative"}> total
                  )
                  %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"} horizontal derivative
                  along
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∂
                          %mi μ
                      %annotation{:encoding => "application/x-tex"} \partial_\mu
              %tr
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                        %mo ≔
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                        %mo −
                        %mi d
                      %annotation{:encoding => "application/x-tex"} \delta \coloneqq \mathbf{d} - d
                %td{:style => "text-align: left;"}
                  (variational)
                  %a.existingWikiWord{:href => "/nlab/show/vertical+derivative"} vertical derivative
              %tr
