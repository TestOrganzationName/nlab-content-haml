              %li
                %p
                  together with a
                  %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
