                                  %mstyle{:mathvariant => "bold"}
                                    %mi BgFields
                                %mstyle{:mathvariant => "bold"}
                                  %mi Fields
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi Φ
                                        %mi X
                                %mo ↘
                              %mtd
                                %mo ⇙
                              %mtd
                                %msub
                                  %mo ↙
                                  %mpadded{:width => "0"}
                                    %mstyle{:mathvariant => "bold"}
                                      %mi Fields
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mstyle{:mathvariant => "bold"}
                                  %mi BgFields
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        X &amp;&amp;\stackrel{\phi}{\to}&amp;&amp; \underset{\mathbf{BgFields}}{\sum} \mathbf{Fields}
                        \\\
                        \&amp; {}_{\mathllap{\Phi_X}}\searrow
                        \&amp;\swArrow&amp;
                        \\swarrow_{\mathrlap{\mathbf{Fields}}}
                        \\\
                        \&amp;&amp; \mathbf{BgFields}
                        }
                %p
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                        %annotation{:encoding => "application/x-tex"} \mathbf{H}
                  %strong fields
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  a
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
