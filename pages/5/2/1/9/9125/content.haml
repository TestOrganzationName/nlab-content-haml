                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} ↓
                        %annotation{:encoding => "application/x-tex"} \downarrow
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal group
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi SO
                          %mover
                            %mo →
                            %mstyle{:mathvariant => "bold"}
                              %mrow
                                %msub
                                  %mi w
                                  %mn 2
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %msub
                            %mi ℤ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}SO \stackrel{\mathbf{w_2}}{\to} \mathbf{B}^2 \mathbb{Z}_2
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/orientation+structure"} orientation structure
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/first+Stiefel-Whitney+class"} first Stiefel-Whitney class
                %tr
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} ↓
                        %annotation{:encoding => "application/x-tex"} \downarrow
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi O
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi w
                                %mn 1
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi ℤ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}O \stackrel{\mathbf{w}_1}{\to} \mathbf{B}\mathbb{Z}_2
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/orthogonal+structure"}> orthogonal structure
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/vielbein"}> vielbein
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} ↓
                        %annotation{:encoding => "application/x-tex"} \downarrow
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}GL
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  %td{:style => "text-align: left;"}
            %p
              (all hooks are
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequences"} homotopy fiber sequences
          %p
            Notice, as in remark
            = succeed "," do
              %a.maruku-ref{:href => "#OrthogonalStructureIsTrivialInPlainHomotopyTheory"}
            %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stacks"} moduli ∞-stacks
            and not in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
          %p
            Hence if a background field of
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            is assumed,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi BgFields
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{BgFields} \colon \mathbf{B}O(n)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi X
                    %mo =
                    %msub
                      %mi e
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \Phi_X = e_X
            = succeed "-fields" do
              %a.existingWikiWord{:href => "/nlab/show/orientation+structure"} orientation structure
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields} \colon \mathbf{B} SO(n) \to \mathbf{B}O(n)
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}O(n)}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi BgFields
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{BgFields} \colon \mathbf{B}SO(n)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi X
                    %mo =
                    %msub
                      %mi o
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \Phi_X = o_X
            = succeed "-fields" do
              %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields} \colon \mathbf{B} Spin(n) \to \mathbf{B}SO(n)
                  \\,.
          %p
            Evidently there is then also a notion of
            = succeed "-fields." do
              %a.existingWikiWord{:href => "/nlab/show/higher+spin+structure"} higher spin structure
            %a.existingWikiWord{:href => "/nlab/show/spinning+particles"} spinning particles
            to
            %a.existingWikiWord{:href => "/nlab/show/spinning+strings"} spinning strings
            and then to further “spinning”
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/branes"} branes
            = succeed "." do
              %em
                %a{:href => "#HigherSpinStructures"} Higher spin structures
          %h5#SpinStructures
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mi Spin
                    %mi c
                %annotation{:encoding => "application/x-tex"} Spin^c
            \-structures
          %p
            Some
            %a.existingWikiWord{:href => "/nlab/show/theory+%28physics%29"} theories
            involve not plain
            %a.existingWikiWord{:href => "/nlab/show/spin+structures"} spin structures
            but
            %a.existingWikiWord{:href => "/nlab/show/spin-c+structures"} spin-c structures
            on their
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            (for instance in
            %a.existingWikiWord{:href => "/nlab/show/Seiberg-Witten+theory"} Seiberg-Witten theory
            or in the
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            over
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
            %em
              %a{:href => "#ChanPatonGaugeFields"} Chan-Paton gauge fields on D-branes
            below). By the discussion there, the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msup
                    %mi Spin
                    %mi c
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}Spin^c(n)
            for
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/spin%5Ec+group"} spin^c group
            %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            sits in the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msup
                            %mi Spin
                            %mi c
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                                  %mn 1
                                %mspace{:width => "thinmathspace"}
                                %mi mod
                                %mspace{:width => "thinmathspace"}
                                %mn 2
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi w
                                %mn 2
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %msub
                            %mi ℤ
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B}Spin^c &amp;\to&amp; \mathbf{B}U(1)
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{\mathbf{c}_1 \,mod\, 2}}
                  \\\
                  \\mathbf{B}SO(n) &amp;\stackrel{\mathbf{w}_2}{\to}&amp;
                  \\mathbf{B}^2\mathbb{Z}_2
                  }
                  \\,,
          %p
            where the right vertical map represents the universal
            %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
            modulo 2. In other words this says that a
            %a.existingWikiWord{:href => "/nlab/show/spin%5Ec-structure"} spin^c-structure
            on some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/twisted+differential+c-structure"} twisted w2-structure
            with twist the first Chern-class of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+bundle"} circle bundle
          %p
            So if that circle bundle is regarded as a
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi X
                  %mo ≔
                  %msub
                    %mi g
                    %mi X
                  %mspace{:width => "thickmathspace"}
                  %mi colon
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\phi_X \coloneqq g_X \;colon\; X \to \mathbf{B}U(1)
          %p
            then a
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Spin
                      %mi c
                  %annotation{:encoding => "application/x-tex"} Spin^c
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Φ
                    %mi X
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi w
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\phi
                  \\;\colon\;
                  \\Phi_X \to \mathbf{w}_2
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mn 2
                        %msub
                          %mi ℤ
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}^2 \mathbb{Z}_2}
          %p
            Or rather, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            as before and the
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(n)
            %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction
            of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi X
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_X : X \to \mathbf{B}GL(n)
            as before, then the
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
            for
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Spin
                      %mi c
                  %annotation{:encoding => "application/x-tex"} Spin^c
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi τ
                        %mi X
                      %mo ,
                      %msub
                        %mi g
                        %mi X
                      %mspace{:width => "thinmathspace"}
                      %mi mod
                      %mspace{:width => "thinmathspace"}
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %msub
                    %mi ℤ
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Phi_X
                  \\;\colon\;
                  X
                  \\stackrel{(\tau_X, g_X \,mod\, 2)}{\to}
                  \\mathbf{B}GL(n) \times \mathbf{B}^2 \mathbb{Z}_2
                  \\,,
          %p and the field moduli stack is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi w
                        %mn 2
                      %mo{:stretchy => "false"} )
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields} \;\colon\;
                  \\mathbf{B}SO(n)
                  \\stackrel{(p, \mathbf{w}_2)}{\to}
                  \\mathbf{B}GL(n) \times \mathbf{B}
                  \\,.
          %h5#TypeIIGravity Type II gravity, exceptional geometry
          %p
            By remark
            %a.maruku-ref{:href => "#OrthogonalStructureIsTrivialInPlainHomotopyTheory"}
            above the ordinary field of
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            on some
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction of the structure group
            from the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            to its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/maximal+compact+subgroup"} maximal compact subgroup
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
            is the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            itself.
          %p
            If one instead considers a variant of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            as a
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
            – a
            %em
              %a.existingWikiWord{:href => "/nlab/show/generalized+tangent+bundle"} generalized tangent bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi τ
                    %mi X
                    %mi gen
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
