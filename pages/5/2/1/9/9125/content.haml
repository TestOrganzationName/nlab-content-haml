                      %annotation{:encoding => "application/x-tex"} \delta_{EL} L \coloneqq \mathbf{d}L + d \Theta
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+variational+derivative"} Euler-Lagrange variational derivative
          #BasicFactsAboutVarationalCalculusOnJetBundleOfTrivialVectorBundle.num_example
            %h6#example_3 Example
            %p
              %strong
                (basic facts about
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
            %p
              Given the jet bundle of a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} variational bicomplex
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
            %ul
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"} horizontal derivative
                  of a spacetime coordinate function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi x
                          %mi μ
                      %annotation{:encoding => "application/x-tex"} x^\mu
                  coincides with its ordinary de Rham differential
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %msup
                          %mi x
                          %mi μ
                        %mo =
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                        %msup
                          %mi x
                          %mi μ
                        %mo ∈
                        %msup
                          %mi Ω
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        d x^\mu = \mathbf{d} x^\mu \in \Omega^{1,0}(E)
                %p and hence this is a horizontal 1-form.
              %li
                %p Therefore the vertical derivative of a spacetime coordinate vanishes:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                        %msup
                          %mi x
                          %mi μ
                        %mo =
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\delta x^\mu = 0
                        \\,.
              %li
                %p
                  In particular the given
                  %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                  gives a horizontal
                  = succeed "-form" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} p+1
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi dvol
                          %mi Σ
                        %mo =
                        %mi d
                        %msup
                          %mi x
                          %mn 0
                        %mo ∧
                        %mi d
                        %msup
                          %mi x
                          %mn 1
                        %mo ∧
                        %mi ⋯
                        %mo ∧
                        %mi d
                        %msup
                          %mi x
                          %mi p
                        %mo ∈
                        %msup
                          %mi Ω
                          %mrow
                            %mi p
                            %mo +
                            %mn 1
                            %mo ,
                            %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        dvol_\Sigma =  d x^0 \wedge d x^1 \wedge \cdots \wedge d x^p \in \Omega^{p+1,0}
                        \\,.
              %li
                %p
                  Generally any horizontal
                  = succeed "-form" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                            %mi ⋯
                            %msub
                              %mi μ
                              %mi k
                        %mi d
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                        %mo ∧
                        %mi ⋯
                        %mo ∧
                        %mi d
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi μ
                              %mi k
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi Ω
                          %mrow
                            %mi k
                            %mo ,
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        f_{\mu_1 \cdots \mu_k} d x^{\mu_1} \wedge \cdots \wedge d x^{\mu_k}
                        \\;\in\;
                        \\Omega^{k,0}(E)
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                            %mi ⋯
                            %msub
                              %mi μ
                              %mi k
                        %mo =
                        %msub
                          %mi f
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                            %mi ⋯
                            %msub
                              %mi μ
                              %mi k
                        %mrow
                          %mo (
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi x
                            %mi μ
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ϕ
                            %mi a
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi ϕ
                            %mrow
                              %mo ,
                              %mi μ
                            %mi a
                          %mo{:stretchy => "false"} )
                          %mo )
                      %annotation{:encoding => "application/x-tex"} f_{\mu_1 \cdots \mu_k} = f_{\mu_1 \cdots \mu_k}\left((x^\mu), (\phi^a), (\phi^a_{,\mu})\right)
                  any smooth function of the spacetime coordinates and the field coordinates.
              %li
                %p
                  The horizontal differential of the vertical differential
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                        %mi ϕ
                      %annotation{:encoding => "application/x-tex"} \delta \phi
                  of a field variable is the differential 2-form of horizontal degree 1 and vertical degree 2 given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %mi d
                                %mo{:stretchy => "false"} (
                                %mi δ
                                %msup
                                  %mi ϕ
                                  %mi a
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo =
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi δ
                                %mo{:stretchy => "false"} (
                                %mi d
                                %msub
                                  %mi ϕ
                                  %mi a
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %mo =
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} (
                                %mi δ
                                %msubsup
                                  %mi ϕ
                                  %mrow
                                    %mo ,
                                    %mi μ
                                  %mi a
                                %mo{:stretchy => "false"} )
                                %mo ∧
                                %mstyle{:mathvariant => "bold"}
                                  %mi d
                                %msup
                                  %mi x
                                  %mi μ
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        d (\delta \phi^a)
                        \&amp; =
                        \-
                        \\delta (d \phi_a)
                        \\\
                        \&amp; =
                        \- (\delta \phi^a_{,\mu}) \wedge \mathbf{d} x^\mu
                        \\end{aligned}
                        \\,.
                %p In words this says that “the spacetime derivative of the variation of the field is the variation of its spacetime derivative”.
          #LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"}> local Lagrangian density
                )
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              over a
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+1)
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              as in example
              = succeed "," do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
              (for the field species thus defined) is a
              %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+form"} horizontal differential form
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+1)
              on the corresponding
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L} \;\in \; \Omega^{p+1,0}(E)
                    \\,.
            %p
              By example
              %a.maruku-ref{:href => "#BasicFactsAboutVarationalCalculusOnJetBundleOfTrivialVectorBundle"}
              any such Lagrangian density may uniquely be written as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo =
                    %mi L
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L} = L dvol_\Sigma
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo =
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϕ
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                      %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L = L((x^\mu), (\phi^a), (\phi^a_{,\mu}), \cdots )
              a smooth function on the jet bundle.
          #EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+operator"}> Euler-Lagrange operator
                )
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %em unique
              decomposition as a sum of two terms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo =
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo −
                    %mi d
                    %mi Θ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{d} \mathbf{L}
                    \=
                    \\delta_{EL} \mathbf{L}
                    \-
                    d \Theta
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                  %annotation{:encoding => "application/x-tex"} \delta_{EL}
              is a “
              %a.existingWikiWord{:href => "/nlab/show/source+form"}> source form
              ”:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi δ
                    %msup
                      %mi Ω
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_{EL} \mathbf{L} \in \Omega^{p+1,0}(E) \wedge \delta \Omega^{0,0}(E) \; \subset \Omega^{p+1,1}(E)
                    \\,.
            %p The map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi Ω
                      %mi s
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_{EL} \;\colon\; \Omega^{p+1,0}(E) \longrightarrow \Omega^{p+1,1}_s(E)
            %p
              thus defined is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+operator"} Euler-Lagrange operator
              and is explicitly given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
