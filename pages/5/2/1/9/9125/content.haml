                  2\mathbf{sLine}_{conn} &amp;\to&amp; \Omega^3_{cl}
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  2 \mathbf{sLine} &amp;\stackrel{curv}{\to}&amp; \flat_{dR} \mathbf{B}2 \mathbf{sLine}
                  }
                  \\,.
          %p This is now the moduli 2-stack
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo ≔
                  %mn 2
