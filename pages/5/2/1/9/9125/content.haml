                        %mi X
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mi conn
                      %annotation{:encoding => "application/x-tex"} \Phi_X \;\colon\; X \to \mathbf{B}G_{conn}
                  is equivalently a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (which if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is assumed connected and simply connected and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                  is of
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  at most 3 is equivalently just a
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+form"} Lie algebra valued form
              %li
                %p
                  a field configuration is a diagram in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi X
                              %mtd
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %msup
                                      %mo ∇
                                      %mi g
                              %mtd
                              %mtd
                                %msup
                                  %mi Ω
                                  %mn 1
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo ,
                                %mi 𝔤
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} /
                                %mo{:stretchy => "false"} /
                                %mi T
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mrow
                                  %mo ∇
                                %mo ↘
                              %mtd
                                %msub
                                  %mo ⇙
                                  %mi g
                              %mtd
                                %msub
                                  %mo ↙
                                  %mpadded{:width => "0"}
                                    %mstyle{:mathvariant => "bold"}
                                      %mi Fields
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %msub
                                  %mi G
                                  %mi conn
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        X &amp;&amp;\stackrel{\nabla^g}{\to}&amp;&amp; \Omega^1(-,\mathfrak{g})//T
                        \\\
                        \&amp; {}_{\nabla}\searrow &amp;\swArrow_{g}&amp; \swarrow_{\mathrlap{\mathbf{Fields}}}
                        \\\
                        \&amp;&amp; \mathbf{B}G_{conn}
                        }
                        \\,,
                %p
                  which is equivalently a differentially refined
                  %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction of the structure group
                  of the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                  underlying
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∇
                        %annotation{:encoding => "application/x-tex"} \nabla
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∇
                      %annotation{:encoding => "application/x-tex"} \nabla
                  is given by a globally defined connection form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  then this is equivalently just a smooth
                  = succeed "-valued" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  that takes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi A
                          %mi g
                      %annotation{:encoding => "application/x-tex"} A^g
                  as indicated.
          %p
            As a slight variant of prop.
            %a.maruku-ref{:href => "#CosetIsHomotopyFiberOfDeloopedInclusion"}
            we have
          .num_prop
            %h6#proposition_14 Proposition
            %p
              We have a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi λ
                    %mo ≃
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mo →
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi T
                    %mover
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi Fields
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}_\lambda \simeq G/T \to \Omega^1(-,\mathfrak{g})//T
                    \\stackrel{\mathbf{Fields}}{\to} \mathbf{B}G_{conn}
                    \\,,
            %p
              where on the left we have the
              %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbit"} coadjoint orbit
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi λ
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle \lambda , -\rangle
          .num_remark
            %h6#remark_16 Remark
            %p
              This implies that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \nabla = 0
              is the trivial background field, than fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                  %annotation{:encoding => "application/x-tex"} \phi : X \to \mathbf{Fields}
              are equivalently maps to the coadjoint orbit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi Φ
                          %mi X
                        %mo =
                        %mn 0
                    %mo ≃
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi 𝒪
                      %mi λ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [X, \mathbf{Fields}]_{\mathbf{H}}|_{\Phi_X = 0}
                    \\simeq
                    C^\infty(X, \mathcal{O}_\lambda)
                    \\,.
            %p
              Hence in this sector we have simply a
              %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
              field as in
              %a{:href => "#SigmaModelFields"} Sigma-models
              above.
          .num_remark
            %h6#remark_17 Remark
            %p
              There is a canonical
              %a.existingWikiWord{:href => "/nlab/show/extended+Lagrangian"} extended Lagrangian
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                  %annotation{:encoding => "application/x-tex"} [X, \mathbf{Fields}]_{\mathbf{H}}
              with the above definitions, whose
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X = S^1
              is the closed connected 1-dimensional manifold, is that of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/1d+Chern-Simons+theory"} 1d Chern-Simons theory
              %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
              of the corresponding
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
              is the
              %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
              map – the “
              %a.existingWikiWord{:href => "/nlab/show/Wilson+line"}> Wilson line
              ” – on the background gauge field connection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                    %annotation{:encoding => "application/x-tex"} \nabla
          %p
            This is discussed further at
            = succeed "." do
              %a{:href => "#ActionFunctionalsForChernSimonsTypeGaugeTheories"} geometry of physics – Prequantum gauge theory and gravity
          %h4#ChernSimonsWithWilsonLines 3d Chern-Simons field with Wilson line
          %p
            We discuss the field content of 3d
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            for a simple, simply connected compact Lie group with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Wilson+loops"} Wilson loops
            = succeed "." do
              %em
                %a{:href => "#BoundaryAndDefectFields"} Bulk fields with defect fields
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mn 3
                  %mo ∈
                  %mi SmthMfd
                  %mo ↪
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \Sigma_3 \in SmthMfd \hookrightarrow \mathbf{H}
            be a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            3, and let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %msup
                    %mi Σ
                    %mn 3
                %annotation{:encoding => "application/x-tex"}
                  C_X \;\colon\; S^1 \to \Sigma^3
          %p
            be the
            %a.existingWikiWord{:href => "/nlab/show/submanifold"} embedding
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/knot"} knot
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo :
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi 𝔠
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi T
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}
                  \:
                  \\Omega^1(-,\mathfrak{c})//T \to \mathbf{B}G_{conn}
          %p
            as defined in
            %em
              %a{:href => "#NonabelianChargedParticle"} Nonabelian charged particle trajectories – Wilson lines
            above. Regarding the not inclusion as a defect in the 3-dimnensional manifold, a bulk-defect fiedl configuration according to def.
            %a.maruku-ref{:href => "#ModuliOfBulkAndBoundaryFields"}
            is a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi C
                    %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                %annotation{:encoding => "application/x-tex"}
                  \\phi
                  \\;\colon\;
                  C_X \to \mathbf{Fields}
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^{(\Delta^1)}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi S
                            %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi A
                              %msubsup
                                %mo{:stretchy => "false"} |
                                %mrow
                                  %msup
                                    %mi S
                                    %mn 1
                                %mi g
                        %mtd
                          %msup
                            %mi Ω
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} /
                          %mi T
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi C
                        %mtd
                          %msub
                            %mo ⇙
                            %mi g
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi Σ
                            %mn 3
                        %mtd
                          %mover
                            %mo →
                            %mi A
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi G
                            %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  S^1 &amp;\stackrel{A|_{S^1}^g}{\to}&amp; \Omega^1(-,\mathfrak{g})//T
                  \\\
                  \\downarrow^{\mathrlap{C}} &amp;\swArrow_{g}&amp; \downarrow
                  \\\
                  \\Sigma_3 &amp;\stackrel{A}{\to}&amp; \mathbf{B}G_{conn}
                  }
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %ol
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+form"} Lie algebra valued form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Σ
                        %mn 3
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \in \Omega^1(\Sigma_3, \mathfrak{g})
                (the bulk
                %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
                of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            %li
              %p
                a
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 1
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g \in C^\infty(S^1, G)
          %p
            which determine a background gauge field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msubsup
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mi g
                %annotation{:encoding => "application/x-tex"} A|_{S^1}^g
            on the knot.
          %p
            Moreover a
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            between two such field configurations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi ϕ
                  %mo ⇒
                  %mi ϕ
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \kappa \;\colon\; \phi \Rightarrow \phi'
            is equivalently a gauge transformaiton of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                %annotation{:encoding => "application/x-tex"} A|_{S^1}
            such that together they intertwine
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} g'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} t \colon S^1 \to T
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ′
                    %mo =
                    %mi t
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g' = t g
            %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbit"} coadjoint orbit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mi λ
                  %mo ≃
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi T
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_\lambda \simeq G/T
            as above.
          %p
            This are the field confugurations for 3d
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            (see the discussion there) with Wilson lines (
            %a{:href => "#FiorenzaSatiSchreiberCSIntroAndSurvey"}> FSS
            ).
          %h4#ChanPatonGaugeFields Chan-Paton gauge fields on D-branes: twisted differential K-cocycles
          %p
            We discuss the
            %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+fields"} Chan-Paton gauge fields
            over
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/extension+of+groups"} extension of groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi PU
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1) \to U(n) \to PU(n)
            sits in a long
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            of
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi PU
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi PU
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi dd
                        %mi n
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  U(1) \to U(n) \to PU(n) \to \mathbf{B}U(1)
                  \\to \mathbf{B}U(n) \to \mathbf{B}PU(n) \stackrel{\mathbf{dd}_n}{\to}
                  \\mathbf{B}^2 U(1)
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}
                  \\colon
                  (\mathbf{B}U(n)//\mathbf{B}U(1))_{conn}
                  \\to
                  \\mathbf{B}^2 U(1)_{conn}
          %p
            be the differential refinement of that universal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Dixmier-Douady+class"} Dixmier-Douady class
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Q
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\iota_X
                  \\;\colon\;
                  Q \hookrightarrow X
          %p
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            in an ambient
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Then a field configuration of the
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            together with a compatible rank-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            gauge field on the
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            is a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                %annotation{:encoding => "application/x-tex"}
                  \\iota_X \to \mathbf{Fields}
          %p
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}^{(\Delta^1)}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Q
                        %mtd
                          %mover
                            %mo →
                            %mrow
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} /
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %msub
                                %mi ι
                                %mi X
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ≃
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mover
                                    %mstyle{:mathvariant => "bold"}
                                      %mi dd
                                    %mo{:stretchy => "false"} ^
                                  %mi n
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mo ∇
                                %mi B
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Q &amp;\stackrel{}{\to}&amp; (\mathbf{B}U(n)//\mathbf{B}U(1))
                  \\\
                  {}^{\iota_X}\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow^{\mathrlap{\hat \mathbf{dd}_n}}
                  \\\
                  X &amp;\stackrel{\nabla_B}{\to}&amp; \mathbf{B}^2 U(1)_{conn}
                  }
          %p
            This identifies a
            %a.existingWikiWord{:href => "/nlab/show/twisted+bundle"} twisted bundle
            with connection on the D-brane whose twist is the class in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^3(X, \mathbb{Z})
            of the bulk
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
          %p
            This relation is the Kapustin-part of the
            %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly"} Freed-Witten-Kapustin anomaly
            cancellation for the
            %a.existingWikiWord{:href => "/nlab/show/bosonic+string"} bosonic string
            or else for the
            %a.existingWikiWord{:href => "/nlab/show/type+II+string"} type II string
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Spin
                    %mi c
                %annotation{:encoding => "application/x-tex"} Spin^c
            D-branes. (
            %a{:href => "#FiorenzaSatiSchreiberCSIntroAndSurvey"}> FSS
            )
          .num_remark
            %h6#remark_18 Remark
            %p
              If we regard the
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
              as a
              %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
              for the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
              %a.maruku-ref{:href => "#PullbackAlongGeneralizedLocalDiffeomorphisms"}
              determines along which maps of the B-field the Chan-Paton gauge field may be transformed.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y &amp;\stackrel{}{\to}&amp; X &amp;\stackrel{}{\to}&amp; (\mathbf{B}U(n)//\mathbf{B}U(1))_{conn}
                    \\\
                    \&amp; \searrow &amp; \downarrow &amp; \swarrow
                    \\\
                    \&amp;&amp;\mathbf{B}^2 U(1)_{conn}
                    }
                    \\,.
            %p On the local connection forms this acts as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %mi A
                    %mo +
                    %mi α
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A \mapsto A + \alpha
                    \\,.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ↦
                    %mi B
                    %mo +
                    %mi d
                    %mi α
                  %annotation{:encoding => "application/x-tex"}
                    B \mapsto B + d \alpha
            %p This is the famous gauge transformation law known from the string theory literature.
          %h4#HeteroticStringBackgroundField
            Anomaly-free heterotic string background: differential
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi String
                      %mi c
                  %annotation{:encoding => "application/x-tex"} String^c
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi Spin
                    %mi conn
                  %mover
                    %mo →
                    %mrow
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msub
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mi p
                          %mo{:stretchy => "false"} ^
                        %mn 1
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}
                  \\;\colon\;
                  \\mathbf{B}Spin_{conn}
                  \\stackrel{\tfrac{1}{2}\hat \mathbf{p}_1}{\to}
                  \\mathbf{B}^3 U(1)_{conn}
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi g
                        %mi X
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mn 8
                  %mo ×
                  %msub
                    %mi E
                    %mn 8
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mo{:stretchy => "false"} ^
                        %mn 2
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Phi_X \;\colon\; X \stackrel{g_X}{\to} \mathbf{B}(E_8 \times E_8)_{conn}
                  \\stackrel{\hat \mathbf{c}_2}{\to}
                  \\mathbf{B}^3 U(1)
          %p
            then fields are
            %a.existingWikiWord{:href => "/nlab/show/twisted+differential+string+structures"} twisted differential string structures
            or equivalently differential
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi String
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{String}^{\mathbf{c}}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \Phi_X
            %em
              %a{:href => "#HigherSpinStructures"} Higher spin structure
            above.
          %p
            As in the discussion there, we implement the constraint that the string structure is on the tangent bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} colol
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_X \;\colol\; X \to \mathbf{B}GL(n)
            of the manifold by settting
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi Spin
                    %mi conn
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msub
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mi p
                          %mo{:stretchy => "false"} ^
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}
                  \\;\colon\;
                  \\mathbf{B}Spin_{conn}
                  \\stackrel{(p,\tfrac{1}{2}\hat \mathbf{p}_1)}{\to}
                  \\mathbf{B}GL(n)_conn \mathbf{B}^3 U(1)_{conn}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mi X
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ∇
                        %mi X
                      %mo ,
                      %msub
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mo{:stretchy => "false"} ^
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo ×
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Phi_X
                  \\;\colon\;
                  X
                  \\stackrel{(\nabla_X, \hat \mathbf{c}_2(g_X))}{\to}
                  \\mathbf{B}GL(n)_{conn} \times \mathbf{B}^3 U(1)_{conn}
                  \\,.
          %p
            Then a field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Φ
                    %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                %annotation{:encoding => "application/x-tex"} \phi \;\colon\; \Phi_X \to \mathbf{Fields}
            is the higher spin-connection version as discussed in
            %em
              %a{:href => "#OrdinaryGravity"} Gravity
            above of a twisted differential string structure.
          %p
            The moduli stack of these fields is that of background fields that satisfy the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+anomaly+cancellation"} Green-Schwarz anomaly cancellation
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+supergravity"} heterotic supergravity
            = succeed ")." do
              %a{:href => "#SSS"} SSS
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/field+observable"} field observable
          %p
