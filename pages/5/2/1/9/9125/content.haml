                            %semantics
                              %mrow
                                %mn ∞
                              %annotation{:encoding => "application/x-tex"} \infty
                    %li
                      %a{:href => "#OrdinaryGravity"} Gravity
                    %li
                      %a{:href => "#SpinStructures"}
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                          %semantics
                            %mrow
                              %mi Spin
                            %annotation{:encoding => "application/x-tex"} Spin
                        \-structures
                    %li
                      %a{:href => "#SpinStructures"}
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                          %semantics
                            %mrow
                              %msup
                                %mi Spin
                                %mi c
                            %annotation{:encoding => "application/x-tex"} Spin^c
                        \-structures
                    %li
                      %a{:href => "#TypeIIGravity"} Type II gravity, exceptional geometry
                    %li
                      %a{:href => "#HigherSpinStructures"} Higher spin structures
                    %li
                      %a{:href => "#HigherSpincstructures"}
                        Higher
                        = succeed "-structures" do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %msup
                                  %mi Spin
                                  %mi c
                              %annotation{:encoding => "application/x-tex"} Spin^c
                  %li
                    %a{:href => "#GaugeFields"}
                      %strong I b)
                      Gauge fields
                  %ul
                    %li
                      %a{:href => "#GaugeFieldsGeneral"}
                        %strong General
                        – Coefficients in differential cohomology:
                        = succeed "-connections" do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mn ∞
                              %annotation{:encoding => "application/x-tex"} \infty
                    %ul
                      %li
                        %a{:href => "#contents_2"} Contents:
                    %li
                      %a{:href => "#ElectromagneticField"} Electromagnetic field
                    %li
                      %a{:href => "#YangMillsField"} Yang-Mills field
                    %li
                      %a{:href => "#KalbRamondBField"}
                        Kalb-Ramond
                        = succeed "-field" do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mi B
                              %annotation{:encoding => "application/x-tex"} B
                    %li
                      %a{:href => "#KalbRamondBField"}
                        Supergeometric
                        = succeed "-field" do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mi B
                              %annotation{:encoding => "application/x-tex"} B
                    %li
                      %a{:href => "#SupergravityCField"}
                        Supergravity
                        = succeed "-field" do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mi C
                              %annotation{:encoding => "application/x-tex"} C
                %li
                  %a{:href => "#MatterFields"}
                    %strong II)
                    Matter fields
                %ul
                  %li
                    %a{:href => "#SectionsOfAssociatedBundles"}
                      %strong General
                      – sections of associated fiber
                      = succeed "-bundles" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mn ∞
                            %annotation{:encoding => "application/x-tex"} \infty
                  %li
                    %a{:href => "#Fermions"} Fermions
                  %li
