                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat G
            is a field
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi g
                    %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mrow
                      %mi B
                      %mi p
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\phi \; \colon\; g_X \to \mathbf{B p}
                  \\,.
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+extension"} ∞-group extension
            is central in that it extends to a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mover
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Bp
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mover
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}A \to \mathbf{B}\hat G \stackrel{\mathbf{Bp}}{\to} \mathbf{B}G \stackrel{\mathbf{c}}{\to} \mathbf{B}^2 A
          %p
            then a
            %a.existingWikiWord{:href => "/nlab/show/twisted+differential+c-structure"} twisted c-structure
            is a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi g
                    %mi X
