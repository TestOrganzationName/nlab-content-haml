                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p This we interpret as a configuration consisting of
          %ol
            %li
              %p
                a bulk field configuration
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
