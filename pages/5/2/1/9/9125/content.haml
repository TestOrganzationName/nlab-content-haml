                            %mo ,
                            %mi Q
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [\iota_{\Sigma}, \iota_X]
                    \&amp;\to&amp;
                    [\Sigma, X]
                    \\\
                    \\downarrow &amp;\swArrow&amp; \downarrow
                    \\\
                    [S^1, Q]
                    \&amp;\to&amp;
                    [S^1, X]
                    }
                    \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
