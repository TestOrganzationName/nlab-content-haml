                    \\to
                    [X, Z]
            %p
              is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi X
                      %mo ⊣
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ((-)\otimes X \dashv [X,-])
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of the following composite of two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/evaluation+maps"} evaluation maps
              = succeed ":" do
                %a.maruku-ref{:href => "#EvalMap"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
