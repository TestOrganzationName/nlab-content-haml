                            %mo ,
                            %mi Z
                            %mo{:stretchy => "false"} ]
                        %mo ,
                        %msub
                          %mi eval
                          %mrow
                            %mi X
                            %mo ,
                            %mi Y
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi Y
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi eval
                          %mrow
                            %mi Y
                            %mo ,
                            %mi Z
                    %mi Z
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [Y, Z] \times [X , Y] \times X
                    \\stackrel{(id_{[Y,Z]}, eval_{X,Y})}{\to}
                    [Y,Z] \times Y
                    \\stackrel{eval_{Y,Z}}{\to}
                    Z
                    \\,.
          %h3#in_simplicial_type_theory In simplicial type theory
          %p
            We work in
            %a.existingWikiWord{:href => "/nlab/show/simplicial+type+theory"} simplicial type theory
            with a
            %a.existingWikiWord{:href => "/nlab/show/directed+interval"} directed interval
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕀
                  %annotation{:encoding => "application/x-tex"} \mathbb{I}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mn 2
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi s
                      %mo :
                      %mi 𝕀
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi t
                      %mo :
                      %mi 𝕀
                  %mi s
                  %mo ≤
                  %mi t
                %annotation{:encoding => "application/x-tex"} \Delta^2 \coloneqq \sum_{s:\mathbb{I}} \sum_{t:\mathbb{I}} s \leq t
          %p
            and let the (2,1)-
            %a.existingWikiWord{:href => "/nlab/show/horn"} horn
            type be defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Λ
                    %mn 1
                    %mn 2
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi s
                      %mo :
                      %mi 𝟚
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi t
                      %mo :
                      %mi 𝟚
                  %mo{:stretchy => "false"} (
                  %mi s
                  %msub
                    %mo =
                    %mi 𝕀
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %mo{:stretchy => "false"} (
                  %mi t
                  %msub
                    %mo =
                    %mi 𝕀
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Lambda_1^2 \coloneqq \sum_{s:\mathbb{2}} \sum_{t:\mathbb{2}} (s =_\mathbb{I} 0) \vee (t =_\mathbb{I} 1)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ∨
                  %mi Q
                %annotation{:encoding => "application/x-tex"} P \vee Q
            is the
            %a.existingWikiWord{:href => "/nlab/show/disjunction"} disjunction
            of the types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ≤
                  %mi t
                %annotation{:encoding => "application/x-tex"} s \leq t
            implies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi s
                  %msub
                    %mo =
                    %mi 𝕀
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %mo{:stretchy => "false"} (
                  %mi t
                  %msub
                    %mo =
                    %mi 𝕀
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (s =_{\mathbb{I}} 0) \vee (t =_{\mathbb{I}} 1)
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %mi 𝕀
                %annotation{:encoding => "application/x-tex"} s:\mathbb{I}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo :
                    %mi 𝕀
                  %annotation{:encoding => "application/x-tex"} t:\mathbb{I}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi t
                  %mo :
                  %mi 𝕀
                  %mo .
                  %mi t
                  %mo ,
                  %mi λ
                  %mi t
                  %mo :
                  %mi 𝕀
                  %mo .
                  %mi t
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Δ
                    %mn 2
                  %mo →
                  %msubsup
                    %mi Λ
                    %mn 1
                    %mn 2
                %annotation{:encoding => "application/x-tex"} (\lambda t:\mathbb{I}.t, \lambda t:\mathbb{I}.t, P):\Delta^2 \to \Lambda^2_1
          %p
            which is a tuple consisting of two copies of the
            %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕀
                %annotation{:encoding => "application/x-tex"} \mathbb{I}
            and a
            %a.existingWikiWord{:href => "/nlab/show/dependent+function"} dependent function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            that takes the witness that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ≤
                  %mi t
                %annotation{:encoding => "application/x-tex"} s \leq t
            to a witness that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi s
                    %msub
                      %mo =
                      %mi 𝕀
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∨
                    %mo{:stretchy => "false"} (
                    %mi t
                    %msub
                      %mo =
                      %mi 𝕀
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s =_{\mathbb{I}} 0) \vee (t =_{\mathbb{I}} 1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mi u
                  %mo .
                  %mi u
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mi t
                  %mo :
                  %mi 𝕀
                  %mo .
                  %mi t
                  %mo ,
                  %mi λ
                  %mi t
                  %mo :
                  %mi 𝕀
                  %mo .
                  %mi t
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mn 2
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Λ
                    %mn 1
                    %mn 2
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda u.u \circ (\lambda t:\mathbb{I}.t, \lambda t:\mathbb{I}.t, P):(\Delta^2 \to A) \to (\Lambda^2_1 \to A)
          %p
            for all types
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mrow
                      %mn 0
                      %mo ,
                      %mn 2
                  %mo :
                  %mi 𝕀
                  %mo →
                  %msup
                    %mi Δ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} h_{0,2}:\mathbb{I} \to \Delta^2
            be the
            %a.existingWikiWord{:href => "/nlab/show/face+map"} face map
            which represents the unique morphism from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            in the 2-simplex.
          %p
          .num_defn
            %h6 Definition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi 𝕀
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f:\mathbb{I} \to A
              is the
              %strong composite
              of a
              %a.existingWikiWord{:href => "/nlab/show/composable+pair+of+morphisms"} composable pair of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %msubsup
                      %mi Λ
                      %mn 1
                      %mn 2
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} k:\Lambda^2_1 \to A
              if one can construct a
              %a.existingWikiWord{:href => "/nlab/show/commutative+triangle"} commutative triangle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %msup
                      %mi Δ
                      %mn 2
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} h:\Delta^2 \to A
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi t
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi t
                    %mo ,
                    %mi λ
                    %mi t
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi t
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi k
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} and
                    %mspace{:width => "thickmathspace"}
                    %mi h
                    %mo ∘
                    %msub
                      %mi h
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 2
                    %mo =
                    %mi f
                  %annotation{:encoding => "application/x-tex"} h \circ (\lambda t:\mathbb{I}.t, \lambda t:\mathbb{I}.t, P) = k \; \mathrm{and} \; h \circ h_{0,2} = f
            %p
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/Segal+type"} Segal type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y:A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} z:A
            %a.existingWikiWord{:href => "/nlab/show/unique+composites"} unique composites
            by definition of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Segal+condition"} Segal condition
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            operation on
            %a.existingWikiWord{:href => "/nlab/show/hom-types"} hom-types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mi g
                  %mo ∘
                  %mi f
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda (g, f).g \circ f:\mathrm{hom}_A(y, z) \times \mathrm{hom}_A(x, y) \to \mathrm{hom}_A(x, z)
          %p
            which by the Segal condition is automatically
            %a.existingWikiWord{:href => "/nlab/show/associative"} associative
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/unital"} unital
          %h2#higher_arity Higher arity
          %p
            Strictly speaking, composition as defined above is
            %em binary
            composition. One can also define
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \geq 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n + 1
            objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                %annotation{:encoding => "application/x-tex"} x_0, \ldots, x_n
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi x
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %mo →
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i\colon x_{i-1} \to x_i
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                    %mo ∘
                    %mi …
                    %mo ∘
                    %msub
                      %mi f
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi x
                      %mn 0
                    %mo →
                    %msub
                      %mi x
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f_n \circ \dots \circ f_1\colon x_0 \to x_n
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn 1
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi x
                    %mn 0
                  %mo →
                  %msub
                    %mi x
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f_1\colon x_0\to x_1
            is simply
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            itself, and the nullary composite of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                %annotation{:encoding => "application/x-tex"} x_0
            is its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
          %p
            Conversely, a category can equivalently be defined as a
            %a.existingWikiWord{:href => "/nlab/show/quiver"} quiver
            (a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/directed+graph"} directed graph
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n\ge 0
            = succeed "," do
              %em unbiased
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %h2#categorical_semantics Categorical semantics
          %p
            In the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/formal+logic"} formal logic
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cut+rule"} cut rule
          %h2#Notation Notation
          %p
            Traditionally, the composite of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            as above is written
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} g \circ f
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mi f
                  %annotation{:encoding => "application/x-tex"} g f
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ∘
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g\circ f)(x) = g(f(x))
          %p On the other hand, reading a diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mover
                    %mo →
                    %mi f
                  %mi y
                  %mover
                    %mo →
                    %mi g
                  %mi z
                %annotation{:encoding => "application/x-tex"} x \stackrel{f}\to y \stackrel{g}\to z
          %p
            the notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi g
                %annotation{:encoding => "application/x-tex"} f g
            reads better. One way to make this anti-Leibniz convention clearer is to write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ;
                  %mi g
                %annotation{:encoding => "application/x-tex"} f ; g
            (which is based on the interpretation of programming commands as morphisms in theoretical computer science). Since this convention is motivated by the drawing of diagrams, it is also sometimes called
            = succeed "." do
              %strong diagrammatic order
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f^* g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            as pulling back along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            to the composite.
          %p
            Therefore, the notations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mi f
                %annotation{:encoding => "application/x-tex"} g f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi g
                %annotation{:encoding => "application/x-tex"} f g
            are ambiguous, while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∘
                  %mi f
                %annotation{:encoding => "application/x-tex"} g \circ f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ;
                  %mi g
                %annotation{:encoding => "application/x-tex"} f ; g
            are less so. It seems that the notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mi f
                %annotation{:encoding => "application/x-tex"} g f
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∘
                  %mi f
                %annotation{:encoding => "application/x-tex"} g\circ f
            is more common than
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi g
                %annotation{:encoding => "application/x-tex"} f g
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ;
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f ; g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi g
                %annotation{:encoding => "application/x-tex"} f g
            notation occurs in some important older papers.
          %p Although diagrammatic order has advantages and partisans, especially among category theorists and computer scientists, the “classical” order of composition is firmly entrenched in much of mathematics. Many people who agree that diagrammatic order is “better” on its own merits nevertheless believe that trying to change the established “classical” order of composition creates more confusion than it removes.
          %p
            In some older category theory papers, arrows were written pointing from right to left, so that the composition of arrows could be written in the “classical” style, while still preserving the diagrammatic intuition. Hom-sets were accordingly written
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(b,a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/source"} source
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/target"} target
            %a.existingWikiWord{:href => "/nlab/show/string+diagrams"} string diagrams
            and
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/surface+diagram"} surface diagram
