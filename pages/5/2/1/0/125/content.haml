          %h2#definition Definition
          %h3#in_a_plain_category In a plain category
          %p
            %strong Composition
            is the operation that takes
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi x
                  %mo →
                  %mi y
                %annotation{:encoding => "application/x-tex"} f\colon  x \to y
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi y
                  %mo →
                  %mi z
                %annotation{:encoding => "application/x-tex"} g\colon  y \to z
            in a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            and produces a morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo →
                    %mi z
                  %annotation{:encoding => "application/x-tex"} g \circ f\colon  x \to z
            %strong composite
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          %p
            Note that this composition is unique by the axioms of category theory. If we instead work in a weak
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+category"} higher category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            with the colimit over the diagram
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mover
                      %mo →
                      %mi f
                    %mi b
                    %mover
                      %mo →
                      %mi g
                    %mi c
                  %annotation{:encoding => "application/x-tex"} a\stackrel{f}{\to}b\stackrel{g}{\to}c
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
          %h3#in_an_enriched_category In an enriched category
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            the composition operation on a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is for each triple
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x,y,z)
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∘
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\circ_{x,y,z} : C(x,y) \otimes C(y,z) \to C(x,z)
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            This reduces to the above definition in the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                %annotation{:encoding => "application/x-tex"} V =
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∘
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                %annotation{:encoding => "application/x-tex"} \circ_{x,y,z}
            sends any two composable morphisms to their composite.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∘
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mover
                    %mo →
                    %mi f
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mover
                    %mo →
                    %mi g
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mover
                    %mo →
                    %mrow
                      %mi g
                      %mo ∘
                      %mi f
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\circ_{x,y,z} : ((x \stackrel{f}{\to} y), (y \stackrel{g}{\to} z))
                  \\;\; \mapsto \;\; (x \stackrel{g\circ f}{\to} z)
                  \\,.
          %h3#for_internal_homs For internal homs
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
