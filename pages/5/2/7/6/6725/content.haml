                  %div
                    %p
                      %a{:href => "/nlab/edit/string+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %ul
                %li
                  %a{:href => "#duality_between_mtheory_and_heterotic_string_theory"} Duality between M-theory and heterotic string theory
                %li
                  %a{:href => "#duality_between_mtheory_and_type_i_string_theory"} Duality between M-theory and type I string theory
                %li
                  %a{:href => "#duality_between_heterotic_and_type_i_string_theory"} Duality between heterotic and type I string theory
              %li
