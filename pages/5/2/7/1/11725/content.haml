            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bockstein+homomorphism"} Bockstein homomorphism
          %h2#references References
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "http://en.wikipedia.org/wiki/Exponential_sheaf_sequence"} Exponential sheaf sequence
          %p
            Discussion in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/real+analytic+geometry"} real analytic geometry
          %ul
            %li#Huisman02
              %a.existingWikiWord{:href => "/nlab/show/Johannes+Huisman"}> Johannes Huisman
              ,
              = succeed "," do
                %em The exponential sequence in real algebraic geometry and Harnack’s Inequality for proper reduced real schemes
              = succeed ")" do
                %a{:href => "http://pageperso.univ-brest.fr/~huisman/rech/publications/exphi.pdf"} pdf
          %p
            Discussion in
            %a.existingWikiWord{:href => "/nlab/show/logarithmic+geometry"} logarithmic geometry
          %ul
            %li#Brylinski94
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"}> Jean-Luc Brylinski
                ,
                = succeed "," do
                  %em Holomorphic gerbes and the Beilinson regulator
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/Brylinski94.pdf", :title => "pdf"} pdf
            %li#Ogus01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Arthur+Ogus"}> Arthur Ogus
                ,
                = succeed "," do
                  %em Lectures on logarithmic algebraic geometry
                %a{:href => "http://math.berkeley.edu/~ogus/preprints/log_book/logbook.pdf"} pdf
            %li#KatoNakayama99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kazuya+Kato"}> Kazuya Kato
                , Chikara Nakayama,
                %em
                  Log Betti cohomology, log étale cohomology, and log de Rham cohomology of log schemes over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                Kodai Math. J.
              %p
                Volume 22, Number 2 (1999), 161-186. (
