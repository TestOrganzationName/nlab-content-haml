                        %annotation{:encoding => "application/x-tex"} Set
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi FinSet
                        %annotation{:encoding => "application/x-tex"} FinSet
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            For a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %em opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            is the category obtained by formally reversing the direction of all its
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            (while retaining their original composition law).
          %p
            Categories generalize (are a
            %a.existingWikiWord{:href => "/nlab/show/horizontal+categorification"} horizontal categorification
            of)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
            %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebras"} algebras
          %h2#definition Definition
          %h3#in_category_theory In category theory
          %p
            For a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %strong opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            has the same
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi x
                  %mo →
                  %mi y
                %annotation{:encoding => "application/x-tex"} f : x \to y
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            is the same as a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi y
                  %mo →
                  %mi x
                %annotation{:encoding => "application/x-tex"} f : y \to x
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mi f
                %annotation{:encoding => "application/x-tex"} g f
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            is defined to be the composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi g
                %annotation{:encoding => "application/x-tex"} f g
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            More precisely,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi{:mathvariant => "normal"} obj
                %annotation{:encoding => "application/x-tex"} C_{\mathrm{obj}}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi{:mathvariant => "normal"} mor
                %annotation{:encoding => "application/x-tex"} C_{\mathrm{mor}}
            are, respectively, the collections of
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            and of
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            are
          %ul
            %li
              %p
                source and target:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi C
                      %mo ,
                      %msub
                        %mi t
                        %mi C
                      %mo :
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                      %mo →
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} obj
                    %annotation{:encoding => "application/x-tex"} s_C,t_C : C_{\mathrm{mor}} \to C_{\mathrm{obj}}
            %li
              %p
                identity-assignment:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mi C
                      %mo :
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} obj
                      %mo →
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                    %annotation{:encoding => "application/x-tex"} i_C : C_{\mathrm{obj}} \to C_{\mathrm{mor}}
            %li
              %p
                composition:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∘
                        %mi C
                      %mo :
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                      %msub
                        %mo ×
                        %mrow
                          %msub
                            %mi C
                            %mi{:mathvariant => "normal"} obj
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                      %mo →
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                    %annotation{:encoding => "application/x-tex"} \circ_C : C_{\mathrm{mor}} \times_{C_{\mathrm{obj}}} C_{\mathrm{mor}} \to C_{\mathrm{mor}}
          %p
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            is the category with
          %ul
            %li
              %p the same (isomorphic) collections of objects and morphisms
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mi op
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi{:mathvariant => "normal"} obj
                      %mo :
                      %mo =
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} obj
                    %annotation{:encoding => "application/x-tex"} (C^{op})_{\mathrm{obj}} := C_{\mathrm{obj}}
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mi op
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi{:mathvariant => "normal"} mor
                      %mo :
                      %mo =
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                    %annotation{:encoding => "application/x-tex"} (C^{op})_{\mathrm{mor}} := C_{\mathrm{mor}}
            %li
              %p the same identity-assigning map
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mrow
                          %msup
                            %mi C
                            %mi op
                      %mo :
                      %mo =
                      %msub
                        %mi i
                        %mi C
                    %annotation{:encoding => "application/x-tex"} i_{C^{op}} := i_C
            %li
              %p
                %em switched
                source and target maps
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mrow
                          %msup
                            %mi C
                            %mi op
                      %mo :
                      %mo =
                      %msub
                        %mi t
                        %mi C
                    %annotation{:encoding => "application/x-tex"} s_{C^{op}} := t_C
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi t
                        %mrow
                          %msup
                            %mi C
                            %mi op
                      %mo :
                      %mo =
                      %msub
                        %mi s
                        %mi C
                    %annotation{:encoding => "application/x-tex"} t_{C^{op}} := s_C
            %li
              %p
                the
                %em same
                composition operation,
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mo ∘
                        %mrow
                          %msup
                            %mi C
                            %mi op
                      %mo :
                      %mo =
                      %msub
                        %mo ∘
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \circ_{C^{op}} := \circ_{C}
                \.
              %p
                or more precisely, the composition operation of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi op
                    %annotation{:encoding => "application/x-tex"} C^{op}
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∘
                        %mrow
                          %msup
                            %mi C
                            %mi op
                      %mo :
                      %msubsup
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                        %mi op
                      %msub
                        %mrow
                        %mrow
                          %msup
                            %mi s
                            %mi op
                      %msub
                        %mo ×
                        %mrow
                          %msup
                            %mi t
                            %mi op
                      %msubsup
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                        %mi op
                      %mo =
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                      %msub
                        %mrow
                        %mi t
                      %msub
                        %mo ×
                        %mi s
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                      %mover
                        %mo →
                        %mo ≃
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                      %msub
                        %mrow
                        %mi s
                      %msub
                        %mo ×
                        %mi t
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                      %mover
                        %mo →
                        %mo ∘
                      %msub
                        %mi C
                        %mi{:mathvariant => "normal"} mor
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\circ_{C^{op}}
                      \:
                      C_{\mathrm{mor}}^{op} {}_{s^{op}}\times_{t^{op}} C_{\mathrm{mor}}^{op}
                      \=
                      C_{\mathrm{mor}} {}_{t} \times_{s} C_{\mathrm{mor}}
                      \\stackrel{\simeq}{\to}
                      C_{\mathrm{mor}} {}_{s} \times_{t} C_{\mathrm{mor}}
                      \\stackrel{\circ}{\to}
                      C_{\mathrm{mor}}
                      \\,,
              %p
                where the isomorphism in the middle is the unique one induced from the universality of the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          %p
            Notice that hence the composition law does
            %em not
            change when passing to the opposite category. Only the interpretation of in which direction the arrows point does change. So forming the opposite category is a completely formal process. Nevertheless, due to the switch of source and target, the opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            is usually far from being
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a monoidal category, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mi op
                %annotation{:encoding => "application/x-tex"} V^{op}
            is equivalent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mi V
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi co
                %annotation{:encoding => "application/x-tex"} (\Sigma V)^{co}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mi V
                %annotation{:encoding => "application/x-tex"} \Sigma V
            is the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            viewed as a one-object
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi co
                %annotation{:encoding => "application/x-tex"} {co}
            is the
            %a.existingWikiWord{:href => "/nlab/show/opposite+2-category"} opposite on 2-cells
          %h3#opposite_functors Opposite functors
          %p
            Given
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %strong opposite functor
            of a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F:C\to D
            is the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mi op
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %msup
                    %mi D
                    %mi op
                %annotation{:encoding => "application/x-tex"} F^{op}:C^{op}\to D^{op}
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi F
                    %mi obj
                    %mi op
                  %mo =
                  %msub
                    %mi F
                    %mi obj
                %annotation{:encoding => "application/x-tex"} F^{op}_{obj}=F_{obj}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mi mor
                      %mi op
                    %mo =
                    %msub
                      %mi F
                      %mi mor
                  %annotation{:encoding => "application/x-tex"} F^{op}_{mor}=F_{mor}
          %p
            In the literature,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mi op
                %annotation{:encoding => "application/x-tex"} F^{op}
            is often confused with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mi op
                  %mo →
                  %msup
                    %mi G
                    %mi op
                %annotation{:encoding => "application/x-tex"} F^{op}\to G^{op}
            (of functors
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %msup
                      %mi D
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}\to D^{op}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} G\to F
            (and not
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F\to G
          %h3#opposite_natural_transformations Opposite natural transformations
          %p
            Given
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ,
                    %mi G
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F,G:C\to D
            %strong opposite natural transformation
            of a
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %mi F
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} t:F\to G
            is the natural transformation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi t
                      %mi op
                    %mo :
                    %msup
                      %mi G
                      %mi op
                    %mo →
                    %msup
                      %mi F
                      %mi op
                  %annotation{:encoding => "application/x-tex"} t^{op}:G^{op}\to F^{op}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi obj
                  %mo →
                  %msub
                    %mi D
                    %mi mor
                %annotation{:encoding => "application/x-tex"} C_{obj}\to D_{mor}
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %p
            Again, in the literature
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi t
                    %mi op
                %annotation{:encoding => "application/x-tex"} t^{op}
            is often confused with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %h3#the_oppositization_1functor The oppositization 1-functor
          %p
            If we let
            %a.existingWikiWord{:href => "/nlab/show/Cat"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            denote the
            %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
            of
            %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict
            %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
            with
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            between them, then there is an
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi op
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Cat
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} op \colon Cat \to Cat
            sending each category to its opposite and each functor to its opposite, and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi op
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi id
                    %mi Cat
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  op^2
                  \\;=\;
                  id_{Cat}
                  \\,.
          %p
            In fact, up to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Cat
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} F \colon Cat \to Cat
            that are
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalences
            %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi Cat
                %annotation{:encoding => "application/x-tex"} id_{Cat}
            and the oppositization functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi op
                  %annotation{:encoding => "application/x-tex"} op
            %a.existingWikiWord{:href => "/nlab/show/automorphism+2-group"} automorphism 2-group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi Cat
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Aut(Cat)
            of all
            %a.existingWikiWord{:href => "/nlab/show/autoequivalences"} autoequivalences
            of the 1-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            is equivalent to the group
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            viewed as a 0-truncated
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
          %p
            To see this, note that any autoequivalence of the 1-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            fixes the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} \ast
            up to unique
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            2 is the unique minimal generator (i.e. it is a generator and no proper
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            is a generator) so it is also fixed up to isomorphism. Since every category is functorially a
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            of copies of 2, once we know whether the autoequivalence fixes or swaps the two maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 1 \to 2
            the autoequivalence is determined up to a natural isomorphism, so every such autoequivalence is naturally isomorphic to either the identity or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi op
                  %annotation{:encoding => "application/x-tex"} op
          %p
            Indeed, it naturally carries the structure of an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
            \- functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} C^{op} \to D
            naturally correspond to functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %msup
                    %mi D
                    %mi op
                %annotation{:encoding => "application/x-tex"} C \to D^{op}
            through applying the oppositization functor. Identities such as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ×
                  %mi D
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ≅
                  %msup
                    %mi C
                    %mi op
                  %mo ×
                  %msup
                    %mi D
                    %mi op
                %annotation{:encoding => "application/x-tex"} (C \times D)^{op} \cong C^{op} \times D^{op}
            then follow from general considerations of right/left adjoints preserving limits/colimits.
          %p
            For this argument and related questions touching on higher category theory see
            = succeed ";" do
              %a{:href => "#Toën05"} Toën (2005), Thm. 6.3
            = succeed ";" do
              %a{:href => "#BarwickSchommerPries11"} Barwick &amp; Schommer-Pries (2011,21), Rem. 13.16
            %a{:href => "#AraGrothGutiérrez15"} Ara, Groth &amp; Gutiérrez (2013, 15)
            (cf. also
            = succeed ")." do
              %a{:href => "#Campion15"} Campion 2015
          %h3#TheOppositization2Functor The oppositization 2-functor
          %p
            There are many advantages to treating
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            as a 2-category with natural transformations as 2-morphisms. Then the above three constructions of the opposite category, opposite functor, and opposite natural transformation combine together to give the
            %strong oppositization 2-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi op
                  %mo :
                  %msup
                    %mi Cat
                    %mi co
                  %mo →
                  %mi Cat
                  %mo ,
                %annotation{:encoding => "application/x-tex"} op: Cat^{co}\to Cat,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Cat
                    %mi co
                %annotation{:encoding => "application/x-tex"} Cat^{co}
            denotes the 2-cell dual of the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
          %h3#in_enriched_category_theory In enriched category theory
          %p
            The definition has a direct generalization to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            the
            %strong
              opposite
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            is defined to be the
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  C^{op}(c,d) := C(d,c)
          %p and composition given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi σ
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mo ∘
                        %mi C
                  %msub
                    %mi C
                    %mrow
                      %mi c
                      %mo ,
                      %mi a
                  %mo =
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^{op}(b,c)\otimes C^{op}(a,b)
                  \:=
                  C(c,b) \otimes C(b,a)
                  \\stackrel{\sigma}{\to}
                  C(b,a) \otimes C(c,b)
                  \\stackrel{\circ_C}{\to}
                  C_{c,a}
                  \=:
                  C^{op}(a,c)
                  \\,.
          %p
            The unit maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mi a
                  %mo :
                  %mi I
                  %mo →
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j_a : I \to C^{op}(a,a)
            are those of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            under the identification
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^{op}(a,a) = C(a,a)
          %p
            Note that the
            %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is used in defining composition for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is merely a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a
            %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
            there are (at least) two ways to define “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            ”, resulting in two different “opposite categories”: we can use either the braiding or the inverse braiding. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
            these two definitions coincide.
          %p
            The opposite category can be regarded as a
            %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            in the
            %a.existingWikiWord{:href => "/nlab/show/monoidal+bicategory"} monoidal bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} V Prof
            of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/profunctors"} profunctors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            up to equivalence, but only up to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalence
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+completion"} Cauchy completion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is symmetric, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} V Prof
            is also symmetric monoidal, so there is only one notion of dual object. When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is braided, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} V Prof
            is not symmetric and has two notions of dual: a left dual and a right dual. These are exactly the two different opposite categories referred to above (the “left opposite” and “right opposite”).
          %h3#in_higher_category_theory In higher category theory
          %p See
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/opposite+2-category"} opposite 2-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/opposite+%28%E2%88%9E%2C1%29-category"} opposite (∞,1)-category
          %h2#the_nerve_of_the_opposite_category The nerve of the opposite category
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(C^{op})
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            is the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            that is degreewise the same as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(C)
            %a.existingWikiWord{:href => "/nlab/show/opposite+quasi-category"} opposite quasi-category
            for more details.
          %h2#classes_of_examples Classes of examples
          %h3#OppositeGroup Opposite group
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mo ⋅
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = (S, \cdot)
            a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            (or
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⋅
                    %mi G
                  %mo :
                  %mi S
                  %mo ×
                  %mi S
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"}
                  \\cdot_G : S \times S \to S
          %p
            the
            %strong opposite group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi G
                    %mi op
                %annotation{:encoding => "application/x-tex"} G^{op}
            is the group whose underlying
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            (underlying object, underlying vector space, etc.) is the same as that of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi op
                  %mo :
                  %mo =
                  %mi S
                %annotation{:encoding => "application/x-tex"}
                  S^{op} := S
          %p
            but whose product operation is that of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            but combined with a switch of the order of the arguments:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⋅
                    %mrow
                      %msup
                        %mi G
                        %mi op
                  %mo :
                  %mi S
                  %mo ×
                  %mi S
                  %mover
                    %mo →
                    %mi σ
                  %mi S
                  %mo ×
                  %mi S
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mo ⋅
                        %mi G
                  %mi S
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdot_{G^{op}} : S \times S \stackrel{\sigma}{\to} S \times S \stackrel{\cdot_G}{\to} S
                  \\,.
          %p
            So for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ,
                  %mi h
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} g,h \in S
            two elements we have that their product in the opposite group is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %msub
                    %mo ⋅
                    %mrow
                      %msup
                        %mi G
                        %mi op
                  %mi h
                  %mo :
                  %mo =
                  %mi h
                  %msub
                    %mo ⋅
                    %mi G
                  %mi g
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  g \cdot_{G^{op}} h := h \cdot_{G} g
                  \\,.
          %p
            Now, the group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            may be thought of as the pointed one-object
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            which is the groupoid with a single object, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            as its set of morphisms, and with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⋅
                    %mi G
                %annotation{:encoding => "application/x-tex"} \cdot_G
            its composition operation.
          %p Under this identification of groups with one-object categories, passing to the opposite category corresponds precisely to passing to the opposite group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi G
                    %mi op
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\mathbf{B}G)^{op} = \mathbf{B}(G^{op})
                  \\,.
          %h3#opposite_of_the_opposite Opposite of the opposite
          %p The opposite of an opposite category is the original category:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo =
                  %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (C^{op})^{op} = C
                  \\,.
          %p
            This is also true for
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is symmetric monoidal, but not when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is merely braided. However, in the latter case we can say
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mrow
                        %mi op
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi op
                        %mn 2
                    %mo =
                    %mi C
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mrow
                        %mi op
                        %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi op
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} (C^{op1})^{op2} = C = (C^{op2})^{op1}
          %h3#coalgebraic_structures Co-algebraic structures
          %p
            Every algebraic structure in a category, for instance the notion of
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            in a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/comonoid"} comonoid
            %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            its a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
          %p
            One may express this succinctly by saying that a co-structure in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is an original structure in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
            %a.existingWikiWord{:href => "/nlab/show/comonoid"} comonoid
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
          %h3#duality_2 Duality
          %p
            Passing to the opposite category is a realization of abstract
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/duality"} duality
          %p
            This goes as far as
            %em defining
            some entities as objects in an opposite category–in particular, all generalizations of
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            which characterize
            %a.existingWikiWord{:href => "/nlab/show/space+and+quantity"} spaces
            in terms of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebra"} algebras
            %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
            is essentially to define a category of
            %em spaces
            as the opposite category of a category of algebras. Similarly, a
            %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            is opposite to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/frame"} frame
          .query
            %p Are there examples where algebras are defined as dual to spaces?
          %p
            Another example is the definition of the category of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/Lie+infinity-algebroid"} algebroids
            as that opposite to quasi-free differential graded algebras, identifying every
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/duality"} dual
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
          %h2#specific_examples Specific examples
          %h3#opposite_of__and_
            Opposite of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
          %p
            The
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Set
                    %mi op
                  %mo →
                  %mi Bool
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{P} \;\colon\; Set^{op} \to Bool
          %p
            constitutes an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            from the opposite category of
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            to that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complete+atomic+Boolean+algebras"} complete atomic Boolean algebras
            %em
              %a{:href => "Set#OppositeCategory"} Set – Properties – Opposite category and Boolean algebras
          %p
            Restricted to
            %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
            this says that the opposite of the category
            %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
            of
            %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
            is
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to the category of finite
            %a.existingWikiWord{:href => "/nlab/show/boolean+algebras"} boolean algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi FinSet
                    %mi op
                  %mo ≃
                  %mi FinBoolAlg
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  FinSet^{op} \simeq FinBoolAlg
                  \\,.
          %p
            See at
            = succeed "." do
              %em
                %a{:href => "FinSet#OppositeCategory"} FinSet – Properties – Opposite category
            %em
              %a.existingWikiWord{:href => "/nlab/show/Stone+duality"} Stone duality
            for more.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/opposite+2-category"} opposite 2-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/opposite+model+category"} opposite model category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/opposite+%28infinity%2C1%29-category"} opposite (infinity,1)-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/opposite+adjunction"} opposite adjunction
          %h2#references References
          %p The basic notion – §II.2 of:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Categories+for+the+Working+Mathematician"} Categories for the Working Mathematician
              %strong 5
              Springer (1971, second ed. 1997) &amp;lbrack;
              %a{:href => "https://link.springer.com/book/10.1007/978-1-4757-4721-8"}> doi:10.1007/978-1-4757-4721-8
              \&amp;rbrack;
          %p
            In the generality of
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            – p. 12 of:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"}> Max Kelly
                ,
                = succeed "," do
                  %em Basic Concepts of Enriched Category Theory
                = succeed "," do
                  %strong 64
              %p
                Republished as: Reprints in Theory and Applications of Categories
                %strong 10
                (2005) 1-136 &amp;lbrack;
                %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/10/tr10abs.html"}> tac:10
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/10/tr10.pdf"} pdf
          %p
            On classification of the autoequivalences of
            %a.existingWikiWord{:href => "/nlab/show/Cat"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            (and more generally of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29Cat"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} (\infty,1)Cat
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29Cat"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} (\infinity,n)Cat
            and of
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29Operad"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Operad
                    %annotation{:encoding => "application/x-tex"} (\infty,1)Operad
          %ul
            %li{:id => "Toën05"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bertrand+To%C3%ABn"}> Bertrand Toën
                ,
                = succeed "," do
                  %em Vers une axiomatisation de la théorie des catégories supérieures
                %strong 34
                3 (2005) 233-263 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math/0409598"}> arXiv:math/0409598
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://dx.doi.org/10.1007/s10977-005-4556-6"} doi:10.1007/s10977-005-4556-6
            %li#BarwickSchommerPries11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Clark+Barwick"}> Clark Barwick
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Chris+Schommer-Pries"} Chris Schommer-Pries
                = succeed "," do
                  %em On the Unicity of the Homotopy Theory of Higher Categories
                %strong 34
                (2021) 1011-1058 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/1112.0040"}> arXiv:1112.0040
                ,
                = succeed "," do
                  %a{:href => "http://prezi.com/w0ykkhh5mxak/the-uniqueness-of-the-homotopy-theory-of-higher-categories/"} slides
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1090/jams/972"} doi:10.1090/jams/972
            %li{:id => "AraGrothGutiérrez15"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dimitri+Ara"}> Dimitri Ara
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Moritz+Groth"} Moritz Groth
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Javier+J.+Guti%C3%A9rrez"} Javier J. Gutiérrez
                = succeed "," do
                  %em
                    On autoequivalences of the
                    = succeed "-category" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\infty,1)
                    = succeed "-operads" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
                %strong 281
                3 (2015) 807-848 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1312.4994"}> arXiv:1312.4994
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/s00209-015-1509-5"} doi:10.1007/s00209-015-1509-5
          %p
            and discussion for the case of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Ho%28Cat%29"} Ho(Cat)
          %ul
            %li#Campion15
              %a.existingWikiWord{:href => "/nlab/show/Tim+Campion"}> Tim Campion
              ,
              %em Does the category of categories-mod-natural-isomorphism have any nonobvious autoequivalences?
              (2015) &amp;lbrack;
              %a{:href => "https://mathoverflow.net/q/223424/381"}> MO:q/223424
              \&amp;rbrack;
        .revisedby
