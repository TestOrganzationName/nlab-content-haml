          .proof
            %h6#proof_10 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
              is a
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+operator"} Green hyperbolic differential operator
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#GreenHyperbolicKleinGordonEquation"}
              = succeed ")." do
                %a.maruku-ref{:href => "#AdvancedAndRetardedGreenFunctionsForGreenHyperbolicOperatorAreUnique"}
              %a.maruku-ref{:href => "#GreenFunctionsAreContinuous"}
              says that they are
              %a.existingWikiWord{:href => "/nlab/show/continuous+linear+functionals"} continuous linear functionals
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
              %a.existingWikiWord{:href => "/nlab/show/structures"} structures
              on
              %a.existingWikiWord{:href => "/nlab/show/spaces+of+smooth+sections"} spaces of smooth sections
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TVSStructureOnSpacesOfSmoothSections"}
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
              this just means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mo ±
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi C
                      %mrow
                        %mo ±
                        %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G_{\pm}
                    \\;\colon\;
                    C^\infty_{cp}(\mathbb{R}^{p,1})
                    \\longrightarrow
                    C^\infty_{\pm cp}(\mathbb{R}^{p,1})
            %p
              are
              %a.existingWikiWord{:href => "/nlab/show/continuous+linear+functionals"} continuous linear functionals
              in the standard sense of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              %a.existingWikiWord{:href => "/nlab/show/Schwartz+kernel+theorem"} Schwartz kernel theorem
              implies the existence of
              %a.existingWikiWord{:href => "/nlab/show/integral+kernels"} integral kernels
              being
              %a.existingWikiWord{:href => "/nlab/show/distributions+in+two+variables"} distributions in two variables
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mo ±
                    %mo ∈
                    %mi 𝒟
                    %mo{:stretchy => "false"} (
