              = succeed "," do
                %a.maruku-ref{:href => "#SingularSupportOfCausalPropagatorForKleinGordonEquationOnMinkowskiSpacetimeIsTheLightCone"}
              %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo −
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x-y
              this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
