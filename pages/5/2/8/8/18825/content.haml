                    C^\infty(\mathbb{R}^n)
                    \\hookrightarrow
                    \\mathcal{S}(\mathbb{R}^n)
                    \\,.
          #ConvolutionProductOnSchwartzSpace.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (pointwise product and
                %a.existingWikiWord{:href => "/nlab/show/convolution+product"} convolution product
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Schwartz+space"} Schwartz space
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Schwartz+space"} Schwartz space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}(\mathbb{R}^n)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SchwartzSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo ∈
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f,g \in \mathcal{S}(\mathbb{R}^n) \hookrightarrow C^\infty(\mathbb{R}^n)
            %ol
              %li
                %p pointwise product:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ⋅
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (f \cdot g)(x) \coloneqq f(x) \cdot g(x)
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/convolution+product"}> convolution product
                  \:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ⋆
                        %mi g
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %munder
                          %mo ∫
                          %mrow
                            %mi y
                            %mo ∈
                            %msup
                              %mi ℝ
                              %mi n
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo −
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mi dvol
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (f \star g)(x) \coloneqq \underset{y \in \mathbb{R}^n}{\int} f(y)\cdot g(x-y) \, dvol(y)
                        \\,.
          .proof
            %h6#proof Proof
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/product+law"} product law
