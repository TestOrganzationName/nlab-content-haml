              %a.maruku-eqref{:href => "#eq:FinalResultOfComputationOf3Plus1dCausalPropagator"} (30)
              in prop.
              %a.maruku-ref{:href => "#SingularSupportOfCausalPropagatorForKleinGordonEquationOnMinkowskiSpacetimeIsTheLightCone"}
              to be
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
