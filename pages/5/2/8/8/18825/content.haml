                      %mn 2
                  %annotation{:encoding => "application/x-tex"} q + m^2
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi δ
                        %mo{:stretchy => "false"} (
                        %mi q
                        %mo +
                        %msup
                          %mi m
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mfrac
                      %mi i
                      %msqrt
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi Δ
                          %mo{:stretchy => "false"} |
                    %mrow
                      %mo (
                      %msup
                        %mi e
                        %mrow
                          %mi i
                          %mi π
                          %mi t
                          %mo{:stretchy => "false"} /
                          %mn 2
                      %mfrac
                        %mrow
                          %msub
                            %mi K
                            %mrow
                              %mi n
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo −
                              %mn 1
                          %mrow
                            %mo (
                            %mi m
                            %msqrt
                              %mrow
                                %msup
                                  %mi q
                                  %mo *
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mi i
                                %msup
                                  %mn 0
                                  %mo +
                            %mo )
                        %mrow
                          %msup
                            %mrow
                              %mo (
                              %msqrt
                                %mrow
                                  %msup
                                    %mi q
                                    %mo *
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                  %mi i
                                  %msup
                                    %mn 0
                                    %mo +
                              %mo )
                            %mrow
                              %mi n
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo −
                              %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo −
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi e
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi i
                          %mi π
                          %mi t
                          %mo{:stretchy => "false"} /
                          %mn 2
                      %mfrac
                        %mrow
                          %msub
                            %mi K
                            %mrow
                              %mi n
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo −
                              %mn 1
                          %mrow
                            %mo (
                            %mi m
                            %msqrt
                              %mrow
                                %msup
                                  %mi q
                                  %mo *
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %msup
                                  %mn 0
                                  %mo +
                            %mo )
                        %mrow
                          %msup
                            %mrow
                              %mo (
                              %msqrt
                                %mrow
                                  %msup
                                    %mi q
                                    %mo *
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi i
