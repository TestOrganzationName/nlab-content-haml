                              %mo )
                            %mrow
                              %mi n
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo −
                              %mn 1
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{
                    \\delta(q + m^2)
                    }
                    \\;=\;
                    \- \frac{i}{\sqrt{{\vert\Delta\vert}}}
                    \\left(
                    e^{i \pi t /2 }
