            )
          #FourierTransformOfDeltaDistribution.num_defn
            %h6#example_9 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/delta-distribution"} delta-distribution
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FourierTransformOnTemperedDistributions"}
              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#DiracDeltaDistribution"}
              = succeed "," do
                %a.maruku-ref{:href => "#CompactlySupportedDistributionFourierTransform"}
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
              on 1:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mi δ
                              %mo ^
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
                              %mrow
                                %mi x
                                %mo ∈
                                %msup
                                  %mi ℝ
                                  %mi n
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %mi k
                                %mi x
                            %mspace{:width => "thinmathspace"}
                            %mi d
                            %mi x
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\widehat {\delta}(k)
                    \&amp; =
                    \\underset{x \in \mathbb{R}^n}{\int} \delta(x) e^{- i k x} \, d x
                    \\\
                    \&amp; =
                    1
                    \\end{aligned}
            %p
              This implies by the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+inversion+theorem"} Fourier inversion theorem
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#FourierInversionTheoremForDistributions"}
              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              itself has equivalently the following expression as a
              %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
