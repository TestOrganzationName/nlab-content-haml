                    %mo ⊂
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    WF(P u) \subset WF(u)
          %p
            (
            %a{:href => "differential+operator#Hoermander90"}> Hörmander 90, (8.1.11)
            )
          #WaveFrontSetOfProductOfDistributionsInsideFiberProductOfFactorWaveFrontSets.num_prop
            %h6#proposition_12 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                of
                %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
                is inside
                = succeed "-wise" do
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                %a.existingWikiWord{:href => "/nlab/show/sum"} sum
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ,
                    %mi v
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u,v \in \mathcal{D}'(X)
              be a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of
              %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              satisfying
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
              %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ⋅
                    %mi v
                  %annotation{:encoding => "application/x-tex"} u \cdot v
              exists by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#HoermanderCriterionForProductOfDistributions"}
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WaveFrontSet"}
              = succeed "-wise" do
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              of the wave front set elements of the two factors:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo ⋅
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    WF(u \cdot v)
                    \\;\subset\;
                    (WF(u) \cup (X \times \{0\}))
                    +
                    (WF(v) \cup (X \times \{0\}))
                    \\,.
          %p
            (
            %a{:href => "product+of+distributions#Hoermander90"}> Hörmander 90, theorem 8.2.10
            )
          %p More generally:
          #PartialProductOfDistributionsOfSeveralVariables.num_prop
            %h6#proposition_13 Proposition
            %p
              %strong
                (partial
                %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/distributions+of+several+variables"} distributions of several variables
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mn 1
                    %mo ∈
