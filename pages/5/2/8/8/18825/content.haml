              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier integral
              operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is of
              %em
                %a.existingWikiWord{:href => "/nlab/show/symbol+class"} symbol class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mi m
                    %mo =
                    %msubsup
                      %mi L
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 0
                      %mi m
                  %annotation{:encoding => "application/x-tex"} L^m = L^m_{1,0}
              if it is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo ∫
                    %mo ∫
                    %msup
                      %mi e
                      %mrow
                        %mi i
                        %mi k
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo −
                        %mi y
                        %mo{:stretchy => "false"} )
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi y
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi k
                  %annotation{:encoding => "application/x-tex"}
                    Q f (x)
                    \\;=\;
                    \\int \int e^{i k \cdot (x - y)} q(x,y,k) f(y) \, d y \, d k
            %p
              with symbol
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              of order
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
          %p
            (
            %a{:href => "symbol+order#Hoermander71"}> Hörmander 71, def. 1.1.1 and first sentence of section 2.1 with (1.4.1)
            )
          #PropagationOfSingularitiesTheorem.num_prop
            %h6#proposition_14 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/propagation+of+singularities+theorem"}> propagation of singularities theorem
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              be a
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DifferentialOperator"}
              %a.existingWikiWord{:href => "/nlab/show/symbol+class"} symbol class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mi m
                  %annotation{:encoding => "application/x-tex"} L^m
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymbolOrder"}
              %a.existingWikiWord{:href => "/nlab/show/principal+symbol"} principal symbol
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              that is
              %a.existingWikiWord{:href => "/nlab/show/homogeneous+function"} homogeneous
              of degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(X)
              a
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mi u
                      %mo =
                      %mi f
                    %annotation{:encoding => "application/x-tex"} Q u = f
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of the
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              by that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is contained in the set of covectors on which the
              %a.existingWikiWord{:href => "/nlab/show/principal+symbol"} principal symbol
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              vanishes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo ∖
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi q
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    WF(u) \setminus WF(f) \;\subset\; q^{-1}(0)
                    \\,.
            %p
              Moreover,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} WF(u)
              is invariant under the
              %a.existingWikiWord{:href => "/nlab/show/bicharacteristic+flow"} bicharacteristic flow
              induced by the
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              with respect to the canonical
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
              structure on the
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              (
              %a{:href => "cotangent+bundle#SymplecticStructure"}> here
              ).
          %p
            (
            %a{:href => "propagation+of+singularities+theorem#DuistermaatHoermander72"}> Duistermaat-Hörmander 72, theorem 6.1.1
            , recalled for instance as
            = succeed ")" do
              %a{:href => "propagation+of+singularities+theorem#Radzikowski96"} Radzikowski 96, theorem 4.6
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#CauchyPrincipalValues
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
          %p
            An important application of the
            %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier analysis
            of
            %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
            is the class of distributions known broadly as
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+values"} Cauchy principal values
            %a.existingWikiWord{:href => "/nlab/show/propagators"} propagators
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/free+field+theories"} free field theories
            %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
            is manifestly a
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
            (prop.
            %a.maruku-ref{:href => "#FeynmanPropagatorAsACauchyPrincipalvalue"}
            and def.
            %a.maruku-ref{:href => "#FeynmanPropagatorForDiracOperatorOnMinkowskiSpacetime"}
            below), but also the
            %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
            properties of the
            %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
            and the
            %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
            are governed by Cauchy principal values (prop.
            %a.maruku-ref{:href => "#SingularSupportOfCausalPropagatorForKleinGordonEquationOnMinkowskiSpacetimeIsTheLightCone"}
            and prop.
            %a.maruku-ref{:href => "#SingularSupportOfHadamardPropagatorForKleinGordonEquationOnMinkowskiSpacetimeIsTheLightCone"}
            below). This way the understanding of Cauchy principal values eventually allows us to determine the
            %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
            of all the propagators (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#WaveFronSetsForKGPropagatorsOnMinkowski"}
          %p
            Therefore we now collect some basic definitions and facts on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+values"} Cauchy principal values
          %p
            The
            %em Cauchy principal value
            of a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            which is
            %a.existingWikiWord{:href => "/nlab/show/integrable+function"} integrable
            on the
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            of one point is, if it exists, the
            %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
            of the
            %a.existingWikiWord{:href => "/nlab/show/integrals"} integrals
            of the function over subsets in the
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            of this point as these integration
            %a.existingWikiWord{:href => "/nlab/show/domains"} domains
            tend to that point
            %em symmetrically
            from all sides.
          %p
            One also subsumes the case that the “point” is “at infinity”, hence that the function is
            %a.existingWikiWord{:href => "/nlab/show/integrable+function"} integrable
            over every
            %a.existingWikiWord{:href => "/nlab/show/bounded+subsets"} bounded
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
            %a.existingWikiWord{:href => "/nlab/show/integrals"} integrals
            of the function over bounded domains, as their bounds tend
            %em symmetrically
            to infinity.
          %p
            The operation of sending a
            %a.existingWikiWord{:href => "/nlab/show/compactly+supported+function"} compactly supported
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            (
            %a.existingWikiWord{:href => "/nlab/show/bump+function"}> bump function
            ) to Cauchy principal value of its pointwise product with a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            that may be singular at the origin defines a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PV
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PV(f)
          #CauchyIntegralValueOfIntegralOverRealline.num_defn
            %h6#definition_12 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
                of an
                %a.existingWikiWord{:href => "/nlab/show/integral"} integral
                over the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R} \to \mathbb{R}
              be a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              on the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              such that for every
              %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              its
              %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ∖
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}\setminus (-\epsilon, \epsilon)
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/integrable+function"} integrable
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is, if it exists, the
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PV
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mi lim
                      %mrow
                        %mi ϵ
                        %mo →
                        %mn 0
                    %munder
                      %mo ∫
                      %mrow
                        %mi ℝ
                        %mo ∖
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ϵ
                        %mo ,
                        %mi ϵ
                        %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PV(f) \coloneqq \underset{\epsilon \to 0}{\lim}
                    \\underset{\mathbb{R} \setminus (-\epsilon, \epsilon)}{\int} f(x) \, d x
                    \\,.
          #CauchyPrincipalValueAsDistributionOnRealLine.num_defn
            %h6#definition_13 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
                as
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                on the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R} \to \mathbb{R}
              be a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              on the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              such that for all
              %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R})
              the Cauchy principal value of the pointwise product function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi b
                  %annotation{:encoding => "application/x-tex"} f b
              exists, in the sense of def.
              = succeed "." do
                %a.maruku-ref{:href => "#CauchyIntegralValueOfIntegralOverRealline"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PV
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi b
                    %mo ↦
                    %mi PV
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    PV(f)
                    \\;\colon\;
                    b \mapsto PV(f b)
            %p
              defines a
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PV
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PV(f) \in \mathcal{D}'(\mathbb{R})
          .num_example
            %h6#example_13 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R} \to \mathbb{R}
              be an
              %a.existingWikiWord{:href => "/nlab/show/integrable+function"} integrable function
              which is symmetric, in that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(-x) = f(x)
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}
              = succeed ")" do
                %a.maruku-ref{:href => "#CauchyIntegralValueOfIntegralOverRealline"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %mfrac
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mi x
                  %annotation{:encoding => "application/x-tex"} x \mapsto \frac{f(x)}{x}
              exists and is zero:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mrow
                        %mi ϵ
                        %mo →
                        %mn 0
                    %munder
                      %mo ∫
                      %mrow
                        %mi ℝ
                        %mo ∖
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ϵ
                        %mo ,
                        %mi ϵ
                        %mo{:stretchy => "false"} )
                    %mfrac
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mi x
                    %mi d
                    %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\epsilon \to 0}{\lim}
                    \\underset{\mathbb{R}\setminus (-\epsilon, \epsilon)}{\int}
                    \\frac{f(x)}{x} d x
                    \\; = \; 0
            %p
              This is because, by the symmetry of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and the skew-symmetry of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ↦
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x \mapsto 1/x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn ∞
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ϵ
                    %mfrac
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mi x
                    %mi d
                    %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %msubsup
                      %mo ∫
                      %mi ϵ
                      %mn ∞
                    %mfrac
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mi x
                    %mi d
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{-\infty}^{-\epsilon} \frac{f(x)}{x} d x
                    \\;=\;
                    \-
                    \\int_{\epsilon}^\infty \frac{f(x)}{x} d x
                    \\,.
          #PrincipalValueOfInverseFunctionCharacteristicEquation.num_example
            %h6#example_14 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PV
                    %mrow
                      %mo (
                      %mfrac
                        %mn 1
                        %mi x
                      %mo )
                  %annotation{:encoding => "application/x-tex"} PV\left( \frac{1}{x}\right)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CauchyPrincipalValueAsDistributionOnRealLine"}
              %a.existingWikiWord{:href => "/nlab/show/equation"} equation
            #eq:DistributionalEquationxfOfxEqualsOne.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi PV
                    %mrow
                      %mo (
                      %mfrac
                        %mn 1
                        %mi x
                      %mo )
                    %mo =
                    %mn 1
                    %mphantom
                      %mi AAA
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    x PV\left(\frac{1}{x}\right) = 1
                    \\phantom{AAA}
                    \\in \mathcal{D}'(\mathbb{R}^1)
                    \\,.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta \in \mathcal{D}'(\mathbb{R}^1)
              solves the equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mphantom
                      %mi AAA
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝕣
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    x \delta(x) = 0
                    \\phantom{AAA}
                    \\in \mathcal{D}'(\mathbb{r}^1)
            %p
              we have that more generally every
              %a.existingWikiWord{:href => "/nlab/show/linear+combination"} linear combination
              of the form
            #eq:GeneralDistributionalSolutionToxfEqualsOne.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi PV
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi c
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAA
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F(x)
                    \\coloneqq
                    PV(1/x) + c \delta(x)
                    \\phantom{AAA}
                    \\in \mathcal{D}'(\mathbb{R}^1)
            %p
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} c \in \mathbb{C}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} x F(x) =  1
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              of all these solutions is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mrow
                      %mo (
                      %mi PV
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi c
                      %mi δ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi k
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mo *
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    WF\left(
                    PV(1/x) + c \delta(x)
                    \\right)
                    \\;=\;
                    \\left\{
                    (0,k) \;\vert\; k \in \mathbb{R}^\ast \setminus \{0\}
                    \\right\}
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              The first statement is immediate from the definition: For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty_c(\mathbb{R}^1)
              any
              %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mrow
                              %mo ⟨
                              %mi x
                              %mi PV
                              %mrow
                                %mo (
                                %mfrac
                                  %mn 1
                                  %mi x
                                %mo )
                              %mo ,
                              %mi b
                              %mo ⟩
                          %mtd
                            %mo ≔
                            %munder
                              %mi lim
                              %mrow
                                %mi ϵ
                                %mo →
                                %mn 0
                            %munder
                              %mo ∫
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mn 1
                                %mo ∖
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi ϵ
                                %mo ,
                                %mi ϵ
                                %mo{:stretchy => "false"} )
                            %mfrac
                              %mi x
                              %mi x
                            %mi b
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mi d
                            %mi x
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo ∫
                            %mi b
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mi d
                            %mi x
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} ⟨
                            %mn 1
                            %mo ,
                            %mi b
                            %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\left\langle x PV\left(\frac{1}{x}\right), b \right\rangle
                    \&amp; \coloneqq
                    \\underset{\epsilon \to 0}{\lim}
                    \\underset{\mathbb{R}^1 \setminus (-\epsilon, \epsilon)}{\int}
                    \\frac{x}{x}b(x) \, d x
                    \\\
                    \&amp; =
                    \\int b(x)  d x
                    \\\
                    \&amp; =
                    \\langle 1,b\rangle
                    \\end{aligned}
            %p
              Regarding the second statement: It is clear that the wave front set is concentrated at the origin. By symmetry of the distribution around the origin, it must contain both
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} directions
          .num_prop
            %h6#proposition_15 Proposition
            %p
              In fact
              %a.maruku-eqref{:href => "#eq:GeneralDistributionalSolutionToxfEqualsOne"} (8)
              is the most general distributional solution to
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:DistributionalEquationxfOfxEqualsOne"} (7)
          %p
            This follows by the characterization of
            %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
            to a point, see there at
            %a{:href => "extension+of+distributions#SpaceOfPointExtensions"} this prop.
            (
            %a{:href => "Cauchy+principa+value#HoermanderLPDO1"}> Hörmander 90, thm. 3.2.4
            )
          #IntegrationAgainstInverseOfxWithImaginaryOffset.num_defn
            %h6#definition_14 Definition
            %p
              %strong (integration against inverse variable with imaginary offset)
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mi x
                          %mo +
                          %mi i
                          %msup
                            %mn 0
                            %mo ±
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tfrac{1}{x + i0^\pm}
                    \\;\in\;
                    \\mathcal{D}'(\mathbb{R})
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              which is the
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}'(\mathbb{R})
              of the
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
              which are given by the
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mi x
                          %mo ±
                          %mi i
                          %mi ϵ
                  %annotation{:encoding => "application/x-tex"} x \mapsto \tfrac{1}{x \pm i \epsilon}
              as the
              %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              tends to zero:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mrow
                        %mi x
                        %mo +
                        %mi i
                        %msup
                          %mn 0
                          %mo ±
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi ϵ
                            %mo ∈
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} )
                        %mrow
                          %mrow
                            %mi ϵ
                            %mo →
                            %mn 0
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mi x
                          %mo ±
                          %mi i
                          %mi ϵ
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{1}{
                    x + i 0^\pm
                    }
                    \\;\coloneqq\;
                    \\underset{ { \epsilon \in (0,\infty) } \atop { \epsilon \to 0 }  }{\lim}
                    \\tfrac{1}{x \pm i \epsilon}
            %p
              hence the distribution which sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty(\mathbb{R}^1)
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ↦
                    %munder
                      %mo ∫
                      %mi ℝ
                    %mfrac
                      %mrow
                        %mi b
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi x
                        %mo ±
                        %mi i
                        %mi ϵ
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    b \mapsto
                    \\underset{\mathbb{R}}{\int}
                    \\frac{b(x)}{x \pm i \epsilon} \, d x
                    \\,.
          #CauchyPrincipalValueEqualsIntegrationWithImaginaryOffsetPlusDelta.num_prop
            %h6#proposition_16 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
                equals integration with
                %a.existingWikiWord{:href => "/nlab/show/imaginary+number"} imaginary
                offset plus
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PV
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mi x
                      %mo )
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PV\left( \tfrac{1}{x}\right) \in \mathcal{D}'(\mathbb{R})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CauchyPrincipalValueAsDistributionOnRealLine"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi x
                  %annotation{:encoding => "application/x-tex"} 1/x
              with imaginary offset (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#IntegrationAgainstInverseOfxWithImaginaryOffset"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PV
                    %mrow
                      %mo (
                      %mfrac
                        %mn 1
                        %mi x
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mn 1
                      %mrow
                        %mi x
                        %mo +
                        %mi i
                        %msup
                          %mn 0
                          %mo ±
                    %mo ±
                    %mi i
                    %mi π
                    %mi δ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PV\left(\frac{1}{x}\right)
                    \\;=\;
                    \\frac{1}{x + i 0^\pm}
                    \\pm i \pi \delta
                    \\,.
            %p
              In particular, by prop.
              %a.maruku-ref{:href => "#PrincipalValueOfInverseFunctionCharacteristicEquation"}
              this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mi x
                          %mo +
                          %mi i
                          %msup
                            %mn 0
                            %mo ±
                  %annotation{:encoding => "application/x-tex"} \tfrac{1}{x + i 0^\pm}
              solves the distributional equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mfrac
                      %mn 1
                      %mrow
                        %mi x
                        %mo +
                        %mi i
                        %msup
                          %mn 0
                          %mo ±
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mphantom
                      %mi AA
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    x \frac{1}{x + i 0^\pm}
                    \\;=\;
                    1
                    \\phantom{AA}
                    \\in \mathcal{D}'(\mathbb{R}^1)
                    \\,.
          .proof
            %h6#proof_7 Proof
            %p Using that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mfrac
                              %mn 1
                              %mrow
                                %mi x
                                %mo ±
                                %mi i
                                %mi ϵ
                          %mtd
                            %mo =
                            %mfrac
                              %mrow
                                %mi x
                                %mo ∓
                                %mi i
                                %mi ϵ
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo +
                                %mi i
                                %mi ϵ
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo −
                                %mi i
                                %mi ϵ
                                %mo{:stretchy => "false"} )
