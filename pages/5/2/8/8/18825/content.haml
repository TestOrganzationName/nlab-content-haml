                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi μ
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi ν
                    %mo −
                    %msup
