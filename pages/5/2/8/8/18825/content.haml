                              %mi k
                              %mo{:stretchy => "false"} →
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\widehat{sgn(k_0)}
                    \&amp; \propto
                    \\left(2\widehat{\Theta(k_0)} - \widehat{1}\right) \delta(\vec k)
                    \\\
                    \&amp; \propto
                    \\left(2\tfrac{1}{i x^0 + 0^+}  - \delta(x^0)\right) \delta(\vec k)
                    \\end{aligned}
            %p
              (by example
              %a.maruku-ref{:href => "#FourierTransformOfDeltaDistribution"}
              and example
              = succeed ")" do
                %a.maruku-ref{:href => "#RelationToFourierTransformOfHeavisideDistribution"}
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WaveFrontSet"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mrow
                      %mo (
                      %mover
                        %mrow
                          %mi sgn
