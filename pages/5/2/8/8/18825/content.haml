                  %annotation{:encoding => "application/x-tex"} \Delta \in \mathcal{S}'(\mathbb{R}^{p,1})
              be any
              %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
              (def.
