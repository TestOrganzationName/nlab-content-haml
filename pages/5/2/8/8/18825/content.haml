                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi k
                    %mo ∈
                    %mi S
                    %mo{:stretchy => "false"} (
                    %msup
