              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 1,0
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %msup
                        %mi S
                        %mi m
                      %mo =
                      %msubsup
                        %mi S
                        %mrow
                          %mn 1
                          %mo ,
                          %mn 0
                        %mi m
