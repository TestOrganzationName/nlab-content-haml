                    +
                    H
            %p
              where the first term is proportional to the sum of the
              %a.existingWikiWord{:href => "/nlab/show/advanced+and+retarded+propagators"} advanced and retarded propagators
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdvancedRetardedPropagatorsForKleinGordonOnMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              according to prop.
              = succeed "." do
                %a.maruku-ref{:href => "#SkewSymmetricPartOfHadmrdPropagatorIsCausalPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
            %p
              Similarly the
              %em
                %a.existingWikiWord{:href => "/nlab/show/anti-Feynman+propagator"} anti-Feynman propagator
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mover
                        %mi F
