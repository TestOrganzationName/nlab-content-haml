                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    I_{\pm}
                    \&amp; =
                    \\int_{-\infty}^\infty
                    \\sin\left(
                    \\tfrac{m c}{\hbar}
                    \\sqrt{ {\vert x-y\vert}^2_\eta }
                    \\left(
