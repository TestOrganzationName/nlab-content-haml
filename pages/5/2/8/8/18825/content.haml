                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_S(x,y)
                    \\;=\;
                    i (2\pi)^{-p} \int \delta\left( k_\mu k^\mu + \left( \tfrac{m c}{\hbar}\right)^2 \right) sgn( k_0 ) e^{ i k_\mu (x-y)^\mu } d^{p+1} k
                    \\,,
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/integrand"} integrand
              is the product of the
              %a.existingWikiWord{:href => "/nlab/show/sign+function"} sign function
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
