                    \\;=\;
                    \\left\{
                    x \in \mathbb{R}^{p,1}
                    \\,\vert\,
                    {\vert x\vert}^2_\eta = 0
                    \\right\}
                    \\,.
          .proof
            %h6#proof_22 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#CausalPropagatorAsFourierTransformOfDeltaDistributionOnTransformedKGOperator"}
              the causal propagator is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              of the
              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              of the
              %a.existingWikiWord{:href => "/nlab/show/mass+shell"} mass shell
              times the
              %a.existingWikiWord{:href => "/nlab/show/sign+function"} sign function
              of the
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/angular+frequency"} angular frequency
              = succeed ")" do
                %a.maruku-ref{:href => "#BasicPropertiesOfFourierTransformOverCartesianSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/convolution+of+distributions"} convolution of distributions
              of the separate Fourier transforms:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Δ
                              %mi S
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ∝
                            %mover
                              %mrow
                                %mi δ
                                %mrow
                                  %mo (
                                  %msup
                                    %mi η
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                                  %mo{:stretchy => "false"} (
                                  %mi k
                                  %mo ,
                                  %mi k
                                  %mo{:stretchy => "false"} )
                                  %mo +
                                  %msup
                                    %mrow
                                      %mo (
                                      %mstyle{:displaystyle => "false"}
                                        %mfrac
                                          %mrow
                                            %mi m
                                            %mi c
                                          %mi ℏ
                                      %mo )
                                    %mn 2
                                  %mo )
                                %mi sgn
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi k
                                  %mn 0
                                %mo{:stretchy => "false"} )
                              %mo ^
                        %mtr
                          %mtd
                          %mtd
                            %mo ∝
                            %mover
                              %mrow
                                %mi δ
                                %mrow
                                  %mo (
                                  %msup
                                    %mi η
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                                  %mo{:stretchy => "false"} (
                                  %mi k
                                  %mo ,
                                  %mi k
                                  %mo{:stretchy => "false"} )
                                  %mo +
                                  %msup
                                    %mrow
                                      %mo (
                                      %mstyle{:displaystyle => "false"}
                                        %mfrac
                                          %mrow
                                            %mi m
                                            %mi c
                                          %mi ℏ
                                      %mo )
                                    %mn 2
                                  %mo )
                              %mo ^
                            %mo ⋆
                            %mover
                              %mrow
                                %mi sgn
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi k
                                  %mn 0
                                %mo{:stretchy => "false"} )
                              %mo ^
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Delta_S(x)
                    \&amp; \propto
                    \\widehat{
                    \\delta\left( \eta^{-1}(k,k) + \left( \tfrac{m c}{\hbar}\right)^2 \right) sgn( k_0 )
                    }
                    \\\
                    \&amp;\propto
                    \\widehat{\delta\left( \eta^{-1}(k,k) + \left( \tfrac{m c}{\hbar}\right)^2 \right)}
                    \\star
                    \\widehat{sgn( k_0 )}
                    \\end{aligned}
            %p
              By prop.
              = succeed "," do
                %a.maruku-ref{:href => "#FourierTransformOfDeltaDistributionappliedToMassShell"}
              %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
              of the first convolution factor is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/light+cone"} light cone
            %p The second factor is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
