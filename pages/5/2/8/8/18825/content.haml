              denotes the
              %a.existingWikiWord{:href => "/nlab/show/dispersion+relation"} dispersion relation
              %a.maruku-eqref{:href => "#eq:DispersionRelationForKleinGordonooeratorObMinkowskiSpacetime"} (9)
              of the
              = succeed "." do
