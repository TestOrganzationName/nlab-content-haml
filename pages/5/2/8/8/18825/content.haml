                        %mi α
                        %mo ,
                        %mi β
                        %mo ,
                        %mi K
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} C_{\alpha, \beta,K } \in \mathbb{R}
              such that the
              %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
              of the
              %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
