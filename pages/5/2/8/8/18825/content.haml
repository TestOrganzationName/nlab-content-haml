                    \\,.
          .proof
            %h6#proof_5 Proof
            %p
              First of all the
              %a.existingWikiWord{:href => "/nlab/show/singular+support+of+a+distribution"} singular support
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SingularSupportOfADistribution"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \delta_0
              is clearly
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi supp
                        %mi sing
                      %mo{:stretchy => "false"} (
                      %mi δ
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} supp_{sing}(\delta(0)) = \{0\}
              %a.maruku-ref{:href => "#WaveFrontSetIsBundleOverSingularSupport"}
              the wave front set vanishes over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \setminus \{0\}
            %p
              At the origin, any bump function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              supported around the origin with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} b(0) = 1
              satisfies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ⋅
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \cdot \delta(0) = \delta(0)
              and hence the wave front set over the origin is the set of covectors along which the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi δ
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat \delta(0)
              does not suitably decay. But this Fourier transform is in fact a
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#FourierTransformOfDeltaDistribution"}
          #WaveFrontSetOfHeavisideDistribution.num_example
            %h6#example_12 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/step+function"} step function
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Θ
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Theta \in \mathcal{D}'(\mathbb{R}^1)
              be the
              %a.existingWikiWord{:href => "/nlab/show/Heaviside+step+function"} Heaviside step function
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Θ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msubsup
                      %mo ∫
                      %mn 0
                      %mn ∞
                    %mi b
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Theta(b) \coloneqq \int_0^\infty b(x)\, d x
                    \\,.
            %p
              Its
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WaveFrontSet"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mi k
                    %mo ≠
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    WF(H) = \{(0,k) \vert k \neq 0\}
                    \\,.
          #WaveFrontSetOfCompactlySupportedDistributions.num_prop
            %h6#proposition_9 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                of
                %a.existingWikiWord{:href => "/nlab/show/convolution+of+distributions"} convolution of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distributions"} compactly supported distributions
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ,
                    %mi v
                    %mo ∈
                    %mi ℰ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u,v \in \mathcal{E}'(\mathbb{R}^n)
              be two
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distributions"} compactly supported distributions
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WaveFrontSet"}
              %a.existingWikiWord{:href => "/nlab/show/convolution+of+distributions"} convolution of distributions
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ConvolutionOfADistributionWithACompactlySupportedDistribution"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo ⋆
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi WF
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mtext and
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi WF
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    WF(u \star v)
                    \\;=\;
                    \\left\{
                    (x + y, k)
                    \\;\vert\;
                    (x,k) \in WF(u) \,\text{and}\, (y,k) \in WF(u)
                    \\right\}
                    \\,.
          %p
            (
            %a{:href => "convolution+product+of+distributions#Bengel77"}> Bengel 77, prop. 3.1
            )
          #HoermanderCriterionForProductOfDistributions.num_prop
            %h6#proposition_10 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
                for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ,
                    %mi v
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u, v \in \mathcal{D}'(\mathbb{R}^n)
              be two
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
              (def
              = succeed ")" do
                %a.maruku-ref{:href => "#WaveFrontSet"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %msubsup
                      %mi T
                      %mi x
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} v \in T^\ast_x X
              a
              %a.existingWikiWord{:href => "/nlab/show/covector"} covector
              contained in one of the two wave front sets then the covector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi v
                    %mo ∈
                    %msubsup
                      %mi T
                      %mi x
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} -v \in T^\ast_x X
              with the opposite
              %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} direction
              in
              %em not
              contained in the other wave front set, i.e. the
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              inside the
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T^\ast X
              of the pointwise
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              of wave fronts with the
              %a.existingWikiWord{:href => "/nlab/show/zero+section"} zero section
              is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi WF
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi u
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi WF
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi u
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo )
                    %munder
                      %mo ×
                      %mrow
                        %msup
                          %mi T
                          %mo *
                        %mi X
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"}
                    \\left( WF(u_1) + WF(u_2) \right) \underset{T^\ast X}{\times} X
                    \\;=\;
                    \\emptyset
            %p i.e.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ∅
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi WF
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi u
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi WF
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi u
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi T
                              %mo *
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \emptyset
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    WF(u_1) + WF(u_2) &amp;&amp; (pb) &amp;&amp; X
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{0}}
                    \\\
                    \&amp;&amp; T^\ast X
                    }
            %p
              then the
              %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ⋅
                    %mi v
                  %annotation{:encoding => "application/x-tex"} u \cdot v
              exists, given, locally, by the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+inversion+theorem"} Fourier inversion
              of the
              %a.existingWikiWord{:href => "/nlab/show/convolution+product"} convolution product
              of their
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              (remark
              = succeed ")." do
                %a.maruku-ref{:href => "#ProductOfDistributionsViaFourierTransformOfConvolution"}
          %p
            For making use of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
          #RetainsOrShrinksWaveFrontSetDifferentialOperator.num_prop
            %h6#proposition_11 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
                preserves or shrinks
                = succeed ")" do
