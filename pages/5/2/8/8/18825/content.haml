            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi P
                        %mi Δ
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi k
                        %mi μ
                      %msub
                        %mi k
                        %mi ν
                      %mo −
                      %msup
                        %mrow
                          %mo (
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mrow
                                %mi m
                                %mi c
                              %mi ℏ
                          %mo )
                        %mn 2
                      %mo )
                    %mover
                      %mo{:stretchy => "false"} (
                      %mo ^
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat {P \Delta}(k)
                    \\;=\;
