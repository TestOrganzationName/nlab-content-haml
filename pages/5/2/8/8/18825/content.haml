                                %mi i
                                %mi k
                                %mo ⋅
                                %mo{:stretchy => "false"} (
                                %mi y
                                %mo −
                                %mi x
                                %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mfrac
                              %mrow
                                %msup
                                  %mi d
                                  %mi n
                                %mi k
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn 2
                                %mi π
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi n
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi d
                              %mi n
                            %mi y
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
                              %mrow
                                %mi k
                                %mo ∈
                                %msup
                                  %mi ℝ
                                  %mi n
