              by the dual
              %a.existingWikiWord{:href => "/nlab/show/rapidity"} rapidity
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                    %annotation{:encoding => "application/x-tex"} z
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mo (
                        %mi cosh
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mn 2
                    %mo −
                    %msup
                      %mrow
                        %mo (
                        %mi sinh
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mn 2
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\left(\cosh(z)\right)^2 - \left( \sinh(z)\right)^2 = 1
            %p as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi κ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mi m
                            %mi c
                          %mi ℏ
                      %mo )
                    %mi cosh
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AA
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AA
                    %mi κ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mi m
                            %mi c
                          %mi ℏ
                      %mo )
                    %mi sinh
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\omega(\kappa)/c
                    \\;=\;
                    \\left(
                    \\tfrac{m c}{\hbar}
                    \\right)
                    \\cosh(z)
                    \\phantom{AA}
                    \\,,
                    \\phantom{AA}
                    \\kappa
                    \\;=\;
                    \\left(
                    \\tfrac{m c}{\hbar}
                    \\right)
                    \\sinh(z)
                    \\,,
            %p
              which makes use of the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi κ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega(\kappa)
              is non-negative, by construction. This
              %a.existingWikiWord{:href => "/nlab/show/change+of+integration+variables"} change of integration variables
              makes the integrals under the braces above become
            #eq:TheTwoSpecialFunctionIntegralsInTheComputationOfTheCausalPropagatorIn3Plus1DOnMinkowski.maruku-equation
              %span.maruku-eq-number (28)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mo ±
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mo ∫
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn ∞
                      %mn ∞
                    %mi sin
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mi m
                            %mi c
                          %mi ℏ
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi x
                          %mn 0
                        %mo −
                        %msup
                          %mi y
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mi cosh
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo ±
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} →
                          %mo −
                          %mover
                            %mi y
                            %mo{:stretchy => "false"} →
                          %mo{:stretchy => "false"} |
                        %mi sinh
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
