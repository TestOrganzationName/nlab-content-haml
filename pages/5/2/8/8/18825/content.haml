                            %mi Δ
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi r
                              %mo ^
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Δ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi P
                              %mo *
                            %mover
                              %mi r
                              %mo ^
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Δ
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mover
                              %mi r
                              %mo ^
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Δ
                            %mrow
                              %mo (
                              %mrow
                                %mo (
