              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} m \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
