                    \\begin{aligned}
                    I_\pm
                    \&amp; =
                    \\int_{-\infty}^\infty
                    \\cos\left(
                    \\tfrac{m c}{\hbar}
                    \\sqrt{ {\vert x-y\vert}^2_\eta }
                    \\left(
                    \\cosh\left( z \right)
                    \\right)
                    \\right)
