                                  %mo{:stretchy => "false"} )
                                  %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\delta(x)
                    \&amp; =
                    \\widecheck{\widehat {\delta_0}}(x)
                    \\\
                    \&amp; =
                    \\underset{k \in \mathbb{R}^n}{\int} e^{i k \cdot x} \, \frac{d^n k}{ (2\pi)^n }
                    \\end{aligned}
            %p
              in the sense that for every
              %a.existingWikiWord{:href => "/nlab/show/function+with+rapidly+decreasing+partial+derivatives"} function with rapidly decreasing partial derivatives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msup
