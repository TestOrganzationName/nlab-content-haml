                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Delta_H(x,y)
                    \&amp; =
                    \\tfrac{i}{2}
                    \\underset{= \Delta_S(x,y)}{
                    \\underbrace{
                    \\frac{-1}{(2\pi)^p}
                    \\int
                    \\frac{1}{\omega(\vec k)/c}
