                  %annotation{:encoding => "application/x-tex"} f \in \mathcal{S}(\mathbb{R}^n)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SchwartzSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
                              %mrow
                                %mi y
                                %mo ∈
                                %msup
                                  %mi ℝ
                                  %mi n
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo −
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi d
                              %mi n
                            %mi y
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
