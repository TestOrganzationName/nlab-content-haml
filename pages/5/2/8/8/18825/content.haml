                into the
                %a.existingWikiWord{:href => "/nlab/show/upper+half+plane"} upper half plane
                as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
