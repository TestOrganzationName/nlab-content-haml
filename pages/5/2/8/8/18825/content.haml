                      %mi ν
                    %annotation{:encoding => "application/x-tex"} \nu
            %p
              Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi ν
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
