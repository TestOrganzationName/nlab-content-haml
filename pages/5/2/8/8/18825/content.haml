                    %msub
                      %mi Δ
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \Delta_F
              and anti-Feynman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mover
                        %mi F
                        %mo ¯
                  %annotation{:encoding => "application/x-tex"} \Delta_{\overline{F}}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FeynmanPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
