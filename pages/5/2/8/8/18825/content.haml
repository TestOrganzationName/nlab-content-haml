                    %mi z
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    I_\pm
                    \\;=\;
                    \\int_{-\infty}^\infty
                    \\sin\left(
                    \\tfrac{m c}{\hbar}
                    \\left(
                    (x^0 - y^0) \cosh(z)
                    \\pm
                    {\vert \vec x - \vec y\vert}
                    \\sinh(z)
                    \\right)
                    \\right)
                    \\, d z
                    \\,.
            %p
              Next we similarly parameterize the vector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo −
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x-y
              by its
              %a.existingWikiWord{:href => "/nlab/show/rapidity"} rapidity
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo −
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x-y
              is spacelike or not, and if not, whether it is future or past directed.
            %p
              First, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo −
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x-y
              is
              %a.existingWikiWord{:href => "/nlab/show/spacelike"} spacelike
              in that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi x
                        %mo −
                        %mi y
                        %mo{:stretchy => "false"} |
                      %mi η
                      %mn 2
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} {\vert x-y\vert}^2_\eta \gt 0
              then we may parameterize as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mn 0
                    %mo −
                    %msup
                      %mi y
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msqrt
                      %mrow
                        %msubsup
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi x
                            %mo −
                            %mi y
                            %mo{:stretchy => "false"} |
                          %mi η
                          %mn 2
                    %mi sinh
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AA
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AA
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo −
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} |
                    %mo =
                    %msqrt
                      %mrow
                        %msubsup
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi x
                            %mo −
                            %mi y
                            %mo{:stretchy => "false"} |
                          %mi η
                          %mn 2
                    %mi cosh
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (x^0 - y^0)
                    \=
                    \\sqrt{{\vert x-y\vert}^2_\eta} \sinh(\tau)
                    \\phantom{AA}
                    \\,,
                    \\phantom{AA}
                    {\vert \vec x - \vec y\vert}
                    \=
                    \\sqrt{ {\vert x-y\vert}^2_\eta} \cosh(\tau)
            %p which yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
