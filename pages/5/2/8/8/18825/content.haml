            %p
              given by
              %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
              at the origin. Its
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WaveFrontSet"}
              %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} directions
              at the origin:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
