                                      %mi y
                                  %mspace{:width => "thinmathspace"}
                                  %msup
                                    %mi d
                                    %mi n
                                  %mi y
                                %mo ⏟
                              %mrow
                                %mo =
                                %mover
                                  %mi f
                                  %mo ^
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi k
                                %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mspace{:width => "thinmathspace"}
                            %mfrac
                              %mrow
                                %msup
                                  %mi d
                                  %mi n
                                %mi k
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn 2
                                %mi π
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %munder
                              %mo ∫
                              %mrow
                                %mi k
                                %mo ∈
                                %msup
                                  %mi ℝ
                                  %mi n
                            %msup
                              %mi e
                              %mrow
                                %mi i
                                %mi k
