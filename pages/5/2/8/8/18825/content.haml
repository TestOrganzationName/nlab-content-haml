          #FourierTransformOfPrincipalValueOfPowerOfQuadraticForm.num_prop
            %h6#proposition_17 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
                of principal value of power of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} m \in \mathbb{R}
              be any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo ∈
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \kappa \in \mathbb{C}
              any
              %a.existingWikiWord{:href => "/nlab/show/complex"} complex
              number. Then the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo +
                    %msup
                      %mi m
                      %mn 2
                    %mo +
                    %mi i
                    %msup
                      %mn 0
                      %mo +
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi κ
                  %annotation{:encoding => "application/x-tex"} 1/(q + m^2 + i 0^+)^\kappa
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo (
                        %mfrac
                          %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi q
                            %mo +
                            %msup
                              %mi m
                              %mn 2
                            %mo +
                            %mi i
                            %msup
                              %mn 0
                              %mo +
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi κ
                        %mo )
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %msup
                          %mn 2
                          %mrow
                            %mn 1
                            %mo −
                            %mi κ
                        %mo{:stretchy => "false"} (
                        %msqrt
                          %mrow
                            %mn 2
                            %mi π
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi n
                        %msup
                          %mi m
                          %mrow
                            %mi n
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo −
                            %mi κ
                      %mrow
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi κ
                        %mo{:stretchy => "false"} )
                        %msqrt
                          %mi Δ
                    %mfrac
                      %mrow
                        %msub
                          %mi K
                          %mrow
                            %mi n
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo −
                            %mi κ
                        %mrow
                          %mo (
                          %mi m
                          %msqrt
                            %mrow
                              %msup
                                %mi q
                                %mo *
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi i
                              %msup
                                %mn 0
                                %mo +
                          %mo )
                      %mrow
                        %msup
                          %mrow
                            %mo (
                            %msqrt
                              %mrow
                                %msup
                                  %mi q
                                  %mo *
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %msup
                                  %mn 0
                                  %mo +
                            %mo )
                          %mrow
                            %mi n
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo −
                            %mi κ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat
                    {
                    \\left(
                    \\frac{1}{(q + m^2 + i0^+)^\kappa}
                    \\right)
                    }
                    \\;=\;
                    \\frac{
                    2^{1- \kappa} (\sqrt{2\pi})^{n} m^{n/2-\kappa}
                    }
                    {
                    \\Gamma(\kappa) \sqrt{\Delta}
                    }
                    \\frac{
                    K_{n/2 - \kappa}\left( m \sqrt{q^\ast - i 0^+} \right)
                    }
                    {
                    \\left(\sqrt{q^\ast - i0^+ }\right)^{n/2 - \kappa}
                    }
                    \\,,
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \Gamma
                  deotes the
                  %a.existingWikiWord{:href => "/nlab/show/Gamma+function"} Gamma function
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi K
                          %mi ν
                      %annotation{:encoding => "application/x-tex"} K_{\nu}
                  denotes the
                  %a.existingWikiWord{:href => "/nlab/show/modified+Bessel+function"} modified Bessel function
                  of order
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ν
                        %annotation{:encoding => "application/x-tex"} \nu
            %p
              Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi ν
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_\nu(a)
              diverges for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \to 0
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ν
                  %annotation{:encoding => "application/x-tex"} a^{-\nu}
              (
              %a{:href => "http://dlmf.nist.gov/10.30#E2"}> DLMF 10.30.2
              ).
          %p
            (
            %a{:href => "Cauchy+principal+value#GelfandShilov66"}> Gel’fand-Shilov 66, III 2.8 (8) and (9), p 289
            )
          #FourierTransformOfDeltaDistributionappliedToMassShell.num_prop
            %h6#proposition_18 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
                of
