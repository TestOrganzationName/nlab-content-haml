                          %mrow
                            %mi x
                            %mo ∈
                            %msup
                              %mi ℝ
                              %mi n
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mover
                          %mi g
                          %mo ^
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi d
                          %mi n
                        %mi x
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{k \in \mathbb{R}^n}{\int} \widehat{f}(k) \cdot g(k) \, d^n k
                        \\;=\;
                        \\underset{x \in \mathbb{R}^n}{\int} f(x) \cdot \widehat{g}(x) \, d^n x
          %p
            (e.g
            = succeed ")" do
              %a{:href => "Fourier+transform#Hoermander90"} Hörmander 90, lemma 7.1.3, theorem 7.1.6
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Schwartz+space"} Schwartz space
            of
            %a.existingWikiWord{:href => "/nlab/show/functions+with+rapidly+decreasing+partial+derivatives"} functions with rapidly decreasing partial derivatives
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#SchwartzSpace"}
            %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#FourierTransformSmoothFunctionsWithRapidlyDecayingDerivativesOnCartesianSpace"}
            = succeed ")," do
              %a.maruku-ref{:href => "#FourierInversion"}
            %em
              %a.existingWikiWord{:href => "/nlab/show/generalized+functions"} generalized functions
            in the sense of
            %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
            (via
            = succeed ")." do
              %a{:href => "non-singular+distribution#NonSingularDistributionsAreDenseInAllDistributions"} this prop.
            %a.existingWikiWord{:href => "/nlab/show/Schwartz+space"} Schwartz space
            in hand, this generalization is readily obtained by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formal duality
          #TemperedDistribution.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"}> tempered distribution
                )
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+linear+functional"} continuous linear functional
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    u \;\colon\; \mathcal{S}(\mathbb{R}^n) \longrightarrow \mathbb{C}
            %p
              on the
              %a.existingWikiWord{:href => "/nlab/show/Schwartz+space"} Schwartz space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SchwartzSpace"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functions+with+rapidly+decaying+partial+derivatives"} functions with rapidly decaying partial derivatives
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              of all tempered distributions is canonically a
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
              as the
              %a.existingWikiWord{:href => "/nlab/show/dual+space"} dual space
              to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Schwartz+space"} Schwartz space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mrow
                        %mo (
                        %mi 𝒮
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}'(\mathbb{R}^n)
                    \\;\coloneqq\;
                    \\left(
                    \\mathcal{S}(\mathbb{R}^n)
                    \\right)^\ast
                    \\,.
          %p
            e.g. (
            %a{:href => "Fourier+transform#Hoermander90"}> Hörmander 90, def. 7.1.7
            )
          #SomeNonSingularTemperedDistributions.num_example
            %h6#example_2 Example
            %p
              %strong
                (some
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/tempered+distributions"} tempered distributions
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/function+with+rapidly+decreasing+partial+derivatives"} function with rapidly decreasing partial derivatives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in \mathcal{S}(\mathbb{R}^n)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SchwartzSpace"}
              %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi f
                    %mo ∈
                    %mi 𝒮
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u_f \in \mathcal{S}'(\mathbb{R}^n)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TemperedDistribution"}
              %a.existingWikiWord{:href => "/nlab/show/integration"} integrating
              against it:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo ↦
                    %munder
                      %mo ∫
                      %mrow
                        %mi x
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mi n
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi d
                      %mi n
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    u_f \;\colon\; g \mapsto \underset{x \in \mathbb{R}^n}{\int} g(x) f(x)\, d^n x
                    \\,.
            %p This construction is a linear inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mtext dense
                    %mi 𝒮
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}(\mathbb{R}^n) \overset{\text{dense}}{\hookrightarrow} \mathcal{S}'(\mathbb{R}^n)
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/Schwartz+space"} Schwartz space
              into its
              %a.existingWikiWord{:href => "/nlab/show/dual+space"} dual space
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/tempered+distributions"} tempered distributions
              %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense subspace
              inclusion.
            %p
              In fact already the restriction of this inclusion to the
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+function"} compactly supported
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactlySupportedSmoothFunctionsAreFunctionsWithRapidlyDecreasingDerivatives"}
              %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense subspace
              inclusion:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mi dense
                    %mi 𝒮
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C^\infty_{cp}(\mathbb{R}^n)
                    \\overset{dense}{\hookrightarrow}
                    \\mathcal{S}'(\mathbb{R}^n)
                    \\,.
            %p
              This means that every
              %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
              is a
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              of a
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              of ordinary
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functions+with+rapidly+decreasing+partial+derivatives"} functions with rapidly decreasing partial derivatives
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              of a
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+function"} compactly supported
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              (
              %a.existingWikiWord{:href => "/nlab/show/bump+functions"}> bump functions
              ).
            %p
              It is in this sense that
              %a.existingWikiWord{:href => "/nlab/show/tempered+distributions"} tempered distributions
              are “generalized functions”.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "Fourier+transform#Hoermander90"} Hörmander 90, lemma 7.1.8
          #CompactlySupportedDistibutionsAreTemperedDistributions.num_example
            %h6#example_3 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distributions"} compactly supported distributions
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/tempered+distributions"} tempered distributions
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
              is a
              %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TemperedDistribution"}
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              %a.existingWikiWord{:href => "/nlab/show/injection"} inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi 𝒮
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}'(\mathbb{R}^n)
                    \\hookrightarrow
                    \\mathcal{S}'(\mathbb{R}^n)
                    \\,.
          #DiracDeltaDistribution.num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/delta+distribution"}> delta distribution
                )
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi ℰ
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_0(-) \;\in\; \mathcal{E}'(\mathbb{R}^n)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              given by point evaluation of functions at the origin of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo ↦
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_0(-) \;\colon\; f \mapsto f(0)
                    \\,.
            %p
              This is clearly a
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
              %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
              by example
              = succeed "." do
                %a.maruku-ref{:href => "#CompactlySupportedDistibutionsAreTemperedDistributions"}
            %p
              We write just “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta(-)
              ” (without the subscript) for the corresponding
              %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#SomeNonSingularTemperedDistributions"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∫
                      %mrow
                        %mi x
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mi n
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi d
                      %mi n
                    %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{x \in \mathbb{R}^n}{\int} \delta(x) f(x) \, d^n x
                    \\;\coloneqq\;
                    f(0)
                    \\,.
          #SquareIntegrableFunctionsInduceTemperedDistributions.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/square+integrable+functions"} square integrable functions
                induce
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/tempered+distributions"} tempered distributions
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi L
                      %mi p
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in L^p(\mathbb{R}^n)
              be a function in the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lebesgue+space"} Lebesgue space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} p = 2
              this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/square+integrable+function"} square integrable function
              %a.existingWikiWord{:href => "/nlab/show/integration"} integration
              against the
              %a.existingWikiWord{:href => "/nlab/show/measure"} measure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi dvol
                  %annotation{:encoding => "application/x-tex"} f dvol
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ↦
                    %munder
                      %mo ∫
                      %mrow
                        %mi x
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mi n
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi d
                      %mi n
                    %mi x
                  %annotation{:encoding => "application/x-tex"}
                    g \mapsto \underset{x \in \mathbb{R}^n}{\int} g(x) f(x) \, d^n x
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TemperedDistribution"}
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "Fourier+transform#Hoermander90"} Hörmander 90, below lemma 7.1.8
          %p
            Property
            %a.maruku-eqref{:href => "#eq:FourierTransformInIntegralOfProductMayBeShiftedToOtherFactor"} (4)
            of the ordinary
            %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
            on
            %a.existingWikiWord{:href => "/nlab/show/functions+with+rapidly+decreasing+partial+derivatives"} functions with rapidly decreasing partial derivatives
            motivates and justifies the fullowing generalization:
          #FourierTransformOnTemperedDistributions.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/tempered+distributions"} tempered distributions
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              of a
              %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi 𝒮
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{S}'(\mathbb{R}^n)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TemperedDistribution"}
              %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat u
              defined on a smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in \mathcal{S}(\mathbb{R}^n)
              in the
              %a.existingWikiWord{:href => "/nlab/show/Schwartz+space"} Schwartz space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SchwartzSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi u
                    %mrow
                      %mo (
                      %mover
                        %mi f
                        %mo ^
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{u}(f) \;\coloneqq\; u\left( \widehat f\right)
                    \\,,
            %p
              where on the right
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo ^
                    %mo ∈
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widehat f \in \mathcal{S}(\mathbb{R}^n)
              is the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
              of functions from def.
              = succeed "." do
                %a.maruku-ref{:href => "#FourierTransformSmoothFunctionsWithRapidlyDecayingDerivativesOnCartesianSpace"}
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "Fourier+transform#Hoermander90"} Hörmander 90, def. 1.7.9
          #FourierTransformOfDistributionsIndeedGeneralizedOrdinaryFourierTransform.num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
                indeed generalizes
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/functions+with+rapidly+decreasing+partial+derivatives"} functions with rapidly decreasing partial derivatives
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi f
                    %mo ∈
                    %mi 𝒮
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u_f \in \mathcal{S}'(\mathbb{R}^n)
              be a
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular
              %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
              induced, via example
              = succeed "," do
                %a.maruku-ref{:href => "#SomeNonSingularTemperedDistributions"}
              %a.existingWikiWord{:href => "/nlab/show/function+with+rapidly+decreasing+partial+derivatives"} function with rapidly decreasing partial derivatives
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi 𝒮
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in \mathcal{S}(\mathbb{R}^n)
            %p
              Then its
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FourierTransformOnTemperedDistributions"}
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular distribution
              induced from the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %msub
                          %mi u
                          %mi f
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi u
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{u_f} \;=\; u_{\hat f}
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi 𝒮
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g \in \mathcal{S}(\mathbb{R}^n)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mrow
                                %msub
                                  %mi u
                                  %mi f
                              %mo ^
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %msub
                              %mi u
                              %mi f
                            %mrow
                              %mo (
                              %mover
                                %mi g
                                %mo ^
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
                              %mrow
                                %mi x
                                %mo ∈
                                %msup
                                  %mi ℝ
                                  %mi n
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mover
                              %mi g
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi d
                              %mi n
                            %mi x
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∫
                              %mrow
                                %mi x
                                %mo ∈
                                %msup
                                  %mi ℝ
                                  %mi n
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi d
                              %mi n
                            %mi x
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi u
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\widehat{u_f}(g)
                    \&amp; \coloneqq
                    u_f\left( \widehat{g}\right)
                    \\\
                    \&amp; =
                    \\underset{x \in \mathbb{R}^n}{\int} f(x) \hat g(x)\, d^n x
                    \\\
                    \&amp; =
                    \\underset{x \in \mathbb{R}^n}{\int} \hat f(x) g(x) \, d^n x
                    \\\
                    \&amp; =
                    u_{\hat f}(g)
                    \\end{aligned}
            %p
              Here all equalities hold by definition, except for the third: this is property
              %a.maruku-eqref{:href => "#eq:FourierTransformInIntegralOfProductMayBeShiftedToOtherFactor"} (4)
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#BasicPropertiesOfFourierTransformOverCartesianSpaces"}
          #FourierTransformOfKleinGordonEquation.num_example
            %h6#example_7 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
                of
