              diverges for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \to 0
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ν
                  %annotation{:encoding => "application/x-tex"} a^{-\nu}
              (
              %a{:href => "http://dlmf.nist.gov/10.30#E2"}> DLMF 10.30.2
              ).
          %p
            (
            %a{:href => "Cauchy+principal+value#GelfandShilov66"}> Gel’fand-Shilov 66, III 2.11 (7), p 294
            )
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            %strong
              %a.existingWikiWord{:href => "/nlab/show/propagators"} propagators
              for the
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
          %ol
            %li
              %p
                %em
                  %a{:href => "#AdvancedAndRetardedPropagatorsForKleinGordonEquationOnMinkowskiSpacetime"} Advanced and regarded propagators
            %li
              %p
                %em
                  %a{:href => "#CausalPropagatorForKleinGordonEquationOnMinkowskiSpacetime"} Causal propagator
            %li
              %p
                %em
                  %a{:href => "#HadamardPropagatorForKleinGordonOnMinkowskiSpacetime"} Wightman propagator
            %li
              %p
                %em
                  %a{:href => "#FeynmanPropagator"} Feynman propagator
            %li
              %p
                %em
                  %a{:href => "#WaveFrontSetsOfPropagatorsForKleinGordonOperatorOnMinkowskiSpacetime"} Singular support and Wave front sets
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
            consider the
            %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
            (example
            = succeed ")" do
              %a.maruku-ref{:href => "#EquationOfMotionOfFreeRealScalarField"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi η
                    %mrow
                      %mi μ
                      %mi ν
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi μ
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %msup
                        %mi x
                        %mi ν
                  %mi Φ
                  %mo −
                  %msup
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mi m
                            %mi c
                          %mi ℏ
                      %mo )
                    %mn 2
                  %mi Φ
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\eta^{\mu \nu} \frac{\partial}{\partial x^\mu} \frac{\partial}{\partial x^\nu} \Phi -  \left( \tfrac{m c}{\hbar} \right)^2 \Phi \;=\; 0 \,.
          %p
            By example
            %a.maruku-ref{:href => "#FourierTransformOfKleinGordonEquation"}
            its
            %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mi k
                    %mi μ
                  %msup
                    %mi k
                    %mi μ
                  %mo −
                  %msup
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mi m
                            %mi c
                          %mi ℏ
                      %mo )
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi k
                    %mn 0
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo −
                  %msup
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi k
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} |
                    %mn 2
                  %mo −
                  %msup
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mi m
                            %mi c
                          %mi ℏ
                      %mo )
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \- k_\mu k^\mu - \left( \tfrac{m c}{\hbar} \right)^2
                  \\;=\;
                  (k_0)^2 - {\vert \vec k\vert}^2 - \left( \tfrac{m c}{\hbar} \right)^2
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/dispersion+relation"} dispersion relation
            of this equation we write (see def.
            = succeed ")" do
              %a.maruku-ref{:href => "#PlaneWaves"}
          #eq:DispersionRelationForKleinGordonooeratorObMinkowskiSpacetime.maruku-equation
            %span.maruku-eq-number (9)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi k
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo +
                  %mi c
                  %msqrt
                    %mrow
                      %msup
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mover
                            %mi k
                            %mo{:stretchy => "false"} →
                          %mo{:stretchy => "false"} |
                        %mn 2
                      %mo +
                      %msup
                        %mrow
                          %mo (
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mrow
                                %mi m
                                %mi c
                              %mi ℏ
                          %mo )
                        %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\omega(\vec k)
                  \\;\coloneqq\;
                  + c \sqrt{ {\vert \vec k \vert}^2 + \left( \tfrac{m c}{\hbar}\right)^2 }
                  \\,,
          %p
            where on the right we choose the
            %a.existingWikiWord{:href => "/nlab/show/non-negative+real+number"} non-negative
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
