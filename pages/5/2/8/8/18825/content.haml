                    %msup
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi k
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((x^i), (k_i))
              we have that for every
              %a.existingWikiWord{:href => "/nlab/show/compact+subset"} compact subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
