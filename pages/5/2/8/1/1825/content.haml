                            %mi G
                            %mn 2
                          %mo{:stretchy => "false"} /
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} S^6 \simeq_{diff} G_2/SU(3)
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82%2FSU%283%29+is+the+6-sphere"} G₂/SU(3) is the 6-sphere
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 15
                          %msub
                            %mo ≃
                            %mi diff
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 9
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 7
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} S^15 \simeq_{diff} Spin(9)/Spin(7)
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Spin%289%29%2FSpin%287%29+is+the+15-sphere"} Spin(9)/Spin(7) is the 15-sphere
            %p
              see also
              %em
                %a.existingWikiWord{:href => "/nlab/show/Spin%288%29-subgroups+and+reductions+--+table"} Spin(8)-subgroups and reductions
            %p#HomotopyTheoretic
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
              of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
            %p
              %img{:src => "/nlab/files/ExceptionalSpheres.jpg", :width => "730px"}/
            %p
              (from
              = succeed ")" do
                %a.existingWikiWord{:href => "/schreiber/show/Twisted+Cohomotopy+implies+M-theory+anomaly+cancellation"} FSS 19, 3.4
          %h4#AsQuotientsOfLorentzGroups As quotients of Lorentz groups
          %p
            If one drops the assumption of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compactness
            = succeed "-spheres," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotients
            of
            %a.existingWikiWord{:href => "/nlab/show/Lorentz+groups"} Lorentz groups
            by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/parabolic+subgroups"} parabolic subgroups
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/celestial+spheres"} celestial spheres
            = succeed "," do
              %a{:href => "#Toller03"} Toller (2003, p. 18)
            = succeed "," do
              %a{:href => "#Varlamov06"} Varlamov (2006, p. 6)
            = succeed "." do
              %a{:href => "https://math.stackexchange.com/a/4092474/58526"} Math.SE:a/4092474
          %h3#homotopyassociative_multiplication Homotopy-associative multiplication
          #SphereMultiplication.num_prop
            %h6#proposition_5 Proposition
            %p
              There exists no homotopy-associative multiplication on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi k
                  %annotation{:encoding => "application/x-tex"} S^k
              unless
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 1
                      %mo ,
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} k=1,3
          %p
            This is proven in (
            %a{:href => "#James57"}> James 1957
            ). There, it is also shown that there is only one homotopy class of multiplication on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            (complex multiplication),
            %em twelve
            classes for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 3
                %annotation{:encoding => "application/x-tex"} S^3
            (one of which given by the quaternions), and none for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 7
                %annotation{:encoding => "application/x-tex"} S^7
            (thus excluding the multiplication provided by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/octonion"} octonions
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Moufang+loop"} Moufang loop
          %h3#spin_structure Spin structure
          %p
          .num_remark
            %h6 Example
            %p
              The
              = succeed "-sphere," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
              = succeed "-realization" do
                %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ≃
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^n \simeq Spin(n+1)/Spin(n)
              (
              %a{:href => "#LabelCosetSpaceStructure"}> above
              ), as a special case of the canonical
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G/H
              (
              %a{:href => "G-structure#CanonicalHStructureOnFModH"}> this example
              ).
          %p Other ways to see this:
          %ul
            %li#Nowaczyk15
              %p
                Nikolai Nowaczyk, Theorem A.6.6 in:
                = succeed "," do
                  %em Dirac Eigenvalues of higher Multiplicity
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1501.04045"} arXiv:1501.04045
            %li#SpinorsInGeometryAndPhysics
              %p
                S. Gutt,
                = succeed "," do
                  %em Killing spinors on spheres and projective spaces
                = succeed "," do
                  %em Spinors in Geometry and Physics – Trieste 11-13 September 1986
                = succeed "," do
                  %a{:href => "https://doi.org/10.1142/9789814541510"} doi:10.1142/9789814541510
                = succeed ")" do
                  %a{:href => "https://books.google.ae/books?id=d14GCwAAQBAJ&lpg=PA243&ots=_tH_He8UFg&dq=%22spin%20structure%20on%20spheres%22&pg=PA243#v=onepage&q=%22spin%20structure%20on%20spheres%22&f=false"} GBooks, p. 243
          %p
            %br/
          %h3#parallelizability Parallelizability
          %ul
            %li
              %p
                Precisely four spheres are
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/parallelizable"} parallelizable
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
                structure (hence are the only spheres with Lie group structure) (see at
                = succeed "):" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Hopf+invariant+one+theorem"} Hopf invariant one theorem
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} S^0
                    (the
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/group+of+order+two"} group of order two
                    = succeed ");" do
                      %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} S^1
                    (the
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
                    = succeed ");" do
                      %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} S^3
                    (the
                    %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi SU
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} SU(2)
                    = succeed ");" do
                      %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 7
                        %annotation{:encoding => "application/x-tex"} S^7
                    (the
                    %a.existingWikiWord{:href => "/nlab/show/Moufang+loop"} Moufang loop
                    of unit
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
          %h3#branched_covers Branched covers
          %p
            Every
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/PL+manifold"} PL manifold
            admits a
            %a.existingWikiWord{:href => "/nlab/show/branched+covering"} branched covering
            of the
            %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            (
            %a{:href => "branched+cover#Alexander20"}> Alexander 20
            ).
          %p
            By the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Riemann+existence+theorem"} Riemann existence theorem
            %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann surface
            admits the
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            of a branched cover by a
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+function"} holomorphic function
            to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
            %a{:href => "branched+cover+of+the+Riemann+sphere#RiemannSurfaces"} there
            at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/branched+cover+of+the+Riemann+sphere"} branched cover of the Riemann sphere
          %div{:style => "text-align: center"}
            %img{:src => "https://ncatlab.org/nlab/files/TorusBranchedCoverOverSphere.jpg", :width => "500"}/
          %blockquote
            %p
              graphics grabbed from
              = succeed "," do
                %a{:href => "branched+cover#ChamseddineConnesMukhanov14"} Chamseddine-Connes-Mukhanov 14, Figure 1
              %a{:href => "branched+cover#Connes17"} Connes 17, Figure 11
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/3-manifolds"} 3-manifolds
            branched covering the
            %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
            see (
            %a{:href => "branched+cover#Montesinos74"}> Montesinos 74
            ).
          %p
            All
            %a.existingWikiWord{:href => "/nlab/show/PL+manifold"} PL
            %a.existingWikiWord{:href => "/nlab/show/4-manifolds"} 4-manifolds
            are
            %em simple
            branched covers of the
            %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            (
            %a{:href => "#Piergallini95"}> Piergallini 95
            ,
            = succeed ")." do
              %a{:href => "branched+cover#IoriPiergallini02"} Iori-Piergallini 02
          %p
            But the
            %a.existingWikiWord{:href => "/nlab/show/n-torus"} n-torus
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 3
                %annotation{:encoding => "application/x-tex"} n \geq 3
            is
            %em
              not a
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic
            branched over of the
            %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            (
            %a{:href => "branched+cover#HirschNeumann75"}> Hirsch-Neumann 75
            )
          %h3#iterated_loop_spaces Iterated loop spaces
          #RationalCohomologyOfIteratedLoopSpaceOf2kSphere.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
                of
                %a.existingWikiWord{:href => "/nlab/show/iterated+loop+space"} iterated loop space
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/n-sphere"} 2k-sphere
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi D
                    %mo &lt;
                    %mi n
                    %mo =
                    %mn 2
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    1 \leq D \lt n = 2k \in \mathbb{N}
            %p
              (hence two
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              %a.existingWikiWord{:href => "/nlab/show/even+number"} even
              and the other required to be smaller than the first) and consider the
              %a.existingWikiWord{:href => "/nlab/show/iterated+loop+space"} D-fold loop space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi D
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Omega^D S^n
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            %p
              Its
              %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
              %a.existingWikiWord{:href => "/nlab/show/graded-commutative+algebra"} graded-commutative algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              on one
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mrow
                        %mi n
                        %mo −
                        %mi D
                  %annotation{:encoding => "application/x-tex"} e_{n-D}
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mi D
                  %annotation{:encoding => "application/x-tex"} n - D
              and one generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mrow
                        %mn 2
                        %mi n
                        %mo −
                        %mi D
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} a_{2n - D - 1}
              of degree
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                      %mo −
                      %mi D
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2n - D - 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi Ω
                      %mi D
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msub
                      %mi e
                      %mrow
                        %mi n
                        %mo −
                        %mi D
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mn 2
                        %mi n
                        %mo −
                        %mi D
                        %mo −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet
                    \\big(
                    \\Omega^D S^n
                    ,
                    \\mathbb{Q}
                    \\big)
                    \\;\simeq\;
                    \\mathbb{Q}\big[ e_{n - D}, a_{2n - D - 1} \big]
                    \\,.
          %p
            (
            %a{:href => "#KallelSjerve99"}> Kallel-Sjerve 99, Prop. 4.10
            )
          %h2#Examples Examples
          %ul
            %li
              %p
                The
                = succeed "-sphere" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (-1)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/empty+space"} empty space
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
                is the
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
                of two
                %a.existingWikiWord{:href => "/nlab/show/points"} points
                (the classical
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/1-sphere"} 1-sphere
                is the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
                is usual sphere from ordinary geometry. This canonically carries the structure of a
                %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
                which makes it the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
                %a.existingWikiWord{:href => "/nlab/show/5-sphere"} 5-sphere
                and
                %a.existingWikiWord{:href => "/nlab/show/6-sphere"} 6-sphere
                and
                %a.existingWikiWord{:href => "/nlab/show/7-sphere"} 7-sphere
                are interesting, too.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/round+sphere"} round sphere
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fuzzy+sphere"}> fuzzy sphere
                ,
                %a.existingWikiWord{:href => "/nlab/show/Podle%C5%9B+sphere"} Podleś sphere
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/hemisphere"}> hemisphere
                ,
                %a.existingWikiWord{:href => "/nlab/show/equator"} equator
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/unit+sphere"} unit sphere
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/stereographic+projection"} stereographic projection
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sphere+fiber+bundle"} sphere fiber bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sphere+type"} sphere type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/polar+coordinates"} polar coordinates
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Reeb+sphere+theorem"} Reeb sphere theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+of+spheres"} homotopy groups of spheres
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/rational+n-sphere"} rational n-sphere
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spherical+fibration"} spherical fibration
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+quantization+of+the+2-sphere"} geometric quantization of the 2-sphere
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/representation+sphere"} representation sphere
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/motivic+sphere"} motivic sphere
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/group+actions+on+spheres"} group actions on spheres
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homology+sphere"} homology sphere
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/rational+homology+sphere"} rational homology sphere
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homotopy+sphere"} homotopy sphere
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+sphere"} rational homotopy sphere
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sphere+packing"} sphere packing
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tate+sphere"} Tate sphere
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian
                %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology+theory"} generalized cohomology theory
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represented
                by
                %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Cohomotopy+cohomology+theory"} Cohomotopy cohomology theory
          %h2#references References
          %ul
            %li#FP1990
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rudolf+Fritsch"}> Rudolf Fritsch
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Renzo+A.+Piccinini"} Renzo A. Piccinini
                = succeed "," do
                  %em Cellular structures in topology
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1017/CBO9780511983948"} doi:10.1017/CBO9780511983948
            %li#tomDieck2008
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
                ,
                = succeed "." do
                  %em Algebraic topology
                = succeed ")" do
                  %a{:href => "https://doi.org/10.4171/048"} doi:10.4171/048
          %h3#formalization Formalization
          %p
            Axiomatization of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of the 1-sphere (the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+inductive+types"} higher inductive types
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Univalent+Foundations+Project"}> Univalent Foundations Project
              , section 6.4 of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Homotopy+Type+Theory+--+Univalent+Foundations+of+Mathematics"} Homotopy Type Theory – Univalent Foundations of Mathematics
          %p Visualization of the idea of the construction for the 2-sphere is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andrej+Bauer"}> Andrej Bauer
              ,
              %em
                HoTT
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S^2
              (
              %a{:href => "https://vimeo.com/119606901"}> video
              )
          %h3#group_actions_on_spheres Group actions on spheres
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/free+actions"} free
            %a.existingWikiWord{:href => "/nlab/show/group+actions+on+spheres"} group actions on spheres
            by
            %a.existingWikiWord{:href => "/nlab/show/finite+groups"} finite groups
            includes
          %ul
            %li#Wall78
              %p
                %a.existingWikiWord{:href => "/nlab/show/C.+T.+C.+Wall"}> C. T. C. Wall
                ,
                = succeed "," do
                  %em Free actions of finite groups on spheres
                = succeed ")" do
                  %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/wall7.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alejandro+Adem"}> Alejandro Adem
                ,
                %em Constructing and deconstructing group actions
                (
                %a{:href => "http://arxiv.org/abs/math/0212280"}> arXiv:0212280
                )
          %p
            The subgroups of
            %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} SO(8)
            which act freely on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 7
                %annotation{:encoding => "application/x-tex"} S^7
            have been classified in
          %ul
            %li
              J. A. Wolf,
              = succeed "," do
                %em Spaces of constant curvature
          %p
            and lifted to actions of
            %a.existingWikiWord{:href => "/nlab/show/Spin+group"} Spin(8)
            in
          %ul
            %li#Gadhia07
              %a.existingWikiWord{:href => "/nlab/show/Sunil+Gadhia"}> Sunil Gadhia
              ,
              = succeed "," do
                %em Supersymmetric quotients of M-theory and supergravity backgrounds
              = succeed ")" do
                %a{:href => "http://inspirehep.net/record/1393845/"} spire:1393845
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/transitive+actions"} transitive actions
            on
            = succeed "-spheres" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+groups"} compact Lie groups
          %ul
            %li#MontgomerySamelson43
              %p
                %a.existingWikiWord{:href => "/nlab/show/Deane+Montgomery"}> Deane Montgomery
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hans+Samelson"} Hans Samelson
                = succeed "," do
                  %em Transformation Groups of Spheres
                %strong 44
                3 (1943) 454-470 &amp;lbrack;
                %a{:href => "https://www.jstor.org/stable/1968975"}> jstor:1968975
                \&amp;rbrack;
            %li#GrayGreen70
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alfred+Gray"}> Alfred Gray
                , Paul S. Green,
                = succeed "," do
                  %em Sphere transitive structures and the triality automorphism
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.pjm/1102976640"} euclid:1102976640
          %p Further discussion of these actions is in
          %ul
            %li#MFFGME09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+de+Medeiros"}> Paul de Medeiros
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+Figueroa-O%27Farrill"} José Figueroa-O'Farrill
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sunil+Gadhia"} Sunil Gadhia
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Elena+M%C3%A9ndez-Escobar"} Elena Méndez-Escobar
                = succeed "," do
                  %em Half-BPS quotients in M-theory: ADE with a twist
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/0909.0163"} arXiv:0909.0163
                = succeed ")" do
                  %a{:href => "http://www.maths.ed.ac.uk/~jmf/CV/Seminars/YRM2010.pdf"} pdf slides
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+de+Medeiros"}> Paul de Medeiros
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+Figueroa-O%27Farrill"} José Figueroa-O'Farrill
                = succeed "," do
                  %em Half-BPS M2-brane orbifolds
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/1007.4761"} arXiv:1007.4761
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.atmp/1408561553"} Euclid
          %p
            where they are related to the
            %a.existingWikiWord{:href => "/nlab/show/black+brane"} black
            %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            = succeed "-solutions" do
              %a.existingWikiWord{:href => "/nlab/show/BPS+state"} BPS
            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ADE-singularities"} ADE-singularities
          %p
            See also the
            %a.existingWikiWord{:href => "/nlab/show/ADE+classification"} ADE classification
            of such actions on the
            %a.existingWikiWord{:href => "/nlab/show/7-sphere"} 7-sphere
            (as discussed there)
          %p
            Discussion of actions of
            %a.existingWikiWord{:href => "/nlab/show/Lorentz+groups"} Lorentz groups
            on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/celestial+spheres"} celestial spheres
          %ul
            %li#Toller03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marco+Toller"}> Marco Toller
                ,
                %em Homogeneous Spaces of the Lorentz Group
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math-ph/0301014"}> arXiv:math-ph/0301014
                \&amp;rbrack;
            %li#Varlamov06
              %p
                V. V. Varlamov,
                = succeed "," do
                  %em Relativistic Spherical Functions on the Lorentz Group
                %strong 39
                (2006) 805-822 &amp;lbrack;
                %a{:href => "https://doi.org/10.1088/0305-4470/39/4/006"}> doi:10.1088/0305-4470/39/4/006
                \&amp;rbrack;
          %h3#multiplications_on_spheres Multiplications on spheres
          %ul
            %li#James57
              %a.existingWikiWord{:href => "/nlab/show/Ioan+M.+James"}> Ioan M. James
              \:
              = succeed "," do
                %em Multiplication on spheres (II)
              %strong 84
              2 (1957) 545-558 &amp;lbrack;
              %a{:href => "https://doi.org/10.1090/S0002-9947-1957-0090812-8"}> doi:10.1090/S0002-9947-1957-0090812-8
              ,
              = succeed "," do
                %a{:href => "https://doi.org/10.2307/1992830"} doi:10.2307/1992830
              = succeed "&rbrack;" do
                %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/jamesm2.pdf"} pdf
          %h3#geometric_structures_on_spheres Geometric structures on spheres
          %p Coset space structures on spheres:
          %ul
            %li#BorelSerre53
              %a.existingWikiWord{:href => "/nlab/show/Armand+Borel"}> Armand Borel
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jean-Pierre+Serre"} Jean-Pierre Serre
              = succeed "," do
                %em Groupes de Lie et Puissances Reduites de Steenrod
              = succeed ")" do
                %a{:href => "https://www.jstor.org/stable/2372495"} jstor:2372495
          %p The following to be handled with care:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
              ,
              = succeed "," do
                %em The non-existent complex 6-sphere
              %a{:href => "https://arxiv.org/abs/1610.09366"} arxiv/1610.09366
          %h3#embeddings_of_spheres Embeddings of spheres
          %p
            The (
            %a.existingWikiWord{:href => "/nlab/show/isotopy"} isotopy
            %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} class
            of an)
            %a.existingWikiWord{:href => "/nlab/show/embedding+of+differentiable+manifolds"} embedding
            of a
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            (1-sphere) into the
            %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
            is a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/knot"} knot
          %ul
            %li#Haefliger66
              %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Haefliger"}> André Haefliger
              ,
              = succeed "," do
                %em
                  Differentiable Embeddings of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mi n
                      %annotation{:encoding => "application/x-tex"} S^n
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mi q
                      %annotation{:encoding => "application/x-tex"} S^{n+q}
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                        %mo &gt;
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} q \gt 2
              = succeed ")" do
                %a{:href => "https://www.jstor.org/stable/1970475"} jstor:1970475
          %h3#iterated_loop_spaces_2 Iterated loop spaces
          %ul
            %li#KallelSjerve99
              %a.existingWikiWord{:href => "/nlab/show/Sadok+Kallel"}> Sadok Kallel
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Denis+Sjerve"} Denis Sjerve
              = succeed "," do
                %em On Brace Products and the Structure of Fibrations with Section
              = succeed "," do
                %a{:href => "https://www.math.ubc.ca/~sjer/brace.pdf"} pdf
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/KallelSjerv99.pdf", :title => "pdf"} pdf
          %h3#topological_complexity Topological complexity
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/topological+complexity"} topological complexity
            of spheres and
            %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} products
            of spheres (including
            %a.existingWikiWord{:href => "/nlab/show/tori"} tori
            as special case):
          %ul
            %li#Farber01
              %a.existingWikiWord{:href => "/nlab/show/Michael+Farber"}> Michael Farber
              ,
              %em Topological complexity of motion planning
              (2001),
              = succeed ";" do
                %a{:href => "https://arxiv.org/abs/math/0111197"} arXiv:math/0111197
        .revisedby
