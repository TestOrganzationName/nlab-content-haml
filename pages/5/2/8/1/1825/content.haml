                            %mi odd
                        %mtr
                          %mtd
                            %mn 2
                            %mi n
                            %mo +
                            %mn 1
                          %mtd
                            %mo ;
                            %mi m
                            %mspace{:width => "1em"}
                            %mi even
                  %annotation{:encoding => "application/x-tex"}
                    TC
                    \\big(
                    (S^m)^n
                    \\big)
                    \\;=\;
                    \\left\{
                    \\begin{array}{ll}
                    n+1 &amp; ; m \quad odd
                    \\\
                    2n+1 &amp; ; m \quad even
                    \\end{array}
                    \\right.
            %p
          %p
            (
            %a{:href => "#Farber01"}> Farber 01, Theorem 13
            )
          %p
            A special case of this proposition is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi TC
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi T
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi n
