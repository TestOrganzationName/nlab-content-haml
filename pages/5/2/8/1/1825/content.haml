          .proof
            %h6#proof_2 Proof
            %p
              Fix a
              %a.existingWikiWord{:href => "/nlab/show/unit+vector"} unit vector
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
