                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n+1)
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
              is clearly the canonical embedding
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                      %mo ↪
                      %msup
                        %mi ℝ
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} S^n \hookrightarrow \mathbb{R}^{n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n+1)
              that consists of rotations around the axis formed by that unit vector
              %a.existingWikiWord{:href => "/nlab/show/stabilizer+group"} stabilizes
              it, and that subgroup is isomorphic to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                      %mo ≃
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S^n \simeq O(n+1)/O(n)
          %p
            Similarly, the analogous argument for
            %a.existingWikiWord{:href => "/nlab/show/unit+spheres"} unit spheres
            inside (the
            %a.existingWikiWord{:href => "/nlab/show/real+vector+spaces"} real vector spaces
            underlying)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+spaces"} complex vector spaces
          #OddDimSphereAsSpecialUnitaryCoset.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (2k+1)-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{2k+1}
              is the
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/special+unitary+groups"} special unitary groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^{2k+1}
                    \\;\simeq\;
                    SU(k+1)/SU(k)
                    \\,.
          %p
            And still similarly, the analogous argument for
            %a.existingWikiWord{:href => "/nlab/show/unit+spheres"} unit spheres
            inside (the
            %a.existingWikiWord{:href => "/nlab/show/real+vector+spaces"} real vector spaces
            underlying)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+vector+spaces"} quaternionic vector spaces
          #SphereAsSymplecticUnitaryCoset.num_prop
            %h6#proposition_3 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k \geq 1
              the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (4k-1)-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 4
                        %mi k
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{4k-1}
              is the
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/quaternionic+unitary+groups"} quaternionic unitary groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 4
                        %mi k
                        %mo −
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^{4k-1}
                    \\;\simeq\;
                    Sp(k)/Sp(k-1)
                    \\,.
          %p Generally:
          #TransitiveEffectiveActionsOfConnectedLieGroupsOnSpheres.num_prop
            %h6#proposition_4 Proposition
            %p
