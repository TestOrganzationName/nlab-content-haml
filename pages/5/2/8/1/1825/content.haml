          .num_defn
            %h6#definition_2 Definition
            %p
              The
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %strong sphere
              , or simply
              = succeed "," do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  \-sphere
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              given by the
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of the
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
              consisting of all points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              whose distance from the origin is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo :
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} ‖
                    %mi x
                    %mo{:stretchy => "false"} ‖
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^n = \{ x: \mathbb{R}^{n+1} \;|\; \|x\| = 1 \}
                    \\,.
            %p
              The
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mi r
                      %mi n
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo :
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} ‖
                    %mi x
                    %mo{:stretchy => "false"} ‖
                    %mo =
                    %mi r
                    %mo{:stretchy => "false"} }
                    %mo .
                  %annotation{:encoding => "application/x-tex"} S^n_r = \{ x: \mathbb{R}^{n+1} \;|\; \|x\| = r \} .
            %p
              Topologically, this is equivalent (
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"}> homeomorphic
              ) to the unit sphere for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} r \gt 0
              %a.existingWikiWord{:href => "/nlab/show/point"} point
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} r = 0
            %p
              This is naturally a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
              induced by the standard smooth structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          %h3#InfiniteDimensionalSphere Infinite dimensional spheres
          %p
            One can also talk about the
            %a.existingWikiWord{:href => "/nlab/show/infinite-dimensional+sphere"} infinite-dimensional sphere
            in an arbitrary (possibly infinite-dimensional)
            %a.existingWikiWord{:href => "/nlab/show/normed+vector+space"} normed vector space
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo :
                  %mi V
                  %mspace{:width => "thickmathspace"}
                  %mtext such that
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi x
                    %mo{:stretchy => "false"} ‖
                  %mo =
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} S(V) = \{ x: V \;\text{such that}\; {\|x\|} = 1 \} .
          %p
            If a
            %a.existingWikiWord{:href => "/nlab/show/LCTVS"} locally convex topological vector space
            admits a continuous linear injection into a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/normed+vector+space"} normed vector space
            %em quotient
            of the space of non-zero vectors under the scalar action of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,\infty)
          %p
            Homotopy theorists (e.g.
            = succeed ")" do
              %a{:href => "#tomDieck2008"} tom Dieck 2008, example 8.3.7
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} S^\infty
            as the
            %a.existingWikiWord{:href => "/nlab/show/directed+colimit"} directed colimit
            of the
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ↪
                  %msup
                    %mi S
                    %mn 0
                  %mo ↪
                  %msup
                    %mi S
                    %mn 1
                  %mo ↪
                  %msup
                    %mi S
                    %mn 2
                  %mo ↪
                  %mi ⋯
                  %msup
                    %mi S
                    %mn ∞
                  %mo .
                %annotation{:encoding => "application/x-tex"} S^{-1} \hookrightarrow S^0 \hookrightarrow S^1 \hookrightarrow S^2 \hookrightarrow \cdots S^\infty .
          %p
            Note that this
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} S^\infty
            is
            %em not
            homeomorphic to the sphere of any metrizable space as defined above, since the metrizable
            %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW-complexes
            are precisely the
            %a.existingWikiWord{:href => "/nlab/show/locally+finite+cell+complex"} locally finite CW-complexes
            (
            %a{:href => "#FP1990"}> Fritsch–Piccinini 1990: 48, prop. 1.5.17
            ), which
            %a{:href => "#CWstructures"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} S^\infty
              is not
            (every open
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo &gt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} m \gt n
          %p
            In themselves, infinite-dimensional spheres provide nothing new to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
          %p
            If the vector space is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/shift+space"} shift space
          #theorem.num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              %a.existingWikiWord{:href => "/nlab/show/shift+space"} shift space
              of some order. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi V
                  %annotation{:encoding => "application/x-tex"} S V
              be its sphere (either via a norm or as the quotient of non-zero vectors). Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi V
                  %annotation{:encoding => "application/x-tex"} S V
              is contractible.
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:lspace => "verythinmathspace"} :
                    %mi V
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} T \colon V \to V
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/shift+map"} shift map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            %p
              It is simplest to start with the non-zero vectors,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} V \setminus \{0\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is injective, it restricts to a map from this space to itself which commutes with the scalar action of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0,\infty)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi V
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    H \colon [0,1] \times (V \setminus
                    \\{0\}) \to V \setminus \{0\}
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mi t
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mi v
                      %mo +
                      %mi t
                      %mi T
                      %mi v
                    %annotation{:encoding => "application/x-tex"} H_t(v) = (1 - t)v + t T v
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi t
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_t(v)
              is never zero. The only place where it could be zero would be on an eigenvector of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is a
              %a.existingWikiWord{:href => "/nlab/show/shift+map"} shift map
              then it has none.
            %p
              As
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/shift+map"} shift map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} v_0
              not in its image. Then we define a homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi V
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} G \colon [0,1] \times (V \setminus \{0\}) \to V \setminus \{0\}
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi t
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mi T
                      %mi v
                      %mo +
                      %mi t
                      %msub
                        %mi v
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} G_t(v) = (1 - t)T v + t v_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} v_0
              is not in the image of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∖
