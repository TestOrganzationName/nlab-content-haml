              with
              %a.existingWikiWord{:href => "/nlab/show/effective+action"} effective
              %a.existingWikiWord{:href => "/nlab/show/transitive+actions"} transitive actions
              on
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              are precisely (up to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %ul
              %li
                %p
