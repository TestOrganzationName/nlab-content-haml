          %h3#LabelCosetSpaceStructure Coset space structure
          %h4#AsQuotientsOfCompactLieGroups As quotients of compact Lie groups
          #nSphereAsCosetSpace.num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              are
              %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
              of
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+groups"} orthogonal groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^n \;\simeq\; O(n+1)/O(n)
                    \\,.
            %p
              Similarly for the corresponding
              %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+groups"} special orthogonal groups
            .maruku-equation
