                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              is compact. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CH
                  %annotation{:encoding => "application/x-tex"} CH
              is a full subcategory of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
