            using the usual application of functions to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/filters"} filters
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            is a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
            (in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi S
                    %mo :
                    %mi S
                    %mo →
                    %mi β
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \eta_S: S \to \beta S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to the
            %a.existingWikiWord{:href => "/nlab/show/principal+ultrafilter"} principal ultrafilter
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            generates, and multiplication
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi S
                    %mo :
                    %mi β
                    %mi β
                    %mi S
                    %mo →
                    %mi β
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \mu_S: \beta \beta S \to \beta S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            on ultrafilters to the ultrafilter of sets whose principal ultrafilters of ultrafilters belong to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi η
                    %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \in \eta x \;\Leftrightarrow\; x \in A
              , so
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mi x
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi A
                      %mo ⊆
                      %mi S
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
