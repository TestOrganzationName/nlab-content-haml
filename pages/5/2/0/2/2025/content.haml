                    %mrow
                      %mi Y
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y \times Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
