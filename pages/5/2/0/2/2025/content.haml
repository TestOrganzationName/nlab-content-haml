                      %mo ∈
                      %mi A
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \eta x = \{ A \subseteq S \;|\; x \in A \}
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi μ
                    %mi U
                    %mspace{:width => "thickmathspace"}
