                  %mi S
                %annotation{:encoding => "application/x-tex"} \beta S
            be the set of
            %a.existingWikiWord{:href => "/nlab/show/ultrafilters"} ultrafilters
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            is an
            %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            on
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi S
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} f: S \to T
            induces a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mi f
                  %mo :
