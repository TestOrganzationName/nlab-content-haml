                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} ⟩
                    %mo :
                    %mi E
                    %mo →
                    %mi Y
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \langle p_0, p_1 \rangle : E \to Y \times Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              is closed. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ↪
                    %mi Y
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} R \hookrightarrow Y \times Y
              be the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ⟩
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \langle f, g \rangle: X \to Y \times Y
              = succeed "," do
                %a.maruku-ref{:href => "#split"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi Y
                    %mo ×
                    %mi U
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} U Y \times U Y
              coincides with the subset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo ⋅
                      %msup
                        %mi R
                        %mi op
                      %mo ⊆
                      %mi U
                      %mi Y
                      %mo ×
                      %mi U
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} R \cdot R^{op} \subseteq U Y \times U Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is the image of the compact space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              under the continuous map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle f, g \rangle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a closed subset of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y \times Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi op
                  %annotation{:encoding => "application/x-tex"} R^{op}
              is a closed subset of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
