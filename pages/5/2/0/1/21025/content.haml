                  the description of
                  %a.existingWikiWord{:href => "/nlab/show/topological+T-duality"} topological T-duality
                  %a{:href => "T-fold#NikolausWaldorf18"} by Nikolaus and Waldorf
                  in terms of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/principal+2-bundles"} principal 2-bundles
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-duality
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/non-geometric+string+vacuum"} non-geometric cases
          %p
            %br/
          %ul
            %li#Berman2023
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Berman"}> David Berman
                \:
              %p
