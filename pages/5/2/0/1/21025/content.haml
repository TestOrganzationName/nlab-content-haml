                  in
                  %a.existingWikiWord{:href => "/nlab/show/Dijkgraaf-Witten+theories"} Dijkgraaf-Witten theories
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
