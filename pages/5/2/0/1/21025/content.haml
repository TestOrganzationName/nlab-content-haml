                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (1,0)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo =
                        %mn 11
                        %mo +
                        %mn 3
                      %annotation{:encoding => "application/x-tex"} D=11+3
                  superalgebra to the
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
