                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/derived+differential+geometry"} derived differential geometry
                  %a.existingWikiWord{:href => "/nlab/show/formal+geometry"} formal
                  %a.existingWikiWord{:href => "/nlab/show/derived+geometry"} derived
                  %a.existingWikiWord{:href => "/nlab/show/smooth+stacks"} smooth stacks
                  (i.e.
                  %a.existingWikiWord{:href => "/nlab/show/stacks"} stacks
                  on formal
                  = succeed ")," do
                    %a.existingWikiWord{:href => "/nlab/show/derived+smooth+manifolds"} derived smooth manifolds
                  %a{:href => "derived+algebraic+geometry#ToenVezzosi04"} Töen-Vezzosi’s homotopical algebraic geometry
                  to the theory of
                  %a.existingWikiWord{:href => "/nlab/show/derived+manifolds"} derived manifolds
                  of
                  %a{:href => "derived+smooth+manifold#Spivak08"} Spivak
                  and
                  = succeed "." do
                    %a{:href => "derived+smooth+manifold#CarchediSteffens19"} Carchedi-Steffens
                  %a.existingWikiWord{:href => "/nlab/show/scalar+field+theory"} scalar field theory
                  and
                  = succeed "." do
