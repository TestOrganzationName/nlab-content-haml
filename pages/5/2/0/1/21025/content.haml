                  %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
                  also has an
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} action
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/exceptional+Lie+algebra"}
                      type
