                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} Z
                  via the
                  %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
                  %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℒ
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} \mathcal{L}Z
                  with
                  %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                  in the (typically non-flat)
                  %a.existingWikiWord{:href => "/nlab/show/higher+holonomy"} holonomy
                  %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} line bundle
                  of a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} gerbe
                  %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/superconnection"} superconnection
                  %a.existingWikiWord{:href => "/nlab/show/Bismut-Chern+character"} Bismut-Chern character
                  form, a loop space refinement of the
                  %a.existingWikiWord{:href => "/nlab/show/twisted+Chern+character"} twisted Chern character
                  form, which represent classes in the completed periodic exotic twisted
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/circle+group"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} S^1
                  %a.existingWikiWord{:href => "/nlab/show/equivariant+de+Rham+cohomology"} equivariant cohomology
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℒ
                          %mi Z
                        %annotation{:encoding => "application/x-tex"} \mathcal{L}Z
                  = succeed "-equivariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} S^1
                  %a.existingWikiWord{:href => "/nlab/show/topological+T-duality"} T-duality
                  in a
                  %a.existingWikiWord{:href => "/nlab/show/background+field"} background
                  %a.existingWikiWord{:href => "/nlab/show/flux"} flux
                  in
                  %a.existingWikiWord{:href => "/nlab/show/type+II+String+Theory"} type II String Theory
                  from a
                  %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
                  perspective. Finally we reinterpret these results as
