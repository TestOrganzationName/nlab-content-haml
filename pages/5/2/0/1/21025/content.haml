                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/branched+covers"} branched covers
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
