                  %mo □
                %annotation{:encoding => "application/x-tex"} \square
          %h2#size_issues Size issues
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} ]
