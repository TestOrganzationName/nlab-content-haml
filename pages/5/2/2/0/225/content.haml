            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi γ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \gamma_a
            would be equal to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi idtoiso
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} idtoiso(p_a)
            (this can easily be proved by induction on
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi isotoid
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi γ
                    %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} isotoid(\gamma_a)
            would be equal to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi a
                  %annotation{:encoding => "application/x-tex"} p_a
            %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
            we would have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ¯
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} {\bar\gamma}={p}
          %p Finally, consider the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ≅
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo =
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ≅
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} (F\cong G)\to  ( F = G) \to (F\cong G).
          %p
            Since identity of
            %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            can be tested componentwise, it suffices to show that for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            we have
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mi idtoiso
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ¯
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi a
                    %mo =
                    %mrow
                      %msub
                        %mi γ
                        %mi a
                  %annotation{:encoding => "application/x-tex"} {idtoiso(\bar\gamma)_a}={\gamma_a}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mi idtoiso
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ¯
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi a
                    %mo =
                    %mrow
                      %mi idtoiso
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ¯
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi a
                      %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} {idtoiso(\bar\gamma)_a}={idtoiso((\bar\gamma)_a)}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ¯
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi a
                  %mo =
                  %mrow
                    %mi isotoid
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi γ
                      %mi a
                    %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {(\bar\gamma)_a}={isotoid(\gamma_a)}
            by computation for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
