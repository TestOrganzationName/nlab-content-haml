                  %mi C
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [C,Set]
            are locally small, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            must be
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/essentially+small+category"} essentially small
            = succeed "." do
