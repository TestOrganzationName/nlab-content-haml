          %ul
            %li#KECA
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nicolai+Kraus"} Nicolai Kraus
                and
                %a.existingWikiWord{:href => "/nlab/show/Martin+Escardo"} Martin Escardo
                and
                %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"} Thierry Coquand
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thorsten+Altenkirch"} Thorsten Altenkirch
                = succeed "." do
                  %a{:href => "http://www.cs.bham.ac.uk/~mhe/papers/hedberg.pdf"} PDF
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nicolai+Kraus"}> Nicolai Kraus
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mart%C3%ADn+Escard%C3%B3"} Martín Escardó
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thierry+Coquand"} Thierry Coquand
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thorsten+Altenkirch"} Thorsten Altenkirch
                = succeed "," do
                  %em Notions of Anonymous Existence in Martin-Löf Type Theory
                %strong 13
                1 &amp;lbrack;
                %a{:href => "https://doi.org/10.23638/LMCS-13(1:15)2017"}> doi:10.23638/LMCS-13(1:15)2017
                ,
