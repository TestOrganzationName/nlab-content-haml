                                %mrow
                                  %msub
                                    %mi f
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_1 &amp;&amp; &amp;&amp; X_2
                    \\\
                    \&amp; \searrow^{\mathrlap{(id,0)}} &amp;&amp; {}^{\mathllap{(0,id)}}\swarrow
                    \\\
                    {}^{\mathllap{id_{X_1}}}\downarrow &amp;&amp; X_1 \times X_2 &amp;&amp; \downarrow^{\mathrlap{id_{X_2}}}
                    \\\
                    \&amp;  &amp;&amp;
                    \\\
                    X_1 &amp;&amp; \downarrow^{\mathrlap{\phi}} &amp;&amp; X_2
                    \\\
                    \&amp; {}_{\mathllap{f_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{f_2}}
                    \\\
                    \&amp;&amp; Q
                    }
                    \\,.
            %p
              Moreover, this is unique: suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \phi'
              is another morphism filling this diagram, then, by using equation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo ⋆
                      %mo ⋆
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\star \star)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ϕ
