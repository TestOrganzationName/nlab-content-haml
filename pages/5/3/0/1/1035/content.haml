          %h2#definition Definition
          #AdditiveCategory.num_defn
            %h6#definition_2 Definition
            %p
              An
              %strong additive category
              is a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              which is
            %ol
              %li
                %p
                  an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
                %p
                  (sometimes called a
                  = succeed "\u2013this" do
                    %a.existingWikiWord{:href => "/nlab/show/pre-additive+category"} pre-additive category
                  %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
                  carries the structure of an
                  %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
                  and composition is
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear
              %li
                %p
                  which admits
                  %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite
                  %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
                %p
                  (and hence, by prop.
                  %a.maruku-ref{:href => "#ProductsAreBiproducts"}
                  below, finite
                  %a.existingWikiWord{:href => "/nlab/show/products"} products
                  which coincide with the coproducts, hence finite
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/biproducts"} biproducts
            %p
              The natural
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %em between
              additive categories are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/additive+functors"} additive functors
          .num_remark
            %h6#remark Remark
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/pre-abelian+category"} pre-abelian category
              is an additive category which also has
              %a.existingWikiWord{:href => "/nlab/show/kernels"} kernels
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cokernels"} cokernels
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              and finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
              %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
              are
              %a.existingWikiWord{:href => "/nlab/show/kernels"} kernels
              and all
              %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cokernels"} cokernels
              %em
                %a.existingWikiWord{:href => "/nlab/show/additive+and+abelian+categories"} additive and abelian categories
              for more.
          .num_remark
            %h6#remark_2 Remark
            %p
              The
              = succeed "-enrichment" do
                %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              %a.existingWikiWord{:href => "/nlab/show/semiadditive+category"} semiadditive category
              (a category with finite
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/biproducts"} biproducts
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
              over
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoids"} commutative monoids
              (as described at
              = succeed ")," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/biproduct"} biproduct
              %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-monoids
              happen to be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groups"} groups
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ab
                    %annotation{:encoding => "application/x-tex"} Ab
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian categories
          .num_remark
            %h6#remark_3 Remark
            %p
              Some authors use
              %strong additive category
              to simply mean an Ab-enriched category, with no further assumptions. It can also be used to mean a
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CMon
                    %annotation{:encoding => "application/x-tex"} CMon
          %h2#properties Properties
          #ProductsAreBiproducts.num_prop
            %h6#proposition Proposition
            %p
              In an
              %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
              (or even just a
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CMon
                    %annotation{:encoding => "application/x-tex"} CMon
              %a.existingWikiWord{:href => "/nlab/show/finite+product"} finite
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              is also a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/biproduct"} biproduct
            %p
              This statement includes the zero-ary case: any
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              is also an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              (and dually), hence every additive category has a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
            %p
              More precisely, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{X_i\}_{i \in I}
              a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              of objects in an Ab-enriched category, the unique morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                    %mo ⟶
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi j
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi j
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\coprod} X_i \longrightarrow \underset{j \in I}{\prod} X_j
            %p
              whose components are identities for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo =
                    %mi j
                  %annotation{:encoding => "application/x-tex"} i = j
              and are
              %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero
              otherwise is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .proof
            %h6#proof Proof
            %p
              Consider first the nullary (i.e., zero-ary) case. Given a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mo *
                    %mo :
                    %mo *
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} id_\ast: \ast \to \ast
              is the zero morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              in its hom-object. For any object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 0
                      %mi A
                    %mo :
                    %mo *
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} 0_A: \ast \to A
              must equal any morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo *
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f: \ast \to A
              on account of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi f
                    %msub
                      %mi id
                      %mo *
                    %mo =
                    %mi f
                    %mn 0
                    %mo =
                    %msub
                      %mn 0
                      %mi A
                  %annotation{:encoding => "application/x-tex"} f = f id_\ast = f 0 = 0_A
              where the last equation is by
              = succeed "-enrichment." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CMon
                    %annotation{:encoding => "application/x-tex"} CMon
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
              is initial. (N.B.: this argument applies more generally to categories
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
              in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/formal+duality"} dual
            %p
              Consider now the case of binary (co-)products. Using
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/zero+morphisms"} zero morphisms
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi X
                        %mn 1
                      %mo ×
                      %msub
                        %mi X
                        %mn 2
                      %mo →
                      %msub
                        %mi X
                        %mi i
                    %annotation{:encoding => "application/x-tex"} p_i \colon X_1 \times X_2 \to X_i
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              also admits “injection” maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi i
                      %mo →
                      %msub
                        %mi X
                        %mn 1
                      %mo ×
                      %msub
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} X_i \to X_1 \times X_2
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
