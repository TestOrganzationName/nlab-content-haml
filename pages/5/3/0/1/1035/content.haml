                              %mi X
                              %mn 1
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 0
                                  %mo ,
                                  %mi id
                                  %mo{:stretchy => "false"} )
                            %mo ↙
                        %mtr
