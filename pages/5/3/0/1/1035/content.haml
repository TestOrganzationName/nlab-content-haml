                    %mi Y
                    %mo ≃
                    %mi Y
                    %mo ⊔
                    %mi Y
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∇
                          %mi Y
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f + g
                    \\;\coloneqq\;
                    X \overset{\Delta_X}{\to} X \times X
                    \\simeq
                    X \oplus X
                    \\overset{f \oplus g}{\longrightarrow}
                    Y \oplus Y
                    \\simeq
                    Y \sqcup Y
                    \\overset{\nabla_Y}{\to}
                    Y
                    \\,.
            %p
              With respect to this operation,
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear
          .proof
            %h6#proof_2 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
              and commutativity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %annotation{:encoding => "application/x-tex"} +
              follows directly from the corresponding properties of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊕
                    %annotation{:encoding => "application/x-tex"} \oplus
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality
              of the
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \Delta_X
              and
              %a.existingWikiWord{:href => "/nlab/show/codiagonal"} codiagonal
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∇
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \nabla_X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
