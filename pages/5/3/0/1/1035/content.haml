                            %mo +
                            %msub
                              %mi f
                              %mn 2
                            %mo ∘
                            %msub
                              %mi p
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi ϕ
                            %mo ′
                            %mo ∘
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi id
                              %mrow
                                %msub
                                  %mi X
                                  %mn 1
                            %mo ,
                            %mn 0
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %msub
                              %mi p
