                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↑
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↑
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
