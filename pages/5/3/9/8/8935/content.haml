            of each
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Id_A(x,x)
            (of
            %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
            of a
            %a.existingWikiWord{:href => "/nlab/show/term"} term
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x \colon A
            %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositionally equal
            to the canonical
            %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexivity
            equality proof
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi refl
                      %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Id
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} refl_x \colon Id_A(x,x)
          %p
            Axiom K can also be called
            %strong loop induction
            or
            %strong self-identification induction
            in parallel to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/path+induction"} path induction
          %h2#statement Statement
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:lspace => "verythinmathspace"} :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Type
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi P
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Type
                  %mrow
                    %mo (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi refl
                      %mi A
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi h
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi Id
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  K
                  \\colon
                  \\underset{A \colon Type}{\prod}
                  \\underset{x \colon A}{\prod}
                  \\underset{P \colon Id_A(x,x) \to Type}{\prod}
                  \\left(
                  P(refl_A x)
                  \\to
                  \\underset{h \colon Id_A(x,x)}{\prod} P(h)
                  \\right)
          %p
            If one doesn’t have
            %a.existingWikiWord{:href => "/nlab/show/type+universes"} type universes
            in the type theory, then axiom K has to be expressed as an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/inference+rule"} inference rule
            = succeed ":" do
              %strong K-rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi p
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi K
                        %mrow
                          %mi A
                          %mo ,
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %msub
                        %mi{:mathvariant => "normal"} refl
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi h
                          %mo :
                          %msub
                            %mi{:mathvariant => "normal"} Id
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi h
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma, x:A, p:\mathrm{Id}_A(x,x) \vdash P(x, p) \; \mathrm{type}}{\Gamma \vdash K_{A, P(-, -)}:\prod_{x:A} P(x, \mathrm{refl}_A(x)) \to \prod_{h:\mathrm{Id}_A(x,x)} P(x, h)}
          %p
            The associated judgmental
            %a.existingWikiWord{:href => "/nlab/show/computation+rule"} computation rule
            for the
            = succeed "-rule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi p
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi d
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %msub
                        %mi{:mathvariant => "normal"} refl
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %msub
                        %mi K
                        %mrow
                          %mi A
                          %mo ,
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi d
                      %mo ,
                      %msub
                        %mi{:mathvariant => "normal"} refl
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi d
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %msub
                        %mi{:mathvariant => "normal"} refl
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma, x:A, p:\mathrm{Id}_A(x,x) \vdash P(x, p) \; \mathrm{type}}{\Gamma, x:A, d:P(x, \mathrm{refl}_A(x)) \vdash K_{A, P(-, -)}(x, d, \mathrm{refl}_A(x)) \equiv d:P(x, \mathrm{refl}_A(x))}
          %h3#using_the_circle_type Using the circle type
          %p
            One can, instead of using elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            and self identifications
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} Id
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p:\mathrm{Id}_A(x,x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} p:S^1 \to A
            from the
            %a.existingWikiWord{:href => "/nlab/show/circle+type"} circle type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            to express axiom K:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi K
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %mo{:lspace => "verythinmathspace"} :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi A
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Type
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi P
                      %mo{:lspace => "verythinmathspace"} :
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 1
                      %mo →
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Type
                  %mrow
                    %mo (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi p
                        %mo :
                        %msup
                          %mi S
                          %mn 1
                        %mo →
                        %mi A
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  K^{\prime}
                  \\colon
                  \\underset{A \colon Type}{\prod}
                  \\underset{x \colon A}{\prod}
                  \\underset{P \colon (S^1 \to A) \to Type}{\prod}
                  \\left(
                  P(\lambda i:S^1.x)
                  \\to
                  \\underset{p:S^1 \to A}{\prod} P(p)
                  \\right)
          %p
            This states that the function type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} S^1 \to A
            is a
            %a.existingWikiWord{:href => "/nlab/show/positive+copy"} positive copy
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+type"} circle type
          %p
            If one doesn’t have
            %a.existingWikiWord{:href => "/nlab/show/type+universes"} type universes
            in the type theory, then axiom K has to be expressed as an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inference+rule"} inference rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi p
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                      %mo →
                      %mi A
                      %mo ⊢
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msubsup
                        %mi K
                        %mrow
                          %mi A
                          %mo ,
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mstyle{:scriptlevel => "0"}
                          %mo ′
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo →
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi p
                          %mo :
                          %msup
                            %mi S
                            %mn 1
                          %mo →
                          %mi A
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma, p:S^1 \to A \vdash P(p) \; \mathrm{type}}{\Gamma \vdash K_{A, P(-)}^{\prime}:\prod_{x:A} P(\lambda i:S^1.x) \to \prod_{p:S^1 \to A} P(p)}
          %p
            The associated judgmental
            %a.existingWikiWord{:href => "/nlab/show/computation+rule"} computation rule
            for the above rule is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi p
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi d
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %msub
                        %mi K
                        %mrow
                          %mi A
                          %mo ,
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi d
                      %mo ,
                      %mi λ
                      %mi i
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi d
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma, x:A, p:\mathrm{Id}_A(x,x) \vdash P(x, p) \; \mathrm{type}}{\Gamma, x:A, d:P(\lambda i:S^1.x) \vdash K_{A, P(-, -)}(x, d, \lambda i:S^1.x) \equiv d:P(\lambda i:S^1.x)}
          %h2#properties Properties
          %h3#relation_to_localization
            Relation to
            = succeed "-localization" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
          %p
            The negative analogue of axiom K is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+S1-localization"}
                axiom of
                = succeed "-localization" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} const
                    %mrow
                      %mi A
                      %mo ,
                      %msup
                        %mi S
                        %mn 1
                  %mo ≡
                  %mi λ
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi λ
                  %mi i
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                  %mo .
                  %mi x
                  %mo :
                  %mi A
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{const}_{A, S^1} \equiv \lambda x:A.\lambda i:S^1.x:A \to (S^1 \to A)
          %p
            is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            or a definitional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
          .num_theorem
            %h6 Theorem
            %p
              Suppose that every type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is definitionally
              = succeed "-local." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} S^1 \to A
              is a
              %a.existingWikiWord{:href => "/nlab/show/positive+copy"} positive copy
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(p)
              indexed by loops
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p:S^1 \to A
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo :
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t:\prod_{x:A} C(\lambda i:S^1.x)
              which says that for all elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
              into
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(\lambda i:S^1.x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi z
                        %mo :
                        %msup
                          %mi S
                          %mn 1
                        %mo →
                        %mi A
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_A(t):\prod_{z:S^1 \to A} C(z)
              such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo ,
                      %mi λ
                      %mi i
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mi i
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                      %mo .
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K_A(t, \lambda i:S^1.x) \equiv t(x):C(\lambda i:S^1.x)
          %p
          .proof
            %h6 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_A(t)
              is defined to be
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi λ
                    %mi p
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %mi A
                    %mo .
                    %mi t
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} const
                      %mrow
                        %mi A
                        %mo ,
                        %msup
                          %mi S
                          %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_A(t) \equiv \lambda p:S^1 \to A.t(\mathrm{const}_{A, S^1}^{-1}(p))
            %p
              and by the computation rules of loop types as negative copies, one has that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} const
                      %mrow
                        %mi A
                        %mo ,
                        %msup
                          %mi S
                          %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathrm{const}_{A, S^1}^{-1}(\lambda i:\mathbb{I}.x) \equiv x
            %p
              and so by definition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ind
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo →
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{S^1 \to A}(t)
              and the judgmental congruence rules for substitution, one has
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi λ
                    %mi i
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi t
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} const
                      %mrow
                        %mi A
                        %mo ,
                        %msup
                          %mi S
                          %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_A(t, \lambda i:S^1.x) \equiv t(\mathrm{const}_{A, S^1}^{-1}(\lambda i:S^1.x)) \equiv t(x)
            %p
          %p
          .num_theorem
            %h6 Theorem
            %p
              Suppose that for all types
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} S^1 \to A
              is a
              %a.existingWikiWord{:href => "/nlab/show/positive+copy"} positive copy
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              through the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} const
                      %mrow
                        %mi A
                        %mo ,
                        %msup
                          %mi S
                          %mn 1
                    %mo ≡
                    %mi λ
                    %mi x
                    %mo :
                    %mi A
                    %mo .
                    %mi λ
                    %mi i
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo .
                    %mi x
                    %mo :
                    %mi A
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{const}_{A, S^1} \equiv \lambda x:A.\lambda i:S^1.x:A \to (S^1 \to A)
            %p
              Then Streicher’s axiom K is true: given a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and given a type family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(x, P)
              indexed by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi X
                    %annotation{:encoding => "application/x-tex"} p:x =_A X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo :
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %msub
                        %mi{:mathvariant => "normal"} refl
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t:\prod_{x:A} C(x, \mathrm{refl}_A(x))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi p
                        %mo :
                        %mi x
                        %msub
                          %mo =
                          %mi A
                        %mi X
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_A(t):\prod_{x:A} \prod_{p:x =_A X} C(x, p)
            %p
              such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi x
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_A(t, x, \mathrm{refl}_A(x)) \equiv t(x)
            %p
          %p
          .proof
            %h6 Proof
            %p
              By the induction principle of
              %a.existingWikiWord{:href => "/nlab/show/positive+copies"} positive copies
              on the type family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} base
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mi f
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} loop
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(f(\mathrm{base}), \mathrm{ap}_f(\mathrm{loop}))
              indexed by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} f:S^1 \to A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi K
                      %mi A
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi f
                        %mo :
                        %mi 𝕀
                        %mo →
                        %mi A
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} base
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mi f
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} loop
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_A^{\prime}(t):\prod_{f:\mathbb{I} \to A} C(f(\mathrm{base}), \mathrm{ap}_f(\mathrm{loop}))
            %p
              such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi K
                      %mi A
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi λ
                    %mi i
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_A^{\prime}(t, \lambda i:S^1.x) \equiv t(x):C(x, \mathrm{refl}_A(x))
            %p since by definition of constant function and reflexivity, one has
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} base
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "1em"}
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %mi λ
                        %mi i
                        %mo :
                        %mi 𝕀
                        %mo .
                        %mi x
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} loop
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\lambda i:\mathbb{I}.x)(\mathrm{base}) \equiv x \quad \mathrm{ap}_{\lambda i:\mathbb{I}.x}(\mathrm{loop}) \equiv \mathrm{refl}_A(x)
            %p We define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi x
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msubsup
                      %mi K
                      %mi A
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_A(t, x, p) \equiv K_A^{\prime}(t, \mathrm{rec}_{S^1}^A(x, p))
            %p
              since by circle recursion one has a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{S^1}^A(x, p):S^1 \to A
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} base
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "1em"}
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msubsup
                          %mi{:mathvariant => "normal"} rec
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} base
                    %mo ,
                    %mi{:mathvariant => "normal"} base
                    %mo ,
                    %mi{:mathvariant => "normal"} loop
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{S^1}^{A}(x, p)(\mathrm{base}) \equiv x \quad \mathrm{ap}_{\mathrm{rec}_{S^1}^{A}(x, p)}(\mathrm{base}, \mathrm{base}, \mathrm{loop}) \equiv p
            %p
          %p One has the following analogies between localization at a specific type and the type theoretic letter rule that it proves:
          %table
            %thead
              %tr
                %th localization rule
                %th type theoretic letter rule
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/I-localization"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi 𝕀
                        %annotation{:encoding => "application/x-tex"} \mathbb{I}
                    \-localization
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/J-rule"} J-rule
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/S1-localization"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} S^1
                    \-localization
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/K-rule"} K-rule
          %h3#computational_behavior Computational behavior
          %p
            Unlike its logical equivalent
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+UIP"} axiom UIP
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi x
                  %mo ,
                  %mi P
                  %mo ,
                  %mi d
                  %mo ,
                  %msub
                    %mi refl
                    %mi A
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(A,x,P,d,refl_A x)
            computes to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
          %p
            This sort of computational axiom K can also be implemented with, and is sufficient to imply, a general scheme of function definition by pattern-matching. This is implemented in the proof assistant
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Agda"} Agda
            %code --without-K
            alters Agda’s pattern-matching scheme to a weaker version appropriate for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/intensional+type+theory"} intensional type theory
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/axiom+UIP"} axiom UIP
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+S1-localization"}
                  axiom of
                  = succeed "-localization" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} S^1
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J-rule"}> J-rule
                ,
                %a.existingWikiWord{:href => "/nlab/show/interval+type+localization"} interval type localization
          %h2#references References
          %p The axiom K was introduced in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"}> Thomas Streicher
              ,
              %em Investigations into intensional type theory
              Habilitation thesis (1993) (
              %a{:href => "http://www.mathematik.tu-darmstadt.de/~streicher/HabilStreicher.pdf"}> pdf
              )
          %p
            For a review and discussion of the implementation in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
          %ul
            %li
              Pierre Corbineau,
              %em The K axiom in Coq (almost) for free
              (
              %a{:href => "http://coq.inria.fr/files/adt-2fev10-corbineau.pdf"}> pdf
              )
          %p
            Discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Univalent+Foundations+Project"}> Univalent Foundations Project
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Homotopy+Type+Theory+--+Univalent+Foundations+of+Mathematics"} Homotopy Type Theory – Univalent Foundations of Mathematics
          %p around theorem 7.2.1
