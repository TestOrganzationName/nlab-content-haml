                  %a{:href => "https://easychair.org/smart-program/VSL2014/APPA-invited-slides-6.pdf"} pdf slides
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
