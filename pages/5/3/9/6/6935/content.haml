                  = succeed "," do
                    %a{:href => "https://doi.org/10.1007/BF01211308"} doi:10.1007/BF01211308
                  %a{:href => "http://www.cse.chalmers.se/~peterd/papers/Inductive_Families.pdf"} pdf
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
