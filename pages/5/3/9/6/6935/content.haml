              by definition of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mn 0
                    %mo ×
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_1 \to X_0 \times X_0
              is a
              %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
              (
              %a.existingWikiWord{:href => "/nlab/show/display+map"}> display map
              ) by the interpretation rule for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dependent+types"} dependent types
            %p This morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi σ
                        %mo{:stretchy => "false"} ^
                      %mn 0
                    %mo :
                    %msubsup
                      %mi X
                      %mn 0
                      %mi I
                    %mo →
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\hat \sigma_0 : X_0^I \to X_1
            %p
              lifts paths/
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              that exist in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
              to the morphisms exhibited by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X_1
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/internal+category+in+an+%28infinity%2C1%29-category"} internal category in an (infinity,1)-category
            %p
              Suppose this exists, then there will be a notion of
              %em equivalences
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X_1
              %a.existingWikiWord{:href => "/nlab/show/core"} core
              inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi X
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Core(X_1) \hookrightarrow X_1
                    \\,.
            %p
              In this case the
              %a.existingWikiWord{:href => "/nlab/show/complete+Segal+space"} Segal-completeness condition
              in degree 1 says that the path recursion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi σ
                        %mo{:stretchy => "false"} ^
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \hat \sigma_0
              exhibits this inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi σ
                        %mo{:stretchy => "false"} ^
                      %mn 0
                    %mo :
                    %msubsup
                      %mi X
                      %mn 0
                      %mi I
                    %mo ≃
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi X
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hat \sigma_0 : X_0^I \simeq Core(X_1) \to X_1
                    \\,.
            %p
              In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              is the classifier of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/univalence"}> univalence
                  \-condition
