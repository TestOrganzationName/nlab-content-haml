                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
            %p reviewed in
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Zhaohui+Luo"}> Zhaohui Luo
                  , §9.2.2 in:
                  = succeed "," do
                    %em Computation and Reasoning – A Type Theory for Computer Science
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  = succeed "," do
                    %a{:href => "https://global.oup.com/academic/product/computation-and-reasoning-9780198538356"} ISBN:9780198538356
                  %a{:href => "https://www.researchgate.net/profile/Zhaohui-Luo-4/publication/243770570_Computation_and_Reasoning_A_Type_Theory_for_Computer_Science/links/54d0dc6b0cf29ca81103f26a/Computation-and-Reasoning-A-Type-Theory-for-Computer-Science.pdf"} pdf
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Christine+Paulin-Mohring"}> Christine Paulin-Mohring
                  , §2.2. in:
                  = succeed "," do
                    %em Introduction to the Calculus of Inductive Constructions
                  %em Vienna Summer of Logic
                  (2014)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
