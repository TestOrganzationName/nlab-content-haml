                %a{:href => "http://arxiv.org/abs/1110.4850"}> arXiv:1110.4850
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/JHEP01(2012)099"} doi:10.1007/JHEP01(2012)099
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Basile"}> Thomas Basile
