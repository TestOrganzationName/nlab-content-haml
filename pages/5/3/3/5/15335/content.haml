                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                  %mi 𝒰
                  %mo :
                  %mi 𝒰
                  %mo ∈
                  %mi Φ
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mu_X(\Phi) = \bigcup \{\bigcap \mathcal{U}: \mathcal{U} \in \Phi\}.
          .proof
            %h6#proof Proof
