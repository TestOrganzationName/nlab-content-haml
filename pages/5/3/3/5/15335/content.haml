                      %msub
                        %mi μ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi Φ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \bigcup \{\bigcap \mathcal{U}: \mathcal{U} \in \Phi\} \subseteq \mu_X(\Phi)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mo{:stretchy => "false"} {
