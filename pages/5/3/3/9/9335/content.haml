                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} Y=\emptyset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is given by the pair
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
