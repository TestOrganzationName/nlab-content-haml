          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              %strong> Segal’s category
              , denoted by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
              of the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi FinSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} FinSet^{*/}
              of
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Γ
                      %mi op
                    %mo ≃
                    %msup
                      %mi FinSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \Gamma^{op} \simeq FinSet^{*/}.
            %p
              Equivalently,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is the category
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              to the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FinSetPart
                  %annotation{:encoding => "application/x-tex"} FinSetPart
              of finite sets and partially defined maps. Objects are finite sets. Morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\to B
              are pairs
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ′
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A',f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ′
                    %mo ⊂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A'\subset A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ′
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f\colon A'\to B
              is a map of sets. Identity morphisms are specified by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi id
                        %mi A
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %msub
                        %mi id
                        %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} id_A=(A,id_A)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ′
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                    %mo ,
                    %mspace{:width => "2em"}
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ′
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi C
                    %mo ,
                    %mspace{:width => "2em"}
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ′
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ′
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ′
                    %mo ∩
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi B
                    %mo ′
                    %mo ,
                    %mi g
                    %mo ∘
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mi A
                        %mo ′
                        %mo ∩
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mi B
                        %mo ′
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} (A',f)\colon A\to B,\qquad (B',g)\colon B\to C,\qquad(B',g)\circ(A',f)=(A'\cap f^{-1}B',g\circ f|_{A'\cap f^{-1}B'}).
            %p
              Equivalently (
              %a{:href => "#Segal"}> Segal, Definition 1.1
              ),
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              admits the following covariant description. Objects are finite sets. Morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\to B
              are maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f\colon A\to P(B)
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %mo ≠
                    %msub
                      %mi a
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} a_1\ne a_2
              implies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∩
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} f(a_1)\cap f(a_2)=\emptyset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} id_A(a)=\{a\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "2em"}
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ∘
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mrow
                        %mi b
                        %mo ∈
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} f\colon A\to P(B),\qquad g\colon B\to P(C),\qquad (g\circ f)(a)=\bigcup_{b\in f(a)}g(b).
          .num_remark
            %h6#remark Remark
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is related to
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-operads"} (infinity,1)-operads
              in a way similar to how the
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              (non-empty and
              %em linearly ordered
              finite sets) is related to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
          .num_remark
            %h6#remark_2 Remark
            %p
              The categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FinSetPart
                  %annotation{:encoding => "application/x-tex"} FinSetPart
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi FinSet
                      %mo *
                  %annotation{:encoding => "application/x-tex"} FinSet_*
              are
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              via the following pair of functors. The functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FinSetPart
                    %mo →
                    %msub
                      %mi FinSet
                      %mo *
                  %annotation{:encoding => "application/x-tex"} FinSetPart\to FinSet_*
            %p sends
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %mi A
                    %mo ⊔
                    %mo{:stretchy => "false"} {
                    %mo *
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mspace{:width => "2em"}
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ′
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ⊔
                    %mo{:stretchy => "false"} {
                    %mo *
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mi B
                    %mo ⊔
                    %mo{:stretchy => "false"} {
                    %mo *
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi g
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mi A
                        %mo ′
                    %mo =
                    %mi f
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi g
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mover
                          %mi A
                          %mo{:stretchy => "false"} ¯
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo *
                    %mo .
                  %annotation{:encoding => "application/x-tex"} A\mapsto A\sqcup\{*\},\qquad ((A',f)\colon A\to B)\mapsto(g\colon A\sqcup\{*\}\to B\sqcup\{*\}),\qquad g|_{A'}=f,\qquad g|_{\bar A'}(x)=*.
            %p The functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi FinSet
                      %mo *
                    %mo →
                    %mi FinSetPart
                  %annotation{:encoding => "application/x-tex"} FinSet_* \to FinSetPart
            %p sends
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %mi A
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mo *
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mspace{:width => "2em"}
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mo *
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi g
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mi A
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %mo *
                        %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} A\mapsto A\setminus\{*\},\qquad (g\colon A\to B)\mapsto(g^{-1}(B\setminus\{*\}),g|_{A\setminus\{*\}}).
          %h2#comparison_to_the_simplex_category Comparison to the simplex category
          %p
            Recall the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
          %p The comparison functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Δ
                  %mo →
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \iota\colon\Delta\to\Gamma
          %p can be defined concisely via its opposite functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ι
                    %mi op
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Δ
                    %mi op
                  %mo →
                  %msub
                    %mi FinSet
                    %mo *
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \iota^{op}\colon\Delta^{op}\to FinSet_*,
          %p
            given by pointed simplicial set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mn 1
                    %mo{:stretchy => "false"} /
                    %mo ∂
                    %msup
                      %mi Δ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta^1/\partial\Delta^1
          %p We can unfold this concise description as follows. Set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo &lt;
                  %mi ⋯
                  %mo &lt;
                  %mi m
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} [m]=\{0\lt\cdots\lt m\}.
          %p
            Interpreting a simplex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} A\in\Delta
            as a (posetal) category, a
            %strong spine edge
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a morphism in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            that is not an identity morphism and cannot be decomposed as the composition of two nonidentity morphisms. That is to say, in a standard simplex
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [m]
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo −
                    %mn 1
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i-1,i)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo &lt;
                    %mi i
                    %mo ≤
                    %mi m
                  %annotation{:encoding => "application/x-tex"} 0\lt i\le m
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi i
                  %annotation{:encoding => "application/x-tex"} (i-1)\to i
          %p The canonical functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Δ
                  %mo →
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \iota\colon\Delta\to\Gamma
          %p sends a simplex to its set of spine edges:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo &lt;
                  %mn 1
                  %mo &lt;
                  %mn 2
                  %mo &lt;
                  %mi ⋯
                  %mo &lt;
                  %mi m
                  %mo{:stretchy => "false"} }
                  %mo ↦
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi …
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo −
                  %mn 1
                  %mo ,
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mi ι
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                  %mo .
                %annotation{:encoding => "application/x-tex"} [m]=\{0\lt1\lt2\lt\cdots\lt m\}\mapsto \{(0,1),(1,2),\ldots,(m-1,m)\}=\iota[m].
          %p
            To define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                %annotation{:encoding => "application/x-tex"} \iota
            on morphisms, observe that a morphism of simplices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} f\colon[m]\to[n]
            can be interpreted as a functor between posetal categories. This functor sends a spine edge in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [m]
            to the composition of a set of spine edges in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            sends a spine edge
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo −
                  %mn 1
                  %mo →
                  %mi i
                %annotation{:encoding => "application/x-tex"} i-1\to i
            to the composition of spine edges
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mn 1
                  %mo →
                  %mi ⋯
                  %mo →
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mn 1
                  %mo →
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} f(i-1)\to f(i-1)+1\to \cdots \to f(i)-1\to f(i).
          %p
            Using Segal’s covariant description of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ι
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi ι
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \iota(f)\colon\iota[m]\to\iota[n]
            by sending a spine edge
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [m]
            to the set of spine edges in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            whose composition yields the image of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            under the functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f\colon[m]\to [n]
          %p
            In terms of the category FinSetPart, we can describe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \iota(f)
            as a partial map of finite sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi ι
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \iota[n]\to\iota[m]
            that sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo −
                  %mn 1
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi ι
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} (j-1,j)\in\iota[n]
            to the unique pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo −
                  %mn 1
                  %mo ,
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi ι
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} (i-1,i)\in\iota[m]
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi j
                    %mo ≤
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(i-1)\lt j\le f(i)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \iota(f)
            is undefined on
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo −
                    %mn 1
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (j-1,j)
          %h2#alternative_description_of_the_comparison_functor Alternative description of the comparison functor
          %p
            Given that the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            can be used to encode homotopy coherent associative monoids in the same manner that the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            can be used to encode homotopy coherent commutative monoids, it is natural to wonder why the description of the comparison functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Δ
                  %mo →
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \iota\colon \Delta\to\Gamma
            appears to be so asymmetric. The primary reason for this asymmetry is that the traditional description of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            relies on the fact that elements are composed in a prescribed order, just like morphisms in a category. This enables us to define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            as a full subcategory of the category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
          %p
            However, it is possible to give an alternative definition of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
