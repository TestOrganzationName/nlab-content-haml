                      %mo ⊔
                      %mi B
                  %mo →
                  %msub
                    %mi X
                    %mi A
                  %mo ×
                  %msub
                    %mi X
                    %mi B
                %annotation{:encoding => "application/x-tex"} X_{A\sqcup B}\to X_A\times X_B
          %p induced by the morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %msub
                    %mi id
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo ⊔
                  %mi B
                  %mo →
                  %mi A
                  %mo ,
                  %mspace{:width => "2em"}
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %msub
                    %mi id
                    %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo ⊔
                  %mi B
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} (A,id_A)\colon A\sqcup B\to A, \qquad (B,id_B)\colon A\sqcup B\to B
          %p
            is an equivalence, as is the map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
