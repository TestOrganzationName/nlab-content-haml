                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
                = succeed "\u201D" do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial
                = succeed "-theory," do
                  %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi Ho
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi PresCat
                        %mrow
                          %mo{:stretchy => "false"} (
