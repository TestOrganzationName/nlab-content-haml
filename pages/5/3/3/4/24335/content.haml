          %h3#category_theoretic_approaches Category theoretic approaches
          %ul
            %li
              %p
                Following
                %a{:href => "#Joyal08"} Joyal 2008
                = succeed "," do
                  %a{:href => "https://ncatlab.org/nlab/files/JoyalTheoryOfQuasiCategories.pdf#page=10"} p. 158
                %a{:href => "#RiehlVerity13"} Riehl &amp; Verity 2013
                observe that the
                %a.existingWikiWord{:href => "/nlab/show/homotopy+2-category"}
                  homotopy 2-category of
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi Ho
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi Cat
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} 2Ho\big( Cat_{(\infty,1)}\big)
                retains much of the interesting structure of the
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,2)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Cat
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cat_{(\infty,1)}
                %a.existingWikiWord{:href => "/nlab/show/formal+category+theory"} formal category theory
                to study certain aspects of the formal theory of
                = succeed "-categories." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28infinity%2C1%29-functors"}
                  adjoint
                  = succeed "-functors" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                (which are automatically homotopy coherent), but not the theory of
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-monads"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
                  \-monads
                (which are not). This is developed in
                %a.existingWikiWord{:href => "/nlab/show/Elements+of+%E2%88%9E-Category+Theory"} Elements of ∞-Category Theory
                in the setting of a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/virtual+equipment"} virtual equipment
            %li
              %p
                For
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-categories"}
                    presentable
                    = succeed "-categories" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\infty,1)
                = succeed "-category" do
