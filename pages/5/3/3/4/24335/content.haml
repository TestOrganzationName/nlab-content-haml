            %li
              %p
                There is also the approach by
                = succeed "." do
                  %a{:href => "#CCNW"} Cisinski et al
          %h3#type_theoretic_approaches Type theoretic approaches
          %p
            The type theoretic approaches attempt to formalise the
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
            of a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"}
              cohesive
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            or
            %a.existingWikiWord{:href => "/nlab/show/local+%28infinity%2C1%29-topos"}
              local
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi{:mathvariant => "normal"} Grpd
                  %annotation{:encoding => "application/x-tex"} \infty\mathrm{Grpd}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} Cat
                  %mo ↪
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} (\infty,1)\mathrm{Cat} \hookrightarrow \mathbf{H}
            is a
            = succeed "-subcategory" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %ul
            %li
              %p
                %a{:href => "#RiehlShulman17"} Riehl &amp; Shulman 2017
                propose a type theory called
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+type+theory"} simplicial type theory
                %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
                in
                %a.existingWikiWord{:href => "/nlab/show/simplicial+infinity-groupoids"} simplicial infinity-groupoids
                or
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/bisimplicial+sets"} bisimplicial sets
                = succeed "." do
                  %a{:href => "#BuchholtzWeinberger21"} Buchholtz &amp; Weinberger 2021
            %li
              %p
                %a{:href => "#GWB24"} Gratzer, Weinberger &amp; Buchholtz 2024
                propose a modification of simplicial type theory called
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/triangulated+type+theory"} triangulated type theory
                %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
                in
                %a.existingWikiWord{:href => "/nlab/show/cubical+infinity-groupoids"} cubical infinity-groupoids
                or
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cubical-simplicial+sets"} cubical-simplicial sets
            %li
              %p
                %a{:href => "#WeaverLicata20"} Weaver &amp; Licata 2020
                propose a type theory, which has semantics in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/bicubical+sets"} bicubical sets
            %li
              %p
                %a{:href => "#KS23"} Kolomatskaia &amp; Shulman 2023
                propose a type theory called
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/displayed+type+theory"} displayed type theory
                %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
                in
                %a.existingWikiWord{:href => "/nlab/show/augmented+simplicial+set"} augmented
                %a.existingWikiWord{:href => "/nlab/show/semi-simplicial+object"} semi-simplicial
                = succeed "-groupoids." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
