                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ≃
                      %mspace{:width => "thinmathspace"}
                    %annotation{:encoding => "application/x-tex"} 2Ho\big( PresCat_{(\infty,1)}\big) \,\simeq\,
                %a.existingWikiWord{:href => "/nlab/show/2Ho%28CombModCat%29"} 2Ho(CombModCat)
                (
                %a{:href => "HoCombModCat#Pavlov21"}> Pavlov 2021
                ).
            %li
              %p
                %a{:href => "#Ruit23"} Ruit 2023
                has introduced an
                = succeed "-double" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
