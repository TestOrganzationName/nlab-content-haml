          %h2#de_rham_coefficients De Rham coefficients
          %h3#model_layer Model Layer
          %h4#liealgebra_valued_differential_1forms Lie-algebra valued differential 1-forms
          #SheafOfLieAlgebraValuedForms.num_defn
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+1-forms"} Lie algebra valued differential 1-forms
              is the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %mi 𝔤
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^1(U,\mathfrak{g}) = \Omega^1(U) \otimes_{\mathbb{R}} \mathfrak{g}
                    \\,.
            %p flat forms:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mi ω
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi F
                        %mi ω
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mi ω
                      %mo +
                      %mo{:stretchy => "false"} [
                      %mi ω
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^1_{flat}(U, \mathfrak{g}) =
                    \\left\{
                    \\omega \in \Omega^1(U,\mathfrak{g}) |
                    F_\omega = \mathbf{d} \omega + [\omega, \omega] = 0
                    \\right\}
                    
                    \\,.
          %p (…)
          %p
            This is a
            %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi flat
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Smooth
                  %mn 0
                  %mi Type
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^1_{flat}(-,\mathfrak{g}) \in Smooth 0 Type
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo =
                  %mi Lie
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{g} = Lie(\mathbb{R})
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi Lie
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi Ω
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^1(-,Lie(\mathbb{R})) = \Omega^1
          %p and we write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi flat
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi Lie
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msubsup
                    %mi Ω
                    %mi cl
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^1_{flat}(-,Lie(\mathbb{R})) = \Omega^1_{cl}
          %p Below we see
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ♭
                    %mi dR
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ≃
                  %msubsup
                    %mi Ω
                    %mi flat
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\flat_{dR}\mathbf{B}G \simeq \Omega^1_{flat}(-,\mathfrak{g})
          %h4#the_de_rham_complex The de Rham complex
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
          %p Below we see that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi ℝ
                  %mo ≃
                  %msub
                    %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi DK
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                  %mi ⋯
                  %mover
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                  %msubsup
                    %mi Ω
                    %mi cl
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\flat_{dR}\mathbf{B}^n \mathbb{R}
                  \\simeq
                  \\flat_{dR}\mathbf{B}^n U(1)
                  \\simeq
                  DK[ \Omega^1(-) \stackrel{\mathbf{d}}{\to} \Omega^2(-) \stackrel{\mathbf{d}}{\to}\cdots \stackrel{\mathbf{d}}{\to} \Omega^n_{cl}(-)]
                  \\,.
