              by Zariski-open immersions of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/affine+scheme"} affine scheme
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
