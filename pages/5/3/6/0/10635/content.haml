              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/integrable+function"} integrable
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/almost+everywhere"} almost everywhere
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lebesgue+integral"} Lebesgue integral
            %li
              In pointwise
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
