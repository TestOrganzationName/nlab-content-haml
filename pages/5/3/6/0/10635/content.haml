              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/integration+axiom"} integration axiom
          %p One may rephrase the first part in various ways as follows. First, simply incorporating the definitions of ‘indefinite integral’ and ‘antiderivative’, we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi{:mathvariant => "normal"} d
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi x
                  %mrow
                    %mo (
                    %msubsup
                      %mo ∫
                      %mi a
                      %mi x
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi t
                    %mo +
                    %mi C
                    %mo )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \frac{\mathrm{d}}{\mathrm{d}x} \left(\int_a^x f(t) \,\mathrm{d}t + C\right) = f(x) .
          %p Taking for granted that adding a constant to a function leaves its derivative unchanged, this simplifies to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi{:mathvariant => "normal"} d
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi x
                  %mrow
                    %mo (
                    %msubsup
                      %mo ∫
                      %mi a
                      %mi x
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi t
                    %mo )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \frac{\mathrm{d}}{\mathrm{d}x} \left(\int_a^x f(t) \,\mathrm{d}t\right) = f(x) .
          %p
            When combined with the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi{:mathvariant => "normal"} d
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi x
                  %mrow
                    %mo (
                    %msubsup
                      %mo ∫
                      %mi a
                      %mrow
                        %mi q
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi t
                    %mo )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mi q
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \frac{\mathrm{d}}{\mathrm{d}x} \left(\int_a^{q(x)} f(t) \,\mathrm{d}t\right) = f(q(x)) q'(x).
          %p
            Taking for granted that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mi u
                      %mi v
                    %mo =
                    %msubsup
                      %mo ∫
                      %mi a
                      %mi v
                    %mo −
                    %msubsup
                      %mo ∫
                      %mi a
                      %mi u
                  %annotation{:encoding => "application/x-tex"} \int_u^v = \int_a^v - \int_a^u
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi{:mathvariant => "normal"} d
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi x
                  %mrow
                    %mo (
                    %msubsup
                      %mo ∫
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi q
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi t
                    %mo )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mi q
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mi p
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \frac{\mathrm{d}}{\mathrm{d}x} \left(\int_{p(x)}^{q(x)} f(t) \,\mathrm{d}t\right) = f(q(x)) q'(x) - f(p(x)) p'(x).
          %p
            Writing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p(x)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} q(x)
            and multiplying both sides by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}x
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mrow
                    %mo (
                    %msubsup
                      %mo ∫
                      %mi u
                      %mi v
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi t
                    %mo )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi v
                  %mo −
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi u
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathrm{d}\left(\int_u^v f(t) \,\mathrm{d}t\right) = f(v) \,\mathrm{d}v - f(u) \,\mathrm{d}u .
          %p
            In other words, the differential and definite integral operators cancel upon performing the
            %a.existingWikiWord{:href => "/nlab/show/substitution"} substitution
            directed by the limits of the definite integral.
          %p One may rephrase the second part in various ways as follows. First, simply incorporating the definitions of ‘indefinite integral’ and ‘antiderivative’, we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo ∫
                    %mi a
                    %mi x
                  %mi F
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi t
                  %mo +
                  %mi C
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int_a^x F'(t) \,\mathrm{d}t + C = F(x)
          %p
            for some constant
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mi a
                      %mi a
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \int_a^a = 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C = F(a)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msubsup
                    %mo ∫
                    %mi a
                    %mi x
                  %mi F
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi t
                  %mo .
                %annotation{:encoding => "application/x-tex"} F(x) = F(a) + \int_a^x F'(t) \,\mathrm{d}t .
          %p
            It is sufficient to consider the special case where
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} x = b
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo ∫
                    %mi a
                    %mi b
                  %mi F
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi t
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \int_a^b F'(t) \,\mathrm{d}t = F(b) - F(a) .
          %p This can also be written
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo ∫
                    %mi a
                    %mi b
                  %mi{:mathvariant => "normal"} d
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int_a^b \mathrm{d}F(t) = F(b) - F(a)
          %p to match the last version of the first part; again, the differential and definite integral operators cancel (but now in the opposite order) upon performing the substitution directed by the limits of the definite integral.
          %h2#proofs Proofs
          %p
            If convenient, one may prove the theorem first for the
            %a.existingWikiWord{:href => "/nlab/show/unit+interval"} unit interval
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0, 1]
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/affine+transformation"} affine transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [a, b]
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            are real numbers with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≤
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \leq b
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            and pointwise constructive mathematics, existence of definite integrals must be proved first; existence of indefinite integrals follows. We can then prove that every indefinite integral is an antiderivative by applying the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/mean+value+theorem"} mean value theorem
          %p
            In the locale-theoretic approach, we essentially
            %em define
            an antiderivative to be an indefinite integral. Formally, the data in a
            %a.existingWikiWord{:href => "/nlab/show/continuously+differentiable+map"} continuously differentiable map
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [a,b]
            consists of a
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
            (its derivative) and a real number (its value at
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
          %p
            Conversely, in synthetic differential geometry, we essentially define an indefinite integral to be an antiderivative. We must prove uniqueness of antiderivatives; but their existence is given by an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom"} axiom
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integration+axiom"} integration axiom
          %h2#integral_formula_for_antiderivative Integral formula for antiderivative
          %p In the literature, the first part of the FTC is sometimes stated as merely existence of an antiderivative. The purpose of this section is to show, independent of foundations, that the second part gives the integral formula for the antiderivative as an indefinite integral.
          .proof
            %h6#proof Proof
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0, 1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ′
                      %mo =
                      %mi f
                    %annotation{:encoding => "application/x-tex"} F' = f
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mo ∫
                        %mn 0
                        %mi x
                      %mi F
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi{:mathvariant => "normal"} d
                      %mi t
                      %mo =
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \int_0^x F'(t) \, {\mathrm{d}}t = F(x) - F(0)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mo ∫
                        %mn 0
                        %mi x
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi{:mathvariant => "normal"} d
                      %mi t
