                  %annotation{:encoding => "application/x-tex"} \Lambda^{n+1}[n] \to X
              from a
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
