              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
