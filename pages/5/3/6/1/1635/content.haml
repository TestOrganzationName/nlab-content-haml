                              %mi i
                              %mo =
                              %mi n
                              %mo −
                              %mn 1
                          %mtr
                            %mtd
                              %mi g
                            %mtd
                              %mi for
                              %mspace{:width => "thickmathspace"}
                              %mi i
                              %mo =
                              %mi n
                              %mo +
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    v_i
                    \\coloneqq
                    \\left\{
                    \\array{
                    s_0 \circ s_0 \circ \cdots \circ s_0 (x) &amp; for \; 0 \leq i \leq  n-2
                    \\\
                    f &amp; for \; i = n-1
