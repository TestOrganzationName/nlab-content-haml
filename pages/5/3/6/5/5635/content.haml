            %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
            in:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+B.+Givental"}> Alexander B. Givental
                ,
                %em Permutation-equivariant quantum K-theory
                \&amp;lbrack;
                %a{:href => "https://math.berkeley.edu/~giventh/perm/perm.html"}> webpage
                \&amp;rbrack;
              %p
                %em
                  I. Definitions. Elementary K-theory of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi ℳ
                            %mo ¯
                          %mrow
                            %mn 0
