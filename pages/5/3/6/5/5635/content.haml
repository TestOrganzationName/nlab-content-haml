                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi N
                        %mo −
                        %mn 1
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msub
                      %mi a
                      %mn 2
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi b
                      %mrow
                        %mn 2
                        %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi a
                      %mn 2
                      %mi N
                    %mo −
                    %msub
                      %mi b
                      %mrow
                        %mn 2
                        %mi N
                    %mo{:stretchy => "false"} )
