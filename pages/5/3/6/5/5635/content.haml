                = succeed "&rbrack;" do
                  %a{:href => "https://projecteuclid.org/journals/michigan-mathematical-journal/volume-48/issue-1/On-the-WDVV-equation-in-quantum-K-theory/10.1307/mmj/1030132720.full"} doi:10.1307/mmj/1030132720
            %li
