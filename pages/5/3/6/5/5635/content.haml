                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}P^1
                  \-sigma model
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+rings"} Pontrjagin rings
              (
              %a.existingWikiWord{:href => "/nlab/show/homology"}> homology
              \-
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebras"} Hopf algebras
              of
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/based+loop+spaces"} based loop spaces
            %p
