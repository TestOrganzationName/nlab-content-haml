                %a.existingWikiWord{:href => "/nlab/show/Shing-Tung+Yau"} Shing-Tung Yau
                (ed.)
                = succeed "," do
                  %em Essays on mirror manifolds
                = succeed "," do
                  %em Mirror Symmetry I
                %strong 9
                (1998) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9111017"}> arXiv:hep-th/9111017
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1090/amsip/009"} doi:10.1090/amsip/009
            %li#Witten90
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                , §3 in:
                = succeed "," do
                  %em Two-dimensional gravity and intersection theory on moduli space
                %strong 1
                (1990) 243-310 &amp;lbrack;
                %a{:href => "https://dx.doi.org/10.4310/SDG.1990.v1.n1.a5"}> doi:10.4310/SDG.1990.v1.n1.a5
                ,
                = succeed "," do
