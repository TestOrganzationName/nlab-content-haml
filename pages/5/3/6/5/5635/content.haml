                            %mi q
                        %annotation{:encoding => "application/x-tex"} D_q
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1508.06697"}> arXiv:1508.06697
                \&amp;rbrack;
              %p
                %em
                  V. Toric
                  = succeed "-hypergeometric" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi q
                        %annotation{:encoding => "application/x-tex"} q
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1509.03903"}> arXiv:1509.03903
                \&amp;rbrack;
              %p
