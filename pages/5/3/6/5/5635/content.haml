                        %msub
                          %mover
                            %mi ℳ
                            %mo ¯
                          %mrow
                            %mn 0
                            %mo ,
                            %mi n
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi S
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \overline{\mathcal{M}}_{0,n}/S_n
                  and adelic characterization
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1508.06697"}> arXiv:1508.06697
                \&amp;rbrack;
              %p
                %em
                  IV.
                  = succeed "-modules" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
