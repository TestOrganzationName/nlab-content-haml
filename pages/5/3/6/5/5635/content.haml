              %a.existingWikiWord{:href => "/nlab/show/target+spaces"} target spaces
              (such as the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/CP%5E1+sigma-model"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℂ
                        %msup
