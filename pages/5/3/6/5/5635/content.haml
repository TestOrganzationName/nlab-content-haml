                = succeed "&rbrack;" do
                  %a{:href => "https://www.semanticscholar.org/paper/Two-dimensional-gravity-and-intersection-theory-on-Witten/e5935bb91e79d8247468b19c310a201b8e41e808"} SemanticScholar
          %p motivated by
          %ul
