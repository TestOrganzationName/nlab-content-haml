              ,
              = succeed "," do
                %em Topological sigma models
              %strong 118
              3 (1988) 411-449 &amp;lbrack;
              %a{:href => "https://projecteuclid.org/journals/communications-in-mathematical-physics/volume-118/issue-3/Topological-sigma-models/cmp/1104162092.full"}> euclid:cmp/1104162092
              \&amp;rbrack;
          %p See also:
          %ul
