          %title Anyons in fractional quantum Hall systems
          %h3#AnyonsInTheQuantumHallEffectReferences Anyons in fractional quantum Hall systems
          %p
            References on
            = succeed "-excitations" do
              %a.existingWikiWord{:href => "/nlab/show/anyon"} anyon
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/braid+group+statistics"} braid group statistics
            %a.existingWikiWord{:href => "/nlab/show/quantum+Hall+effect"} quantum Hall effect
            (for more on the application to
            %a.existingWikiWord{:href => "/nlab/show/topological+quantum+computation"} topological quantum computation
            see the references
            = succeed "):" do
              %a{:href => "topological+quantum}computation#TopologicalQuantumComputationWithAnyons"} there
          %p
            The prediction of
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
            = succeed "-excitations" do
              %a.existingWikiWord{:href => "/nlab/show/anyon"} anyon
            %a.existingWikiWord{:href => "/nlab/show/quantum+Hall+effect"} quantum Hall effect
            (i.e. satisfying
            %a.existingWikiWord{:href => "/nlab/show/braid+group+statistics"} braid group statistics
            in 1-dimensional
            %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
            of the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/braid+group"} braid group
            %a.existingWikiWord{:href => "/nlab/show/Berry+phases"} Berry phases
            of
            %a.existingWikiWord{:href => "/nlab/show/Laughlin+wavefunctions"} Laughlin wavefunctions
            via the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+adiabatic+theorem"} quantum adiabatic theorem
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bertrand+I.+Halperin"}> Bertrand I. Halperin
                \:
                = succeed "," do
                  %em Statistics of Quasiparticles and the Hierarchy of Fractional Quantized Hall States
                %strong 52
                (1984) 1583 [
                %a{:href => "https://doi.org/10.1103/PhysRevLett.52.1583"}> doi:10.1103/PhysRevLett.52.1583
                ]
              %p
                Erratum, Phys. Rev. Lett.
                %strong 52
                (1984) 2390 [
                %a{:href => "https://doi.org/10.1103/PhysRevLett.52.2390.4"}> doi:10.1103/PhysRevLett.52.2390.4
                ]
            %li#ArovasSchriefferWilczek84
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+P.+Arovas"}> Daniel P. Arovas
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Robert+Schrieffer"} John Robert Schrieffer
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Frank+Wilczek"} Frank Wilczek
                = succeed "," do
                  %em Fractional Statistics and the Quantum Hall Effect
                %strong 53
                (1984) 722 [
                %a{:href => "https://doi.org/10.1103/PhysRevLett.53.722"}> doi:10.1103/PhysRevLett.53.722
                ]
              %blockquote
                %p
                  (for filling fraction
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ν
                          %mo =
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mi q
                        %annotation{:encoding => "application/x-tex"} \nu = 1/q
            %li#Su86
              %p
                W. P. Su:
                = succeed "," do
                  %em Statistics of the fractionally charged excitations in the quantum Hall effect
                %strong 34
                (1986) 1031 [
                %a{:href => "https://doi.org/10.1103/PhysRevB.34.1031"}> doi:10.1103/PhysRevB.34.1031
                ]
              %blockquote
                %p
                  (claim for general filling fraction
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ν
                          %mo =
                          %mi p
                          %mo{:stretchy => "false"} /
                          %mi q
                        %annotation{:encoding => "application/x-tex"} \nu = p/q
            %li#GoldhaberJain95
              %p
                A. S. Goldhaber,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Jainendra+K.+Jain"} Jainendra K. Jain
                = succeed "," do
                  %em Characterization of fractional-quantum-Hall-effect quasiparticles
                %strong 199
                3–4 (1995) 267-273 [
                %a{:href => "https://doi.org/10.1016/0375-9601(95)00101-8"}> doi:10.1016/0375-9601(95)00101-8
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/cond-mat/9501080"} arXiv:cond-mat/9501080
              %blockquote
                %p
                  (for Jain series fractions
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ν
                          %mo =
                          %mi n
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mi p
                          %mi n
                          %mo ±
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \nu = n/(2p n \pm 1)
            %li
              %p
                %a{:href => "#Jain07"} Jain 2007 §9.8
              %blockquote
                %p (review)
          %p
            The original discussion of
            %a.existingWikiWord{:href => "/nlab/show/non-abelian+group"} non-abelian
            = succeed "-excitations" do
              %a.existingWikiWord{:href => "/nlab/show/anyon"} anyon
            %a.existingWikiWord{:href => "/nlab/show/quantum+Hall+effect"} quantum Hall effect
            (i.e. satisfying
            %a.existingWikiWord{:href => "/nlab/show/braid+group+statistics"} braid group statistics
            in higher dimensional
            %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/braid+group"} braid group
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/modular+tensor+categories"} modular tensor categories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"}> Gregory Moore
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Nicholas+Read"} Nicholas Read
              = succeed "," do
                %em Nonabelions in the fractional quantum Hall effect
              = succeed "," do
                %a{:href => "http://www.physics.rutgers.edu/~gmoore/MooreReadNonabelions.pdf"} pdf
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/0550-3213(91)90407-O"} doi:10.1016/0550-3213(91)90407-O
          %p Review:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ady+Stern"}> Ady Stern
                ,
                = succeed "," do
                  %em Anyons and the quantum Hall effect – A pedagogical review
                %strong 323
                1 (2008) 204-249 [
                %a{:href => "https://doi.org/10.1016/j.aop.2007.10.008"}> doi:10.1016/j.aop.2007.10.008
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/0711.4697"} arXiv:0711.4697
            %li
              %p
                Menelaos Zikidis:
                = succeed "," do
                  %em Abelian Anyons and Fractional Quantum Hall Effect
                = succeed "," do
                  %a{:href => "https://www.mathi.uni-heidelberg.de/~walcher/teaching/sose17/atqft/writeups/Menelaos.pdf"} pdf
                = succeed "]" do
                  %a.existingWikiWord{:href => "/nlab/files/Zikidis-AbelianAnyons.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ady+Stern"}> Ady Stern
                \:
                = succeed "," do
                  %em Engineering Non-Abelian Quasi-Particles in Fractional Quantum Hall States – A Pedagogical Introduction
                = succeed "," do
                  %em Fractional Quantum Hall Effects
                = succeed "]" do
                  %a{:href => "https://doi.org/10.1142/9789811217494_0009"} doi:10.1142/9789811217494_0009
            %li
              %p
                D. E. Feldman,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Bertrand+Halperin"} Bertrand Halperin
                = succeed "," do
                  %em Fractional charge and fractional statistics in the quantum Hall effects
                %strong 84
                (2021) 076501 [
                %a{:href => "https://doi.org/10.1088/1361-6633/ac03aa"}> doi:10.1088/1361-6633/ac03aa
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/2102.08998"} arXiv:2102.08998
          %p#ReferencesFQHAsPotentialTQCHardware
            On (
            %a.existingWikiWord{:href => "/nlab/show/anyons"} anyons
            in)
            %a.existingWikiWord{:href => "/nlab/show/fractional+quantum+Hall+systems"} fractional quantum Hall systems
            as potential
            %a.existingWikiWord{:href => "/nlab/show/quantum+materials"} quantum hardware
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+quantum+computing"} topological quantum computing
          %ul
            %li
              %p
                D. V. Averin, V. J. Goldman:
                = succeed "," do
                  %em Quantum computation with quasiparticles of the fractional quantum Hall effect
                %strong 121
                1 (2001) 25-28 [
                %a{:href => "https://doi.org/10.1016/S0038-1098(01)00447-1"}> doi:10.1016/S0038-1098(01)00447-1
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/cond-mat/0110193"} arXiv:cond-mat/0110193
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sankar+Das+Sarma"}> Sankar Das Sarma
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Freedman"} Michael Freedman
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Chetan+Nayak"} Chetan Nayak
                = succeed "," do
                  %em Topologically-Protected Qubits from a Possible Non-Abelian Fractional Quantum Hall State
