                    %a{:href => "#definition"} Definition
                  %li
                    %a{:href => "#properties"} Properties
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            Given a finite dimensional (pseudo)-
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,g)
            %em Hodge star operator
            “completes” a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            to the
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,g)
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            be an
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "al" do
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            endowed with a (
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"}> pseudo
            )-
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \leq k \leq n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^k(X)
            for the
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} forms
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h3#hodge_inner_product Hodge inner product
          %p
            The metric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            naturally induces a nondegenerate symmetric
            %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ω
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi Ω
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Ω
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (-\mid-)
                  \\;\colon\;
                  \\Omega^k(X) \otimes \Omega^k(X)
                  \\to
                  \\Omega^0(X)
                  \\,.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            then the
            %a.existingWikiWord{:href => "/nlab/show/integral"} integral
            of this against the
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi vol
                    %mi g
                %annotation{:encoding => "application/x-tex"} vol_g
            exists. This is the
            %em Hodge inner product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ω
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi Ω
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\langle - , - \rangle
                  \\;\colon\;
                  \\Omega^k(X)\otimes \Omega^k(X)
                  \\to
                  \\mathbb{R}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi α
                  %mo ,
                  %mi β
                  %mo{:stretchy => "false"} ⟩
                  %mo :
                  %mo =
                  %mstyle{:displaystyle => "false"}
                    %mrow
                      %msub
                        %mo ∫
                        %mi X
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mi β
                    %mo{:stretchy => "false"} )
                    %mi vol
                    %mspace{:width => "thinmathspace"}
                    %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\langle \alpha, \beta \rangle
                  \:=
                  \\textstyle{\int_X} (\alpha\mid \beta) vol
                  \\,.
          %h3#hodge_star_operator Hodge star operator
          %p
            The
            %strong Hodge star operator
            is the unique
            %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Ω
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Ω
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  {\star}\colon \Omega^k (X) \to \Omega^{n-k} (X)
          %p defined by the identity
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ∧
                  %mo ⋆
                  %mi β
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi β
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi vol
                    %mi g
                  %mo ,
                  %mspace{:width => "2em"}
                  %mo ∀
                  %mi α
                  %mo ,
                  %mi β
                  %mo ∈
                  %mstyle{:displaystyle => "false"}
                    %mrow
                      %msup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                        %mi k
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\alpha \wedge \star\beta
                  \=
                  (\alpha \mid \beta) vol_g,
                  \\qquad
                  \\forall \alpha,\beta \in \textstyle{\bigwedge^k} X
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi vol
                    %mi g
                  %mo ∈
                  %msup
                    %mi Ω
                    %mi n
                  %mi X
                %annotation{:encoding => "application/x-tex"} vol_g \in \Omega^n X
            is the
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            induced by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          %p
            Therefore in terms of the Hodge operator the
            %a.existingWikiWord{:href => "/nlab/show/Hodge+inner+product"} Hodge inner product
            reads
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi α
                  %mo ,
                  %mi β
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mstyle{:displaystyle => "false"}
                    %mrow
                      %msub
                        %mo ∫
                        %mi X
                    %mi α
                    %mo ∧
                    %mo ⋆
                    %mi β
                    %mspace{:width => "thinmathspace"}
                    %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\langle \alpha , \beta\rangle
                  \=
                  \\textstyle{\int_X} \alpha \wedge \star \beta
                  \\,.
          %h3#generalizations Generalizations
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} metric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is used in two places in the specification of the Hodge operator: in the inner product on forms and in the volume form. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is equipped only with a
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            (not necessarily coming from a metric), then the Hodge operator still takes
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-k)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multivector+field"} vector fields
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/volume+pseudoform"} volume pseudoform
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-k)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pseudoforms"} pseudoforms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is equipped with only a volume pseudoform (which is equivalent to an
            %a.existingWikiWord{:href => "/nlab/show/absolutely+continuous+measure"} absolutely continuous
            %a.existingWikiWord{:href => "/nlab/show/Radon+measure"} Radon measure
            on
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-pseudovector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-k)
          %h2#properties Properties
          %h3#ComponentExpression Component expression
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a (
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"}> pseudo
            \-)
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subset X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msup
                    %mi e
                    %mi D
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  e^1, \dots, e^D
                  \\;\in\;
                  \\Omega^1(U)
          %p
            be a frame of
            %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
            (a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi x
                    %mi i
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x^i\}
            is a
            %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mi i
                  %mo ≔
                  %mi d
                  %msup
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"} e^i \coloneqq d x^i
            is such a frame.
          %p
            With this choice, any
            %a.existingWikiWord{:href => "/nlab/show/differential+p-form"} differential p-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ∈
                  %msup
                    %mi Ω
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha \in \Omega^p(U)
            has a component expansion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mn 1
                    %mrow
                      %mi p
                      %mo !
                  %msub
                    %mi α
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                      %mi …
                      %msub
                        %mi i
                        %mi p
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi e
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %msup
                    %mi e
                    %mrow
                      %msub
                        %mi i
                        %mi p
                %annotation{:encoding => "application/x-tex"}
                  \\alpha
                  \\;=\;
                  \\frac{1}{p!}
                  \\alpha_{i_1 \dots i_p}
                  \\, e^{i_1} \wedge \cdots \wedge e^{i_p}
          %p
            for
            = succeed "-components" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi α
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi i
                        %mi p
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\alpha_{i_1 \cdots i_p}\}
            (where here and in the following we use the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
          %p
            In terms of these components, the Hodge dual
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %mi α
                %annotation{:encoding => "application/x-tex"} \star \alpha
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is expressed by the following formula:
          #eq:ComponentFormulaForHodgeStar.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mo ⋆
                          %mi α
                        %mtd
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mfrac
                            %mn 1
                            %mrow
                              %mi p
                              %mo !
                              %mo{:stretchy => "false"} (
                              %mi D
                              %mo −
                              %mi p
                              %mo{:stretchy => "false"} )
                              %mo !
                          %msqrt
                            %mrow
                              %mo |
                              %mi det
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mo{:stretchy => "false"} (
                              %msub
