                [
                %a{:href => "https://strickland1.org/courses/bestiary/bestiary.pdf"}> pdf
                ,
                = succeed "]" do
                  %a.existingWikiWord{:href => "/nlab/files/Strickland-BestiaryTopological.pdf", :title => "pdf"} pdf
            %li#MimuraToda63
              %p
                M. Mimura and H. Toda,
                = succeed "," do
                  %em
                    Homotopy Groups of
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
