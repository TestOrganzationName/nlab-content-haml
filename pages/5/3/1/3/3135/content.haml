          %h2#definition Definition
          %p
            For a
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %strong unitary group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(n)
            is the
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            of
            %a.existingWikiWord{:href => "/nlab/show/isometry"} isometries
            of the
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ×
                  %mi n
                %annotation{:encoding => "application/x-tex"} n \times n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/unitary+matrices"} unitary matrices
          %p
            More generally, for a Hilbert space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                  %annotation{:encoding => "application/x-tex"} \mathcal{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi ℋ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(\mathcal{H})
            is the group of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/unitary+operator"} unitary operator
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/operator+topology"} strong operator topology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi ℋ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(\mathcal{H})
            are frequently considered for other purposes.
          %h2#properties Properties
          %p
            The unitary groups are naturally
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
            (infinite dimensional if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℋ
                %annotation{:encoding => "application/x-tex"} \mathcal{H}
            is infinite dimensional).
          #UnitaryGroupIsCompact.num_prop
            %h6#proposition Proposition
            %p
              The unitary group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(n)
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
          %h3#HomotopyGroups Homotopy groups
          #InclusionOfUnitaryGroupnIntoUnitaryGroupnPlusIneIsnMinus1Equivalence.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ,
                      %mi N
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n,N \in \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≤
                      %mi N
                    %annotation{:encoding => "application/x-tex"} n \leq N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    U(n) \hookrightarrow U(N)
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-equivalence"} 2n-equivalence
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              on
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              in degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &lt;
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \lt 2n
              and a
              %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 2n
          .proof
            %h6#proof Proof
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U(n)
                    \\longrightarrow
                    U(n+1)
                    \\longrightarrow
                    U(n+1)/U(n)
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#UnitaryGroupIsCompact"}
              and by
              = succeed "," do
                %a{:href => "coset#QuotientProjectionForCompactLieSubgroupIsPrincipal"} this corollary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(n+1)\to U(n+1)/U(n)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %a.maruku-ref{:href => "#nSphereAsUnitaryCosetSpace"}
              identifies the
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              with the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (2n+1)-sphere
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo ≃
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^{2n+1}\simeq U(n+1)/U(n)
                    \\,.
            %p
              Therefore the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              of the
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} U(n)\to U(n+1) \to S^{2n+1}
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    \\pi_{\bullet+1}(S^{2n+1})
                    \\longrightarrow
                    \\pi_\bullet(U(n))
                    \\longrightarrow
                    \\pi_\bullet(U(n+1))
                    \\longrightarrow
                    \\pi_\bullet(S^{2n+1})
                    \\to
                    \\cdots
            %p
              Since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mrow
                          %mo ≤
                          %mn 2
                          %mi n
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \pi_{\leq 2n}(S^{2n+1}) = 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mo &lt;
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi π
                      %mrow
                        %mo &lt;
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_{\lt 2n}(U(n))
                    \\overset{\simeq}{\longrightarrow}
                    \\pi_{\lt 2n}(U(n+1))
            %p is an isomorphism and that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_{2n}(U(n))
                    \\longrightarrow
                    \\pi_{2n}(U(n+1))
            %p
              is surjective. Hence now the statement follows by induction over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo −
                      %mi n
                    %annotation{:encoding => "application/x-tex"} N-n
          %p
            It follows that the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_k(U(n))
            are independent of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo &gt;
                  %mfrac
                    %mi k
                    %mn 2
                %annotation{:encoding => "application/x-tex"} n \gt \frac{k}{2}
            (the “stable range”). So if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U = \underset{\longrightarrow}{\lim}_n U(n)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_k(U(n)) = \pi_k(U)
            %a.existingWikiWord{:href => "/nlab/show/Bott+periodicity"} Bott periodicity
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mrow
                              %mn 2
                              %mi k
                              %mo +
                              %mn 0
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mrow
                              %mn 2
                              %mi k
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mi ℤ
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\pi_{2k+0}(U) &amp;= 0\\
                  \\pi_{2k+1}(U) &amp;= \mathbb{Z}.
                  }
          %p
            In the unstable range for low
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            they instead start out as follows
