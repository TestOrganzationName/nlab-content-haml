          %h2#definition Definition
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            (
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"}> homotopy type theory
            ), given a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and a
            %a.existingWikiWord{:href => "/nlab/show/type+family"} type family
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} type
                  %annotation{:encoding => "application/x-tex"} x\colon A \vdash B(x) \; \mathrm{type}
            %strong dependent anafunction
            is a type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo ,
                  %mi y
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} x\colon A, y\colon B(x) \vdash R(x, y) \; \mathrm{type}
            which comes with a family of witnesses
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo ⊢
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi{:mathvariant => "normal"} isContr
