                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x:A) \to B(x)
            for dependent function types rather than the dependent product type notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
