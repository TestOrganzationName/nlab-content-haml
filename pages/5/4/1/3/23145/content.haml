      }
          
      a.existingWikiWord[title]:visited {
      border: 0px;
      color: #551111;
      text-decoration: none;
      }
      
      a[href^="http://"] {
      border: 0px;
      color: #003399;
      }
      
      a[href^="http://"]:visited {
      border: 0px;
      color: #330066;
      }
      
      a[href^="https://"] {
      border: 0px;
