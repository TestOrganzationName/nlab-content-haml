                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo ≃
                    %msub
                      %mi L
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi D
                          %mi α
                        %mo{:stretchy => "false"} }
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %mover
                      %munder
                        %mo ↪
                        %mrow
                          %msub
                            %mi i
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi i
                            %mo *
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}
                    \\simeq
                    L_{\{D_\alpha\}} \mathbf{H}_{th}
                    \\stackrel{\overset{i^*}{\leftarrow}}{\underset{i_*}{\hookrightarrow}}
