          #ExhibitingInfinitesimalCohesion.num_defn
            %h6#definition_5 Definition
            %p
              A set of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi D
                      %mi α
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi α
                  %annotation{:encoding => "application/x-tex"} \{D_\alpha \in \mathbf{H}_{th}\}_\alpha
              is said to
              %strong exhibit the differential structure
              or
              %strong exhibit the infinitesimal thickening
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th}
              if the
              %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi D
                          %mi α
                        %mo{:stretchy => "false"} }
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %mover
                      %mo ↪
                      %mo ←
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"}
                    L_{\{D_\alpha\}} \mathbf{H}_{th}
                    \\stackrel{\leftarrow}{\hookrightarrow}
                    \\mathbf{H}_{th}
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th}
              at the morphisms of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi α
                    %mo ×
                    %mi X
                    %mo →
