          #LieDifferentiationInCohesion.num_defn
            %h6#definition_6 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lie
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo →
                    %msup
                      %mi FormalModuli
                      %mrow
                        %msubsup
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mi th
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                    %mo ↪
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Lie
                    \\;\colon\;
                    \\mathbf{H}_{th}^{\ast/}
                    \\to
                    FormalModuli^{\mathbf{H}_{th}^{*/}}
                    \\hookrightarrow
                    PSh_\infty(\mathbf{H}_{th}^{*/})
            %p
              for the Lie differentiaon
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              = succeed "," do
                %a.maruku-ref{:href => "#LieDifferentiationFunctor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
