                      %mi FormalModuli
                      %mrow
                        %msub
                          %mi Sp
                          %mo *
                  %annotation{:encoding => "application/x-tex"} FormalModuli^{Sp_*}
              may be computed in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi PSh
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Sp
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh_\infty(Sp_*)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
              %a.existingWikiWord{:href => "/nlab/show/derived+hom+space"} (∞,1)-hom (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sp
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sp_*(D,-)
              preserves
              = succeed "-limits." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
