          .proof
            %h6#proof_2 Proof
            %p
              The localizing objects are in particular themselves
              %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              so that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ʃ
                        %mi inf
                      %msub
                        %mi D
                        %mi α
                      %mo ≃
                      %mo *
                    %annotation{:encoding => "application/x-tex"} &amp;#643;_{inf} D_\alpha \simeq *
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Red
                      %mo ⊣
                      %msub
                        %mi ʃ
                        %mi inf
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Red \dashv &amp;#643;_{inf})
              %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
              this means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi th
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %msub
                              %mi D
                              %mi α
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi th
                            %mo{:stretchy => "false"} (
                            %mi Red
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi D
                              %mi α
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi th
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %msub
                              %mi ʃ
                              %mi inf
                            %msub
                              %mi D
                              %mi α
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi th
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %mo *
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{H}_{th}(*, D_\alpha)
                    \&amp; \simeq \mathbf{H}_{th}(Red(*), D_\alpha)
                    \\\
                    \&amp; \simeq \mathbf{H}_{th}(*, &amp;#643;_{inf} D_\alpha)
                    \\\
                    \&amp; \simeq \mathbf{H}_{th}(*, *)
                    \\\
                    \&amp; \simeq *
                    \\end{aligned}
                    \\,.
          %p
            We now consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
