                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th}
            be a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ʃ
                  %mo ⊣
                  %mo ♭
                  %mo ⊣
                  %mo ♯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (&amp;#643; \dashv \flat \dashv \sharp)
            equipped with
            %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
