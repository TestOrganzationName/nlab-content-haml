                  %mrow
                    %msup
                      %mi FormalModuli
                      %mrow
                        %msub
                          %mi Sp
                          %mo *
                  %annotation{:encoding => "application/x-tex"} FormalModuli^{Sp_*}
              of
              %a.existingWikiWord{:href => "/nlab/show/formal+moduli+problems"} formal moduli problems
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective sub-(∞,1)-category
              of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi FormalModuli
                      %mrow
                        %msub
                          %mi Sp
                          %mo *
                    %mover
                      %mo ↪
                      %mo ←
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Sp
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    FormalModuli^{Sp_*}
                    \\stackrel{\leftarrow}{\hookrightarrow}
                    PSh_{\infty}(Sp_*)
                    \\,.
          #LieDifferentiationFunctor.num_prop
            %h6#proposition_2 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/deformation+context"} deformation context
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sp
                        %mo *
                    %annotation{:encoding => "application/x-tex"} Sp_*
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
              gives an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lie
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Sp
