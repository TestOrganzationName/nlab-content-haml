                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} X \colon (Sp_*^{inf})^{op} \to \infty Grpd
              such that
            %ol
              %li
                %p
                  over the
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  they are
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
