                      %mrow
                        %msub
                          %mi Sp
                          %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Lie \;\colon\; Sp_* \to FormalModuli^{Sp_*}
                    \\,.
          .num_remark
            %h6#remark_3 Remark
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi Sp
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (X,x) \in Sp_*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lie
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Lie(X,x)
              represents the
              %em
                %a.existingWikiWord{:href => "/nlab/show/formal+geometry"} formal neighbourhood
              of the basepoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as seen by the infinitesimally thickened points dual to the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi E
                        %mi α
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{E_\alpha\}
            %p
              Hence we may call this the operation of
              %strong Lie differentiation
              of spaces in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sp
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Sp_*
              around their given base point.
            %p
              In the archetypical implementation of these axiomatics, discuss
              = succeed "," do
                %a{:href => "#Examples"} below
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
              of
              %a.existingWikiWord{:href => "/nlab/show/formal+moduli+problems"} formal moduli problems
              with
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
              and the Lie differentiation of the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %a.existingWikiWord{:href => "/nlab/show/moduli+%E2%88%9E-stack"} moduli ∞-stack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              of a
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-group"} smooth ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is its
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Lie
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} Lie(\mathbf{B}G) \simeq \mathbf{B}\mathfrak{g}
          #LieDifferentiationPreservesLimits.num_prop
            %h6#proposition_3 Proposition
            %p The Lie differentiation functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lie
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Sp
                      %mo *
                    %mo →
                    %msup
                      %mi FormalModuli
                      %mrow
                        %msub
                          %mi Sp
                          %mo *
                  %annotation{:encoding => "application/x-tex"}
                    Lie
                    \\;
                    \\colon
                    \\;
                    Sp_* \to FormalModuli^{Sp_*}
            %p
              of prop.
              %a.maruku-ref{:href => "#LieDifferentiationFunctor"}
              preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
          .proof
            %h6#proof Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#FormalModuliIsPresentableCategory"}
              the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
