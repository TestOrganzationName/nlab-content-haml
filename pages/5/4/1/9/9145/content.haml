              = succeed "," do
                %a{:href => "http://ncatlab.org/nlab/show/cohesive+%28infinity,1%29-topos+--+structures"} structures in cohesion – A1-homotopy and the continuum
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/A1-homotopy+theory"} A1-homotopy theory
          #ObjectsExhibitingDifferentialCohesionAreUniquelyPointed.num_prop
            %h6#proposition_4 Proposition
            %p
              If objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi D
                      %mi α
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi th
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{D_\alpha \in \mathbf{H}_{th}\}
              exhibit the differential cohesion of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi th
