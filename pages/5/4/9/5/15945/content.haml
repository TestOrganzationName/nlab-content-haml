                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/universal+constructions"} universal constructions
            such as of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            internally.
          %p
            Given the system of
            %a.existingWikiWord{:href => "/nlab/show/slice+categories"} slice categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            (or more generally any
            %a.existingWikiWord{:href => "/nlab/show/indexed+category"} indexed category
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↦
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi X
                  %annotation{:encoding => "application/x-tex"} X \mapsto \mathbf{H}_X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as the shape of a discrete
            %a.existingWikiWord{:href => "/nlab/show/internal+diagram"} internal diagram
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
            as discrete actual
            %a.existingWikiWord{:href => "/nlab/show/internal+diagrams"} internal diagrams
            of this shape.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            happens to have a (small)
            %a.existingWikiWord{:href => "/nlab/show/object+classifier"} object classifier
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi h
                  %annotation{:encoding => "application/x-tex"} \mathbf{h}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat F
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalent
            to morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi h
                  %annotation{:encoding => "application/x-tex"} F \colon X \to \mathbf{h}
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}\to \mathbf{H}
          %p
            Now if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            has good enough properties as a (self-)
            %a.existingWikiWord{:href => "/nlab/show/indexed+category"} indexed category
            in that it is a
            %a.existingWikiWord{:href => "/nlab/show/hyperdoctrine"} hyperdoctrine
            with
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi Y
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi X
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi Y
                %annotation{:encoding => "application/x-tex"} \underset{X \stackrel{f}{\to} Y}{\sum} \colon \mathbf{H}_{/X} \to \mathbf{H}_{/Y}
            and
            %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi Y
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi X
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi Y
                %annotation{:encoding => "application/x-tex"} \underset{X \stackrel{f}{\to} Y}{\prod} \colon \mathbf{H}_{/X} \to \mathbf{H}_{/Y}
            operations, then it makes sense to define the
            %em internal colimit
            of a discrete diagram as above as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mo ⟶
                  %mi F
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi X
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"}
                  \\underset{\longrightarrow}{\lim} F \coloneqq \underset{X}{\sum} \hat F
          %p
            and the
            %em internal limit
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mo ⟵
                  %mi F
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi X
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\underset{\longleftarrow}{\lim} F \coloneqq \underset{X}{\prod} \hat F
                  \\,.
          %p
            Of course with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            being, internally, a discrete diagram shape these are, so far, just internal
            %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            and internal
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/products"} products
          %p
            It is more or less straightforward to extend the above from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cat(\mathbf{H})
            %a.existingWikiWord{:href => "/nlab/show/internal+categories"} internal categories
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/internal+diagram"} internal diagram
            shape)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ∈
                  %mi Cat
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C \in Cat(\mathbf{H})
            the objects in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi C
                %annotation{:encoding => "application/x-tex"} Cat(\mathbf{H})_{/C}
            as not-necessarily discrete diagrams, and proceed as before. For various specific choices of context
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            = succeed "," do
              %a{:href => "#Johnstone"} Johnstone, below prop. B2.3.20
            = succeed "," do
              %a{:href => "#Pisani09"} Pisani 09, p.18, p. 23
            = succeed ")." do
              %a{:href => "#HoTTBook"} HoTTBook, section 6.12
          %p
            To see internally the expected
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the above definition, consider the
            %a.existingWikiWord{:href => "/nlab/show/internal+diagram"} internal
            = succeed "-diagram" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} A \in \mathbf{H}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo *
                    %mi A
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} X^\ast A \in \mathbf{H}_{/X}
            %a.existingWikiWord{:href => "/nlab/show/object+classifier"} object classifier
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi h
                %annotation{:encoding => "application/x-tex"} \mathbf{h}
            then this corresponds indeed to the
            %a.existingWikiWord{:href => "/nlab/show/constant+map"} constant map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo *
                    %mover
                      %mo →
                      %mrow
                        %mo ⊢
                        %mi A
                    %mstyle{:mathvariant => "bold"}
                      %mi h
                  %annotation{:encoding => "application/x-tex"} X \to \ast \stackrel{\vdash A}{\to} \mathbf{h}
            %a.existingWikiWord{:href => "/nlab/show/cone"} cone
            with tip
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            over the diagram
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            as above is a morphism of
            = succeed "-diagrams" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo *
                  %mi A
                  %mo ⟶
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X^\ast A \longrightarrow \hat F
                  \\,.
          %p
            Now by the defining
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mo *
                  %mo ⊣
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X^\ast \dashv \underset{X}{\prod})
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⟶
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi X
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"}
                  A \longrightarrow \underset{X}{\prod} \hat F
          %p
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⟶
                  %munder
                    %mi lim
                    %mo ⟵
                  %mi F
                %annotation{:encoding => "application/x-tex"}
                  A \longrightarrow \underset{\longleftarrow}{\lim} F
          %p
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            into the internal colimit.
          %p
            This is clearly the internal version of the statement that is extrernally true
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            of sets over a diagram is the set of all its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cones"} cones
          %p
            Dually, an internal
            %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
            is a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                  %mo ⟶
                  %msup
                    %mi X
                    %mo *
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\hat F \longrightarrow X^\ast A
          %p
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi X
                  %mo ⊣
                  %msup
                    %mi X
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\underset{X}{\sum} \dashv X^\ast)
            of the
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
            this is equivalently a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mo ⟶
                  %mi F
                  %mo ⟶
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\underset{\longrightarrow}{\lim} F \longrightarrow A
          %p
            exhibiting internally the statement familiar externally from
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            that maps out of colimits of a diagram are equivalently cocones under that diagram.
          %h2#examples Examples
          %h3#ExamplesInfinityGroupoidal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Groupoidal homotopy limits and colimits of
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            The small
            %a.existingWikiWord{:href => "/nlab/show/object+classifier"} object classifier
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %msub
                    %mi Grpd
                    %mi small
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Core(\infty Grpd_{small})
            itself. Hence an
            = succeed "-groupoidal-shaped" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            is
            %em internally
            in
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            a discrete diagram
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mi small
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \colon X\to Core(\infty Grpd_{small})
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/universal+right+fibration"} universal right fibration
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %msub
                      %mo ∫
                      %mi X
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \hat F = \int_X F
          %p Accordingly the above gives the internal limits and colimits
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mo ⟵
                  %mi F
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi X
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"}
                  \\underset{\longleftarrow}{\lim} F = \underset{X}{\sum} \hat F
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mo ⟶
                  %mi F
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi X
                  %mover
                    %mi F
                    %mo{:stretchy => "false"} ^
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\underset{\longrightarrow}{\lim} F = \underset{X}{\prod} \hat F
                  \\,.
          %p
            There are indeed also the correct external
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
            = succeed "." do
              %a{:href => "limit+in+a+quasi-category#WithValInooGrpd"} here
          %h3#BorelConstructionHomotopyQuotients Borel construction and homotopy-quotients, -invariants, -coinvariants
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            object, consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X = \mathbf{B}G
            its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            = succeed "-groupoidal," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/internal+diagram"} internal diagram
            of this shape
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ⟶
                  %mstyle{:mathvariant => "bold"}
                    %mi h
                %annotation{:encoding => "application/x-tex"}
                  \\rho \;\colon\;  \mathbf{B}G \longrightarrow \mathbf{h}
          %p
            is equivalently an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            named by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ⟶
                  %mstyle{:mathvariant => "bold"}
                    %mi h
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\ast \to\mathbf{B}G \longrightarrow \mathbf{h}
                  \\,.
          %p Now the internal colimit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mo ⟶
                  %mi ρ
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                  %mover
                    %mi ρ
                    %mo{:stretchy => "false"} ^
                  %mo ≃
                  %mi V
                  %mo{:stretchy => "false"} /
                  %mspace{:width => "negativethinmathspace"}
                  %mo{:stretchy => "false"} /
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\underset{\longrightarrow}{\lim} \rho = \underset{\mathbf{B}G}{\sum} \hat \rho
                  \\simeq
                  V/\!/G
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coinvariants"} homotopy coinvariants
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            this is given by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Borel+construction"} Borel construction
          %p Similarly, the internal limit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mo ⟵
                  %mi ρ
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                  %mover
                    %mi ρ
                    %mo{:stretchy => "false"} ^
                  %mo ≃
                  %msub
                    %mi Ext
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\underset{\longleftarrow}{\lim} \rho = \underset{\mathbf{B}G}{\prod} \hat\rho
                  \\simeq
                  Ext_G(\ast, V)
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+invariants"} homotopy invariants
            of the action.
          %p
            More generally, the internal left and right
            %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            give the
            %a.existingWikiWord{:href => "/nlab/show/induced+representation"} induced representation
            and
            %a.existingWikiWord{:href => "/nlab/show/coinduced+representation"} coinduced representation
            constructions. See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            for more on this.
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
                , Chapter 8 in Vol 1
                %em Basic Category Theory
                of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Categorical+Algebra"} Handbook of Categorical Algebra
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1017/CBO9780511525858"} doi:10.1017/CBO9780511525858
            %li#Johnstone
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                , section B2 in
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Sketches of an Elephant
            %li#Pisani09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Claudio+Pisani"}> Claudio Pisani
                ,
                %em Balanced Category Theory II
                (
                %a{:href => "http://arxiv.org/abs/0904.1790"}> arXiv:0904.1790
                )
            %li#HoTTBook
              %p
                %a.existingWikiWord{:href => "/nlab/show/Univalent+Foundations+Project"}> Univalent Foundations Project
                , section 6.12 of
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Homotopy+Type+Theory+--+Univalent+Foundations+of+Mathematics"} Homotopy Type Theory – Univalent Foundations of Mathematics
