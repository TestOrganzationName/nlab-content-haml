          #DenseFunctor.num_defn
            %h6 Definition
            %p
              %strong (dense functor)
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} i \colon S \to C
              is
              %strong dense
              if it satisfies the following equivalent conditions:
            %ol
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mi lim
                          %mo ⟶
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} /
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi{:mathvariant => "normal"} pr
                              %mi S
                        %mi S
                        %mover
                          %mo ⟶
                          %mi i
                        %mi C
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\underset{\longrightarrow}{\lim}
                        \\Big(
                        (i/c)
                        \\overset{\mathrm{pr}_S}{
                        \\longrightarrow
                        }
                        S
                        \\overset{i}{\longrightarrow}
                        C
                        \\Big)
                %p
                  over the
                  %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo{:stretchy => "false"} /
                          %mi c
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (i/c)
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo −
                          %mo ,
                          %mi c
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} C(i-,c)
                  %a.existingWikiWord{:href => "/nlab/show/weighted+colimit"} weighted colimit
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
                %p
                  (This version generalizes readily to the
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
              %li
                %p
                  the corresponding
                  %a.existingWikiWord{:href => "/nlab/show/restricted+Yoneda+embedding"} restricted Yoneda embedding
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo →
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi S
                          %mi op
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} C \to [S^{op},Set]
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} fully faithful
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi lan
                          %mi i
                        %mi i
                      %annotation{:encoding => "application/x-tex"} lan_i i
                  exists, is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/pointwise+Kan+extension"} pointwise
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is the closure of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  under
                  %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                  of a family of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi L
                          %mi op
                        %mo →
                        %mi 𝒱
                        %mo ,
                        %mi P
                        %mo{:lspace => "verythinmathspace"} :
                        %mi L
                        %mo →
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (F \colon L^{op} \to \mathcal{V}, P \colon L \to C)
                  consisting of a
                  %a.existingWikiWord{:href => "/nlab/show/weight"} weight
                  and a diagram for that weight, and these colimits are
                  = succeed "-absolute" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
                  %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi N
                          %mi i
                      %annotation{:encoding => "application/x-tex"} N_i
                  of
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
                  = succeed "," do
                    %a{:href => "#Kelly"} (Theorem 5.19 of Kelly)
              %li
                %p
                  For every category
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                        %annotation{:encoding => "application/x-tex"} B
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  induces a
                  %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi i
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo :
                        %mi S
                        %mtext -Cocts
                        %mo{:stretchy => "false"} [
                        %mi C
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mi S
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [i, 1] : S\text{-Cocts}[C, B] \to [S, B]
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mtext -Cocts
                        %mo{:stretchy => "false"} [
                        %mi C
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} S\text{-Cocts}[C, B]
                  is the category of functors preserving
                  %a.existingWikiWord{:href => "/nlab/show/weighted+colimits"} weighted colimits
                  whose weights are presheaves
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mi op
                          %mo →
                          %mi V
                        %annotation{:encoding => "application/x-tex"} S^{op} \to V
            %p
          %h2#Properties Properties
          %p
          #DenseFunctorsNotClosedUnderComposition.num_remark
            %h6 Remark
            %p
              %strong (dense functors not closed under composition)
              %br/
              Beware that the
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of dense functors (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DenseFunctor"}
              %em not
              closed under
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              of functors.
            %p
              For a counter-example see Example
              %a.maruku-ref{:href => "#DenseSubcategoriesOfSimplexCategory"}
              below.
            %p
          %h2#Examples Examples
          %p
          .num_remark
            %h6 Example
            %p
              The inclusion of the
              %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete category
              on the
              %a.existingWikiWord{:href => "/nlab/show/singleton+set"} singleton set
              into all of
              %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
              is a
              %a.existingWikiWord{:href => "/nlab/show/dense+subcategory"} dense subcategory
              inclusion.
            %p
              More generally, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is an essentially small category, then the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} C \to [C^{op},Set]
              is dense.
          %p
          .num_remark
            %h6 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a category of
              %a.existingWikiWord{:href => "/nlab/show/algebras"} algebras
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              has a presentation with operations of at most arity
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              be the free
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              generators. Then the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              with object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is dense in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              More generally, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/accessible+category"} accessible category
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi κ
                    %mo ⊆
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V_\kappa \subseteq V
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %a.existingWikiWord{:href => "/nlab/show/presentable+objects"} presentable objects
              is dense. This means in particular that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C \to Ind(C)
              into its
              %a.existingWikiWord{:href => "/nlab/show/Ind+category"} Ind category
              is dense, and that
              %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves"} categories of sheaves
              have small
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dense+subcategories"} dense subcategories
          %p
          #DenseSubcategoriesOfSimplexCategory.num_remark
            %h6 Example
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mo ≤
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta_{\leq [1]} \subset \Delta
              be the full subcategory with object set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{[0],[1]\}
              – i.e. comprising the 0-dimensional simplex and the 1-dimensional simplex.
            %p Then
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mrow
                            %mo ≤
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                        %mo ↪
                        %mi Δ
                      %annotation{:encoding => "application/x-tex"} \Delta_{\leq [1]} \hookrightarrow \Delta
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/dense+subcategory"} dense subcategory
                  inclusion;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo ↪
                        %mstyle{:mathvariant => "bold"}
                          %mi Cat
                      %annotation{:encoding => "application/x-tex"} \Delta \hookrightarrow \mathbf{Cat}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/dense+subcategory"} dense subcategory
                  inclusion,
              %li
                %p
                  but the composite
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mrow
                            %mo ≤
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                        %mo ↪
                        %mi Δ
                        %mo ↪
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} \Delta_{\leq [1]} \hookrightarrow \Delta \hookrightarrow Cat
                  is
                  %em not
                  dense in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Cat
                      %annotation{:encoding => "application/x-tex"} \mathbf{Cat}
                  (see Remark
                  = succeed ")." do
                    %a.maruku-ref{:href => "#DenseFunctorsNotClosedUnderComposition"}
            %p
          %p
          .num_remark
            %h6 Example
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              does not have any small full subcategory which is dense. Indeed,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              is not generated under colimits by any small subcategory.
          %p
          .num_remark
            %h6 Example
            %p
              The full subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Set^{op}
              on a countable set is dense if and only if there is not a proper class of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/measurable+cardinals"} measurable cardinals
              = succeed "," do
                %a{:href => "#Isbell"} Isbell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Set^{op}
              admits a small dense subcategory if and only if there is not a proper class of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/measurable+cardinals"} measurable cardinals
              = succeed "," do
                %a{:href => "#LPAC"} Adámek–Rosický
          %p
          .num_remark
            %h6 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/B%C3%A9nabou+cosmos"} Bénabou cosmos
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed ")." do
                %a{:href => "#Przybyłek2014"} Przybyłek (2014)
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dense"} dense
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/codense+functor"} codense functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/absolutely+dense+functor"} absolutely dense functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dense+subcategory"} dense subcategory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/codensity+monad"} codensity monad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/space+and+quantity"} space and quantity
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dominant+geometric+morphism"} dominant geometric morphism
          %h2#terminology_and_history Terminology and History
          %p
            %a.existingWikiWord{:href => "/nlab/show/John+Isbell"} John Isbell
            introduced
            %a.existingWikiWord{:href => "/nlab/show/dense+subcategory"} dense subcategories
            in a seminal paper
            %a{:href => "#MR0175954"} (Isbell 1960)
            under the name
            = succeed "." do
              %em left adequate
            %em right adequate
            was also introduced and subcategories satisfying both were called
            = succeed "." do
              %em adequate
            %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/measurable+cardinals"} measurable cardinals
          %p
            Later in the mid 60s,
            %a.existingWikiWord{:href => "/nlab/show/Friedrich+Ulmer"} Friedrich Ulmer
            considered the concept for more general functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F:C\to D
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo :
                    %mi C
                    %mo ↪
                    %mi D
                  %annotation{:encoding => "application/x-tex"} I:C\hookrightarrow D
            %em dense
            for them.
          %p
            Independently,
            %a.existingWikiWord{:href => "/nlab/show/Pierre+Gabriel"} Pierre Gabriel
            worked on this concept and their work coalesced to what was to become the concept of a
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
            of their
            = succeed "." do
              %a{:href => "#GabrielUlmer71"} 1971 monograph
            = succeed "\u2019" do
              %em Abelian
          %p
            More recently,
            %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
            has referred to the analogue notion for
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
            as
            %em strongly generating
            in a version (arXiv v4) of his
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strong+generator"} something different
