            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+de+Rham+cohomology"} equivariant de Rham cohomology
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/momentum+map"} momentum map
            %li
              %p
