          %h3#characterization Characterization
          %p
            By
            = succeed "," do
              %a{:href => "#AtiyahBott"} Atiyah &amp; Bott
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/basic+differential+form"} basic
            = succeed ")" do
