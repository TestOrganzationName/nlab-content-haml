          %p
            which is a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+manifolds"} Poisson manifolds
            %strong
              %a.existingWikiWord{:href => "/nlab/show/momentum+map"} momentum map
            of the (infinitesimal) Hamiltonian
            = succeed "-action." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            %strong Warning
            The lift from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ϕ
