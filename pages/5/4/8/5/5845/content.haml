          %h2#definition Definition
          #Defn.num_defn
            %h6#definition_2 Definition
            %p
              An
              %strong adjoint triple
              (of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              between
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              or generally of
              %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
              in a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi G
                    %mo ⊣
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"}
                    (F \dashv G \dashv H) \colon C \to D
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/triple"} triple
              of
              = succeed "/morphisms" do
                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ,
                    %mi H
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F,H \colon C \to D
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} G \colon D \to C
              together with
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              data
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊣
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F\dashv G
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ⊣
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G\dashv H
              %a.existingWikiWord{:href => "/nlab/show/adjoint+string"} adjoint string
              of length 3.
          #AsAdjunctionOfAdjunctions.num_prop
            %h6#proposition Proposition
            %p
              An adjoint triple
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo ⊣
                      %mi G
                      %mo ⊣
                      %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (F\dashv G\dashv H)
              %a.maruku-ref{:href => "#Defn"}
              is equivalently an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
              in the 2-category whose morphisms are adjoint pairs in the original 2-category, hence an adjunction of adjunctions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ⊣
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ⊣
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (F \dashv G) \dashv (G \dashv H)
                    \\,.
          %p
            This fact plays an important role in
            = succeed "." do
              %a{:href => "#LicataShulman"} Licata–Shulman, 5.1
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            (e.g. the
            %a.existingWikiWord{:href => "/nlab/show/local+geometric+morphism"} local
            ones) in terms of adjunctions in the 2-category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Topos"} Topos
          %p It may be suggestive to denote this like so
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi F
                        %mtd
                          %mo ⊣
                        %mtd
                          %mi G
                      %mtr
                        %mtd
                          %mo ⊥
                        %mtd
                        %mtd
                          %mo ⊥
                      %mtr
                        %mtd
                          %mi G
                        %mtd
                          %mo ⊣
                        %mtd
                          %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  F &amp;\dashv&amp; G
                  \\\
                  \\bot &amp;&amp; \bot
                  \\\
                  G &amp;\dashv&amp; H
                  }
          %p such that the two adjoint pairs appear horizontally, while the second order adjunction between them runs vertically.
          %h2#Properties Properties
          #GIsBicontinuous.num_note
            %h6#note Note
            %p
              The two adjunctions imply of course that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              preserves all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
          #AdjointPairFromAdjointTriple.num_note
            %h6#note_2 Note
            %p Every adjoint triple
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi G
                    %mo ⊣
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"}
                    (F \dashv G \dashv H) \colon C \to D
            %p
              gives rise to an
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjoint pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mi F
                    %mo ⊣
                    %mi G
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    (G F \dashv G H) \colon C \to C
            %p
              consisting of the
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi F
                  %annotation{:encoding => "application/x-tex"} G F
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to the
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G H
              on
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mi G
                    %mo ⊣
                    %mi H
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"}
                    (F G \dashv H G) \colon D \to D
            %p
              consisting of the comonad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F G
              left adjoint to the monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H G
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
          %p
            See
            %em
              %a.existingWikiWord{:href => "/nlab/show/adjoint+monad"} adjoint monad
            for more.
          %p
            In general there is a duality (an
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/dual+equivalence"} antiequivalence of categories
          %p
            Note also (see
            = succeed ")" do
              %a{:href => "adjoint+monad#IsomorphismOfEMCategories"} there
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"} algebras
            over a left-
            %a.existingWikiWord{:href => "/nlab/show/adjoint+monad"} adjoint monad
            are identified with the
            %a.existingWikiWord{:href => "/nlab/show/coalgebra+over+a+comonad"} coalgebras
            for its right-adjoint comonad (duel to
            = succeed "," do
              %a{:href => "adjoint+monad#EilenbergMoore65"} Eilenberg &amp; Moore 1965
            = succeed ")." do
              %a{:href => "#SGL"} MacLane &amp; Moerdijk 1992, Theorems V.8.1 and V.8.2
          %h3#FullyFaithFulAdjointTriples Fully faithful adjoint triples
          #FullyFaithful.num_prop
            %h6#proposition_2 Proposition
            %p
              For an adjoint triple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊣
                    %mi G
                    %mo ⊣
                    %mi H
                  %annotation{:encoding => "application/x-tex"} F\dashv G\dashv H
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} fully faithful
              if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is fully faithful.
          %p
            (In this case either
            %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/idempotent+adjunction"} idempotent adjunction
            %a.maruku-ref{:href => "#Idempotent"}
            below.)
          .proof
            %h6#proof Proof
            %p
              By a basic
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor#FullyFaithfulAndInvertibleAdjoints"} property
              of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              (
              %a{:href => "adjoint+functor#FullyFaithfulAndInvertibleAdjoints"}> this Prop.
              ), we have that
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  being full and faithful is equivalent to the
                  %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Id
                        %mo →
                        %mi G
                        %mi F
                      %annotation{:encoding => "application/x-tex"} Id \to G F
                  being a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                  being full and faithful is equivalent to the counit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mi H
                        %mo →
                        %mi Id
                      %annotation{:encoding => "application/x-tex"} G H \to Id
                  being a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            %p
              Moreover, by Note
              %a.maruku-ref{:href => "#AdjointPairFromAdjointTriple"}
              and the fact that adjoints are unique up to isomorphism, we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi F
                  %annotation{:encoding => "application/x-tex"} G F
              is isomorphic to the identity precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G H
              is.
            %p
              Finally, by a standard fact about
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              (see for instance (
              %a{:href => "#Elephant"}> Elephant, Lemma A1.1.1
              )), we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G H
              is naturally isomorphic to the identity precisely if it is so by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
          %p
            The preceeding proposition is
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/folklore"} folklore
            = succeed ")." do
              %a{:href => "#DyckhoffTholen"} DT, Lemma 1.3
            = succeed ")." do
              %a{:href => "#KellyLawvere"} KL, Prop. 2.3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi H
                  %mo →
                  %mi Id
                %annotation{:encoding => "application/x-tex"} G H \to Id
            or the unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Id
                  %mo →
                  %mi G
                  %mi F
                %annotation{:encoding => "application/x-tex"} Id \to G F
            given an inverse to the other (which could be extracted by
            %a.existingWikiWord{:href => "/nlab/show/beta-reduction"} beta-reducing
            the above, slightly more abstract argument). It also appears in (
            %a{:href => "#SGL"}> SGL, Lemma 7.4.1
            ).
          %p
            In the situation of Proposition
            = succeed "," do
              %a.maruku-ref{:href => "#FullyFaithful"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ⊣
                  %mi G
                  %mo ⊣
                  %mi H
                %annotation{:encoding => "application/x-tex"} F\dashv G \dashv H
            is a
            = succeed "." do
              %strong fully faithful adjoint triple
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a category of “spaces” structured over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            construct “discrete” and “codiscrete” spaces respectively.
          %p
            For instance, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} G\colon D\to C
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+concrete+category"} topological concrete category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            need not be
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
          #FinalLifts.num_prop
            %h6#proposition_3 Proposition
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi G
                    %mo ⊣
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} (F \dashv G \dashv H) \colon C \to D
              is an adjoint triple in which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              are fully faithful, and suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              admits
              %a.existingWikiWord{:href => "/nlab/show/final+lift"} final lifts
              for
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              = succeed "-structured" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sinks"} sinks
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi G
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{G(S_i) \to X\}
              be a small sink in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              consisting of all the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mi i
                    %annotation{:encoding => "application/x-tex"} S_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mi G
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi S
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \varepsilon\colon F G(S_i) \to S_i
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is the left adjoint of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi G
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F G(S_i) \to F(X)
              of the morphisms making up the sink. The colimit of this diagram is preserved by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (since it has a right adjoint as well). But the image of the diagram consists essentially of just the sink itself (since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is fully faithful,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi ε
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(\varepsilon)
              is an isomorphism), and its colimit is
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              (up to isomorphism). It is easy to verify that this lifting has the correct universal property.
          %p
            Thus, we can talk about objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            having the
            %a.existingWikiWord{:href => "/nlab/show/weak+structure"} weak structure
            or
            %a.existingWikiWord{:href => "/nlab/show/strong+structure"} strong structure
            induced by any small collection of maps.
          #Fibration.num_cor
            %h6#corollary Corollary
            %p
              In the situation of Proposition
              = succeed "," do
                %a.maruku-ref{:href => "#FinalLifts"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a (
              %a.existingWikiWord{:href => "/nlab/show/Street+fibration"}> Street
              )
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} opfibration
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isofibration"} isofibration
          .proof
            %h6#proof_3 Proof
            %p A final lift of a singleton sink is precisely an opcartesian arrow.
          %p
            Dually, of course, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is complete, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            admits initial lifts for small
            = succeed "-structured" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            In particular, the proposition and its corollary apply to a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
          %h3#idempotent_adjoint_triples Idempotent adjoint triples
          #Idempotent.num_prop
            %h6#proposition_4 Proposition
            %p
              For an adjoint triple
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⊣
                      %mi G
                      %mo ⊣
                      %mi H
                    %annotation{:encoding => "application/x-tex"} F\dashv G\dashv H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊣
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F\dashv G
              is an
              %a.existingWikiWord{:href => "/nlab/show/idempotent+adjunction"} idempotent adjunction
              if and only if the adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⊣
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G\dashv H
              is so.
          .proof
            %h6#proof_4 Proof
            %p
              The monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi F
                  %annotation{:encoding => "application/x-tex"} G F
              is left adjoint to the comonad
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G H
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/mates"} mates
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi F
                    %annotation{:encoding => "application/x-tex"} G F
              = succeed "-coalgebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊣
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F\dashv G
              is idempotent precisely when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi F
                  %annotation{:encoding => "application/x-tex"} G F
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent monad
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi F
                    %annotation{:encoding => "application/x-tex"} G F
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ⊣
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G\dashv H
          %p
            A special case of this situation is Prop.
            %a.maruku-ref{:href => "#FullyFaithful"}
            above.
          %h2#examples Examples
          %h3#special_cases Special cases
          %ul
            %li
              %p
                If one of the two
                %a.existingWikiWord{:href => "/nlab/show/adjoint+pairs"} adjoint pairs
                induced from an adjoint triple involving identities, then the other exhibits an
                %em
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+cylinder"} adjoint cylinder
                \/
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/unity+of+opposites"} unity of opposites
            %li
              %p
                An adjoint triple
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⊣
                      %mi G
                      %mo ⊣
                      %mi H
                    %annotation{:encoding => "application/x-tex"} F\dashv G\dashv H
                is
                %strong Frobenius
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is naturally isomorphic to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Frobenius+functor"} Frobenius functor
            %li
              %p
                An
                %em
                  %a.existingWikiWord{:href => "/nlab/show/affine+morphism"} affine morphism
                is an adjoint triple of functors in which the middle term is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative
                %a.existingWikiWord{:href => "/nlab/show/affine+morphism+of+schemes"} affine morphism of schemes
                induce an affine triples of functors among the categories of
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/quasicoherent+module"} quasicoherent module
            %li
              %p
                An adjoint triple of functors among
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} A_\infty
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/triangulated+functor"} triangulated functor
                %strong spherical
                \. See e.g. (
                %a{:href => "#Anno"}> Anno
                ). The main examples come from
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/Serre+functor"} Serre functor
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+category"} Calabi-Yau category
                context.
            %li
              %p
                A context of
                %a.existingWikiWord{:href => "/nlab/show/six+operations"} six operations
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mo !
                        %mo ⊣
                        %msup
                          %mi f
                          %mo !
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (f_! \dashv f^!)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi f
                        %mo *
                      %mo ⊣
                      %msub
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f^\ast \dashv f_\ast)
                induces an adjoint triple when either
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo !
                      %mo ≃
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^! \simeq f^\ast
                or
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo !
                        %mo =
                        %msub
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f_! = f_\ast
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Wirthm%C3%BCller+context"} Wirthmüller context
                or a
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Grothendieck+context"} Grothendieck context
          %h3#specific_examples Specific examples
          %ul
            %li
              %p
                Given any
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo ∘
                      %mo :
                      %mi R
                      %mo →
                      %mi S
                    %annotation{:encoding => "application/x-tex"} f^\circ: R\to S
                (in commutative case dual to an
                %a.existingWikiWord{:href => "/nlab/show/affine+morphism"} affine morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi Spec
                      %mi S
                      %mo →
                      %mi Spec
                      %mi R
                    %annotation{:encoding => "application/x-tex"} f: Spec S\to Spec R
                of
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/affine+schemes"} affine schemes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo !
                      %mo ⊣
                      %msub
                        %mi f
                        %mo *
                      %mo ⊣
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^!\dashv f_*\dashv f^*
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo :
                      %msub
                        %mrow
                        %mi R
                      %mi Mod
                      %mo →
                      %msub
                        %mrow
                        %mi S
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} f^*: {}_R Mod\to {}_S Mod
                is an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/extension+of+scalars"} extension of scalars
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                      %mo :
                      %msub
                        %mrow
                        %mi S
                      %mi Mod
                      %mo →
                      %msub
                        %mrow
                        %mi R
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} f_*: {}_S Mod\to {}_R Mod
                the restriction of scalars and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo !
                      %mo :
                      %mi M
                      %mo ↦
                      %msub
                        %mi Hom
                        %mi R
                      %mo{:stretchy => "false"} (
                      %msub
                        %mrow
                        %mi R
                      %mi S
                      %mo ,
                      %msub
                        %mrow
                        %mi R
                      %mi M
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^! : M\mapsto Hom_R ({}_R S, {}_R M)
                its
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/coextension+of+scalars"} right adjoint
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/lax-idempotent+2-monad"} lax-idempotent 2-monad
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                has an adjunction
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo :
                        %mi T
                        %mi A
                        %mo ⇄
                        %mi A
                        %mo :
                        %msub
                          %mi η
                          %mi A
                      %annotation{:encoding => "application/x-tex"} a : T A \rightleftarrows A : \eta_A
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is called a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/continuous+algebra"} continuous algebra
            %li
              %p
                See
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"}> adjoint quadruple
                ,
                %a.existingWikiWord{:href => "/nlab/show/adjoint+string"} adjoint string
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ambidextrous+adjunction"} ambidextrous adjunction
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/affine+morphism"}> affine morphism
                ,
                %a.existingWikiWord{:href => "/nlab/show/affine+localization"} affine localization
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+triple"} Quillen adjoint triple
          %h2#references References
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Moore"} John Moore
              = succeed "," do
                %em Adjoint functors and triples
              %strong 9
              3 (1965) 381-398 &amp;lbrack;
              %a{:href => "https://doi.org/10.1215/ijm/1256068141"}> doi:10.1215/ijm/1256068141
              \&amp;rbrack;
          %p Some remarks on adjoint triples are in
          %ul
            %li#Johnstone
              %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
              ,
              = succeed "," do
                %em Remarks on punctual local connectedness
              = succeed "." do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/25/3/25-03abs.html"} tac/25-03
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/modal+type+theory"} modal type theory
            of adjoint triples is discussed in
          %ul
            %li#LicataShulman
              %a.existingWikiWord{:href => "/nlab/show/Dan+Licata"} Dan Licata
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike Shulman
              %em Adjoint logic with a 2-category of modes
              (
              %a{:href => "http://dlicata.web.wesleyan.edu/pubs/ls15adjoint/ls15adjoint.pdf"}> pdf
              ).
          %p On spherical triples see
          %ul
            %li#Anno
              Rina Anno,
              = succeed "," do
                %em Spherical functors
              = succeed "." do
                %a{:href => "https://arxiv.org/abs/0711.4409"} arxiv/0711.4409
          %p Generalities are in
          %ul
            %li#Elephant
              %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
              ,
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Sketches of an Elephant
          %p
            Proofs of the folklore Proposition
            %a.maruku-ref{:href => "#FullyFaithful"}
            can be found in
          %ul
            %li#DyckhoffTholen
              %p
                Roy Dyckhoff and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Walter+Tholen"} Walter Tholen
            %li#KellyLawvere
              %p
                %a.existingWikiWord{:href => "/nlab/show/G.M.+Kelly"} G.M. Kelly
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/F.W.+Lawvere"} F.W. Lawvere
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Kelly-Lawvere_EssentialLocalizations.pdf", :title => "pdf"} pdf
            %li#SGL
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saunders+Mac+Lane"}> Saunders Mac Lane
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Sheaves+in+Geometry+and+Logic"} Sheaves in Geometry and Logic — A First Introduction to Topos Theory
                = succeed "&rbrack;" do
                  %a{:href => "https://dx.doi.org/10.1007/978-1-4612-0927-0"} doi:10.1007/978-1-4612-0927-0
          %p Several lemmas concerning adjoint pairs and adjoint triples are included in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Rosenberg"}> Alexander Rosenberg
              ,
              = succeed "," do
                %em Noncommutative schemes
              %strong 112
              (1998) 93–125,
              %a{:href => "https://dx.doi.org/10.1023/A:1000479824211"} doi
          %p together with geometric consequences. Note a somewhat nonstandard usage of terminology continuous functor (also flatness in the paper includes having right adjoint).
