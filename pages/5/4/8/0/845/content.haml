                                %mo ′
                                %mo ;
                    %annotation{:encoding => "application/x-tex"}
                      Mor_{C \star C'}(a,b) :=
                      \\left\lbrace
                      \\array{
                      Mor_C(a,b) &amp; \text{ if  }\;\; a,b \in C
                      \\\
                      Mor_{C'}(a,b) &amp; \text{ if }\;\; a,b \in C'\\
                      \\emptyset &amp; \text{ if  }\;\;  a \in C', b \in C;
                      \\\
                      \\mathrm{pt} &amp; \text{ if  } \;\; a \in C, b \in C';
                      }
                      \\right.
          %h3#in_terms_of_profunctors In terms of profunctors
          %p
            The join of categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ,
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} C,C'
            can also be described to be the
            %a.existingWikiWord{:href => "/nlab/show/cograph+of+a+profunctor"} cograph
            of the unique profunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mi ⇸
                  %mspace{:width => "thickmathspace"}
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} W\colon C &amp;#8696; \; C'
            sending all objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi c
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c,c')
            to the terminal set (the definition speaks for itself).
          %h3#in_terms_of_adjoint_functors In terms of adjoint functors
          %p
            Consider the inclusion of the
            %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"} boundary
            of the standard 1-simplex,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} i\colon \{0,1\}\to [1]
            as a functor between the
            %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete category
            with two elements and the
            %a.existingWikiWord{:href => "/nlab/show/interval+category"} walking arrow
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ≤
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I=\{0 \leq 1\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Cat
                  %mo{:stretchy => "false"} /
                  %mi I
                  %mo →
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Cat
                  %mo ×
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Cat
                %annotation{:encoding => "application/x-tex"}
                  i^*\colon \Cat / I
                  \\to
                  \\Cat \times \Cat
          %p
            which admits a right adjoint. This right adjoint is precisely the
            %a.existingWikiWord{:href => "/nlab/show/bifunctor"} bifunctor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Cat
                    %mo ×
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Cat
                    %mo →
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Cat
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \star\colon \Cat \times \Cat \to \Cat / I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⋆
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} C\star C'
            comes naturally equipped with an arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⋆
                  %mi C
                  %mo ′
                  %mo →
                  %mi I
                  %mo =
                  %mn 1
                  %mo ⋆
                  %mn 1
                %annotation{:encoding => "application/x-tex"} C\star C'\to I=1\star 1
            induced by (bi)functoriality of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mn 1
                  %mo ,
                  %mi C
                  %mo ′
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} C\to 1, C'\to 1
            to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
          .proof
            %h6#proof Proof
            %p
              It is quite clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i^*
              is defined by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} C\to I
              to the pair of categories
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo ←
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi C
                        %mn 0
                      %mo ,
                      %msub
                        %mi C
                        %mn 1
                      %mo =
                      %msup
                        %mi i
                        %mo ←
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i^\leftarrow(0)=C_0, C_1=i^\leftarrow(1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Cat
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %msup
                      %mi i
                      %mo *
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi C
                    %mo →
                    %mi I
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo ≅
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Cat
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi C
                    %mo ,
                    %mi A
                    %mo ⋆
                    %mi B
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Cat^{\mathbf{2}}\Big(i^*\big( C\to I\big), (A,B)\Big)\cong
                    \\Cat / I \Big( C, A\star B \Big)
            %p
              is now rather obvious, since any functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi I
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    i^*
                    \\Big(
                    \\array{ C\\ \downarrow \\ I }
                    \\Big)
                    \\to (A,B)
              determines a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi A
                    %mo ⋆
                    %mi B
                  %annotation{:encoding => "application/x-tex"} C\to A\star B
              and viceversa.
          %h3#as_a_cocomma_construction As a cocomma construction
          %p
            The join of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
