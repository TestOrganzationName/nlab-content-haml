          .num_defn
            %h6#definition_3 Definition
            %p
              If the braiding in def.
              %a.maruku-ref{:href => "#BraidedMonoidalCategory"}
              “squares” to the identity in that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mrow
                          %mi y
                          %mo ,
                          %mi x
                      %mo ∘
                      %msub
                        %mi B
                        %mrow
                          %mi x
                          %mo ,
                          %mi y
                      %mo =
                      %msub
                        %mi id
                        %mrow
                          %mi x
                          %mo ⊗
                          %mi y
                    %annotation{:encoding => "application/x-tex"} B_{y,x} \circ B_{x,y} = id_{x \otimes y}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
          .num_remark
            %h6#remark Remark
            %p
              Intuitively speaking, the first hexagon identity in def.
              %a.maruku-ref{:href => "#BraidedMonoidalCategory"}
              says we may braid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              past
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ⊗
                    %mi z
                  %annotation{:encoding => "application/x-tex"} y \otimes z
              ‘all at once’ or in two steps. The second hexagon identity says that we may braid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊗
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \otimes y
              past
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              all at once or in two steps.
          .num_remark
            %h6#remark_2 Remark
            %p
              From these axioms in def.
              = succeed "," do
                %a.maruku-ref{:href => "#BraidedMonoidalCategory"}
              %a.existingWikiWord{:href => "/nlab/show/unitors"} unitors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi l
                      %mi x
                    %mo :
                    %mi I
                    %mo ⊗
                    %mi x
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} l_x : I \otimes x \to x
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi r
                        %mi x
                      %mo :
                      %mi x
                      %mo ⊗
                      %mi I
                      %mo →
                      %mi x
                    %annotation{:encoding => "application/x-tex"} r_x : x \otimes I \to x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
