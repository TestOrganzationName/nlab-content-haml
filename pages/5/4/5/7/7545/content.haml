                  %mo .
                %annotation{:encoding => "application/x-tex"} (R^*\omega)_c(v_1,\ldots,v_p) \coloneqq \omega_{R(c)}(R_*v_1,\ldots,R_*v_p) .
          %p
            Here,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mo *
                  %msub
                    %mi v
                    %mi i
                %annotation{:encoding => "application/x-tex"} R_*v_i
            is the
            %a.existingWikiWord{:href => "/nlab/show/pushforward"} pushforward
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi i
                %annotation{:encoding => "application/x-tex"} v_i
            under
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mo *
                  %mi ω
                %annotation{:encoding => "application/x-tex"} R^*\omega
            is continuous if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is; we can also pull back differentiability and analyticity properties that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            both have.
          %p
            Given a continuous absolute
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} R\colon U \to X
            %strong integral
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi R
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \int_R \omega
            is a scalar:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi R
                  %mi ω
                  %mo ≔
                  %msub
                    %mo ∫
                    %mi U
                  %msup
                    %mi R
                    %mo *
                  %mi ω
                  %mo .
                %annotation{:encoding => "application/x-tex"} \int_R \omega \coloneqq \int_U R^*\omega .
          %p
            On the right-hand side,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mo *
                  %mi ω
                %annotation{:encoding => "application/x-tex"} R^*\omega
            is a continuous absolute
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is
            = succeed "-dimensional," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "-pseudoform" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
          %h2#examples Examples
          %p Examples of absolute forms from classical differential geometry include:
          %ul
            %li
              %p
                Absolute
                = succeed "-forms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                = succeed "-forms." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
            %li
              %p
                Absolute
                = succeed "-forms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/dimensional"} dimensional
                manifold are the same as
                = succeed "-pseudoforms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/absolutely+continuous+measure"} absolutely continuous
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/Radon+measures"} Radon measures
            %li
              %p
                In
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/complex+analysis"} complex analysis
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi{:mathvariant => "normal"} d
                        %mi z
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|\mathrm{d}z|}
                is an absolute
                = succeed "-form" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/contour+integration"} contour integration
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                      %annotation{:encoding => "application/x-tex"} z
            %li
              %p
                More generally, the
                %a.existingWikiWord{:href => "/nlab/show/arclength"} arclength
                element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi s
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi{:mathvariant => "normal"} d
                        %mstyle{:mathvariant => "bold"}
                          %mi x
                        %mo{:stretchy => "false"} ‖
                    %annotation{:encoding => "application/x-tex"} \mathrm{d}s = {\|\mathrm{d}\mathbf{x}\|}
                on a
                %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
                is an absolute
                = succeed "-form." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi s
                    %annotation{:encoding => "application/x-tex"} \mathrm{d}s
                nor (in general)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mstyle{:mathvariant => "bold"}
                        %mi x
                    %annotation{:encoding => "application/x-tex"} \mathrm{d}\mathbf{x}
                is actually the differential of anything, but
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mstyle{:mathvariant => "bold"}
                        %mi x
                    %annotation{:encoding => "application/x-tex"} \mathrm{d}\mathbf{x}
                is the canonical
                = succeed "-valued" do
                  %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} vector
                = succeed "-form" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/affine+space"} affine space
                %a.existingWikiWord{:href => "/nlab/show/identity+map"} identity map
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi x
                      %annotation{:encoding => "application/x-tex"} \mathbf{x}
                = succeed "-form." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
            %li
              %p
                Similarly, the
                %span.newWikiWord
                  surface area
                  %a{:href => "/nlab/new/surface+area"} ?
                element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \mathrm{d}S
                on a Riemannian manifold is an absolute
                = succeed "-form," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
                %a.existingWikiWord{:href => "/nlab/show/volume+element"} volume element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi V
                    %annotation{:encoding => "application/x-tex"} \mathrm{d}V
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
                is already covered as a
                = succeed "-pseudoform)." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 3
                      %annotation{:encoding => "application/x-tex"} 3
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \mathrm{d}S
                etc in terms of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi s
                      %annotation{:encoding => "application/x-tex"} \mathrm{d}s
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi S
                        %mo =
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mrow
                            %mi{:mathvariant => "normal"} d
                            %mstyle{:mathvariant => "bold"}
                              %mi x
                            %mover
                              %mo ×
                              %mo{:stretchy => "false"} ^
                            %mi{:mathvariant => "normal"} d
                            %mstyle{:mathvariant => "bold"}
                              %mi x
                          %mo{:stretchy => "false"} ‖
                        %mo{:stretchy => "false"} /
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathrm{d}S = {\|{\mathrm{d}\mathbf{x} \hat\times \mathrm{d}\mathbf{x}}\|} / 2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mo ×
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat\times
                indicates a wedge product of vector-valued forms whose vectors are multiplied by the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cross+product"} cross product
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi V
                        %mo =
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mi{:mathvariant => "normal"} d
                            %mstyle{:mathvariant => "bold"}
                              %mi x
                            %mover
                              %mo ⋅
                              %mo{:stretchy => "false"} ^
                            %mi{:mathvariant => "normal"} d
                            %mstyle{:mathvariant => "bold"}
                              %mi x
                            %mover
                              %mo ×
                              %mo{:stretchy => "false"} ^
                            %mi{:mathvariant => "normal"} d
                            %mstyle{:mathvariant => "bold"}
                              %mi x
                          %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} /
                        %mn 6
                      %annotation{:encoding => "application/x-tex"} \mathrm{d}V = {|{\mathrm{d}\mathbf{x} \hat\cdot \mathrm{d}\mathbf{x} \hat\times \mathrm{d}\mathbf{x}}|} / 6
          .num_remark
            %p
              The reason that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi s
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}s
              determines
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}S
              is that lengths determine areas, as through Heron's Formula. However, our usual ways of deriving one form from another (thinking of them, at a given point, as maps from lists of vectors to numbers) involve only rerranging (permuting, duplicating, and contracting) the inputs and applying operations to the outputs. But this cannot be sufficient; knowing only the lengths of two vectors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
              (which vectors are the inputs to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \mathrm{d}S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi s
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}s
              at those inputs) does not tell you the area of the parallelogram that they span (which is the output of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \mathrm{d}S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo −
                    %mi w
                  %annotation{:encoding => "application/x-tex"} v - w
              (or of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo +
                      %mi w
                    %annotation{:encoding => "application/x-tex"} v + w
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %msub
                      %mi S
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}S_c
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}S
              at a point
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo ↦
                    %mn 2
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} d
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi{:mathvariant => "normal"} d
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi{:mathvariant => "normal"} d
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo −
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v, w \mapsto 2 H(\mathrm{d}s(v), \mathrm{d}s(w), \mathrm{d}s(v - w))
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is the Heron function, the real-valued function of three real variables that takes the lengths of the three sides of a triangle and returns its area), or equivalently as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ,
                      %mi w
                      %mo ↦
                      %mn 2
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi v
                        %mo{:stretchy => "false"} ‖
                      %mo ,
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi w
                        %mo{:stretchy => "false"} ‖
                      %mo ,
                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mrow
                          %mi v
                          %mo −
                          %mi w
                        %mo{:stretchy => "false"} ‖
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (v, w \mapsto 2 H({\|v\|}, {\|w\|}, {\|{v - w}\|}))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}S
              with a formula anything along the lines of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mstyle{:mathvariant => "bold"}
                          %mi x
                        %mover
                          %mo ×
                          %mo{:stretchy => "false"} ^
                        %mi{:mathvariant => "normal"} d
                        %mstyle{:mathvariant => "bold"}
                          %mi x
                      %mo{:stretchy => "false"} ‖
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} {\|{\mathrm{d}\mathbf{x} \hat\times \mathrm{d}\mathbf{x}}\|} / 2
              using
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi s
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}s
              directly instead of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mstyle{:mathvariant => "bold"}
                        %mi x
                    %annotation{:encoding => "application/x-tex"} \mathrm{d}\mathbf{x}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %msub
                      %mi S
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}S_c
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo ↦
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %mi v
                        %mo ×
                        %mi w
                      %mo{:stretchy => "false"} ‖
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v, w \mapsto {\|{v \times w}\|})
              instead.)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                exterior
                %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
                and
                %a.existingWikiWord{:href => "/nlab/show/pseudoforms"} pseudoforms
                (the more well-known variations);
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cojet+differential+forms"} cojet differential forms
                (and
                %a.existingWikiWord{:href => "/nlab/show/cogerm+differential+forms"} cogerm differential forms
                more generally) generalize both exterior and absolute
                = succeed "-forms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                = succeed "-forms;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
            %li
              %p
                %span.newWikiWord>
                  coflare differential form
                  %a{:href => "/nlab/new/coflare+differential+form"} ?
                s are a common generalization of exterior forms, absolute forms, and cojet forms (although not all cogerm forms).
          %h2#references References
          %p
            Near the end of a Usenet post from 2002, we see a definition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi R
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi ω
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \int_R {|\omega|}
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            a (pseudo)-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            \-form and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            a
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi ω
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|\omega|}
            itself:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Toby+Bartels"} Toby Bartels
              and Ralph Hartley;
              %a{:href => "https://groups.google.com/group/sci.physics.research/msg/424da828e75b6b90?dmode=source"} Densitized Pseudo Twisted Forms
          %p
            Apparently absolute
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/densities"} densities
            as defined by Gelfand; see this MathOverflow answer:
          %ul
            %li
              Juan Carlos Álvarez Paiva; answer to
              = succeed "." do
                %a{:href => "http://mathoverflow.net/questions/90455/why-do-i-need-densities-in-order-to-integrate-on-a-non-orientable-manifold/90714#90714"} Why do I need densities in order to integrate on a non-orientable manifold?
