                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ω
                          %mi c
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi v
                          %mi p
                        %msubsup
                          %mo{:stretchy => "false"} )
                          %mi S
                          %mi o
                      %annotation{:encoding => "application/x-tex"} \omega_c(v_1,\ldots,v_p)_S^o
                  be
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
