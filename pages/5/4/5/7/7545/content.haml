                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \omega_c({-})
                  shall be
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/uniformly+continuous+map"} uniformly continuous
              %li
                %p
