          %h2#idea Idea
          %p
            The
            %em
              automorphism
              = succeed "-Lie" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi aut
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} aut(\mathfrak{g})
            of an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            – or dually
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi aut
                  %mo{:stretchy => "false"} (
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} aut(CE(\mathfrak{g}))
            of the corresponding
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            – has in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            the
            %a.existingWikiWord{:href => "/nlab/show/derivations"} derivations
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            of degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi k
                  %annotation{:encoding => "application/x-tex"} -k
            %a.existingWikiWord{:href => "/nlab/show/higher+Lie+algebra"} higher Lie algebra
            version of the
            %a.existingWikiWord{:href => "/nlab/show/automorphism+Lie+algebra"} automorphism Lie algebra
            of an ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
          %p
            In terms of
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi aut
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} aut(\mathfrak{g})
            is a model for the rationalization of the group of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
            %a.existingWikiWord{:href => "/nlab/show/rational+space"} rational space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})
            corresponding to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            under the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+construction"} Sullivan construction
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ∧
                    %mo •
                  %msup
                    %mi 𝔞
                    %mo *
                  %mo ,
                  %msub
                    %mi d
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A := (\wedge^\bullet \mathfrak{a}^*, d_A)
            be a
            %a.existingWikiWord{:href => "/nlab/show/semifree+dga"} semifree
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
          %p
            Notice that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \phi : A \to A
            a
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi k
                %annotation{:encoding => "application/x-tex"} -k
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \lambda : A\to A
            another derivation of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi l
                %annotation{:encoding => "application/x-tex"} -l
            the
            %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi ϕ
                  %mo ,
                  %mi λ
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mo =
                  %mi ϕ
                  %mo ∘
                  %mi λ
                  %mo −
                  %mi λ
                  %mo ∘
                  %mi ϕ
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  [\phi,\lambda] := \phi \circ \lambda - \lambda \circ \phi : A \to A
          %p
            is itself a derivation, of degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mi l
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} -(k+l)
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi A
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} d_A : A \to A
            is itself a derivation of degree +1, we have that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi A
                  %mi ϕ
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi d
                    %mi A
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  d_A \phi := [d_A, \phi] : A \to A
          %p
            is a derivation of degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} -(k+1)
          .un_defn
            %h6#definition_2 Definition
            %p
              %strong
                (automorphism
                = succeed "-Lie" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi aut
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} aut(A)
              is the
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
              which
            %ul
              %li
                %p
                  in degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi k
                      %annotation{:encoding => "application/x-tex"} -k
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo &gt;
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} k \gt 0
                  has the derivations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo :
                        %mi A
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} \phi : A \to A
                  of degree
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi k
                        %annotation{:encoding => "application/x-tex"} -k
              %li
                %p
                  in degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                  the derivations that commute with the differential
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi A
                      %annotation{:encoding => "application/x-tex"} d_A
              %li
                %p
                  whose differential
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi δ
                          %mrow
                            %mi aut
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi d
                          %mi A
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \delta_{aut(A)} := [d_A,-]
                  is given by the commutator with the differential of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
              %li
                %p
                  whose Lie bracket is the commutator
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi ϕ
                          %mo ,
                          %mi λ
                          %mo{:stretchy => "false"} ]
                          %mo =
                          %mi ϕ
                          %mo ∘
                          %mi λ
                          %mo −
                          %mi λ
                          %mo ∘
                          %mi ϕ
                        %annotation{:encoding => "application/x-tex"} [\phi,\lambda] = \phi \circ \lambda - \lambda \circ \phi
          %h2#properties Properties
          %h3#AutomorphismGroup Automorphism group
          %p
            For stating the fundamental theorem about
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi aut
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} aut(\mathfrak{g})
            below we need some facts about the ordinary
            %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
            of a dg-algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p (…)
          %p
            (See chapter 6 of
            = succeed ")." do
              %a{:href => "#Sullivan"} Sullivan
          %h3#ClassifyingSpaces
            Classifying space for
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aut(X)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/rational+space"} rational space
            whose
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \simeq \exp(\mathfrak{g})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi aut
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi aut
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} aut'(\mathfrak{g}) \subset aut(\mathfrak{g})
            be the sub dg-algebra of the automorphism
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G(X)
            be the maximal reductive group of genuine automorphisms of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            (see
            = succeed ")." do
              %a{:href => "#AutomorphismGroup"} above
          %p
            Then the
            %a.existingWikiWord{:href => "/nlab/show/rational+space"} rational space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi aut
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi B
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\exp(aut'(\mathfrak{g}))/G(X)
                  \\simeq
                  B Aut (X)
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            for
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aut(X)
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h2#examples Examples
          %ul
            %li
              The
              %a.existingWikiWord{:href => "/nlab/show/inner+derivation+Lie+2-algebra"} inner derivation Lie 2-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inn
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} inn(\mathfrak{g})
              is the full subalgebra of the automorphism
              = succeed "-Lie" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %em inner
              derivations of the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/automorphism+Lie+algebra"} automorphism Lie algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/deformation+theory"} deformation theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tangent+complex"} tangent complex
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cotangent+complex"} cotangent complex
            %li
              %p
                %span.newWikiWord
                  automorphism group of a Lie algebra
                  %a{:href => "/nlab/new/automorphism+group+of+a+Lie+algebra"} ?
          %h2#references References
          %p
            The general definition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi aut
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} aut(\mathfrak{g})
            is the topic of p. 313 (45 of 63) and following in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dennis+Sullivan"}> Dennis Sullivan
              ,
              %em Infinitesimal computations in topology
              Publications Mathématiques de l’IHÉS, 47 (1977) (
              %a{:href => "http://www.numdam.org/item?id=PMIHES_1977__47__269_0"}> numdam
              )
          %p
            The automorphism group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Aut(A)
            of a dg-algebra is discussed in paragraph 6 there. Few details on proofs are given there. Only recently in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andrey+Lazarev"}> Andrey Lazarev
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Block"} Jonathan Block
          %p a detailed proof is given.
          %p
            Concrete computations of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi aut
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} aut(\mathfrak{g})
            for some classes of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/rational+space"} rational space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X = \exp(\mathfrak{g})
            can be found for instance in
          %ul
            %li
              Samual Bruce Smith,
              %em The rational homotopy Lie algebra of classifying spaces for formal two-stage spaces
              , Journal of Pure and Applied Algebra Volume 160, Issues 2-3, 25 June 2001, Pages 333-343
