                                  %mtr
                                    %mtd
                                      %mi h
                                      %mo −
                                      %mi p
                                      %mi i
                              %mo )
                            %mi β
                            %msup
                              %mi P
                              %mrow
                                %mi h
                                %mo +
                                %mi k
                                %mo −
                                %mi i
                            %msup
                              %mi P
                              %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mo{:stretchy => "false"} (
