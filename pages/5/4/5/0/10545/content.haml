            %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring"} E-infinity ring
            such that its dual
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/Steenrod+algebra"} Steenrod algebra
            in the form of the self-
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mo •
