              %a.maruku-ref{:href => "#SelfHomologyIsModuleOverCohomologyRing"}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/flat+module"} flat module
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mo •
                        %mo ,
                        %msub
                          %mi A
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (A_\bullet, A_\bullet(A))
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
                  over
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi R
                            %mo •
                        %annotation{:encoding => "application/x-tex"} R_\bullet
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi A
                          %mo •
                          %mi R
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A^R_\bullet(X)
                  is a left
                  = succeed "-module" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi A
                            %mo •
                            %mi R
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} A^R_\bullet(A)
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-module"} ∞-module
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
          %p
            This is due to (
            %a{:href => "#BakerLazarev01"}> Baker-Lazarev 01
            ), further discussed in (
            %a{:href => "#BakerJeanneret02"}> Baker-Jeanneret 02
            ) (there expressed in terms of the presentation by
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/highly+structured+ring+spectra"} highly structured ring spectra
            = succeed ")." do
              %a{:href => "#Ravenel"} Ravenel, chapter 2, prop. 2.2.8
          .proof
            %h6#proof_sketch Proof sketch
            %p
              Using the arguments of (
              %a{:href => "#Adams74"}> Adams 74
              ,
              = succeed ")." do
                %a{:href => "#Ravenel86"} Ravenel 86
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/flat+module"} flatness
              condition implies that there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mrow
                      %mo (
                      %mi A
                      %munder
                        %mo ∧
                        %mi R
                      %mi A
                      %munder
                        %mo ∧
                        %mi R
                      %mi X
                      %mo )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msubsup
                      %mi A
                      %mo •
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ⊗
                      %mrow
                        %msub
                          %mi A
                          %mo •
                    %msubsup
                      %mi A
                      %mo •
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet\left(
                    A \underset{R}{\wedge} A \underset{R}{\wedge} X
                    \\right)
                    \\stackrel{\simeq}{\longrightarrow}
                    A_\bullet^R(A) \underset{A_\bullet}{\otimes} A_\bullet^R(X)
                    \\,.
            %p
              Combining this with the map in lemma
              %a.maruku-ref{:href => "#SelfHomologyIsModuleOverCohomologyRing"}
              yields the
              %a.existingWikiWord{:href => "/nlab/show/coaction"} coaction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi A
                      %mo •
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mrow
                      %mo (
                      %mi A
                      %munder
                        %mo ∧
                        %mi R
                      %mi A
                      %munder
                        %mo ∧
                        %mi R
                      %mi X
                      %mo )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msubsup
                      %mi A
                      %mo •
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ⊗
                      %mrow
                        %msub
                          %mi A
                          %mo •
                    %msubsup
                      %mi A
                      %mo •
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A_\bullet^R(X)
                    \\longrightarrow
                    \\pi_\bullet\left(
                    A \underset{R}{\wedge} A \underset{R}{\wedge} X
                    \\right)
                    \\stackrel{\simeq}{\longrightarrow}
                    A_\bullet^R(A) \underset{A_\bullet}{\otimes} A_\bullet^R(X)
                    \\,.
          %p
            These (dual)
            = succeed "-Steenrod" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/brave+new+algebra"} brave new Hopf algebroids
            = succeed "," do
              %a{:href => "#Baker"} Baker
            = succeed ")" do
              %a{:href => "#BakerJeanneret02"} Baker-Jeanneret 02
          .num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi H
                    %msub
                      %mi 𝔽
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E = H \mathbb{F}_2
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
              structure on the dual ordinary Steenrod algebra as above.
          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                  %annotation{:encoding => "application/x-tex"} E =
              %a.existingWikiWord{:href => "/nlab/show/MU"} MU
              then by
              %a.existingWikiWord{:href => "/nlab/show/Quillen%27s+theorem+on+MU"} Quillen's theorem on MU
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi MU
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi L
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(MU) \simeq L
              is the
              %a.existingWikiWord{:href => "/nlab/show/Lazard+ring"} Lazard ring
              and the Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi MU
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi MU
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi MU
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\pi_\bullet(MU), MU_\bullet(MU))
              is described by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Landweber-Novikov+theorem"} Landweber-Novikov theorem
          .num_example
            %h6#example_3 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                  %annotation{:encoding => "application/x-tex"} E =
              %a.existingWikiWord{:href => "/nlab/show/BP"} BP
              the analog is the content of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Adams-Quillen+theorem"} Adams-Quillen theorem
              %a.existingWikiWord{:href => "/nlab/show/Landweber+exact+functor+theorem"} Landweber exact functor theorem
              was proven using the
              = succeed "-Hopf" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %msub
                        %mi P
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mi P
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B P_\bullet(B P)
          %h3#relation_to_adams_spectral_sequence Relation to Adams spectral sequence
          %h4#for_ordinary_cohomology_3 For ordinary cohomology
          %p
            By construction, the total
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^\bullet(X,\mathbb{Z}_2)
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            over the Steenrod algebra:
          %p
            a cohomology element is represented by a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            which is a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⟶
                  %msup
                    %mi B
                    %mi n
                  %msub
                    %mi ℤ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} X \longrightarrow B^n \mathbb{Z}_2
            and the action of a
            %a.existingWikiWord{:href => "/nlab/show/Steenrod+square"} Steenrod square
            on this is just by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
          %p
            In this form the Steenrod algebra appears in the second page of the
            %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            which computes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Σ
                    %mn ∞
                  %mi X
                  %mo ,
                  %msup
                    %mi Σ
                    %mn ∞
                  %mi Y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\Sigma^\infty X, \Sigma^\infty Y]
            for
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "-groups" do
              %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 2
                  %mo =
                  %msub
                    %mi Ext
                    %mi A
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  E_2 = Ext_A(H^\bullet(X, \mathbb{Z}_2), H^\bullet(Y,\mathbb{Z}_2))
          %p
            computed in the
            %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of A-modules
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            the Steenrod algebra.
          %h4#for_generalized_cohomology_3 For generalized cohomology
          %p
            More generally, For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
