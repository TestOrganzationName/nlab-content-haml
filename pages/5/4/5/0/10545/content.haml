                              %mo )
                            %msup
                              %mi P
                              %mrow
                                %mi h
                                %mo +
                                %mi k
                                %mo −
                                %mi i
                            %mi β
                            %msup
                              %mi P
                              %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    P^h \beta P^k
                    \&amp; =\;
                    \\underoverset{[h/p]}{i = 0}{\sum}
                    (-1)^{h+i}
                    \\left(
                    \\array{
