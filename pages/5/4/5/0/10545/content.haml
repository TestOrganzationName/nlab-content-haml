                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi h
                                %mo +
                                %mi i
                                %mo −
                                %mn 1
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mo{:stretchy => "false"} (
                                      %mi p
                                      %mo −
                                      %mn 1
                                      %mo{:stretchy => "false"} )
                                      %mo{:stretchy => "false"} (
                                      %mi k
                                      %mo −
                                      %mi i
                                      %mo{:stretchy => "false"} )
                                      %mo −
