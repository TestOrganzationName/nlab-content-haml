            is a (graded-)
            %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mo •
                  %mo =
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R_\bullet = \pi_\bullet(R)
            (see at
            = succeed ")," do
              %a{:href => "Steenrod+algebra#HopfAlgebraStructure"} Steenrod algebra – Hopf algebroid structure
            = succeed "-term" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E^2
            = succeed "-Adams" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_\bullet(E)
            %a.existingWikiWord{:href => "/nlab/show/comodules"} comodules
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mn 2
                  %mo ≃
                  %msub
                    %mi Ext
                    %mrow
                      %msub
                        %mi R
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi R
                    %mo •
                  %mo ,
                  %msub
                    %mi R
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E^2 \simeq Ext_{R_\bullet(R)}(R_\bullet, R_\bullet(X))
                  \\,.
          %p
            See the
            = succeed "." do
              %a{:href => "#ReferencesHopfAlgebroid"} references below
