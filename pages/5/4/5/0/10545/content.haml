            %p
              and whose coproduct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                  %annotation{:encoding => "application/x-tex"} \Psi
              is subject to the following relations:
            %p
              %strong>
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mn 2
