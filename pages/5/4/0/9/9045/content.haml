                    \\,.
            %p
              Notice that here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \Omega^p
              is still regarded as sitting in degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi p
                    %annotation{:encoding => "application/x-tex"} -p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          #HodgeFiltrationForComplexSpace.num_defn
            %h6#definition_4 Definition
            %p
              The
              %em Hodge filtration
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^\bullet(X,\mathbb{C})
              is defined to be the
              %a.existingWikiWord{:href => "/nlab/show/filtration"} filtration
              with
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hyper
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
              with coefficients in the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi p
                    %msup
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi im
                    %mrow
                      %mo (
                      %msup
                        %mi H
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msup
                        %mi F
                        %mi p
                      %msubsup
                        %mi Ω
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mi H
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msubsup
                        %mi Ω
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    F^p H^k(X,\mathbb{C})
                    \\coloneqq
                    im
                    \\left(
                    H^k(X, F^p \Omega^\bullet_X)
                    \\to
                    H^k(X, \Omega^\bullet_X)
                    \\right)
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#Voisin02"} Voisin 02, def. 8.2
            = succeed ")." do
              %a{:href => "#PetersSteenbrink08"} Peters-Steenbrink 08, def. 2.21
          #HodgeFiltrationForComplexSpaceReproducesKaehlerHodgeStructure.num_theorem
            %h6#theorem Theorem
            %p
              When the compact
              %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              happens to have the structure of a
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"} Kähler manifold
              then the
              %a.existingWikiWord{:href => "/nlab/show/Fr%C3%B6licher+spectral+sequence"} Frölicher spectral sequence
              degenerates at the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E_1
              page which implies that def.
              %a.maruku-ref{:href => "#HodgeFiltrationForComplexSpace"}
              coincides with the traditional definition via
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/harmonic+differential+forms"} harmonic differential forms
              = succeed ":" do
                %a.maruku-ref{:href => "#TraditionalHodgeFiltration"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊕
                      %mrow
                        %mi k
                        %mo −
                        %mi q
                        %mo ≥
                        %mi p
                    %msup
                      %mi H
                      %mrow
                        %mi k
                        %mo −
                        %mi q
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi im
                    %mrow
                      %mo (
                      %msup
                        %mi H
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msup
                        %mi F
                        %mi p
                      %msubsup
                        %mi Ω
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mi H
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msubsup
                        %mi Ω
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{k-q \geq p}{\oplus}
                    H^{k-q,q}(X)
                    \\simeq
                    im
                    \\left(
                    H^k(X, F^p \Omega^\bullet_X)
                    \\to
                    H^k(X, \Omega^\bullet_X)
                    \\right)
                    \\,.
          %p
            (e.g.
            = succeed ";" do
              %a{:href => "#Voisin02"} Voisin 02, remark 8.29
            = succeed ";" do
              %a{:href => "#Voisin08"} Voisin 08, 1.1.2
            = succeed ")." do
              %a{:href => "#PetersSteenbrink08"} Peters-Steenbrink 08, prop 2.22
          #FrolicherEquivalenceInComponents.num_remark
            %h6#remark_3 Remark
            %p
              The equivalence in theorem
              %a.maruku-ref{:href => "#HodgeFiltrationForComplexSpaceReproducesKaehlerHodgeStructure"}
              is exhibited by the following morphism.
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tot
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo ≥
                        %mi p
                        %mo ,
                        %mo •
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mo =
                    %mo ∂
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mover
                      %mo ∂
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    tot(\Omega^{\bullet \geq p, \bullet}, \mathbf{d}= \partial + \bar \partial)
            %p
              for the holomorphically truncated
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
              of the
              %a.existingWikiWord{:href => "/nlab/show/Dolbeault+complex"} Dolbeault
              %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Ω
                              %mrow
                                %mi p
                                %mo ,
                                %mn 0
                          %mtd
                            %mover
                              %mo →
                              %mover
                                %mo ∂
                                %mo{:stretchy => "false"} ¯
                          %mtd
                            %msup
                              %mi Ω
                              %mrow
                                %mi p
                                %mo −
                                %mn 1
                                %mo ,
                                %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mover
                                %mo ∂
                                %mo{:stretchy => "false"} ¯
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ∂
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ∂
                        %mtr
                          %mtd
                            %msup
                              %mi Ω
                              %mrow
                                %mi p
                                %mo +
                                %mn 1
                                %mo ,
                                %mn 0
                          %mtd
                            %mover
                              %mo →
                              %mover
                                %mo ∂
                                %mo{:stretchy => "false"} ¯
                          %mtd
                            %msup
                              %mi Ω
                              %mrow
                                %mi p
                                %mo ,
                                %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mover
                                %mo ∂
                                %mo{:stretchy => "false"} ¯
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ∂
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ∂
                        %mtr
                          %mtd
                            %mi ⋮
                          %mtd
                          %mtd
                            %mi ⋮
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Omega^{p,0} &amp;\stackrel{\bar \partial}{\to}&amp; \Omega^{p-1,1} &amp;\stackrel{\bar \partial}{\to}&amp; \cdots
                    \\\
                    \\downarrow^{\mathrlap{\partial }}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\partial }}
                    \\\
                    \\Omega^{p+1,0} &amp;\stackrel{\bar \partial}{\to}&amp; \Omega^{p,1} &amp;\stackrel{\bar \partial}{\to}&amp; \cdots
                    \\\
                    \\downarrow^{\mathrlap{\partial }}
