                    \\,.
            %p
              Since this is in each row the
              %a.existingWikiWord{:href => "/nlab/show/Dolbeault+resolution"} Dolbeault resolution
              of the given sheaf of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/holomorphic+differential+forms"} holomorphic differential forms
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphic
              to the (truncated)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/holomorphic+de+Rham+complex"} holomorphic de Rham complex
            %p
              The total complex is in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi k
                  %annotation{:encoding => "application/x-tex"} -k
              given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊕
                      %mrow
                        %mi k
                        %mo −
                        %mi q
                        %mo ≥
                        %mi p
                    %msup
                      %mi Ω
                      %mrow
                        %mi k
                        %mo −
                        %mi q
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \underset{k-q \geq p}{\oplus} \Omega^{k-q, q}
              and hence globally defined closed
              = succeed "-forms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
