          .num_remark
            %h6#remark_2 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/holomorphic+de+Rham+complex"} holomorphic de Rham complex
              is naturally
              %a.existingWikiWord{:href => "/nlab/show/filtered+object"} filtered
              by degree with the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi p
                    %msubsup
                      %mi Ω
                      %mi X
                      %mo •
                    %mo ≔
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mn 0
                    %mo →
                    %mi ⋯
                    %mo →
                    %mn 0
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi X
                      %mi p
                    %mover
                      %mo ⟶
                      %mo ∂
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
