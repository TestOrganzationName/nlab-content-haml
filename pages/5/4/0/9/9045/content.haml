                    \\to
                    \\cdots
                    \\to
                    0
                    \\to
                    \\Omega^p_X
                    \\stackrel{\partial}{\longrightarrow}
                    \\Omega^{p+1}
                    \\stackrel{\partial}{\longrightarrow}
                    \\cdots
