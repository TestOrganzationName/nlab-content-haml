                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi H
                              %mrow
                                %mn 2
                                %mo ,
                                %mn 0
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    F^0 H^2(X,\mathbb{C})
                    \&amp; =
                    H^{0,2}(X) \oplus H^{1,1}(X) \oplus H^{2,0}(X)
                    \\\
                    F^1 H^2(X,\mathbb{C})
                    \&amp; =
                    \\;\;\;\;\;\;\;
                    H^{1,1}(X)
                    \\oplus
                    H^{2,0}(X)
                    \\\
                    F^2 H^2(X,\mathbb{C})
                    \&amp; =
                    \\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;
                    H^{2,0}(X)
                    \\end{aligned}
          .num_example
            %h6#example_2 Example
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              the mid-dimensional Hodge filtration stage in even total degree is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi p
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi p
                    %mo =
                    %msup
                      %mi H
                      %mrow
                        %mi p
                        %mo ,
                        %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mi p
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mi ⋯
                    %mo ⊕
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F^p H^{2p}
                    \=
                    H^{p,p}(X)
                    \\oplus
                    H^{p+1,p-1}(X)
                    \\oplus
                    \\cdots
                    \\oplus
                    H^{2p,0}(X)
                    \\,.
          %h3#ForAComplexAnalyticSpace On the cohomology of a complex analytic space
          .num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+analytic+space"} complex analytic space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi X
                      %mo •
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mi X
