                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi tot
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo ≥
                        %mi p
                        %mo ,
                        %mo •
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mo =
                    %mo ∂
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mover
                      %mo ∂
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^k(X, tot(\Omega^{\bullet\geq p, \bullet}, \mathbf{d} = \partial + \bar \partial) )
                    \\simeq
                    H^0(X,tot(\Omega^{\bullet\geq p, \bullet}, \mathbf{d} = \partial + \bar \partial)[-k])
                    \\,.
            %p
              Therefore given a representative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in \Omega^{p,q}_{cl}(X)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msup
                      %mi H
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [\alpha] \in H^{p,q}(X)
              it is canonically sent along
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊕
                      %mrow
                        %mi k
                        %mo −
                        %mi q
                        %mo ≥
                        %mi p
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mo ⊕
                      %mrow
                        %mi k
                        %mo −
                        %mi q
                        %mo ≥
                        %mi p
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi tot
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo ≥
                        %mi p
                        %mo ,
                        %mo •
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mo =
                    %mo ∂
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mover
                      %mo ∂
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{k-q\geq p}{\oplus} \Omega^{p,q}_{cl}(X)
                    \\simeq
                    \\underset{k-q\geq p}{\oplus}
                    H^0(X, \Omega^{p,q}_{cl})
                    \\to
                    H^0(X,tot(\Omega^{\bullet\geq p, \bullet}, \mathbf{d} = \partial + \bar \partial)[-k])
                    \\,.
            %p
              This map exhibits the equivalence in theorem
              %a.maruku-ref{:href => "#HodgeFiltrationForComplexSpaceReproducesKaehlerHodgeStructure"}
              (e.g.
              = succeed ")." do
                %a{:href => "#Voisin08"} Voisin 08, section 1.1.2
            %p Dually,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi hol
                      %mrow
                        %mo ≤
                        %mi k
                    %mo ≃
                    %mi tot
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo ≤
                        %mi k
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega_{hol}^{\leq k}
                    \\simeq
                    tot(  \Omega^{\bullet \leq k, \bullet})
                    \\,.
            %p
              This plays a role in the discussion of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/intermediate+Jacobians"} intermediate Jacobians
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dim
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi k
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} dim_{\mathbb{C}}(X)= k+1
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi F
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msubsup
                      %mi Ω
                      %mi hol
                      %mrow
                        %mo •
                        %mo ≤
                        %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^{2k+1}(X,\mathbb{R})
                    \\simeq
                    H^{2k+1}(X,\mathbb{C}) / F^{k+1} H^{2k+1}(X,\mathbb{C})
                    \\simeq
                    H^{2k+1}(X, \Omega_{hol}^{\bullet \leq k})
                    \\,.
            %p
              Here a real differential
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2k+1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mover
                      %mrow
                        %msup
                          %mi α
                          %mrow
                            %mn 0
                            %mo ,
                            %mn 2
                            %mi k
                            %mo +
                            %mn 1
                      %mo ¯
                    %mo +
                    %mover
                      %mrow
                        %msup
                          %mi α
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 2
                            %mi k
                      %mo ¯
                    %mo +
                    %mi ⋯
                    %mo +
                    %msup
                      %mi α
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 2
                        %mi k
                    %mo +
                    %msup
                      %mi α
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha
                    \=
                    \\overline{\alpha^{0,2k+1}}
                    +
                    \\overline{\alpha^{1, 2k}}
                    +
                    \\cdots
                    +
                    \\alpha^{1, 2k}
                    +
                    \\alpha^{0,2k+1}
            %p injects via its pieces in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo ≤
                        %mi k
                        %mo ,
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                        %mo −
                        %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo ≤
                        %mi k
                        %mo ,
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                        %mo −
                        %mi p
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi tot
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo ≤
                        %mi k
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Ω
                      %mi hol
                      %mrow
                        %mo •
                        %mo ≤
                        %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{p \leq k, 2k+1-p}(X)
                    \\simeq
                    H^0(X, \Omega^{p \leq k, 2k+1-p})
                    \\to
                    H^0(X, tot(\Omega^{\bullet \leq k, \bullet})[-k])
                    \\simeq
                    H^k(\Omega_{hol}^{\bullet\leq k})
                    \\,.
          %h3#OnAnAbelianGroup Generally on an abelian group
          #HodgeStructureOfWeightk.num_defn
            %h6#definition_5 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} H_{\mathbb{Z}}
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %em Hodge structure
              of
              %em weight
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{Z}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} H_{\mathbb{Z}}
              is a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              decomposition of its
              %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi ℂ
                    %mo ≔
                    %msub
                      %mi H
                      %mi ℤ
                    %msub
                      %mo ⊗
                      %mi ℤ
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    H_{\mathbb{C}}\coloneqq H_{\mathbb{Z}} \otimes_{\mathbb{Z}} \mathbb{C}
            %p
              into
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+spaces"} complex vector spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} H^{p,q}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mi q
                    %mo =
                    %mi k
                  %annotation{:encoding => "application/x-tex"} p +q = k
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi ℂ
                    %mo ≃
                    %munder
                      %mo ⊕
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                        %mo =
                        %mi k
                    %msup
                      %mi H
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"}
                    H_{\mathbb{C}} \simeq \underset{p+q = k}{\oplus} H^{p,q}
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mi q
                        %mo ,
                        %mi p
                  %annotation{:encoding => "application/x-tex"} H^{q,p}
              is the
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugate
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mrow
                          %mi p
                          %mo ,
                          %mi q
                    %annotation{:encoding => "application/x-tex"} H^{p,q}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo =
                    %mover
                      %mrow
                        %msup
                          %mi H
                          %mrow
                            %mi q
                            %mo ,
                            %mi p
                      %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^{p,q} = \overline{H^{q,p}}
                    \\,.
            %p This is an equality of the underlying sets of the complex vector spaces.
          %p
            With this the above def.
            %a.maruku-ref{:href => "#TraditionalHodgeFiltration"}
            has the following verbatim generalization
          #GeneralHodgeFiltration.num_defn
            %h6#definition_6 Definition
            %p
              Given a Hodge structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi ℤ
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi H
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} H_{\mathbb{Z}}, \{H^{p,q}\}
              of weight
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %a.maruku-ref{:href => "#HodgeStructureOfWeightk"}
              %em Hodge filtration
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi ℂ
                  %annotation{:encoding => "application/x-tex"} H_{\mathbb{C}}
              is the
              %a.existingWikiWord{:href => "/nlab/show/filtered+complex"} filtered complex
              structure given by the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi p
                    %msub
                      %mi H
                      %mi ℂ
                    %mo ≔
                    %munder
                      %mo ⊕
                      %mrow
                        %mi k
                        %mo −
                        %mi q
                        %mo ≥
                        %mi p
                    %msup
                      %mi H
                      %mrow
                        %mi k
                        %mo −
                        %mi q
                        %mo ,
                        %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F^p H_{\mathbb{C}}
                    \\coloneqq
                    \\underset{k-q \geq p}{\oplus}
                    H^{k-q,q}
                    \\,.
