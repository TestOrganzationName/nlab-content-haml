          %p These are subject to the following axioms:
          %ol
            %li
              For any composable triplet of
              = succeed "-cells" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi Ob
                      %mrow
                        %mi ℭ
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mi D
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi Ob
                      %mrow
                        %mi ℭ
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo ,
                        %mi C
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi Ob
                      %mrow
                        %mi ℭ
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,g,h)\in Ob_{\mathfrak{C}(C,D)}\times Ob_{\mathfrak{C}(B,C)}\times Ob_{\mathfrak{C}(A,B)}
              we have that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi γ
                        %mrow
                          %mi f
                          %mo ,
                          %mi g
                      %mo ⋆
                      %msub
                        %mn 1
                        %mrow
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mi h
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %msub
                        %mi γ
                        %mrow
                          %mi f
                          %mo ∘
                          %mi g
                          %mo ,
                          %mi h
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mn 1
                        %mrow
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mo ⋆
                      %msub
                        %mi γ
                        %mrow
                          %mi g
                          %mo ,
                          %mi h
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %msub
                        %mi γ
                        %mrow
                          %mi f
                          %mo ,
                          %mi g
                          %mo ∘
                          %mi h
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      (\gamma_{f,g}\star 1_{P(h)})\circ\gamma_{f\circ g,h}=(1_{P(f)}\star\gamma_{g,h})\circ\gamma_{f,g\circ h},
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∘
                    %annotation{:encoding => "application/x-tex"} \circ
                denotes vertical composition and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋆
                    %annotation{:encoding => "application/x-tex"} \star
                denotes horizontal composition, as illustrated by the following commutative
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
