              %a.existingWikiWord{:href => "/nlab/show/Bicat"} Bicat
              of bicategories, pseudofunctors,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pseudonatural+transformations"} pseudonatural transformations
              %a.existingWikiWord{:href => "/nlab/show/modifications"} modifications
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to its full sub-3-category spanned by the strict 2-categories. However, it is not equivalent to the
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} 3
              %span.newWikiWord
                Str2Cat
                %a{:href => "/nlab/new/Str2Cat"} ?
              of strict
              = succeed "-categories," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
              %em strict
              = succeed "-functors," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
              = succeed "-functor\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
