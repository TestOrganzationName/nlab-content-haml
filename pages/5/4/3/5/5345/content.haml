                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %annotation{:encoding => "application/x-tex"} \mathbf{f} \colon \mathbf{H}(x,x) \to \mathbf{K}\big(\mathbf{f}(x), \mathbf{f}(x)\big)
                      is a
                      = succeed "." do
                        %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              %li#CofIsRetractOfFree
                %p
