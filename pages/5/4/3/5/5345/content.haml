          = succeed "." do
            %a{:href => "#GoerssJardine09"} Goerss &amp; Jardine (2009), p. 316 and after cor V.7.3
          %p
          #RelationToModelStructureOnSimplicialGroups.num_remark
            %h6 Remark
            %p
              %strong (relation to model structure on simplicial groups)
              %br/
              An
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi sGrpd
                      %mi DK
                  %annotation{:encoding => "application/x-tex"} X \in sGrpd_{DK}
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
