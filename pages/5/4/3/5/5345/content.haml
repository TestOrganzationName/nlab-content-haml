                    %mi DK
                %annotation{:encoding => "application/x-tex"} sGrpd_{DK}
            for the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoids"} simplicial groupoids
            (whose
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            of
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are understood to be constant, see the discussion
            = succeed ")." do
              %a{:href => "simplicial+groupoid#Definition"} there
          %p
          #FreeMorphismsOfSimplicialGroupoids.num_defn
            %h6 Definition
            %p
              %strong (free morphisms of simplicial groupoids)
              %br/
              Say that a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{f} \colon \mathbf{X} \to \mathbf{Y}
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoids"} simplicial groupoids
              is
              %em free
              iff:
            %ol
              %li
                %p
                  it is degreewise
                  %a.existingWikiWord{:href => "/nlab/show/injective"} injective
                  (i.e. on the
                  %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                  of
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  and on the sets of
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
