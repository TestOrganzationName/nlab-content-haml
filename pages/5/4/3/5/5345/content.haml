            %p
          This is essentially
          = succeed "," do
            %a{:href => "#DwyerKan84"} Dwyer &amp; Kan (1984), Prop. 2.9, 2.10
          = succeed "." do
            %a{:href => "#Bergner08"} Bergner (2008), Thm. 2.2
          %p
          .num_prop
            %h6 Proposition
            %p
              The model structure on simplicial groupoids from Prop.
              %a.maruku-ref{:href => "#TheModelStructure"}
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+proper+model+category"} right proper
          This is
          = succeed "." do
            %a{:href => "#Bergner08"} Bergner (2008), Prop. 2.5
          %h3#RelationToSimplicialGroups Relation to simplicial groups
          %p
          .num_remark
            %h6 Remark
            %p
              Forming simplicial
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              of
              %a.existingWikiWord{:href => "/nlab/show/1-categories"} 1-categories
              from
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groups"} simplicial groups
              to
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+groupoids"} enriched groupoids
              (DK-
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoids"}> simplicial groupoids
              ):
            #eq:SimplicialDeloopingGroupoid.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi sGrp
                          %mtd
                            %mo ↪
                          %mtd
                            %mi sSet
                            %mtext -
                            %mi Grpd
                        %mtr
                          %mtd
                            %mi 𝒢
                          %mtd
                            %mo ↦
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi 𝒢
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    sGrp &amp;\hookrightarrow&amp; sSet\text{-}Grpd
                    \\\
                    \\mathcal{G} &amp;\mapsto&amp; \mathbf{B}\mathcal{G}
                    \\mathrlap{\,.}
                    }
            %p
              With respect to the above model structure (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#TheModelStructure"}
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              and
              %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+groups"} model structure on simplicial groups
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              and thus fails to be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
          %h3#relation_to_skeletal_simplicial_groupoids Relation to skeletal simplicial groupoids
          %p
            The following proposition assumes the
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            in the underlying category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
          %p
          #BifibrantResolutionBySkeleta.num_prop
            %h6 Proposition
            %p
              Every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %mtext -
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathbf{X} \,\in\, sSet\text{-}Grpd
              has a
              %a.existingWikiWord{:href => "/nlab/show/bifibrant+object"} bifibrant
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              by a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/skeletal+groupoid"} skeletal groupoid
          Here we mean a skeletal
          = succeed "-" do
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
          = succeed "," do
            %a.existingWikiWord{:href => "/nlab/show/enriched+groupoid"} enriched groupoid
          %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
          of simplicial
          %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
          = succeed "." do
            %a.maruku-eqref{:href => "#eq:SimplicialDeloopingGroupoid"} (2)
          .proof
            %h6 Proof
            %p
              By the existence of the model structure (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#TheModelStructure"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} cofibrant resolution
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %a.existingWikiWord{:href => "/nlab/show/deformation+retraction"} deformation retraction
              onto a skeleton (by
              = succeed "," do
                %a{:href => "simplicial+groupoid#SimplicialGroupoidsAdjointEquivalentToSkeleta"} this Prop.
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              %a{:href => "model+category#ClosureOfMorphisms"} preserved
              by
              %a.existingWikiWord{:href => "/nlab/show/retraction"} retraction
              it follows that every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              has a
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} cofibrant resolution
              by a skeleton. To conclude we just need to see that skeletal simplicial groupoids are fibrant, which is the case by
              = succeed "." do
                %a{:href => "simplicial+group#EverySimplicialGroupIsAKanComplex"} Moore’s theorem
          %h3#relation_to_simplicial_sets Relation to simplicial sets
          %p
          #QuillenEquivalenceWithSimplicialSets.num_prop
            %h6 Proposition
            %p
            %p The
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Dwyer-Kan+loop+groupoid"}> Dwyer-Kan loop groupoid
                  \-construction
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒢
                      %annotation{:encoding => "application/x-tex"} \mathcal{G}
                  (
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"}> left adjoint
                  )
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"}> simplicial classifying space
                  \-construction
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi W
                          %mo ¯
                      %annotation{:encoding => "application/x-tex"} \overline{W}
                  (
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"}> right adjoint
                  , see
                  = succeed ")" do
                    %a{:href => "simplicial+classifying+space#BarWForSimplicialGroupoid"} here
            %p
              constitute a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sGrpd
                      %mi DK
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mo ≃
                          %mrow
                            %msub
                              %mo
                              %mpadded{:width => "0"}
                                %mi Qu
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟶
                        %mover
                          %mi W
                          %mo ¯
                      %mover
                        %mo ⟵
                        %mi 𝒢
                    %msub
                      %mi sSet
                      %mi Qu
                  %annotation{:encoding => "application/x-tex"}
                    sGrpd_{DK}
                    \\underoverset
                    {\underset{\overline{W}}{\longrightarrow}}
                    {\overset{\mathcal{G}}{\longleftarrow}}
                    {\;\;\;\; \simeq_{_{\mathrlap{Qu}}} \;\;\;\;}
                    sSet_{Qu}
            %p
              between the model structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sGrpd
                      %mi DK
                  %annotation{:encoding => "application/x-tex"} sGrpd_{DK}
              from Prop.
              %a.maruku-ref{:href => "#TheModelStructure"}
              and the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
            %p
              In addition both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline W
              preserve all
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            %p
          %p
            This is due to
            = succeed "," do
              %a{:href => "#DwyerKan84"} Dwyer &amp; Kan (1984), Thm. 3.3
            = succeed "." do
              %a{:href => "#GoerssJardine"} Goerss &amp; Jardine (2009), Thm. 7.8
          .num_remark
            %h6#remark Remark
            %p
              When restricted to simplicial groupoids of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (\mathbf{B} G)_\bullet
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mo •
                  %annotation{:encoding => "application/x-tex"} G_\bullet
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} G_n
              its
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              this produces a standard presentation of
              %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
              for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/infinity-groups"} infinity-groups
              %em
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+groups"} model structure on simplicial groups
              for more.
          %p
          #AcyclicFibrationsSurjectiveOnObjects.num_lemma
            %h6 Lemma
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/acyclic+fibration"} acyclic fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi Fib
                    %mo ∩
                    %mi{:mathvariant => "normal"} W
                  %annotation{:encoding => "application/x-tex"} f \in Fib \cap \mathrm{W}
              of simplicial groupoids is
              %a.existingWikiWord{:href => "/nlab/show/surjective"} surjective
              on objects.
          One lazy way to see this:
          .proof
            %h6 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo ∈
                    %mi Fib
                    %mo ∩
                    %mi{:mathvariant => "normal"} W
                  %annotation{:encoding => "application/x-tex"} f_\bullet \in Fib \cap \mathrm{W}
              an acyclic Kan fibration, notice that:
            %ol
              %li
                %p
                  Since the
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
                  functor on simplicial groupoids (
                  %a{:href => "simplicial+classifying+space#BarWForSimplicialGroupoid"}> here
                  ) is a
                  %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
                  by Prop.
                  %a.maruku-ref{:href => "#QuillenEquivalenceWithSimplicialSets"}
                  it follows that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi W
                          %mo ¯
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi Fib
                        %mo ∩
                        %mi{:mathvariant => "normal"} W
                      %annotation{:encoding => "application/x-tex"} \overline{W}(f) \in Fib \cap \mathrm{W}
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/acyclic+Kan+fibration"} acyclic Kan fibration
              %li
                %p
                  All acylic fibrations in the
                  %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
                  are degreewise surjective (see
                  = succeed ")." do
                    %a{:href => "acyclic+Kan+fibration#AcyclicKanFibrationsAreSurjective"} this Prop.
            %p
              But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{W}
              is the identity on the sets of objects/vertices (by its definition
              = succeed ")," do
                %a{:href => "simplicial+classifying+space#BarWForSimplicialGroupoid"} here
          %p Also useful to notice is:
          %p
          #sGrpdCofibrationIsObjectwiseSSetCofibration.num_prop
            %h6 Proposition
            %p
              A (acyclic) cofibration of simplicial groupoids is
              = succeed "-wise" do
                %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} Kan-Quillen
              (acyclic) cofibration, of simplicial
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
          .proof
            %h6 Proof
            %p
              By Def.
              %a.maruku-ref{:href => "#FreeMorphismsOfSimplicialGroupoids"}
              and Prop.
              %a.maruku-ref{:href => "#TheModelStructure"}
              these cofibrations of simplicial groupoids are, in particular, retracts of monomorphisms of simplicial sets. Since
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %a.existingWikiWord{:href => "/nlab/show/epi-mono+factorization+system"} epi-mono factorization system
              implies that monomorphisms are preserved under retracts. And of course also the Kan-Quillen weak equivalences are preserved under retracts.
          %h3#RelationToSimplicialCategories Relation to simplicial categories
          %p
          .num_prop
            %h6 Proposition
            %p The canonical inclusion functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %mtext -
                    %mi Grpd
                    %mover
                      %mo ↪
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                    %mi sSet
                    %mtext -
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    \\iota
                    \\,\colon\,
                    sSet\text{-}Grpd
                    \\xhookrightarrow{\phantom{--}}
                    sSet\text{-}Cat
            %p
              of the category of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+groupoids"} enriched groupoids
              into that of
              %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+categories"} sSet-enriched categories
            %ol
              %li
                %p
                  has a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  = succeed "-construction" do
                    %a.existingWikiWord{:href => "/nlab/show/free+groupoid"} free groupoid
                  %a.existingWikiWord{:href => "/nlab/show/localization+of+a+category"} localization
                  at the class of all morphisms)
              %li
                %p
                  evidently preserves fibrations and weak equivalences between the above model structures on simplicial groupoids and the Bergner-
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+sSet-categories"} model structure on sSet-categories
                  (see
                  = succeed ")," do
                    %a{:href => "model+structure+on+sSet-categories#ModelForInfinityCategories"} there
            %p
              hence we have a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            #eq:SimplicialGroupoidificationAdjunction.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                    %mtext -
                    %msub
                      %mi Grpd
                      %mi DK
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mo ⊥
                          %mi{:mathvariant => "normal"} Qu
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ↪
                        %mi ι
                      %mover
                        %mo ⟵
                        %mi F
                    %mi sSet
                    %mtext -
                    %msub
                      %mi Cat
                      %mi Berg
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sSet\text{-}Grpd_{DK}
                    \\underoverset
                    {\underset{\iota}{\hookrightarrow}}
                    {\overset{F}{\longleftarrow}}
                    {\;\;\; \bot_{\mathrm{Qu}} \;\;\;}
                    sSet\text{-}Cat_{Berg}
                    \\,.
            %p
          (see also
          = succeed ")" do
            %a{:href => "#MinichielloRiveraZeinalian23"} Minichiello, Rivera &amp; Zeinalian (2023), Prop. 2.8
          %p
            Consider the
            %a.existingWikiWord{:href => "/nlab/show/pair"} pair
            of
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            given by
            %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            and
            %a.existingWikiWord{:href => "/nlab/show/rigidification+of+quasi-categories"} rigidification of quasi-categories
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℭ
                  %annotation{:encoding => "application/x-tex"} \mathfrak{C}
          #eq:HoCoherentNerveAndRigidificationAdjunction.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                  %mtext -
                  %msub
                    %mi Cat
                    %mi Berg
                  %munderover
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊥
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⟶
                      %mi N
                    %mover
                      %mo ⟵
                      %mi ℭ
                  %mi sSet
                %annotation{:encoding => "application/x-tex"}
                  sSet\text{-}Cat_{Berg}
                  \\underoverset
                  {\underset{N}{\longrightarrow}}
                  {\overset{\mathfrak{C}}{\longleftarrow}}
                  {\;\;\; \bot \;\;\;}
                  sSet
          %p
            This is a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            with respect to the
            %a.existingWikiWord{:href => "/nlab/show/Joyal+model+structure"} Joyal model structure
            for
            %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
            on the right, but next we are after a slightly different role of this adjunction:
          #ComparisonFromLocalizationOfRigidificationAndToDKGroupoid.num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} S \in sSet
              there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∘
                    %mi ℭ
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F \circ \mathfrak{C}(S)
                    \\longrightarrow
                    \\mathcal{G}(S)
            %p
              which is a
              %a.existingWikiWord{:href => "/nlab/show/Dwyer-Kan+equivalence"} Dwyer-Kan equivalence
              (from the localization
              %a.maruku-eqref{:href => "#eq:SimplicialGroupoidificationAdjunction"} (3)
              of the rigidification
              %a.maruku-eqref{:href => "#eq:HoCoherentNerveAndRigidificationAdjunction"} (4)
              to the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Dwyer-Kan+fundamental+simplicial+groupoid"} Dwyer-Kan fundamental simplicial groupoid
          \&amp;lbrack;
          %a{:href => "#MinichielloRiveraZeinalian23"}> Minichiello, Rivera &amp; Zeinalian (2023), Thm. 1.1 (Cor. 4.2)
          \&amp;rbrack;
          %p
            As a corollary:
          #LocalizationOfRegidificationAsLeftQuillenFunctor.num_prop
            %h6 Proposition
            %p
              The composite of the adjunctions
              %a.maruku-eqref{:href => "#eq:SimplicialGroupoidificationAdjunction"} (3)
              and
              %a.maruku-eqref{:href => "#eq:HoCoherentNerveAndRigidificationAdjunction"} (4)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                    %mtext -
                    %msub
                      %mi Grpd
                      %mi DK
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⊥
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ↪
                        %mi ι
                      %mover
                        %mo ⟵
                        %mi F
                    %mi sSet
                    %mtext -
                    %mi Cat
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⊥
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟶
                        %mi N
                      %mover
                        %mo ⟵
                        %mi ℭ
                    %msub
                      %mi sSet
                      %mi KQ
                  %annotation{:encoding => "application/x-tex"}
                    sSet\text{-}Grpd_{DK}
                    \\underoverset
                    {\underset{\iota}{\hookrightarrow}}
                    {\overset{F}{\longleftarrow}}
                    {\;\;\; \bot \;\;\;}
                    sSet\text{-}Cat
                    \\underoverset
                    {\underset{N}{\longrightarrow}}
                    {\overset{\mathfrak{C}}{\longleftarrow}}
                    {\;\;\; \bot \;\;\;}
                    sSet_{KQ}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              between the Dwyer-Kan model structure from Prop.
              %a.maruku-ref{:href => "#TheModelStructure"}
              and the
              %a.existingWikiWord{:href => "/nlab/show/Kan-Quillen+model+structure"} Kan-Quillen model structure
              on simplicial sets.
          .proof
            %h6 Proof
            %p
              It is sufficient to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∘
                    %mi ℭ
                  %annotation{:encoding => "application/x-tex"} F \circ \mathfrak{C}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
              %a.existingWikiWord{:href => "/nlab/show/Joyal+model+structure"} Joyal model structure
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℭ
                    %mo ⊣
                    %mi N
                  %annotation{:encoding => "application/x-tex"} \mathfrak{C} \dashv N
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              (
              %a{:href => "relation+between+quasi-categories+and+simplicial+categories#TheQuillenEquivalence"}> this Prop.
              ) so that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ∘
                      %mi ℭ
                    %annotation{:encoding => "application/x-tex"} F \circ \mathfrak{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℭ
                  %annotation{:encoding => "application/x-tex"} \mathfrak{C}
              with the left Quillen functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              %a.maruku-eqref{:href => "#eq:SimplicialGroupoidificationAdjunction"} (3)
              is itself left Quillen. But the
              %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
              of the
              %a.existingWikiWord{:href => "/nlab/show/Joyal+model+structure"} Joyal model structure
              coincide with those of the
              %a.existingWikiWord{:href => "/nlab/show/Kan-Quillen+model+structure"} Kan-Quillen model structure
              on
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              (both being
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∘
                    %mi ℭ
                  %annotation{:encoding => "application/x-tex"} F \circ \mathfrak{C}
              also preserves the Kan-Quillen cofibrations. To conclude it is therefore sufficient to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∘
                    %mi ℭ
                  %annotation{:encoding => "application/x-tex"} F \circ \mathfrak{C}
              sends all
              %a.existingWikiWord{:href => "/nlab/show/simplicial+weak+homotopy+equivalences"} simplicial weak homotopy equivalences
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Dwyer-Kan+equivalences"} Dwyer-Kan equivalences
              %a.maruku-ref{:href => "#ComparisonFromLocalizationOfRigidificationAndToDKGroupoid"}
              every map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo ⟶
                    %mi S
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f \colon S \longrightarrow S'
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              gives rise to a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              in
              %a.existingWikiWord{:href => "/nlab/show/sSet+Cat"} sSet Cat
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mo ∘
                            %mi ℭ
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi F
                                %mo ∘
                                %mi ℭ
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi F
                            %mo ∘
                            %mi ℭ
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                        %mtr
                          %mtd
                            %mi 𝒢
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mi 𝒢
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi 𝒢
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo ′
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F \circ \mathfrak{C}(S)
                    \&amp;\overset{F \circ \mathfrak{C}(f)}{\longrightarrow}&amp;
                    F \circ \mathfrak{C}(S')
                    \\\
                    \\Big\downarrow
                    \&amp;&amp;
                    \\Big\downarrow
                    \\\
                    \\mathcal{G}(S)
                    \&amp;\underset{\;\; \mathcal{G}(f) \;\;}{\longrightarrow}&amp;
                    \\mathcal{G}(S')
                    }
            %p
              where the vertical morphisms are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Dwyer-Kan+equivalences"} Dwyer-Kan equivalences
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/Dwyer-Kan+fundamental+simplicial+groupoid"} Dwyer-Kan fundamental simplicial groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              preserves all weak equivalences by
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Ken+Brown%27s+lemma"} Ken Brown's lemma
              %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
              on a model category all whose objects are cofibrant. Therefore also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∘
                    %mi ℭ
                  %annotation{:encoding => "application/x-tex"} F \circ \mathfrak{C}
              preserves all weak equivalences, by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/2-out-of-3"} 2-out-of-3
          %h2#Examples Examples
          %h3#FiberProductsWithActionOneGroupoids Fiber products with action 1-groupoids
          %p
            While the underlying category of
            %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+groupoids"} sSet-enriched groupoids
            is
            %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+monoidal+category"} cartesian closed
            (see
            = succeed ")," do
              %a{:href => "simplicial+groupoid#CartesianClosedStructure"} there
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+model+category"} cartesian monoidal as a model structure
          %p
            But here is a (very) simple special case at least of an
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            Quillen adjunction for
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/1-groupoids"} 1-groupoids
          %p#AssumptionForFiberProductWithActionOneGroupoid Consider:
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/group"} group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi Grp
                        %mo{:stretchy => "false"} (
                        %mi Set
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G \,\in\, Grp(Set)
            %li
              %p
                with
                %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
                denoted
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi Grpd
                        %mo{:stretchy => "false"} (
                        %mi Set
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi sSet
                        %mtext -
                        %mi Grpd
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G \,\in\, Grpd(Set) \subset sSet\text{-}Grpd
            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited set
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} W \,\in\, Set
            %li
              %p
                equipped with a
                %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo ↷
                        %mi W
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi G
                        %mi Act
                        %mo{:stretchy => "false"} (
                        %mi Set
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G \curvearrowright W \,\in\, G Act(Set)
            %li
              %p
                with
                %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
                denoted
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mo ⫽
                        %mi G
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi Grpd
                        %mo ↪
                        %mi sSet
                        %mtext -
                        %mi Grpd
                      %annotation{:encoding => "application/x-tex"} W \sslash G \,\in\, Grpd \hookrightarrow sSet\text{-}Grpd
              %p
                canonically regarded in the
                %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi sSet
                        %mtext -
                        %msub
                          %mi Grpd
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                      %annotation{:encoding => "application/x-tex"} sSet\text{-}Grpd_{/\mathbf{B}G}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+groupoids"} sSet-enriched groupoids
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi sSet
                      %mtext -
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \;\mathbf{X}, \mathbf{Y} \,\in\, sSet\text{-}Grpd
                lifted to the
                %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
                via
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mstyle{:mathvariant => "bold"}
                            %mi X
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi p
                          %mstyle{:mathvariant => "bold"}
                            %mi Y
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi sSet
                        %mtext -
                        %msub
                          %mi Grpd
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                      %annotation{:encoding => "application/x-tex"} p_\mathbf{X},\, p_\mathbf{Y} \,\in\, sSet\text{-}Grpd_{/\mathbf{B}G}
          %p
          #FiberProductWithActionOneGroupoidPreservesCofibrations.num_lemma
            %h6 Lemma
            %p
              With the
              = succeed "," do
                %a{:href => "#AssumptionForFiberProductWithActionOneGroupoid"} above assumptions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{f} \colon \mathbf{X} \to \mathbf{Y}
              a morphism in the slice over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              which is a cofibration in the
              %a.existingWikiWord{:href => "/nlab/show/slice+model+category"} slice model category
              in that its
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                    %mtext -
                    %mi Grpd
