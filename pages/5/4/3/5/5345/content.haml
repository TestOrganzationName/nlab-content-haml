                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mover
                              %mi ω
                              %mo{:stretchy => "false"} ^
                            %mo{:lspace => "verythinmathspace"} :
                            %mi x
                            %mo →
                            %mi z
                          %annotation{:encoding => "application/x-tex"} \hat \omega \colon x \to z
                      of
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi H
                              %mn 0
                          %annotation{:encoding => "application/x-tex"} H_0
                      such that
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi f
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi ω
                                %mo{:stretchy => "false"} ^
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mi ω
                            %annotation{:encoding => "application/x-tex"} \mathbf{f}(\hat \omega) = \omega
                  %li
                    %p
                      for every object
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi x
                          %annotation{:encoding => "application/x-tex"} x
                      in
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                          %annotation{:encoding => "application/x-tex"} \mathbf{H}
                      the induced morphism
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi f
                            %mo{:lspace => "verythinmathspace"} :
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
