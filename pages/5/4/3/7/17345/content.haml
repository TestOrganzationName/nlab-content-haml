          %title Contents
          %hr/
          %p
            This page is an introduction to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequences"} spectral sequences
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequences+of+filtered+complexes"} spectral sequences of filtered complexes
            from the computation of
            %a.existingWikiWord{:href => "/nlab/show/cellular+cohomology"} cellular cohomology
            via stratum-wise
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative cohomology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequences+of+filtered+spectra"} spectral sequences of filtered spectra
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            For background on
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Introduction+to+Homological+algebra"} Introduction to Homological algebra
          %p
            For background on
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory"} Introduction to Stable homotopy theory
          %p
            For application to
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology"} complex oriented cohomology
            see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Cobordism+and+Complex+Oriented+Cohomology"} Introduction to Cobordism and Complex Oriented Cohomology
          %p
            For application to the
            %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            see
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+2"} Introduction to Adams spectral sequences
          %hr/
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#SpectralSequencesForFilteredChainComplexes"} For filtered complexes
              %ul
                %li
                  %a{:href => "#ordinary_homology"} Ordinary homology
                %li
                  %a{:href => "#cellular_homology"} Cellular homology
                %li
                  %a{:href => "#filtered_chain_complexes"} Filtered chain complexes
                %li
                  %a{:href => "#comparing_cellular_and_singular_homology"} Comparing cellular and singular homology
              %li
                %a{:href => "#SpectralSequencesForFilteredSpectra"} For filtered spectra
              %li
                %a{:href => "#References"} References
          %p
            In
            %em
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1"} Introduction to Stable homotopy theory
            we have set up the concept of
            %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and their
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_\bullet(X)
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyGroups"}> def.
            ). More generally for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            two spectra then there is the graded stable homotopy group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                %annotation{:encoding => "application/x-tex"} [X,Y]_\bullet
            of homotopy classes of maps bewteen them (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#GradedAbelianGroupStructureOnHomsInTheHomotopyCategory"}> def.
            ). These may be thought of as
            %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized cohomology
            groups (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#ForASpectrumXGeneralizedECohomology"}> exmpl.
            ). Moreover, in
            %em
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1-2"} part 1.2
            we discussed the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∧
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \wedge Y
            %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
            groups (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#EMHomology"}> rmk.
            ).
          %p
            These stable homotopy and generalized (co-)homology groups are the fundamental invariants in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+2"} part 2
          %p
            In general the only practicable way to carry out such computations is by doing them along a decomposition of the given spectrum into a “sequence of stages” of sorts. The concept of
            %em
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
            is what formalizes this idea.
          %p (Here the re-occurence of the root “spectr-” it is a historical coincidence, but a lucky one.)
          %p Here we give an expository introduction to the concept of spectral sequences, building up in detail to the spectral sequence of a filtered complex.
          %p We put these spectral sequences to use in
          %ul
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+2"}> part 2 – Adams spectral sequences
                  \.
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+S"} part S – Complex oriented cohomology theory
          %h2#SpectralSequencesForFilteredChainComplexes For filtered complexes
          %p
            We begin with recalling basics of
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary
            %em
              %a.existingWikiWord{:href => "/nlab/show/relative+homology"} relative homology
            and then seamlessly derive the notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequences"} spectral sequences
            from that as the natural way of computing the ordinary cohomology of a
            %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
            stagewise from the relative cohomology of its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} skeleta
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/filtered+spectra"} filtered spectra
            = succeed "." do
              %a{:href => "#SpectralSequencesForFilteredSpectra"} next
          %h3#ordinary_homology Ordinary homology
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} A \hookrightarrow X
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_\bullet(X)
            for the
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of
            %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_\bullet(A) \hookrightarrow C_\bullet(X)
            for the
            %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            induced by the subspace inclusion.
          #RelativeSingularHomology.num_defn
            %h6#definition Definition
            %p
              The (degreewise)
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
              of this inclusion, hence the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet(X)/C_\bullet(A)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet(X)
              by the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet(A)
              under the inclusion, is the
              = succeed "." do
                %strong
                  chain complex of
                  = succeed "-relative" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
            %ul
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                  in this quotient is called an
                  = succeed "," do
                    %strong
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi A
                          %annotation{:encoding => "application/x-tex"} A
                      \-relative singular boundary
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
                  is called an
                  = succeed "." do
                    %strong
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi A
                          %annotation{:encoding => "application/x-tex"} A
                      \-relative singular cycle
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
                  of the quotient is the
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                    \-relative singular homology of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %msub
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi C
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi C
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        H_n(X , A)\coloneqq H_n(C_\bullet(X)/C_\bullet(A))
                        \\,.
          .num_remark
            %h6#remark Remark
            %p
              This means that a singular
              = succeed "-chain" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %msub
                      %mi C
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \in C_{n+1}(X)
              is an
              = succeed "-relative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi c
                    %mo ∈
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \partial c \in C_{n}(X)
              is, while not necessarily 0, contained in the
              = succeed "-chains" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mi c
                      %mo ∈
                      %msub
                        %mi C
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %msub
                        %mi C
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \partial c \in C_n(A) \hookrightarrow C_n(X)
              = succeed "\u201D." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            We record two evident but important classes of
            %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences"} long exact sequences
            that relative homology groups sit in:
          #RelativeHomologyLongExactSequence.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ↪
                      %mi i
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \stackrel{i}{\hookrightarrow} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              inclusion. The corresponding relative singular homology, def.
              = succeed "," do
                %a.maruku-ref{:href => "#RelativeSingularHomology"}
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi δ
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi H
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    H_n(A)
                    \\stackrel{H_n(i)}{\to}
                    H_n(X)
                    \\to
                    H_n(X, A)
                    \\stackrel{\delta_{n-1}}{\to}
                    H_{n-1}(A)
                    \\stackrel{H_{n-1}(i)}{\to}
                    H_{n-1}(X)
                    \\to
                    H_{n-1}(X, A)
                    \\to
                    \\cdots
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta_{n} \colon H_{n+1}(X, A) \to H_n(A)
              sends an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [c] \in H_{n+1}(X, A)
              represented by an
              = succeed "-relative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %msub
                        %mi C
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c \in C_{n+1}(X)
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi X
                      %mi c
                      %mo ∈
                      %msub
                        %mi C
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %msub
                        %mi C
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \partial^X c \in C_n(A) \hookrightarrow C_n(X)
          .proof
            %h6#proof Proof
            %p
              This is the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homology+long+exact+sequence"} homology long exact sequence
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mi i
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0 \to C_\bullet(A) \stackrel{i}{\hookrightarrow} C_\bullet(X) \to coker(i)  \simeq C_\bullet(X)/C_\bullet(A)  \to 0
              of chain complexes.
          #RelativeTripleHomologyLongExactSequence.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ↪
                    %mi A
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} B \hookrightarrow A \hookrightarrow X
              be a sequence of two
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              inclusions. Then there is a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/relative+singular+homology"} relative singular homology
              groups of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to H_n(A , B) \to H_n(X , B) \to H_n(X , A ) \to H_{n-1}(A , B) \to \cdots
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              Observe that we have a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of chain complexes, def.
              %a.maruku-ref{:href => "#ShortExactSequenceOfChainComplexes"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to C_\bullet(A)/C_\bullet(B) \to C_\bullet(X)/C_\bullet(B) \to C_\bullet(X)/C_\bullet(A) \to 0
                    \\,.
            %p
              The corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homology+long+exact+sequence"} homology long exact sequence
              = succeed "," do
                %a.maruku-ref{:href => "#HomologyLongExactSequence"}
          %p We look at some concrete fundamental examples in a moment. But first it is useful to make explicit the following general sub-notion of relative homology.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            still be a given
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
          .num_defn
            %h6#definition_2 Definition
            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/augmentation"} augmentation
                map
              for the
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon \colon C_0(X) \to \mathbb{Z}
            %p which adds up all the coefficients of all 0-chains:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:lspace => "verythinmathspace"} :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi n
                      %mi i
                    %msub
                      %mi σ
                      %mi i
                    %mo ↦
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi n
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon \colon \colon \sum_{i} n_i \sigma_i \mapsto \sum_i n_i
                    \\,.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              of a 1-chain is in the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of this map, by example
              = succeed "," do
                %a.maruku-ref{:href => "#BasicExamplesOfChainBoundaries"}
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon \colon C_\bullet(X) \to \mathbb{Z}
                    \\,,
            %p
              where now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              is regarded as a chain complex concentrated in degree 0.
          #ReducedSingularChainComplex.num_defn
            %h6#definition_3 Definition
            %p
              The
              %strong reduced singular chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi C
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde C_\bullet(X)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the augmentation map, the chain complex sitting in the
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mover
                        %mi C
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi ϵ
                    %mi ℤ
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to \tilde C_\bullet(C) \to C_\bullet(X) \stackrel{\epsilon}{\to} \mathbb{Z} \to 0
                    \\,.
            %p
              The
              %strong reduced singular homology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde H_\bullet(X)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              of the reduced singular chain complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi C
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde H_\bullet(X) \coloneqq H_\bullet(\tilde C_\bullet(X))
                    \\,.
          %p Equivalently:
          .num_defn
            %h6#definition_4 Definition
            %p
              The
              %strong reduced singular homology
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi H
                          %mo{:stretchy => "false"} ˜
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde H_\bullet(X)
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              of the
              %a.existingWikiWord{:href => "/nlab/show/augmentation"} augmented
              chain complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi C
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 1
                    %msub
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi ϵ
                    %mi ℤ
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to C_2(X) \stackrel{\partial_1}{\to} C_1(X) \stackrel{\partial_0}{\to} C_0(X) \stackrel{\epsilon}{\to}
                    \\mathbb{Z} \to 0
                    \\,.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_\bullet(X)
            its
            %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi H
                      %mo{:stretchy => "false"} ˜
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tilde H_\bullet(X)
            its reduced singular homology, def.
            = succeed "." do
              %a.maruku-ref{:href => "#ReducedSingularChainComplex"}
          #RelationBetweenReducedSingularAndSingular.num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              there is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mover
                                  %mi H
                                  %mo{:stretchy => "false"} ˜
                                %mi n
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mi for
                              %mspace{:width => "thickmathspace"}
                              %mi n
                              %mo ≥
                              %mn 1
                          %mtr
                            %mtd
                              %msub
                                %mover
                                  %mi H
                                  %mo{:stretchy => "false"} ˜
                                %mn 0
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                              %mo ⊕
                              %mi ℤ
                            %mtd
                              %mi for
                              %mspace{:width => "thickmathspace"}
                              %mi n
                              %mo =
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    H_n(X)
                    \\simeq
                    \\left\{
                    \\array{
                    \\tilde H_n(X) &amp; for \; n \geq 1
                    \\\
                    \\tilde H_0(X) \oplus \mathbb{Z} &amp; for\; n = 0
                    }
                    \\right.
          .proof
            %h6#proof_3 Proof
            %p
              The
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homology+long+exact+sequence"} homology long exact sequence
              = succeed "," do
                %a.maruku-ref{:href => "#HomologyLongExactSequence"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi C
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi ϵ
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \tilde C_\bullet(C) \to C_\bullet(X) \stackrel{\epsilon}{\to} \mathbb{Z}
              is, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              here is concentrated in degree 0, of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mo →
                    %mi ⋯
                    %mo →
                    %mn 0
                    %mo →
                    %mi ⋯
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi ϵ
                    %mi ℤ
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to \tilde H_n(X) \to H_n(X) \to 0 \to \cdots \to
                    0 \to
                    \\cdots \to \tilde H_1(X) \to H_1(X) \to 0 \to
                    \\tilde H_0(X) \to H_0(X) \stackrel{\epsilon}{\to}  \mathbb{Z} \to 0
                    \\,.
            %p
              Here
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exactness
              says that all the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde H_n(X) \to H_n(X)
              for positive
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℤ
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to \tilde H_0(X) \to H_0(X) \to \mathbb{Z} \to 0
            %p
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split
              = succeed "," do
                %a.maruku-ref{:href => "#SplittingLemma"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mover
                          %mi H
                          %mo{:stretchy => "false"} ˜
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} H_0(X) \simeq \tilde H_0(X) \oplus \mathbb{Z}
          .num_prop
            %h6#proposition_4 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X = *
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/point"} point
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    H_0(\epsilon) \colon H_0(X) \to \mathbb{Z}
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde H_\bullet(*) \simeq 0
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              By the discussion in section
              %a{:href => "#SimplicialHomology"} 2)
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℤ
                            %mtd
                              %mi for
                              %mspace{:width => "thickmathspace"}
                              %mi n
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_n(*) \simeq
                    \\left\{
                    \\array{
                    \\mathbb{Z} &amp; for \; n = 0
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
            %p
              Moreover, it is clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \epsilon \colon C_0(*) \to \mathbb{Z}
              is the
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              map.
          %p Now we can discuss the relation between reduced homology and relative homology.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              an
              %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/reduced+singular+homology"} reduced singular homology
              = succeed "," do
                %a.maruku-ref{:href => "#ReducedSingularChainComplex"}
              %a.existingWikiWord{:href => "/nlab/show/relative+singular+homology"} relative singular homology
              relative to any base point
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mo *
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \colon * \to X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde H_\bullet(X)
                    \\simeq
                    H_\bullet(X,*)
                    \\,.
          .proof
            %h6#proof_5 Proof
            %p
              Consider the sequence of
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ↪
                    %mo *
                    %mover
                      %mo ↪
                      %mi x
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\emptyset \hookrightarrow * \stackrel{x}{\hookrightarrow} X
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#RelativeTripleHomologyLongExactSequence"}
              this induces a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mo →
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi H
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    H_{n+1}(*) \to H_{n+1}(X) \to H_{n+1}(X,*)
                    \\to
                    H_n(*) \to H_n(X) \to H_n(X,*)
                    \\to
                    \\cdots
                    \\to
                    H_1(X) \to H_1(X,*) \to  H_0(*) \stackrel{H_0(x)}{\to}  H_0(X) \to H_n(X,*)
                    \\to 0
                    \\,.
            %p
              Here in positive degrees we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} H_n(*) \simeq 0
              and therefore
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exactness
              gives
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∀
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    H_n(X) \stackrel{\simeq}{\to} H_n(X,*)\;\; \forall_{n \geq 1}
            %p
              and hence with prop.
              %a.maruku-ref{:href => "#RelationBetweenReducedSingularAndSingular"}
              isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∀
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde H_n(X) \stackrel{\simeq}{\to} H_n(X,*)\;\; \forall_{n \geq 1}
                    \\,.
            %p
              It remains to deal with the case in degree 0. To that end, observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_0(x) \colon H_0(*) \to H_0(X)
              is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi H
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi id
                          %mtd
                            %msub
                              %mi H
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi H
                                    %mn 0
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi H
                                    %mn 0
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo ↗
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mo ≃
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi H
                                    %mn 0
                                  %mo{:stretchy => "false"} (
                                  %mi ϵ
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mi H
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi H
                                  %mn 0
                                %mo{:stretchy => "false"} (
                                %mi ϵ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    H_0(*) &amp;\stackrel{id}{\to}&amp; H_0(*)
                    \\\
                    {}^{\mathllap{H_0(x)}}\downarrow &amp;{}^{\mathllap{H_0(f)}}\nearrow&amp; \downarrow^{\mathrlap{H_0(\epsilon)}}_\simeq
                    \\\
                    H_0(X) &amp;\stackrel{H_0(\epsilon)}{\to}&amp; \mathbb{Z}
                    }
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} f \colon X \to *
              is the terminal map. That the outer square commutes means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_0(\epsilon) \circ H_0(x) = H_0(\epsilon)
              and hence the composite on the left is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_0(x)
              is an injection.
            %p
              Therefore we have a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              as shown in the top of this diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi H
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                                %msub
                                  %mi H
                                  %mn 0
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi H
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msub
                              %mi H
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi H
                                    %mn 0
                                  %mo{:stretchy => "false"} (
                                  %mi ϵ
                                  %mo{:stretchy => "false"} )
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0 &amp;\to&amp; H_0(*) &amp;\stackrel{H_0(x)}{\hookrightarrow}&amp;
                    H_0(X) &amp;\stackrel{}{\to}&amp; H_0(X,*)
                    \&amp;\to&amp;
                    0
                    \\\
                    \&amp;&amp; &amp; {}_{\mathllap{\simeq}}\searrow &amp; \downarrow^{\mathrlap{H_0(\epsilon)}} &amp;
                    \\\
                    \&amp;&amp; &amp;&amp; \mathbb{Z}
                    }
                    \\,.
            %p Using this we finally compute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi H
                                %mo{:stretchy => "false"} ˜
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mi ker
                            %msub
                              %mi H
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi ϵ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi coker
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi H
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mo *
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\tilde H_0(X)
                    \&amp; \coloneqq
                    ker H_0(\epsilon)
                    \\\
                    \&amp; \simeq coker( H_0(x) )
                    \\\
                    \&amp; \simeq H_0(X,*)
                    \\end{aligned}
                    \\,.
          %p
            With this understanding of homology
            %em relative to a point
            in hand, we can now characterize relative homology more generally. From its definition in def.
            = succeed "," do
              %a.maruku-ref{:href => "#RelativeSingularHomology"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_n(X,A)
            provides information about the quotient topological space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X/A
          #GoodPair.num_defn
            %h6#definition_5 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \hookrightarrow X
              is called a
              %strong good pair
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is
                  %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
                  inside
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  has an
                  %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ↪
                        %mi U
                        %mo ↪
                        %mi X
                      %annotation{:encoding => "application/x-tex"} A \hookrightarrow U \hookrightarrow X
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ↪
                        %mi U
                      %annotation{:encoding => "application/x-tex"} A \hookrightarrow U
                  has a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/deformation+retract"} deformation retract
          #HomologyOfQuotientSpace.num_prop
            %h6#proposition_6 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \hookrightarrow X
              is a
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              inclusion which is
              %em good
              in the sense of def.
              = succeed "," do
                %a.maruku-ref{:href => "#GoodPair"}
              = succeed "-relative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              coincides with the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/reduced+singular+homology"} reduced singular homology
              = succeed "," do
                %a.maruku-ref{:href => "#ReducedSingularChainComplex"}
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi A
                    %annotation{:encoding => "application/x-tex"} X/A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_n(X/A)
                    \\simeq
                    \\tilde H_n(X , A)
                    \\,.
          %p
            The proof of this is spelled out at
            = succeed "." do
              %em
                %a{:href => "relative%20homology#RelationToQuotientTopologicalSpaces"} Relative homology – relation to quotient topological spaces
            %em
              %a{:href => "http://ncatlab.org/nlab/show/relative%20homology#Excision"} Excision property
            of relative homology. While important, here we will not further dwell on this. The interested reader can find more information behind the above links.
          %h3#cellular_homology Cellular homology
          %p
            With the general definition of relative homology in hand, we now consider the basic
            %em cells
            such that
            %em
              %a.existingWikiWord{:href => "/nlab/show/cell+complexes"} cell complexes
            built from such cells have tractable relative homology groups. Actually, up to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            %em every
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
            is given by such a
            %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
            and hence its relative homology, then called
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/cellular+homology"} cellular homology
          .num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              write
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi D
                          %mi n
                        %mo ↪
                        %msup
                          %mi ℝ
                          %mi n
                        %mo ∈
                      %annotation{:encoding => "application/x-tex"} D^n \hookrightarrow \mathbb{R}^n \in
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  for the standard
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/disk"} disk
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo ↪
                        %msup
                          %mi ℝ
                          %mi n
                        %mo ∈
                      %annotation{:encoding => "application/x-tex"} S^{n-1} \hookrightarrow \mathbb{R}^{n} \in
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                  for the standard
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n-1)
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
                %p
                  (notice that the 0-sphere is the disjoint union of
                  = succeed "," do
                    %em two points
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 0
                          %mo =
                          %mo *
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mo *
                        %annotation{:encoding => "application/x-tex"} S^0 = * \coprod *
                  = succeed "-sphere" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (-1)
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ↪
                        %msup
                          %mi D
                          %mi n
                      %annotation{:encoding => "application/x-tex"} S^{-1} \hookrightarrow D^{n}
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                  that includes the
                  = succeed "-sphere" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n-1)
                  %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                  of the
                  = succeed "-disk." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
          .num_example
            %h6#example Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/reduced+singular+homology"} reduced singular homology
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^{n}
              equals the
              = succeed "-relative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} S^{n-1}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/disk"} disk
              with respect to the canonical
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              inclusion
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo ↪
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^{n-1} \hookrightarrow D^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %mo ,
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde H_\bullet(S^n) \simeq H_\bullet(D^n, S^{n-1})
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              The
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              is
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/disk"} disk
              with its entire
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              identified with a point:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ≃
                    %msup
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^n \simeq D^n/S^{n-1}
                    \\,.
            %p
              Moreover the boundary inclusion is a
              %em good pair
              in the sense of def.
              = succeed "." do
                %a.maruku-ref{:href => "#GoodPair"}
              = succeed "." do
                %a.maruku-ref{:href => "#HomologyOfQuotientSpace"}
          %p
            When forming
            %a.existingWikiWord{:href => "/nlab/show/cell+complexes"} cell complexes
            from disks, then each relative dimension will be a
            %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
            of disks:
          #WedgeSum.num_defn
            %h6#definition_7 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %msub
                      %mi X
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \{x_i \colon * \to X_i\}_i
              a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              %em
                %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∨
                      %mi i
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \vee_i X_i
              is the result of identifying all base points in their
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                      %msub
                        %mi X
                        %mi i
                      %mo )
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi i
                      %mo *
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\coprod_i X_i
                    \\right)/
                    \\left(
                    \\coprod_i *
                    \\right)
                    \\,.
          .num_example
            %h6#example_2 Example
            %p
              The wedge sum of two pointed
              %a.existingWikiWord{:href => "/nlab/show/circles"} circles
              is the “figure 8”-topological space.
          #ReducedHomologyRespectsWedgeSum.num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo *
                    %mo →
                    %msub
                      %mi X
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \{* \to X_i\}_i
              be a set of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∨
                      %mi i
                    %msub
                      %mi X
                      %mi i
                    %mo ∈
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} \vee_i X_i \in Top
              for their
              %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mi i
                    %mo →
                    %msub
                      %mo ∨
                      %mi i
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \iota_i \colon X_i \to \vee_i X_i
              for the canonical inclusion functions.
            %p
              Then for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ι
                      %mi i
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mo ⊕
                      %mi i
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∨
                      %mi i
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\tilde H_n(\iota_i))_i \colon \oplus_i \tilde H_n(X_i) \to \tilde H_n(\vee_i X_i)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .proof
            %h6#proof_7 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#HomologyOfQuotientSpace"}
              the reduced homology of the wedge sum is equivalently the relative homology of the disjoint union of spaces relative to their disjoint union of basepoints
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∨
                      %mi i
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde H_n(\vee_i X_i)
                    \\simeq
                    H_n(\coprod_i X_i, \coprod_i *)
                    \\,.
            %p
              The relative homology preserves these coproducts (sends them to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mo ⊕
                      %mi i
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_n(\coprod_i X_i, \coprod_i *)
                    \\simeq
                    \\oplus_i H_n(X_i, *)
                    \\,.
          %p The following defines topological spaces which are inductively built by gluing disks to each other.
          #CWComplex.num_defn
            %h6#definition_8 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
                of
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-1)
              is the
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %p
              By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
                of
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              is a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_{n}
              obtained from
            %ol
              %li
                %p
                  a
                  = succeed "-complex" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi CW
                        %annotation{:encoding => "application/x-tex"} CW
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} X_{n-1}
                  of dimension
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n-1
              %li
                %p
                  an index set
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Cell
                          %mo{:stretchy => "false"} (
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi n
                          %mo ∈
                          %mi Set
                        %annotation{:encoding => "application/x-tex"} Cell(X)_n \in Set
              %li
                %p
                  a set of
                  %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
                  (the
                  = succeed ")" do
                    %strong attaching maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi f
                          %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo →
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi Cell
                            %mo{:stretchy => "false"} (
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi n
                      %annotation{:encoding => "application/x-tex"} \{ f_i \colon S^{n-1} \to X_{n-1}\}_{i \in Cell(X)_n}
            %p
              as the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                    %mo ≃
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi j
                          %mo ∈
                          %mi Cell
                          %mo{:stretchy => "false"} (
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi n
                      %msup
                        %mi D
                        %mi n
                      %mo )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi j
                        %mo ∈
                        %mi Cell
                        %mo{:stretchy => "false"} (
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi n
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    X_n
                    \\simeq
                    \\left(
                    \\coprod_{j \in Cell(X)_n} D^n
                    \\right)
                    \\underset{j \in Cell(X)_n S^{n-1}}{\coprod}
                    X_n
            %p in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi j
                                %mo ∈
                                %mi Cell
                                %mo{:stretchy => "false"} (
                                %mi X
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi n
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mi j
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi j
                                %mo ∈
                                %mi Cell
                                %mo{:stretchy => "false"} (
                                %mi X
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi n
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi X
                              %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\coprod_{j \in Cell(X)_{n}} S^{n-1} &amp;\stackrel{(f_j)}{\to}&amp; X_{n-1}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\coprod_{j \in Cell(X)_{n}} D^{n} &amp;\to&amp; X_{n}
                    }
                    \\,,
            %p
              hence as the topological space obtained from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{n-1}
              by gluing in
              = succeed "-disks" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mi Cell
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} j \in Cell(X)_n
              along the given boundary inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi j
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo →
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} f_j \colon S^{n-1} \to X_{n-1}
            %p
              By this construction, an
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/filtered+topological+space"} filtered topological space
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              inclusions of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ↪
                    %msub
                      %mi X
                      %mn 0
                    %mo ↪
                    %msub
                      %mi X
                      %mn 1
                    %mo ↪
                    %mi ⋯
                    %mo ↪
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ↪
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\emptyset \hookrightarrow X_0 \hookrightarrow X_1 \hookrightarrow \cdots \hookrightarrow X_{n-1} \hookrightarrow X_n
            %p which are the right vertical morphisms in the above pushout diagrams.
            %p
              A general
              %strong
                %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              then is a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              which is the limiting space of a possibly infinite such sequence, hence a topological space given as the
              %a.existingWikiWord{:href => "/nlab/show/sequential+colimit"} sequential colimit
              over a
              %a.existingWikiWord{:href => "/nlab/show/tower"} tower
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              each of whose morphisms is such a filter inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ↪
                    %msub
                      %mi X
                      %mn 0
                    %mo ↪
                    %msub
                      %mi X
                      %mn 1
                    %mo ↪
                    %mi ⋯
                    %mo ↪
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\emptyset \hookrightarrow X_0 \hookrightarrow X_1 \hookrightarrow \cdots \hookrightarrow X
                    \\,.
          %p
            The following basic facts about the
            %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
            of
            %a.existingWikiWord{:href => "/nlab/show/CW+complexes"} CW complexes
            are important.
          %p Now we can state a variant of singular homology adapted to CW complexes which admits a more systematic way of computing its homology groups. First we observe the following.
          #SkeletalRelativeSingularHomologyOfCW.num_prop
            %h6#proposition_8 Proposition
            %p
              The
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/relative+singular+homology"} relative singular homology
              = succeed "," do
                %a.maruku-ref{:href => "#RelativeSingularHomology"}
              %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.maruku-ref{:href => "#CWComplex"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi k
                    %mo ,
                    %msub
                      %mi X
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℤ
                              %mo{:stretchy => "false"} [
                              %mi Cells
                              %mo{:stretchy => "false"} (
                              %mi X
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi n
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi k
                              %mo =
                              %mi n
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    H_n(X_k , X_{k-1})
                    \\simeq
                    \\left\{
                    \\array{
                    \\mathbb{Z}[Cells(X)_n] &amp; if\; k = n
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi Cells
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[Cells(X)_n]
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              on the set of
              = succeed "-cells." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          .proof
            %h6#proof_8 Proof
            %p
              The inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo ↪
                    %msub
                      %mi X
                      %mi k
                  %annotation{:encoding => "application/x-tex"} X_{k-1} \hookrightarrow X_k
              is a
              %em good pair
              in the sense of def.
              = succeed "." do
                %a.maruku-ref{:href => "#GoodPair"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi k
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi X
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_k/X_{k-1}
              is by definition of CW-complexes a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
              = succeed "," do
                %a.maruku-ref{:href => "#WedgeSum"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spheres"} spheres
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cell
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi k
                    %annotation{:encoding => "application/x-tex"} Cell(X)_k
              %a.maruku-ref{:href => "#HomologyOfQuotientSpace"}
              we have an isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi k
                    %mo ,
                    %msub
                      %mi X
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi k
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi X
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_n(X_k , X_{k-1}) \simeq \tilde H_n( X_k / X_{k-1})
              with the
              %a.existingWikiWord{:href => "/nlab/show/reduced+homology"} reduced homology
              of this wedge sum. The statement then follows by the respect of reduced homology for wedge sums, prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ReducedHomologyRespectsWedgeSum"}
          #SingularHomologyOfCWComples.num_prop
            %h6#proposition_9 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
              with skeletal filtration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{X_n\}_n
              as above, and with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ,
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k,n \in \mathbb{N}
              we have for the
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo &gt;
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (k \gt n) \Rightarrow (H_k(X_n) \simeq 0)
                    \\,.
            %p
              In particular if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a CW-complex of finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mi X
                  %annotation{:encoding => "application/x-tex"} dim X
              (the maximum degree of cells), then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo &gt;
                    %mi dim
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (k \gt dim X) \Rightarrow (H_k(X) \simeq 0).
            %p
              Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \lt n
              the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_k(X_n) \stackrel{\simeq}{\to} H_k(X)
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k = n
              we have an isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi image
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    image(H_n(X_n) \to H_n(X)) \simeq H_n(X)
                    \\,.
          .proof
            %h6#proof_9 Proof
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/relative+homology"} relative homology
              %a.maruku-ref{:href => "#RelativeHomologyLongExactSequence"}
              we have an
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo ,
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo ,
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_{k+1}(X_n , X_{n-1})
                    \\to
                    H_k(X_{n-1})
                    \\to
                    H_k(X_n)
                    \\to
                    H_k(X_n, X_{n-1})
                    \\,.
            %p
              Now by prop.
              %a.maruku-ref{:href => "#SkeletalRelativeSingularHomologyOfCW"}
              the leftmost and rightmost homology groups here vanish when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≠
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \neq n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≠
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k \neq n-1
              and hence exactness implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_k(X_{n-1})
                    \\stackrel{\simeq}{\to}
                    H_k(X_n)
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≠
                      %mi n
                      %mo ,
                      %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k \neq n,n-1
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p Finally for the last claim use that the above exact sequence gives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo ,
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    H_{n-1+1}(X_n , X_{n-1})
                    \\to
                    H_{n-1}(X_{n-1})
                    \\to
                    H_{n-1}(X_n)
                    \\to
                    0
            %p
              and hence that with the above the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_{n-1}(X_{n-1}) \to H_{n-1}(X)
              is surjective.
          %p
            We may now discuss the
            %em
              %a.existingWikiWord{:href => "/nlab/show/cellular+homology"} cellular homology
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
          #CellularChainComplex.num_defn
            %h6#definition_9 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              = succeed "," do
                %a.maruku-ref{:href => "#CWComplex"}
              %strong cellular chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mo •
                      %mi CW
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo •
                  %annotation{:encoding => "application/x-tex"} H_\bullet^{CW}(X) \in Ch_\bullet
              is the
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              such that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
                  of
                  %a.existingWikiWord{:href => "/nlab/show/chains"} chains
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/relative+singular+homology"} relative singular homology
                  group, def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#RelativeSingularHomology"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi n
                        %mo ↪
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X_n \hookrightarrow X
                  relative to
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mo ↪
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X_{n-1} \hookrightarrow X
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi H
                          %mi n
                          %mi CW
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %msub
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mi n
                        %mo ,
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        H_n^{CW}(X) \coloneqq H_n(X_n, X_{n-1})
                        \\,,
              %li#DifferentialInCellularHomology
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/differential"} differential
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mo ∂
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                          %mi CW
                        %mo{:lspace => "verythinmathspace"} :
                        %msubsup
                          %mi H
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                          %mi CW
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msubsup
                          %mi H
                          %mi n
                          %mi CW
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \partial^{CW}_{n+1} \colon H_{n+1}^{CW}(X) \to H_n^{CW}(X)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mo ∂
                          %mi n
                          %mi CW
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi H
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo ,
                        %msub
                          %mi X
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mo ∂
                              %mi n
                        %msub
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi i
                              %mi n
                        %msub
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mi n
                        %mo ,
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\partial^{CW}_n
                        \\colon
                        H_{n+1}(X_{n+1}, X_n)
                        \\stackrel{\partial_n}{\to}
                        H_n(X_n)
                        \\stackrel{i_n}{\to}
                        H_n(X_n, X_{n-1})
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∂
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \partial_n
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                  map of the
                  %a.existingWikiWord{:href => "/nlab/show/singular+chain+complex"} singular chain complex
                  and where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mi n
                      %annotation{:encoding => "application/x-tex"} i_n
                  is the morphism on
                  %a.existingWikiWord{:href => "/nlab/show/relative+homology"} relative homology
                  induced from the canonical inclusion of pairs
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mi n
                          %mo ,
                          %mi ∅
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mi n
                          %mo ,
                          %msub
                            %mi X
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X_n, \emptyset) \to (X_n, X_{n-1})
          .num_prop
            %h6#proposition_10 Proposition
            %p
              The composition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∂
                      %mi n
                      %mi CW
                    %mo ∘
                    %msubsup
                      %mo ∂
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mi CW
                  %annotation{:encoding => "application/x-tex"} \partial^{CW}_{n} \circ \partial^{CW}_{n+1}
              of two differentials in def.
              %a.maruku-ref{:href => "#CellularChainComplex"}
              is indeed zero, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mo •
                      %mi CW
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{CW}_\bullet(X)
              is indeed a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
          .proof
            %h6#proof_10 Proof
            %p
              On representative singular
              %a.existingWikiWord{:href => "/nlab/show/chains"} chains
              the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi n
                  %annotation{:encoding => "application/x-tex"} i_n
              acts as the identity and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∂
                      %mi n
                      %mi CW
                    %mo ∘
                    %msubsup
                      %mo ∂
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mi CW
                  %annotation{:encoding => "application/x-tex"} \partial^{CW}_{n} \circ \partial^{CW}_{n+1}
              acts as the double singular boundary,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mi n
                      %mo ∘
                      %msub
                        %mo ∂
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \partial_{n} \circ \partial_{n+1} = 0
          .num_remark
            %h6#remark_2 Remark
            %p This means that
            %ul
              %li
                %p
                  a
                  %strong
                    cellular
                    = succeed "-chain" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                  is a singular
                  = succeed "-chain" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mi n
                          %mo ↪
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X_n \hookrightarrow X
              %li
                %p
                  a
                  %strong
                    cellular
                    = succeed "-cycle" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                  is a singular
                  = succeed "-chain" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n-2)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mrow
                              %mi n
                              %mo −
                              %mn 2
                          %mo ↪
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X_{n-2} \hookrightarrow X
              %li
                %p
                  a
                  %strong
                    cellular
                    = succeed "-boundary" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                  is a singular
                  = succeed "-chain" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "-chain" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n+1)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n+1)
          %p
            This kind of situation – chains that are cycles only up to lower filtering degree and boundaries that come from specified higher filtering degree – has an evident generalization to higher relative filtering degrees. And in this greater generality the concept is of great practical relevance. Therefore before discussing cellular homology further now, we consider this more general “higher-order relative homology” that it suggests (namely the formalism of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequences"} spectral sequences
            %a.maruku-ref{:href => "#SpectralSequenceOfCWComplex"}
            below to analyse the above cellular situation using this conceptual tool.
          %p
            In theorem
            %a.maruku-ref{:href => "#CelluarEquivalentToSingularFromSpectralSequence"}
            we conclude that cellular homology and singular homology agree of
            %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
            agres.
          %p
            First we abstract the structure on chain complexes that in the above example was induced by the CW-complex structure on the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/singular+chain+complex"} singular chain complex
          %h3#filtered_chain_complexes Filtered chain complexes
          #FilteredChainComplex.num_defn
            %h6#definition_10 Definition
            %p
              The structure of a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtered chain complex
              in a
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              is a sequence of
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ↪
                    %msub
                      %mi F
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %msub
                      %mi C
                      %mo •
                    %mo ↪
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo ↪
                    %mi ⋯
                    %mo ↪
                    %msub
                      %mi C
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\hookrightarrow
                    F_{p-1}C_\bullet \hookrightarrow F_p C_\bullet \hookrightarrow
                    \\cdots
                    \\hookrightarrow
                    C_\bullet
                    \\,.
            %p
              The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
                complex
              of a filtered chain complex, denoted
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mo •
                      %msub
                        %mi C
                        %mo •
                    %annotation{:encoding => "application/x-tex"} G_\bullet C_\bullet
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              chain complexes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo ≔
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi F
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %msub
                      %mi C
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G_p C_\bullet \coloneqq F_p C_\bullet / F_{p-1} C_\bullet
                    \\,.
            %p
              We say that element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} G_p C_\bullet
              are
              %em in filtering degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          .num_remark
            %h6#remark_3 Remark
            %p In more detail this means that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi ⋯
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mo ∂
                              %mi n
                        %msub
                          %mi C
                          %mi n
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mo ∂
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                        %msub
                          %mi C
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo →
                        %mi ⋯
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\cdots \stackrel{\partial_{n}}{\to} C_n \stackrel{\partial_{n-1}}{\to} C_{n-1} \to \cdots]
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi C
                          %mi n
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{C_n\}
                  are
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \mathcal{A}
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/modules"}> modules
                  ) and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mo ∂
                          %mi n
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{\partial_n\}
                  are
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  (module
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mo ∂
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo ∘
                          %msub
                            %mo ∂
                            %mi n
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \partial_{n+1} \circ \partial_{n} = 0
              %li
                %p
                  For each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/filtered+object"} filtering
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mo •
                        %msub
                          %mi C
                          %mi n
                      %annotation{:encoding => "application/x-tex"} F_\bullet C_n
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mi n
                      %annotation{:encoding => "application/x-tex"} C_n
                  and all these filterings are compatible with the
                  %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
                  in that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mi p
                        %msub
                          %mi C
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msub
                          %mi F
                          %mi p
                        %msub
                          %mi C
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        \\partial(F_p C_n) \subset F_p C_{n-1}
              %li
                %p
                  The grading associated to the filtering is such that the
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                  %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mi p
                        %msub
                          %mi C
                          %mi n
                        %mo ≔
                        %mfrac
                          %mrow
                            %msub
                              %mi F
                              %mi p
                            %msub
                              %mi C
                              %mi n
                          %mrow
                            %msub
                              %mi F
                              %mrow
                                %mi p
                                %mo −
                                %mn 1
                            %msub
                              %mi C
                              %mi n
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        G_p C_n \coloneqq \frac{F_p C_n}{ F_{p-1} C_n}
                        \\,.
                %p
                  Since the differentials respect the grading we have chain complexes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mi p
                        %msub
                          %mi C
                          %mo •
                      %annotation{:encoding => "application/x-tex"} G_p C_\bullet
                  in each filtering degree
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
          %p
            Hence elements in a filtered chain complex are
            = succeed ":" do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/bigraded+object"} bi-graded
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} C_\bullet
            as usual, but now they also carry a filtering degree: for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ,
                  %mi q
                  %mo ∈
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} p,q \in \mathbb{Z}
            we therefore also write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                  %mo ≔
                  %msub
                    %mi F
                    %mi p
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                %annotation{:encoding => "application/x-tex"}
                  C_{p,q} \coloneqq F_p C_{p+q}
          %p
            and call this the collection of
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
              \-chains
            in the filtered chain complex.
          %p
            Accordingly we have
            = succeed "-cycles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
          #AlmostChainsCyclesBoundaries.num_defn
            %h6#definition_11 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} F_\bullet C_\bullet
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtered chain complex
              %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
              chain complex is the set of chain complexes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo ≔
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi F
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    G_p C_\bullet \coloneqq F_p C_\bullet / F_{p-1} C_\bullet
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ,
                    %mi p
                    %mo ,
                    %mi q
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} r, p, q \in \mathbb{Z}
              we say that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mi p
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                      %annotation{:encoding => "application/x-tex"} G_p C_{p+q}
                  is the module of
                  %strong
                    %em
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo ,
                            %mi q
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (p,q)
                      \-
                      %a.existingWikiWord{:href => "/nlab/show/chains"} chains
                  or of
                  = succeed ";" do
                    %strong
                      %em
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo +
                              %mi q
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} (p+q)
                        \-chains in filtering degree
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi p
                            %annotation{:encoding => "application/x-tex"} p
              %li
                %p the module
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %msubsup
                                  %mi Z
                                  %mrow
                                    %mi p
                                    %mo ,
                                    %mi q
                                  %mi r
                              %mtd
                                %mo ≔
                                %mrow
                                  %mo {
                                  %mi c
                                  %mo ∈
                                  %msub
                                    %mi G
                                    %mi p
                                  %msub
                                    %mi C
                                    %mrow
                                      %mi p
                                      %mo +
                                      %mi q
                                  %mo{:stretchy => "false"} |
                                  %mo ∂
                                  %mi c
                                  %mo =
                                  %mn 0
                                  %mspace{:width => "thinmathspace"}
                                  %mi mod
                                  %msub
                                    %mi F
                                    %mrow
                                      %mi p
                                      %mo −
                                      %mi r
                                  %msub
                                    %mi C
                                    %mo •
                                  %mo }
                            %mtr
                              %mtd
                              %mtd
                                %mo =
                                %mrow
                                  %mo {
                                  %mi c
                                  %mo ∈
                                  %msub
                                    %mi F
                                    %mi p
                                  %msub
                                    %mi C
                                    %mrow
                                      %mi p
                                      %mo +
                                      %mi q
                                  %mo{:stretchy => "false"} |
                                  %mo ∂
                                  %mo{:stretchy => "false"} (
                                  %mi c
                                  %mo{:stretchy => "false"} )
                                  %mo ∈
                                  %msub
                                    %mi F
                                    %mrow
                                      %mi p
                                      %mo −
                                      %mi r
                                  %msub
                                    %mi C
                                    %mrow
                                      %mi p
                                      %mo +
                                      %mi q
                                      %mo −
                                      %mn 1
                                  %mo }
                                %mo{:stretchy => "false"} /
                                %msub
                                  %mi F
                                  %mrow
                                    %mi p
                                    %mo −
                                    %mn 1
                                %msub
                                  %mi C
                                  %mrow
                                    %mi p
                                    %mo +
                                    %mi q
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned} Z^r_{p,q}  &amp; \coloneqq \left\{ c \in G_p C_{p+q} | \partial c = 0 \, mod F_{p-r} C_{\bullet} \right\} \\ &amp; =  \left\{ c \in F_p C_{p+q} | \partial(c) \in F_{p-r} C_{p+q-1} \right\}/ F_{p-1}C_{p+q} \end{aligned}
                %p
                  is the module of
                  %strong
                    %em
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi r
                          %annotation{:encoding => "application/x-tex"} r
                      \-almost
                      = succeed "-" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo ,
                              %mi q
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} (p,q)
                      %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
                  (the
                  = succeed "-chains" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo +
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (p+q)
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo −
                          %mi r
                        %annotation{:encoding => "application/x-tex"} p-r
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi B
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mi r
                        %mo ≔
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mrow
                            %mi p
                            %mo +
                            %mi r
                            %mo −
                            %mn 1
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"} B^{r}_{p,q} \coloneqq \partial(F_{p+r-1} C_{p+q+1}) \,,
                %p
                  is the module of
                  = succeed "." do
                    %strong
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi r
                          %annotation{:encoding => "application/x-tex"} r
                      \-almost
                      = succeed "-" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo ,
                              %mi q
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} (p,q)
                      %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
          %p Similarly we set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Z
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %mn ∞
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi c
                  %mo ∈
                  %msub
                    %mi F
                    %mi p
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} |
                  %mo ∂
                  %mi c
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi F
                    %mrow
                      %mi p
                      %mo −
                      %mn 1
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo =
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi G
                    %mi p
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Z^\infty_{p,q} \coloneqq \{c \in F_p C_{p + q} | \partial c = 0 \}/F_{p-1}C_{p+q}
                  \=
                  Z(G_p C_{p+q})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi B
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %mn ∞
                  %mo ≔
                  %mo ∂
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi p
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  B^\infty_{p,q} \coloneqq \partial( F_p C_{p+q+1} )
                  \\,.
          %p
            From this definition we immediately have that the differentials
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo →
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \partial \colon C_{p+q} \to C_{p+q-1}
            restrict to the
            = succeed "-almost" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
          #DifferentialsOnAlmostChains.num_prop
            %h6#proposition_11 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              restrict on
              = succeed "-almost" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo →
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo −
                        %mi r
                        %mo ,
                        %mi q
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                      %mi r
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^r
                    \\colon
                    Z^r_{p,q}
                    \\to
                    Z^r_{p-r, q+r-1}
                    \\,.
            %p
              These are still
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mn 2
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \partial^2 = 0
          .proof
            %h6#proof_11 Proof
            %p
              By the very definition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                  %annotation{:encoding => "application/x-tex"} Z^r_{p,q}
