            %p
              the spectral sequence becomes constant in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi s
                  %annotation{:encoding => "application/x-tex"} r_s
              on if all the differentials vanish, so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∂
                      %mrow
                        %mi p
                        %mo ,
