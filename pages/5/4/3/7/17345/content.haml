            %h6#proof_21 Proof
            %p
              By the third item of prop.
              %a.maruku-ref{:href => "#PagesInTheSpectralSequenceOfTheFilteredSingularComplex"}
              the
              = succeed "-page" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
