                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tilde i \coloneqq i|_{im(i)}
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mover
                          %mi j
                          %mo{:stretchy => "false"} ˜
                        %mo ≔
                        %mi j
                        %mo ∘
                        %msup
                          %mi i
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \tilde j \coloneqq j \circ i^{-1}
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mover
                          %mi k
                          %mo{:stretchy => "false"} ˜
                        %mo ≔
                        %mi k
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %mi d
