          %h2#SpectralSequencesForFilteredSpectra For filtered spectra
          #FilteredSpectrum.num_defn
            %h6#definition_20 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/filtered+spectrum"} filtered spectrum
              is a
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with a sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mo &gt;
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Spectra
                  %annotation{:encoding => "application/x-tex"} X_\bullet \colon (\mathbb{N}, \gt) \longrightarrow Spectra
              of spectra of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ⟶
                    %msub
                      %mi X
                      %mn 3
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mn 2
                    %msub
                      %mi X
                      %mn 2
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                    %msub
                      %mi X
                      %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mn 0
                    %msub
                      %mi X
                      %mn 0
                    %mo =
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\longrightarrow
                    X_3
                    \\stackrel{f_2}{\longrightarrow}
                    X_2
                    \\stackrel{f_1}{\longrightarrow}
                    X_1 \stackrel{f_0}{\longrightarrow} X_0 = X
                    \\,.
          .num_remark
            %h6#remark_6 Remark
            %p
              More generally a
              %a.existingWikiWord{:href => "/nlab/show/filtered+object+in+an+%28infinity%2C1%29-category"} filtering
              on an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in (stable or not)
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              is a
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
