          .proof
            %h6#proof_14 Proof
            %p By the defining relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mrow
                        %mi r
                        %mo +
                        %mn 1
                    %mo ≃
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∂
                      %mrow
                        %mi p
                        %mo −
                        %mi r
                        %mo ,
                        %mi q
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∂
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi E
                      %mi pq
                      %mi r
