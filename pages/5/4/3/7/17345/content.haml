                    %annotation{:encoding => "application/x-tex"} p,q
          #Collaps.num_example
            %h6#example_4 Example
            %p
              If for a
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}\}_{r,p,q}
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi s
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} r_s \geq 2
              such that the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi r
                        %mi s
                    %annotation{:encoding => "application/x-tex"} r_s
              = succeed "," do
                %a.maruku-ref{:href => "#Degeneration"}
              = succeed "." do
                %a.maruku-ref{:href => "#LimitTerm"}
              %strong collapses
              on this page.
          .proof
            %h6#proof_15 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} r \geq 2
              the
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              of the spectral sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo →
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo −
                        %mi r
                        %mo ,
                        %mi q
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                      %mi r
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^r \colon E^r_{p,q} \to E^r_{p-r, q+r-1}
            %p
              have
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
              and
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
              necessarily in different rows an columns (while for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} r = 1
              both are in the same row and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} r = 0
              both coincide). Therefore if all but one row or column vanish, then all these differentials vanish.
          #Convergence.num_defn
            %h6#definition_15 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}\}_{r,p,q}
              is said to
              %strong converge
              to a
              %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mo •
                  %annotation{:encoding => "application/x-tex"} H_\bullet
              with
              %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtering
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo •
                      %msub
                        %mi H
                        %mo •
                    %annotation{:encoding => "application/x-tex"} F_\bullet H_\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo ⇒
                    %msub
                      %mi H
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E^r_{p,q} \Rightarrow H_\bullet
                    \\,,
            %p
              if the
              %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
              complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi F
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{G_p H_{p+q}\}_{p,q} \coloneqq \{F_p H_{p+q} / F_{p-1} H_{p+q}\}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is the limit term of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed ":" do
                %a.maruku-ref{:href => "#LimitTerm"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn ∞
                    %mo ≃
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∀
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^\infty_{p,q} \simeq G_p H_{p+q} \;\;\;\;\;\;\; \forall_{p,q}
                    \\,.
          .num_remark
            %h6#remark_4 Remark
            %p
              In practice spectral sequences are often referred to via their first non-trivial page, often also the page at which it collapses, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Collaps"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 2
                    %mo ⇒
                    %msub
                      %mi H
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    E^2_{p,q} \Rightarrow H_\bullet
            %p to be read as “There is a spectral sequence whose second page is as shown on the left and which converges to a filtered object as shown on the right.”
          #BoundedSpectralSequence.num_defn
            %h6#definition_16 Definition
            %p
              A spectral sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}\}
              is called a
              %strong bounded spectral sequence
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ,
                    %mi r
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n,r \in \mathbb{Z}
              the number of non-vanishing terms of total degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi E
                        %mrow
                          %mi k
                          %mo ,
                          %mi n
                          %mo −
                          %mi k
                        %mi r
                    %annotation{:encoding => "application/x-tex"} E^r_{k,n-k}
          #QuadrantSpectralSequence.num_defn
            %h6#definition_17 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}\}
              is called
            %ul
              %li
                %p
                  a
                  %strong first quadrant spectral sequence
                  if all terms except possibly for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                        %mo ≥
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} p,q \geq 0
                  vanish;
              %li
                %p
                  a
                  %strong third quadrant spectral sequence
                  if all terms except possibly for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                        %mo ≤
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} p,q \leq 0
                  vanish.
            %p
              Such spectral sequences are bounded, def.
              = succeed "." do
                %a.maruku-ref{:href => "#BoundedSpectralSequence"}
          #BoundedSpectralSequenceHasLimitTerm.num_prop
            %h6#proposition_15 Proposition
            %p
              A bounded spectral sequence, def.
              = succeed "," do
                %a.maruku-ref{:href => "#BoundedSpectralSequence"}
              = succeed "." do
                %a.maruku-ref{:href => "#LimitTerm"}
          .proof
            %h6#proof_16 Proof
            %p
              First notice that if a spectral sequence has at most
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              non-vanishing terms of total degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              on page
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            %p
              Therefore for a bounded spectral sequence for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} L(n) \in \mathbb{Z}
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi n
                        %mo −
                        %mi p
                      %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} E^r_{p,n-p} = 0
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≤
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \leq L(n)
              and all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} T(n) \in \mathbb{Z}
              such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi n
                        %mo −
                        %mi q
                        %mo ,
                        %mi q
                      %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} E^r_{n-q,q} = 0
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≤
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q \leq T(n)
              and all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            %p
              We claim then that the limit term of the bounded spectral sequence is in position
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
              given by the value
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                  %annotation{:encoding => "application/x-tex"} E^r_{p,q}
              for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo &gt;
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo −
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mi q
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi q
                    %mo +
                    %mn 1
                    %mo −
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mi q
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    r \gt max(  p-L(p+q-1), q + 1 - L(p+q+1) )
                    \\,.
            %p
              This is because for such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              we have
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo −
                            %mi r
                            %mo ,
                            %mi q
                            %mo +
                            %mi r
                            %mo −
                            %mn 1
                          %mi r
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} E^r_{p-r, q+r-1} = 0
                  because
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo −
                          %mi r
                          %mo &lt;
                          %mi L
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo +
                          %mi q
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} p-r \lt L(p+q-1)
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mo ∂
                          %mrow
                            %mi p
                            %mo −
                            %mi r
                            %mo ,
                            %mi q
                            %mo +
                            %mi r
                            %mo −
                            %mn 1
                          %mi r
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} ker(\partial^r_{p-r,q+r-1}) = 0
                  vanishes;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo +
                            %mi r
                            %mo ,
                            %mi q
                            %mo −
                            %mi r
                            %mo +
                            %mn 1
                          %mi r
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} E^r_{p+r, q-r+1} = 0
                  because
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi q
                          %mo −
                          %mi r
                          %mo +
                          %mn 1
                          %mo &lt;
                          %mi T
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo +
                          %mi q
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} q-r + 1 \lt T(p+q+1)
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mo ∂
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mi r
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} im(\partial^r_{p,q}) = 0
                  vanishes.
            %p Therefore
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mrow
                                %mi r
                                %mo +
                                %mn 1
                          %mtd
                            %mo =
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mo ∂
                              %mrow
                                %mi p
                                %mo −
                                %mi r
                                %mo ,
                                %mi q
                                %mo +
                                %mi r
                                %mo −
                                %mn 1
                              %mi r
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mo ∂
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mi r
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mi r
                            %mo{:stretchy => "false"} /
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mi r
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    E^{r+1}_{p,q}
                    \&amp;=
                    ker(\partial^r_{p-r,q+r-1})/im(\partial^r_{p,q})
                    \\\
                    \&amp; \simeq E^r_{p,q}/0
                    \\\
                    \&amp; \simeq E^r_{p,q}
                    \\end{aligned}
                    \\,.
          %p The central statement about the notion of the spectral sequence of a filtered chain complex then is the following proposition. It says that the iterative computation of higher order relative homology indeed in the limit computes the genuine homology.
          #FilteringOnHomology.num_defn
            %h6#definition_18 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} F_\bullet C_\bullet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/filtered+complex"} filtered complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi image
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi p
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F_p H_\bullet(C)
                    \\coloneqq
                    image( H_\bullet(F_p C) \to H_\bullet(C) )
                    \\,.
            %p
              This defines a
              %a.existingWikiWord{:href => "/nlab/show/filtered+object"} filtering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_\bullet H_\bullet(C)
              of the homology, regarded as a graded object.
          #ConvergingToGenuineHomology.num_prop
            %h6#proposition_16 Proposition
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+complex"} spectral sequence of a filtered complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} F_\bullet C_\bullet
              of prop.
              %a.maruku-ref{:href => "#ExplicitDefIsIndeedSpectralSequ"}
              has a limit term, def.
              %a.maruku-ref{:href => "#LimitTerm"}
              then it converges, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Convergence"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo ⇒
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E^r_{p,q} \Rightarrow H_{p+q}(C_\bullet)
                    \\,,
            %p
              i.e. for sufficiently large
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo ≃
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E^r_{p,q} \simeq G_p H_{p+q}(C)
                    \\,,
            %p
              where on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/associated+graded+object"} associated graded object
              of the filtering of def.
              = succeed "." do
                %a.maruku-ref{:href => "#FilteringOnHomology"}
          .proof
            %h6#proof_17 Proof
            %p
              By assumption, there is for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p,q
              an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r(p,q)
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≥
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r \geq r(p,q)
              the
              = succeed "-almost" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "-almost" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "," do
                %a.maruku-ref{:href => "#AlmostChainsCyclesBoundaries"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"} F_p C_{p+q}
              are the ordinary
              %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≥
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r \geq r(p,q)
              def.
              %a.maruku-ref{:href => "#ExplicitForm"}
              gives
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi E
                        %mrow
                          %mi p
                          %mo ,
                          %mi q
                        %mi r
                      %mo ≃
                      %msub
                        %mi G
                        %mi p
                      %msub
                        %mi H
                        %mrow
                          %mi p
                          %mo +
                          %mi q
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^r_{p,q} \simeq G_p H_{p+q}(C)
          %p
            This says what these spectral sequences are converging to. For computations it is also important to know how they start out for low
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %mi r
                %annotation{:encoding => "application/x-tex"} E^r_{p,q}
            for very low values of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            simply as follows:
          #SpectralSequencePagesForLowr.num_prop
            %h6#proposition_17 Proposition
            %p We have
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mn 0
                        %mo =
                        %msub
                          %mi G
                          %mi p
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo =
                        %msub
                          %mi F
                          %mi p
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi F
                          %mrow
                            %mi p
                            %mo −
                            %mn 1
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                      %annotation{:encoding => "application/x-tex"} E^0_{p,q} = G_p C_{p+q} = F_p C_{p+q} / F_{p-1} C_{p+q}
                %p
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated p-graded
                  piece of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mrow
                              %mi p
                              %mo +
                              %mi q
                        %annotation{:encoding => "application/x-tex"} C_{p+q}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mn 1
                        %mo =
                        %msub
                          %mi H
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi G
                          %mi p
                        %msub
                          %mi C
                          %mo •
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E^1_{p,q} = H_{p+q}(G_p C_\bullet)
          .proof
            %h6#proof_18 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} r = 0
              def.
              %a.maruku-ref{:href => "#ExplicitForm"}
              restricts to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 0
                    %mo =
                    %mfrac
                      %mrow
                        %msub
                          %mi F
                          %mi p
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi p
                            %mo −
                            %mn 1
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                    %mo =
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi C
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"}
                    E^0_{p,q} = \frac{ F_p C_{p+q}}{F_{p-1} C_{p+q}} = G_p C_{p+q}
            %p
              because for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"} c \in F_p C_{p+q}
              we automatically also have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi c
                    %mo ∈
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \partial c \in F_p C_{p+q}
              since the differential respects the filtering degree by assumption.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} r = 1
              def.
              %a.maruku-ref{:href => "#ExplicitForm"}
              gives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 1
                    %mo =
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi c
                        %mo ∈
                        %msub
                          %mi G
                          %mi p
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo{:stretchy => "false"} |
                        %mo ∂
                        %mi c
                        %mo =
                        %mn 0
                        %mo ∈
                        %msub
                          %mi G
                          %mi p
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo{:stretchy => "false"} }
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mi p
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^1_{p,q} = \frac{\{c \in G_p C_{p+q} | \partial c = 0 \in G_p C_{p+q}\} }{\partial(F_p C_{p+q})} = H_{p+q} (G_p C_\bullet)
                    \\,.
          .num_remark
            %h6#remark_5 Remark
            %p
              There is, in general, a decisive difference between the homology of the associated graded complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_{p+q}(G_p C_\bullet)
              and the associated graded piece of the genuine homology
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi p
                      %msub
                        %mi H
                        %mrow
                          %mi p
                          %mo +
                          %mi q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G_p H_{p+q}(C_\bullet)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo →
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} r \to \infty
              %a.maruku-ref{:href => "#ConvergingToGenuineHomology"}
              below.
          %h3#comparing_cellular_and_singular_homology Comparing cellular and singular homology
          %p
            These general facts now allow us, as a first simple example for the application of
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequences"} spectral sequences
            to see transparently that the
            %a.existingWikiWord{:href => "/nlab/show/cellular+homology"} cellular homology
            of a CW complex, def.
            = succeed "," do
              %a.maruku-ref{:href => "#CellularChainComplex"}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
          %p
            First notice that of course the structure of a
            %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
            on a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.maruku-ref{:href => "#CWComplex"}
            naturally induces on its
            %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_\bullet(X)
            the structure of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtered chain complex
            = succeed ":" do
              %a.maruku-ref{:href => "#FilteredChainComplex"}
          #SpectralSequenceOfSingularChainsInCWComplex.num_defn
            %h6#definition_19 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                    %mo ↪
                    %msub
                      %mi X
                      %mn 1
                    %mo ↪
                    %mi ⋯
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_0 \hookrightarrow X_1 \hookrightarrow \cdots \hookrightarrow X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F_p C_\bullet(X) \coloneqq C_\bullet(X_p)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/singular+chain+complex"} singular chain complex
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi p
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X_p \hookrightarrow X
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi p
                    %mo ↪
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_p \hookrightarrow X_{p+1}
              induce
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi F
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_p C_\bullet(X) \hookrightarrow F_{p+1} C_\bullet(X)
              and these equip the singular chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet(X)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the structure of a bounded
              %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtered chain complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ↪
                    %msub
                      %mi F
                      %mn 0
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi F
                      %mn 1
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi F
                      %mn 2
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi ⋯
                    %mo ↪
                    %msub
                      %mi F
                      %mn ∞
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi C
