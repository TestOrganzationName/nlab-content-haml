                    \&amp;&amp; \pi_\bullet(A_3) &amp;&amp; \pi_\bullet(A_2) &amp;&amp; \pi_\bullet(A_1) &amp;&amp; \pi_\bullet(A_0)
                    }
                    \\,,
            %p
              where each triangle is a rolled-up incarnation of a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              (and in particular is
              %em not
              a commuting diagram!).
            %p
              If we furthermore consider the
              %a.existingWikiWord{:href => "/nlab/show/bigraded+object"} bigraded
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(X_\bullet)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(A_\bullet)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mo •
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi π
                                  %mo •
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mo •
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mo •
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi δ
                            %mo ↖
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi π
                                    %mo •
                                  %mo{:stretchy => "false"} (
                                  %mi cofib
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi f
                                    %mo •
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi A
                              %mo •
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\pi_\bullet(X_\bullet)
                    \&amp; \stackrel{\pi_\bullet(f_\bullet)}{\longrightarrow} &amp;
                    \\pi_\bullet(X_\bullet)
                    \\\
                    \&amp; {}_{\mathllap{\delta}}\nwarrow
                    \&amp; \downarrow^{\mathrlap{\pi_\bullet(cofib(f_\bullet))}}
                    \\\
                    \&amp;&amp;
                    \\pi_\bullet(A_\bullet)
                    }
            %p
              where the morphisms
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(f_\bullet)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi cofib
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(cofib(f_\bullet))
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              have bi-degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0,-1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,0)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-1,1)
            %p Here it is convenient to shift the bigrading, equivalently, by setting
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒟
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo ≔
                    %msub
                      %mi π
                      %mrow
                        %mi t
                        %mo −
                        %mi s
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}^{s,t} \coloneqq \pi_{t-s}(X_s)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℰ
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo ≔
                    %msub
                      %mi π
                      %mrow
                        %mi t
                        %mo −
                        %mi s
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi s
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}^{s,t} \coloneqq \pi_{t-s}(A_s)
                    \\,,
            %p
              because then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              counts the cycles of going around the triangles:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi 𝒟
                      %mrow
                        %mi s
                        %mo +
                        %mn 1
                        %mo ,
                        %mi t
                        %mo +
                        %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi π
                          %mrow
                            %mi t
                            %mo −
                            %mi s
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mi s
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi 𝒟
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi π
                          %mrow
                            %mi t
                            %mo −
                            %mi s
                        %mo{:stretchy => "false"} (
                        %mi cofib
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mi s
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi ℰ
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi δ
                          %mi s
                    %msup
                      %mi 𝒟
                      %mrow
                        %mi s
                        %mo +
                        %mn 1
                        %mo ,
                        %mi t
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    \\mathcal{D}^{s+1,t+1}
                    \\stackrel{\pi_{t-s}(f_s)}{\longrightarrow}
                    \\mathcal{D}^{s,t}
                    \\stackrel{\pi_{t-s}(cofib(f_s))}{\longrightarrow}
                    \\mathcal{E}^{s,t}
                    \\stackrel{\delta_s}{\longrightarrow}
                    \\mathcal{D}^{s+1,t}
                    \\to
                    \\cdots
            %p
              Data of this form is called an
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/exact+couple"} exact couple
              %a.maruku-ref{:href => "#ExactCouple"}
              below.
          #UnrolledExactCouple.num_defn
            %h6#definition_21 Definition
            %p
              An
              %em
                unrolled
                %a.existingWikiWord{:href => "/nlab/show/exact+couple"} exact couple
              (of Adams-type) is a diagram of
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msup
                              %mi 𝒟
                              %mrow
                                %mn 3
                                %mo ,
                                %mo •
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi i
                                  %mn 2
                          %mtd
                            %msup
                              %mi 𝒟
                              %mrow
                                %mn 2
                                %mo ,
                                %mo •
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi i
                                  %mn 1
                          %mtd
                            %msup
                              %mi 𝒟
                              %mrow
                                %mn 1
                                %mo ,
                                %mo •
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi i
                                  %mn 0
                          %mtd
                            %msup
                              %mi 𝒟
                              %mrow
                                %mn 0
                                %mo ,
                                %mo •
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi k
                                    %mn 2
                            %mo ↖
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi j
                                    %mn 2
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi k
                                    %mn 1
                            %mo ↖
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi j
                                    %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi k
                                    %mn 0
                            %mo ↖
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi j
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi ℰ
                              %mrow
                                %mn 3
                                %mo ,
                                %mo •
                          %mtd
                          %mtd
                            %msup
                              %mi ℰ
                              %mrow
                                %mn 2
                                %mo ,
                                %mo •
                          %mtd
                          %mtd
                            %msup
                              %mi ℰ
                              %mrow
                                %mn 1
                                %mo ,
                                %mo •
                          %mtd
                          %mtd
                            %msup
                              %mi ℰ
                              %mrow
                                %mn 0
                                %mo ,
                                %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\cdots
                    \&amp;\stackrel{}{\longrightarrow}&amp;
                    \\mathcal{D}^{3,\bullet}
                    \&amp;\stackrel{i_2}{\longrightarrow}&amp;
                    \\mathcal{D}^{2,\bullet}
                    \&amp;\stackrel{i_1}{\longrightarrow} &amp;
                    \\mathcal{D}^{1,\bullet}
                    \&amp;\stackrel{i_0}{\longrightarrow}&amp;
                    \\mathcal{D}^{0,\bullet}
                    \\\
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{}}  &amp;{}_{\mathllap{k_2}}\nwarrow &amp;
                    {}^{\mathllap{j_2}}\downarrow &amp;{}_{\mathllap{k_1}}\nwarrow &amp;
                    {}^{\mathllap{j_1}}\downarrow &amp;{}_{\mathllap{k_0}}\nwarrow
                    \&amp; {}_{\mathllap{j_0}}\downarrow
                    \\\
                    \&amp;&amp; \mathcal{E}^{3,\bullet} &amp;&amp; \mathcal{E}^{2,\bullet}
                    \&amp;&amp; \mathcal{E}^{1,\bullet} &amp;&amp; \mathcal{E}^{0,\bullet}
                    }
            %p
              such that each triangle is a rolled-up
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi 𝒟
                      %mrow
                        %mi s
                        %mo +
                        %mn 1
                        %mo ,
                        %mi t
                        %mo +
                        %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi i
                          %mi s
                    %msup
                      %mi 𝒟
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi j
                          %mi s
                    %msup
                      %mi ℰ
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi k
                          %mi s
                    %msup
                      %mi 𝒟
                      %mrow
                        %mi s
                        %mo +
                        %mn 1
                        %mo ,
                        %mi t
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    \\mathcal{D}^{s+1,t+1}
                    \\stackrel{i_s}{\longrightarrow}
                    \\mathcal{D}^{s,t}
                    \\stackrel{j_s}{\longrightarrow}
                    \\mathcal{E}^{s,t}
                    \\stackrel{k_s}{\longrightarrow}
                    \\mathcal{D}^{s+1,t}
                    \\to
                    \\cdots
                    \\,.
          %p
            The collection of this “un-rolled” data into a single diagram of
            %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            is called the corresponding
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/exact+couple"} exact couple
          #ExactCouple.num_defn
            %h6#definition_22 Definition
            %p
              An
              %em
                %a.existingWikiWord{:href => "/nlab/show/exact+couple"} exact couple
              is a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              (non-commuting) of
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒟
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi k
                            %mo ↖
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi j
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ℰ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{D}
                    \&amp;\stackrel{i}{\longrightarrow}&amp;
                    \\mathcal{D}
                    \\\
                    \&amp; {}_{\mathllap{k}}\nwarrow &amp; \downarrow^{\mathrlap{j}}
                    \\\
                    \&amp;&amp; \mathcal{E}
                    }
                    \\,,
            %p
              such that this is
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              exact in each position, hence such that the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of every
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              is the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of the preceding one.
          %p The concept of exact couple so far just collects the sequences of long exact sequences given by a filtration. Next we turn to extracting information from this sequence of sequences.
          #Observingd1.num_remark
            %h6#remark_9 Remark
            %p
              The sequence of long exact sequences in remark
              %a.maruku-ref{:href => "#UnrolledExactCoupleOfAFiltrationOnASpectrum"}
              is inter-locking, in that every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi t
                        %mo −
                        %mi s
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_{t-s}(X_s)
              appears in
              %em two
              of them, and thus we can string them all together:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi π
                              %mrow
                                %mi t
                                %mo −
                                %mi s
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mrow
                                %mi s
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msubsup
                                    %mi δ
                                    %mrow
                                      %mi t
                                      %mo −
                                      %mi s
                                    %mi s
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi π
                                    %mrow
                                      %mi t
                                      %mo −
                                      %mi s
                                      %mo −
                                      %mn 1
                                  %mo{:stretchy => "false"} (
                                  %mi cofib
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi f
                                    %mrow
                                      %mi s
                                      %mo +
                                      %mn 1
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi π
                              %mrow
                                %mi t
                                %mo −
                                %mi s
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi A
                              %mi s
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi def
                                %mo :
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %msubsup
                                  %mi d
                                  %mn 1
                                  %mrow
                                    %mi s
                                    %mo ,
                                    %mi t
                          %mtd
                          %mtd
                            %msub
                              %mi π
                              %mrow
                                %mi t
                                %mo −
                                %mi s
                                %mo −
