                      %annotation{:encoding => "application/x-tex"} \tilde k \coloneqq k|_{ker(d)}
                  \.
          #DerivedExactCoupleIsExactCouple.num_prop
            %h6#proposition_20 Proposition
            %p
              A derived exact couple, def.
              = succeed "," do
                %a.maruku-ref{:href => "#DerivedExactCouple"}
              = succeed "." do
                %a.maruku-ref{:href => "#ExactCouple"}
          .num_defn
            %h6#definition_25 Definition
            %p
              Given an exact couple, def.
              = succeed "," do
                %a.maruku-ref{:href => "#ExactCouple"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              = succeed "," do
                %a.maruku-ref{:href => "#SpectralSequence"}
              = succeed "," do
                %a.maruku-ref{:href => "#PageOfAnExactCouple"}
              = succeed "," do
                %a.maruku-ref{:href => "#DerivedExactCouple"}
              = succeed "." do
                %a.maruku-ref{:href => "#DerivedExactCoupleIsExactCouple"}
          #AdamsTypeSpectralSequenceOfATower.num_example
            %h6#example_5 Example
            %p
              Consider a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/filtered+spectrum"} filtered spectrum
              = succeed "," do
                %a.maruku-ref{:href => "#FilteredSpectrum"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi X
                              %mn 3
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 2
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 2
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mn 1
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi A
                              %mn 3
                          %mtd
                          %mtd
                            %msub
                              %mi A
                              %mn 2
                          %mtd
                          %mtd
                            %msub
                              %mi A
                              %mn 1
                          %mtd
                          %mtd
                            %msub
                              %mi A
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\cdots
                    \&amp;\stackrel{}{\longrightarrow}&amp;
                    X_3
                    \&amp;\stackrel{f_2}{\longrightarrow}&amp;
                    X_2
                    \&amp;\stackrel{f_2}{\longrightarrow} &amp;
                    X_1
                    \&amp;\stackrel{f_1}{\longrightarrow}&amp;
                    X
                    \\\
                    \&amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; A_3 &amp;&amp; A_2 &amp;&amp; A_1 &amp;&amp; A_0
                    }
            %p
              and its induced
              %a.existingWikiWord{:href => "/nlab/show/exact+couple"} exact couple
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              %a.maruku-ref{:href => "#UnrolledExactCoupleOfAFiltrationOnASpectrum"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒟
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi k
                            %mo ↖
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi j
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ℰ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒟
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo ,
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo ↖
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 0
                                  %mo ,
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ℰ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{D} &amp;\stackrel{i}{\longrightarrow}&amp; \mathcal{D}
                    \\\
                    \&amp;{}_{\mathllap{k}}\nwarrow&amp; \downarrow^{\mathrlap{j}}
                    \\\
                    \&amp;&amp; \mathcal{E}
                    }
                    \\;\;\;\;\;\,\;\;\;\;\;\;
                    \\array{
                    \\mathcal{D} &amp;\stackrel{(-1,-1)}{\longrightarrow}&amp; \mathcal{D}
                    \\\
                    \&amp;{}_{\mathllap{(1,0)}}\nwarrow&amp; \downarrow^{\mathrlap{(0,0)}}
                    \\\
                    \&amp;&amp; \mathcal{E}
                    }
            %p with bigrading as shown on the right.
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "http://ncatlab.org/nlab/files/adamstypedifferentials.jpg", :width => "360"}/
            %p
              As we pass to derived exact couples, by def.
              = succeed "," do
                %a.maruku-ref{:href => "#DerivedExactCouple"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is preserved, but that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              increases by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,1)
              in each step, since
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo ∘
                    %msup
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg(\tilde j) = deg( j \circ i^{-1}) = deg(j) + (1,1)
                    \\,.
            %p
              Therefore the induced
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              has differentials of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi r
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi ℰ
                      %mi r
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo ⟶
                    %msubsup
                      %mi ℰ
                      %mi r
                      %mrow
                        %mi s
                        %mo +
                        %mi r
                        %mo ,
                        %mi t
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_r \;\colon\; \mathcal{E}_r^{s,t} \longrightarrow \mathcal{E}_r^{s+r, t+r-1}
                    \\,.
            %p
              This is also called the Adams-type
              %em
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+tower+of+fibrations"} spectral sequence of the tower of fibrations
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo →
                      %msub
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X_{n+1} \to X_n
          %p
            This we discuss in detail in
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+2"} part 2 – Adams spectral sequences
          %h2#References References
          %p A gentle exposition of the general idea of spectral sequences is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+McCleary"}> John McCleary
              ,
              = succeed "," do
                %em A User’s Guide to Spectral Sequences
          %p A concise account streamlined for our purposes is in section 2 of
          %ul
            %li#Rognes12
              %a.existingWikiWord{:href => "/nlab/show/John+Rognes"}> John Rognes
              ,
              %em The Adams spectral sequence
              (following
              = succeed ")," do
                %a{:href => "classical+Adams+spectral+sequence#Bruner09"} Bruner
              = succeed ")" do
                %a{:href => "http://folk.uio.no/rognes/papers/notes.050612.pdf"} pdf
