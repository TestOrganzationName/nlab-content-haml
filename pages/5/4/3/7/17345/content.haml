                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}(X)\}
              is concentrated in the
              = succeed "-row" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
