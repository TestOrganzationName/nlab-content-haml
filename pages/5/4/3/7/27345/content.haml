                      %mo{:stretchy => "false"} ]
                      %msub
                        %mo =
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi A
                          %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} [
                      %mi y
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A:U_i}{\Gamma, x:A, y:A \vdash \mathrm{trunc}_A(x, y):[x] =_{[A]} [y]}
          %ul
            %li Elimination rules for propositional truncations:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %msub
                        %mi U
                        %mi i
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi U
                        %mi i
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi y
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi z
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi y
                      %msub
                        %mo =
                        %mrow
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mi z
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo{:stretchy => "false"} ]
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} ind
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi A
                          %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi p
                      %mo ,
                      %mi f
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A:U_i \quad \Gamma, x:A \vdash B(x):U_i \quad \Gamma, x:A, y:B(x), z:B(x) \vdash p(x, y, z):y =_{B(x)} z \quad \Gamma, x:A \vdash f(x):B([x])}{\Gamma, x:[A] \vdash \mathrm{ind}_{[A]}(B, p, f, x):B(x)}
          %ul
            %li Computation rules for propositional truncations:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %msub
                        %mi U
                        %mi i
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi U
                        %mi i
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi y
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi z
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi y
                      %msub
                        %mo =
                        %mrow
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mi z
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo :
                      %mi A
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} ind
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi A
                          %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi p
                      %mo ,
                      %mi f
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A:U_i \quad \Gamma, x:A \vdash B(x):U_i \quad \Gamma, x:A, y:B(x), z:B(x) \vdash p(x, y, z):y =_{B(x)} z \quad \Gamma, x:A \vdash f(x):B([x]) \quad \Gamma \vdash a:A}{\Gamma \vdash \mathrm{ind}_{[A]}(B, p, f, [a]) \equiv f(a):B([a])}
          %h3#univalence Univalence
          %p
            Given types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} A:U_i
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo :
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} B:U_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:A \to B
            is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            if the fiber of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            at each element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            has exactly one element. The property of the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            having exactly one element is represented by the
            %a.existingWikiWord{:href => "/nlab/show/isContr"} isContr
            modality which states that the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is contractible. The fiber of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            at an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi B
                %annotation{:encoding => "application/x-tex"} b:B
            is given by the type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi b
                      %mo :
                      %mi B
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi B
                  %mi b
                %annotation{:encoding => "application/x-tex"} \sum_{b:B} f(a) =_B b
          %p
            We formally define the property of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            being a one-to-one correspondence or an equivalence of types as the type:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} isEquiv
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi b
                      %mo :
                      %mi B
                  %mi{:mathvariant => "normal"} isContr
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi a
                        %mo :
                        %mi A
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi B
                    %mi b
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{isEquiv}_{A, B}(f) \coloneqq \prod_{b:B} \mathrm{isContr}\left(\sum_{a:A} f(a) =_B b\right)
          %p
            We define the type of equivalences from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≃
                  %mi B
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                  %msub
                    %mi{:mathvariant => "normal"} isEquiv
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \simeq B \coloneqq \sum_{f:A \to B} \mathrm{isEquiv}_{A, B}(f)
          %p There is a function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} idtoequiv
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msub
                    %mo =
                    %mrow
                      %msub
                        %mi U
                        %mi i
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ≃
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{idtoequiv}_{A, B}:(A =_{U_i} B) \to (A \simeq B)
          %p
            which is inductively defined on reflexivity to be the identity function on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} idtoequiv
                    %mrow
                      %mi A
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %msub
                        %mi U
                        %mi i
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi id
                    %mi A
                %annotation{:encoding => "application/x-tex"} \mathrm{idtoequiv}_{A, A}(\mathrm{refl}_{U_i}(A)) \equiv id_A
          %p
            Note that both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo =
                    %mrow
                      %msub
                        %mi U
                        %mi i
                  %mi B
                %annotation{:encoding => "application/x-tex"} A =_{U_i} B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≃
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \simeq B
            lie in the universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} U_{i + 1}
            in strongly predicative dependent type theory.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
            then states that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} idtoequiv
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                %annotation{:encoding => "application/x-tex"} \mathrm{idtoequiv}_{A, B}
            is an equivalence for all external natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ∈
                  %mi 𝒩
                %annotation{:encoding => "application/x-tex"} i \in \mathcal{N}
            and types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} A:U_i
            and
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo :
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} B:U_i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi i
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} level
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %msub
                        %mi U
                        %mi i
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi B
                      %mo :
                      %msub
                        %mi U
                        %mi i
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} ua
                        %mrow
                          %msub
                            %mi U
                            %mi i
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} isEquiv
                        %mrow
                          %mi A
                          %msub
                            %mo =
                            %mrow
                              %msub
                                %mi U
                                %mi i
                          %mi B
                          %mo ,
                          %mi A
                          %mo ≃
                          %mi B
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi{:mathvariant => "normal"} idtoequiv
                        %mrow
                          %mi A
                          %mo ,
                          %mi B
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash i \; \mathrm{level} \quad \Gamma \vdash A:U_i \quad \Gamma \vdash B:U_i}{\Gamma \vdash \mathrm{ua}_{U_i}(A, B):\mathrm{isEquiv}_{A =_{U_i} B, A \simeq B}(\mathrm{idtoequiv}_{A, B})}
          %h3#replacement Replacement
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi B
                %annotation{:encoding => "application/x-tex"} x:A \vdash f(x):B
            is given by the type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} im
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo :
                      %mi B
                  %mrow
                    %mo [
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi B
                    %mi y
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \mathrm{im}(f) \coloneqq \sum_{y:B} \left[\sum_{x:A} f(x) =_B y\right]
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/type+theoretic+axiom+of+replacement"} type theoretic axiom of replacement
            states that for all universe levels
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %a.existingWikiWord{:href => "/nlab/show/essentially+small+type"}
              essentially
              = succeed "-small" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
            type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/locally+small+type"}
              locally
              = succeed "-small" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
            type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi B
                  %annotation{:encoding => "application/x-tex"} x:A \vdash f(x):B
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} im
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{im}(f)
            is essentially
            = succeed "-small." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
            %a.existingWikiWord{:href => "/nlab/show/quotient+sets"} quotient sets
            in all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
            = succeed "." do
              %a{:href => "#BBCDG"} Bezem et al 2021
          %p
            Thus, the
            %a.existingWikiWord{:href => "/nlab/show/h-sets"} h-sets
            in each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} U_i
            form an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+pretopos"} arithmetic pretopos
          %h3#excluded_middle Excluded middle
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/law+of+excluded+middle"} law of excluded middle
            can be formulated in strongly predicative dependent type theory as the following: that for each universe level
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %a.existingWikiWord{:href => "/nlab/show/embedding+of+types"} embedding
            of the
            %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝟚
                %annotation{:encoding => "application/x-tex"} \mathbb{2}
            into the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+of+propositions"}
                type of
                = succeed "-small" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                      %annotation{:encoding => "application/x-tex"} U_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo :
                  %mi 𝟚
                %annotation{:encoding => "application/x-tex"} 0:\mathbb{2}
            to the
            %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo :
                  %mi 𝟚
                %annotation{:encoding => "application/x-tex"} 1:\mathbb{2}
            to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
          %p
            Thus, with excluded middle, the
            %a.existingWikiWord{:href => "/nlab/show/h-sets"} h-sets
            in each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} U_i
            form an
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+pretopos"} arithmetic
            %a.existingWikiWord{:href => "/nlab/show/Boolean+pretopos"} Boolean pretopos
            and the univeres
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} U_i
            themselves correspond to the
            %a.existingWikiWord{:href => "/nlab/show/regular+cardinals"} regular cardinals
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
