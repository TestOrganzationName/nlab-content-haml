                      %mi x
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi A
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi z
                      %mo :
