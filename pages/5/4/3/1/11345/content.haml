                  \&amp;rbrack;
              %li
                %p
                  Jan Albert, Justin Kaidi, Ying-Hsuan Lin,
                  %em Topological modularity of Supermoonshine
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  %a{:href => "https://arxiv.org/abs/2210.14923"} arXiv:2210.14923
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
            %h4#occurrences_in_string_theory Occurrences in string theory
            %h5#ReferencesEllipticGeneraAsPartitionFunctionsOfHStrings H-string elliptic genus
            %p
              Further on the elliptic genus of the
              %a.existingWikiWord{:href => "/nlab/show/heterotic+string"} heterotic string
              being the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
            %p
              The interpretation of
              %a.existingWikiWord{:href => "/nlab/show/equivariant+elliptic+genera"} equivariant elliptic genera
              as
              %a.existingWikiWord{:href => "/nlab/show/partition+functions"} partition functions
              of
              %a.existingWikiWord{:href => "/nlab/show/parametrized+WZW+models"} parametrized WZW models
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            %ul
              %li#DistlerSharpe07
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Jacques+Distler"}> Jacques Distler
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Eric+Sharpe"} Eric Sharpe
                  = succeed "," do
                    %em Heterotic compactifications with principal bundles for general groups and general levels
                  = succeed ")" do
                    %a{:href => "http://arxiv.org/abs/hep-th/0701244"} arXiv:hep-th/0701244
              %li#Ando07
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Matthew+Ando"}> Matthew Ando
                  ,
                  = succeed "," do
                    %em Equivariant elliptic cohomology and the Fibered WZW models of Distler and Sharpe
                  %a{:href => "http://www.math.ucsb.edu/~drm/GTPseminar/2007-fall.php"} talk 2007
                  (
                  %a{:href => "http://www.math.ucsb.edu/~drm/GTPseminar/notes/20071026-ando/20071026-malmendier.pdf"}> lecture notes pdf
                  )
            %p
              Speculations on physics aspects of lifting the
              %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
              to
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/topological+modular+forms"} topological modular forms
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Yuji+Tachikawa"}> Yuji Tachikawa
                  ,
                  %em Topological modular forms and the absence of a heterotic global anomaly
                  (
                  %a{:href => "https://arxiv.org/abs/2103.12211"}> arXiv:2103.12211
                  )
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Yuji+Tachikawa"}> Yuji Tachikawa
                  , Mayuko Yamashita,
                  %em Topological modular forms and the absence of all heterotic global anomalies
                  (
                  %a{:href => "https://arxiv.org/abs/2108.13542"}> arXiv:2108.13542
                  )
            %h5#ReferencesEllipticGeneraAsPartitionFunctionsOfM5Branes M5-brane elliptic genus
            %p
              On the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/M5-brane+elliptic+genus"} M5-brane elliptic genus
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/2d+SCFT"} 2d SCFT
              argued to describe the
              %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
              of the
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
              on a
              %a.existingWikiWord{:href => "/nlab/show/4-manifold"} 4-manifold
              (specifically: a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/complex+surface"} complex surface
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Juan+Maldacena"}> Juan Maldacena
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andrew+Strominger"} Andrew Strominger
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
                = succeed "," do
                  %em Black Hole Entropy in M-Theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9711053"} arXiv:hep-th/9711053
            %p
              Discussion of the resulting
              %a.existingWikiWord{:href => "/nlab/show/elliptic+genus"} elliptic genus
              (
              %a.existingWikiWord{:href => "/nlab/show/2d+SCFT"} 2d SCFT
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Davide+Gaiotto"}> Davide Gaiotto
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Andrew+Strominger"} Andrew Strominger
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Xi+Yin"} Xi Yin
                  = succeed "," do
                    %em The M5-Brane Elliptic Genus: Modularity and BPS States
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/hep-th/0607010"} hep-th/0607010
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Davide+Gaiotto"}> Davide Gaiotto
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Xi+Yin"} Xi Yin
                  = succeed "," do
                    %em Examples of M5-Brane Elliptic Genera
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/hep-th/0702012"} arXiv:hep-th/0702012
            %p Further discussion in:
            %ul
              %li
                %p
                  Murad Alim, Babak Haghighat, Michael Hecht,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Albrecht+Klemm"} Albrecht Klemm
                  %em Wall-crossing holomorphic anomaly and mock modularity of multiple M5-branes
                  (
                  %a{:href => "https://arxiv.org/abs/1012.1608"}> arXiv:1012.1608
                  )
              %li#GukovPeiPutrovVafa18
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sergei+Gukov"}> Sergei Gukov
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Du+Pei"} Du Pei
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Pavel+Putrov"} Pavel Putrov
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                  %em 4-manifolds and topological modular forms
                  (
                  %a{:href => "https://arxiv.org/abs/1811.07884"}> arXiv:1811.07884
                  ,
                  = succeed ")" do
                    %a{:href => "https://inspirehep.net/literature/1704312"} spire:1704312
            %h5#ReferencesEllipticGeneraAsPartitionFunctionsOfMStrings M-string elliptic genus
            %p
              On the
              %a.existingWikiWord{:href => "/nlab/show/elliptic+genus"} elliptic genus
              of
              %a.existingWikiWord{:href => "/nlab/show/M-strings"} M-strings
              inside
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Stefan+Hohenegger"}> Stefan Hohenegger
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Amer+Iqbal"} Amer Iqbal
                  = succeed "," do
                    %em
                      M-strings, Elliptic Genera and
