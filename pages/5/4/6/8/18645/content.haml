                            %mi g
                            %mo *
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi d
                            %mi n
                          %mi x
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %munder
                            %mo ∫
                            %mrow
                              %mi k
                              %mo ∈
                              %msup
                                %mi ℝ
                                %mi n
                          %mover
                            %mi f
                            %mo ^
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                          %msup
                            %mover
                              %mi g
                              %mo ^
                            %mo *
                          %mo{:stretchy => "false"} (
