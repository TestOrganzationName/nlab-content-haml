                %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser ("re"-)normalization
                in theorem
                = succeed "." do
                  %a.maruku-ref{:href => "#ExistenceRenormalization"}
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#UVRegularizationViaZ
              %strong
                %a.existingWikiWord{:href => "/nlab/show/UV-regularization"} UV-Regularization
                via
                %a.existingWikiWord{:href => "/nlab/show/counterterms"} counterterms
            %p
              While
              %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser renormalization
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
              (theorem
              = succeed ")" do
                %a.maruku-ref{:href => "#ExistenceRenormalization"}
              %a.existingWikiWord{:href => "/nlab/show/extensions+of+distributions"} extensions of distributions
              in prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#SpaceOfPointExtensions"}
              %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
              (theorem
              = succeed ")," do
                %a.maruku-ref{:href => "#PerturbativeRenormalizationMainTheorem"}
              %em difference
              between any two such choices as an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinition"} interaction vertex redefinition
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
              itself should have an incarnation in terms of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinitions"} interaction vertex redefinitions
            %p
              This may be realized via a construction of
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
              in terms of
              %em
                %a.existingWikiWord{:href => "/nlab/show/UV-regularization"} UV-regularization
              (prop.
              %a.maruku-ref{:href => "#UVRegularization"}
              below): For any choice of “
              %a.existingWikiWord{:href => "/nlab/show/UV-cutoff"}> UV-cutoff
              ”, given by an approximation of the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \Delta_F
              by
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi F
                        %mo ,
                        %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
              (def.
              %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
              below) there is a unique “
              %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix"}> effective S-matrix
              ”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒮
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda
              induced at each cutoff scale (def.
              %a.maruku-ref{:href => "#SMatrixEffective"}
              below). While the “UV-limit”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
