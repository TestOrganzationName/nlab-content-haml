                                  %msub
                                    %mover
                                      %mi v
                                      %mo{:stretchy => "false"} ^
                                    %mn 2
                                  %mi A
                                  %mo )
                                %mrow
                                  %mo (
                                  %mover
                                    %mi A
                                    %mo ¯
                                  %msub
                                    %mover
                                      %mi v
                                      %mo{:stretchy => "false"} ^
                                    %mn 1
                                  %mi A
                                  %mo )
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 2
                              %mrow
                                %mo (
                                %mover
                                  %mi A
                                  %mo ¯
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mover
                                    %mi v
                                    %mo{:stretchy => "false"} ^
                                  %mn 1
                                %msub
                                  %mover
                                    %mi v
                                    %mo{:stretchy => "false"} ^
                                  %mn 2
                                %mo +
                                %msub
                                  %mover
                                    %mi v
                                    %mo{:stretchy => "false"} ^
                                  %mn 2
                                %msub
                                  %mover
                                    %mi v
                                    %mo{:stretchy => "false"} ^
                                  %mn 1
                                %mo{:stretchy => "false"} )
                                %mi A
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mover
                                %mi A
                                %mo ¯
                              %mi A
                              %mstyle{:displaystyle => "false"}
