                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mi Φ
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi fb
                            %mtr
                              %mtd
                                %mi Σ
                              %mtd
                                %mo =
                              %mtd
                                %mi Σ
                        %mphantom
