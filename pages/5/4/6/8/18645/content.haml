                                  %msup
                                    %mi k
                                    %mi μ
                                  %mo −
                                  %msup
                                    %mrow
                                      %mo (
                                      %mstyle{:displaystyle => "false"}
                                        %mfrac
                                          %mrow
                                            %mi m
                                            %mi c
                                          %mi ℏ
                                      %mo )
                                    %mn 2
                                  %mo ±
                                  %mi i
                                  %mi ϵ
                              %mspace{:width => "thinmathspace"}
                              %mi d
                              %msub
                                %mi k
                                %mn 0
                              %mspace{:width => "thinmathspace"}
                              %msup
                                %mi d
                                %mi p
                              %mover
                                %mi k
                                %mo{:stretchy => "false"} →
                              %mspace{:width => "thinmathspace"}
                              %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\Delta_{F,m}(x)
                      \&amp; =
                      \\underset{ {\epsilon \in (0,\infty)} \atop {\epsilon \to 0} }{\lim}
                      \\frac{+i}{(2\pi)^{p+1}}
                      \\int
