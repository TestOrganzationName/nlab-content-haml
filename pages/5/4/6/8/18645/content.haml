                                      %mo{:stretchy => "false"} )
                                  %mrow
                                    %mrow
                                      %mi ϵ
                                      %mo →
                                      %mn 0
                              %mfrac
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                  %mi i
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 2
                                  %mi π
                                  %msup
                                    %mo{:stretchy => "false"} )
                                    %mrow
                                      %mi p
                                      %mo +
                                      %mn 1
                              %mo ∫
                              %msubsup
                                %mo ∫
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn ∞
                                %mn ∞
                              %mfrac
