                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\left(
                      {\, \atop \,}
                      PolyObs(E_{\text{BV-BRST}})_{mc}[ [\hbar] ] \;,\;
                      \\star_H
                      {\, \atop \,}
                      \\right)
              %p
                for the corresponding
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                on
                %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
