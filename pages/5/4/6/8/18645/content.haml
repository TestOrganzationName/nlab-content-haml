                        %mi BV
                    %annotation{:encoding => "application/x-tex"} s_{BV}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi BRST
                    %annotation{:encoding => "application/x-tex"} s_{BRST}
                have (i.e. increase) bidegree as follows:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
