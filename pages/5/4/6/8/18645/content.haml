                  %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                %em
                  %a.existingWikiWord{:href => "/nlab/show/type"} type
                  of
                  %a.existingWikiWord{:href => "/nlab/show/field"} fields
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                is a
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FiberBundle"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi E
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi fb
                          %mtr
                            %mtd
                              %mi Σ
                    %annotation{:encoding => "application/x-tex"}
                      \\array{E \\ \downarrow^{\mathrlap{fb}} \\ \Sigma }
              %p
                called the
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/type"} type
                of
                %a.existingWikiWord{:href => "/nlab/show/field"} fields
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                this way, then a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
                of that type on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                is a
                %a.existingWikiWord{:href => "/nlab/show/term"} term
                of that
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/type"} type
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Sections"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Σ
                      %mo ⟶
                      %mi E
                    %annotation{:encoding => "application/x-tex"}
                      \\Phi \;\colon\; \Sigma \longrightarrow E
              %p
                such that composed with the
                %a.existingWikiWord{:href => "/nlab/show/projection"} projection
                map it is the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi fb
                      %mo ∘
                      %mi Φ
                      %mo =
                      %mi id
                      %mphantom
                        %mi AAAAAAA
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi E
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi Φ
                              %mo ↗
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi fb
                          %mtr
                            %mtd
                              %mi Σ
                            %mtd
                              %mo =
                            %mtd
                              %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      fb \circ \Phi = id
                      \\phantom{AAAAAAA}
                      \\array{
                      \&amp;&amp; E
                      \\\
                      \&amp; {}^{\mathllap{\Phi}}\nearrow &amp; \downarrow^{\mathrlap{fb}}
                      \\\
                      \\Sigma &amp; = &amp; \Sigma
                      }
                      \\,.
              %p
                The set of such
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
                is to be denoted
              #eq:SetOfFieldHistories.maruku-equation
                %span.maruku-eq-number (18)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi E
                            %mtr
                              %mtd
                              %mtd
                                %msup
