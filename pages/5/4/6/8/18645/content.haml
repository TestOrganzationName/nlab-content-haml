                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mn 0
                                    %mo{:stretchy => "false"} |
                                    %mn 1
                                %mo ,
                                %msub
                                  %mi V
                                  %mi odd
                                %mo ]
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %msub
