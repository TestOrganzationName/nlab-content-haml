                                    %mi x
                                    %mi μ
                              %mstyle{:mathvariant => "bold"}
                                %mi d
                              %msup
                                %mi x
                                %mi μ
                          %mtr
                            %mtd
                            %mtd
                              %mo ≔
                              %mrow
                                %mo (
                                %mfrac
                                  %mrow
                                    %mo ∂
                                    %mi f
                                  %mrow
                                    %mo ∂
                                    %msup
                                      %mi x
                                      %mi μ
                                %mo +
                                %mfrac
                                  %mrow
                                    %mo ∂
                                    %mi f
                                  %mrow
                                    %mo ∂
                                    %msup
                                      %mi ϕ
                                      %mi a
                                %msubsup
                                  %mi ϕ
                                  %mrow
                                    %mo ,
                                    %mi μ
                                  %mi a
                                %mo +
                                %mfrac
                                  %mrow
                                    %mo ∂
                                    %mi f
                                  %mrow
                                    %mo ∂
                                    %msubsup
                                      %mi ϕ
                                      %mrow
                                        %mo ,
                                        %mi ν
                                      %mi a
