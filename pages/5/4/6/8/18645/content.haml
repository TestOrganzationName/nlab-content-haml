                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac
                %a.existingWikiWord{:href => "/nlab/show/field+observables"} field observables
                are proportional to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                      %annotation{:encoding => "application/x-tex"} \theta
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi ℝ
                        %mn 0
                      %mo ⟶
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ×
                      %msub
                        %mi S
                        %mi odd
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      A \;\colon\; \mathbb{R}^{0} \longrightarrow PolyObs(E \times S_{odd})
              %p
                then all the odd monomials in the
                %a.existingWikiWord{:href => "/nlab/show/field+observables"} field observables
                of the
                %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
                disappear.
            .proof
              %h6#proof Proof
              %p
                By definition of supergeometric
                %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#MappingSpaceOutOfASuperCartesianSpace"}
                %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
                between
                = succeed "-plots" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 0
                            %mo{:stretchy => "false"} |
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{0 \vert 1}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_{(-)}
                of the space of observables and smooth functionss out of the
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 0
                          %mo{:stretchy => "false"} |
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{0 \vert 1}
                with the
                %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
                to the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 0
                              %mo{:stretchy => "false"} |
                              %mn 1
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi A
