                          \&amp;\overset{f_\ast(\mathbb{R}^{n_2}\times Spec(A_2) )}{\longrightarrow}&amp;
                          X_2(\mathbb{R}^{n_2} \times Spec(A_2))
                          \\\
                          \\mathllap{g_1^\ast}\downarrow &amp;&amp; \downarrow\mathrlap{g^\ast_2}
                          \\\
                          X_1(\mathbb{R}^{n_1} \times Spec(A_1))
                          \&amp;\underset{f_\ast(\mathbb{R}^{n_1})}{\longrightarrow}&amp;
                          X_2(\mathbb{R}^{n_1} \times Spec(A_1))
                          }
            %p
              (
              %a{:href => "synthetic+differential+supergeometry#Yetter88"}> Yetter 88
              )
            %p
              Basing
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
              on
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"} super formal smooth sets
              is an instance of the general approach to
              %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
              called
              %em
                %a.existingWikiWord{:href => "/nlab/show/functorial+geometry"} functorial geometry
              or
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supergeometry"} geometry of physics – supergeometry
            %p
              In direct generalization of example
              %a.maruku-ref{:href => "#SmoothManifoldsAreDiffeologicalSpaces"}
              we have:
            #SuperSmoothSetSuperCartesianSpaces.num_example
              %h6#example_23 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+spaces"} super Cartesian spaces
                  are
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"} super smooth sets
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperCartesianSpace"}
                %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth set
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo ∈
                      %mi X
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ×
                      %mi 𝔻
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Phi \in X(\mathbb{R}^n \times \mathbb{D})
                to the algebra homomorphisms
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo ×
                        %mi 𝔻
                        %mo{:stretchy => "false"} )
                        %mo ←
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mi b
                            %mo{:stretchy => "false"} |
                            %mi s
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^n \times \mathbb{D}) \leftarrow C^\infty(\mathbb{R}^{b\vert s})
              %p
                Under this identification, morphisms between
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+spaces"} super Cartesian spaces
                are in
                %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
                with their morphisms regarded as
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth sets
              %p
                Stated more
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/category+theory"} abstractly
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
                over a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/subcanonical+site"} subcanonical site
            %p
              Similarly, in direct generalization of prop.
              %a.maruku-ref{:href => "#CartSpYpnedaLemma"}
              we have:
            #SuperCartSpYpnedaLemma.num_prop
              %h6#proposition_2 Proposition
              %p
                %strong
                  (plots of a
                  %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth set
                  really are the
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                  into the smooth smooth set)
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth set
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ×
                      %mi 𝔻
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times \mathbb{D}
                any
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperCartesianSpace"}
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
                %a.existingWikiWord{:href => "/nlab/show/function"} function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi SmoothSet
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mo ≃
                      %mi X
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{SmoothSet}(\mathbb{R}^n , X) \overset{\simeq}{\longrightarrow} X(\mathbb{R}^n)
              %p
                from the set of homomorphisms of super smooth sets from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ×
                      %mi 𝔻
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times \mathbb{D}
                (regarded as a super smooth set via example
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperSmoothSetSuperCartesianSpaces"}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                        %mo ×
                        %mi 𝔻
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times \mathbb{D}
                %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity
                plot
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi id
                          %mrow
                            %msup
                              %mi ℝ
                              %mi n
                            %mo ×
                            %mi 𝔻
                      %annotation{:encoding => "application/x-tex"} id_{\mathbb{R}^n \times \mathbb{D}}
              %p
                This function is a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              %p
                This says that the plots of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                into being as declaring the
                %em would-be
                smooth functions into
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %em actual
                smooth functions into
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            .proof
              %h6#proof_5 Proof
              %p
                This is the statement of the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
                over the
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+spaces"} super Cartesian spaces
            %p
              We do not need to consider here
              %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
              more general than the
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+spaces"} super Cartesian spaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SuperCartesianSpace"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              according to def./prop.
              = succeed ":" do
                %a.maruku-ref{:href => "#SmoothManifoldInsideDiffeologicalSpaces"}
            #SuperSmoothManifolds.num_defn
              %h6#definitionproposition_2 Definition/Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/supermanifolds"}> supermanifolds
                  )
              %p
                A
                %em
                  %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                of
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                super-dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ℕ
                      %mo ×
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} (b,s) \in \mathbb{N} \times \mathbb{N}
                is
              %ul
                %li
                  a
                  %a.existingWikiWord{:href => "/nlab/show/super+smooth+set"} super smooth set
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
              %p such that
              %ol
                %li
                  %p
                    there exists an
                    %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed set
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msup
                            %mi ℝ
                            %mrow
                              %mi b
                              %mo{:stretchy => "false"} |
                              %mi s
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ϕ
                                %mi i
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} }
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                        %annotation{:encoding => "application/x-tex"} \{ \mathbb{R}^{b\vert s} \overset{\phi_i}{\to} X\}_{i \in I}
                    of morphisms of
                    %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"} super smooth sets
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
                    %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+spaces"} super Cartesian spaces
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mrow
                              %mi b
                              %mo{:stretchy => "false"} |
                              %mi s
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^{b\vert s}
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#SuperCartesianSpace"}
                    %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth sets
                    via example
                    %a.maruku-ref{:href => "#SuperSmoothSetSuperCartesianSpaces"}
                    into
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X
                  %ol
                    %li
                      %p
                        for every plot
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msup
                                %mi ℝ
                                %mi n
                              %mo ×
                              %mi 𝔻
                              %mo →
                              %mi X
                            %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times \mathbb{D} \to X
                        there is a
                        %a.existingWikiWord{:href => "/nlab/show/differentiably+good+open+cover"} differentiably good open cover
                        (def.
                        = succeed ")" do
                          %a.maruku-ref{:href => "#DifferentiablyGoodOpenCover"}
                        = succeed ";" do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %msubsup
                                  %mi ℝ
                                  %mi i
                                  %mrow
                                    %mi b
                                    %mo{:stretchy => "false"} |
                                    %mi s
                              %annotation{:encoding => "application/x-tex"} \mathbb{R}^{b\vert s}_i
                    %li
                      %p
                        every
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi ϕ
                                %mi i
                            %annotation{:encoding => "application/x-tex"} \phi_i
                        is a
                        %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphism"} local diffeomorphism
                        according to def.
                        = succeed "," do
                          %a.maruku-ref{:href => "#FormalSmoothSetLocalDiffeomorphism"}
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
                        = succeed ";" do
                          %a.existingWikiWord{:href => "/nlab/show/superpoints"} superpoints
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/bosonic+modality"} bosonic
                    part of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                    according to def./prop.
                    = succeed "." do
                      %a.maruku-ref{:href => "#SmoothManifoldInsideDiffeologicalSpaces"}
            %p
              Finally we have the evident generalization of the smooth moduli space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^\bullet
              of
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
              from example
              %a.maruku-ref{:href => "#UniversalSmoothModuliSpaceOfDifferentialForms"}
              to
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            #ModuliOfSDifferentialForms.num_example
              %h6#example_24 Example
              %p
                %strong
                  (universal
                  %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth
                  %a.existingWikiWord{:href => "/nlab/show/moduli+spaces"} moduli spaces
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi M
                    %annotation{:encoding => "application/x-tex"} n \in \mathbf{M}
                write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi n
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi SuperSmoothSet
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{\Omega}^n \;\in\; SuperSmoothSet
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/super+smooth+set"} super smooth set
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperSmoothSetSuperCartesianSpaces"}
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi SuperCartSp
                    %annotation{:encoding => "application/x-tex"} U \in SuperCartSp
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperCartesianSpace"}
                %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DifferentialFormOnSuperCartesianSpaces"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi Ω
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{\Omega}^n(U) \;\coloneqq\; \Omega^n(U)
              %p
                and whose maps of plots is given by
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
                of super differential forms.
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
                on
                %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
                applied plot-wise yields a morpism of super smooth sets
              #eq:SuperUniversalDeRhamDifferential.maruku-equation
                %span.maruku-eq-number (27)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi n
                      %mo ⟶
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d \;\colon\; \mathbf{\Omega}^n \longrightarrow \mathbf{\Omega}^{n+1}
                      \\,.
              %p
                As before in def.
                %a.maruku-ref{:href => "#DifferentialFormsOnDiffeologicalSpaces"}
                we then define for any
                %a.existingWikiWord{:href => "/nlab/show/super+smooth+set"} super smooth set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi SuperSmoothSet
                    %annotation{:encoding => "application/x-tex"} X \in SuperSmoothSet
                its set of differential
                = succeed "-forms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Hom
                        %mi SuperSmoothSet
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\Omega^n(X)
                      \\;\coloneqq\;
                      Hom_{SuperSmoothSet}(X,\mathbf{\Omega}^n)
              %p
                and we define the
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
                on these to be given by postcomposition with
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:SuperUniversalDeRhamDifferential"} (27)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            #FermionicBosonicFields.num_defn
              %h6#definition_15 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/bosonic+fields"} bosonic fields
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/fermionic+fields"} fermionic fields
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo ⟶
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\longrightarrow} \Sigma
                with total space a
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperCartesianSpace"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperSmoothManifolds"}
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %ul
                %li
                  %p
                    the even-graded
                    %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                    are called the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/bosonic+field"} bosonic
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
                %li
                  %p
                    the odd-graded
                    %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                    are called the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/fermionic+field"} fermionic
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              %p
                In components, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo =
                      %mi Σ
                      %mo ×
                      %mi F
                    %annotation{:encoding => "application/x-tex"} E = \Sigma \times F
                is a
                %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivial bundle
                with
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                a
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperCartesianSpace"}
                %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϕ
                        %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\phi^a)
                and odd-graded
                %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ψ
                          %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\psi^A)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \phi^a
                are called the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/bosonic+field"} bosonic
                field coordinates, and the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ψ
                        %mi A
                    %annotation{:encoding => "application/x-tex"} \psi^A
                are called the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/fermionic+field"} fermionic
                field coordinates.
            %p
              What is crucial for the discussion of
              %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
              is the following immediate
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometric
              analog of the smooth structure on the
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              from example
              = succeed ":" do
                %a.maruku-ref{:href => "#DiffeologicalSpaceOfFieldHistories"}
            #SupergeometricSpaceOfFieldHistories.num_example
              %h6#example_25 Example
              %p
                %strong
