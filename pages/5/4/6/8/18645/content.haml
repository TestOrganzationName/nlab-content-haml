                                %mrow
                                  %mover
                                    %mo ∂
                                    %mo ←
                                  %mi f
                                %mrow
                                  %mo ∂
                                  %msup
                                    %mi c
                                    %mi α
                              %mfrac
                                %mrow
                                  %mover
                                    %mo ∂
                                    %mo →
                                  %mi g
                                %mrow
                                  %mo ∂
                                  %msubsup
                                    %mi c
                                    %mi α
                                    %mo ‡
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\left\{ f,g \right\}
                      \&amp; =
                      \\phantom{+}
                      \\frac{\overset{\leftarrow}{\partial} f}{\partial \phi^\ddagger_a}
                      \\frac{\overset{\rightarrow}{\partial} g}{\partial {\phi}^a}
                      \-
                      \\frac{\overset{\leftarrow}{\partial} f}{\partial \phi^a}
                      \\frac{\overset{\rightarrow}{\partial} g}{\partial \phi^\ddagger_a}
                      \\\
                      \&amp;
                      \\phantom{=}
                      +
                      \\frac{\overset{\leftarrow}{\partial} f}{\partial c^\ddagger_\alpha}
                      \\frac{\overset{\rightarrow}{\partial} g}{\partial {c}^{\alpha}}
                      \-
                      \\frac{\overset{\leftarrow}{\partial} f}{\partial c^{\alpha}}
                      \\frac{\overset{\rightarrow}{\partial} g}{\partial c^\ddagger_\alpha}
                      \\end{aligned}
                      \\,,
              %p
                where the arrow over the
                %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
                indicates that we we pick up signs via the
                %a.existingWikiWord{:href => "/nlab/show/Leibniz+rule"} Leibniz rule
                either as usual, going through products from left to right (for
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mo ∂
                          %mo →
                      %annotation{:encoding => "application/x-tex"} \overset{\rightarrow}{\partial}
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mo ∂
                          %mo ←
                      %annotation{:encoding => "application/x-tex"} \overset{\leftarrow}{\partial}
              %p
                In this form the
                %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
                is called the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
            %p
              (e. g.
              = succeed "," do
                %a{:href => "antibracket#Henneaux90"} Henneaux 90, (53d)
              = succeed ")" do
                %a{:href => "antibracket#HenneauxTeitelboim92"} Henneaux-Teitelboim 92, section 15.5.2
            %p
              The power of the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
              %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
              rests in the fact that it makes the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+differential"} Chevalley-Eilenberg differential
              on a
              %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi d
                        %mi S
                        %mo ≃
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} (X/\mathfrak{g})_{d S \simeq 0}
              become a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              with the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+differential"} Chevalley-Eilenberg differential
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} X/\mathfrak{g}
            #ChevalleyEilenbergDifferentialOnDerivedCriticalLocusIsHamiltonianViaAntibracket.num_example
              %h6#example_5 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+differential"} Chevalley-Eilenberg differential
                  of
                  %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
                  is
                  %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
                  for the
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi 𝔤
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi d
                          %mi S
                          %mo ≃
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} (X/\mathfrak{g})_{d S \simeq 0}
                be a
                %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
                inside an
                %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
                as in example
                = succeed "." do
                  %a.maruku-ref{:href => "#ArchetypeOfBVBRSTComplex"}
              %p
                Then the CE-differential
                %a.maruku-eqref{:href => "#eq:ExplicitCEDifferentialInCotangentBundleOfActionLieAlgebroid"} (183)
                of the
                %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi 𝔤
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mi S
                          %mo ≃
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} X/\mathfrak{g}\vert_{S \simeq 0}
                is simply the
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
                %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SchoutenBracketAndAntibracket"}
                %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              #eq:BVBRSTFunctionForActionLieAlgebroid.maruku-equation
                %span.maruku-eq-number (187)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mtext BV-BRST
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi S
                      %mo −
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} /
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      S_{\text{BV-BRST}}
                      \\;\coloneqq\;
                      S - d_{CE(X/\mathfrak{g})}
              %p
                of the
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+differential"} Chevalley-Eilenberg differential
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} X/\mathfrak{g}
                and the function
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi S
                      %annotation{:encoding => "application/x-tex"} -S
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mrow
                            %mo (
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi d
                                %mi S
                                %mo ≃
                                %mn 0
                            %mo )
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo {
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi S
                        %mo +
                        %msub
                          %mi d
                          %mrow
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d_{CE\left( (X/\mathfrak{g})_{d S \simeq 0} \right) }(-)
                      \\;=\;
                      \\left\{
                      \- S + d_{CE(X/\mathfrak{g})}
                      \\,,\,
                      (-)
                      \\right\}
                      \\,.
              %p
                In coordinates, using the expression for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} /
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_{CE(X/\mathfrak{g})}
                from
                %a.maruku-eqref{:href => "#eq:DifferentialOnActionLieAlgebroid"} (171)
                and using the notation for derivations from
                %a.maruku-eqref{:href => "#eq:AntiNotationForDerivations"} (179)
                this means that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mrow
                            %mo (
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi d
                                %mi S
                                %mo ≃
                                %mn 0
                            %mo )
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo {
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi S
                        %mo +
                        %msup
                          %mi c
                          %mi α
                        %msubsup
                          %mi R
                          %mi α
                          %mi a
                        %msubsup
                          %mi ϕ
                          %mi a
                          %mo ‡
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msup
                          %mi γ
                          %mi α
                        %msub
                          %mrow
                          %mrow
                            %mi β
                            %mi γ
                        %msup
                          %mi c
                          %mi β
                        %msup
                          %mi c
                          %mi γ
                        %msubsup
                          %mi c
                          %mi α
                          %mo ‡
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d_{CE\left( (X/\mathfrak{g})_{d S \simeq 0} \right)}(-)
                      \\;=\;
                      \\left\{
                      \- S
                      +
                      c^\alpha R_\alpha^a \phi^\ddagger_a
                      \-
                      \\tfrac{1}{2}\gamma^\alpha{}_{\beta \gamma} c^\beta c^\gamma
                      c^\ddagger_\alpha
                      \\,,\,
                      (-)
                      \\right\}
                      \\,.
            .proof
              %h6#proof_5 Proof
              %p
                This is a simple straightforward computation, but we spell it out for illustration of the general principle. The result is to be compared with
                = succeed ":" do
                  %a.maruku-eqref{:href => "#eq:ExplicitCEDifferentialInCotangentBundleOfActionLieAlgebroid"} (183)
              %p
                for
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ϕ
                          %mi a
                      %annotation{:encoding => "application/x-tex"} \phi^a
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
