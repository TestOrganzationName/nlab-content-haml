              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 0
                          %mo{:stretchy => "false"} |
                          %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi odd
                    %annotation{:encoding => "application/x-tex"}
                      \\theta \in C^\infty(\mathbb{R}^{0\vert 1})_{odd}
              %p
                is the canonical odd-graded coordinate function on the
                %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 0
                          %mo{:stretchy => "false"} |
                          %mn 1
