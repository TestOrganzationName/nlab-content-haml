                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma_\Sigma(E) \in SuperSmoothSet
              %p
                whose plots
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
                for a given
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                and
                %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔻
                    %annotation{:encoding => "application/x-tex"} \mathbb{D}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperCartesianSpace"}
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ≔
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ×
                      %mi 𝔻
                    %annotation{:encoding => "application/x-tex"} U \coloneqq \mathbb{R}^n \times \mathbb{D}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} U \times \Sigma
                regarded as
                %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth sets
                according to example
                %a.maruku-ref{:href => "#SuperSmoothSetSuperCartesianSpaces"}
                are defined to be the
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                of
                %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth set
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi U
                              %mo ×
                              %mi Σ
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi Φ
                                    %mrow
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                            %mtd
