                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                such that there exists a
                %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivialization
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
