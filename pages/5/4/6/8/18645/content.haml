                              %mo +
                              %mn 1
                              %mo ,
                              %mn 0
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          dvol_\Sigma =  d x^0 \wedge d x^1 \wedge \cdots \wedge d x^p
