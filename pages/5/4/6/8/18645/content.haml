                                %mi n
                              %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \&amp;
                      \\underset{\Sigma^n}{\int}
                      T_{(\alpha_i), (\beta_j)}(x_1, \cdots, x_{r}, x_{r+1}, \cdots x_{n})
                      g_1(x_1) \cdots g_r(x_r)
                      \\,
                      j_1(x_{r+1}) \cdots j_n(x_n)
                      \\, dvol_{\Sigma^n}(x_1, \cdots x_n)
                      \\\
                      \&amp; \coloneqq
                      T( S_1, \cdots, S_r, A_{r+1}, \cdots, A_n )
                      \\end{aligned}
                      \\,.
              %p
                Moreover, the subscripts on these
                %a.existingWikiWord{:href => "/nlab/show/generalized+functions"} generalized functions
                will always be clear from the context, so that in computations we may notationally suppress these.
              %p
                Finally, due to the “symmetry” axiom in def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TimeOrderedProduct"}
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                of arguments, not on the order of the arguments. We will write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ≔
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi x
                        %mi r
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbf{X} \coloneqq \{x_1, \cdots, x_r\}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo ≔
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi y
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %msub
                        %mi y
                        %mi r
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y} \coloneqq \{y_1, \cdots y_r\}
                for sets of spacetime points, and hence abbreviate the expression for the “value” of the generalized function in the above as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T(\mathbf{X}, \mathbf{Y})
                etc.
              %p In this condensed notation the above reads
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∫
                        %mrow
                          %msup
                            %mi Σ
                            %mrow
                              %mi r
                              %mo +
                              %mi s
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi g
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mi ⋯
                      %msub
                        %mi g
                        %mi r
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi r
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi j
                        %mrow
                          %mi r
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mrow
                          %mi r
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                      %mi ⋯
                      %msub
                        %mi j
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi dvol
                        %mrow
                          %msup
                            %mi Σ
                            %mrow
                              %mi r
                              %mo +
                              %mi s
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\underset{\Sigma^{r+s}}{\int}
                      T(\mathbf{X}, \mathbf{Y})
                      \\,
                      g_1(x_1) \cdots g_r(x_r)
                      j_{r+1}(x_{r+1}) \cdots j_n(x_n)
                      \\,
                      dvol_{\Sigma^{r+s}}(\mathbf{X})
                      \\,.
            %p This condensed notation turns out to be greatly simplify computations, as it absorbs all the “relative” combinatorial prefactors:
            #ProductOfPerturbationSeriesInGenealizedFunctionNotation.num_example
              %h6#example_4 Example
              %p
                %strong
                  (product of perturbation series in
                  = succeed "-notation)" do
                    %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
              %p Let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi n
                          %mo =
                          %mn 0
                        %mn ∞
                      %mfrac
                        %mn 1
                        %mrow
                          %mi n
                          %mo !
                      %mo ∫
                      %mi U
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi g
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mi ⋯
                      %mi g
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi dvol
                    %annotation{:encoding => "application/x-tex"}
                      U(g)
                      \\coloneqq
                      \\underoverset{n = 0}{\infty}{\sum}
                      \\frac{1}{n!}
                      \\int U(x_1, \cdots, x_n)
                      \\,
                      g(x_1) \cdots g(x_n) \, dvol
              %p and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi n
                          %mo =
                          %mn 0
                        %mn ∞
                      %mfrac
                        %mn 1
                        %mrow
                          %mi n
                          %mo !
                      %mo ∫
                      %mi V
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi g
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mi ⋯
                      %mi g
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi dvol
                    %annotation{:encoding => "application/x-tex"}
                      V(g)
                      \\coloneqq
                      \\underoverset{n = 0}{\infty}{\sum}
                      \\frac{1}{n!}
                      \\int V(x_1, \cdots, x_n)
                      \\,
                      g(x_1) \cdots g(x_n) \, dvol
              %p
                be power series of
                = succeed "-valued" do
                  %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
                in the
                = succeed "-notation" do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
                = succeed "." do
                  %a.maruku-ref{:href => "#NotationForTimeOrderedProductsAsGeneralizedFunctions"}
              %p
                Then their product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(g) \coloneqq U(g) V(g)
                with
                = succeed "-representation" do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi n
                          %mo =
                          %mn 0
                        %mn ∞
                      %mfrac
                        %mn 1
                        %mrow
                          %mi n
                          %mo !
                      %mo ∫
                      %mi W
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi g
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mi ⋯
                      %mi g
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi dvol
                    %annotation{:encoding => "application/x-tex"}
                      W(g)
                      \\coloneqq
                      \\underoverset{n = 0}{\infty}{\sum}
                      \\frac{1}{n!}
                      \\int W(x_1, \cdots, x_n)
                      \\,
                      g(x_1) \cdots g(x_n) \, dvol
              %p is given simply by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi I
                          %mo ⊂
                          %mstyle{:mathvariant => "bold"}
                            %mi X
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mo{:stretchy => "false"} )
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ∖
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      W(\mathbf{X})
                      \\;=\;
                      \\underset{\mathbf{I} \subset \mathbf{X}}{\sum} U(\mathbf{I}) V(\mathbf{X} \setminus \mathbf{I})
                      \\,.
            %p
              (
              %a{:href => "S-matrix#EpsteinGlaser73"}> Epstein-Glaser 73 (5)
              )
            .proof
              %h6#proof_7 Proof
              %p
                For fixed
                %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mo{:stretchy => "false"} |
                      %mo =
                      %msub
                        %mi n
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} {\vert \mathbf{I} \vert} = n_1
                the sum over all subsets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mo ⊂
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{I} \subset \mathbf{X}
                overcounts the sum over
                %a.existingWikiWord{:href => "/nlab/show/partitions"} partitions
                of the coordinates as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
