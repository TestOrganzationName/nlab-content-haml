                              %mi x
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                            %mtd
                              %msup
                                %mi ϕ
                                %mi a
                            %mtd
                              %mo ∘
                              %mi Φ
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mtext field
                                  %mtr
                                    %mtd
                                      %mtext observable
                            %mtd
                            %mtd
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mtext field
                                  %mtr
                                    %mtd
                                      %mtext history
                            %mtd
