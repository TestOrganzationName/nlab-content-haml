            #InteractingFieldAlgebraOfObservablesIsFormalDeformationQuantization.num_prop
              %h6#proposition_2 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/interacting+field+algebra+of+observables"} interacting field algebra of observables
                  is
                  %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
                  of
                  %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
