                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\hat p \Psi(q,p)
                      \&amp; =
                      i \nabla_{\partial_q} \Psi(q,p) + p \Psi(q,p)
                      \\\
                      \&amp; = i \frac{\partial}{\partial q} (\psi(q)e^{i q p}) + p \Psi(q,p)
                      \\\
                      \&amp; =
                      \\left(
                      i \frac{\partial}{\partial q}\psi(q)
                      \\right) e^{i q p}
                      +
                      \\underset{ = 0}{
                      \\underbrace{
                      \\underset{
                      \= - p \Psi(q,p)
                      }{
                      \\underbrace{
                      \\psi(q)
                      \\left(
                      i \frac{\partial}{\partial q} e^{i q p}
                      \\right)
                      }
                      }
                      +
                      p \Psi(q,p)
                      }
                      }
                      \\\
                      \&amp; =
                      \\left(
                      i \frac{\partial}{\partial q}\psi(q)
                      \\right) e^{i p q}
                      \\end{aligned}
                      \\,.
              %p
                Hence under the identification
                %a.maruku-eqref{:href => "#eq:PolarizedFunctionsForBasicExampleOnR2"} (214)
                we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi q
