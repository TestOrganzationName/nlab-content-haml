                    }{\,}
                    }
            %p
              The independence of the
              %a.existingWikiWord{:href => "/nlab/show/causally+local+net"} causally local net
              of localized
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+algebras+of+observables"} interacting field algebras of observables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi IntObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} IntObs(E_{\text{BV-BRST}}, \mathbf{L}_{int} )(\mathcal{O})
              from the choice of
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatic switching
              implies a well-defined spacetime-global
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+observables"} algebra of observables
              by forming the
              %a.existingWikiWord{:href => "/nlab/show/inductive+limit"} inductive limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi IntObs
                    %mo{:stretchy => "false"} (
