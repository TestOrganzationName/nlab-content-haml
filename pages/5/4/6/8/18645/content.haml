                %a.maruku-eqref{:href => "#eq:RealAndSymmetricH"} (150)
                in prop.
                %a.maruku-ref{:href => "#SkewSymmetricPartOfHadmrdPropagatorIsCausalPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
                says that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
