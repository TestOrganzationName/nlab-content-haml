              %p
                Then the global
                %a.existingWikiWord{:href => "/nlab/show/BV-differential"} BV-differential
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi S
