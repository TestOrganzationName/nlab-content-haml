                              %mtext factors
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi dvol
                            %mi Σ
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          S_{int}
                          \\;=\;
                          \\underset{\Sigma}{\int}
                          g_{sw}
                          \\,
                          \\underset{
                          n \, \text{factors}
                          }{
                          \\underbrace{
                          \\mathbf{\Phi}(x)
                          \\cdot
                          \\mathbf{\Phi}(x)
                          \\cdots
                          \\mathbf{\Phi}(x)
                          \\cdot
                          \\mathbf{\Phi}(x)
                          }
                          }
                          \\,
                          dvol_\Sigma(x)
                  %p
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
                    of order
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
              %p
                Therefore one needs to extend the
                %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
                provided by corollary
                %a.maruku-ref{:href => "#FreeGaugeFixedLagrangianFieldTheoryQuantizationOfRegularObservables"}
                to a larger subspace of
                %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
                that includes at least the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              %p
                But prop.
                %a.maruku-ref{:href => "#SymmetricContribution"}
                characterizes the freedom in choosing a
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
                %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
                by a symmetric contribution. In view of prop.
                %a.maruku-ref{:href => "#PropagatorStarProduct"}
                and in view of of
                %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
                for the
                %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#HoermanderCriterionForProductOfDistributions"}
                %a.existingWikiWord{:href => "/nlab/show/integral+kernels"} integral kernels
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                such that the sum
              #eq:ShiftingCausalPropagatorBySymmetricContribution.maruku-equation
                %span.maruku-eq-number (218)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi H
                      %mo =
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi i
                          %mn 2
                      %mi Δ
                      %mo +
                      %mi H
                    %annotation{:encoding => "application/x-tex"}
                      \\Delta_H = \tfrac{i}{2}\Delta + H
              %p
                has a
                %em smaller
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#WaveFrontSet"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi i
                          %mn 2
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \tfrac{i}{2}\Delta
                itself has. The smaller
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi WF
                        %mo{:stretchy => "false"} (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mi i
                            %mn 2
                        %mi Δ
                        %mo +
                        %mi H
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} WF(\tfrac{i}{2}\Delta + H)
                %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
                on which the corresponding
                %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
                exists.
              %p
                Now by prop.
                %a.maruku-ref{:href => "#SkewSymmetricPartOfHadmrdPropagatorIsCausalPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
                the
                %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \Delta_H
                is of the form
                %a.maruku-eqref{:href => "#eq:ShiftingCausalPropagatorBySymmetricContribution"} (218)
                and by prop.
                %a.maruku-ref{:href => "#WaveFronSetsForKGPropagatorsOnMinkowski"}
                its
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                is only “half” that of the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \Delta_H
                does yield a
                %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
                of a subspace of
                %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
                that includes all
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                on
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
                = succeed "." do
                  %em
                    %a{:href => "#FreeQuantumFields"} Free quantum fields
              %p
                With such a
                %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
                of the
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
                in hand, we may then finally obtain also a formal deformation quantization of
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interacting
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theories"} Lagrangian field theories
                by
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbation theory
                %em
                  %a{:href => "#Scattering"} Scattering
                and
                = succeed "." do
                  %em
                    %a{:href => "#QuantumObservables"} Quantum observables
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              This concludes our discussion of some basic concepts of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
              %a{:href => "#FreeQuantumFields"} next chapter
              we apply this to discuss the
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+quantum+observables"} algebra of quantum observables
              of
              %a.existingWikiWord{:href => "/nlab/show/free+field+theories"} free
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theories"} Lagrangian field theories
              %em
                %a{:href => "#QuantumObservables"} Quantum observables
              we then discuss also the quantization of the
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interacting
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theories"} Lagrangian field theories
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/perturbation+theory"} perturbatively
          %div
            %h2#FreeQuantumFields Free quantum fields
            %p In this chapter we discuss the following topics:
            %ul
              %li
                %p
                  %em
                    %a{:href => "#WickAlgebraAbstract"} Wick algebra
              %li
                %p
                  %em
                    %a{:href => "#AbstractTimeOrderedProduct"} Time-ordered product
              %li
                %p
                  %em
                    %a{:href => "#OperatorProductAndNormalOrderedProduct"} Operator product notation
              %li
                %p
                  %em
                    %a{:href => "#HadamardVacuumStatesOnWickAlgebras"} Hadamard vacuum state
              %li
                %p
                  %em
                    %a{:href => "#FreeQuantumBVDifferential"} Free quantum BV-differential
              %li
                %p
                  %em
                    %a{:href => "#SchwingerDysonEquation"} Schwinger-Dyson equation
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              In the
              %a{:href => "#Quantization"} previous chapter
              we discussed
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
              of linear
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/phase+spaces"} phase spaces
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+observables"} algebra of observables
              into a
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+algebra"} noncommutative algebra
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+spaces"} covariant phase spaces
              of
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theories"} Lagrangian field theories
              (as discussed in the chapter
              = succeed ")," do
                %em
                  %a{:href => "#GaugeFixing"} Gauge fixing
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
              for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/free+fields"} free fields
            %p
              For this purpose we first need to find a sub-algebra of all observables which is large enough to contain all
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              (such as the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/phi%5En+interaction"} phi^n interaction
              %a.maruku-ref{:href => "#InWickAlgebraphinInteraction"}
              below, and the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/electron-photon+interaction"} electron-photon interaction
              %a.maruku-ref{:href => "#InWickAlgebraElectronPhotonInteraction"}
              below) but small enough for the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              %a.existingWikiWord{:href => "/nlab/show/deformation+quantization"} deformation quantization
              to meet
              %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
              for absence of
              %a.existingWikiWord{:href => "/nlab/show/UV-divergences"} UV-divergences
              (remark
              = succeed ")." do
                %a.maruku-ref{:href => "#UltravioletDivergencesFromPaleyWiener"}
              %a.maruku-ref{:href => "#PointwiseProductsOfFieldObservablesAdiabaticallySwitchedIsMicrocausal"}
              below): It is called the algebra of
              %em
                %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
              (def.
              %a.maruku-ref{:href => "#MicrocausalObservable"}
              below).
            %div
              %p
                %strong>
                  %a.existingWikiWord{:href => "/nlab/show/types"} types
                  of
                  %a.existingWikiWord{:href => "/nlab/show/observables"} observables
                  in
                  %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
                \:
              .maruku-equation
                %math#mathml_dc72fc1ac31759c80d4dd998a660470e72d5ea5d_1.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mtext local
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %mtext field
                            %mtd
                              %mo ⟶
                            %mtd
                              %mtext linear
                            %mtd
                              %mo ⟶
                            %mtd
                              %mtext microcausal
                            %mtd
                              %mo ⟶
                            %mtd
                              %mtext polynomial
                            %mtd
                              %mo ⟶
                            %mtd
                              %mtext general
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mo ↗
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mtext regular
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp;
                      \\text{local}
                      \\\
                      \&amp;&amp;
                      \&amp; \searrow
                      \\\
                      \\text{field}
                      \&amp;\longrightarrow&amp;
                      \\text{linear}
                      \&amp;\longrightarrow&amp;
                      \\text{microcausal}
                      \&amp;\longrightarrow&amp;
                      \\text{polynomial}
                      \&amp;\longrightarrow&amp;
                      \\text{general}
                      \\\
                      \&amp;&amp;
                      \&amp; \nearrow
                      \\\
                      \&amp;&amp;
                      \\text{regular}
                      }
            %p
              While the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              of the
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              still violates
              %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
              for absence of
              %a.existingWikiWord{:href => "/nlab/show/UV-divergences"} UV-divergences
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
              %a{:href => "#Quantization"} previous chapter
              that qantization freedom allows to shift this
              %a.existingWikiWord{:href => "/nlab/show/Poisson+tensor"} Poisson tensor
              by a symmetric contribution. By prop.
              %a.maruku-ref{:href => "#SkewSymmetricPartOfHadmrdPropagatorIsCausalPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
              such a shift is provided by passage from the
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              %a.maruku-ref{:href => "#WaveFronSetsForKGPropagatorsOnMinkowski"}
              this reduces the
              %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              and hence the UV-singularities “by half”.
            %p
              This way the
              %a.existingWikiWord{:href => "/nlab/show/deformation+quantization"} deformation quantization
              of the
              %a.existingWikiWord{:href => "/nlab/show/Peierls-Poisson+bracket"} Peierls-Poisson bracket
              exists on
              %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
              as the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              algebra induced by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              %a.existingWikiWord{:href => "/nlab/show/non-commutative+algebra"} non-commutative
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+observables"} algebra of observables
              is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              (prop.
              %a.maruku-ref{:href => "#MoyalStarProductOnMicrocausal"}
              below). Its algebra structure may be expressed in terms of a commutative “
              %a.existingWikiWord{:href => "/nlab/show/normal-ordered+product"}> normal-ordered product
              ” (def.
              %a.maruku-ref{:href => "#NormalOrderedProductNotation"}
              below) and the
              %a.existingWikiWord{:href => "/nlab/show/vacuum+expectation+values"} vacuum expectation values
              of
              %a.existingWikiWord{:href => "/nlab/show/field+observables"} field observables
              in a canonically induced
              %a.existingWikiWord{:href => "/nlab/show/vacuum+state"} vacuum state
              (prop.
              %a.maruku-ref{:href => "#WickAlgebraCanonicalState"}
              below).
            %p
              The analogous
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              induced by the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              (def.
              %a.maruku-ref{:href => "#OnRegularPolynomialObservablesTimeOrderedProduct"}
              below) acts by first
              %a.existingWikiWord{:href => "/nlab/show/causal+ordering"} causal ordering
              its arguments and then multiplying them with the
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra product
              (prop.
              %a.maruku-ref{:href => "#CausalOrderingTimeOrderedProductOnRegular"}
              below) and hence is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              (def.
              %a.maruku-ref{:href => "#OnRegularPolynomialObservablesTimeOrderedProduct"}
              below). This is the key structure in the discussion of
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting field theory
              discussed in the next chapter
              = succeed "." do
                %em
                  %a{:href => "#InteractingQuantumFields"} Interacting quantum fields
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              only, hence for averages of
              %a.existingWikiWord{:href => "/nlab/show/field+observables"} field observables
              that evaluate at distinct
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              points. The
              %a.existingWikiWord{:href => "/nlab/show/extension"} extension
              of the
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              to
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              is possible, but requires making choices: This is called
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/renormalization"} renormalization
              %em
                %a{:href => "#Renormalization"} Renormalization
              below.
            %div
              %table
                %thead
                  %tr
                    %th
                    %th
                      %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field
                      %a.existingWikiWord{:href => "/nlab/show/algebra+of+quantum+observables"} algebra of quantum observables
                    %th
                      %a.existingWikiWord{:href => "/nlab/show/physics"} physics
                      terminology
                    %th
                      %a.existingWikiWord{:href => "/nlab/show/mathematics"} maths
                      terminology
                %tbody
                  %tr
                    %td{:style => "text-align: left;"} 1)
                    %td{:style => "text-align: left;"}
                      %a.existingWikiWord{:href => "/nlab/show/supercommutative+algebra"} supercommutative product
                    %td{:style => "text-align: left;"}
                      %math#mathml_0c965b27b918c973b0d6a80ade615bbc435d8f77_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
