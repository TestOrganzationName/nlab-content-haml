                      %mi V
                    %annotation{:encoding => "application/x-tex"}
                      U_i \cap U_j \times V
                      \\overset{f_i\vert_{U_i \cap U_j}}{\longrightarrow}
                      E\vert_{U_i \cap U_j}
                      \\overset{f_j^{-1}\vert_{U_i \cap U_j}}{\longrightarrow}
                      U_i \cap U_j \times V
