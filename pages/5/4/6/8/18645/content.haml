            %p
              We will focus on discussing the
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometric
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#SupergeometricSpaceOfFieldHistories"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              (def.
              %a.maruku-ref{:href => "#DiracFieldBundle"}
              below). This we consider below in example
              = succeed ";" do
                %a.maruku-ref{:href => "#DiracFieldBundle"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            %p
              Example
              %a.maruku-ref{:href => "#SupergeometricSpaceOfFieldHistories"}
              is really a special case of a general relative
              = succeed "-construction" do
                %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              = succeed "." do
                %a.maruku-ref{:href => "#MappingSpaceOutOfAnInfinitesimallyThickenedCartesianSpace"}
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometric
              context.
            #MappingSpaceOutOfASuperCartesianSpace.num_defn
              %h6#definition_16 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/supergeometry"}> super
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
