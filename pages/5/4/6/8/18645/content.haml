              %p
                of super smooth functions from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                is the
                %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super formal smooth set
                whose
                = succeed "-plots" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+set"} super smooth set
                from the
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                of
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U \times X
