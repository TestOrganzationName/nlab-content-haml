                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi d
                          %mi CE
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} (d_{CE})^2 = 0
                %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
                is called the
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %msup
                          %mo ∧
                          %mo •
                        %msup
                          %mi 𝔤
                          %mo *
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %msub
                          %mi d
                          %mi CE
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} ]
                          %mo *
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      CE(\mathfrak{g})
                      \\;\coloneqq\;
                      \\left(
                      \\wedge^\bullet \mathfrak{g}^\ast
                      \\,,
                      d_{CE} = [-,-]^\ast
                      \\right)
                      \\,.
              %p In components:
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi c
                        %mi α
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{c_\alpha\}
                is a
                %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
                is given by the structure constants
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi γ
                        %mi α
                      %msub
                        %mrow
                        %mrow
                          %mi β
                          %mi γ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\gamma^\alpha{}_{\beta \gamma})
                as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi c
                        %mi β
                      %mo ,
                      %msub
                        %mi c
                        %mi γ
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msup
                        %mi γ
                        %mi α
                      %msub
                        %mrow
                        %mrow
                          %mi β
                          %mi γ
                      %msub
                        %mi c
                        %mi γ
                    %annotation{:encoding => "application/x-tex"}
                      [c_\beta, c_\gamma] = \tfrac{1}{2} \gamma^\alpha{}_{\beta \gamma} c_\gamma
              %p
                and if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi c
                        %mi α
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{c^\alpha\}
                denotes the corresponding dual basis, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mo •
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^\ast
                is equivalently the
                %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebra"} differential graded-commutative superalgebra
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#differentialgradedcommutativeSuperalgebra"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi c
                        %mi α
                    %annotation{:encoding => "application/x-tex"} c^\alpha
                in bi-degree
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi σ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (1,\sigma)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ∈
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \sigma \in \mathbb{Z}/2
                is the super-degree of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi α
                    %annotation{:encoding => "application/x-tex"} c_\alpha
                as in def.
                %a.maruku-ref{:href => "#DifferentialFormOnSuperCartesianSpaces"}
                subject to the relation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi c
                        %mi α
                      %mo ∧
                      %msup
                        %mi c
                        %mi β
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi σ
                            %mi α
                          %msub
                            %mi σ
                            %mi β
                      %msup
                        %mi c
                        %mi β
                      %mo ∧
                      %msup
                        %mi c
                        %mi α
                    %annotation{:encoding => "application/x-tex"}
                      c^\alpha \wedge c^\beta = (-1) (-1)^{\sigma_\alpha \sigma_\beta} c^\beta \wedge c^\alpha
              %p and the differential is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi CE
                      %msup
                        %mi c
                        %mi α
                      %mo =
                      %msup
                        %mi γ
                        %mi α
                      %msub
                        %mrow
                        %mrow
                          %mi β
                          %mi γ
                      %msup
                        %mi c
                        %mi β
                      %mo ∧
                      %msup
                        %mi c
                        %mi γ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d_{CE} c^\alpha = \gamma^\alpha{}_{\beta \gamma} c^\beta \wedge c^\gamma
                      \\,.
              %p
                Notice that by degree-reasons
                %em every
                degree +1
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mo •
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^\ast
                is of this form,
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mtext derivations
                            %mtr
                              %mtd
                                %mtext of degree
                                %mspace{:width => "thinmathspace"}
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo ,
                                %mi even
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mtext on
                                %mspace{:width => "thinmathspace"}
                                %msup
                                  %mo ∧
                                  %mo •
                                %msup
                                  %mi 𝔤
                                  %mo *
                        %mo }
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mtext super-skew
                            %mtr
                              %mtd
                                %mtext bilinear maps
                            %mtr
                              %mtd
                                %mi 𝔤
                                %mo ⊗
                                %mi 𝔤
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mo{:stretchy => "false"} [
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo ,
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} ]
                                %mi 𝔤
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \\array{
                      \\text{derivations}
                      \\\
                      \\text{of degree}\, (1,even)
                      \\\
                      \\text{on} \, \wedge^\bullet \mathfrak{g}^\ast
                      }
                      \\right\}
                      \\;\;\simeq\;\,
                      \\left\{
                      \\array{
                      \\text{super-skew}
                      \\\
                      \\text{bilinear maps}
                      \\\
                      \\mathfrak{g} \otimes \mathfrak{g} \overset{[-,-]}{\longrightarrow} \mathfrak{g}
                      }
                      \\right\}
              %p
                The condition that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mi CE
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} (d_{CE})^2 = 0
                is equivalently the (super-)
                %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
                on the bracket
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [-,-]
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
              #eq:JacobiIdentity.maruku-equation
                %span.maruku-eq-number (169)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mi CE
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo =
                      %mn 0
                      %mphantom
                        %mi AAA
                      %mo ⇔
                      %mphantom
                        %mi AAA
                      %msup
                        %mi γ
                        %mi α
                      %msub
                        %mrow
                        %mrow
                          %mi β
                          %mo{:stretchy => "false"} [
                          %mi γ
                      %msup
                        %mi γ
                        %mi β
                      %msub
                        %mrow
                        %mrow
                          %mi β
                          %mo ′
                          %mi γ
                          %mo ′
                          %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      (d_{CE})^2 = 0
                      \\phantom{AAA}
                      \\Leftrightarrow
                      \\phantom{AAA}
                      \\gamma^\alpha{}_{\beta [\gamma} \gamma^{\beta}{}_{\beta' \gamma']}
                      \= 0
              %p (where the square brackets on the right denote super-skew-symmetrization).
              %p
                Hence not only is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
                a
                %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebra"} differential graded-commutative superalgebra
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#differentialgradedcommutativeSuperalgebra"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                on a
                %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                is the same as a differential of degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi even
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1,even)
                on the
                %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∧
                          %mo •
                        %msup
                          %mi 𝔤
                          %mo *
                      %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^\ast
              %p
                We may state this equivalence in a more refined form: A
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝔤
                      %mo ⟶
                      %mi 𝔥
                    %annotation{:encoding => "application/x-tex"} \phi \;\colon\; \mathfrak{g} \longrightarrow \mathfrak{h}
                between
                %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
                is, by degree-reasons, the same as a graded algebra homomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mo *
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mo ∧
                        %mo •
                      %msup
                        %mi 𝔥
                        %mo *
                      %mo ⟶
                      %msup
                        %mo ∧
                        %mo •
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \phi^\ast \;\colon\; \wedge^\bullet \mathfrak{h}^\ast \longrightarrow \wedge^\bullet \mathfrak{g}^\ast
                and it is immediate to check that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                is a
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                of
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
                precisely if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \phi^\ast
                is a homomorpism of differential algebras:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                      %mo ∘
                      %msup
                        %mi ϕ
                        %mo *
                      %mo =
                      %msup
                        %mi ϕ
                        %mo *
                      %mo ∘
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔥
                          %mo{:stretchy => "false"} )
                      %mphantom
                        %mi AAA
                      %mo ⇔
                      %mphantom
                        %mi AAA
                      %msup
                        %mi ϕ
                        %mrow
                          %msub
                            %mi α
                            %mn 1
                      %msub
                        %mrow
                        %mrow
                          %msub
                            %mi β
                            %mn 1
                      %msubsup
                        %mi γ
                        %mi 𝔤
                        %mrow
                          %msub
                            %mi β
                            %mn 1
                      %msub
                        %mrow
                        %mrow
                          %msub
                            %mi β
                            %mn 2
                          %msub
                            %mi β
                            %mn 3
                      %mo =
                      %msubsup
                        %mi γ
                        %mi 𝔥
                        %mrow
                          %msub
                            %mi α
                            %mn 1
                      %msub
                        %mrow
                        %mrow
                          %msub
                            %mi α
                            %mn 2
                          %msub
                            %mi α
                            %mn 3
                      %msup
                        %mi ϕ
                        %mrow
                          %msub
                            %mi α
                            %mn 2
                      %msub
                        %mrow
                        %mrow
                          %msub
                            %mi β
                            %mn 2
                      %msup
                        %mi ϕ
                        %mrow
                          %msub
                            %mi α
                            %mn 3
                      %msub
                        %mrow
                        %mrow
                          %msub
                            %mi β
                            %mn 3
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d_{CE(\mathfrak{g})} \circ \phi^\ast
                      \=
                      \\phi^\ast \circ d_{CE(\mathfrak{h})}
                      \\phantom{AAA}
                      \\Leftrightarrow
                      \\phantom{AAA}
                      \\phi^{\alpha_1}{}_{\beta_1} \gamma^{\beta_1}_{\mathfrak{g}}{}_{\beta_2 \beta_3}
                      \=
                      \\gamma^{\alpha_1}_{\mathfrak{h}}{}_{\alpha_2 \alpha_3} \phi^{\alpha_2}{}_{\beta_2} \phi^{\alpha_3}{}_{\beta_3}
                      \\,.
              %p
                This is a
                %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
                between homomrophism of
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
                and of
                %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebras"} differential graded-commutative superalgebras
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#differentialgradedcommutativeSuperalgebra"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi SuperLieAlg
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo ,
                      %mi 𝔥
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Hom
                        %mi dgcSAlg
                      %mrow
                        %mo (
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔥
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{SuperLieAlg}( \mathfrak{g}, \mathfrak{h}  )
                      \\;\simeq\;
                      Hom_{dgcSAlg}\left( CE(\mathfrak{h}), CE(\mathfrak{g})  \right)
                      \\,.
              %p
                Stated more
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} abstractly
                this means that forming
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
                is a
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi SuperLieAlg
                        %mi fin
                      %mover
                        %mo ↪
                        %mphantom
                          %mi AAA
                      %msup
                        %mi dgcSAlg
                        %mi op
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      CE
                      \\;\colon\;
                      SuperLieAlg^{fin}
                      \\overset{\phantom{AAA}}{\hookrightarrow}
                      dgcSAlg^{op}
                      \\,.
            %p
              Notice that prop.
              %a.maruku-ref{:href => "#LieAlgebraInTermsOfChevalleyEilenbergAlgebra"}
              establishes a
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} dual
              algebraic incarnation of (
