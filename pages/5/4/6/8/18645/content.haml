                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} (e_i)^2 = -1
                %li
                  %p
                    for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi e
                            %mi i
                          %mo →
                          %msub
                            %mi e
                            %mi j
                          %mo →
                          %msub
                            %mi e
                            %mi k
                        %annotation{:encoding => "application/x-tex"} e_i \to e_j \to e_k
                    an edge or circle in the diagram shown (a labeled version of the
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/Fano+plane"} Fano plane
                  %ol
                    %li
                      %p
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi e
                                %mi i
                              %msub
                                %mi e
