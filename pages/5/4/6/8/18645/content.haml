                                %mi j
                                %mi n
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mi n
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi dvol
                                %mrow
                                  %msup
                                    %mi Σ
                                    %mi n
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 1
                              %mo ,
                              %mi ⋯
                              %msub
                                %mi x
                                %mi n
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ≔
                              %mi T
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi S
                                %mn 1
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %msub
                                %mi S
                                %mi r
                              %mo ,
                              %msub
