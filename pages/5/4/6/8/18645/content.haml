                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                    %annotation{:encoding => "application/x-tex"}
