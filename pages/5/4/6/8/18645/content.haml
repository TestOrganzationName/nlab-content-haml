            #CouplingRunning.num_defn
              %h6#definition_8 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/running+coupling+constants"}> running coupling constants
                  )
              %p Let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi vac
                      %mo ≔
                      %msub
                        %mi vac
                        %mi e
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo ′
                      %mo ,
                      %msub
                        %mi Δ
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      vac
                      \\coloneqq
                      vac_e
                      \\;\coloneqq\;
                      (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              %p
                be a
                %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
                (according to def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#VacuumFree"}
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
                be an
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                scheme around this vacuum and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi rg
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} rg_{(-)}
                be a
                %a.existingWikiWord{:href => "/nlab/show/renormalization+group+flow"} renormalization group flow
                according to prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#FlowRenormalizationGroup"}
                %a.existingWikiWord{:href => "/nlab/show/S-matrix+scheme"} S-matrix scheme
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝒮
                        %mi vac
                        %mi ρ
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}_{vac}^\rho
                satisfies the
                %a.existingWikiWord{:href => "/nlab/show/renormalization+condition"} renormalization condition
                “field independence”.
              %p
                Then by the
                %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
                (theorem
                = succeed "," do
                  %a.maruku-ref{:href => "#PerturbativeRenormalizationMainTheorem"}
                = succeed ")" do
                  %a.maruku-ref{:href => "#AnyTwoSMatrixRenormalizationSchemesDifferByAUniqueVertexRedefinition"}
                %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ρ
                        %mn 1
                      %mo ,
                      %msub
                        %mi ρ
                        %mn 2
                      %mo ∈
                      %mi RG
                    %annotation{:encoding => "application/x-tex"} \rho_1, \rho_2 \in RG
                a unique
                %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinition"} interaction vertex redefinition
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝒵
                        %mrow
