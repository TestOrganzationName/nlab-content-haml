                              %mi mod
                              %mspace{:width => "thickmathspace"}
                              %msup
                                %mi ℏ
                                %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \&amp; A_1 \star_H A_2
                      \\\
                      \&amp; =
                      \\phantom{+} A_1 A_2
                      \\\
                      \&amp; \phantom{=}
                      +
                      \\hbar
                      \\int
                      \\left(
                      \\tfrac{i}{2} \Delta^{a_1 a_2}(x_1, x_2) + H^{a_1 a_2}(x_1,x_2)
                      \\right)
                      \\frac{\partial A_1}{\partial \mathbf{\Phi}^{a_1}(x_1)}
                      \\frac{\partial A_2}{\partial \mathbf{\Phi}^{a_2}(x_2)}
                      \\;mod\;
                      \\hbar^2
                      \\\
                      \&amp; =
                      \\phantom{+} A_1 A_2
                      \\\
                      \&amp; \phantom{=}
                      +
                      \\hbar
                      \\left(
                      \\int
