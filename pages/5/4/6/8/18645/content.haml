                          %mi Δ
                        %annotation{:encoding => "application/x-tex"} \Delta
                    which corresponds to the
                    %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+partial+differential+equation"} Green hyperbolic
                    %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
                    %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
                    induced by the
                    %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge-fixed
                    %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mo ′
                          %annotation{:encoding => "application/x-tex"} \mathbf{L}'
              %p Given this, we write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                        %mi PolyObs
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mtext BV-BRST
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi mc
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi ℏ
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thickmathspace"}
                        %mo ,
                        %mspace{:width => "thickmathspace"}
