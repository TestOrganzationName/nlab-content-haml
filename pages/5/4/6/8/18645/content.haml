                                %mi ϕ
                                %mi a
                                %mo ‡
                            %mtd
                              %mo ↦
                            %mtd
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi S
                                %mrow
                                  %mo ∂
                                  %msup
                                    %mi ϕ
                                    %mi a
