                                    %mtd
                                      %mtext component
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathbf{\Phi}^a(x)
                      \&amp;\colon&amp;
                      \\Phi
                      \&amp;\overset{\phantom{AA}}{\mapsto}&amp;
                      \\Phi^a(x)
                      \&amp;=&amp;
                      \\phi^a &amp; \circ \Phi(x)
                      \\\
                      \\array{
