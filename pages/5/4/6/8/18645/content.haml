                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\hat q \Psi(q,p)
                      \&amp; =
                      \- i \nabla_{\partial_p}\Psi(q,p) + q \Psi(q,p)
                      \\\
                      \&amp; = -i
                      \\underset{ = 0 }{
