                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          sd(u \otimes v) \leq sd(u) + sd(v)
                  %p
                    for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                          %mo ∈
                          %mi 𝒟
                          %mo ′
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} v \in \mathcal{D}'(Y)
                    another distribution on
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Y
