                be a
                %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
                according to def.
                = succeed "." do
                  %a.maruku-ref{:href => "#VacuumFree"}
              %p
                Then the following conditions are
                %a.existingWikiWord{:href => "/nlab/show/renormalization+conditions"} renormalization conditions
                (def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#RenormalizationConditions"}
              %ol
                %li
                  %p
                    (field independence) The
                    %a.existingWikiWord{:href => "/nlab/show/functional+derivative"} functional derivative
                    of a
                    %a.existingWikiWord{:href => "/nlab/show/polynomial+observable"} polynomial observable
                    arising as a
                    %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
                    takes contributions only from the arguments, not from the product operation itself; in
                    = succeed "-notation:" do
                      %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
                  #eq:FieldIndependenceRenormalizationCondition.maruku-equation
                    %span.maruku-eq-number (242)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
