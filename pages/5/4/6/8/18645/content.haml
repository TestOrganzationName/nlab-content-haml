                          %mi ν
                      %msub
                        %mi Q
                        %mrow
                          %mi a
                          %mi b
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      P^{\mu \nu}_{a b} = \eta^{\mu \nu} Q_{a b}
                      \\,.
            #FormallyAdjointDifferentialOperators.num_defn
