                        %mi AAAA
                      %mover
                        %mi p
                        %mo{:stretchy => "false"} ^
                      %mi ψ
                      %mo =
                      %mi i
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %mi q
                      %mi ψ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\hat q \psi = q \psi
                      \\phantom{AAAA}
                      \\hat p \psi = i \frac{\partial}{\partial q} \psi
                      \\,.
              %p
                This is called the
                %a.existingWikiWord{:href => "/nlab/show/Schr%C3%B6dinger+representation"} Schrödinger representation
                of the
                %a.existingWikiWord{:href => "/nlab/show/canonical+commutation+relation"} canonical commutation relation
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:R2PoissonBracket"} (215)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
