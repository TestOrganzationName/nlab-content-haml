                %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mo •
                      %msup
