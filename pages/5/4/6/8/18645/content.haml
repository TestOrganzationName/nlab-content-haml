                      +
                      \\cdots
              %p
                In fact this leaves the
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+function"} Lagrangian function
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
                = succeed ":" do
                  %a.maruku-ref{:href => "#InfinitesimalGaugeSymmetryElectromagnetism"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
