                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{-S',(-)\}
                acting by the
                %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operator"} formally adjoint differential operator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi P
                        %mo *
