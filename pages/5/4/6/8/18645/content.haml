                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msup
                                    %mi Ω
                                    %mo •
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi ℝ
                                    %mrow
                                      %msub
                                        %mi n
                                        %mn 1
                                  %mo{:stretchy => "false"} )
                                %mtd
                                %mtd
                                  %mover
                                    %mo ⟵
                                    %mrow
                                      %msup
                                        %mi f
                                        %mo *
                                %mtd
                                %mtd
                                  %msup
                                    %mi Ω
                                    %mo •
