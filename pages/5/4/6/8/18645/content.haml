                from
                %a.maruku-eqref{:href => "#eq:StandardThetaForTrivialVectorFieldBundleOnMinkowskiSpacetime"} (54)
                as follows:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
