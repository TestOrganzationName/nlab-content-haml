                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} i \lt j \in \{1, \cdots, \nu\}
                    a natural number
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
