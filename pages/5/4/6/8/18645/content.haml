                = succeed "." do
                  %em derived presymplectic potental current
              %p We then have that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi δ
                      %mo +
