                              %mspace{:width => "thickmathspace"}
                              %msup
                                %mi ℝ
                                %mi n
                              %mo →
                              %msup
                                %mi ℝ
                                %mi n
                            %annotation{:encoding => "application/x-tex"} id_{\mathbb{R}^n} \;\colon\; \mathbb{R}^n \to \mathbb{R}^n
                        is the
                        %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
                        on
                        = succeed "," do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mi n
                              %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msup
                                %mrow
                                  %mo (
                                  %msub
                                    %mi id
                                    %mrow
                                      %msup
                                        %mi ℝ
                                        %mi n
                                  %mo )
                                %mo *
                              %mspace{:width => "thickmathspace"}
                              %mo{:lspace => "verythinmathspace"} :
                              %mspace{:width => "thickmathspace"}
                              %mi X
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi ℝ
                                %mi n
                              %mo{:stretchy => "false"} )
                              %mo →
                              %mi X
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi ℝ
                                %mi n
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} \left(id_{\mathbb{R}^n}\right)^\ast \;\colon\; X(\mathbb{R}^n) \to X(\mathbb{R}^n)
                        is the
                        %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
                        on the set of plots
                        = succeed "." do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mi X
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ℝ
                                  %mi n
                                %mo{:stretchy => "false"} )
                              %annotation{:encoding => "application/x-tex"} X(\mathbb{R}^n)
                    %li
                      %p
                        If
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msup
                                %mi ℝ
                                %mrow
                                  %msub
                                    %mi n
                                    %mn 1
                              %mover
                                %mo →
                                %mi f
                              %msup
                                %mi ℝ
                                %mrow
                                  %msub
                                    %mi n
                                    %mn 2
                              %mover
                                %mo →
                                %mi g
                              %msup
                                %mi ℝ
                                %mrow
                                  %msub
                                    %mi n
                                    %mn 3
                            %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1} \overset{f}{\to} \mathbb{R}^{n_2} \overset{g}{\to} \mathbb{R}^{n_3}
                        are two
                        %a.existingWikiWord{:href => "/nlab/show/composition"} composable
                        %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                        between
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                        = succeed ":" do
                          %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                      .maruku-equation
                        %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msup
                                %mi f
                                %mo *
                              %mo ∘
                              %msup
                                %mi g
                                %mo *
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo ∘
                              %mi f
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                            %annotation{:encoding => "application/x-tex"}
                              f^\ast \circ g^\ast
                              \=
                              (g \circ f)^\ast
                      %p i.e.
                      .maruku-equation
                        %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                    %mtd
                                    %mtd
                                      %mi X
                                      %mo{:stretchy => "false"} (
                                      %msup
                                        %mi ℝ
                                        %mrow
                                          %msub
                                            %mi n
                                            %mn 2
                                      %mo{:stretchy => "false"} )
                                  %mtr
                                    %mtd
                                    %mtd
                                      %msup
                                        %mrow
                                        %mpadded{:lspace => "-100%width", :width => "0"}
                                          %mrow
                                            %msup
                                              %mi f
                                              %mo *
                                      %mo ↙
                                    %mtd
                                    %mtd
                                      %msup
                                        %mo ↖
                                        %mpadded{:width => "0"}
                                          %mrow
                                            %msup
                                              %mi g
                                              %mo *
                                  %mtr
                                    %mtd
                                      %mi X
                                      %mo{:stretchy => "false"} (
