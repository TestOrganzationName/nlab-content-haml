                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mi dim
                                  %mo{:stretchy => "false"} (
                                  %mi Σ
                                  %mo{:stretchy => "false"} )
                              %mrow
                                %mo (
                                %msub
                                  %mo ∫
                                  %mi Σ
                                %mi d
                                %mi ω
                                %mo −
                                %msub
                                  %mo ∫
                                  %mrow
                                    %mo ∂
                                    %mi Σ
                                %mi ω
                                %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      d \int_\Sigma \omega
                      \&amp; =
                      (-1)^{dim(\Sigma)} \int_\Sigma d_U \omega
                      \\\
                      \&amp; =
                      (-1)^{dim(\Sigma)}
                      \\left(
                      \\int_\Sigma d \omega
                      \-
                      \\int_{\partial \Sigma} \omega
                      \\right)
