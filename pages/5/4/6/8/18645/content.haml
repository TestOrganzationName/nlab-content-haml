                            %mi aux
                          %mo ,
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mi aux
                          %mo{:stretchy => "false"} }
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"}
                          \\{\mathbf{L}_{aux}, \mathbf{L}_{aux}\} = 0
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
                    of this differential is trivial:
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi H
                            %mo •
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi s
                            %mi aux
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mn 0
                        %annotation{:encoding => "application/x-tex"}
                          H^\bullet( s_{aux} )\;=\;0
                %li
                  %p
                    The
                    %a.existingWikiWord{:href => "/nlab/show/local+antibracket"} local antibracket
                    of the
                    %a.existingWikiWord{:href => "/nlab/show/BV-Lagrangian+density"} BV-Lagrangian density
