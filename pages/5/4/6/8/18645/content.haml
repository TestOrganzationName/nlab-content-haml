                      \&amp;
                      0
                      \&amp;
                      0
                      }
              %p
                then these two differentials constitute a
                %a.existingWikiWord{:href => "/nlab/show/bicomplex"} bicomplex
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
