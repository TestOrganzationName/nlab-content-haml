              %p
                Then the
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
                on
                %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#OnRegularPolynomialObservablesTimeOrderedProduct"}
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ⋆
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \star_H
                in that for all
                %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                of
                %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                      %mo ,
                      %msub
                        %mi A
                        %mn 2
                      %mo ∈
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi reg
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      A_1, A_2 \in PolyObs(E)_{reg}[ [\hbar] ]
              %p
                with
                %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                %a.existingWikiWord{:href => "/nlab/show/support"} support
                we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                      %msub
                        %mo ⋆
                        %mi F
                      %msub
                        %mi A
                        %mn 2
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mrow
