                        %mi ω
                        %mn 2
                      %mo −
                      %msub
                        %mi ω
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi ω
                        %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\iota_{v} (\omega_1 \wedge \omega_2)
                      \\;=\;
                      \\omega_1(v) \omega_2 - \omega_2(v) \omega_1
                      \\;\in\;
                      \\Omega^1(\mathbb{R}^n)
                      \\,.
            #PullbackOfDifferentialForms.num_prop
              %h6#proposition_2 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"}> pullback of differential n-forms
                  )
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo →
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^{n_1} \to \mathbb{R}^{n_2}
                a
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                between
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential 1-forms
                of def.
                %a.maruku-ref{:href => "#Differential1FormsOnCartesianSpaces"}
                extends as an
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^k)
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                to the
                %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
                of
                %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#DifferentialnForms"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      f^\ast
                      \\;\colon\;
                      \\Omega^\bullet(\mathbb{R}^{n_2})
                      \\longrightarrow
                      \\Omega^\bullet(\mathbb{R}^{n_1})
              %p given on basis elements by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mrow
                        %mo (
                        %msup
                          %mi dx
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                        %mo ∧
                        %mi ⋯
                        %mo ∧
                        %msup
                          %mi dx
                          %mrow
                            %msub
                              %mi i
                              %mi n
                        %mo )
                      %mo =
                      %mrow
                        %mo (
                        %msup
                          %mi f
                          %mo *
                        %msup
                          %mi dx
                          %mrow
                            %msub
