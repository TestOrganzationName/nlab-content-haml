                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\alpha_1, \alpha_2 \;\in\; \Omega^{\bullet,\bullet}_\Sigma(E)
              %p
                be two
                %a.existingWikiWord{:href => "/nlab/show/variational+differential+forms"} variational differential forms
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                (hence one less than the
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                of
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
              %p
                Then the
                = succeed "-property" do
