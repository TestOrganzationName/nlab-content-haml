                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#BundlesAndSections
              %strong
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundles"} fiber bundles
            %p
              Given any context of
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              and
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              between them, such as the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              and
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              from def.
              %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
              it is of interest to fix one
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and consider other objects
              %em
                %a.existingWikiWord{:href => "/nlab/show/dependent+type"} parameterized over
              it. These are called
              %em
                %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BundlesAndFibers"}
              %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
              in the context of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            %p
              Of course the theory of bundles is mostly trivial over Cartesian spaces; it gains its main interest from its generalization to more general
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              (def./prop.
              %a.maruku-ref{:href => "#SmoothManifoldInsideDiffeologicalSpaces"}
              below). It is still worthwhile for our development to first consider the relevant concepts in this simple case first.
            %p
              For more exposition see at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/fiber+bundles+in+physics"} fiber bundles in physics
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            #BundlesAndFibers.num_defn
              %h6#definition_4 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/bundles"}> bundles
                  )
              %p
                We say that a
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} X
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
                just to amplify that we think of it as exhibiting
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                as being a “space over
                = succeed "\u201D:" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi E
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi fb
                          %mtr
                            %mtd
                              %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      E
                      \\\
                      \\downarrow\mathrlap{fb}
                      \\\
                      X
                      }
                      \\,.
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
                a point, we say that the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                of this
                %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                is the
                %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
              #eq:FiberOfAFiberBundle.maruku-equation
                %span.maruku-eq-number (2)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi x
                      %mo ≔
                      %msup
                        %mi fb
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi E
                    %annotation{:encoding => "application/x-tex"}
                      E_x \coloneqq fb^{-1}(\{x\}) \subset E
              %p
                of the point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                under the smooth function. We think of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi fb
                    %annotation{:encoding => "application/x-tex"} fb
                as exhibiting a “smoothly varying” set of
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                spaces over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              %p
                Given two
                %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 1
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi fb
                            %mn 1
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E_1 \overset{fb_1}{\to} X
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 2
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi fb
                            %mn 2
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E_2 \overset{fb_2}{\to} X
                over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                  of bundles
                between them is a
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi E
                        %mn 1
                      %mo →
                      %msub
                        %mi E
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f \colon E_1 \to E_2
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi fb
                        %mn 2
                      %mo ∘
                      %mi f
                      %mo =
                      %msub
                        %mi fb
                        %mn 1
                      %mphantom
                        %mi AAAA
                      %mtext i.e.
                      %mphantom
                        %mi AAA
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi E
                                %mn 1
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mi f
                            %mtd
                            %mtd
                              %msub
                                %mi E
                                %mn 2
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi fb
                                      %mn 1
                              %mo ↘
                            %mtd
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi fb
                                      %mn 2
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      fb_2  \circ f = fb_1
                      \\phantom{AAAA}
                      \\text{i.e.}
                      \\phantom{AAA}
                      \\array{
                      E_1 &amp;&amp; \overset{f}{\longrightarrow} &amp;&amp; E_2
                      \\\
                      \&amp; {}_{\mathllap{fb_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{fb_2}}
                      \\\
                      \&amp;&amp; X
                      }
                      \\,.
              %p
                Hence a bundle homomorphism is a smooth function that sends
                %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
                to
                %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
                over the same point:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi x
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo ⊂
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi x
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      f\left(
                      (E_1)_x
                      \\right)
                      \\;\subset\;
                      (E_2)_x
                      \\,.
              %p
                The inclined reader may notice that this defines a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                of
                %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
                over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %em
                  %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi CartSp
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi X
                      %annotation{:encoding => "application/x-tex"} CartSp_{/X}
            #Sections.num_defn
              %h6#definition_5 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/sections"}> sections
                  )
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} X
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#BundlesAndFibers"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/section"} section
                is a
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi E
                    %annotation{:encoding => "application/x-tex"} s \colon X \to E
                such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi fb
                      %mo ∘
                      %mi s
                      %mo =
                      %msub
                        %mi id
                        %mi X
                      %mphantom
                        %mi AAAAA
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi E
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi s
                              %mo ↗
                            %mtd
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi fb
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                              %mo =
                            %mtd
                              %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      fb \circ s = id_X
                      \\phantom{AAAAA}
                      \\array{
                      \&amp;&amp; E
                      \\\
                      \&amp;
                      {}^{\mathllap{s}}\nearrow
                      \&amp; \downarrow\mathrlap{fb}
                      \\\
                      X &amp;=&amp; X
                      }
                      \\,.
              %p
                This means that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
                sends every point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
                to an element in the
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                over that point
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi E
                        %mi x
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      s(x) \in E_x
                      \\,.
              %p We write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi E
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mi s
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi fb
                            %mtr
                              %mtd
                                %mi X
                              %mtd
                                %mo =
                              %mtd
                                %mi X
                        %mphantom
                          %mi fb
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma_X(E) \coloneqq
                      \\left\{
                      \\array{
                      \&amp;&amp; E
                      \\\
                      \&amp; {}^{\mathllap{s}}\nearrow &amp; \downarrow^\mathrlap{fb}
                      \\\
                      X &amp;=&amp; X
                      }
                      \\phantom{fb}
                      \\right\}
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} set of sections
                of a bundle.
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 1
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mn 1
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E_1 \overset{f_1}{\to} X
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 2
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mn 2
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E_2 \overset{f_2}{\to} X
                two
                %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
                and for
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi E
                                %mn 1
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mi f
                            %mtd
                            %mtd
                              %msub
                                %mi E
                                %mn 2
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi fb
                                      %mn 1
                              %mo ↘
                            %mtd
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi fb
                                      %mn 2
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi X
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      E_1
                      \&amp;&amp; \overset{f}{\longrightarrow} &amp;&amp;
                      E_2
                      \\\
                      \&amp; {}_{\mathllap{fb_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{fb_2}}
                      \\\
                      \&amp;&amp; X
                      }
              %p
                a bundle
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                between them (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#BundlesAndFibers"}
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                sends
                %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                to
                %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                and hence yields a
                %a.existingWikiWord{:href => "/nlab/show/function"} function
                denoted
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Γ
                                %mi X
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi E
                                %mn 1
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi f
                                    %mo *
                            %mtd
                              %msub
                                %mi Γ
                                %mi X
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi E
                                %mn 2
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi s
                            %mtd
                              %mo ↦
                            %mtd
                              %mi f
                              %mo ∘
                              %mi s
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\Gamma_X(E_1)
                      \&amp;\overset{f_\ast}{\longrightarrow}&amp;
                      \\Gamma_X(E_2)
                      \\\
                      s &amp;\mapsto&amp; f \circ s
                      }
                      \\,.
            #TrivialBundleOnCartesianSpace.num_example
              %h6#example_3 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"}> trivial bundle
                  )
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi F
                    %annotation{:encoding => "application/x-tex"} X \times F
                equipped with the
                %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                              %mo ×
                              %mi F
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi pr
                                      %mn 1
                          %mtr
                            %mtd
                              %mi X
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X \times F
                      \\\
                      \\downarrow^\mathrlap{pr_1}
                      \\\
                      X
                      }
              %p
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a
                %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#BundlesAndFibers"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivial bundle
                with
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                %em constant
                smoothly varying set of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} F = \ast
                is the point, then this is the identity bundle
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                          %mtr
                            %mtd
                              %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X
                      \\\
                      \\downarrow\mathrlap{id}
                      \\\
                      X
                      }
                      \\,.
              %p
                Given any
                %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mover
                          %mo →
                          %mi fb
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} X
                = succeed ")" do
                  %a.maruku-ref{:href => "#BundlesAndFibers"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} X
                is equivalently a
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} X
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Sections"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mi s
                            %mtd
                            %mtd
                              %mi E
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi id
                              %mo ↘
                            %mtd
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:width => "0"}
                                  %mi fb
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi X
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X &amp;&amp; \overset{s}{\longrightarrow} &amp;&amp; E
                      \\\
                      \&amp; {}_{\mathllap{id}}\searrow &amp;&amp; \swarrow_{\mathrlap{fb}}
                      \\\
                      \&amp;&amp; X
                      }
            #FiberBundle.num_defn
              %h6#definition_6 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"}> fiber bundle
                  )
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} X
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#BundlesAndFibers"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
                with
                %em typical fiber
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                if there exists a
                %a.existingWikiWord{:href => "/nlab/show/differentiably+good+open+cover"} differentiably good open cover
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo ↪
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} \{U_i \hookrightarrow X\}_{i \in I}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DifferentiablyGoodOpenCover"}
