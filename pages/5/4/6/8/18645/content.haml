                          %msub
                            %mi k
                            %mn 2
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mi ⋯
                      %mi T
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mrow
