            #CauchyPrincipalValueAsDistributionOnRealLine.num_defn
              %h6#definition_13 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
                  as
                  %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                  on the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℝ
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R} \to \mathbb{R}
                be a
                %a.existingWikiWord{:href => "/nlab/show/function"} function
                on the
                %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
                such that for all
                %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R})
                the Cauchy principal value of the pointwise product function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mi b
                    %annotation{:encoding => "application/x-tex"} f b
                exists, in the sense of def.
                = succeed "." do
                  %a.maruku-ref{:href => "#CauchyIntegralValueOfIntegralOverRealline"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PV
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi b
                      %mo ↦
                      %mi PV
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      PV(f)
                      \\;\colon\;
                      b \mapsto PV(f b)
              %p
                defines a
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi PV
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi 𝒟
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi ℝ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} PV(f) \in \mathcal{D}'(\mathbb{R})
            .num_example
              %h6#example_13 Example
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℝ
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R} \to \mathbb{R}
                be an
                %a.existingWikiWord{:href => "/nlab/show/integrable+function"} integrable function
                which is symmetric, in that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(-x) = f(x)
                for all
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}
                = succeed ")" do
                  %a.maruku-ref{:href => "#CauchyIntegralValueOfIntegralOverRealline"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ↦
                      %mfrac
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mi x
                    %annotation{:encoding => "application/x-tex"} x \mapsto \frac{f(x)}{x}
                exists and is zero:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mi lim
                        %mrow
                          %mi ϵ
                          %mo →
                          %mn 0
                      %munder
                        %mo ∫
                        %mrow
                          %mi ℝ
                          %mo ∖
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi ϵ
                          %mo ,
                          %mi ϵ
                          %mo{:stretchy => "false"} )
                      %mfrac
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mi x
                      %mi d
                      %mi x
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\underset{\epsilon \to 0}{\lim}
                      \\underset{\mathbb{R}\setminus (-\epsilon, \epsilon)}{\int}
                      \\frac{f(x)}{x} d x
                      \\; = \; 0
              %p
                This is because, by the symmetry of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                and the skew-symmetry of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ↦
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x \mapsto 1/x
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mo ∫
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn ∞
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi ϵ
                      %mfrac
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mi x
                      %mi d
                      %mi x
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mo −
                      %msubsup
                        %mo ∫
                        %mi ϵ
                        %mn ∞
                      %mfrac
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mi x
                      %mi d
                      %mi x
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\int_{-\infty}^{-\epsilon} \frac{f(x)}{x} d x
                      \\;=\;
                      \-
                      \\int_{\epsilon}^\infty \frac{f(x)}{x} d x
                      \\,.
            #PrincipalValueOfInverseFunctionCharacteristicEquation.num_example
              %h6#example_14 Example
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PV
                      %mrow
                        %mo (
                        %mfrac
                          %mn 1
                          %mi x
                        %mo )
                    %annotation{:encoding => "application/x-tex"} PV\left( \frac{1}{x}\right)
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CauchyPrincipalValueAsDistributionOnRealLine"}
                %a.existingWikiWord{:href => "/nlab/show/equation"} equation
              #eq:DistributionalEquationxfOfxEqualsOne.maruku-equation
                %span.maruku-eq-number (132)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mi PV
                      %mrow
                        %mo (
                        %mfrac
                          %mn 1
                          %mi x
                        %mo )
                      %mo =
                      %mn 1
                      %mphantom
                        %mi AAA
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      x PV\left(\frac{1}{x}\right) = 1
                      \\phantom{AAA}
                      \\in \mathcal{D}'(\mathbb{R}^1)
                      \\,.
              %p
                Since the
                %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \delta \in \mathcal{D}'(\mathbb{R}^1)
                solves the equation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mi δ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mphantom
                        %mi AAA
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝕣
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      x \delta(x) = 0
                      \\phantom{AAA}
                      \\in \mathcal{D}'(\mathbb{r}^1)
              %p
                we have that more generally every
                %a.existingWikiWord{:href => "/nlab/show/linear+combination"} linear combination
                of the form
              #eq:GeneralDistributionalSolutionToxfEqualsOne.maruku-equation
                %span.maruku-eq-number (133)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi PV
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi c
                      %mi δ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mphantom
                        %mi AAA
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      F(x)
                      \\coloneqq
                      PV(1/x) + c \delta(x)
                      \\phantom{AAA}
                      \\in \mathcal{D}'(\mathbb{R}^1)
              %p
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} c \in \mathbb{C}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} x F(x) =  1
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                of all these solutions is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi WF
                      %mrow
                        %mo (
                        %mi PV
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi c
                        %mi δ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo {
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mi k
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mo *
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      WF\left(
                      PV(1/x) + c \delta(x)
                      \\right)
                      \\;=\;
                      \\left\{
                      (0,k) \;\vert\; k \in \mathbb{R}^\ast \setminus \{0\}
                      \\right\}
                      \\,.
            .proof
              %h6#proof_6 Proof
              %p
                The first statement is immediate from the definition: For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %msubsup
                        %mi C
                        %mi c
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in C^\infty_c(\mathbb{R}^1)
                any
                %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
                we have that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mrow
                                %mo ⟨
                                %mi x
                                %mi PV
                                %mrow
                                  %mo (
                                  %mfrac
                                    %mn 1
                                    %mi x
                                  %mo )
                                %mo ,
                                %mi b
                                %mo ⟩
                            %mtd
                              %mo ≔
                              %munder
                                %mi lim
                                %mrow
                                  %mi ϵ
                                  %mo →
                                  %mn 0
                              %munder
                                %mo ∫
                                %mrow
                                  %msup
                                    %mi ℝ
                                    %mn 1
                                  %mo ∖
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi ϵ
                                  %mo ,
                                  %mi ϵ
                                  %mo{:stretchy => "false"} )
                              %mfrac
                                %mi x
                                %mi x
                              %mi b
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mi d
                              %mi x
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo ∫
                              %mi b
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mi d
                              %mi x
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:stretchy => "false"} ⟨
                              %mn 1
                              %mo ,
                              %mi b
                              %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\left\langle x PV\left(\frac{1}{x}\right), b \right\rangle
                      \&amp; \coloneqq
                      \\underset{\epsilon \to 0}{\lim}
                      \\underset{\mathbb{R}^1 \setminus (-\epsilon, \epsilon)}{\int}
                      \\frac{x}{x}b(x) \, d x
                      \\\
                      \&amp; =
                      \\int b(x)  d x
                      \\\
                      \&amp; =
                      \\langle 1,b\rangle
                      \\end{aligned}
              %p
                Regarding the second statement: It is clear that the wave front set is concentrated at the origin. By symmetry of the distribution around the origin, it must contain both
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} directions
            .num_prop
              %h6#proposition_15 Proposition
              %p
                In fact
                %a.maruku-eqref{:href => "#eq:GeneralDistributionalSolutionToxfEqualsOne"} (133)
                is the most general distributional solution to
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:DistributionalEquationxfOfxEqualsOne"} (132)
            %p
              This follows by the characterization of
              %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
              to a point, see there at
              %a{:href => "extension+of+distributions#SpaceOfPointExtensions"} this prop.
              (
              %a{:href => "Cauchy+principa+value#HoermanderLPDO1"}> Hörmander 90, thm. 3.2.4
              )
            #IntegrationAgainstInverseOfxWithImaginaryOffset.num_defn
              %h6#definition_14 Definition
              %p
                %strong (integration against inverse variable with imaginary offset)
              %p Write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mrow
                            %mi x
                            %mo +
                            %mi i
                            %msup
                              %mn 0
                              %mo ±
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\tfrac{1}{x + i0^\pm}
                      \\;\in\;
                      \\mathcal{D}'(\mathbb{R})
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                which is the
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}'(\mathbb{R})
                of the
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
                which are given by the
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ↦
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mrow
                            %mi x
                            %mo ±
                            %mi i
                            %mi ϵ
                    %annotation{:encoding => "application/x-tex"} x \mapsto \tfrac{1}{x \pm i \epsilon}
                as the
                %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive real number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
                tends to zero:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mn 1
                        %mrow
                          %mi x
                          %mo +
                          %mi i
                          %msup
                            %mn 0
                            %mo ±
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mi lim
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mi ϵ
                              %mo ∈
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo ,
                              %mn ∞
                              %mo{:stretchy => "false"} )
                          %mrow
                            %mrow
                              %mi ϵ
                              %mo →
                              %mn 0
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mrow
                            %mi x
                            %mo ±
                            %mi i
                            %mi ϵ
                    %annotation{:encoding => "application/x-tex"}
                      \\frac{1}{
                      x + i 0^\pm
                      }
                      \\;\coloneqq\;
                      \\underset{ { \epsilon \in (0,\infty) } \atop { \epsilon \to 0 }  }{\lim}
                      \\tfrac{1}{x \pm i \epsilon}
              %p
                hence the distribution which sends
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in C^\infty(\mathbb{R}^1)
                to
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ↦
                      %munder
                        %mo ∫
                        %mi ℝ
                      %mfrac
                        %mrow
                          %mi b
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mi x
                          %mo ±
                          %mi i
                          %mi ϵ
                      %mspace{:width => "thinmathspace"}
                      %mi d
                      %mi x
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      b \mapsto
                      \\underset{\mathbb{R}}{\int}
                      \\frac{b(x)}{x \pm i \epsilon} \, d x
                      \\,.
            #CauchyPrincipalValueEqualsIntegrationWithImaginaryOffsetPlusDelta.num_prop
              %h6#proposition_16 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
                  equals integration with
                  %a.existingWikiWord{:href => "/nlab/show/imaginary+number"} imaginary
                  offset plus
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PV
                      %mrow
                        %mo (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mi x
                        %mo )
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PV\left( \tfrac{1}{x}\right) \in \mathcal{D}'(\mathbb{R})
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CauchyPrincipalValueAsDistributionOnRealLine"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi x
                    %annotation{:encoding => "application/x-tex"} 1/x
                with imaginary offset (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#IntegrationAgainstInverseOfxWithImaginaryOffset"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PV
                      %mrow
                        %mo (
                        %mfrac
                          %mn 1
                          %mi x
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mi x
                          %mo +
                          %mi i
                          %msup
                            %mn 0
                            %mo ±
                      %mo ±
                      %mi i
                      %mi π
                      %mi δ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      PV\left(\frac{1}{x}\right)
                      \\;=\;
                      \\frac{1}{x + i 0^\pm}
                      \\pm i \pi \delta
                      \\,.
              %p
                In particular, by prop.
                %a.maruku-ref{:href => "#PrincipalValueOfInverseFunctionCharacteristicEquation"}
                this means that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mrow
                            %mi x
                            %mo +
                            %mi i
                            %msup
                              %mn 0
                              %mo ±
                    %annotation{:encoding => "application/x-tex"} \tfrac{1}{x + i 0^\pm}
                solves the distributional equation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mfrac
                        %mn 1
                        %mrow
                          %mi x
                          %mo +
                          %mi i
                          %msup
                            %mn 0
                            %mo ±
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mn 1
                      %mphantom
                        %mi AA
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      x \frac{1}{x + i 0^\pm}
                      \\;=\;
                      1
                      \\phantom{AA}
                      \\in \mathcal{D}'(\mathbb{R}^1)
                      \\,.
            .proof
