                          %mrow
                            %mstyle{:mathvariant => "bold"}
                              %mi P
                          %annotation{:encoding => "application/x-tex"} \mathbf{P}
                  %ol
                    %li
                      %p
                        The first summand in the third line is the contribution where
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi J
                              %mo ′
                            %annotation{:encoding => "application/x-tex"} \mathbf{J}'
                        has a non-empty intersection with
                        = succeed "." do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi Q
                              %annotation{:encoding => "application/x-tex"} \mathbf{Q}
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi K
                            %annotation{:encoding => "application/x-tex"} \mathbf{K}
                        range without constraint, and therefore the sum in the middle vanishes, as indicated, as it is the contribution at order
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mrow
                                %mo{:stretchy => "false"} |
                                %mstyle{:mathvariant => "bold"}
                                  %mi Q
                                %mo{:stretchy => "false"} |
                            %annotation{:encoding => "application/x-tex"} {\vert \mathbf{Q}\vert}
                        of the inversion formula from prop.
                        = succeed "." do
                          %a.maruku-ref{:href => "#InversionFormulaForTimeOrderedProducts"}
                    %li
                      %p
                        The second summand in the third line is the contribution where
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi J
                              %mo ′
                            %annotation{:encoding => "application/x-tex"} \mathbf{J}'
                        does not intersect
                        = succeed "." do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi Q
                              %annotation{:encoding => "application/x-tex"} \mathbf{Q}
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi K
                            %annotation{:encoding => "application/x-tex"} \mathbf{K}
                        is the inversion formula from prop.
                        %a.maruku-ref{:href => "#InversionFormulaForTimeOrderedProducts"}
                        except for one term, and so it equals that term.
            %p
              Using these facts about the reverse-time ordered products, we may finally prove that
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              indeed do induced a perturbative S-matrix:
            #TimeOrderedProductInducesPerturbativeSMatrix.num_prop
              %h6#proposition_9 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
                  induce
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi T
                        %mi k
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \{T_k\}_{k \in \mathbb{N}}
                be a system of
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
                according to def.
                = succeed "." do
                  %a.maruku-ref{:href => "#TimeOrderedProduct"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi 𝒮
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≔
                              %mi T
                              %mrow
                                %mo (
                                %msub
                                  %mi exp
                                  %mo ⊗
                                %mrow
                                  %mo (
                                  %mstyle{:displaystyle => "false"}
                                    %mfrac
                                      %mn 1
                                      %mrow
                                        %mi i
                                        %mi ℏ
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                  %mo )
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo ≔
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi k
                                  %mo ∈
                                  %mi ℕ
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mrow
                                    %mi k
                                    %mo !
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi i
                                    %mi ℏ
                                    %msup
                                      %mo{:stretchy => "false"} )
                                      %mi k
                              %mi T
                              %mo{:stretchy => "false"} (
                              %munder
                                %munder
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo ,
                                    %mi ⋯
                                    %mo ,
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo ⏟
                                %mrow
                                  %mi k
                                  %mspace{:width => "thinmathspace"}
                                  %mtext factors
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\mathcal{S}(-)
                      \&amp; \coloneqq
                      T
                      \\left(
                      \\exp_\otimes
                      \\left(
                      \\tfrac{1}{i \hbar}(-)
                      \\right)
                      \\right)
                      \\\
                      \&amp;
                      \\coloneqq
                      \\underset{k \in \mathbb{N}}{\sum}
                      \\tfrac{1}{k!}
                      \\tfrac{1}{(i \hbar)^k}  T( \underset{k \, \text{factors}}{\underbrace{-,  \cdots , -}} )
                      \\end{aligned}
              %p
                is indeed a perturbative S-matrix according to def.
                = succeed "." do
                  %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
            .proof
              %h6#proof_11 Proof
              %p
                The axiom “perturbation” of the S-matrix is immediate from the axioms “perturbation” and “normalization” of the time-ordered products. What requires proof is that
                %a.existingWikiWord{:href => "/nlab/show/causal+additivity"} causal additivity
                of the S-matrix follows from the
                %a.existingWikiWord{:href => "/nlab/show/causal+factorization"} causal factorization
                property of the time-ordered products.
              %p
                Notice that also the weaker
                %a.existingWikiWord{:href => "/nlab/show/causal+factorization"} causal factorization
                property of the S-matrix (remark
                = succeed ")" do
                  %a.maruku-ref{:href => "#DysonCausalFactorization"}
              %p
                But
                %a.existingWikiWord{:href => "/nlab/show/causal+additivity"} causal additivity
                is stronger. It is remarkable that this, too, follows from just the time-ordering (
                %a{:href => "S-matrix#EpsteinGlaser73"}> Epstein-Glaser 73, around (73)
                ):
              %p
                To see this, first expand the generating function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒵
                    %annotation{:encoding => "application/x-tex"} \mathcal{Z}
                %a.maruku-eqref{:href => "#eq:GeneratingFunctionInducedFromSMatrix"} (232)
                into powers of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒵
                        %mrow
                          %mi g
                          %msub
                            %mi S
                            %mi int
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi n
                          %mo ,
                          %mi m
                          %mo =
                          %mn 0
                        %mn ∞
                      %mfrac
                        %mn 1
                        %mrow
                          %mi n
                          %mo !
                          %mi m
                          %mo !
                      %mi R
                      %mrow
                        %mo (
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                        %munder
                          %munder
                            %mrow
                              %mi g
                              %msub
                                %mi S
                                %mi int
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %mi g
                              %msub
                                %mi S
                                %mi int
                            %mo ⏟
                          %mrow
                            %mi n
                            %mspace{:width => "thinmathspace"}
                            %mtext factors
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %munder
                          %munder
                            %mrow
                              %mi j
                              %mi A
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %mi j
                              %mi A
                            %mo ⏟
                          %mrow
                            %mi m
                            %mspace{:width => "thinmathspace"}
                            %mtext factors
                        %mo{:stretchy => "false"} )
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{Z}_{g S_{int}}(j A)
                      \\;=\;
                      \\underoverset{n,m = 0}{\infty}{\sum}
                      \\frac{1}{n! m!}
                      R\left(
                      {\, \atop \,}
                      \\underset{n\, \text{factors}}{\underbrace{g S_{int},  \cdots ,g S_{int}}},
                      ( \underset{m \, \text{factors}}{ \underbrace{ j A ,  \cdots , j A } }  )
                      {\, \atop \,}
                      \\right)
              %p
                and then compare order-by-order with the given time-ordered product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                and its induced reverse-time ordered product (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ReverseTimeOrderedProduct"}
                = succeed "." do
                  %a.maruku-ref{:href => "#ReverseTimOrderedProductsGiveReverseSMatrix"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R(-,-)
                are also called the “generating
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/retarded+products"} retarded products
                %a.maruku-ref{:href => "#RetardedProductFromPerturbativeSMatrix"}
                below.)
              %p
                In the condensed notation of remark
                %a.maruku-ref{:href => "#NotationForTimeOrderedProductsAsGeneralizedFunctions"}
                and its way of absorbing combinatorial prefactors as in example
                %a.maruku-ref{:href => "#ProductOfPerturbationSeriesInGenealizedFunctionNotation"}
                this yields at order
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} /
                      %mi ℏ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mstyle{:mathvariant => "bold"}
                            %mi Y
                          %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} /
                      %mi ℏ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mstyle{:mathvariant => "bold"}
                            %mi X
                          %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} (g/\hbar)^{\vert \mathbf{Y}\vert} (j/\hbar)^{\vert \mathbf{X}\vert}
                the coefficient
              #eq:CoefficientOfgeneratingRetardedProduct.maruku-equation
                %span.maruku-eq-number (238)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi I
                          %mo ⊂
                          %mstyle{:mathvariant => "bold"}
                            %mi Y
                      %mover
                        %mi T
                        %mo ¯
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mo{:stretchy => "false"} )
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo ∖
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      R(\mathbf{Y}, \mathbf{X})
                      \\;=\;
                      \\underset{\mathbf{I} \subset \mathbf{Y}}{\sum}
                      \\overline{T}(\mathbf{I})
                      T( (\mathbf{Y} \setminus \mathbf{I}) , \mathbf{X} )
                      \\,.
              %p
                We claim now that the
                %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} support
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                is inside the subset for which
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y}
                is in the
                %a.existingWikiWord{:href => "/nlab/show/causal+past"} causal past
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi X
                      %annotation{:encoding => "application/x-tex"} \mathbf{X}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R(-,-)
                it then follows that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo ∨
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo ∧
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo ⇒
                      %mrow
                        %mo (
                        %msub
                          %mi Z
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi g
                            %msub
                              %mi S
                              %mi int
                            %mo +
                            %mi j
                            %msub
                              %mi A
                              %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi j
                        %msub
                          %mi A
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi Z
                          %mrow
                            %msub
                              %mi S
                              %mi int
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\left(supp(A_1) {\vee\!\!\!\wedge} supp(A_2)\right)
                      \\Rightarrow
                      \\left( Z_{(g S_{int}  + j A_1)}(j A_2) = Z_{S_{int}}(A_2) \right)
              %p
                and by prop.
                %a.maruku-ref{:href => "#ZCausalAdditivity"}
                this is equivalent to
                %a.existingWikiWord{:href => "/nlab/show/causal+additivity"} causal additivity
                of the S-matrix.
              %p It remains to prove the claim:
              %p
                Consider
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo ⊂
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \mathbf{X}, \mathbf{Y} \subset \Sigma
                such that the subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mo ⊂
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \mathbf{P} \subset \mathbf{Y}
                of points not in the past of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi X
                      %annotation{:encoding => "application/x-tex"} \mathbf{X}
                %a.existingWikiWord{:href => "/nlab/show/causal+ordering"} causal ordering
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mrow
                        %mo ∨
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mo ∧
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{P} {\vee\!\!\!\wedge} \mathbf{X}
                      \\,,
              %p
                is non-empty. We need to show that in this case
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} R(\mathbf{Y}, \mathbf{X}) = 0
                (in the sense of generalized functions).
              %p
                Write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Q
                      %mo ≔
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo ∖
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                    %annotation{:encoding => "application/x-tex"} \mathbf{Q} \coloneqq \mathbf{Y} \setminus \mathbf{P}
                for the complementary set of points, so that all points of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Q
                    %annotation{:encoding => "application/x-tex"} \mathbf{Q}
                are in the past of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi X
                      %annotation{:encoding => "application/x-tex"} \mathbf{X}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                    %annotation{:encoding => "application/x-tex"} \mathbf{P}
                is also not in the past of
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
