            .proof
              %h6#proof_14 Proof
              %p
                We will construct an
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
