              %li
                %p
                  %em
                    %a{:href => "#TimeOrderedProducts"} Time-ordered products
              %li
                %p
                  %em
                    %a{:href => "#ExistenceAndRenormalization"} (“Re”-)Normalization
              %li
                %p
                  %em
