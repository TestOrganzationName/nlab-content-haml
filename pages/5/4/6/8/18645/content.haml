                        %mi{:mathvariant => "normal"} D
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                    %annotation{:encoding => "application/x-tex"} \mathrm{D}_{\delta_{EL}}
                to be
                %a.existingWikiWord{:href => "/nlab/show/formally+self-adjoint+differential+operator"} formally self-adjoint differential operator
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              Now we may finally prove that an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
              is also an infinitesimal symmetry of the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations"} Euler-Lagrange
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            #InfinitesimalSymmetriesOfLagrangianAreAlsoSymmetriesOfTheEquationsOfMotion.num_prop
              %h6#proposition_6 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries+of+the+Lagrangian"} infinitesimal symmetries of the Lagrangian
                  are also
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries"} infinitesimal symmetries
                  of the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                is an
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
                then the
                %a.existingWikiWord{:href => "/nlab/show/flow"} flow
                along its prolongation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat v
                preserves the
                %a.existingWikiWord{:href => "/nlab/show/prolonged+shell"} prolonged shell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℰ
                        %mn ∞
                      %mo ↪
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}^\infty \hookrightarrow J^\infty_\Sigma(E)
                %a.maruku-eqref{:href => "#eq:ProlongedShellInJetBundle"} (52)
                in that the
                %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
                of the
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mi EL
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                    %annotation{:encoding => "application/x-tex"} \delta_{EL}\mathbf{L}
                along
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat v
                vanishes on
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℰ
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}^\infty
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℒ
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo =
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mo .
                      %mo .
                      %mo .
                      %mo{:stretchy => "false"} )
                      %mphantom
                        %mi AAA
                      %mo ⇒
                      %mphantom
                        %mi AAA
                      %msub
                        %mi ℒ
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi δ
                        %mi EL
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msup
                            %mi ℰ
                            %mn ∞
                      %mo =
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{L}_{\hat v}\mathbf{L} = d(...)
                      \\phantom{AAA}
                      \\Rightarrow
                      \\phantom{AAA}
                      \\mathcal{L}_{\hat v} \, \delta_{EL}\mathbf{L}\vert_{\mathcal{E}^\infty} = 0
                      \\,.
            .proof
              %h6#proof_7 Proof
              %p
                Notice that for any vector field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat v
                the
                %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CartanHomotopyFormula"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℒ
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}_{\hat v}
                of the
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mi EL
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo =
                      %mfrac
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mi L
                        %mrow
                          %mi δ
                          %msup
                            %mi ϕ
                            %mi a
                      %mi δ
                      %msup
                        %mi ϕ
                        %mi a
                      %mo ∧
                      %msub
                        %mi dvol
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"} \delta_{EL}\mathbf{L} = \frac{\delta_{EL}L}{\delta \phi^a} \delta \phi^a \wedge dvol_\Sigma
                differs from that of its component functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mi L
                        %mrow
                          %mi δ
                          %msup
                            %mi ϕ
                            %mi a
                      %msub
                        %mi dvol
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"} \frac{\delta_{EL}L}{\delta \phi^a} dvol_\Sigma
                by a term proportional to these component functions, which by definition vanishes on-shell:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℒ
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mrow
                        %mo (
                        %mfrac
                          %mrow
                            %msub
                              %mi δ
                              %mi EL
                            %mi L
                          %mrow
                            %mi δ
                            %msup
                              %mi ϕ
                              %mi a
                        %mi δ
                        %msup
                          %mi ϕ
                          %mi a
                        %mo ∧
                        %msub
                          %mi dvol
                          %mi Σ
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %munder
                          %mrow
                            %mo (
                            %msub
                              %mi ℒ
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                            %mfrac
                              %mrow
                                %msub
                                  %mi δ
                                  %mi EL
                                %mi L
                              %mrow
                                %mi δ
                                %msup
                                  %mi ϕ
                                  %mi a
                            %mo )
                          %mo ⏟
                        %mrow
                          %mo =
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                          %mrow
                            %mo (
                            %mfrac
                              %mrow
                                %msub
                                  %mi δ
                                  %mi EL
                                %mi L
                              %mrow
                                %mi δ
                                %msup
                                  %mi ϕ
                                  %mi a
                            %mo )
                      %mi δ
                      %msup
                        %mi ϕ
                        %mi a
                      %mo ∧
                      %msub
                        %mi dvol
                        %mi Σ
                      %mo +
                      %munder
                        %munder
                          %mfrac
                            %mrow
                              %msub
                                %mi δ
                                %mi EL
                              %mi L
                            %mrow
                              %mi δ
                              %msup
                                %mi ϕ
                                %mi a
                          %mo ⏟
                        %mrow
                          %mo =
                          %mn 0
                          %mspace{:width => "thinmathspace"}
                          %mtext on
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi ℰ
                            %mn ∞
                      %mrow
                        %mo (
                        %msub
                          %mi ℒ
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                        %mi δ
                        %msup
                          %mi ϕ
                          %mi a
                        %mo )
                      %mo ∧
                      %msub
                        %mi dvol
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{L}_{\hat v} \left( \frac{\delta_{EL} L}{\delta \phi^a} \delta \phi^a \wedge dvol_\Sigma \right)
                      \\;=\;
                      \\underset{
                      \= \hat v\left( \frac{\delta_{EL}L}{\delta \phi^a} \right)
                      }{
                      \\underbrace{
                      \\left(
                      \\mathcal{L}_{\hat v}
                      \\frac{\delta_{EL}L}{\delta \phi^a}
                      \\right)
                      }
                      }
                      \\delta \phi^a
                      \\wedge
                      dvol_\Sigma
                      +
                      \\underset{
                      \= 0 \, \text{on} \, \mathcal{E}^\infty
                      }{
                      \\underbrace{
                      \\frac{\delta_{EL}L}{\delta \phi^a}
                      }
                      }
                      \\left(
                      \\mathcal{L}_{\hat v} \delta \phi^a
                      \\right)
                      \\wedge dvol_\Sigma
              %p But the Lie derivative of the component functions is just their plain derivative. Therefore it is sufficient to show that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mo (
                        %mfrac
                          %mrow
                            %msub
                              %mi δ
                              %mi EL
                            %mi L
                          %mrow
                            %mi δ
                            %msup
                              %mi ϕ
                              %mi a
                        %mo )
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msup
                            %mi ℰ
                            %mn ∞
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\hat v
                      \\left(
                      \\frac{\delta_{EL} L}{\delta \phi^a}
                      \\right)
                      \\vert_{\mathcal{E}^\infty}
                      \\;=\;
                      0
                      \\,.
              %p
                Now by
                %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem I
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#NoethersFirstTheorem"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℒ
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mo =
                      %mi d
                      %msub
                        %mover
                          %mi J
                          %mo{:stretchy => "false"} ˜
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}_{\hat v} = d \tilde J_{\hat v}
                for an
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
                implies that the contraction (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ContractionOfFormsWithVectorFields"}
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
                with the corresponding
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                is a
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivative"} total spacetime derivative
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi δ
                        %mi EL
                      %mstyle{:mathvariant => "bold"}
