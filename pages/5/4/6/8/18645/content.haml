                    %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
                    on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝔤
                            %mo *
