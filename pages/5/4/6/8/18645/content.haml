                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msup
                        %mi Ω
                        %mo •
                      %mrow
                        %mo (
                        %msub
                          %mi Γ
                          %mrow
                            %msub
                              %mi Σ
                              %mi r
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\tau_{\Sigma} \;\colon\; \Omega^{\bullet,\bullet}_{\Sigma,cp}(E) \longrightarrow \Omega^\bullet\left(\Gamma_{\Sigma_r}(E)\right)
              %p
                is compatible with the
                %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
