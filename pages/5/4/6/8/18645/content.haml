                  %a.maruku-ref{:href => "#NLGaugeFixingOfElectromagnetism"}
                = succeed "):" do
                  %a.maruku-ref{:href => "#FieldSpeciesQED"}
              %ol
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
                    modelling the
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/electron"} electron
                    %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                    called the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/electron+propagator"} electron propagator
                    (def.
                    = succeed ")," do
                      %a.maruku-ref{:href => "#FeynmanPropagatorForDiracOperatorOnMinkowskiSpacetime"}
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
