                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mrow
                          %mo (
                          %msubsup
                            %mi j
                            %mi Σ
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi Φ
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo *
                          %msub
                            %mi β
                            %mi i
                          %mo )
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi dvol
                          %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      S_j
                      \\colon
                      \\Phi
                      \\mapsto
                      \\underset{\Sigma}{\int} g_i(x) \, \left(j^\infty_\Sigma(\Phi)^\ast \alpha_i\right)(x)\, dvol_\Sigma(x)
                      \\right\}
                      \\;\cup\;
                      \\left\{
                      A_j
                      \\colon
                      \\Phi
                      \\mapsto
                      \\underset{\Sigma}{\int} j_i(x) \, \left(j^\infty_\Sigma(\Phi)^\ast \beta_i\right)(x)\, dvol_\Sigma(x)
                      \\right\}
              %p
                is the corresponding set of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
                of these observables as the
                %a.existingWikiWord{:href => "/nlab/show/integration"} integration
                of these
                %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
                against a
                %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi α
                            %mi i
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T_{(\alpha_i)}
                with values in the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                            %mtd
                              %munder
                                %mo ∫
                                %mrow
                                  %msup
                                    %mi Σ
                                    %mi n
                              %msub
                                %mi T
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi α
                                    %mi i
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi β
                                    %mi j
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 1
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %msub
                                %mi x
                                %mi r
                              %mo ,
                              %msub
                                %mi x
                                %mrow
                                  %mi r
                                  %mo +
                                  %mn 1
                              %mo ,
                              %mi ⋯
                              %msub
                                %mi x
                                %mi n
                              %mo{:stretchy => "false"} )
                              %msub
                                %mi g
                                %mn 1
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mi ⋯
                              %msub
                                %mi g
                                %mi r
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mi r
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi j
                                %mn 1
                              %mo{:stretchy => "false"} (
