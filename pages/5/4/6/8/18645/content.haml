            .proof
              %h6#proof_3 Proof
              %p For the first statement we compute as follows:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
