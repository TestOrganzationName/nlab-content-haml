                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} A \in LocObs(E_{\text{BV-BRST}})[ [\hbar , g] ]
                a
                %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
                of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
                %a.existingWikiWord{:href => "/nlab/show/local+interacting+field+observable"} local interacting field observable
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
