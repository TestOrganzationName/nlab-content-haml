                            %mo )
                        %annotation{:encoding => "application/x-tex"}
                          \\left(
                          {\, \atop \,}
                          supp(O_1) {\vee\!\!\!\wedge} supp(O_2)
                          {\, \atop \,}
                          \\right)
                          \\;\; \Rightarrow \;\;
                          \\left(
                          {\, \atop \,}
                          \\mathcal{S}( O_1 + O_2 )
                          \=
                          \\mathcal{S}( O_1 ) \, \mathcal{S}( O_2 )
                          {\, \atop \,}
                          \\right)
              %p
                (This is the special case of “causal additivity” for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi O
                          %mn 0
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} O_0 = 0
                %a.maruku-eqref{:href => "#eq:ExponentialSeriesScatteringMatrix"} (229)
                we have
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒮
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathcal{S}(0) = 1
              %p
                If we now think of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi O
                        %mn 1
                      %mo =
                      %mi g
                      %msub
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} O_1 = g S_{1}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi O
                        %mn 2
                      %mo =
                      %mi g
                      %msub
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} O_2 = g S_2
                themselves as
                %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/action+functionals"} action functionals
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi S
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo ∨
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo ∧
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⇒
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                        %mi 𝒮
                        %mo{:stretchy => "false"} (
                        %mi g
                        %msub
                          %mi S
                          %mn 1
                        %mo +
                        %mi g
                        %msub
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi 𝒮
                        %mo{:stretchy => "false"} (
                        %mi g
                        %msub
                          %mi S
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mi 𝒮
                        %mo{:stretchy => "false"} (
                        %mi g
                        %msub
                          %mi sS
                          %mn 2
                        %mo{:stretchy => "false"} )
