                  %annotation{:encoding => "application/x-tex"} \,
            %p#AbstractTimeOrderedProduct
              %strong
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
            #OnRegularPolynomialObservablesTimeOrderedProduct.num_defn
              %h6#definition_2 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
                  on
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                be a
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                over a
                %a.existingWikiWord{:href => "/nlab/show/Lorentzian+manifold"} Lorentzian
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                and with
                %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green-hyperbolic
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/differential+equations"} differential equations
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi S
                      %mo =
                      %msub
                        %mi Δ
                        %mo +
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mi Δ
                        %mo −
                    %annotation{:encoding => "application/x-tex"} \Delta_S = \Delta_+ - \Delta_-
                for the induced
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi H
                      %mo =
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi i
                          %mn 2
                      %msub
                        %mi Δ
                        %mi S
                      %mo +
                      %mi H
                    %annotation{:encoding => "application/x-tex"} \Delta_H = \tfrac{i}{2}\Delta_S + H
                be a compatible
                %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
                and write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi F
                      %mo =
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi i
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Δ
                        %mo +
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %msub
                        %mi Δ
                        %mo −
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi H
                    %annotation{:encoding => "application/x-tex"} \Delta_F = \tfrac{i}{2}(\Delta_+ + \Delta_-) + H
                for the induced
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              %p
                Then the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
                on the space of
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observable"} regular polynomial observable
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi reg
                    %annotation{:encoding => "application/x-tex"} PolyObs(E)_{reg}
                is the
                %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
                induced by the
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                (via prop.
                = succeed "):" do
                  %a.maruku-ref{:href => "#PropagatorStarProduct"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi PolyObs
                              %mo{:stretchy => "false"} (
                              %mi E
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi reg
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi ℏ
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                              %mo ⊗
                              %mi PolyObs
                              %mo{:stretchy => "false"} (
                              %mi E
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi reg
