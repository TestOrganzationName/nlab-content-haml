                  %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
