                        %mi α
                        %mn 1
                      %mo ∧
                      %mi d
                      %msub
                        %mi α
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\tau_\Sigma( d \alpha_1) \wedge \alpha_2 )
                      \\;=\;
                      \- (-1)^{deg(\alpha_1)}
                      \\tau_\Sigma( \alpha_1 \wedge d \alpha_2 )
                      \\,,
              %p hence
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
