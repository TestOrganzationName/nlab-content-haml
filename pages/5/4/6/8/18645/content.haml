                            %mo )
                        %annotation{:encoding => "application/x-tex"} \left( Obs(E,\mathbf{L})_{\mu c},\, \star\right)
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℂ
                          %mi Alg
                        %annotation{:encoding => "application/x-tex"} \mathbb{C}Alg
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/non-commutative+algebra"} non-commutative algebra
                    %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                    on
                    %a.existingWikiWord{:href => "/nlab/show/observable"} field observables
                  %td{:style => "text-align: left;"}
                    def.
                    = succeed "," do
                      %a.maruku-ref{:href => "#WickAlgebraOfFreeQuantumField"}
                    %a.maruku-ref{:href => "#GeneratingFunctionsForCorrelationFunctions"}
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#FieldBundles
              %strong
                %a.existingWikiWord{:href => "/nlab/show/field+bundles"} field bundles
            #FieldsAndFieldBundles.num_defn
              %h6#definition Definition
              %p
                %strong
