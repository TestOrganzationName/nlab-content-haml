                        %annotation{:encoding => "application/x-tex"}
                          \\underset{x \in \mathbb{R}^n}{\int} f(x) g^\ast(x)\, d^n x
                          \\;=\;
                          \\underset{k \in \mathbb{R}^n}{\int} \widehat{f}(k) \widehat{g}^\ast(k) \, d^n k
                %li
                  #eq:FourierTransformInIntegralOfProductMayBeShiftedToOtherFactor.maruku-equation
                    %span.maruku-eq-number (129)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ∫
                            %mrow
                              %mi k
                              %mo ∈
                              %msup
