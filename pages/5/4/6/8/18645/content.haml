                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DifferentialOperator"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
