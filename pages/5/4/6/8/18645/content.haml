                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi Γ
                              %mo ,
                              %mi vertlab
                              %mo ,
                              %mi edgelab
                              %mo{:stretchy => "false"} )
                          %mrow
                            %mrow
                              %mo ∈
                              %msub
                                %mi 𝒢
                                %mrow
                                  %mi conn
                                  %mo ,
                                  %mi vac
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ,
                      %mi vertlab
                      %mo ,
                      %mi edgelab
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi mc
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
