                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i,j \in I
                are
                %a.existingWikiWord{:href => "/nlab/show/linear+functions"} linear functions
                over each point
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
