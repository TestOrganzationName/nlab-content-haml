                        %mrow
                          %mi a
                          %mo =
                          %mn 1
                        %mi s
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Phi = ( \Phi^a )_{a = 1}^s
                      \\,.
            #RealScalarFieldBundle.num_example
              %h6#example_2 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                  for
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                is a
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                and if the
                %a.existingWikiWord{:href => "/nlab/show/field+fiber"} field fiber
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ≔
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      F \coloneqq \mathbb{R}
              %p
                is simply the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi Σ
                              %mo ×
                              %mi ℝ
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi pr
                                      %mn 1
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi Σ
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\Sigma \times \mathbb{R}
                      \\\
                      {}^{\mathllap{pr_1}}\downarrow
                      \\\
                      \\Sigma
                      }
              %p
                is the
                %em
