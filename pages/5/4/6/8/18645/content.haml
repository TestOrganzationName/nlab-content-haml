            #AssociativeAndUnitalStarProduct.num_prop
              %h6#proposition Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
                  is
                  %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
              %p
                Given
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi π
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V,\pi)
                as above, then the star product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⋆
                        %mi π
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-) \star_\pi (-)
                from def.
                %a.maruku-ref{:href => "#StarPoduct"}
                is
                %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
                and
                %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
                with unit the
                %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ∈
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
