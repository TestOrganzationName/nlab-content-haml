                says that
              #eq:IntegrationByPartsCohomologicallyOnJetBundle.maruku-equation
                %span.maruku-eq-number (106)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
