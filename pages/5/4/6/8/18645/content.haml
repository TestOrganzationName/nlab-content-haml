                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha \in \Omega^{s-1,0}_\Sigma(E)
                with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo =
                        %mi d
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \omega = d \alpha
            %p
              (e.g.
              = succeed ")" do
                %a{:href => "variational+bicomplex#Anderson89"} Anderson 89, prop. 4.3
            #EulerLagrangeComplex.num_remark
              %h6#remark_3 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+complex"}> Euler-Lagrange complex
                  )
              %p
                In fact the exact sequence
                %a.maruku-eqref{:href => "#eq:ExactSequenceTotalSpacetimeDerivative"} (40)
                from prop.
                %a.maruku-ref{:href => "#HorizontalVariationalComplexOfTrivialFieldBundleIsExact"}
                continues further to the right, as such called the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+complex"} Euler-Lagrange complex
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+operator"} Euler-Lagrange operator
                and then then next is the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Helmholtz+operator"} Helmholtz operator
              %p
                Here we do not discuss this in detail, but we encounter aspects of the exactness further to the right below in example
                %a.maruku-ref{:href => "#TrivialLagrangianDensities"}
                and in prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#EvolutionaryDerivativeOfEulerLagrangeFormIsFormallySelfAdjoint"}
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              This concludes our discussion of
              %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %a{:href => "#Lagrangians"} next chapter
              we apply this to
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
              on the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theories"} Lagrangian field theories
          %div
            %h2#Lagrangians Lagrangians
            %p In this chapter we discuss the following topics:
            %ul
              %li
                %p
                  %em
                    %a{:href => "#LagrangianDensities"} Lagrangian densities
              %li
                %p
                  %em
                    %a{:href => "#ELFormsAndPresymplecticCurrents"} Euler-Lagrange forms and Presymplectic currents
              %li
                %p
                  %em
                    %a{:href => "#ELEquationsOfMotion"} Euler-Lagrange equations of motion
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              Given any
              %a.existingWikiWord{:href => "/nlab/show/type"} type
              of
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              that are to be regarded as “physically realizable” (if we think of the field theory as a description of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/observable+universe"} observable universe
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              – the
              %em
                %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
              – meaning that realizability of any field histories may be checked upon restricting the configuration to the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhoods"} infinitesimal neighbourhoods
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#InfinitesimalNeighbourhood"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/local+field+theory"} local field theory
              %a.maruku-ref{:href => "#JetBundleInTermsOfSyntheticDifferentialGeometry"}
              this means that
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              of a field theory are
              %a.existingWikiWord{:href => "/nlab/show/equations"} equations
              among the
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              of the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            %p
              For many field theories of interest, their
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential
              %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
              is not a random
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/partial+differential+equations"} partial differential equations
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/principle+of+extremal+action"} principle of extremal action
              %a.maruku-ref{:href => "#PrincipleOfExtremalAction"}
              below) determined by a
              %em
                %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
              (def.
              %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              below). These are called
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theories"} Lagrangian field theories
            %p
              Namely among all the
              %a.existingWikiWord{:href => "/nlab/show/variational+differential+forms"} variational differential forms
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^{0,0}_\Sigma(E)
              – the smooth functions – and the horizontal
              = succeed "-forms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p+1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^{p+1,0}_\Sigma(E)
              – to be called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                    %annotation{:encoding => "application/x-tex"} \mathbf{L}
              (def.
              %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              below) – since these occupy the two “corners” of the
              %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} variational bicomplex
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:VariationalBicomplexDiagram"} (38)
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}
              do inherit special structure from their special position in the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} variational bicomplex
            %p
              Their
              %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \delta \mathbf{L}
              uniquely decomposes as
            %ol
              %li
                %p
                  the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+derivative"} Euler-Lagrange derivative
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                      %annotation{:encoding => "application/x-tex"} \delta_{EL} \mathbf{L}
                  which is proportional to the variation of the fields (instead of their derivatives)
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total spacetime derivative
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %msub
                          %mi Θ
                          %mi BFV
                      %annotation{:encoding => "application/x-tex"} d \Theta_{BFV}
                  of a potential
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Θ
                          %mi BFV
                      %annotation{:encoding => "application/x-tex"} \Theta_{BFV}
                  for a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Ω
                            %mi BFV
                          %mo ≔
                          %mi δ
                          %msub
                            %mi Θ
                            %mi BFV
                        %annotation{:encoding => "application/x-tex"} \Omega_{BFV} \coloneqq \delta \Theta_{BFV}
            %p
              This is prop.
              %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
              below:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                        %mo ⏟
                      %mtext Euler-Lagrange variation
                    %mo −
                    %mi d
                    %munder
                      %munder
                        %mrow
                          %msub
                            %mi Θ
                            %mi BFV
                        %mo ⏟
                      %mtext presymplectic current
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta \mathbf{L}
                    \\;=\;
                    \\underset{ \text{Euler-Lagrange variation}
                    }{\underbrace{\delta_{EL}\mathbf{L}}} - d \underset{\text{presymplectic current}}{\underbrace{\Theta_{BFV}}}
                    \\,.
            %p
              These two terms play a pivotal role in the theory: The condition that the first term vanishes on
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              is a
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              on field histories, called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
                %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
              (def.
              %a.maruku-ref{:href => "#EulerLagrangeEquationsOnTrivialVectorFieldBundleOverMinkowskiSpacetime"}
              below). The space of solutions to this
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              %em
                %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
                %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            #eq:InclusionOfOnShellSpaceOfFieldHistories.maruku-equation
              %span.maruku-eq-number (41)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mo =
                        %mn 0
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AAA
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_\Sigma(E)_{\delta_{EL}\mathbf{L} = 0}
                    \\overset{\phantom{AAA}}{\hookrightarrow}
                    \\Gamma_\Sigma(E)
            %p
              has the interpretation of the space of “physically realizable field histories”. This is the key object of study in the following chapters. Often this is referred to as the space of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical
                  field histories
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            %p
              Indeed, there is also the second term in the variational derivative of the Lagrangian density, the
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Θ
                        %mi BFV
                    %annotation{:encoding => "application/x-tex"} \Theta_{BFV}
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+structure"} presymplectic structure
              on the on-shell space of field histories (def.
              %a.maruku-ref{:href => "#PhaseSpaceAssociatedWithCauchySurface"}
              below) which encodes
              %a.existingWikiWord{:href => "/nlab/show/deformations"} deformations
              of the algebra of smooth functions on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
              of the field theory to an actual
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
              = succeed "." do
                %a{:href => "#Quantization"} below
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi δ
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo =
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi δ
                              %mi EL
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mtd
                            %mi d
                            %msub
                              %mi Θ
                              %mi BFV
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mtext classical
                                %mtr
                                  %mtd
                                    %mtext field theory
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mtext deformation to
                                %mtr
                                  %mtd
                                    %mtext quantum
                                %mtr
                                  %mtd
                                    %mtext field theory
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;&amp; \delta \mathbf{L}
                    \\\
                    \&amp;&amp;&amp; =
                    \\\
                    \&amp;  &amp; \delta_{EL}\mathbf{L} &amp;- &amp; d \Theta_{BFV}   &amp;
                    \\\
                    \&amp; \swarrow &amp;&amp; &amp;&amp; \searrow
                    \\\
                    \\array{
                    \\text{classical}
                    \\\
                    \\text{field theory}
                    }
                    \&amp;&amp; &amp;&amp; &amp;&amp;
                    \\array{
                    \\text{deformation to}
                    \\\
                    \\text{quantum}
                    \\\
                    \\text{field theory}
                    }
                    }
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#LagrangianDensities
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
            #LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime.num_defn
              %h6#definition Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"}> local Lagrangian density
                  )
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                over a
                = succeed "-dimensional" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (p+1)
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                as in example
                = succeed "," do
                  %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                    %annotation{:encoding => "application/x-tex"} \mathbf{L}
                (for the type of field thus defined) is a
                %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+form"} horizontal differential form
                of degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+1)
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                (def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L} \;\in \; \Omega^{p+1,0}_{\Sigma}(E)
                      \\,.
              %p
                By example
                %a.maruku-ref{:href => "#BasicFactsAboutVarationalCalculusOnJetBundleOfTrivialVectorBundle"}
                in terms of the given
                %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
                on spacetimes, any such Lagrangian density may uniquely be written as
              #eq:LagrangianFunctionViaVolumeForm.maruku-equation
                %span.maruku-eq-number (42)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo =
                      %mi L
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi dvol
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L} = L \, dvol_\Sigma
              %p
                where the
                %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
                function (the
                = succeed ")" do
                  %em Lagrangian function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo =
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϕ
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ⋯
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      L = L((x^\mu), (\phi^a), (\phi^a_{,\mu}), \cdots )
                      \\,.
              %p
                where by prop.
                %a.maruku-ref{:href => "#JetBundleIsLocallyProManifold"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ⋯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L((x^\mu), \cdots)
                depends locally on an arbitrary but finite order of derivatives
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi ϕ
                          %mrow
                            %mo ,
                            %msub
                              %mi μ
                              %mn 1
                            %mi ⋯
                            %msub
                              %mi μ
                              %mi k
                          %mi a
                      %annotation{:encoding => "application/x-tex"} \phi^a_{,\mu_1 \cdots \mu_k}
              %p
                We say that a
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                    %annotation{:encoding => "application/x-tex"} \mathbf{L}
                is (or defines) a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/prequantum+field+theory"} prequantum
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                on the
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
            #ParameterizedLagrangianDensities.num_remark
              %h6#remark Remark
              %p
                %strong
                  (parameterized and
                  = succeed "-less" do
                    %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
              %p
                More generally we may consider parameterized collections of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi U
                      %mo ⟶
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L}_{(-)}
                      \\;\colon\;
                      U \longrightarrow \Omega^{p+1,0}_\Sigma(E)
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                some
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                or generally some
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              %p
                For example all
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
                considered in
                %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic field theory
                are naturally
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                of the scale of the
                %a.existingWikiWord{:href => "/nlab/show/metric"} metric
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi ℝ
                                %mrow
                                  %mo &gt;
                                  %mn 0
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                            %mtd
                              %msubsup
                                %mi Ω
                                %mi Σ
                                %mrow
                                  %mi p
                                  %mo +
                                  %mn 1
                                  %mo ,
                                  %mn 0
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi r
                            %mtd
                              %mo ↦
                            %mtd
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                                %mrow
                                  %msup
                                    %mi r
                                    %mn 2
                                  %mi η
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathbb{R}_{\gt 0}
                      \&amp;\overset{}{\longrightarrow}&amp;
                      \\Omega^{p+1,0}_\Sigma(E)
                      \\\
                      r &amp;\mapsto&amp; \mathbf{L}_{r^2\eta}
                      }
              %p
                But by the discussion in remark
                = succeed "," do
                  %a.maruku-ref{:href => "#MinkowskiMetricAndPhysicalUnitOfLength"}
                %a.existingWikiWord{:href => "/nlab/show/physics"} physics
                a rescaling of the
                %a.existingWikiWord{:href => "/nlab/show/metric"} metric
                is interpreted as reflecting but a change of
                %a.existingWikiWord{:href => "/nlab/show/physical+units"} physical units
                of
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/length"} length
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/distance"} distance
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                is supposed to express intrinsic content of a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/theory+%28physics%29"} physical theory
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/physical+units"} physical units
              %p
                This is achieved by having the Lagrangian be parameterized by
                %em further
                parameters, whose corresponding
                %a.existingWikiWord{:href => "/nlab/show/physical+units"} physical units
                compensate that of the metric such as to make the Lagrangian density “
                %a.existingWikiWord{:href => "/nlab/show/physical+unit"}> physical unit
                \-less”.
              %p
                This means to consider parameter spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                equipped with an
                %a.existingWikiWord{:href => "/nlab/show/action"} action
                of the multiplicative
                %a.existingWikiWord{:href => "/nlab/show/group"} group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℝ
                        %mrow
                          %mo &gt;
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\gt 0}
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/positive+real+numbers"} positive real numbers
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi U
                      %mo ⟶
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L}_{(-)} \;\colon\; U \longrightarrow \Omega^{p+1,0}_\Sigma(E)
              %p
                which are
                %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
                under this
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
            #LocallyVariationalFieldTheory.num_remark
              %h6#remark_2 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/locally+variational+field+theory"} locally variational field theory
                  and Lagrangian
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} p-gerbe connection
              %p
                If the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                over
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
                %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
                may not exist as a globally defined differential
                = succeed "-form," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (p+1)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} p-gerbe connection
                %em
                  %a.existingWikiWord{:href => "/nlab/show/locally+variational+field+theories"} locally variational field theories
                such as the
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/charged+particle"} charged particle
                %em
                  %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
                and generally theories involving
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/higher+WZW+terms"} higher WZW terms
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/schreiber/show/Higher+Structures"} Higher Structures in Physics
            #LagrangianForFreeScalarFieldOnMinkowskiSpacetime.num_example
              %h6#example Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
                  for
                  %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                  %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
                  on
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                for the
                %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
                from example
                = succeed "," do
                  %a.maruku-ref{:href => "#RealScalarFieldBundle"}
                %a.existingWikiWord{:href => "/nlab/show/trivial+line+bundle"} trivial line bundle
                over
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %p
                According to def.
                %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                its
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
                has canonical coordinates
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo {
                        %mo{:stretchy => "false"} {
                        %msup
                          %mi x
                          %mi μ
                        %mo{:stretchy => "false"} }
                        %mo ,
                        %mi ϕ
                        %mo ,
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi μ
                        %mo{:stretchy => "false"} }
                        %mo ,
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %msub
                              %mi μ
                              %mn 1
                            %msub
                              %mi μ
                              %mn 2
                        %mo{:stretchy => "false"} }
                        %mo ,
                        %mi ⋯
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \\{x^\mu\}, \phi, \{\phi_{,\mu}\}, \{\phi_{,\mu_1 \mu_2}\}, \cdots
                      \\right\}
                      \\,.
              %p
                In these coordinates, the
                %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ∈
                      %msup
                        %mi Ω
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L \in \Omega^{p+1,0}(\Sigma)
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
                of
                %a.existingWikiWord{:href => "/nlab/show/mass"} mass
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} m \in \mathbb{R}
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ≔
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %mrow
                        %mo (
                        %msup
                          %mi η
                          %mrow
                            %mi μ
                            %mi ν
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi μ
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi ν
                        %mo −
                        %msup
                          %mi m
                          %mn 2
                        %msup
                          %mi ϕ
                          %mn 2
                        %mo )
                      %msub
                        %mi{:mathvariant => "normal"} dvol
                        %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      L
                      \\coloneqq
                      \\tfrac{1}{2}
                      \\left(
                      \\eta^{\mu \nu} \phi_{,\mu} \phi_{,\nu}
                      \-
                      m^2 \phi^2
                      \\right)
                      \\mathrm{dvol}_\Sigma
                      \\,.
              %p
                This is naturally thought of as a collection of Lagrangians smoothly parameterized by the
                %a.existingWikiWord{:href => "/nlab/show/metric"} metric
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                and the
                %a.existingWikiWord{:href => "/nlab/show/mass"} mass
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                      %annotation{:encoding => "application/x-tex"} m
                = succeed "-free" do
                  %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
                %a.maruku-ref{:href => "#ParameterizedLagrangianDensities"}
                the
                %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
                of the parameter
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
                must be that of the inverse metric, hence must be an inverse
                %a.existingWikiWord{:href => "/nlab/show/length"} length
                according to remark
                %a.maruku-ref{:href => "#MinkowskiMetricAndPhysicalUnitOfLength"}
                This is the
                %em
                  inverse
                  %a.existingWikiWord{:href => "/nlab/show/Compton+wavelength"} Compton wavelength
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℓ
                        %mi m
                      %mo =
                      %mi ℏ
                      %mo{:stretchy => "false"} /
                      %mi m
                      %mi c
                    %annotation{:encoding => "application/x-tex"} \ell_m = \hbar / m c
                %a.maruku-eqref{:href => "#eq:ComptonWavelength"} (9)
                and hence the
                = succeed "-free" do
                  %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mrow
                          %mi η
                          %mo ,
                          %msub
                            %mi ℓ
                            %mi m
                      %mspace{:width => "mediummathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %msubsup
                              %mi ℓ
                              %mi m
                              %mn 2
                          %mn 2
                      %mrow
                        %mo (
                        %msup
                          %mi η
                          %mrow
                            %mi μ
                            %mi ν
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi μ
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi ν
                        %mo −
                        %msup
                          %mrow
                            %mo (
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mrow
                                  %mi m
                                  %mi c
                                %mi ℏ
                            %mo )
                          %mn 2
                        %msup
                          %mi ϕ
                          %mn 2
                        %mo )
                      %msub
                        %mi{:mathvariant => "normal"} dvol
                        %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L}_{\eta,\ell_m}
                      \\:\coloneqq\;
                      \\tfrac{\ell_m^2}{2}
                      \\left(
                      \\eta^{\mu \nu} \phi_{,\mu} \phi_{,\nu}
                      \-
                      \\left( \tfrac{m c}{\hbar} \right)^2 \phi^2
                      \\right)
                      \\mathrm{dvol}_\Sigma
                      \\,.
            #phintheoryLagrangian.num_example
              %h6#example_2 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/phi%5En+theory"}> phi^n theory
                  )
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                for the
                %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
                from example
                = succeed "," do
                  %a.maruku-ref{:href => "#RealScalarFieldBundle"}
                %a.existingWikiWord{:href => "/nlab/show/trivial+line+bundle"} trivial line bundle
                over
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                from example
                %a.maruku-ref{:href => "#LagrangianForFreeScalarFieldOnMinkowskiSpacetime"}
                some power of the field coordinate
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mi int
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi g
                      %msup
                        %mi ϕ
                        %mi n
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi dvol
                        %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L}_{int}
                      \\;\coloneqq\;
                      g \phi^n \, dvol_\Sigma
                      \\,,
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} g \in \mathbb{R}
                some number, here called the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                defined by the resulting
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo +
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mi int
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %mrow
                        %mo (
                        %msup
                          %mi η
                          %mrow
                            %mi μ
                            %mi ν
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi μ
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi ν
                        %mo −
                        %msup
                          %mi m
                          %mn 2
                        %msup
                          %mi ϕ
                          %mn 2
                        %mo +
                        %mi g
                        %msup
                          %mi ϕ
                          %mi n
                        %mo )
                      %msub
                        %mi{:mathvariant => "normal"} dvol
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L}
                      +
                      \\mathbf{L}_{int}
                      \\;=\;
                      \\tfrac{1}{2}
                      \\left(
                      \\eta^{\mu \nu} \phi_{,\mu} \phi_{,\nu}
                      \-
                      m^2 \phi^2
                      +
                      g \phi^n
                      \\right)
                      \\mathrm{dvol}_\Sigma
              %p
                is usually called just
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/phi%5En+theory"} phi^n theory
            #ElectromagnetismLagrangianDensity.num_example
              %h6#example_3 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
                  for
                  %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi T
                        %mo *
                      %mi Σ
                      %mo →
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} T^\ast \Sigma \to \Sigma
                for the
                %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
                on
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                from example
                = succeed "," do
                  %a.maruku-ref{:href => "#Electromagnetism"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                of
                %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} p+1
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                coordinates taken to be
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mi μ
                        %msubsup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi μ
                            %mo =
                            %mn 0
                          %mi p
                      %annotation{:encoding => "application/x-tex"} (a_\mu)_{\mu = 0}^p
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
