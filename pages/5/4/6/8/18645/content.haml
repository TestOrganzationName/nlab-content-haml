                which are
                %a.existingWikiWord{:href => "/nlab/show/disjoint+unions"} disjoint unions
                of
                %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
                sets that are in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/causal+order"} causal order
                %a.existingWikiWord{:href => "/nlab/show/causal+factorization"} causal factorization
                the time-ordered products
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
