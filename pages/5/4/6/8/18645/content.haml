                          %mover
                            %mi g
                            %mo ^
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi d
                            %mi n
                          %mi x
                        %annotation{:encoding => "application/x-tex"}
                          \\underset{k \in \mathbb{R}^n}{\int} \widehat{f}(k) \cdot g(k) \, d^n k
                          \\;=\;
