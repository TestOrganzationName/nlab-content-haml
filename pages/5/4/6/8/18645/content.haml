              as a measure for
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal
              displacements along the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
