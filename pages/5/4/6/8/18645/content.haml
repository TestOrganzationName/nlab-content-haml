                      \\left(
                      \\Gamma_{\Sigma_{tra}}(E)_{\delta_{EL} \mathbf{L} = 0}
                      \\right)
                      \\,.
              %p
                Hence there is a well defined
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 2
                      %mrow
                        %mo (
                        %msub
                          %mi Γ
                          %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi E
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi δ
                              %mi EL
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                        %mo =
                        %mn 0
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\omega \in \Omega^2\left(  \Gamma_\Sigma(E)_{\delta_{EL}\mathbf{L}} = 0 \right)
              %p
                on the genuine
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo ≔
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mi ω
                        %mrow
                          %msub
                            %mi Σ
                            %mi p
                    %annotation{:encoding => "application/x-tex"} \omega \coloneqq i^\ast \omega_{\Sigma_p}
                for any Cauchy surface
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                        %mover
                          %mo ↪
                          %mi i
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma_p \overset{i}{\hookrightarrow} \Sigma
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+smooth+space"} presymplectic smooth space
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %msub
                          %mi Γ
                          %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi E
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi δ
                              %mi EL
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi ω
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\left(
                      \\Gamma_\Sigma(E)_{\delta_{EL}\mathbf{L}}
                      \\,,\,
