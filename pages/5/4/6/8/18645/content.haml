                            %mn 2
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} (e_i)^2 = -1
                %li
                  %p
                    for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo ,
                          %mi j
                          %mo ,
                          %mi k
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (i,j,k)
                    a cyclic
                    %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 2
                          %mo ,
                          %mn 3
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (1,2,3)
                    then
                  %ol
                    %li
                      %p
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi e
                                %mi i
