                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      S_{eff}(g,j) \;\in\; PolyObs(E_{\text{BV-BRST}})((\hbar))[ [ g, j] ]
              %p
                be the corresponding
                %a.existingWikiWord{:href => "/nlab/show/effective+action"} effective action
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#InPerturbationTheoryActionEffective"}
              %p
                Then then
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
