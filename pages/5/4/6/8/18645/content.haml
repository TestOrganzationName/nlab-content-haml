              %p
                Just as for ordinary
                %a.existingWikiWord{:href => "/nlab/show/cotangent+bundles"} cotangent bundles
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Differential1FormsOnCartesianSpaces"}
                = succeed ")" do
                  %a.maruku-ref{:href => "#HomomorphismBetweenLieAlgebroids"}
              #eq:CotangentLieAlgebrpoidProjection.maruku-equation
                %span.maruku-eq-number (176)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
