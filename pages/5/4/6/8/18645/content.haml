                            %mi ϕ
                            %mrow
                              %mo ,
                              %mi μ
                            %mi a
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi ⋯
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} L = L((x^\mu), (\phi^a), (\phi^a_{,\mu}), \cdots)
                    some smooth function that may depend on all the spacetime and field coordinates.
                %li
                  %p
                    The spacetimes
                    %a.existingWikiWord{:href => "/nlab/show/total+derivatives"} total derivatives
                    \/horizontal derivatives) of the variational derivative (vertical derivative)
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi δ
                          %mi ϕ
                        %annotation{:encoding => "application/x-tex"} \delta \phi
                    of a field variable is the differential 2-form of horizontal degree 1 and vertical degree 1 given by
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                              %mtr
                                %mtd
                                  %mi d
                                  %mo{:stretchy => "false"} (
                                  %mi δ
                                  %msup
                                    %mi ϕ
                                    %mi a
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %mo =
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi δ
                                  %mo{:stretchy => "false"} (
                                  %mi d
                                  %msub
                                    %mi ϕ
                                    %mi a
                                  %mo{:stretchy => "false"} )
                              %mtr
                                %mtd
                                %mtd
                                  %mo =
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} (
                                  %mi δ
                                  %msubsup
                                    %mi ϕ
                                    %mrow
                                      %mo ,
                                      %mi μ
                                    %mi a
                                  %mo{:stretchy => "false"} )
                                  %mo ∧
                                  %mstyle{:mathvariant => "bold"}
                                    %mi d
                                  %msup
                                    %mi x
                                    %mi μ
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          \\begin{aligned}
                          d (\delta \phi^a)
                          \&amp; =
                          \-
                          \\delta (d \phi_a)
                          \\\
                          \&amp; =
                          \- (\delta \phi^a_{,\mu}) \wedge \mathbf{d} x^\mu
                          \\end{aligned}
                          \\,.
                  %p In words this says that “the spacetime derivative of the variation of the field is the variation of its spacetime derivative”.
            %p The following are less trivial properties of variational differential forms:
            #PullbackAlongJetProlongationIntertwinesHorizontalDerivative.num_prop
              %h6#proposition_2 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
                  along
                  %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
                  compatible with
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total spacetime derivatives
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                over a
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %p
                Then for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo ∈
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Phi \in \Gamma_\Sigma(E)
                any field history, the
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#PullbackOfDifferentialForms"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi j
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Φ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      j^\infty_\Sigma(\Phi)^\ast
                      \\;\colon\;
                      \\Omega^\bullet(J^\infty_\Sigma(E))
                      \\longrightarrow
                      \\Omega^\bullet(\Sigma)
              %p
                along the
                %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} \Phi
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#JetProlongation"}
              %ol
                %li
                  %p
                    intertwines the
                    %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
                    on
                    %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Differential1FormsOnCartesianSpaces"}
                    %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivative"} total spacetime derivative
                    (
                    %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"}> horizontal derivative
                    ) on the
                    %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                    (def.
                    = succeed "):" do
                      %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mo ∘
                          %msubsup
                            %mi j
                            %mi Σ
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi Φ
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo *
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %msubsup
                            %mi j
                            %mi Σ
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi Φ
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo *
                          %mo ∘
                          %mi d
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          d \circ j^\infty_\Sigma(\Phi)^\ast
                          \\;=\;
                          j^\infty_\Sigma(\Phi)^\ast \circ d
                          \\,.
                %li
                  %p
                    annihilates all
                    %a.existingWikiWord{:href => "/nlab/show/vertical+differential+forms"} vertical differential forms
                    (def.
                    = succeed "):" do
                      %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi j
                            %mi Σ
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi Φ
                          %msup
                            %mo{:stretchy => "false"} )
                            %mo *
                          %msub
                            %mo{:stretchy => "false"} |
                            %mrow
                              %msubsup
                                %mi Ω
                                %mi Σ
                                %mrow
                                  %mi r
                                  %mo ,
                                  %mo ≥
                                  %mn 1
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          j^\infty_\Sigma(\Phi)^\ast\vert_{\Omega^{r, \geq 1}_\Sigma(E)} = 0
                          \\,.
            .proof
              %h6#proof Proof
              %p
                The operation of
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
                along any
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                intertwines the full
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+differentials"} de Rham differentials
                (prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#PullbackOfDifferentialForms"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∘
                      %msubsup
                        %mi j
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Φ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo =
                      %msubsup
                        %mi j
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Φ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo ∘
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d \circ j^\infty_\Sigma(\Phi)^\ast
                      \=
                      j^\infty_\Sigma(\Phi)^\ast \circ \mathbf{d}
                      \\,.
              %p This means that the second statement immediately follows from the first, by definition of the variational (vertical) derivative as the difference between the full de Rham differential and the horizontal one:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msubsup
                                %mi j
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi Φ
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mo ∘
                              %mi δ
                            %mtd
                              %mo =
                              %msubsup
                                %mi j
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi Φ
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mo ∘
                              %mo{:stretchy => "false"} (
                              %mstyle{:mathvariant => "bold"}
                                %mi d
                              %mo −
                              %mi d
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mo −
                              %mi d
                              %mo{:stretchy => "false"} )
                              %mo ∘
                              %msubsup
                                %mi j
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi Φ
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      j^\infty_\Sigma(\Phi)^\ast \circ \delta
                      \&amp; =
                      j^\infty_\Sigma(\Phi)^\ast \circ (\mathbf{d} - d)
                      \\\
                      \&amp; =
                      (d - d) \circ j^\infty_\Sigma(\Phi)^\ast
                      \\\
                      \&amp; =
                      0
                      \\end{aligned}
              %p It remains to see the first statement:
              %p
                Since the
                %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi j
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Φ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j^\infty_\Sigma(\Phi)
                preserves the spacetime coordinates
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mi μ
                    %annotation{:encoding => "application/x-tex"} x^\mu
                (being a
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                %a.existingWikiWord{:href => "/nlab/show/linear+basis"} basis
                1-forms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %msup
                        %mi x
                        %mi μ
                      %mo =
                      %mi d
                      %msup
                        %mi x
                        %mi μ
                    %annotation{:encoding => "application/x-tex"} \mathbf{d}x^\mu = d x^\mu
                (example
                = succeed "):" do
