                %li
                  %p
                    which are
                    %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
                    under the Lie algebra action in that
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
