                          \\widehat{ - i\partial_a f} = k_a \widehat f
                %li
                  %p
                    (interchanging pointwise multiplication with
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/convolution+product"} convolution product
                    = succeed "):" do
                      %a.maruku-ref{:href => "#ConvolutionProductOnSchwartzSpace"}
                  #eq:FourierTransformInterchangesPointwiseProductWithConvolution.maruku-equation
                    %span.maruku-eq-number (128)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
