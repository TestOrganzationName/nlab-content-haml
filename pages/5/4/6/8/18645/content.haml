                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mrow
                              %mi i
                              %mi ℏ
                        %mo{:stretchy => "false"} (
                        %mi g
                        %msub
                          %mi S
                          %mi int
                        %mo +
                        %mi j
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tfrac{1}{i \hbar}(g S_{int} + j A)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is not independent of powers of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                and
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
              %p By definition we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                            %mtd
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi k
                                  %mo ∈
                                  %mi ℕ
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi k
                                  %mo !
                              %mover
                                %mi T
                                %mo ¯
                              %mo{:stretchy => "false"} (
                              %munder
                                %munder
