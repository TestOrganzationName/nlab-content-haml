                    %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
                    couplings
              %p Similarly then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi LocObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ⟨
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"}
                      LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j ] ]\langle g , j \rangle
              %p
                is the subspace of those formal power series that are at least linear in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
                (hence those that vanish if one sets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ,
                      %mi j
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} g,j = 0
                ). Hence every element of this space may be written in the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo =
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi LocObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ⟨
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ⟩
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      O
                      \=
                      g S_{int} + j A
                      \\;\in\;
                      LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j ] ]\langle g , j \rangle
                      \\,,
              %p
                where the notation is to suggest that we will think of the coefficient of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                as an (
                %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"}> adiabatically switched
                )
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                and of the coefficient of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
                as an external
                %a.existingWikiWord{:href => "/nlab/show/source+field"} source field
                (reflected by internal and external vertices, respectively, in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
                %a.maruku-ref{:href => "#VerticesAndFieldSpecies"}
                below).
              %p In particular for
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mi int
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L}_{int}
                      \\;\in\;
                      \\Omega^{p+1,0}_\Sigma(E_{\text{BV-BRST}})[ [ \hbar , g] ]
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                of
                %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+densities"} local Lagrangian densities
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
                Lagrangians, and if
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi sw
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ⟨
                      %mi g
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"}
                      g_{sw}
                      \\;\in\;
                      C^\infty_{cp}(\Sigma) \langle g \rangle
              %p
                is an
                %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
                coupling as before, then the
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TransgressionOfVariationalDifferentialFormsToConfigrationSpaces"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi sw
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mi int
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi Ω
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi cp
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ⟨
                      %mi g
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"}
                      g_{sw} \mathbf{L}_{int}
                      \\;\in\;
                      \\Omega^{p+1,0}_{\Sigma,cp}(E_{\text{BV-BRST}})[ [ \hbar ,g ] ]\langle g \rangle
              %p
                is such an
                %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi τ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mi sw
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mi int
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi LocObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ⟨
                      %mi g
                      %mo{:stretchy => "false"} ⟩
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      g S_{int}
                      \\;=\;
                      \\tau_\Sigma( g_{sw} \mathbf{L}_{int} )
                      \\;\in\;
                      LocObs(E_{\text{BV-BRST}})[ [ \hbar, g] ]\langle g \rangle
                      \\,.
              %p
                We also consider the space of
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
                of the
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
                with formal parameters adjoined
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi mc
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi ℏ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      PolyObs(E_{\text{BV-BRST}})_{mc} ((\hbar)) [ [ g , j] ]
                      \\,,
              %p
                which, in its
                = succeed "-dependent," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℏ
                      %annotation{:encoding => "application/x-tex"} \hbar
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Laurent+series"} Laurent series
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℏ
                      %annotation{:encoding => "application/x-tex"} \hbar
                %a.existingWikiWord{:href => "/nlab/show/negative+number"} negative
                formal powers of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℏ
                      %annotation{:encoding => "application/x-tex"} \hbar
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#PerturbativeSMatrixAndTimeOrderedProducts
              %strong Perturbative S-Matrices
            %p
              We introduce now the
              %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
              for perturbative
              %a.existingWikiWord{:href => "/nlab/show/scattering+matrices"} scattering matrices
              relative to a fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (def.
              %a.maruku-ref{:href => "#VacuumFree"}
              below) according to
              %em
                %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
              (def.
              %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              below). Since the first of these axioms requires the S-matrix to be a formal sum of
              %a.existingWikiWord{:href => "/nlab/show/multilinear+map"} multi-
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/linear+continuous+functionals"} linear continuous functionals
              %em
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              in def.
              %a.maruku-ref{:href => "#TimeOrderedProduct"}
              below. That these latter axioms already imply the former is the statement of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#TimeOrderedProductInducesPerturbativeSMatrix"}
              %a.maruku-ref{:href => "#CausalFactorizationAlreadyImpliesSMatrix"}
              below . Its proof requires a close look at the “
              %a.existingWikiWord{:href => "/nlab/show/reverse-time+ordered+products"}> reverse-time ordered products
              ” for the inverse S-matrix (def.
              %a.maruku-ref{:href => "#ReverseTimeOrderedProduct"}
              below) and their induced reverse-causal factorization (prop.
              %a.maruku-ref{:href => "#ReverseCausalFactorizationOfReverseTimeOrderedProducts"}
              below).
            #LagrangianFieldTheoryPerturbativeScattering.num_defn
              %h6#definition_3 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                  %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
                  –
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo ′
                      %mo ,
                      %msub
                        %mi Δ
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
                be a
                %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
                according to def.
                = succeed "." do
                  %a.maruku-ref{:href => "#VacuumFree"}
              %p
                Then a
                %em
                  perturbative
                  %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                  %a.existingWikiWord{:href => "/nlab/show/renormalization+scheme"} scheme
                for
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
