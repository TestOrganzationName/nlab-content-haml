            #DeterminantViaProductWithTraceReversal.num_prop
              %h6#proposition_6 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski metric
                  in terms of
                  %a.existingWikiWord{:href => "/nlab/show/trace"} trace
                  reversal)
              %p
                In terms of the trace reversal operation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mo ˜
                    %annotation{:encoding => "application/x-tex"} \widetilde{(-)}
                from def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TraceReversal"}
                %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
                operation on
                %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#MatrixNotation"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mo −
                              %mi det
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mi A
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mi A
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \-det(A) &amp; = A \tilde A
                      \\\
                      \&amp; = \tilde A A
                      \\end{aligned}
                      \\,.
              %p
                and the Minkowski inner product from prop.
                %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
                has the alternative expression
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi η
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mo ,
                              %mi B
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 2
                              %mi Re
                              %mo{:stretchy => "false"} (
                              %mi tr
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mover
                                %mi B
                                %mo{:stretchy => "false"} ˜
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 2
                              %mi Re
                              %mo{:stretchy => "false"} (
                              %mi tr
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mi B
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\eta(A,B) &amp; = \tfrac{1}{2}Re(tr(A \tilde B))
                      \\\
                      \&amp; = \tfrac{1}{2} Re(tr(\tilde A B))
                      \\end{aligned}
                      \\,.
            %p
              (
              %a{:href => "geometry+of+physics+--+supersymmetry#BaezHuerta09"}> Baez-Huerta 09, prop. 5
              )
            #SLGrupOnPaulimatrices.num_prop
              %h6#proposition_7 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SL
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{K})
                  acts by linear
                  %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
                  on
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                  )
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mi ℝ
                      %mo ,
                      %mi ℂ
                      %mo ,
                      %mi ℍ
                      %mo ,
                      %mi 𝕆
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{K} \in \{\mathbb{R}, \mathbb{C}, \mathbb{H}, \mathbb{O}\}
                one of the four real
                %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#HurwitzTheorem"}
                %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SL
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{K})
                %a.existingWikiWord{:href => "/nlab/show/action"} acts
                on
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
                in dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 2
                      %mo +
                      %mn 1
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mn 3
                      %mo +
                      %mn 1
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mn 5
                      %mo +
                      %mn 1
                      %mo .
                      %mspace{:width => "thinmathspace"}
                      %mn 9
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} p+1 \in \{2+1, \,3+1, \, 5+1. \, 9+1\}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
                %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
                given under the identification with the
                %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"} Pauli matrices
                in prop./def.
                %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
                by
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi SL
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo ,
                              %mi 𝕂
                              %mo{:stretchy => "false"} )
                              %mo ×
                              %msup
                                %mi ℝ
                                %mrow
                                  %mi dim
                                  %mo{:stretchy => "false"} (
                                  %mi 𝕂
                                  %mo +
                                  %mn 1
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                            %mtd
                              %mi SL
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo ,
                              %mi 𝕂
                              %mo{:stretchy => "false"} )
                              %mo ×
                              %msubsup
                                %mi Mat
                                %mrow
                                  %mn 2
                                  %mo ×
                                  %mn 2
                                %mi herm
                              %mo{:stretchy => "false"} (
                              %mi 𝕂
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                            %mtd
                              %msubsup
                                %mi Mat
                                %mrow
                                  %mn 2
                                  %mo ×
                                  %mn 2
                                %mi herm
                              %mo{:stretchy => "false"} (
                              %mi 𝕂
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                            %mtd
                              %msup
                                %mi ℝ
                                %mrow
                                  %mi dim
                                  %mo{:stretchy => "false"} (
                                  %mi 𝕂
                                  %mo +
                                  %mn 1
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi G
                              %mo ,
                              %mi A
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ↦
                            %mtd
                              %mi G
