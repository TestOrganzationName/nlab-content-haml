                      \\;\colon\;
                      X
                      \\overset{\omega}{\longrightarrow}
                      \\mathbf{\Omega}^k
                      \\overset{d}{\longrightarrow}
                      \\mathbf{\Omega}^{k+1}
                      \\,.
              %p
                Explicitly this means simply that for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi U
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Phi \colon U \to X
                a plot, then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Φ
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mi ω
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi d
                      %mrow
                        %mo (
                        %msup
                          %mi Φ
                          %mo *
                        %mi ω
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi Ω
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Phi^\ast (d\omega)
                      \\;=\;
                      d\left( \Phi^\ast \omega\right)
                      \\;\in\;
                      \\Omega^{k+1}(U)
                      \\,.
            %p
              The usual operations on ordinary
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
              directly generalize plot-wise to differential forms on
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
              and more generally on
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            #ExteriorCalculusOnDiffeologicalSpaces.num_defn
              %h6#definition_5 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/exterior+differential"} exterior differential
                  and
                  %a.existingWikiWord{:href => "/nlab/show/exterior+product"} exterior product
                  on
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DiffeologicalSpace"}
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#SmoothSet"}
              %ol
                %li
                  %p
                    For
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ω
                          %mo ∈
                          %msup
                            %mi Ω
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \omega \in \Omega^n(X)
                    a
                    %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
                    on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#DifferentialFormsOnDiffeologicalSpaces"}
                    %a.existingWikiWord{:href => "/nlab/show/exterior+differential"} exterior differential
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mi ω
                          %mo ∈
                          %msup
                            %mi Ω
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          d \omega \in \Omega^{n+1}(X)
                  %p
                    is defined on any plot
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                          %mover
                            %mo →
                            %mi Φ
                          %mi X
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \overset{\Phi}{\to} X
                    as the ordinary
                    %a.existingWikiWord{:href => "/nlab/show/exterior+differential"} exterior differential
                    of the pullback of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ω
                        %annotation{:encoding => "application/x-tex"} \omega
                    along that plot:
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Φ
                            %mo *
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mi ω
                          %mo{:stretchy => "false"} )
                          %mo ≔
                          %mi d
                          %msup
                            %mi Φ
                            %mo *
                          %mo{:stretchy => "false"} (
                          %mi ω
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          \\Phi^\ast(d \omega) \coloneqq d \Phi^\ast(\omega)
                          \\,.
                %li
                  %p
                    For
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ω
                            %mn 1
                          %mo ∈
                          %msup
                            %mi Ω
                            %mrow
                              %msub
                                %mi n
                                %mn 1
                        %annotation{:encoding => "application/x-tex"} \omega_1 \in \Omega^{n_1}
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ω
                            %mn 2
                          %mo ∈
                          %msup
                            %mi Ω
                            %mrow
                              %msub
                                %mi n
                                %mn 2
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \omega_2 \in \Omega^{n_2}(X)
                    two differential forms on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#DifferentialFormsOnDiffeologicalSpaces"}
                    %a.existingWikiWord{:href => "/nlab/show/exterior+product"} exterior product
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ω
                            %mn 1
                          %mo ∧
                          %msub
                            %mi ω
                            %mn 2
                          %mspace{:width => "thickmathspace"}
                          %mo ∈
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi Ω
                            %mrow
                              %msub
                                %mi n
                                %mn 1
                              %mo +
                              %msub
                                %mi n
                                %mn 2
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          \\omega_1 \wedge \omega_2 \;\in\; \Omega^{n_1 + n_2}(X)
                  %p
                    is the differential form defined on any plot
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                          %mover
                            %mo →
                            %mi Φ
                          %mi X
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \overset{\Phi}{\to} X
                    as the ordinary exterior product of the pullback of th differential forms
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ω
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \omega_1
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ω
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \omega_2
                    to this plot:
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Φ
                            %mo *
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ω
                            %mn 1
                          %mo ∧
                          %msub
                            %mi ω
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi Φ
                            %mo *
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ω
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %msup
                            %mi Φ
                            %mo *
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ω
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          \\Phi^\ast(\omega_1 \wedge \omega_2)
                          \\;\coloneqq\;
                          \\Phi^\ast(\omega_1) \wedge \Phi^\ast(\omega_2)
                          \\,.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#InfinitesimalGeometry
              %strong Infinitesimal geometry
            %p
              It is crucial in
              %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
              that we consider
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              not only over all of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/submanifolds"} submanifolds
              of spacetime. Or rather, what is actually of interest are the restrictions of the field histories to the
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhoods"} infinitesimal neighbourhoods
              (example
              %a.maruku-ref{:href => "#InfinitesimalNeighbourhood"}
              below) of these submanifolds. This appears notably in the construction of
              %em
                %a.existingWikiWord{:href => "/nlab/show/phase+spaces"} phase spaces
              = succeed "." do
                %a{:href => "#PhaseSpace"} below
              %a.existingWikiWord{:href => "/nlab/show/fermion+fields"} fermion fields
              such as the
              %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              (example
              %a.maruku-ref{:href => "#DiracFieldBundle"}
              below) take values in
              %em
                %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
              spaces, called
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+spaces"} super spaces
              (discussed
              = succeed ")." do
                %a{:href => "#Supergeometry"} below
              %em
                %a.existingWikiWord{:href => "/nlab/show/formal+geometry"} formal geometry
              (as in “
              %a.existingWikiWord{:href => "/nlab/show/formal+scheme"}> formal scheme
              ”) or
              %em
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
              or
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+supergeometry"} synthetic differential supergeometry
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
            %p
              In order to mathematically grasp what
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhoods"} infinitesimal neighbourhoods
              are, we appeal to the first magic algebraic property of differential geometry from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#AlgebraicFactsOfDifferentialGeometry"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} dually
              in terms of their
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on them
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi SmoothManifolds
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AAA
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mi Algebras
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C^\infty(-) \;\colon\; SmoothManifolds \overset{\phantom{AAA}}{\hookrightarrow} (\mathbb{R} Algebras)^{op}
                    \\,.
            %p
              But since there are of course more
              %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi ℝ
                    %mi Algebras
                  %annotation{:encoding => "application/x-tex"} A \in \mathbb{R}Algebras
              than arise this way from smooth manifolds, we may turn this around and try to regard any algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as
              %em defining
              a would-be
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/space"} space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
            %p
              For example an
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} infinitesimally thickened point
              should be a space which is “so small” that every smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              on it which vanishes at the origin takes values so tiny that some finite power of them is not just even more tiny, but actually vanishes:
            #InfinitesimallyThickendSmoothManifold.num_defn
              %h6#definition_6 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+smooth+manifold"}> infinitesimally thickened Cartesian space
                  )
              %p
                An
                %em
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} infinitesimally thickened point
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔻
                      %mo ≔
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{D} \coloneqq Spec(A)
              %p
                is represented by a
                %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi ℝ
                      %mi Alg
                    %annotation{:encoding => "application/x-tex"} A \in \mathbb{R}Alg
                which as a
                %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
                is a
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %msub
                        %mo ≃
                        %mi ℝ
                      %mo{:stretchy => "false"} ⟨
                      %mn 1
                      %mo{:stretchy => "false"} ⟩
                      %mo ⊕
                      %mi V
                    %annotation{:encoding => "application/x-tex"}
                      A \simeq_{\mathbb{R}} \langle 1 \rangle \oplus V
              %p
                of the 1-dimensional space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mn 1
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \langle 1 \rangle = \mathbb{R}
                of multiples of 1 with a
                %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional vector space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                that is a
                %a.existingWikiWord{:href => "/nlab/show/nilpotent+ideal"} nilpotent ideal
                in that for each element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} a \in V
                there exists a
                %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi a
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo =
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      a^{n+1} = 0
                      \\,.
              %p
                More generally, an
                %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+manifold"} infinitesimally thickened Cartesian space
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ×
                      %mi 𝔻
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ×
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{R}^n \times \mathbb{D} \;\coloneqq\;  \mathbb{R}^n \times Spec(A)
              %p
                is represented by a
                %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative algebra
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi ℝ
                      %mi Alg
                    %annotation{:encoding => "application/x-tex"}
                      C^\infty(\mathbb{R}^n) \otimes A \;\in\; \mathbb{R} Alg
              %p
                which is the
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+algebras"} tensor product of algebras
                of the algebra of smooth functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^n)
                on an actual
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                of some
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                (example
                = succeed ")," do
                  %a.maruku-ref{:href => "#AlgebraOfSmoothFunctionsOnCartesianSpaces"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %msub
                        %mo ≃
                        %mi ℝ
                      %mo{:stretchy => "false"} ⟨
                      %mn 1
                      %mo{:stretchy => "false"} ⟩
                      %mo ⊕
                      %mi V
                    %annotation{:encoding => "application/x-tex"} A \simeq_{\mathbb{R}} \langle 1\rangle \oplus V
                of an infinitesimally thickened point, as above.
              %p
                We say that a
                %em
                  smooth function between two
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+manifolds"} infinitesimally thickened Cartesian spaces
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ×
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mi f
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo ×
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{R}^{n_1} \times Spec(A_1) \overset{f}{\longrightarrow} \mathbb{R}^{n_2} \times Spec(A_2)
              %p
                is by definition
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} dually
                an
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %msub
                        %mi A
                        %mn 1
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi f
                            %mo *
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %msub
                        %mi A
                        %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      C^\infty(\mathbb{R}^{n_1}) \otimes A_1
                      \\overset{f^\ast}{\longleftarrow}
                      C^\infty(\mathbb{R}^{n_2}) \otimes A_2
                      \\,.
            #InfinitesimalNeighbourhoodsInTheRealLine.num_example
              %h6#example_12 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhoods"} infinitesimal neighbourhoods
                  in the
                  %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
                  )
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/quotient+ring"} quotient algebra
                of the
                %a.existingWikiWord{:href => "/nlab/show/formal+power+series+algebra"} formal power series algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ϵ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}[ [\epsilon] ]
                in a single parameter
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
                by the ideal generated by
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ϵ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \epsilon^2
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ϵ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϵ
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mo ≃
                        %mi ℝ
                      %mspace{:width => "thickmathspace"}
                      %mi ℝ
                      %mo ⊕
                      %mi ϵ
                      %mi ℝ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (\mathbb{R}[ [\epsilon] ])/(\epsilon^2)
                      \\;\simeq_{\mathbb{R}}\;
                      \\mathbb{R} \oplus \epsilon \mathbb{R}
                      \\,.
              %p
                (This is sometimes called the
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/algebra+of+dual+numbers"} algebra of dual numbers
                %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
                of this algebra is, as show, the
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                of the multiples of 1 with the multiples of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} \epsilon
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo +
                      %mi b
                      %mi ϵ
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} [
                      %mi ϵ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϵ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      a + b \epsilon \in (\mathbb{R}[\epsilon])/(\epsilon^2)
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} a,b \in \mathbb{R}
                are
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ϵ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \epsilon^2
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %msub
                          %mi a
                          %mn 1
                        %mo +
                        %msub
                          %mi b
                          %mn 1
                        %mi ϵ
                        %mo )
                      %mo ⋅
                      %mrow
                        %mo (
                        %msub
                          %mi a
                          %mn 2
                        %mo +
                        %msub
                          %mi b
                          %mn 2
                        %mi ϵ
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi a
                        %mn 1
                      %msub
                        %mi a
                        %mn 2
                      %mo +
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 1
                      %msub
                        %mi b
                        %mn 2
                      %mo +
                      %msub
                        %mi b
                        %mn 1
                      %msub
                        %mi a
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mi ϵ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\left(
                      a_1 + b_1 \epsilon
                      \\right)
                      \\cdot
                      \\left(
                      a_2 + b_2 \epsilon
                      \\right)
                      \\;=\;
                      a_1 a_2 + ( a_1 b_2 + b_1 a_2 ) \epsilon
                      \\,.
              %p
                We may think of an element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo +
                      %mi b
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} a + b \epsilon
                as the truncation to first order of a
                %a.existingWikiWord{:href => "/nlab/show/Taylor+series"} Taylor series
                at the origin of a
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                on the
                %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi ℝ
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      f \;\colon\; \mathbb{R} \to \mathbb{R}
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a = f(0)
                is the value of the function at the origin, and where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo =
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi f
                        %mrow
                          %mo ∂
                          %mi x
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b = \frac{\partial f}{\partial x}(0)
                is its first
                %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
                at the origin.
              %p
                Therefore this algebra behaves like the algebra of smooth function on an
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔻
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{D}^1
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} 0 \in \mathbb{R}
                which is so tiny that its
                %a.existingWikiWord{:href => "/nlab/show/generalized+element"} elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %msup
                        %mi 𝔻
                        %mn 1
                      %mo ↪
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{D}^1 \hookrightarrow \mathbb{R}
                become, upon squaring them, not just tinier, but actually zero:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϵ
                        %mn 2
                      %mo =
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\epsilon^2 = 0
                      \\,.
              %p
                This intuitive picture is now made precise by the concept of
                %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
                def.
                = succeed "," do
                  %a.maruku-ref{:href => "#InfinitesimallyThickendSmoothManifold"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔻
                        %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi Spec
                      %mrow
                        %mo (
                        %mi ℝ
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi ϵ
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ϵ
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{D}^1
                      \\;\coloneqq\;
                      Spec\left(
                      \\mathbb{R}[ [\epsilon] ]/(\epsilon^2)
                      \\right)
              %p
                and observe that there is the
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} inclusion
                of infinitesimally thickened Cartesian spaces
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔻
                        %mn 1
                      %mover
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi i
                          %mphantom
                            %mi AA
                      %msup
                        %mi ℝ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{D}^1 \overset{\phantom{AA}i\phantom{AA} }{\hookrightarrow} \mathbb{R}^1
              %p which is dually given by the algebra homomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℝ
                              %mo ⊕
                              %mi ϵ
                              %mi ℝ
                            %mtd
                              %mover
                                %mo ⟵
                                %mrow
                                  %msup
                                    %mi i
                                    %mo *
                            %mtd
                              %msup
                                %mi C
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi ℝ
                                %mn 1
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo +
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi f
                                %mrow
                                  %mo ∂
                                  %mi x
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ⟵
                            %mtd
                              %mo{:stretchy => "false"} {
                              %mi f
                              %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathbb{R} \oplus \epsilon \mathbb{R}
                      \&amp;\overset{i^\ast}{\longleftarrow}&amp;
                      C^\infty(\mathbb{R}^1)
                      \\\
                      f(0) + \frac{\partial f}{\partial x}(0)  &amp;\longleftarrow&amp; \{f\}
                      }
              %p
                which sends a
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                to its value
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(0)
                at zero plus
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
                times its
                %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
                at zero. Observe that this is indeed a
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                of algebras due to the
                %a.existingWikiWord{:href => "/nlab/show/product+law"} product law
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msup
                                %mi i
                                %mo *
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo ⋅
                              %mi g
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo ⋅
                              %mi g
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo +
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi f
                                  %mo ⋅
                                  %mi g
                                %mrow
                                  %mo ∂
                                  %mi x
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mi ϵ
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo ⋅
                              %mi g
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo +
                              %mrow
                                %mo (
                                %mfrac
                                  %mrow
                                    %mo ∂
                                    %mi f
                                  %mrow
                                    %mo ∂
                                    %mi x
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                                %mi g
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mo +
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                                %mfrac
                                  %mrow
                                    %mo ∂
                                    %mi g
                                  %mrow
                                    %mo ∂
                                    %mi x
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mo )
                              %mi ϵ
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mrow
                                %mo (
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mo +
                                %mfrac
                                  %mrow
                                    %mo ∂
                                    %mi f
                                  %mrow
                                    %mo ∂
                                    %mi x
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mi ϵ
                                %mo )
                              %mo ⋅
                              %mrow
                                %mo (
                                %mi g
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mo +
                                %mfrac
                                  %mrow
                                    %mo ∂
                                    %mi g
                                  %mrow
                                    %mo ∂
                                    %mi x
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                                %mi ϵ
                                %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      i^\ast(f \cdot g)
                      \&amp; =
                      (f \cdot g)(0) + \frac{\partial f \cdot g}{\partial x}(0) \epsilon
                      \\\
                      \&amp; =
                      f(0) \cdot g(0)
                      +
                      \\left(
                      \\frac{\partial f}{\partial x}(0) \cdot g(0) +  f(0) \cdot \frac{\partial g}{\partial x}(0)
                      \\right) \epsilon
                      \\\
                      \&amp; =
                      \\left(
                      f(0) + \frac{\partial f}{\partial x}(0) \epsilon
                      \\right)
                      \\cdot
                      \\left(
                      g(0) + \frac{\partial g}{\partial x}(0) \epsilon
                      \\right)
                      \\end{aligned}
              %p
                Hence we see that restricting a smooth function to the infinitesimal neighbourhood of a point is equivalent to restricting attention to its
                %a.existingWikiWord{:href => "/nlab/show/Taylor+series"} Taylor series
                to the given order at that point:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi 𝔻
                                %mn 1
                            %mtd
                              %mover
                                %mo ↪
                                %mi i
                            %mtd
                              %msup
                                %mi ℝ
                                %mn 1
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi ϵ
                                    %mo ↦
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %mn 0
                                    %mo{:stretchy => "false"} )
                                    %mo +
                                    %mfrac
                                      %mrow
                                        %mo ∂
                                        %mi f
                                      %mrow
                                        %mo ∂
                                        %mi x
                                    %mo{:stretchy => "false"} (
                                    %mn 0
                                    %mo{:stretchy => "false"} )
                                    %mi ϵ
                                    %mo{:stretchy => "false"} )
                              %mo ↘
                            %mtd
                              %msub
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi f
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mi ℝ
                                %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathbb{D}^1 &amp;\overset{i}{\hookrightarrow}&amp; \mathbb{R}^1
                      \\\
                      \&amp; {}_{\mathllap{(\epsilon \mapsto f(0) + \frac{\partial f}{\partial x}(0) \epsilon) }}\searrow &amp; \downarrow_{\mathrlap{f}}
                      \\\
                      \&amp;&amp; \mathbb{R}^1
                      }
              %p
                Similarly for each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
                the algebra
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ϵ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϵ
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (\mathbb{R}[ [ \epsilon ] ])/(\epsilon^{k+1})
              %p
                may be thought of as the algebra of
                %a.existingWikiWord{:href => "/nlab/show/Taylor+series"} Taylor series
                at the origin of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                        %mo →
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R} \to \mathbb{R}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                are discarded. The corresponding
                %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} infinitesimally thickened point
                is often denoted
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔻
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi Spec
                      %mrow
                        %mo (
                        %mrow
                          %mo (
                          %mi ℝ
                          %mo{:stretchy => "false"} [
                          %mo{:stretchy => "false"} [
                          %mi ϵ
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ]
                          %mo )
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ϵ
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{D}^1(k) \;\coloneqq\; Spec\left(  \left(\mathbb{R}[ [\epsilon] ]\right)/(\epsilon^{k+1}) \right)
                      \\,.
              %p
                This is now the
                %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
                of the
                %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔻
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ↪
                        %mphantom
                          %mi AAA
                      %msup
                        %mi ℝ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{D}^1(k) \overset{\phantom{AAA}}{\hookrightarrow} \mathbb{R}^1
              %p
                on those elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ϵ
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \epsilon^{k+1} = 0
            %p
              (
              %a{:href => "synthetic+differential+geometry#Kock81"}> Kock 81
              ,
              = succeed ")" do
                %a{:href => "synthetic+differential+geometry#Kock10"} Kock 10
            %p
              The following example
              %a.maruku-ref{:href => "#UniquePointOfInfinitesimalLine"}
              shows that infinitesimal thickening is invisible for ordinary spaces when mapping
              %em out
              of these. In contrast example
              %a.maruku-ref{:href => "#SyntheticTangentVectorFields"}
              further below shows that the morphisms
              %em into
              an ordinary space out of an infinitesimal space are interesting: these are
              %a.existingWikiWord{:href => "/nlab/show/tangent+vectors"} tangent vectors
              and their higher order infinitesimal analogs.
            #UniquePointOfInfinitesimalLine.num_example
              %h6#example_13 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
                  line
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔻
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{D}^1
                  has unique
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/global+point"} global point
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                any ordinary
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %msup
                        %mi ℝ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} D^1(k) \hookrightarrow \mathbb{R}^1
                the order-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
                of the origin in the
                %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
                from example
                = succeed "," do
                  %a.maruku-ref{:href => "#InfinitesimalNeighbourhoodsInTheRealLine"}
                %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+smooth+manifolds"} infinitesimally thickened Cartesian spaces
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                to
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔻
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbb{D}^1(k)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi ℝ
                                %mi n
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo ∃
                                  %mo !
                            %mtd
                              %mn 6
                              %msup
                                %mi 𝔻
                                %mn 1
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∃
                                    %mo !
                              %mo ↘
                            %mtd
                            %mtd
                              %msub
                                %mo ↗
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∃
                                    %mo !
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mi ℝ
                                %mn 0
                              %mo =
                              %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathbb{R}^n &amp;&amp; \overset{\exists !}{\longrightarrow} &amp;6 \mathbb{D}^1(k)
                      \\\
                      \&amp; {}_{\mathllap{\exists !}}\searrow &amp;&amp; \nearrow_{\mathrlap{\exists !}}
                      \\\
                      \&amp;&amp; \mathbb{R}^0 = \ast
                      }
                      \\,.
            .proof
              %h6#proof_2 Proof
              %p
                By definition such a morphism is
                %a.existingWikiWord{:href => "/nlab/show/formal+duality"} dually
                an algebra homomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi f
                            %mo *
                      %mrow
                        %mo (
                        %mi ℝ
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi ϵ
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ϵ
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                        %mo )
                      %msub
                        %mo ≃
                        %mi ℝ
                      %mi ℝ
                      %mo ⊕
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      C^\infty(\mathbb{R}^n)
                      \\overset{f^\ast}{\longleftarrow}
                      \\left(
                      \\mathbb{R}[ [\epsilon] ])/(\epsilon^{k+1}
                      \\right)
                      \\simeq_{\mathbb{R}}
                      \\mathbb{R} \oplus \mathcal{O}(\epsilon)
              %p
                from the higher order “
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+dual+numbers"}> algebra of dual numbers
                ” to the
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                (example
                = succeed ")." do
                  %a.maruku-ref{:href => "#AlgebraOfSmoothFunctionsOnCartesianSpaces"}
              %p
                Now this being an
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} c \in \mathbb{R}
                of the identity is fixed:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      f^\ast(1) = 1
                      \\,.
              %p
                All the remaining elements are proportional to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} \epsilon
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                property of an algebra homomorphism it follows that it must send nilpotent elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
                to nilpotent elements
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi ϵ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f(\epsilon)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                  %mo (
                                  %msup
                                    %mi f
                                    %mo *
                                  %mo{:stretchy => "false"} (
                                  %mi ϵ
                                  %mo{:stretchy => "false"} )
                                  %mo )
                                %mrow
                                  %mi k
                                  %mo +
                                  %mn 1
                            %mtd
                              %mo =
                              %msup
                                %mi f
                                %mo *
                              %mrow
                                %mo (
                                %msup
                                  %mi ϵ
                                  %mrow
                                    %mi k
                                    %mo +
                                    %mn 1
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %msup
                                %mi f
                                %mo *
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\left(f^\ast(\epsilon)\right)^{k+1}
                      \&amp; = f^\ast\left( \epsilon^{k+1}\right)
                      \\\
                      \&amp; = f^\ast(0)
                      \\\ &amp; = 0
                      \\end{aligned}
              %p
                But the only nilpotent element in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^n)
                is the zero element, and hence it follows that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      f^\ast(\epsilon) = 0
                      \\,.
              %p
                Thus
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^\ast
                as above is uniquely fixed.
            #SyntheticTangentVectorFields.num_example
              %h6#example_14 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                be a
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
                %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+smooth+manifold"} infinitesimally thickened Cartesian space
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#InfinitesimallyThickendSmoothManifold"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔻
                        %mn 1
                      %mo ≔
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ϵ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϵ
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{D}^1 \coloneqq Spec( (\mathbb{R}[ [\epsilon] ])/(\epsilon^2) )
                the first order infinitesimal line from example
                = succeed "." do
                  %a.maruku-ref{:href => "#InfinitesimalNeighbourhoodsInTheRealLine"}
              %p
                Then homomorphisms of
                %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+smooth+manifold"} infinitesimally thickened Cartesian spaces
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi ℝ
                                %mi n
                              %mo ×
                              %msup
                                %mi 𝔻
                                %mn 1
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ˜
                            %mtd
                            %mtd
                              %msup
                                %mi ℝ
                                %mi n
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi pr
                                      %mn 1
                              %mo ↘
                            %mtd
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:width => "0"}
                                  %mi id
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mi ℝ
                                %mi n
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathbb{R}^n \times \mathbb{D}^1
                      \&amp;&amp; \overset{\tilde v}{\longrightarrow} &amp;&amp;
                      \\mathbb{R}^n
                      \\\
                      \&amp; {}_{\mathllap{pr_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{id}}
                      \\\
                      \&amp;&amp; \mathbb{R}^n
                      }
              %p
                hence smoothly
                = succeed "-parameterized" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ˜
                        %mi x
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi 𝔻
                        %mn 1
                      %mo ⟶
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"}
                      \\tilde v_x \;\colon\; \mathbb{D}^1 \longrightarrow \mathbb{R}^n
              %p
                which send the unique base point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℜ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝔻
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \Re(\mathbb{D}^1) = \ast
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#UniquePointOfInfinitesimalLine"}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^n
                %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
                with
                %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %msub
                        %mi Γ
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                      %mo{:stretchy => "false"} (
                      %mi T
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} v \in \Gamma_{\mathbb{R}^n}(T \mathbb{R}^n)
                (example
                = succeed ")." do
                  %a.maruku-ref{:href => "#TangentVectorFields"}
            .proof
              %h6#proof_3 Proof
              %p
                By definition, the morphisms in question are
                %a.existingWikiWord{:href => "/nlab/show/formal+duality"} dually
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
                %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %mi ϵ
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⟵
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (C^\infty(\mathbb{R}^n) \oplus \epsilon C^\infty(\mathbb{R}^n))
                      \\longleftarrow
                      C^\infty(\mathbb{R}^n)
              %p
                which are the identity modulo
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} \epsilon
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R}^n)
                to
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mo ∂
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"}
                      f + (\partial f) \epsilon
              %p
                for some smooth function
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ∂
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\partial f) \in C^\infty(\mathbb{R}^n)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 1
                      %mo ,
                      %msub
                        %mi f
                        %mn 2
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f_1,f_2 \in C^\infty(\mathbb{R}^n)
                we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %msub
                        %mi f
                        %mn 2
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mo ∂
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %msub
                        %mi f
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mo ∂
                      %msub
                        %mi f
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 2
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mo ∂
                      %msub
                        %mi f
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (f_1 f_2 + (\partial (f_1 f_2))\epsilon )
                      \\;=\;
                      (f_1 + (\partial f_1) \epsilon)
                      \\cdot
                      (f_2 + (\partial f_2) \epsilon)
                      \\,.
              %p
                Multiplying this out and using that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ϵ
                          %mn 2
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \epsilon^2 = 0
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mn 1
                      %msub
                        %mi f
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo ∂
                      %msub
                        %mi f
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi f
                        %mn 2
                      %mo +
                      %msub
                        %mi f
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mo ∂
                      %msub
                        %mi f
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\partial(f_1 f_2) = (\partial f_1) f_2 + f_1 (\partial f_2)
                      \\,.
              %p
                This in turn means equivalently that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \partial\colon C^\infty(\mathbb{R}^n)\to C^\infty(\mathbb{R}^n)
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              %p
                With this the statement follows with the third magic algebraic property of smooth functions (prop.
                = succeed "):" do
                  %a.maruku-ref{:href => "#AlgebraicFactsOfDifferentialGeometry"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/derivations+of+smooth+functions+are+vector+fields"} derivations of smooth functions are vector fields
            %p
              We need to consider infinitesimally thickened spaces more general than the thickenings of just Cartesian spaces in def.
              = succeed "." do
                %a.maruku-ref{:href => "#InfinitesimallyThickendSmoothManifold"}
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
              and
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SmoothSet"}
            #FormalSmoothSet.num_defn
              %h6#definition_7 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/formal+smooth+set"}> formal smooth set
                  )
              %p
                A
                %em
                  %a.existingWikiWord{:href => "/nlab/show/formal+smooth+set"} formal smooth set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is
              %ol
                %li
                  %p
                    for each
                    %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+smooth+manifold"} infinitesimally thickened Cartesian space
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                          %mo ×
                          %mi Spec
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times Spec(A)
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#InfinitesimallyThickendSmoothManifold"}
                    %a.existingWikiWord{:href => "/nlab/show/set"} set
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mi n
                          %mo ×
                          %mi Spec
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi Set
                        %annotation{:encoding => "application/x-tex"}
                          X(\mathbb{R}^n \times Spec(A)) \in Set
                  %p
                    to be called the set of
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                    or
                    %em plots
                    from
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                          %mo ×
                          %mi Spec
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times Spec(A)
                    to
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X
                %li
                  %p
                    for each
                    %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 1
                          %mo ×
                          %mi Spec
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi A
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ⟶
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 2
                          %mo ×
                          %mi Spec
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi A
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} f \;\colon\; \mathbb{R}^{n_1} \times Spec(A_1) \longrightarrow \mathbb{R}^{n_2} \times Spec(A_2)
                    between
                    %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+smooth+manifold"} infinitesimally thickened Cartesian spaces
                    a choice of function
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi f
                            %mo *
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %mi X
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 2
                          %mo ×
                          %mi Spec
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi A
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
