              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
                  of an
                  %a.existingWikiWord{:href => "/nlab/show/integral"} integral
                  over the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℝ
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R} \to \mathbb{R}
                be a
                %a.existingWikiWord{:href => "/nlab/show/function"} function
                on the
                %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
                such that for every
                %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive real number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
