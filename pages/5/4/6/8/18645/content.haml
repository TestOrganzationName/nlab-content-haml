              %a.maruku-ref{:href => "#SmoothManifoldsAreDiffeologicalSpaces"}
              to smooth geometry with
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimals"} infinitesimals
            #YonedaLemmaForFormalSmoothSets.num_example
