                = succeed ")," do
                  %a.maruku-ref{:href => "#TimeOrderedProductAwayFromDiagonal"}
                %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
                contraction
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
