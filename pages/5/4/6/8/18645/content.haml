                      %semantics
                        %mrow
                          %msubsup
                            %mo ∧
                            %mrow
                              %msup
                                %mi C
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
