              inside the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              %em infinitesimal cotangent bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mi inf
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T^\ast_{inf}(X/\mathfrak{g})
              of the Lie algebroid (def.
              %a.maruku-ref{:href => "#LieAlgebroidInfinitesimalCotangentBundle"}
              ebelow).
            %p
              To motivate the definition
              %a.maruku-ref{:href => "#LieAlgebroidInfinitesimalCotangentBundle"}
              below of
              %em infinitesimal cotangent bundle of a Lie algebroid
              recall from example
              %a.maruku-ref{:href => "#InfinitesimalNeighbourhood"}
              that the
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
              on the infinitesimal cotangent bundle should be fiberwise the
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series+algebra"} formal power series algebra
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/linear+functions"} linear functions
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              is by definition a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
              %a.existingWikiWord{:href => "/nlab/show/derivations+of+smooth+functions+are+vector+fields"} vector fields are equivalently derivations of smooth functions
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#AlgebraicFactsOfDifferentialGeometry"}
            #LieAlgebroidInfinitesimalCotangentBundle.num_defn
              %h6#definition_2 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-Lie+algebra"}> infinitesimal cotangent Lie algebroid
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}
                be a
                %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-algebroid"} Lie ∞-algebroid
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LInfinityAlgebroid"}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %em infinitesimal cotangent bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi T
                        %mi inf
                        %mo *
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} T^\ast_{inf} \mathfrak{a}
                is the
                %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-algebroid"} Lie ∞-algebroid
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                whose underlying
                %a.existingWikiWord{:href => "/nlab/show/graded+module"} graded module
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(X)
                is the
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                of the original module with the
                %a.existingWikiWord{:href => "/nlab/show/derivations"} derivations
                of the graded algebra underlying
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CE(\mathfrak{a})
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi T
                        %mi inf
                        %mo *
                      %mi 𝔞
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mo •
                        %mo *
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
