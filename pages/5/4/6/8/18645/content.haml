                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of the local cotangent Lie ∞-algebroid (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LocalInfinitesimalCotangentLieAlgebroid"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
