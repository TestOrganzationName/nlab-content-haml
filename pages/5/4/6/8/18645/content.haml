                      %msup
                        %mi ϕ
                        %mo *
                      %mi d
                      %msup
                        %mi x
                        %mi i
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mfrac
                        %mrow
                          %mo ∂
                          %msup
                            %mi ϕ
                            %mi i
                        %mrow
                          %mo ∂
                          %msup
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} ˜
                            %mi j
                      %mi d
                      %msup
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ˜
                        %mi j
                    %annotation{:encoding => "application/x-tex"}
                      \\phi^* d  x^i
                      \\;\coloneqq\;
                      \\frac{\partial \phi^i}{\partial \tilde x^j} d \tilde x^j
              %p and then extended linearly by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
