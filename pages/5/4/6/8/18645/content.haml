                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E, \mathbf{L})
                a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                on a
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %p Let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi tra
                      %mover
                        %mo ↪
                        %mi tra
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"}
                      \\Sigma_{tra} \overset{tra}{\hookrightarrow} \Sigma
              %p
                be a
                %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
                %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} with two boundary components
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %msub
                        %mi Σ
                        %mi tra
                      %mo =
                      %msub
                        %mi Σ
                        %mi in
                      %mo ⊔
                      %msub
                        %mi Σ
                        %mi out
                    %annotation{:encoding => "application/x-tex"} \partial \Sigma_{tra} = \Sigma_{in} \sqcup \Sigma_{out}
                , both of which are
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+surfaces"} Cauchy surfaces
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#CauchySurface"}
              %p Then the corresponding inclusion diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi Σ
                                %mi tra
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi in
                              %mo ↗
                            %mtd
                            %mtd
                              %msup
                                %mo ↖
                                %mi{:mathvariant => "normal"} out
                          %mtr
                            %mtd
                              %msub
                                %mi Σ
                                %mi in
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi Σ
                                %mi out
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; \Sigma_{tra}
                      \\\
                      \&amp; {}^{\mathllap{in}}\nearrow &amp;&amp; \nwarrow^{\mathrm{out}}
                      \\\
                      \\Sigma_{in}
                      \&amp;&amp; &amp;&amp;
                      \\Sigma_{out}
                      }
              %p
                induces a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+correspondence"} Lagrangian correspondence
                between the associated
                %a.existingWikiWord{:href => "/nlab/show/phase+spaces"} phase spaces
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#PhaseSpaceAssociatedWithCauchySurface"}
