                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                a smooth
                %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+chain"} singular simplicial chain
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#IntegrationOfDifferentialFormsOverSmoothSingularChainsInCartesianSpaces"}
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber
                %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
                along
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %mi Σ
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi pr
                            %mn 1
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U \times \Sigma \overset{pr_1}{\longrightarrow} U
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#IntegrationOfDifferentialFormsOverSmoothSingularChainsInCartesianSpaces"}
                %a.existingWikiWord{:href => "/nlab/show/exterior+derivative"} exterior derivative
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi U
                    %annotation{:encoding => "application/x-tex"} d_U
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#deRhamDifferential"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi d
                              %msub
                                %mo ∫
                                %mi Σ
                              %mi ω
                            %mtd
                              %mo =
                              %mo{:stretchy => "false"} (
