                %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
                of the
                %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
                on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/vector+potential"} vector potential
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#deRhamDifferential"}
                %a.existingWikiWord{:href => "/nlab/show/vector+potential"} vector potential
                is a
                %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ≔
                      %mi d
                      %mi A
                    %annotation{:encoding => "application/x-tex"}
                      F \coloneqq d A
              %p
                known as the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
              #eq:TensorFaraday.maruku-equation
                %span.maruku-eq-number (20)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi p
                      %msub
                        %mi E
                        %mi i
                      %mi d
                      %msup
                        %mi x
                        %mn 0
                      %mo ∧
                      %mi d
                      %msup
                        %mi x
                        %mi i
                      %mo +
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mn 1
                          %mo ≤
                          %mi i
                          %mo &lt;
                          %mi j
                          %mo ≤
                          %mi p
                      %msub
                        %mi B
                        %mrow
                          %mi i
                          %mi j
                      %mi d
                      %msup
                        %mi x
                        %mi i
                      %mo ∧
                      %mi d
                      %msup
                        %mi x
                        %mi j
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      F
                      \=
                      \\underoverset{i = 1}{p}{\sum}
                      E_i d x^0 \wedge d x^i
                      +
                      \\underset{1 \leq i \lt j \leq p}{\sum}
                      B_{i j} d x^i \wedge d x^j
                      \\,.
              %p
                Here
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mi i
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi p
                    %annotation{:encoding => "application/x-tex"} (E_i)_{i = 1}^p
                are called the components of the
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/electric+field"} electric field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi B
                        %mrow
                          %mi i
                          %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (B_{i j})
                are called the components of the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/magnetic+field"} magnetic field
            #YangMillsFieldOverMinkowski.num_example
              %h6#example_4 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                  for
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills field
                  over
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                be a
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                of
                %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                with
                %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi t
                          %mi α
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (t_\alpha)
                %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
                is given by
              #eq:LieAlgebraStructureConstants.maruku-equation
                %span.maruku-eq-number (21)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi t
                        %mi α
                      %mo ,
                      %msub
                        %mi t
                        %mi β
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi γ
                        %mi γ
                      %msub
                        %mrow
                        %mrow
                          %mi α
                          %mi β
                      %msub
                        %mi t
                        %mi γ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      [t_\alpha, t_\beta]
                      \\;=\;
                      \\gamma^\gamma{}_{\alpha \beta} t_\gamma
                      \\,.
              %p
                Over
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                which is the
                %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensored
                with the
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ≔
                      %msup
                        %mi T
                        %mo *
                      %mi Σ
                      %mo ⊗
                      %mi 𝔤
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      E \coloneqq T^\ast \Sigma \otimes \mathfrak{g}
                      \\,.
              %p
                This is the
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
                %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi a
                        %mi μ
                        %mi α
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      ( a_\mu^\alpha )
                      \\,.
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of this bundle is a
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra-valued+differential+1-form"} Lie algebra-valued differential 1-form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi T
                        %mo *
                      %mi Σ
                      %mo ⊗
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      A \in \Gamma_\Sigma(T^\ast \Sigma \otimes \mathfrak{g}) = \Omega^1(\Sigma, \mathfrak{g})
                      \\,.
              %p with components
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi a
                        %mi μ
                        %mi α
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msubsup
                        %mi A
                        %mi μ
                        %mi α
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      A^\ast(a_\mu^\alpha) = A^\alpha_\mu
                      \\,.
              %p
                This is called a
                %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
                for
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills
                  %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
                (at least if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                is a
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
                %a.maruku-ref{:href => "#YangMillsLagrangian"}
                below).
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                      %mo =
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g} = \mathbb{R}
                is the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/line+Lie+algebra"} line Lie algebra
                %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
                (example
                = succeed ")." do
                  %a.maruku-ref{:href => "#Electromagnetism"}
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                      %mo =
                      %mi 𝔰𝔲
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g} = \mathfrak{su}(3)
                this is a
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
                history for the
                %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
                of the
                %a.existingWikiWord{:href => "/nlab/show/strong+nuclear+force"} strong nuclear force
                in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+chromodynamics"} quantum chromodynamics
            %p
              For readers familiar with the concepts of
              %em
                %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              and
              %em
                %a.existingWikiWord{:href => "/nlab/show/connections+on+a+bundle"} connections on a bundle
              we include the following example
              %a.maruku-ref{:href => "#YangMillsFieldInInstantonSector"}
              which generalizes the
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills field
              over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              from example
              %a.maruku-ref{:href => "#YangMillsFieldOverMinkowski"}
              to the situation over general
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spacetimes"} spacetimes
            #YangMillsFieldInInstantonSector.num_example
              %h6#example_5 Example
              %p
                %strong
                  (general
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills field
                  in fixed
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/instanton"} topological sector
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                be any
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
                and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                be a
                %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
                with
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                denoted
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mover
                        %mo →
                        %mi is
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} P \overset{is}{\to} \Sigma
                be a
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∇
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \nabla_0
                a chosen
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
                on it, to be called the
                %a.existingWikiWord{:href => "/nlab/show/background+field"} background
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills
                field.
              %p
                Then the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
                %em
                  in the
                  %a.existingWikiWord{:href => "/nlab/show/instanton"} topological sector
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                is the
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ≔
                      %mrow
                        %mo (
                        %mi P
                        %msubsup
                          %mo ×
                          %mi G
                          %mi ad
                        %mi 𝔤
                        %mo )
                      %msub
                        %mo ⊗
                        %mi Σ
                      %mrow
                        %mo (
                        %msup
                          %mi T
                          %mo *
                        %mi Σ
                        %mo )
