              %p
                One thinks of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi int
                    %annotation{:encoding => "application/x-tex"} A_{int}
                as the
                %a.existingWikiWord{:href => "/nlab/show/deformation"} deformation
                of the
                %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                as the
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mi int
                    %annotation{:encoding => "application/x-tex"} S_{int}
                is turned on; and speaks of an element of the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/interacting+field+algebra+of+observables"} interacting field algebra of observables
                = succeed "\u201D)" do
                  %a.existingWikiWord{:href => "/nlab/show/expectation+value"} expectation value
                %a.existingWikiWord{:href => "/nlab/show/Hadamard+vacuum+state"} Hadamard vacuum state
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle  -\rangle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#VacuumFree"}
                %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
                in
                %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"} Planck's constant
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
                and in the
                %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in the
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo ⟨
                        %msub
                          %mi A
                          %mi int
                        %mo ⟩
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi ℂ
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      \\left\langle
                      A_{int}
                      \\right\rangle
                      \\;\in\;
                      \\mathbb{C}[ [\hbar, g] ]
              %p
                which express the
                %a.existingWikiWord{:href => "/nlab/show/probability+amplitudes"} probability amplitudes
                that reflect the predictions of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/experiment"} experiment
            %p
              (
              %a{:href => "S-matrix#EpsteinGlaser73"}> Epstein-Glaser 73, around (74)
              ); review includes (
              %a{:href => "S-matrix#DuetschFredenhagen00"}> Dütsch-Fredenhagen 00, around (17)
              ,
              = succeed ")." do
                %a{:href => "pAQFT#Duetsch18"} Dütsch 18, around (3.212)
            #FormalPowerSeriesInteractingFieldObservables.num_example
              %h6#remark_3 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
                  are
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
                in def.
                %a.maruku-ref{:href => "#InteractingFieldObservables"}
                are indeed
                %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
                in the formal parameter
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
                (
                %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"}> Planck's constant
                ), as opposed to being more general
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Laurent+series"} Laurent series
                %a.existingWikiWord{:href => "/nlab/show/negative+number"} negative
                powers of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
                (
                %a{:href => "interacting+field+observable#DuetschFredenhagen00"}> Dütsch-Fredenhagen 00, prop. 2 (ii)
                ,
                = succeed ")." do
                  %a{:href => "interacting+field+observable#HawkinsRejzner16"} Hawkins-Rejzner 16, cor. 5.2
                %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
                the
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                that they are defined from does involve negative powers of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℏ
                      %annotation{:encoding => "application/x-tex"} \hbar
              %p
                It follows in particular that the
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
                have a
                %a.existingWikiWord{:href => "/nlab/show/classical+limit"} classical limit
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℏ
                        %mo →
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \hbar \to 0
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                itself (due to it involving negative powers of
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℏ
                      %annotation{:encoding => "application/x-tex"} \hbar
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
                constitute a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
                of the
                %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
                of the
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting field theory
                (prop.
                %a.maruku-ref{:href => "#InteractingFieldAlgebraOfObservablesIsFormalDeformationQuantization"}
                below) and are thus the more fundamental concept.
            %p
              As the name suggests, the
              %a.existingWikiWord{:href => "/nlab/show/S-matrices"} S-matrices
              in def.
              %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              serve to express
              %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
              (example
              %a.maruku-ref{:href => "#ScatteringAmplitudeFromInteractingFieldObservables"}
              below). But by remark
              %a.maruku-ref{:href => "#FormalPowerSeriesInteractingFieldObservables"}
              the more fundamental concept is that of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
              %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
              requires the following condition on the relation between the
              %a.existingWikiWord{:href => "/nlab/show/vacuum+state"} vacuum state
              and the
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              term:
            #VacuumStability.num_defn
              %h6#definition_6 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/vacuum+stability"}> vacuum stability
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo ′
                      %mo ,
                      %msub
                        %mi Δ
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
                be a
                %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
                according to def.
                = succeed "," do
                  %a.maruku-ref{:href => "#VacuumFree"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
                be a corresponding
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                scheme according to def.
                = succeed "," do
                  %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo ∈
                      %mi LocObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ⟨
                      %mi g
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} g S_{int} \in LocObs(E_{\text{BV-BRST}})[ [ \hbar, g] ]\langle g \rangle
                be a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
                %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              %p
                We say that the given
                %a.existingWikiWord{:href => "/nlab/show/Hadamard+vacuum+state"} Hadamard
                %a.existingWikiWord{:href => "/nlab/show/vacuum+state"} vacuum state
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#WickAlgebraCanonicalState"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi mc
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo ⟶
                      %mi ℂ
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      \\langle - \rangle
                      \\;\colon\;
                      PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar , g, j ] ]
                      \\longrightarrow
                      \\mathbb{C}[ [ \hbar, g, j ] ]
              %p
                is
                %em
                  %a.existingWikiWord{:href => "/nlab/show/vacuum+stability"} stable
                with respect to the
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mi int
                      %annotation{:encoding => "application/x-tex"} S_{int}
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi mc
                      %mo{:stretchy => "false"} [
