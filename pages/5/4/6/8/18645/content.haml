                is the
                %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
                on
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %a.maruku-eqref{:href => "#eq:MinkowskiVolume"} (10)
                and where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                denoted the
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#deRhamDifferential"}
              %p
                This implies by
                %a.existingWikiWord{:href => "/nlab/show/Stokes%27+theorem"} Stokes' theorem
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#StokesTheorem"}
                %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
                that under an
                %a.existingWikiWord{:href => "/nlab/show/integral"} integral
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi P
                        %mo *
