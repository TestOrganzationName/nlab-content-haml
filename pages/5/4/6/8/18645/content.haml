                %a.existingWikiWord{:href => "/nlab/show/regular+observable"} regular
                %a.existingWikiWord{:href => "/nlab/show/linear+observables"} linear observables
                %a.maruku-eqref{:href => "#eq:RegularLinearObservables"} (103)
                is itself an
                %em
