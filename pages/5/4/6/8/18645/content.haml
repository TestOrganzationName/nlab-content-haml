                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Der(CE(\mathfrak{a}))
                being the graded
                %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
                with the differential
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_{CE(\mathfrak{a})}
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CE(\mathfrak{a})
                (which is itself a graded derivation of degree +1):
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi d
