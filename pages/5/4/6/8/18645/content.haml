                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                        %mo ⊗
                        %mi id
                        %mspace{:width => "thickmathspace"}
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Δ
                          %mi H
                        %mrow
                          %mo (
                          %mfrac
                            %mi δ
                            %mrow
                              %mi δ
                              %mstyle{:mathvariant => "bold"}
                                %mi Φ
                          %mo ⊗
                          %mfrac
                            %mi δ
                            %mrow
                              %mi δ
                              %mstyle{:mathvariant => "bold"}
                                %mi Φ
                          %mo )
