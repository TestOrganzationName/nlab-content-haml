                    %th
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mspace{:width => "thinmathspace"}
                          %annotation{:encoding => "application/x-tex"} \,\,
                      %a.existingWikiWord{:href => "/nlab/show/brane+scan"} brane scan
                      entry
                %tbody
                  %tr
                    %td{:style => "text-align: left;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 3
                            %mo =
                            %mn 2
                            %mo +
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} 3 = 2+1
                    %td{:style => "text-align: left;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Spin
                            %mo{:stretchy => "false"} (
