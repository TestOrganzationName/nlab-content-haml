                        %mrow
                          %mi μ
                          %mi ν
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (b_{\mu \nu})
                with
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
