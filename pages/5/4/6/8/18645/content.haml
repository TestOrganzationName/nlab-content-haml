            %p#InfinitesimalSymmetriesOfTheLagrangianDensity
              %strong
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries"} infinitesimal symmetries
                of the
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            #Variation.num_defn
              %h6#definition Definition
              %p
                %strong (variation)
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %p
                A
                %em variation
                is a
                %a.existingWikiWord{:href => "/nlab/show/vertical+vector+field"} vertical vector field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                on the
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+forms"} horizontal differential forms
              %p
                In the special case that the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                is
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                over
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                as in example
                = succeed "," do
                  %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo =
                      %msup
                        %mi v
                        %mi a
                      %msub
                        %mo ∂
                        %mrow
                          %msup
                            %mi ϕ
                            %mi a
                      %mo +
                      %msubsup
                        %mi v
                        %mrow
                          %mo ,
                          %mi μ
                        %mi a
                      %msub
                        %mo ∂
                        %mrow
                          %msubsup
                            %mi ϕ
                            %mrow
                              %mo ,
                              %mi μ
                            %mi a
                      %mo +
                      %msubsup
                        %mi v
                        %mrow
                          %msub
                            %mi μ
                            %mn 1
                          %msub
                            %mi μ
                            %mn 2
                        %mi a
                      %msub
                        %mo ∂
                        %mrow
                          %msubsup
                            %mi ϕ
                            %mrow
                              %msub
                                %mi μ
                                %mn 1
                              %msub
                                %mi μ
                                %mn 2
                            %mi a
                      %mo +
                      %mi ⋯
                    %annotation{:encoding => "application/x-tex"}
                      v = v^a \partial_{\phi^a} + v^a_{,\mu} \partial_{\phi^a_{,\mu}} + v^a_{\mu_1 \mu_2} \partial_{\phi^a_{\mu_1 \mu_2}} + \cdots
            %p
              The concept of variation in def.
              %a.maruku-ref{:href => "#Variation"}
              is very general, in that it allows to vary the field coordinates independently from the corresponding jets. This generality is necessary for discussion of symmetries of
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+currents"} presymplectic currents
              in def.
              %a.maruku-ref{:href => "#HamiltonianForms"}
              below. But for discussion of symmetries of
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
              we are interested in explicitly varying just the
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              coordinates (def.
              %a.maruku-ref{:href => "#EvolutionaryVectorField"}
              below) and inducing from this the corresponding variations of the field derivatives (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
            %p
              In order to motivate the following definition
              %a.maruku-ref{:href => "#EvolutionaryVectorField"}
              of
              %em
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
              we follow remark
              %a.maruku-ref{:href => "#ReplacingBundleMorphismsByDifferentialOperators"}
              saying that concepts in
              %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
              are obtained from their analogous concepts in plain
              %a.existingWikiWord{:href => "/nlab/show/differential+calculus"} differential calculus
              by replacing plain
              %a.existingWikiWord{:href => "/nlab/show/bundle+morphisms"} bundle morphisms
              by morphisms out of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              %em
                %a.existingWikiWord{:href => "/nlab/show/vertical+vector+field"} vertical vector field
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of its
              %a.existingWikiWord{:href => "/nlab/show/vertical+tangent+bundle"} vertical tangent bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi Σ
                    %mi E
                  %annotation{:encoding => "application/x-tex"} T_\Sigma E
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#VerticalTangentBundle"}
              %a.existingWikiWord{:href => "/nlab/show/bundle+morphism"} bundle morphism
              of this form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mtext vertical vector field
                          %mtd
                          %mtd
                            %msub
                              %mi T
                              %mi Σ
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi id
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E &amp;&amp; \overset{\text{vertical vector field}}{\longrightarrow} &amp;&amp; T_\Sigma E
                    \\\
                    \&amp; {}_{\mathllap{id}}\searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; E
                    }
            %p The variational version replaces the vector bundle on the left with its jet bundle:
            #EvolutionaryVectorField.num_defn
              %h6#definition_2 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"}> evolutionary vector fields
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                is “variational vertical vector field” on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                out of the
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msubsup
                                %mi J
                                %mi Σ
                                %mn ∞
                              %mi E
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mi v
                            %mtd
                            %mtd
                              %msub
                                %mi T
                                %mi Σ
                              %mi E
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi jb
                                      %mrow
                                        %mn ∞
                                        %mo ,
                                        %mn 0
                              %mo ↘
                            %mtd
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi E
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      J^\infty_\Sigma E
                      \&amp;&amp; \overset{v}{\longrightarrow} &amp;&amp;
                      T_\Sigma E
                      \\\
                      \&amp; {}_{\mathllap{jb_{\infty,0}}}\searrow &amp;&amp; \swarrow_{\mathllap{}}
                      \\\
                      \&amp;&amp; E
                      }
              %p
                to the
                %a.existingWikiWord{:href => "/nlab/show/vertical+tangent+bundle"} vertical tangent bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi Σ
                      %mi E
                      %mover
                        %mo →
                        %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} T_\Sigma E \overset{}{\to} \Sigma
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#VerticalTangentBundle"}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mover
                          %mo →
                          %mi fb
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              %p
                In the special case that the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                is a
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                over
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                as in example
                = succeed "," do
                  %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
                %a.existingWikiWord{:href => "/nlab/show/tangent+vector+field"} tangent vector field
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#TangentVectorFields"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
                of the special form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi v
                            %mtd
                              %mo =
                              %msup
                                %mi v
                                %mi a
                              %msub
                                %mo ∂
                                %mrow
                                  %msup
                                    %mi ϕ
                                    %mi a
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %msup
                                %mi v
                                %mi a
                              %mrow
                                %mo (
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi x
                                  %mi μ
                                %mo{:stretchy => "false"} )
                                %mo ,
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ϕ
                                  %mi a
                                %mo{:stretchy => "false"} )
                                %mo ,
                                %mo{:stretchy => "false"} (
                                %msubsup
                                  %mi ϕ
                                  %mrow
                                    %mo ,
                                    %mi μ
                                  %mi a
                                %mo{:stretchy => "false"} )
                                %mo ,
                                %mi ⋯
                                %mo )
                              %msub
                                %mo ∂
                                %mrow
                                  %msup
                                    %mi ϕ
                                    %mi a
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      v
                      \&amp; =
                      v^a \partial_{\phi^a}
                      \\\
                      \&amp; =
                      v^a\left(
                      (x^\mu), (\phi^a), (\phi^a_{,\mu}), \cdots
                      \\right) \partial_{\phi^a}
                      \\end{aligned}
                      \\,,
              %p
                where the
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi v
                        %mi a
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} v^a \in C^\infty(J^\infty_\Sigma(E))
                are general
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                on the
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                (while the cmponents are
                %a.existingWikiWord{:href => "/nlab/show/tangent+vectors"} tangent vectors
                along the field coordinates
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ϕ
                          %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\phi^a)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x^\mu)
                and not along the jet coordinates
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi ϕ
                          %mrow
                            %mo ,
                            %msub
                              %mi μ
                              %mn 1
                            %mi ⋯
                            %msub
                              %mi μ
                              %mi k
                          %mi a
                      %annotation{:encoding => "application/x-tex"} \phi^a_{,\mu_1 \cdots \mu_k}
              %p We write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Γ
                        %mi E
                        %mi ev
                      %mrow
                        %mo (
                        %msub
                          %mi T
                          %mi Σ
                        %mi E
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mn 0
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma_E^{ev}\left( T_\Sigma E \right)
                      \\;\in\;
                      \\Omega^{0,0}_\Sigma(E) Mod
              %p
                for the space of evolutionary vector fields, regarded as a
                %a.existingWikiWord{:href => "/nlab/show/module"} module
                over the
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mn 0
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi C
                        %mn ∞
                      %mrow
                        %mo (
                        %msubsup
                          %mi J
                          %mi Σ
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\Omega^{0,0}_\Sigma(E)
                      \\;=\;
                      C^\infty\left( J^\infty_\Sigma(E) \right)
              %p
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                on the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorField"}
              %em depending
              on, possibly, the point in spacetime and the values of the field and all its derivatives (locally to finite order, by prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#JetBundleIsLocallyProManifold"}
            %p
              This induces a corresponding infinitesimal change of the derivatives of the fields, called the
              %em prolongation
              of the evolutionary vector field:
            #EvolutionaryVectorFieldProlongation.num_prop
              %h6#proposition Proposition
              %p
                %strong
                  (prolongation of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              %p
                Given an
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorField"}
                %a.existingWikiWord{:href => "/nlab/show/tangent+vector+field"} tangent vector field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat v
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#TangentVectorFields"}
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                        %annotation{:encoding => "application/x-tex"} \hat v
                    agrees on field coordinates (as opposed to jet coordinates) with
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi v
                          %annotation{:encoding => "application/x-tex"} v
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi jb
                            %mrow
                              %mn ∞
                              %mo ,
                              %mn 0
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo *
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi v
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          (jb_{\infty,0})_\ast(\hat v) = v
                          \\,,
                  %p
                    which means in the special case that
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                          %mover
                            %mo →
                            %mi fb
                          %mi Σ
                        %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                    over
                    %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                    (example
                    = succeed ")" do
                      %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                        %annotation{:encoding => "application/x-tex"} \hat v
                    is of the form
                  #eq:GenericComponentsForProlongationOfEvolutionaryVectorField.maruku-equation
                    %span.maruku-eq-number (74)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %munder
                            %munder
                              %mrow
                                %msup
                                  %mi v
                                  %mi a
                                %msub
                                  %mo ∂
                                  %mrow
                                    %msup
                                      %mi ϕ
                                      %mi a
                              %mo ⏟
                            %mrow
                              %mo =
                              %mi v
                          %mspace{:width => "thinmathspace"}
                          %mo +
                          %mspace{:width => "thinmathspace"}
                          %msubsup
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} ^
                            %mi μ
                            %mi a
                          %msub
                            %mo ∂
                            %mrow
                              %msubsup
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %mi μ
                                %mi a
                          %mo +
                          %msubsup
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} ^
                            %mrow
                              %msub
                                %mi μ
                                %mn 1
                              %msub
                                %mi μ
                                %mn 2
                            %mi a
                          %msub
                            %mo ∂
                            %mrow
                              %msubsup
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %msub
                                    %mi μ
                                    %mn 1
                                  %msub
                                    %mi μ
                                    %mn 2
                                %mi a
                          %mo +
                          %mi ⋯
                        %annotation{:encoding => "application/x-tex"}
                          \\hat v
                          \\;=\;
                          \\underset{
                          \= v
                          }{
                          \\underbrace{
                          v^a \partial_{\phi^a}
                          }}
                          \\,+\,
                          \\hat v^a_{\mu} \partial_{\phi^a_{,\mu}}
                          +
                          \\hat v^a_{\mu_1 \mu_2} \partial_{\phi^a_{,\mu_1 \mu_2}}
                          +
                          \\cdots
                %li
                  %p
                    contraction with
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                        %annotation{:encoding => "application/x-tex"} \hat v
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#ContractionOfFormsWithVectorFields"}
                    %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total spacetime derivative
                    (def.
                    = succeed "):" do
                      %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
                  #eq:ProlongedEvolutionaryVectorFieldContractionAnticommutedWithHorizontalDerivative.maruku-equation
                    %span.maruku-eq-number (75)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ι
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} ^
                          %mo ∘
                          %mi d
                          %mo +
                          %mi d
                          %mo ∘
                          %msub
                            %mi ι
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} ^
                          %mo =
                          %mn 0
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          \\iota_{\hat v} \circ d + d \circ \iota_{\hat v} = 0
                          \\,.
              %p
                In particular
                %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+homotopy+formula"} Cartan's homotopy formula
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CartanHomotopyFormula"}
                %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℒ
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}_{\hat v}
                holds with respect to the
                %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                      %annotation{:encoding => "application/x-tex"} \delta
              #eq:HomotopyFormulaForLieDerivativeAlongProlongationOfEvolutionaryVectorField.maruku-equation
                %span.maruku-eq-number (76)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℒ
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mo =
                      %mi δ
                      %mo ∘
                      %msub
                        %mi ι
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mo +
                      %msub
                        %mi ι
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mo ∘
                      %mi δ
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{L}_{\hat v} = \delta \circ \iota_{\hat v} + \iota_{\hat v} \circ \delta
              %p
                Explicitly, in the special case that the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                is a
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                over
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat v
                is given by
              #eq:ProlongationOfEvolutionaryVectorFieldExplicit.maruku-equation
                %span.maruku-eq-number (77)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mo =
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi n
                          %mo =
                          %mn 0
                        %mn ∞
                      %mfrac
                        %mrow
                          %msup
                            %mi d
                            %mi n
                          %msup
                            %mi v
                            %mi a
                        %mrow
                          %mi d
                          %msup
                            %mi x
                            %mrow
                              %msub
                                %mi μ
                                %mn 1
                          %mi ⋯
                          %mi d
                          %msup
                            %mi x
                            %mrow
                              %msub
                                %mi μ
                                %mi n
                      %msub
                        %mo ∂
                        %mrow
                          %msubsup
                            %mi ϕ
                            %mrow
                              %msub
                                %mi μ
                                %mn 1
                              %mi ⋯
                              %msub
                                %mi μ
                                %mi n
                            %mi a
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\hat v = \underoverset{n = 0}{\infty}{\sum} \frac{d^n v^a}{ d x^{\mu_1} \cdots d x^{\mu_n} } \partial_{\phi^a_{\mu_1 \cdots \mu_n}}
                      \\,.
            .proof
              %h6#proof Proof
              %p
                It is sufficient to prove the coordinate version of the statement. We prove this by
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
                over the maximal jet order
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mrow
                          %msubsup
                            %mi ϕ
                            %mrow
                              %msub
                                %mi μ
                                %mn 1
                              %mi ⋯
                              %msub
                                %mi μ
                                %mi k
                            %mi a
                    %annotation{:encoding => "application/x-tex"} \partial_{\phi^a_{\mu_1 \cdots \mu_k}}
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat v
                is given by the contraction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mi δ
                      %msubsup
                        %mi ϕ
                        %mrow
                          %msub
                            %mi μ
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi μ
                            %mi k
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \iota_{\hat v} \delta \phi^a_{\mu_1 \cdots \mu_k}
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#ContractionOfFormsWithVectorFields"}
              %p
                Similarly (at “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k = -1
                ”) the component of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mrow
                          %msub
                            %mi μ
                            %mn 1
                    %annotation{:encoding => "application/x-tex"} \partial_{\mu_1}
                is given by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ι
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                        %mi d
                        %msup
                          %mi x
                          %mi μ
                      %annotation{:encoding => "application/x-tex"} \iota_{\hat v} d x^{\mu}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi ι
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                              %mi d
                              %msup
                                %mi x
                                %mi μ
                            %mtd
                              %mo =
                              %mi d
                              %msub
                                %mi ι
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                              %msup
                                %mi x
                                %mi μ
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\iota_{\hat v} d x^\mu
                      \&amp; =
                      d \iota_{\hat v} x^\mu
                      \\\
                      \&amp; =
                      0
                      \\end{aligned}
              %p
                Moreover, the coefficient of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mrow
                          %msup
                            %mi ϕ
                            %mi a
                    %annotation{:encoding => "application/x-tex"} \partial_{\phi^a}
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat v
                is fixed by the first condition above to be
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mi δ
                      %msup
                        %mi ϕ
                        %mi a
                      %mo =
                      %msup
                        %mi v
                        %mi a
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\iota_{\hat v} \delta \phi^a
                      \=
                      v^a
                      \\,.
              %p
                This shows the statement for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} k = 0
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mrow
                          %msubsup
                            %mi ϕ
                            %mrow
                              %msub
                                %mi μ
                                %mn 1
                              %mi ⋯
                              %msub
                                %mi μ
                                %mrow
                                  %mi k
                                  %mo +
                                  %mn 1
                            %mi a
                    %annotation{:encoding => "application/x-tex"} \partial_{\phi^a_{\mu_1 \cdots \mu_{k+1}}}
                are fixed by the contractions with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                        %msubsup
                          %mi ϕ
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                            %mi ⋯
                            %msub
                              %mi μ
                              %mi k
                            %msub
                              %mi μ
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                          %mi a
                        %mo ∧
                        %mi d
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi μ
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                      %annotation{:encoding => "application/x-tex"} \delta \phi^a_{\mu_1 \cdots \mu_{k} \mu_{k+1}} \wedge d x^{\mu_{k+1}}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mo ∘
                      %mi d
                      %mo +
                      %mi d
                      %mo ∘
                      %mi δ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \delta \circ d + d \circ \delta = 0
                as well as the induction assumption that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi ι
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                              %mi δ
                              %msubsup
                                %mi ϕ
                                %mrow
                                  %msub
                                    %mi μ
                                    %mn 1
                                  %mi ⋯
                                  %msub
                                    %mi μ
                                    %mrow
                                      %mi k
                                      %mo +
                                      %mn 1
                                %mi a
                              %mo ∧
                              %mi d
                              %msup
                                %mi x
                                %mrow
                                  %msub
                                    %mi μ
                                    %mrow
                                      %mi k
                                      %mo +
                                      %mn 1
                            %mtd
                              %mo =
                              %msub
                                %mi ι
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                              %mi δ
                              %mi d
                              %msubsup
                                %mi ϕ
                                %mrow
                                  %msub
                                    %mi μ
                                    %mn 1
                                  %mi ⋯
                                  %msub
                                    %mi μ
                                    %mi k
                                %mi a
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mi d
                              %msub
                                %mi ι
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                              %mi δ
                              %msubsup
                                %mi ϕ
                                %mrow
                                  %msub
                                    %mi μ
                                    %mn 1
                                  %mi ⋯
                                  %msub
                                    %mi μ
                                    %mi k
                                %mi a
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mi d
                              %mfrac
                                %mrow
                                  %msup
                                    %mi d
                                    %mi k
                                  %msup
                                    %mi v
                                    %mi a
                                %mrow
                                  %mi d
                                  %msup
                                    %mi x
                                    %mrow
                                      %msub
                                        %mi μ
                                        %mn 1
                                  %mi ⋯
                                  %mi d
                                  %msup
                                    %mi x
                                    %mrow
                                      %msub
                                        %mi μ
                                        %mi k
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mfrac
                                %mrow
                                  %msup
                                    %mi d
                                    %mrow
                                      %mi k
                                      %mo +
                                      %mn 1
                                  %msup
                                    %mi v
                                    %mi a
                                %mrow
                                  %mi d
                                  %msup
                                    %mi x
                                    %mrow
                                      %msub
                                        %mi μ
                                        %mn 1
                                  %mi ⋯
                                  %mi d
                                  %msup
                                    %mi x
                                    %mrow
                                      %msub
                                        %mi μ
                                        %mrow
                                          %mi k
                                          %mo +
                                          %mn 1
                              %mi d
                              %msup
                                %mi x
                                %mrow
                                  %msub
                                    %mi μ
                                    %mrow
                                      %mi k
                                      %mo +
                                      %mn 1
                              %mspace{:width => "thinmathspace"}
                              %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\iota_{\hat v} \delta \phi^a_{\mu_1 \cdots \mu_{k+1}} \wedge d x^{\mu_{k+1}}
                      \&amp; =
                      \\iota_{\hat v}  \delta d \phi^a_{\mu_1 \cdots \mu_k}
                      \\\
                      \&amp; =
                      d \iota_{\hat v} \delta \phi^a_{\mu_1 \cdots \mu_k}
                      \\\
                      \&amp;
                      \= d \frac{d^k v^a}{d x^{\mu_1} \cdots d x^{\mu_k}}
                      \\\
                      \&amp; =
                      \\frac{d^{k+1}v^a }{d x^{\mu_1} \cdots d x^{\mu_{k+1}}} d x^{\mu_{k+1}}
                      \\,.
                      \\end{aligned}
              %p
                This shows that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat v
                satisfying the two conditions given exists uniquely.
              %p
                Finally formula
                %a.maruku-eqref{:href => "#eq:HomotopyFormulaForLieDerivativeAlongProlongationOfEvolutionaryVectorField"} (76)
                for the
                %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
                follows from the second of the two conditions with
                %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+homotopy+formula"} Cartan's homotopy formula
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℒ
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mo ∘
                      %msub
                        %mi ι
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mo +
                      %msub
                        %mi ι
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %mo ∘
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}_{\hat v} = \mathbf{d} \circ \iota_{\hat v} + \iota_{\hat v} \circ \mathbf{d}
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CartanHomotopyFormula"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mo =
                      %mi δ
                      %mo +
                      %mi d
                    %annotation{:encoding => "application/x-tex"} \mathbf{d} = \delta + d
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:VariationalDerivative"} (35)
            #EvolutionaryVectorFieldLieAlgebra.num_prop
              %h6#proposition_2 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
                  form a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} v_1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} v_2
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorField"}
                %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
                of
                %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
                of their prolongations
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \hat v_1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \hat v_2
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi v
                            %mn 1
                          %mo ,
                          %msub
                            %mi v
                            %mn 2
                          %mo{:stretchy => "false"} ]
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{[v_1, v_2]}
                of a unique evolutionary vector field
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [v_1,v_2]
              %p
                This defines the structure of a
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                on evolutionary vector fields.
            .proof
              %h6#proof_2 Proof
              %p
                It is clear that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mn 1
                      %mo ,
                      %msub
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mn 2
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\hat v_1, \hat v_2]
                is still
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/vertical+vector+field"} vertical
                = succeed "," do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mrow
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi v
                            %mn 1
                          %mo ,
                          %msub
                            %mi v
                            %mn 2
                          %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \iota_{[v_1, v_2]}
                with this vector field (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ContractionOfFormsWithVectorFields"}
                %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"} horizontal derivative
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi d
                        %mo ,
                        %msub
                          %mi ι
                          %mrow
                            %mo{:stretchy => "false"} [
                            %msub
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                              %mn 1
                            %mo ,
                            %msub
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                              %mn 2
                            %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} [d, \iota_{[\hat v_1, \hat v_2]}] = 0
              %p
                Now
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi d
                      %mo ,
                      %msub
                        %mi ι
                        %mrow
                          %mo{:stretchy => "false"} [
                          %msub
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} ^
                            %mn 1
                          %mo ,
                          %msub
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} ^
                            %mn 2
                          %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [d, \iota_{[\hat v_1, \hat v_2]}]
                is an operator that sends vertical 1-forms to horizontal 1-forms and vanishes on horizontal 1-forms. Therefore it is sufficient to see that this operator in fact also vanishes on all vertical 1-forms. But for this it is sufficient that it commutes with the vertical derivative. This we check by
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cartan+calculus"} Cartan calculus
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi d
                      %mo ,
                      %mi δ
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} [d,\delta] = 0
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi d
                        %mo ,
                        %msub
                          %mi ι
                          %mrow
                            %msub
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                              %mi i
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} [d, \iota_{\hat v_i}]=0
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi δ
                                %mo ,
                                %mo{:stretchy => "false"} [
                                %mi d
                                %mo ,
                                %msub
                                  %mi ι
                                  %mrow
                                    %mo{:stretchy => "false"} [
                                    %msub
                                      %mover
                                        %mi v
                                        %mo{:stretchy => "false"} ^
                                      %mn 1
                                    %mo ,
                                    %msub
                                      %mover
                                        %mi v
                                        %mo{:stretchy => "false"} ^
                                      %mn 2
                                    %mo{:stretchy => "false"} ]
                                %mo{:stretchy => "false"} ]
                                %mo{:stretchy => "false"} ]
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} [
                              %mi d
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mi δ
                              %mo ,
                              %msub
                                %mi ι
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msub
                                    %mover
                                      %mi v
                                      %mo{:stretchy => "false"} ^
                                    %mn 1
                                  %mo ,
                                  %msub
                                    %mover
                                      %mi v
                                      %mo{:stretchy => "false"} ^
                                    %mn 2
                                  %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} [
                              %mi d
                              %mo ,
                              %msub
                                %mi ℒ
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msub
                                    %mover
                                      %mi v
                                      %mo{:stretchy => "false"} ^
                                    %mn 1
                                  %mo ,
                                  %msub
                                    %mover
                                      %mi v
                                      %mo{:stretchy => "false"} ^
                                    %mn 2
                                  %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} [
                              %mi d
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi ℒ
                                %mrow
                                  %msub
                                    %mover
                                      %mi v
                                      %mo{:stretchy => "false"} ^
                                    %mn 1
                              %mo ,
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mover
                                      %mi v
                                      %mo{:stretchy => "false"} ^
                                    %mn 2
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} [
                              %mi d
                              %mo ,
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi δ
                              %mo ,
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mover
                                      %mi v
                                      %mo{:stretchy => "false"} ^
                                    %mn 1
                              %mo{:stretchy => "false"} ]
                              %mo ,
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mover
                                      %mi v
                                      %mo{:stretchy => "false"} ^
                                    %mn 2
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mn 0
                              %mspace{:width => "thinmathspace"}
                              %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      {[ \delta, [ d,\iota_{[\hat v_1, \hat v_2]}] ]}
                      \&amp; =
                      \- [d, [\delta, \iota_{[\hat v_1, \hat v_2]}]]
                      \\\
                      \&amp; =
                      \- [d,  \mathcal{L}_{[\hat v_1, \hat v_2]}]
                      \\\
                      \&amp; =
                      \-[d, [\mathcal{L}_{\hat v_1}, \iota_{\hat v_2}]  ]
                      \\\
                      \&amp; =
                      \- [d, [ [\delta, \iota_{\hat v_1}], \iota_{\hat v_2}  ]]
                      \\\
                      \&amp; =
                      0
                      \\,.
                      \\end{aligned}
            %p
              Now given an evolutionary vector field, we want to consider the
              %a.existingWikiWord{:href => "/nlab/show/flow"} flow
              that it induces on the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            #FlowOfFieldHistoriesAlongEvolutionaryVectorField.num_defn
              %h6#definition_3 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/flow"} flow
                  of
                  %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
                  along
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                be an
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorField"}
                %a.existingWikiWord{:href => "/nlab/show/flow"} flow
                of its prolongation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat v
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\exp(t \hat v)
                      \\;\colon\; J^\infty_\Sigma(E) \longrightarrow J^\infty_\Sigma(E)
              %p
                exists on the
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                (e.g. if the order of derivatives of field coordinates that it depends on is bounded).
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi U
                        %mn 1
                      %mo →
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Phi_{(-)} \colon U_1 \to  \Gamma_\Sigma(E)
                a collection of
                %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
                (hence a plot of the
                %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SupergeometricSpaceOfFieldHistories"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/flow"} flow
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                through
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
                is the
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ×
                      %msup
                        %mi ℝ
                        %mn 1
                      %mover
                        %mo ⟶
                        %mrow
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Φ
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      U_1 \times \mathbb{R}^1
                      \\overset{\exp(v)(\Phi_{(-)})}{\longrightarrow}
                      \\Gamma_\Sigma(E)
              %p
                whose unique factorization
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                        %mo ^
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Φ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \widehat{\exp(v)}(\Phi_{(-)})
                through the space of jets of field histories (i.e. the
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi im
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi j
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} im(j^\infty_\Sigma)
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
                = succeed ")" do
                  %a.maruku-ref{:href => "#JetProlongation"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi im
                              %mo{:stretchy => "false"} (
                              %msubsup
                                %mi j
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ↪
                            %mtd
                              %msub
                                %mi Γ
                                %mi Σ
                              %mo{:stretchy => "false"} (
                              %msubsup
                                %mi J
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mover
                                      %mrow
                                        %mi exp
                                        %mo{:stretchy => "false"} (
                                        %mi v
                                        %mo{:stretchy => "false"} )
                                      %mo ^
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi Φ
                                      %mrow
