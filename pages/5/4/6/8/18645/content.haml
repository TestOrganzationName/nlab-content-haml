                        %mrow
                          %mi j
                        %annotation{:encoding => "application/x-tex"} j
                    (“
                    %a.existingWikiWord{:href => "/nlab/show/source+field"}> source field
                    ”)
              %p
                with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in the
                %a.existingWikiWord{:href => "/nlab/show/topological+vector+spaces"} topological vector spaces
                of the
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                polynomial
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                of the
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
                theory (def.
                = succeed ");" do
                  %a.maruku-ref{:href => "#LocalObservables"}
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
                (def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#MicrocausalObservable"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi mc
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %msub
                            %mi k
                            %mn 1
                          %mo ,
                          %msub
                            %mi k
                            %mn 2
                          %mo ,
                          %msub
                            %mi k
                            %mn 3
                          %mo ∈
                          %mi ℕ
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi mc
                      %mo{:stretchy => "false"} ⟨
                      %msup
                        %mi ℏ
                        %mrow
                          %msub
                            %mi k
                            %mn 1
                      %msup
                        %mi g
                        %mrow
                          %msub
                            %mi k
                            %mn 2
                      %msup
                        %mi j
                        %mrow
                          %msup
                            %mi k
                            %mn 3
                      %mo{:stretchy => "false"} ⟩
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j ] ]
                      \\;\coloneqq\;
                      \\underset{ k_1, k_2, k_3 \in \mathbb{N}}{\prod}
                      PolyObs(E_{\text{BV-BRST}})_{mc}\langle \hbar^{k_1} g^{k_2} j^{k^3}\rangle
                      \\,.
              %p Similary
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi LocObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mphantom
                        %mi AAA
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      LocObs(E_{\text{BV-BRST}})[ [ \hbar, g  ] ]
                      \\,,
                      \\phantom{AAA}
                      PolyObs(E_{\text{BV-BRST}})[ [ \hbar, g  ] ]
              %p
                denotes the subspace for which no powers of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
                appear, etc.
              %p Accordingly
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ⟨
                      %mi g
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"}
                      C^\infty_{cp}(\Sigma) \langle g \rangle
              %p
                denotes the vector space of
                %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
                on
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                tensored with the vector space spanned by a single copy of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi sw
                      %mo ∈
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ⟨
                      %mi g
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"}
