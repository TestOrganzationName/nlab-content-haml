                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      A_1 \star_F A_2
                      \\;
                      \\coloneqq
                      \\;
                      ((-)\cdot(-))
                      \\circ
                      \\exp\left(
                      \\underset{\Sigma \times \Sigma}{\int}
                      \\Delta_F^{a b}(x,y)
                      \\frac{\delta}{\delta \mathbf{\Phi}^a(x)}
                      \\otimes
