                              %mspace{:width => "thickmathspace"}
                              %msup
                                %mi 𝔤
                                %mo *
                              %mo ∧
                              %msup
                                %mi 𝔤
                                %mo *
                              %mspace{:width => "thinmathspace"}
                              %mo .
                            %annotation{:encoding => "application/x-tex"}
                              d_{CE} \omega \coloneqq \omega([-,-]) \;\in \; \mathfrak{g}^\ast \wedge \mathfrak{g}^\ast
                              \\,.
              %p In components:
              %p
                Assume that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X = \mathbb{R}^n
                is a
                %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
                with
                %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϕ
                        %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\phi^a)
                and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi c
                        %mi α
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{c_\alpha\}
                be a
                %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                with dual basis
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi c
                        %mi α
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (c^\alpha)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast
                and structure constants
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi γ
                        %mi α
                      %mo{:stretchy => "false"} )
                      %msub
                        %mrow
                        %mrow
                          %mi β
                          %mi γ
                    %annotation{:encoding => "application/x-tex"} (\gamma^\alpha){}_{\beta \gamma}
                as in prop.
                %a.maruku-ref{:href => "#LieAlgebraInTermsOfChevalleyEilenbergAlgebra"}
                and with the Lie action given in components
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi R
                        %mi α
                        %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (R_\alpha^a)
                as in def.
                = succeed "." do
                  %a.maruku-ref{:href => "#InfinitesimalActionByLieAlgebra"}
                %a.existingWikiWord{:href => "/nlab/show/differential"} differential
                is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi d
                                %mrow
                                  %mi CE
                                  %mo{:stretchy => "false"} (
                                  %mi X
                                  %mo{:stretchy => "false"} /
                                  %mi 𝔤
                                  %mo{:stretchy => "false"} )
                              %msup
                                %mi c
                                %mi α
                            %mtd
                              %mo =
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 2
                              %msup
                                %mi γ
                                %mi α
                              %msub
                                %mrow
                                %mrow
                                  %mi β
                                  %mi γ
                              %mspace{:width => "thinmathspace"}
                              %msup
                                %mi c
                                %mi β
                              %mo ∧
                              %msup
                                %mi c
                                %mi γ
                          %mtr
                            %mtd
                              %msub
                                %mi d
                                %mrow
                                  %mi CE
                                  %mo{:stretchy => "false"} (
                                  %mi X
                                  %mo{:stretchy => "false"} /
                                  %mi 𝔤
                                  %mo{:stretchy => "false"} )
                              %msup
                                %mi ϕ
                                %mi a
                            %mtd
                              %mo =
                              %msubsup
                                %mi R
                                %mi α
                                %mi a
                              %msup
                                %mi c
                                %mi α
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      d_{CE(X/\mathfrak{g})} c^\alpha &amp; = \tfrac{1}{2} \gamma^\alpha{}_{\beta \gamma} \, c^\beta \wedge c^\gamma
                      \\\
                      d_{CE(X/\mathfrak{g})} \phi^a &amp; = R^a_\alpha c^\alpha
                      \\end{aligned}
              %p
                We may summarize this by writing the
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} /
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_{CE(X/\mathfrak{g})}
                as follows:
              #eq:DifferentialOnActionLieAlgebroid.maruku-equation
                %span.maruku-eq-number (171)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} /
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi c
                        %mi α
                      %msubsup
                        %mi R
                        %mi α
                        %mi a
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %msup
                            %mi ϕ
                            %mi a
                      %mspace{:width => "thickmathspace"}
                      %mo +
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msup
                        %mi γ
                        %mi α
                      %msub
                        %mrow
                        %mrow
                          %mi β
                          %mi γ
                      %msup
                        %mi c
                        %mi β
                      %msup
                        %mi c
                        %mi γ
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %msup
                            %mi c
                            %mi α
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d_{CE(X/\mathfrak{g})}
                      \\;=\;
                      c^\alpha R_\alpha^a \frac{\partial}{\partial \phi^a}
                      \\;+\;
                      \\tfrac{1}{2} \gamma^{\alpha}{}_{\beta \gamma} c^\beta c^\gamma \frac{\partial}{\partial c^\alpha}
                      \\,.
              %p That this squares to zero is equivalently
              %ul
                %li
                  %p
                    in degree 0 the
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} action property
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} [
                          %mi t
                          %mo ,
                          %mi t
                          %mo ′
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} [
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \rho([t, t']) = [\rho(t), \rho(t')]
                %li
                  %p
                    in degree 1 the
                    %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
                    = succeed "." do
                      %a.maruku-eqref{:href => "#eq:JacobiIdentity"} (169)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} /
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo =
                      %mn 0
                      %mphantom
                        %mi AAA
                      %mo ⇔
                      %mphantom
                        %mi AAA
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mphantom
                                %mi and
                              %mspace{:width => "thinmathspace"}
                              %mtext Jacobi identity
                          %mtr
                            %mtd
                              %mtext and
                              %mspace{:width => "thinmathspace"}
                              %mtext action property
                    %annotation{:encoding => "application/x-tex"}
                      (d_{CE(X/\mathfrak{g})})^2 = 0
                      \\phantom{AAA}
                      \\Leftrightarrow
                      \\phantom{AAA}
                      \\array{
                      \\phantom{and} \, \text{Jacobi identity}
                      \\\
                      \\text{and} \, \text{action property}
                      }
              %p
                Hence as before in prop.
                %a.maruku-ref{:href => "#LieAlgebraInTermsOfChevalleyEilenbergAlgebra"}
                the
                %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} Lie theoretic
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                is faithfully captured dually by
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebra"} differential graded-commutative superalgebra
              %p
                We call the
                %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formal dual
                of this dgc-superalgebra the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} X/\mathfrak{g}
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                acting on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %p The concept emerging by this example we may consider generally:
            #LInfinityAlgebroid.num_defn
              %h6#definition_7 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"}> super
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-algebroid"}> Lie ∞-algebroid
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperSmoothManifolds"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
                = succeed ")" do
                  %a.maruku-ref{:href => "#SuperCartesianSpace"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(X)
                for its
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
                %em
                  connected
                  %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"} super
                  %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-algebroid"} Lie ∞-algebroid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                of
                %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
                is a
              %ol
                %li
                  %p
                    a sequence
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi 𝔞
                            %mi k
                          %msubsup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi k
                              %mo =
                              %mn 1
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} (\mathfrak{a}_k)_{ k = 1 }^\infty
                    of
                    %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
                    of
                    %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
                    %a.existingWikiWord{:href => "/nlab/show/rank"} rank
                    over
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} C^\infty(X)
                    %a.existingWikiWord{:href => "/nlab/show/graded+module"} graded module
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝔞
                            %mo •
                        %annotation{:encoding => "application/x-tex"} \mathfrak{a}_\bullet
                    in degrees
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi k
                            %mo ∈
                            %mi ℕ
                          %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo ≥
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} k \geq 1
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/differential"} differential
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi d
                            %mi CE
                        %annotation{:encoding => "application/x-tex"} d_{CE}
                    that makes the
                    %a.existingWikiWord{:href => "/nlab/show/graded-commutative+algebra"} graded-commutative algebra
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Sym
                            %mrow
                              %msup
                                %mi C
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi 𝔞
                            %mo •
                            %mo *
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Sym_{C^\infty(X)}(\mathfrak{a}^\ast_\bullet)
                    into a cochain
                    %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
                    (hence with
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi d
                            %mi CE
                        %annotation{:encoding => "application/x-tex"} d_{CE}
                    of degree +1) over
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                    (not necessarily over
                    = succeed ")," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} C^\infty(X)
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                    of
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝔞
                          %annotation{:encoding => "application/x-tex"} \mathfrak{a}
                  #eq:CEAlgebra.maruku-equation
                    %span.maruku-eq-number (172)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mrow
                            %mo (
                            %msub
                              %mi Sym
                              %mrow
                                %msup
                                  %mi C
                                  %mn ∞
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi 𝔞
                              %mo •
                              %mo *
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi d
                              %mi CE
                            %mo )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          CE(\mathfrak{a})
                          \\;\coloneqq\;
                          \\left(
                          Sym_{C^\infty(X)}(\mathfrak{a}^\ast_\bullet)
                          \\,,\,
                          d_{CE}
                          \\right)
                          \\,.
              %p
                If we allow
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔞
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}_\bullet
                to also have terms in non-positive degree, then we speak of a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/derived+Lie+algebroid"} derived Lie algebroid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔞
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}_\bullet
                is
                %em only
                concentrated in negative degrees, we also speak of a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/derived+manifold"} derived manifold
              %p
                With
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(X)
                canonically itself regarded as a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebra"} differential graded-commutative superalgebra
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      CE(\mathfrak{a}) \longrightarrow C^\infty(X)
              %p
                which is the identity on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(X)
                and zero on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi 𝔞
                          %mrow
                            %mo ≠
                            %mn 0
                          %mo *
                      %annotation{:encoding => "application/x-tex"} \mathfrak{a}^\ast_{\neq 0}
            %p
              (We discuss
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              between
              %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-algebroid"} Lie ∞-algebroid
              below in def.
              = succeed ".)" do
                %a.maruku-ref{:href => "#HomomorphismBetweenLieAlgebroids"}
            #dgManifolds.num_remark
              %h6#remark_3 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
                  as
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/differential+graded+manifolds"} differential graded manifolds
              %p
                Definition
                %a.maruku-ref{:href => "#LInfinityAlgebroid"}
                of
                %em
                  %a.existingWikiWord{:href => "/nlab/show/derived+Lie+algebroids"} derived Lie algebroids
                is an encoding in
                %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
                (
                %a.existingWikiWord{:href => "/nlab/show/homological+algebra"}> homological algebra
                , in this case) of a situation that is usefully thought of in terms of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
              %p
                To see this, recall the magic algebraic properties of ordinary
                %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#AlgebraicFactsOfDifferentialGeometry"}
              %ol
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds+into+formal+duals+of+R-algebras"}> embedding of smooth manifolds into formal duals of R-algebras
                    ;
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/smooth+Serre-Swan+theorem"} embedding of smooth vector bundles into formal duals of modules
              %p
                Together these imply that we may think of the
                %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
                underlying a
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                as being the
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
                on a
                %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded manifold
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ⋯
                      %mo ×
                      %msub
                        %mi 𝔞
                        %mn 2
                      %mo ×
                      %msub
                        %mi 𝔞
                        %mn 1
                      %mo ×
                      %mi X
                      %mo ×
                      %msub
                        %mi 𝔞
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ×
                      %mi ⋯
                    %annotation{:encoding => "application/x-tex"}
                      \\cdots \times \mathfrak{a}_2 \times \mathfrak{a}_1 \times X \times \mathfrak{a}_{-1} \times \cdots
              %p
                which is
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
                in non-vanishing degree.
              %p
                The “higher” in
                %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
                refers to the degrees higher than zero. See at
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Higher+Structures"} Higher Structures
                for exposition. Specifically if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔞
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathfrak{a}_\bullet
                has components in negative degrees, these are also called
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/derived+manifolds"} derived manifolds
            #BasicExamplesOfLieAlgebroids.num_example
              %h6#example_8 Example
              %p
                %strong
                  (basic examples of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
              %p
                Two basic examples of
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
                are:
              %ol
                %li
                  %p
                    For
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                    any
                    %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
                    (def.
                    = succeed ")," do
                      %a.maruku-ref{:href => "#SuperSmoothManifolds"}
                    %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#SuperCartesianSpace"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝔞
                            %mrow
                              %mo ≠
                              %mn 0
                          %mo ≔
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \mathfrak{a}_{\neq 0 } \coloneqq 0
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi d
                            %mi CE
                          %mo ≔
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} d_{CE} \coloneqq 0
                    makes it a Lie algebroid in the sense of def.
                    = succeed "." do
                      %a.maruku-ref{:href => "#LInfinityAlgebroid"}
                %li
                  %p
                    For
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                    a
                    %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
                    %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                    (prop.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#LieAlgebraInTermsOfChevalleyEilenbergAlgebra"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
                    exhibits
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                    as a
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                    in the sense of def.
                    = succeed "." do
                      %a.maruku-ref{:href => "#LInfinityAlgebroid"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} B\mathfrak{g}
                    or
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \ast/\mathfrak{g}
                    for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                    regarded as a
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                    this way.
                %li
                  %p
                    For
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                    as in the previous items, and for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                          %mo{:lspace => "verythinmathspace"} :
                          %mi 𝔤
                          %mo ×
                          %mi X
                          %mo →
                          %mi T
                          %mi X
                        %annotation{:encoding => "application/x-tex"} R \colon \mathfrak{g} \times X \to T X
                    a
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#InfinitesimalActionByLieAlgebra"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                    on
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} /
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} CE(X/\mathfrak{g})
                    from def.
                    %a.maruku-ref{:href => "#ActionLieAlgebroid"}
                    defines a
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                    in the sense of def.
                    = succeed "," do
                      %a.maruku-ref{:href => "#LInfinityAlgebroid"}
                    = succeed "." do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
                  %p
                    In the special case that
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g} = 0
                    this reduces to the first example, while for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo =
                          %mo *
                        %annotation{:encoding => "application/x-tex"} X = \ast
                    this reduces to the second example.
            %p
              Here is another basic examples of
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
              that will plays a role:
            #HorizontalTangentLieAlgebroid.num_example
              %h6#example_9 Example
              %p
                %strong
                  (horizontal
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                or more generally a
                %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
                or more generally a
                %a.existingWikiWord{:href => "/nlab/show/locally+pro-manifold"} locally pro-manifold
                (prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#JetBundleIsLocallyProManifold"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo{:stretchy => "false"} /
                      %mi T
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma/T\Sigma
                for the
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and whose
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                is generated over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(X)
                in degree 1 from the
                %a.existingWikiWord{:href => "/nlab/show/module"} module
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝔞
                        %mn 1
                        %mo *
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo ≃
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi T
                        %mo *
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathfrak{a}_1^\ast \coloneqq (\Gamma(T \Sigma))^\ast \simeq\Gamma(T^\ast \Sigma) = \Omega^1(\Sigma)
              %p
                of
                %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
                and whose
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+differential"} Chevalley-Eilenberg differential
                is the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                is the
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+dg-algebra"} de Rham dg-algebra
                of
                %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#deRhamAlgebraOfSuperDifferentialFormsIsDifferentialGradedCommutativeSuperalgebra"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} /
                      %mi T
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi d
                        %mi dR
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      CE( \Sigma/T\Sigma ) \coloneqq (\Omega^\bullet(\Sigma), d_{dR})
                      \\,.
              %p
                This is called the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded manifold
                (via remark
                = succeed ")" do
                  %a.maruku-ref{:href => "#dgManifolds"}
                = succeed "\u201D" do
                  %a.existingWikiWord{:href => "/nlab/show/shifted+tangent+bundle"} shifted tangent bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} T[1] \Sigma
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              %p
                More generally, let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
                over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi T
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)/T\Sigma
                over the
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                being the
                %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"} horizontal
                part of the
                %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} variational bicomplex
                (def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                      %mrow
                        %mo (
                        %msubsup
                          %mi J
                          %mi Σ
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi T
                        %mi Σ
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %msubsup
                          %mi Ω
                          %mi Σ
                          %mrow
                            %mo •
                            %mo ,
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi d
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      CE\left(
                      J^\infty_\Sigma(E)/T\Sigma
                      \\right)
                      \\;\coloneqq\;
                      \\left(\Omega^{\bullet,0}_\Sigma(E), d\right)
                      \\,.
              %p
                The underlying
                %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded manifold
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi T
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)/T\Sigma
                is the
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mi Σ
                      %mi T
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)\times_\Sigma T[1]\Sigma
                of the
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                with the
                %a.existingWikiWord{:href => "/nlab/show/shifted+tangent+bundle"} shifted tangent bundle
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
              %p
                There is then a canonical homomorphism of Lie algebroids (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#HomomorphismBetweenLieAlgebroids"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msubsup
                                %mi J
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mi T
                              %mi Σ
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi Σ
                              %mo{:stretchy => "false"} /
                              %mi T
                              %mi Σ
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      J^\infty_\Sigma(E)/T\Sigma
                      \\\
                      \\downarrow
                      \\\
                      \\Sigma/T\Sigma
                      }
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#BRSTComplex
              %strong
                %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
            %p
              With the general concept of
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InfinitesimalActionByLieAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroids"} action Lie algebroids
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ActionLieAlgebroid"}
              %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-algebroids"} Lie ∞-algebroids
              in hand (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LInfinityAlgebroid"}
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParameters"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/local+field+theory"} locally
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of the resulting
              %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ActionLieAlgebroid"}
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local
                  %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
              %a.maruku-ref{:href => "#LocalOffShellBRSTComplex"}
              below.
            %p
              The
              = succeed "-perspective" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST formalism
              has been made explicit in (
              %a{:href => "BRST+complex#Barnich10"}> Barnich 10
              ).
            #GaugeParametersClosed.num_defn
              %h6#definition_8 Definition
              %p
                %strong
                  (closed
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                be a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
                bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mover
                        %mo →
                        %mi gb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\to} \Sigma
                parameterizing
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#GaugeParameters"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %msub
                        %mo ×
                        %mi Σ
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mi R
                      %msub
                        %mi T
                        %mi Σ
                      %mi E
                    %annotation{:encoding => "application/x-tex"}
                      J^\infty_\Sigma(\mathcal{G} \times_\Sigma E) \overset{R}{\longrightarrow} T_\Sigma E
              %p
                is called
                %em closed
                if it is closed under the
                %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
                of
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldLieAlgebra"}
              #eq:ClosedGaugeParametersBracket.maruku-equation
                %span.maruku-eq-number (173)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi 𝒢
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %msub
                        %mo ×
                        %mi Σ
                      %mi 𝒢
                      %msub
                        %mo ×
                        %mi Σ
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %msub
                        %mo ×
                        %mi Σ
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      [-,-]_{\mathcal{G}}
                      \\;\colon\;
                      J^\infty_\Sigma( \mathcal{G} \times_\Sigma \mathcal{G} \times_\Sigma E )
                      \\longrightarrow
                      J^\infty_\Sigma(\mathcal{G} \times_\Sigma E)
              %p such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo [
                        %mi R
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi R
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ]
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\left[ R(-) , R(-)\right]
                      \\;=\;
                      R([-,-]_{\mathcal{G}})
                      \\,,
              %p
                where on the left we have the Lie bracket of
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
                from prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldLieAlgebra"}
              %p
                Beware that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} [-,-]_{\mathcal{G}}
                may be a function of the fields, namely of the
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                of the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} [-,-]_{\mathcal{G}}
                in general defines a
                = succeed "-structure" do
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                = succeed ")." do
                  %a.maruku-ref{:href => "#LInfinityAlgebroid"}
              %p
                Notice that the collection of all
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries+of+the+Lagrangian"} infinitesimal symmetries of the Lagrangian
                by necessity always forms a (very large)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
                is a condition on the
                %em choice
                of parameterization of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
                = succeed "." do
                  %a.maruku-ref{:href => "#GeneratingSetOfGaugeTransformations"}
            %p
              (
              %a{:href => "BRST+complex#Henneaux90"}> Henneaux 90, section 2.9
              )
            %p
              Recall the general concept of a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#InfinitesimalActionByLieAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            #ActionOfGaugeParameterizedInfinitesimalGaugeSymmetriesOnJetBundle.num_example
              %h6#example_10 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
                  of closed
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
                  on
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                be a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mover
                        %mo →
                        %mi gb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\to} \Sigma
                be a bundle of
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#GaugeParameters"}
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %msub
                        %mo ×
                        %mi Σ
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mi R
                      %msub
                        %mi T
                        %mi Σ
                      %mi E
                    %annotation{:encoding => "application/x-tex"}
                      J^\infty_\Sigma(\mathcal{G} \times_\Sigma E)
                      \\overset{R}{\longrightarrow}
                      T_\Sigma E
              %p
                which are closed (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#GaugeParametersClosed"}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi 𝒢
                      %annotation{:encoding => "application/x-tex"} [-,-]_{\mathcal{G}}
              %p
                By passing from these
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorField"}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi R
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat{R}
                = succeed ")," do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msubsup
                                %mi J
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi 𝒢
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo ×
                                %mi Σ
                              %msubsup
                                %mi J
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mover
                                  %mrow
                                    %mi R
                                    %mo{:stretchy => "false"} (
                                    %mi e
                                    %mo{:stretchy => "false"} )
                                  %mo ^
                            %mtd
                            %mtd
                              %msub
                                %mi T
                                %mi Σ
                              %msubsup
                                %mi J
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ↘
                            %mtd
                            %mtd
                              %mo ↙
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msubsup
                                %mi J
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      J^\infty_\Sigma(\mathcal{G}) \times_\Sigma J^\infty_\Sigma (E)
                      \&amp;&amp; \overset{\widehat{R(e)}}{\longrightarrow} &amp;&amp;
                      T_\Sigma J^\infty_\Sigma(E)
                      \\\
                      \&amp; \searrow &amp;&amp; \swarrow
                      \\\
                      \&amp;&amp; J^\infty_\Sigma(E)
                      }
              %p
                and via the assumed bracket
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} [-,-]_{\mathcal{G}}
                on
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
                this exhibits
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                structure on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi J
                          %mi Σ
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi 𝒢
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ×
                          %mi Σ
                        %msubsup
                          %mi J
                          %mi Σ
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi pr
                              %mn 2
                        %msubsup
                          %mi J
                          %mi Σ
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(\mathcal{G}) \times_\Sigma J^\infty_\Sigma(E) \overset{pr_2}{\to} J^\infty_\Sigma(E)
              %p
                In the case that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mo =
                      %mi 𝔤
                      %mo ×
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} = \mathfrak{g} \times \Sigma
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo ×
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi 𝔤
                        %mn ∞
                      %mo ×
                      %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      J^\infty_\Sigma(\mathfrak{g} \times \Sigma) = \mathfrak{g}^\infty \times \Sigma
                      \\,.
              %p
                If moreover the bracket
                %a.maruku-eqref{:href => "#eq:ClosedGaugeParametersBracket"} (173)
                on the
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
                is independent of the fields, then this induces a
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                structure on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔤
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\infty
                and exhibits an
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi 𝔤
                                %mn ∞
                              %mo ×
                              %msubsup
                                %mi J
                                %mi Σ
                                %mn ∞
                              %mi E
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mover
                                  %mrow
                                    %mi R
                                    %mo{:stretchy => "false"} (
                                    %mi e
                                    %mo{:stretchy => "false"} )
                                  %mo ^
                            %mtd
                            %mtd
                              %msub
                                %mi T
                                %mi Σ
                              %msubsup
                                %mi J
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ↘
                            %mtd
                            %mtd
                              %mo ↙
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msubsup
                                %mi J
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathfrak{g}^\infty \times J^\infty_\Sigma E
                      \&amp;&amp; \overset{\widehat{R(e)}}{\longrightarrow} &amp;&amp;
                      T_\Sigma J^\infty_\Sigma(E)
                      \\\
                      \&amp; \searrow &amp;&amp; \swarrow
                      \\\
                      \&amp;&amp; J^\infty_\Sigma(E)
                      }
                      \\,.
              %p
                of the
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameterized
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
                on the
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                of the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                by
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
            #LocalOffShellBRSTComplex.num_example
              %h6#example_11 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local
                  %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
                  and
                  %a.existingWikiWord{:href => "/nlab/show/ghost+fields"} ghost fields
                  for closed
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                be a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mover
                        %mo ⟶
                        %mi gb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\longrightarrow} \Sigma
                be a bundle of irreducible closed
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
                for the theory (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msubsup
                                %mi J
                                %mi Σ
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi 𝒢
                              %msub
                                %mo ×
                                %mi Σ
                              %mi E
                              %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mi R
                            %mtd
                            %mtd
                              %msub
                                %mi T
                                %mi Σ
                              %mi E
                          %mtr
                            %mtd
                            %mtd
                              %mo ↘
                            %mtd
                            %mtd
                              %mo ↙
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi E
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      J^\infty_\Sigma( \mathcal{G} \times_\Sigma E )
                      \&amp;&amp; \overset{R}{\longrightarrow} &amp;&amp;
                      T_\Sigma E
                      \\\
                      \&amp; \searrow &amp;&amp; \swarrow
                      \\\
                      \&amp;&amp; E
                      }
                      \\,.
              %p
                Assuming that the gauge parameter bundle is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒢
                        %mo =
                        %mi 𝔤
                        %mo ×
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \mathcal{G} = \mathfrak{g} \times \Sigma
                %a.maruku-ref{:href => "#ActionOfGaugeParameterizedInfinitesimalGaugeSymmetriesOnJetBundle"}
                this induces an
                %a.existingWikiWord{:href => "/nlab/show/action"} action
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi R
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat R
                of a Lie algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔤
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\infty
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mi E
                    %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma E
                by
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
              %p
                The corresponding
                %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi 𝔤
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)/\mathfrak{g}^\infty
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ActionLieAlgebroid"}
                %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded manifold
                (remark
                = succeed ")" do
                  %a.maruku-ref{:href => "#dgManifolds"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔤
                        %mn ∞
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ×
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %msub
                        %mo ×
                        %mi Σ
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathfrak{g}^\infty[1] \times J^\infty_\Sigma(E)
                      \\;\simeq\;
                      J^\infty_\Sigma( \mathcal{G}[1] \times_\Sigma E  )
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                of the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded
                  %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi BRST
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi E
                      %msub
                        %mo ×
                        %mi Σ
                      %mi 𝒢
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      E_{BRST} \;\coloneqq\; E \times_\Sigma \mathcal{G}[1]
              %p
                which regards the
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
                as
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
                in degree 1. As such these are called
                = succeed ":" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/ghost+fields"} ghost fields
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo {
                        %mtext ghost field histories
                        %mo }
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \\text{ghost field histories}
                      \\right\}
                      \\;\coloneqq\;
                      \\Gamma_\Sigma( \mathcal{G}[1] )
                      \\,.
              %p Therefore we write suggestively
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} /
                      %mi 𝒢
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi 𝔤
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"}
                      E/\mathcal{G}
                      \\;\coloneqq\;
                      J^\infty_\Sigma(E)/\mathfrak{g}^\infty
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
                of the
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameterized
                implicit
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
                on the
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                of the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %p
                The Chevalley-Eilenberg
                %a.existingWikiWord{:href => "/nlab/show/differential"} differential
                of the
                %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
                is traditionally denoted
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi BRST
                      %mo ≔
                      %msub
                        %mi d
                        %mi CE
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      s_{BRST} \coloneqq d_{CE}
                      \\,.
              %p
                To express this in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                as well as the
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
                bundle are
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundles"} trivial vector bundles
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϕ
                        %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\phi^a)
                the
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
                coordinates on the
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                with induced jet coordinates
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϕ
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi ϕ
                        %mi μ
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ⋯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ((x^\mu), (\phi^a), (\phi^a_{\mu}), \cdots)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi c
                        %mi α
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (c^\alpha)
                are
                %a.existingWikiWord{:href => "/nlab/show/ghost+field"} ghost field
                coordinates on the fiber of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}[1]
                with induced jet coordinates
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi x
                          %mi μ
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi c
                          %mi α
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi c
                          %mi μ
                          %mi α
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ⋯
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} ((x^\mu), (c^\alpha), (c^\alpha_\mu), \cdots)
              %p
                Then in terms of the corresponding coordinate expression for the gauge symmetries
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                %a.maruku-eqref{:href => "#eq:CoordinateExpressionForGaugeParameterized"} (157)
                the
                %a.existingWikiWord{:href => "/nlab/show/BRST+differential"} BRST differential
                is given on the
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
                by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi BRST
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi ϕ
                        %mi a
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi c
                        %mrow
                          %mo ,
                          %msub
                            %mi μ
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi μ
                            %mi k
                        %mi α
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                      %msubsup
                        %mi R
                        %mi α
                        %mrow
                          %mi a
                          %msub
                            %mi μ
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi μ
                            %mi k
                    %annotation{:encoding => "application/x-tex"}
                      s_{BRST} \, \phi^a
                      \\;=\;
                      c^\alpha_{,\mu_1 \cdots \mu_k}
                      \\underset{k \in \mathbb{N}}{\sum}
                      R^{a \mu_1 \cdots \mu_k}_{\alpha}
              %p
                and on the
                %a.existingWikiWord{:href => "/nlab/show/ghost+fields"} ghost fields
                by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi BRST
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi c
                        %mi α
                      %mo =
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msup
                        %mi γ
                        %mi α
                      %msub
                        %mrow
                        %mrow
                          %mi β
                          %mi γ
                      %msup
                        %mi c
                        %mi β
                      %msup
                        %mi c
                        %mi γ
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      s_{BRST} \, c^\alpha = \tfrac{1}{2}\gamma^\alpha{}_{\beta \gamma} c^\beta c^\gamma
                      \\,,
              %p
                and it extends from there, via prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total spacetime derivative
              %p
                Moreover, since the action of the
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
                is by definition via prolongations (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorField"}
                %a.existingWikiWord{:href => "/nlab/show/total+derivative"} total spacetime derivative
                %a.maruku-eqref{:href => "#eq:ProlongedEvolutionaryVectorFieldContractionAnticommutedWithHorizontalDerivative"} (75)
                this construction descends to the horizontal tangent Lie algebroid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi T
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)/T\Sigma
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#HorizontalTangentLieAlgebroid"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %msub
                        %mo ×
                        %mi Σ
                      %mi T
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %msubsup
                          %mi J
                          %mi Σ
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi T
                        %mi Σ
                        %mo )
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi 𝔤
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"}
                      E/(\mathcal{G}\times_\Sigma T \Sigma)
                      \\;\coloneqq\;
                      \\left(J^\infty_\Sigma(E)/T\Sigma\right)/\mathfrak{g}^\infty
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+differential"} Chevalley-Eilenberg differential
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %msub
                        %mo ×
                        %mi Σ
                      %mi T
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E/(\mathcal{G}\times_\Sigma T \Sigma)
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo −
                      %msub
                        %mi s
                        %mi BRST
                    %annotation{:encoding => "application/x-tex"}
                      d - s_{BRST}
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                of functions on this
                %a.existingWikiWord{:href => "/nlab/show/differential+graded+manifold"} differential graded manifold
                %a.maruku-eqref{:href => "#eq:CEAlgebra"} (172)
                is called the
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
            %p
              (
              %a{:href => "local+BRST+cohomology#BarnichBrandtHenneaux94"}> Barnich-Brandt-Henneaux 94
              ,
              = succeed ")." do
                %a{:href => "BRST+complex#Barnich10"} Barnich 10 (35)
            .num_defn
              %h6#definition_9 Definition
              %p
                %strong
                  (global
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
              %p
                We may pass from the
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LocalOffShellBRSTComplex"}
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                to the “global” BRST complex by
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression of variational differential forms
                (def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#TransgressionOfVariationalDifferentialFormsToConfigrationSpaces"}
              %p
                Write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Obs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo ×
                        %mi Σ
                      %mi 𝒢
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Obs(E \times_\Sigma \mathcal{G}[1])
                for the induced graded
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+observables"} algebra of observables
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#LocalObservables"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                          %mo ,
                          %mo •
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo ×
                        %mi Σ
                      %mi 𝒢
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \in \Omega^{p+1,\bullet}_\Sigma(E \times_\Sigma \mathcal{G}[1])
                with corresponding
                %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi LocObs
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo ×
                        %mi Σ
                      %mi 𝒢
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tau_\Sigma(A) \in LocObs_\Sigma(E \times_\Sigma \mathcal{G}[1])
                its BRST differential is defined by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi BRST
                      %msub
                        %mi τ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi τ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi s
                        %mi BRST
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      s_{BRST} \tau_{\Sigma}(A) \;\coloneqq\; \tau_{\Sigma}(s_{BRST} A)
              %p
                and extended from there to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Obs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo ×
                        %mi Σ
                      %mi 𝒢
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Obs(E \times_\Sigma \mathcal{G}[1])
                as a graded derivation.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#ExamplesForLocalBRSTComplexes
              %strong
                Examples of
                %a.existingWikiWord{:href => "/nlab/show/local+BRST+complexes"} local BRST complexes
                of
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian
                %a.existingWikiWord{:href => "/nlab/show/gauge+theories"} gauge theories
            #LocalBRSTComplexForFreeElectromagneticFieldOnMinkowskiSpacetim.num_prop
              %h6#example_12 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
                  for
                  %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                  %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
                  on
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                of
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
                on
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#ElectromagnetismLagrangianDensity"}
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
                bundle as in example
                = succeed "." do
                  %a.maruku-ref{:href => "#InfinitesimalGaugeSymmetryElectromagnetism"}
              %p
                By
                %a.maruku-eqref{:href => "#eq:EMProlongedSymmetryVectorField"} (163)
                the action of the
                %a.existingWikiWord{:href => "/nlab/show/BRST+differential"} BRST differential
                is the derivation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi BRST
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi c
                        %mrow
                          %mo ,
                          %mi μ
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %msub
                            %mi a
                            %mi μ
                      %mo +
                      %msub
                        %mi c
                        %mrow
                          %mo ,
                          %mi μ
                          %mi ν
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %msub
                            %mi a
                            %mrow
                              %mi μ
                              %mo ,
                              %mi ν
                      %mo +
                      %mi ⋯
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      s_{BRST}
                      \\;=\;
                      c_{,\mu} \frac{\partial}{\partial a_\mu}
                      +
                      c_{, \mu \nu} \frac{\partial}{\partial a_{\mu, \nu}}
                      +
                      \\cdots
                      \\,.
              %p
                In particular the
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                is BRST-closed
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi s
                                %mi BRST
                              %mstyle{:mathvariant => "bold"}
                                %mi L
                            %mtd
                              %mo =
                              %msub
                                %mi s
                                %mi BRST
                              %msub
                                %mi f
                                %mrow
                                  %mi μ
                                  %mi ν
                              %msup
                                %mi f
                                %mrow
                                  %mi μ
                                  %mi ν
                              %msub
                                %mi dvol
                                %mi Σ
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %msub
                                %mi c
                                %mrow
                                  %mo ,
                                  %mi μ
                                  %mi ν
                              %msup
                                %mi f
                                %mrow
                                  %mi μ
                                  %mi ν
                              %msub
                                %mi dvol
                                %mi Σ
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      s_{BRST} \mathbf{L}
                      \&amp; =
                      s_{BRST} f_{\mu \nu} f^{\mu \nu} dvol_\Sigma
                      \\\
                      \&amp; =
                      c_{,\mu \nu} f^{\mu \nu} dvol_\Sigma
                      \\\
                      \&amp; =
                      0
                      \\end{aligned}
              %p
                as is the
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
                (due to the symmetry
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mrow
                          %mo ,
                          %mi μ
                          %mi ν
                      %mo =
                      %msub
                        %mi c
                        %mrow
                          %mo ,
                          %mi ν
                          %mi μ
                    %annotation{:encoding => "application/x-tex"} c_{,\mu \nu} = c_{,\nu \mu}
                %a.maruku-eqref{:href => "#eq:JetCoodinatesSymmetry"} (29)
                and in contrast to the skew-symmetry
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mrow
                            %mi μ
                            %mi ν
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mi f
                          %mrow
                            %mi ν
                            %mi μ
                      %annotation{:encoding => "application/x-tex"} f_{\mu \nu} = - f_{\nu \mu}
            #YangMillsLocalBRSTComplex.num_example
              %h6#example_13 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills field
                  on
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                of
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
                on
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                from example
                = succeed "," do
                  %a.maruku-ref{:href => "#YangMillsLagrangian"}
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msubsup
                        %mi f
                        %mrow
                          %mi μ
                          %mi ν
                        %mi α
                      %msubsup
                        %mi f
                        %mi α
                        %mrow
                          %mi μ
                          %mi ν
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L}
                      \\;=\;
                      \\tfrac{1}{2} f^\alpha_{\mu \nu} f_\alpha^{\mu \nu}
              %p
                given by the universal
                %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
                %a.maruku-eqref{:href => "#eq:YangMillsJetFieldStrengthMinkowski"} (31)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi f
                        %mrow
                          %mi μ
                          %mi ν
                        %mi α
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %mrow
                        %mo (
                        %msubsup
                          %mi a
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi ν
                            %mo ,
                            %mi μ
                            %mo{:stretchy => "false"} ]
                          %mi α
                        %mo +
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msubsup
                          %mi γ
                          %mrow
                            %mi β
                            %mi γ
                          %mi α
                        %msubsup
                          %mi a
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi μ
                          %mi β
                        %msubsup
                          %mi a
                          %mrow
                            %mi ν
                            %mo{:stretchy => "false"} ]
                          %mi γ
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      f^\alpha_{\mu \nu}
                      \\;\coloneqq\;
                      \\tfrac{1}{2}
                      \\left(
                      a^\alpha_{[\nu,\mu]}
                      +
                      \\tfrac{1}{2} \gamma^\alpha_{\beta \gamma} a^\beta_{[\mu} a^\gamma_{\nu]}
                      \\right)
                      \\,.
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mo ≔
                      %mi Σ
                      %mo ×
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} \coloneqq \Sigma \times \mathfrak{g}
                be the
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                with
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
                bundle (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msup
                        %mi c
                        %mi α
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ((x^\mu), c^\alpha)
                and consider the
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parametrized
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                %a.maruku-eqref{:href => "#eq:CoordinateExpressionForGaugeParameterized"} (157)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %msubsup
                          %mi c
                          %mrow
                            %mo ,
                            %mi μ
                          %mi α
                        %mo −
                        %msubsup
                          %mi γ
                          %mrow
                            %mi β
                            %mi γ
                          %mi α
                        %msup
                          %mi c
                          %mi β
                        %msubsup
                          %mi a
                          %mi μ
                          %mi γ
                        %mo )
                      %msub
                        %mo ∂
                        %mrow
                          %msubsup
                            %mi a
                            %mi μ
                            %mi α
                    %annotation{:encoding => "application/x-tex"}
                      R
                      \\;=\;
                      \\left(
                      c^\alpha_{,\mu}
                      \-
                      \\gamma^\alpha_{\beta \gamma} c^\beta a^\gamma_\mu
                      \\right)
                      \\partial_{a^\alpha_\mu}
              %p
                from example
                = succeed "." do
                  %a.maruku-ref{:href => "#InfinitesimalGaugeSymmetryOfYangMillsTheory"}
              %p
                We claim that these are
                %em
                  closed
                  %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
                in the sense of def.
                = succeed "," do
                  %a.maruku-ref{:href => "#GaugeParametersClosed"}
                %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
                in the form of example
                %a.maruku-ref{:href => "#LocalOffShellBRSTComplex"}
                exists.
              %p
                To see this, observe that, by def.
                %a.maruku-ref{:href => "#ActionLieAlgebroid"}
                the candidate BRST differential needs to be of the form
                %a.maruku-eqref{:href => "#eq:OnMinkowskiInfinitesimalGaugeSymmetryForYangMills"} (164)
                plus the
                %a.existingWikiWord{:href => "/nlab/show/linear+dual"} linear dual
                of the
                %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msubsup
                        %mo{:stretchy => "false"} ]
                        %mi 𝒢
                        %mo *
                    %annotation{:encoding => "application/x-tex"} [-,-]_{\mathcal{G}}^\ast
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi BRST
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %mrow
                          %mo (
                          %msubsup
                            %mi c
                            %mrow
                              %mo ,
                              %mi μ
                            %mi α
                          %mo −
                          %msubsup
                            %mi γ
                            %mrow
                              %mi β
                              %mi γ
                            %mi α
                          %msup
                            %mi c
                            %mi β
                          %msubsup
                            %mi a
                            %mi μ
                            %mi γ
                          %mo )
                        %msub
                          %mo ∂
                          %mrow
                            %msubsup
                              %mi a
                              %mi μ
                              %mi α
                        %mspace{:width => "thickmathspace"}
                        %mo +
                        %mspace{:width => "thickmathspace"}
                        %mtext prolongation
                        %mo )
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi 𝒢
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      s_{BRST}
                      \\;=\;
                      \\left(
                      \\left(
                      c^\alpha_{,\mu}
                      \-
                      \\gamma^\alpha_{\beta \gamma} c^\beta a^\gamma_\mu
                      \\right)
                      \\partial_{a^\alpha_\mu}
                      \\;+\;
                      \\text{prolongation}
                      \\right)
                      +
                      ([-,-]_{\mathcal{G}})^\ast
                      \\,.
              %p
                Moreover, by def.
                %a.maruku-ref{:href => "#ActionLieAlgebroid"}
                we may equivalently make an Ansatz for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi 𝒢
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} ([-,-]_{\mathcal{G}})^\ast
                and if the resulting differential
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
