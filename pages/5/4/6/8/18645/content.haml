                          \\overset{( (f_i)^\ast )_{i \in I}  }{\hookrightarrow}
                          \\underset{i \in I}{\prod} X(U_i)
                  %p
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                    onto the set of those
                    %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Φ
                            %mi i
                          %mo ∈
                          %mi X
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                        %annotation{:encoding => "application/x-tex"} (\Phi_i \in X(U_i))_{i \in I}
                    of plots, which are “
                    %a.existingWikiWord{:href => "/nlab/show/matching+families"}> matching families
                    ” in that they agree on
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ϕ
                            %mi i
                          %msub
                            %mo{:stretchy => "false"} |
                            %mrow
                              %msub
                                %mi U
                                %mi i
                              %mo ∩
                              %msub
                                %mi U
                                %mi j
                          %mo =
                          %msub
                            %mi ϕ
                            %mi j
                          %msub
                            %mo{:stretchy => "false"} |
                            %mrow
                              %msub
                                %mi U
                                %mi i
                              %mo ∩
                              %msub
                                %mi U
                                %mi j
                          %mphantom
                            %mi AAAA
                          %mtext i.e.
                          %mphantom
                            %mi AAAA
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %msub
                                    %mi U
                                    %mi i
                                  %mo ∩
                                  %msub
                                    %mi U
                                    %mi j
                              %mtr
                                %mtd
                                %mtd
                                  %mo ↙
                                %mtd
                                %mtd
                                  %mo ↘
                              %mtr
                                %mtd
                                  %msub
                                    %mi U
                                    %mi i
                                %mtd
                                %mtd
                                %mtd
                                %mtd
                                  %msub
                                    %mi U
                                    %mi j
                              %mtr
                                %mtd
                                %mtd
                                  %msub
                                    %mrow
                                    %mpadded{:width => "0"}
                                      %mrow
                                        %msub
                                          %mi Φ
                                          %mi i
                                  %mo ↘
                                %mtd
                                %mtd
                                  %msub
                                    %mo ↙
                                    %mpadded{:width => "0"}
                                      %mrow
                                        %msub
                                          %mi Φ
                                          %mi j
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mi X
                        %annotation{:encoding => "application/x-tex"}
                          \\phi_i\vert_{U_i \cap U_j} = \phi_j \vert_{U_i \cap U_j}
                          \\phantom{AAAA}
                          \\text{i.e.}
