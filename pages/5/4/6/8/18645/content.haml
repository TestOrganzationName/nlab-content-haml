            #IntegrationByPartsOnJetBundle.num_example
              %h6#example_9 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cohomological
                  %a.existingWikiWord{:href => "/nlab/show/integration+by+parts"} integration by parts
                  on the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
