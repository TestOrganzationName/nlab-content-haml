              %p
                which by
                %a.maruku-eqref{:href => "#eq:VerticalDerivative"} (36)
                is equivalent to
              #eq:HorizontalAndVerticalDerivativeAnticommute.maruku-equation
                %span.maruku-eq-number (37)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
