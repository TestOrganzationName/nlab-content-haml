            %p#FourierAnalysis
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier analysis
                and
                %a.existingWikiWord{:href => "/nlab/show/plane+wave"} plane wave
                modes
            %p
              By definition, the
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              of
              %a.existingWikiWord{:href => "/nlab/show/free+field+theories"} free field theories
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FreeFieldTheory"}
              %a.existingWikiWord{:href => "/nlab/show/linear+partial+differential+equations"} linear partial differential equations
              and hence lend themselves to
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/harmonic+analysis"} harmonic analysis
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              are decomposed into
              %a.existingWikiWord{:href => "/nlab/show/superpositions"} superpositions
              of
              %a.existingWikiWord{:href => "/nlab/show/plane+waves"} plane waves
              via
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier analysis
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formal duality
              to the
              %a.existingWikiWord{:href => "/nlab/show/harmonic+analysis"} harmonic analysis
              of the
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              themselves, also the linear
              %a.existingWikiWord{:href => "/nlab/show/observables"} observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LinearObservables"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              %em
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distributional
                %a.existingWikiWord{:href => "/nlab/show/generalized+functions"} generalized functions
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#LinearObservablesAreTheCompactlySupportedDistributions"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              (def.
              %a.maruku-ref{:href => "#FourierTransformOnTemperedDistributions"}
              below).
            %p
              Throughout, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
