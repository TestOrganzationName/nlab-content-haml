                        %mi dvol
                        %mi σ
                    %annotation{:encoding => "application/x-tex"}
                      \\delta_{EL}\mathbf{L}
                      \\;=\;
                      \\left(\eta^{\mu \nu} \phi_{,\mu \nu} - m^2 \right) \delta \phi \wedge dvol_\sigma
              %p
                Hence for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo ∈
