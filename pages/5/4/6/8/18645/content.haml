                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} A_1, A_2 \in PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j] ]
                two
                %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
                we have for any
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo ,
                      %msub
                        %mi ρ
                        %mi vac
                      %mo ∈
                      %msub
                        %mi ℝ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \rho, \rho_{vac} \in \mathbb{R}_+
                that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi σ
