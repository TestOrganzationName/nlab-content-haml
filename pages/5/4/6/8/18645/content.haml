              %p of the map
              #eq:RegularLinearObservables.maruku-equation
                %span.maruku-eq-number (103)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
