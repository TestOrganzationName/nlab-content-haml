                implies that
                %a.existingWikiWord{:href => "/nlab/show/restriction+of+distributions"} restricted
                to any
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi I
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_{I}
                these have to be given (in the condensed
                = succeed "-notation" do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
                %a.maruku-ref{:href => "#NotationForTimeOrderedProductsAsGeneralizedFunctions"}
                on any unordered tuple
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo =
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi x
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} }
                      %mo ∈
                      %msub
                        %mi 𝒞
                        %mi I
                    %annotation{:encoding => "application/x-tex"} \mathbf{X} = \{x_1, \cdots, x_{n+1}\} \in \mathcal{C}_I
                with corresponding induced tuples
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mo ≔
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi x
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
