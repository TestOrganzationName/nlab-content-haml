                        %mtext unique
                      %mo +
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mi α
                              %mo ∈
                              %msup
                                %mi ℕ
                                %mi n
                          %mrow
                            %mrow
                              %mrow
                                %mo{:stretchy => "false"} |
                                %mi α
                                %mo{:stretchy => "false"} |
                              %mo ≤
                              %mi ρ
                      %msup
                        %mi c
                        %mi α
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ∂
                        %mi α
                      %msub
                        %mi δ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\hat u
                      \\;=\;
                      \\underset{
                      \\text{unique}
                      }{
                      \\underbrace{
                      \\widehat{
                      u \circ p_\rho
                      }
                      }
                      }
                      +
                      \\underset{
                      { \alpha \in \mathbb{N}^n  }
                      \\atop
                      { {\vert \alpha\vert} \leq \rho }
                      }{\sum}
                      c^\alpha
                      \\,
                      \\partial_\alpha \delta_0
              %p
                for a finite number of constants
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi c
                          %mi α
                        %mo ∈
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} c^\alpha \in \mathbb{C}
              %p
                Notice that for any extension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat u
                the exact value of the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi c
                        %mi α
                    %annotation{:encoding => "application/x-tex"} c^\alpha
                here depends on the arbitrary choice of dual basis
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
