              %p such that the horizontal and vertical derivative increase horizontal or vertical degree, respectively:
              #eq:VariationalBicomplexDiagram.maruku-equation
                %span.maruku-eq-number (38)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
