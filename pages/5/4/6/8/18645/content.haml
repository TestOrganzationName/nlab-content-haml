                %a.existingWikiWord{:href => "/nlab/show/prolonged+shell"} prolonged shell
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℰ
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}^\infty
                = succeed "," do
                  %a.maruku-eqref{:href => "#eq:ProlongedShellInJetBundle"} (52)
                %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivatives"} total spacetime derivatives
                of terms proportional to the components of the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
              %p
                By
                %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's second theorem
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#NoetherIdentities"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} A = 0
                and hence
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi J
                        %mi R
                      %mo −
                      %mi K
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d(J_R - K) = 0
                      \\,.
              %p
                Now if the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                and
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
                bundle are trivial, then prop.
                %a.maruku-ref{:href => "#HorizontalVariationalComplexOfTrivialFieldBundleIsExact"}
                implies that
              #eq:DecompositionOfGaugSymmetryConservedCurrent.maruku-equation
                %span.maruku-eq-number (160)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi R
                      %mo −
                      %mi K
                      %mo =
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mo .
                      %mo .
                      %mo .
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      J_R - K = d(...)
                      \\,.
              %p
                By restricting this equation to the
                %a.existingWikiWord{:href => "/nlab/show/prolonged+shell"} prolonged shell
                and using that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msup
                              %mi ℰ
                              %mn ∞
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} K\vert_{\mathcal{E}^\infty} = 0
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mi R
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msup
                              %mi ℰ
                              %mn ∞
                        %mo =
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mo .
                        %mo .
                        %mo .
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} J_R \vert_{\mathcal{E}^\infty} = d(...)
              %p
                This implies
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Q
                        %mi R
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} Q_R = 0
                by prop.
                %a.maruku-ref{:href => "#PullbackAlongJetProlongationIntertwinesHorizontalDerivative"}
                and
                %a.existingWikiWord{:href => "/nlab/show/Stokes%27+theorem"} Stokes' theorem
                (prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#StokesTheorem"}
            %p
              This situation has a concise
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} cohomological
              incarnation:
            #dWCohomology.num_example
              %h6#example_3 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorems I and II
                  in terms of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/local+BV-cohomology"} local BV-cohomology
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                be a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                of
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} p + 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mover
                        %mo →
                        %mi gb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\to} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundle"} gauge parameter bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
                = succeed ")." do
                  %a.maruku-ref{:href => "#GaugeParametersClosed"}
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundles"} trivial vector bundles
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
                = succeed "." do
                  %a.maruku-ref{:href => "#EulerLagrangeFormIsSectionOfLocalCotangentBundleOfJetBundleGaugeActionLieAlgebroid"}
              %p
                Then in the
                %a.existingWikiWord{:href => "/nlab/show/local+BV-complex"} local BV-complex
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#BVComplexOfOrdinaryLagrangianDensity"}
              %p
                The
                = succeed "-closure" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi s
                          %mi BV
                        %mo +
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (s_{BV} + d)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                is characterizes as the
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                of an
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                which is an
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
                and the
                %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
                that corresponds to it under
                %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's first theorem
                (prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#NoethersFirstTheorem"}
              %p
                Moreover, such a pair is
                = succeed "-exact" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi s
                          %mi BV
                        %mo +
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (s_{BV} + d)
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
                is in fact an
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetry"} infinitesimal gauge symmetry
                as witnessed by
                %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's second theorem
                (prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#NoetherIdentities"}
            %p
              (
              %a{:href => "local+BRST+cohomology#BarnichBrandtHenneaux94"}> Barnich-Brandt-Henneaux 94, top of p. 20
              )
            .proof
              %h6#proof_5 Proof
              %p
                An element of the
                %a.existingWikiWord{:href => "/nlab/show/local+BV-complex"} local BV-complex
                in degee
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                is the
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                of a
                %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+form"} horizontal differential form
                of degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                with the product of a horizontal form of degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+1)
                times a function proportional to the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/antifields"} antifields
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi J
                                %mi v
                              %mo{:stretchy => "false"} }
                            %mtd
                            %mtd
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} {
                              %msup
                                %mi v
                                %mi a
                              %msubsup
                                %mi ϕ
                                %mi a
                                %mo ‡
                              %msub
                                %mi dvol
                                %mi Σ
                              %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\{J_v\} &amp;&amp;
                      \\\
                      \&amp;&amp;
                      \\\
                      \&amp;&amp; \{ v^a \phi^\ddagger_a dvol_\Sigma\}
                      }
              %p Its closure means that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi J
                                %mi v
                              %mo{:stretchy => "false"} }
                            %mtd
                              %mover
                                %mo ⟶
                                %mi d
                            %mtd
                              %mo{:stretchy => "false"} {
                              %mover
                                %mover
                                  %mrow
                                    %mi d
                                    %msub
                                      %mi J
                                      %mi v
                                    %mo −
                                    %msub
                                      %mi ι
                                      %mi v
                                    %msub
                                      %mi δ
                                      %mi EL
                                    %mstyle{:mathvariant => "bold"}
                                      %mi L
                                  %mo ⏞
                                %mrow
                                  %mo =
                                  %mn 0
                              %mo{:stretchy => "false"} }
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi s
                                    %mi BV
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} {
                              %msup
                                %mi v
                                %mi a
                              %msubsup
                                %mi ϕ
                                %mi a
                                %mo ‡
                              %msub
                                %mi dvol
                                %mi Σ
                              %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\{J_v\} &amp;\overset{d}{\longrightarrow}&amp; \{ \overset{= 0}{\overbrace{ d J_v - \iota_v \delta_{EL}\mathbf{L} }} \}
                      \\\
                      \&amp;&amp; \uparrow\mathrlap{s_{BV}}
                      \\\
                      \&amp;&amp; \{ v^a \phi^\ddagger_a dvol_\Sigma\}
                      }
              %p where the equality in the top right corner is euqation
              %p It being exact means that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mrow
                                %mo {
                                %mo .
                                %mo .
                                %mo .
                                %mo }
                            %mtd
                              %mover
                                %mo ⟶
                                %mi d
                            %mtd
                              %mrow
                                %mo {
                                %msub
                                  %mi J
                                  %mi R
                                %mo =
                                %mi K
                                %mo +
                                %mi d
                                %mo{:stretchy => "false"} (
                                %mo .
                                %mo .
                                %mo .
                                %mo{:stretchy => "false"} )
                                %mo }
                            %mtd
                              %mover
                                %mo ⟶
                                %mi d
                            %mtd
                              %mrow
                                %mo {
                                %mi d
                                %msub
                                  %mi J
                                  %mi R
                                %mo }
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↑
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mrow
                                %mo {
                                %msup
                                  %mi K
                                  %mrow
                                    %mi a
                                    %mi μ
                                %msubsup
                                  %mi ϕ
                                  %mi a
                                  %mo ‡
                                %msub
                                  %mi ι
                                  %mrow
                                    %msub
                                      %mo ∂
                                      %mi μ
                                %msub
                                  %mi dvol
                                  %mi Σ
                                %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\left\{ ... \right\}
                      \&amp;
                      \\overset{d}{\longrightarrow}
                      \&amp;
                      \\left\{
                      J_R
                      \=
                      K + d(...)
                      \\right\}
                      \&amp;\overset{d}{\longrightarrow}&amp;
                      \\left\{
                      d J_R
                      \\right\}
                      \\\
                      \&amp;&amp;
                      \\uparrow
                      \\\
                      \&amp;&amp;
                      \\left\{
                      K^{a \mu} \phi^\ddagger_a \iota_{\partial_\mu} dvol_\Sigma
                      \\right\}
                      }
              %p
                where now the equality in the second term from the left is equation
                %a.maruku-eqref{:href => "#eq:DecompositionOfGaugSymmetryConservedCurrent"} (160)
                for
                %a.existingWikiWord{:href => "/nlab/show/conserved+currents"} conserved currents
                corresponding to
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
                (prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#ConservedChargeOfInfinitesimalGaugeSymmetryVanishes"}
            %p
              We will need some further technical results on
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Noether+identities"} Noether identities
            #NoetherOperator.num_defn
              %h6#definition_3 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Noether+operator"}> Noether operator
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                be a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                of
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} p + 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mover
                        %mo →
                        %mi gb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\to} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundle"} gauge parameter bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
                = succeed ")." do
                  %a.maruku-ref{:href => "#GaugeParametersClosed"}
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundles"} trivial vector bundles
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
                = succeed "." do
                  %a.maruku-ref{:href => "#EulerLagrangeFormIsSectionOfLocalCotangentBundleOfJetBundleGaugeActionLieAlgebroid"}
              %p
                A
                %em Noether operator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                is a
                %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DifferentialOperator"}
                %a.existingWikiWord{:href => "/nlab/show/vertical+cotangent+bundle"} vertical cotangent bundle
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#VerticalTangentBundle"}
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
                %a.existingWikiWord{:href => "/nlab/show/real+line+bundle"} real line bundle
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi ω
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                      %msup
                        %mi N
                        %mrow
                          %mi a
                          %msub
                            %mi μ
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi μ
                            %mi k
                      %mfrac
                        %mrow
                          %msup
                            %mi d
                            %mi k
                        %mrow
                          %mi d
                          %msup
                            %mi x
                            %mrow
                              %msub
                                %mi μ
                                %mn 1
                          %mi ⋯
                          %mi d
                          %msup
                            %mi x
                            %mrow
                              %msub
                                %mi μ
                                %mi k
                      %msub
                        %mi ω
                        %mi a
                    %annotation{:encoding => "application/x-tex"}
                      N(\omega)
                      \\;=\;
                      \\underset{k \in \mathbb{N}}{\sum}
                      N^{a \mu_1 \cdots \mu_k}
                      \\frac{d^k}{d x^{\mu_1} \cdots d x^{\mu_k}} \omega_a
              %p
                such that it annihilates the
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
                (prop.
                = succeed "):" do
                  %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                      %msup
                        %mi N
                        %mrow
                          %mi a
                          %msub
                            %mi μ
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi μ
                            %mi k
                      %mfrac
                        %mrow
                          %msup
                            %mi d
                            %mi k
                        %mrow
                          %mi d
                          %msup
                            %mi x
                            %mrow
                              %msub
                                %mi μ
                                %mn 1
                          %mi ⋯
                          %mi d
                          %msup
                            %mi x
                            %mrow
                              %msub
                                %mi μ
                                %mi k
                      %mfrac
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mi L
                        %mrow
                          %mi δ
                          %msup
                            %mi ϕ
                            %mi a
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\underset{k \in \mathbb{N}}{\sum}
                      N^{a \mu_1 \cdots \mu_k}
                      \\frac{d^k}{d x^{\mu_1} \cdots d x^{\mu_k}} \frac{\delta_{EL} L}{\delta \phi^a}
                      \\;=\; 0
                      \\,.
              %p
                Given For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                an
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                which is an
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#SymmetriesAndConservedCurrents"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ⋅
                      %mi N
                    %annotation{:encoding => "application/x-tex"} v \cdot N
                by
              #eq:MultiplyingANoetherOperatorWithAnInfinitesimalSymmetry.maruku-equation
                %span.maruku-eq-number (161)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ⋅
                      %mi N
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi a
                          %msub
                            %mi μ
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi μ
                            %mi k
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mover
                        %mi v
                        %mo ^
                      %mrow
                        %mo (
                        %msup
                          %mi N
                          %mrow
                            %mi a
                            %msub
                              %mi μ
                              %mn 1
                            %mi ⋯
                            %msub
                              %mi μ
                              %mi k
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo −
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi N
                        %mi a
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi{:mathvariant => "normal"} D
                        %mi v
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mi a
                        %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      (v \cdot N)^{a \mu_1 \cdots \mu_k}
                      \\;\coloneqq\;
                      \\widehat{v}\left(
                      N^{a \mu_1 \cdots \mu_k}
                      \\right)
                      \\;-\;
                      N^a \circ (\mathrm{D}_v)^\ast_a
                      \\,,
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{v}
                denotes the prolongation of the
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi{:mathvariant => "normal"} D
                        %mi v
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (\mathrm{D}_v)^\ast
                denotes the
                %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operator"} formally adjoint differential operator
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+derivative"} evolutionary derivative
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#FieldDependentDifferentialOperatorDerivative"}
            %p
              (
              %a{:href => "BRST+complex#Barnich10"}> Barnich 10 (3.1) and (3.5)
              )
            #LieAlgebraActionOfInfinitesimalSymmetriesOfTheLagrangianOnNoetherOperators.num_prop
              %h6#proposition_5 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
                  of
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries+of+the+Lagrangian"} infinitesimal symmetries of the Lagrangian
                  on
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Noether+operators"} Noether operators
              %p
                The operation
                %a.maruku-eqref{:href => "#eq:MultiplyingANoetherOperatorWithAnInfinitesimalSymmetry"} (161)
                exhibits a
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
                of the
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                of
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries+of+the+Lagrangian"} infinitesimal symmetries of the Lagrangian
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldLieAlgebra"}
                = succeed ")," do
                  %a.maruku-ref{:href => "#NoetherOperator"}
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                          %mo ⋅
                          %mi N
                        %annotation{:encoding => "application/x-tex"} v \cdot N
                    is again a Noether operator;
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi v
                            %mn 1
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi v
                            %mn 2
                          %mo ⋅
                          %mi N
                          %mo{:stretchy => "false"} )
                          %mo −
                          %msub
                            %mi v
                            %mn 2
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi v
                            %mn 1
                          %mo ⋅
                          %mi N
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi v
                            %mn 1
                          %mo ,
                          %msub
                            %mi v
                            %mn 2
                          %mo{:stretchy => "false"} ]
                          %mo ⋅
                          %mi N
                        %annotation{:encoding => "application/x-tex"} v_1 \cdot (v_2 \cdot N) - v_2 \cdot (v_1 \cdot N) = [v_1, v_2] \cdot N
                    \.
              %p
                Moreover, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
                denotes the map which identifies a
                %a.existingWikiWord{:href => "/nlab/show/Noether+identity"} Noether identity
                with an
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetry"} infinitesimal gauge symmetry
                by
                %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's second theorem
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#NoetherIdentities"}
              #eq:LieActionOnNoetherOperatorGivesLieBracketUnderNoetherTheorem.maruku-equation
                %span.maruku-eq-number (162)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mrow
                        %mo (
                        %mi v
                        %mo ⋅
                        %mi N
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo [
                        %mi v
                        %mo ,
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo ]
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\rho \left(
                      v \cdot N
                      \\right)
                      \\;=\;
                      \\left[ v, \rho(N)\right]
                      \\,,
              %p
                where on the right we have again the
                %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
                of
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
                from (prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldLieAlgebra"}
            %p
              (
              %a{:href => "BRST+complex#Barnich10"}> Barnich 10, prop. 3.1 and (3.8)
              )
            .proof
              %h6#proof_6 Proof
              %p
                For the first statement observe that by the
                %a.existingWikiWord{:href => "/nlab/show/product+law"} product law
                for
                %a.existingWikiWord{:href => "/nlab/show/differentiation"} differentiation
                we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo =
                              %mover
                                %mi v
                                %mo ^
                              %mrow
                                %mo (
                                %mi N
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi δ
                                  %mi EL
                                %mi L
                                %mo{:stretchy => "false"} )
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mover
                                %mi v
                                %mo ^
                              %mrow
                                %mo (
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                  %mrow
                                    %mi k
                                    %mo ∈
                                    %mi ℕ
                                %msup
                                  %mi N
                                  %mrow
                                    %mi a
                                    %msub
                                      %mi μ
                                      %mn 1
                                    %mi ⋯
                                    %msub
                                      %mi μ
                                      %mi k
                                %mo )
                              %mo −
                              %mrow
                                %mo (
                                %msup
                                  %mi N
                                  %mi a
                                %mo ∘
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi{:mathvariant => "normal"} D
                                  %mi v
                                %msubsup
                                  %mo{:stretchy => "false"} )
                                  %mi a
                                  %mi b
                                %mrow
                                  %mo (
                                  %mfrac
                                    %mrow
                                      %msub
                                        %mi δ
                                        %mi EL
                                      %mi L
                                    %mrow
                                      %mi δ
                                      %msup
                                        %mi ϕ
                                        %mi a
                                  %mo )
                                %mo )
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      0
                      \&amp; =
                      \\widehat{v}\left(
                      N(\delta_{EL} L)
                      \\right)
                      \\\
                      \&amp; =
                      \\widehat{v}
                      \\left(
                      \\underset{k \in \mathbb{N}}{\sum} N^{a \mu_1 \cdots \mu_k}
                      \\right)
                      \-
                      \\left(
                      N^a \circ (\mathrm{D}_v)_a^b\left(  \frac{\delta_{EL} L}{\delta \phi^a} \right)
                      \\right)
                      \\,,
                      \\end{aligned}
              %p
                where on the right we used
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:TowardsProofThatSymmetriesPreserveTheShell"} (82)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              Here are examples of
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            #InfinitesimalGaugeSymmetryElectromagnetism.num_example
              %h6#example_4 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetry"} infinitesimal gauge symmetry
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                of
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
                on
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                from example
                = succeed "." do
                  %a.maruku-ref{:href => "#ElectromagnetismLagrangianDensity"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ((x^\mu), (a_\mu))
                the
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %msub
                        %mi f
                        %mrow
                          %mi μ
                          %mi ν
                      %msup
                        %mi f
                        %mrow
                          %mi μ
                          %mi ν
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi dvol
                        %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L}
                      \\;=\;
                      \\tfrac{1}{2} f_{\mu \nu} f^{\mu \nu}
                      \\, dvol_\Sigma
                      \\,,
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mrow
                          %mi μ
                          %mi ν
                      %mo ≔
                      %msub
                        %mi a
                        %mrow
                          %mi ν
                          %mo ,
                          %mi μ
                    %annotation{:encoding => "application/x-tex"} f_{\mu \nu} \coloneqq a_{\nu,\mu}
                is the universal
                %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
                from example
                = succeed "." do
                  %a.maruku-ref{:href => "#JetFaraday"}
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mo ≔
                      %mi Σ
                      %mo ×
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} \coloneqq \Sigma \times \mathbb{R}
                be the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/trivial+line+bundle"} trivial line bundle
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parameter
                bundle (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi x
                          %mi μ
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} ((x^\mu), c)
              %p
                Then a
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter"} gauge parametrized
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                %a.maruku-eqref{:href => "#eq:CoordinateExpressionForGaugeParameterized"} (157)
                is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi c
                        %mrow
                          %mo ,
                          %mi μ
                      %msub
                        %mo ∂
                        %mrow
                          %msub
                            %mi a
                            %mi μ
                    %annotation{:encoding => "application/x-tex"}
                      R
                      \\;=\;
                      c_{,\mu} \partial_{a_\mu}
              %p
                with prolongation (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
              #eq:EMProlongedSymmetryVectorField.maruku-equation
                %span.maruku-eq-number (163)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi R
                        %mo ^
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi c
                        %mrow
                          %mo ,
                          %mi μ
                      %msub
                        %mo ∂
                        %mrow
                          %msub
                            %mi a
                            %mi μ
                      %mo +
                      %msub
                        %mi c
                        %mrow
                          %mo ,
                          %mi μ
                          %mi ν
                      %msub
                        %mo ∂
                        %mrow
                          %msub
                            %mi a
                            %mrow
                              %mi μ
                              %mo ,
                              %mi ν
                      %mo +
                      %mi ⋯
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\widehat R
                      \\;=\;
                      c_{,\mu} \partial_{a_\mu}
                      +
                      c_{,\mu \nu} \partial_{a_{\mu,\nu}}
                      +
                      \\cdots
                      \\,.
              %p
                This is because already the universal
                %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
                is
                %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
                under this flow:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mover
                                %mi R
                                %mo ^
                              %msub
                                %mi f
                                %mrow
                                  %mi μ
                                  %mi ν
                            %mtd
                              %mo =
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 2
                              %msub
                                %mi c
                                %mrow
                                  %mo ,
                                  %mi μ
                                  %mo ′
                                  %mi ν
                                  %mo ′
                              %msub
                                %mo ∂
                                %mrow
                                  %msub
                                    %mi a
                                    %mrow
                                      %mi μ
                                      %mo ′
                                      %mo ,
                                      %mi ν
                                      %mo ′
                              %mrow
                                %mo (
                                %msub
                                  %mi a
                                  %mrow
                                    %mi ν
                                    %mo ,
                                    %mi μ
                                %mo −
                                %msub
                                  %mi a
                                  %mrow
                                    %mi μ
                                    %mo ,
                                    %mi ν
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 2
                              %mrow
                                %mo (
                                %msub
                                  %mi c
                                  %mrow
                                    %mo ,
                                    %mi ν
                                    %mi μ
                                %mo −
                                %msub
                                  %mi c
                                  %mrow
                                    %mo ,
                                    %mi μ
                                    %mi ν
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mn 0
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\widehat {R} f_{\mu \nu}
                      \&amp;=
                      \\tfrac{1}{2}
                      c_{,\mu' \nu'} \partial_{a_{\mu',\nu'}}
                      \\left(
                      a_{\nu, \mu} - a_{\mu,\nu}
                      \\right)
                      \\\
                      \&amp; =
                      \\tfrac{1}{2}
                      \\left(
                      c_{,\nu\mu} - c_{,\mu \nu}
                      \\right)
                      \\\
                      \&amp; = 0
                      \\,,
                      \\end{aligned}
              %p
                because
                %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
                commute with each other:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
