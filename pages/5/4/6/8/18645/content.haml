                          %mn 1
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi k
                              %mi μ
                            %msup
                              %mi k
                              %mi μ
                            %mo −
                            %msup
                              %mrow
