                          \=
                          \\{f,g\}' + d(...)
                          \\,.
                %li
                  %p The primed version is strictly graded skew-symmetric:
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo {
