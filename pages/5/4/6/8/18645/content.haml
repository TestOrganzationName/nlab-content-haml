                                  %mi 𝔞
                                  %mo{:stretchy => "false"} )
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathllap{ d_{CE(T^\ast_{inf} \mathfrak{a})} }
                      \&amp;\mathrlap{ \vert_{\mathfrak{a}^\ast} }&amp;
                      \&amp;
                      \\coloneqq &amp; d_{CE(\mathfrak{a})}
                      \\\
                      \\mathllap{ d_{CE(T^\ast_{inf} \mathfrak{a})} }
