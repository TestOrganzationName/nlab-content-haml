                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{R}
                      \\overset{}{\hookrightarrow}
                      \\Omega^{0,0}_\Sigma(E)
                      \\overset{d}{\longrightarrow}
                      \\Omega^{1,0}_\Sigma(E)
                      \\overset{d}{\longrightarrow}
                      \\Omega^{2,0}_\Sigma(E)
                      \\overset{d}{\longrightarrow}
                      \\cdots
                      \\overset{d}{\longrightarrow}
                      \\Omega^{p,0}_\Sigma(E)
                      \\overset{d}{\longrightarrow}
                      \\Omega^{p+1,0}_\Sigma(E)
              %p
                is
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi s
                      %mo ≤
                      %mi p
                    %annotation{:encoding => "application/x-tex"} 0 \leq s \leq p
                the
                %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                coincides with the
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Ω
                          %mi Σ
                          %mrow
                            %mi s
                            %mo ,
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Omega^{s,0}_\Sigma(E)
              %p
                More explicitly, this means that not only is every horizontally exact differential form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo =
                      %mi d
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \omega = d \alpha
                horizontally closed
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi ω
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d \omega = 0
                (which follows immediately from the fact that we have a
                %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
                in the first place, hence that
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi d
                          %mn 2
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} d^2 = 0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mn 0
                          %mo ≤
                          %mi s
                          %mo ≤
                          %mi p
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \omega \in \Omega^{0 \leq s \leq p,0}_\Sigma(E)
                satisfies
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mi ω
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} d \omega = 0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mi s
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 0
