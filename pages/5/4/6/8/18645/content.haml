                        %mrow
                          %mi n
                          %mo ≤
                          %mi N
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi μ
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi μ
                            %mi n
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %msup
                            %mi x
                            %mrow
                              %msup
                                %mi μ
                                %mn 1
                      %mi ⋯
                      %mfrac
