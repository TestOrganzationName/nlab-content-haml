                            %mo )
                        %annotation{:encoding => "application/x-tex"} E_{\text{BV-BRST}} = T^\ast_{\Sigma}[-1]\left( E\times_\Sigma \mathcal{G}[1] \times_\Sigma A \times_\Sigma A[-1]\right)
                    (remark
                    = succeed ");" do
                      %a.maruku-ref{:href => "#FieldBundleBVBRST"}
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Δ
                            %mi H
                          %mo ∈
                          %mi Γ
                          %mo ′
