                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi d
                      %msubsup
                        %mi j
                        %mi σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi α
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %msubsup
                        %mi j
