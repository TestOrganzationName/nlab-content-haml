                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \in \mathcal{E}'(\mathbb{R}^n) \hookrightarrow \mathcal{S}'(\mathbb{R}^n)
                be a
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
                regarded as a
                %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
                by example
                = succeed "." do
                  %a.maruku-ref{:href => "#CompactlySupportedDistibutionsAreTemperedDistributions"}
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FourierTransformOnTemperedDistributions"}
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular distribution
                induced from a
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                that grows at most exponentially.
            %p
              (e.g.
              = succeed ")" do
                %a{:href => "Paley-Wiener-Schwartz+theorem#Hoermander90"} Hoermander 90, theorem 7.3.1
            #FourierInversionTheoremForDistributions.num_prop
              %h6#proposition_6 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Fourier+inversion+theorem"} Fourier inversion theorem
                  for
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              %p
                The operation of forming the
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi u
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{u}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FourierTransformOnTemperedDistributions"}
                %a.existingWikiWord{:href => "/nlab/show/tempered+distributions"} tempered distributions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi 𝒮
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \in \mathcal{S}'(\mathbb{R}^n)
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TemperedDistribution"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
                given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi u
                        %mo ˇ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi g
                      %mo ↦
                      %mi u
                      %mrow
                        %mo (
                        %mover
                          %mi g
                          %mo ˇ
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\widecheck{ u } \;\colon\; g \mapsto u\left( \widecheck{g}\right)
                      \\,,
              %p
                where on the right
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi g
                        %mo ˇ
                    %annotation{:encoding => "application/x-tex"} \widecheck{g}
                is the ordinary
                %a.existingWikiWord{:href => "/nlab/show/inverse+Fourier+transform"} inverse Fourier transform
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                according to prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#FourierInversion"}
            .proof
              %h6#proof_4 Proof
              %p
                By def.
                %a.maruku-ref{:href => "#FourierTransformOnTemperedDistributions"}
                this follows immediately from the
                %a.existingWikiWord{:href => "/nlab/show/Fourier+inversion+theorem"} Fourier inversion theorem
                for smooth functions (prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#FourierInversion"}
            %p
              We have the following distributional generalization of the basic property
              %a.maruku-eqref{:href => "#eq:FourierTransformInterchangesPointwiseProductWithConvolution"} (128)
              from prop.
              = succeed ":" do
                %a.maruku-ref{:href => "#BasicPropertiesOfFourierTransformOverCartesianSpaces"}
            #FourierTransformOfDistributionsInterchangesConvolutionOfDistributionsWithPointwiseProduct.num_prop
              %h6#proposition_7 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
                  interchanges
                  %a.existingWikiWord{:href => "/nlab/show/convolution+of+distributions"} convolution of distributions
                  with pointwise product)
              %p Let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mn 1
                      %mo ∈
                      %mi 𝒮
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      u_1 \in \mathcal{S}'(\mathbb{R}^n)
              %p
                be a
                %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TemperedDistribution"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mn 2
                      %mo ∈
                      %mi ℰ
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi 𝒮
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      u_2 \in \mathcal{E}'(\mathbb{R}^n) \hookrightarrow \mathcal{S}'(\mathbb{R}^n)
              %p
                be a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
                %a.existingWikiWord{:href => "/nlab/show/tempered+distribution"} tempered distribution
                via example
                = succeed "." do
                  %a.maruku-ref{:href => "#CompactlySupportedDistibutionsAreTemperedDistributions"}
              %p
                Observe here that the
                %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"} Paley-Wiener-Schwartz theorem
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#PaleyWienerSchwartzTheorem"}
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} u_1
                is a
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular distribution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %msub
                            %mi u
                            %mn 1
                        %mo ^
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \widehat{u_1} \in C^\infty(\mathbb{R}^n)
                so that the product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %msub
                            %mi u
                            %mn 1
                        %mo ^
                      %mo ⋅
                      %mover
                        %mrow
                          %msub
                            %mi u
                            %mn 2
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{u_1} \cdot \widehat{u_2}
                is always defined.
              %p
                Then the
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
                of the
                %a.existingWikiWord{:href => "/nlab/show/convolution+product+of+distributions"} convolution product of distributions
                is the product of the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %msub
                            %mi u
                            %mn 1
                          %mo ⋆
                          %msub
                            %mi u
                            %mn 2
                        %mo ^
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mover
                        %mrow
                          %msub
                            %mi u
                            %mn 1
                        %mo ^
                      %mo ⋅
                      %mover
                        %mrow
                          %msub
                            %mi u
                            %mn 2
                        %mo ^
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\widehat{u_1 \star u_2}
                      \\;=\;
                      \\widehat{u_1} \cdot \widehat{u_2}
                      \\,.
            %p
              (e.g.
              = succeed ")" do
                %a{:href => "Fourier+transform#Hoermander90"} Hörmander 90, theorem 7.1.15
            #ProductOfDistributionsViaFourierTransformOfConvolution.num_remark
              %h6#remark Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
                  via
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              %p
                Prop.
                %a.maruku-ref{:href => "#FourierTransformOfDistributionsInterchangesConvolutionOfDistributionsWithPointwiseProduct"}
                together with the
                %a.existingWikiWord{:href => "/nlab/show/Fourier+inversion+theorem"} Fourier inversion theorem
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FourierInversionTheoremForDistributions"}
                %em define
                the
                %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mn 1
                      %mo ⋅
                      %msub
                        %mi u
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} u_1 \cdot u_2
                for
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distributions"} compactly supported distributions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mn 1
                      %mo ,
                      %msub
                        %mi u
                        %mn 2
                      %mo ∈
                      %mi ℰ
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi 𝒮
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u_1, u_2 \in \mathcal{E}'(\mathbb{R}^n) \hookrightarrow \mathcal{S}'(\mathbb{R}^n)
                by the formula
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %msub
                            %mi u
                            %mn 1
                          %mo ⋅
                          %msub
                            %mi u
                            %mn 2
                        %mo ^
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi π
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mover
                        %mrow
                          %msub
                            %mi u
                            %mn 1
                        %mo ^
                      %mo ⋆
                      %mover
                        %mrow
                          %msub
                            %mi u
                            %mn 2
                        %mo ^
                    %annotation{:encoding => "application/x-tex"}
                      \\widehat{ u_1 \cdot u_2 }
                      \\;\coloneqq\;
                      (2\pi)^n \widehat{u_1} \star \widehat{u_2}
              %p
                which would complete the generalization of of property
                %a.maruku-eqref{:href => "#eq:FourierTransformInterchangesPointwiseProductWithConvolution"} (128)
                from prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#BasicPropertiesOfFourierTransformOverCartesianSpaces"}
              %p
                For this to make sense, the
                %a.existingWikiWord{:href => "/nlab/show/convolution+product"} convolution product
                of the
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                on the right needs to exist, which is not guaranteed (prop.
                %a.maruku-ref{:href => "#ConvolutionProductOnSchwartzSpace"}
                does not apply here!). The condition that this exists is the
                %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander+criterion"} Hörmander criterion
                on the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#WaveFrontSet"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} u_1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} u_2
                (prop.
                %a.maruku-ref{:href => "#HoermanderCriterionForProductOfDistributions"}
                belwo). This we further discuss in
                %em
                  %a{:href => "#MicrolocalAnalysisAndUltravioletDivergence"} Microlocal analysis and UV-Divergences
                below.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#MicrolocalAnalysisAndUltravioletDivergence
              %strong
                %a.existingWikiWord{:href => "/nlab/show/microlocal+analysis"} microlocal analysis
                and
                %a.existingWikiWord{:href => "/nlab/show/ultraviolet+divergences"} ultraviolet divergences
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LinearObservablesAreTheCompactlySupportedDistributions"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#DistributionsAreGeneralizedFunctions"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              which may have “
              %a.existingWikiWord{:href => "/nlab/show/singularities"}> singularities
              ”, namely points at which it values or that of its
              %a.existingWikiWord{:href => "/nlab/show/derivative+of+a+distribution"} derivatives
              “become infinite”. Conversely,
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              are the
              %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#DistributionsAreGeneralizedFunctions"}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular
              %em
                %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
              (def.
              %a.maruku-ref{:href => "#SingularSupportOfADistribution"}
              below).
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FourierTransformOnTemperedDistributions"}
              %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
              into the
              %a.existingWikiWord{:href => "/nlab/show/plane+wave"} plane wave
              modes that it is made of (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#PlaneWaves"}
              %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"} Paley-Wiener-Schwartz theorem
              (prop.
              %a.maruku-ref{:href => "#DecayPropertyOfFourierTransformOfCompactlySupportedFunctions"}
              below) says that the singular nature of a
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
              may be read off from this
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier mode
              decomposition: Singularities correspond to large contributions by Fourier modes of high
              %a.existingWikiWord{:href => "/nlab/show/frequency"} frequency
              and small
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/wavelength"} wavelength
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/ultraviolet+divergence"} ultraviolet
              %a.maruku-ref{:href => "#UltravioletDivergencesFromPaleyWiener"}
              below). Therefore the
              %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
              of a distribution is the set of points around which the Fourier transform does not sufficiently decay “in the UV”.
            %p
              But since the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
              is a function of the full
              %a.existingWikiWord{:href => "/nlab/show/wave+vector"} wave vector
              of the
              %a.existingWikiWord{:href => "/nlab/show/plane+wave"} plane wave
              modes (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#PlaneWaves"}
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/frequency"} frequency
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/wavelength"} wavelength
              %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} direction
              of the wave vector, this means that it contains
              %em
                %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} directional
                information
              about the singularities: A distribution may have UV-singularities at some point and in some
              %a.existingWikiWord{:href => "/nlab/show/wave+vector"} wave vector
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} direction
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} directions
            %p
              In particular, if the distribution in question is a
              %a.existingWikiWord{:href => "/nlab/show/distributional+solution+to+a+partial+differential+equation"} distributional solution to a partial differential equation
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DistributionalDerivatives"}
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              then the
              %em
                %a.existingWikiWord{:href => "/nlab/show/propagation+of+singularities+theorem"} propagation of singularities theorem
              (prop.
              %a.maruku-ref{:href => "#PropagationOfSingularitiesTheorem"}
              below) says that the
              %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
              of the solution evolves in spacetime along the direction of those
              %a.existingWikiWord{:href => "/nlab/show/wave+vectors"} wave vectors
              in which the Fourier transform exhibits high UV constributions. This means that these directions are the “wave front” of the distributional solution. Accordingly, the
              %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
              of a distribution together with, over each of its points, the
              %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} directions
              of
              %a.existingWikiWord{:href => "/nlab/show/wave+vectors"} wave vectors
              in which the Fourier transform around that point has large UV constributions is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              of the distribution (def.
              %a.maruku-ref{:href => "#WaveFrontSet"}
              below).
            %p
              What is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/microlocal+analysis"} microlocal analysis
              is essentially the analysis of
              %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              with attention to their
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/wave+vector"} wave vector
              %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} directions
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/UV+divergences"} UV divergences
            %p
              In particular the
              %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
              is well defined (only) if the
              %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
              of the distributions to not “collide”. And this in fact motivates the definition of the wave front set:
            %p
              To see this, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ,
                    %mi v
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u,v \in  \mathcal{D}'(\mathbb{R}^1)
              be two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            %p
              Since the product
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ⋅
                      %mi v
                    %annotation{:encoding => "application/x-tex"} u \cdot v
              %em pointwise
              product of smooth functions, it must be fixed locally: for every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}
              there ought to be a
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+function"} compactly supported
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              (
              %a.existingWikiWord{:href => "/nlab/show/bump+function"}> bump function
              )
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R})
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f(x) = 1
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mn 2
                    %mi u
                    %mo ⋅
                    %mi v
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    b^2 u \cdot v = (b u) \cdot (b v)
                    \\,.
            %p
              But now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mi v
                  %annotation{:encoding => "application/x-tex"} b v
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mi u
                  %annotation{:encoding => "application/x-tex"} b u
              are both
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distributions"} compactly supported distributions
              (def.
              %a.maruku-ref{:href => "#PropductOfDistributionWithASmoothFunction"}
              below), and these have the special property that their
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transforms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi b
                        %mi v
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{b v}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi b
                        %mi u
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{b u}
              are, in particular,
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              (by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"} Paley-Wiener-Schwartz theorem
              = succeed ")." do
                %a.maruku-ref{:href => "#PaleyWienerSchwartzTheorem"}
            %p
              Moreover, the operation of
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
              interchanges pointwise products with
              %a.existingWikiWord{:href => "/nlab/show/convolution+products"} convolution products
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#BasicPropertiesOfFourierTransformOverCartesianSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ⋅
                    %mi v
                  %annotation{:encoding => "application/x-tex"} u \cdot v
              exists, it must locally be given by the
              %a.existingWikiWord{:href => "/nlab/show/inverse+Fourier+transform"} inverse Fourier transform
              of the
              %a.existingWikiWord{:href => "/nlab/show/convolution+product"} convolution product
              of the Fourier transforms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi b
                        %mi u
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat {b u}
              and
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi b
                        %mo ^
                      %mi v
                    %annotation{:encoding => "application/x-tex"} \widehat b v
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %msup
                          %mi b
                          %mn 2
                        %mi u
                        %mo ⋅
                        %mi v
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi k
                            %mi max
                          %mo →
                          %mn ∞
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mo ∫
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mi k
                          %mi max
                      %mrow
                        %msub
                          %mi k
                          %mi max
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mi u
                        %mo{:stretchy => "false"} )
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mi v
                        %mo{:stretchy => "false"} )
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mi d
                    %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{ b^2 u \cdot v }(x)
                    \\;=\;
                    \\underset{\underset{k_{max} \to \infty}{\longrightarrow}}{\lim}
                    \\,
                    \\int_{- k_{max}}^{k_{max}} \widehat{(b u)}(k) \widehat{(b v)}(x - k) d k
                    \\,.
            %p
              (Notice that the converse of this formula holds as a fact by prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#FourierTransformOfDistributionsInterchangesConvolutionOfDistributionsWithPointwiseProduct"}
            %p
              This shows that the
              %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
              exists once there is a
              %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              such that the
              %a.existingWikiWord{:href => "/nlab/show/integral"} integral
              on the right converges as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mi max
                      %mo →
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} k_{max} \to \infty
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"} Paley-Wiener-Schwartz theorem
              says more, it says that the Fourier transforms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi b
                        %mi u
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat {b u}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi b
                        %mi u
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat {b u}
              are polynomially bounded. On the other hand, the
              %a.existingWikiWord{:href => "/nlab/show/integral"} integral
              above is well defined if the
              %a.existingWikiWord{:href => "/nlab/show/integrand"} integrand
              decreases at least quadratically with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo →
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} k \to \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi b
                        %mi u
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat {b u}
              has to polynomially decrease faster with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo →
                    %mo ±
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} k \to \pm \infty
              than
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi b
                        %mi v
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat {b v}
              grows in the
              %em other
              direction,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo →
                    %mo ∓
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} k \to \mp \infty
              (due to the minus sign in the argument of the second factor in the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/convolution+product"} convolution product
            %p
              Moreover, the degree of polynomial growth of the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
              increases by one with each
              %a.existingWikiWord{:href => "/nlab/show/derivative+of+distributions"} derivative
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#DistributionalDerivatives"}
              %a.existingWikiWord{:href => "/nlab/show/product+law"} product law
              for
              %a.existingWikiWord{:href => "/nlab/show/derivatives+of+distributions"} derivatives of distributions
              is to hold generally, we need that either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi b
                        %mi u
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{b u}
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi b
                        %mi v
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{b v}
              decays faster than
              %em any
              polynomial in the opposite of the directions in which the respective other factor does not decay.
            %p
              Here the set of directions of wave vectors in which the Fourier transform of a distribution localized around any point does not decay exponentially is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
              of a distribution (def.
              %a.maruku-ref{:href => "#WaveFrontSet"}
              below). Hence the condition that the product of two distributions is well defined is that for each wave vector direction in the wave front set of one of the two distributions, the opposite direction must not be an element of the wave front set of the other distribution. This is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
              (prop.
              %a.maruku-ref{:href => "#HoermanderCriterionForProductOfDistributions"}
              below).
            %p We now say this in detail:
            #RestrictionOfDistributions.num_defn
              %h6#definition_6 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/restriction+of+distributions"}> restriction of distributions
                  )
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊂
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} U \subset \mathbb{R}^n
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(\mathbb{R}^n)
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                %em
                  %a.existingWikiWord{:href => "/nlab/show/restriction+of+distributions"} restriction
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                is the distribution
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi U
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      u\vert_U \in \mathcal{D}'(U)
              %p
                give by restricting
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
                to test functions whose
                %a.existingWikiWord{:href => "/nlab/show/support"} support
                is in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
            #SingularSupportOfADistribution.num_defn
              %h6#definition_7 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/singular+support+of+a+distribution"}> singular support of a distribution
                  )
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mo ∈
                        %mi 𝒟
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(\mathbb{R}^n)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^n
                is a
                %em singular point
                if there is no
                %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊂
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} U \subset \mathbb{R}^n
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                such that the
                %a.existingWikiWord{:href => "/nlab/show/restriction+of+distributions"} restriction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi U
                    %annotation{:encoding => "application/x-tex"} u\vert_U
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#RestrictionOfDistributions"}
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular distribution
                (given by a
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %p
                The set of all singular points is the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi supp
                        %mi sing
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} supp_{sing}(u) \subset \mathbb{R}^n
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                      %annotation{:encoding => "application/x-tex"} u
            #PropductOfDistributionWithASmoothFunction.num_defn
              %h6#definition_8 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of a distribution
                  with a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(\mathbb{R}^n)
                be a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R}^n)
                a smooth function. Then the
                %em product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mi u
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f u \in \mathcal{D}'(\mathbb{R}^n)
                is the evident
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                given on a test function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R}^n)
                by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mi u
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi u
                      %mo ↦
                      %mi u
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ⋅
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                    %annotation{:encoding => "application/x-tex"}
                      f u
                      \\;\colon\;
                      u
                      \\mapsto
                      u(f \cdot b)
                      \\,
            #DecayPropertyOfFourierTransformOfCompactlySupportedFunctions.num_prop
              %h6#proposition_8 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"} Paley-Wiener-Schwartz theorem
                  II – decay of
                  %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/compactly+supported+functions"} compactly supported functions
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi ℰ
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \in \mathcal{E}'(\mathbb{R}^n)
                is non-
                %a.existingWikiWord{:href => "/nlab/show/singular+support+of+a+distribution"}> singular
                , hence given by a
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+function"} compactly supported function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R}^n)
                via
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo ∫
                        %mi b
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mi dvol
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} u(f) = \int b(x) f(x) dvol(x)
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+a+distribution"} Fourier transform
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat u
                (
                %a{:href => "compactly+supported+distribution#FourierTransformOfCompactlySupportedDistribution"}> this def.
                ) satisfies the following decay property:
              %p
                For all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
                there exists
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi N
                      %mo ∈
                      %msub
                        %mi ℝ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} C_N \in \mathbb{R}_+
                such that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{R}^n
                we have that the
                %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {\vert \hat v(k)\vert}
                of the Fourier transform at that point is bounded by
              #eq:DecayEstimateForFourierTransformOfNonSingularDistribution.maruku-equation
                %span.maruku-eq-number (130)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mo ≤
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi C
                        %mi N
                      %msup
                        %mrow
                          %mo (
                          %mn 1
                          %mo +
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi k
                            %mo{:stretchy => "false"} |
                          %mo )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi N
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      {\vert \hat v(k)\vert}
                      \\;\leq\;
                      C_N \left( 1 + {\vert k\vert} \right)^{-N}
                      \\,.
            %p
              (
              %a{:href => "Paley-Wiener-Schwartz+theorem#Hoermander90"}> Hörmander 90, around (8.1.1)
              )
            #UltravioletDivergencesFromPaleyWiener.num_remark
              %h6#remark_2 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/ultraviolet+divergences"}> ultraviolet divergences
                  )
              %p
                In words, the
                %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"} Paley-Wiener-Schwartz theorem
                II (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DecayPropertyOfFourierTransformOfCompactlySupportedFunctions"}
                %a.existingWikiWord{:href => "/nlab/show/singular+support"} singularities
                of a
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                “in position space” are reflected in non-decaying contributions of high
                %a.existingWikiWord{:href => "/nlab/show/frequencies"} frequencies
                (small
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/wavelength"} wavelength
                = succeed "-decomposition" do
                  %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier mode
                = succeed ")." do
                  %a.maruku-ref{:href => "#FourierTransformOnTemperedDistributions"}
                %a.existingWikiWord{:href => "/nlab/show/light+waves"} light waves
                one associates high
                %a.existingWikiWord{:href => "/nlab/show/frequency"} frequency
                with the “ultraviolet”, we may think of these as “ultaviolet contributions”.
              %p
                But apart from the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/wavelength"} wavelength
                %a.existingWikiWord{:href => "/nlab/show/wave+vector"} wave vector
                that the
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
                depends on also encodes the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} direction
                of the corresponding
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/plane+wave"} plane wave
                %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"} Paley-Wiener-Schwartz theorem
                says in more detail that a
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                is singular at some point already if along any
                %em one
                %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} direction
                of the
                %a.existingWikiWord{:href => "/nlab/show/wave+vector"} wave vector
                its local
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
                picks up ultraviolet contributions
                = succeed "." do
                  %em in that direction
              %p
                It therefore makes sense to record this extra directional information in the singularity structure of a distribution. This is called the
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#WaveFrontSet"}
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/microlocal+analysis"} microlocal analysis
              %p
                Moreover, the
                %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"} Paley-Wiener-Schwartz theorem
                I (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#PaleyWienerSchwartzTheorem"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/frequency"} frequency
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
                is not only singular, but is actually ill defined.
              %p
                Such
                %em
                  %a.existingWikiWord{:href => "/nlab/show/ultraviolet+divergences"} ultraviolet divergences
                appear notably when forming a would-be
                %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
                whose two factors have
                %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
                whose UV-contributions “add up”. This condition for the appearance/avoidance of
                %a.existingWikiWord{:href => "/nlab/show/UV-divergences"} UV-divergences
                is called
                %em
                  %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
                (prop.
                %a.maruku-ref{:href => "#HoermanderCriterionForProductOfDistributions"}
                below).
            #WaveFrontSet.num_defn
              %h6#definition_9 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/wavefront+set"}> wavefront set
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(\mathbb{R}^n)
                be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R}^n)
                a
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+function"} compactly supported
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mi u
                      %mo ∈
                      %mi ℰ
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b u \in \mathcal{E}'(\mathbb{R}^n)
                for the corresponding product (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#PropductOfDistributionWithASmoothFunction"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} x\in supp(b) \subset \mathbb{R}^n
                %a.existingWikiWord{:href => "/nlab/show/covector"} covector
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} k \in S((\mathbb{R}^n)^\ast)
                is
                %em regular
                if there exists a
                %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊂
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U \subset S((\mathbb{R}^n)^\ast)
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                in the
                %a.existingWikiWord{:href => "/nlab/show/unit+sphere"} unit sphere
                such that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mi k
                      %mo ′
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} c k' \in (\mathbb{R}^n)^\ast
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %msub
                        %mi ℝ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} c \in \mathbb{R}_+
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ′
                      %mo ∈
                      %mi U
                      %mo ⊂
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} k' \in U \subset S((\mathbb{R}^n)^\ast)
                the decay estimate
                %a.maruku-eqref{:href => "#eq:DecayEstimateForFourierTransformOfNonSingularDistribution"} (130)
                is valid for the
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi b
                          %mi u
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{b u}
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mi u
                      %annotation{:encoding => "application/x-tex"} b u
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mi k
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} c k'
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                is
                = succeed "." do
                  %em non-regular
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo {
                        %mi k
                        %mo ∈
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mi k
                        %mspace{:width => "thinmathspace"}
                        %mtext non-regular
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\Sigma(b u)
                      \\;\coloneqq\;
                      \\left\{
                      k \in S((\mathbb{R}^n)^\ast)
                      \\;\vert\;
                      k \, \text{non-regular}
                      \\right\}
              %p
                for the set of non-regular covectors of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mi u
                      %annotation{:encoding => "application/x-tex"} b u
              %p
                The
                %em
                  wave front set at
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                is the
                %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
                of these sets as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
                ranges over
                %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
                whose
                %a.existingWikiWord{:href => "/nlab/show/support"} support
                includes
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ∩
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mi b
                              %mo ∈
                              %msubsup
                                %mi C
                                %mi cp
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi ℝ
                                %mi n
                              %mo{:stretchy => "false"} )
                          %mrow
                            %mrow
                              %mi x
                              %mo ∈
                              %mi supp
                              %mo{:stretchy => "false"} (
                              %mi b
                              %mo{:stretchy => "false"} )
                      %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Sigma_x(u)
                      \\;\coloneqq\;
                      \\underset{
                      { b \in C^\infty_{cp}(\mathbb{R}^n) }
                      \\atop
                      { x \in supp(b) }
                      }{\cap}
                      \\Sigma(b u)
                      \\,.
              %p
                Finally the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
                is the subset of the
                %a.existingWikiWord{:href => "/nlab/show/sphere+bundle"} sphere bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi T
                        %mo *
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S(T^\ast \mathbb{R}^n)
                which over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^n
                consists of
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Σ
                          %mi x
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msubsup
                          %mi T
                          %mi x
                          %mo *
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \Sigma_x(U) \subset T^\ast_x \mathbb{R}^n
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi WF
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ∪
                        %mrow
                          %mi x
                          %mo ∈
                          %msup
                            %mi ℝ
                            %mi n
                      %msub
                        %mi Σ
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ⊂
                      %mspace{:width => "thickmathspace"}
                      %mi S
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi T
                        %mo *
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      WF(u)
                      \\;\coloneqq\;
                      \\underset{x \in \mathbb{R}^n}{\cup}
                      \\Sigma_x(u)
                      \\;\subset\;
                      S(T^\ast \mathbb{R}^n)
              %p
                Often this is equivalently considered as the full
                %a.existingWikiWord{:href => "/nlab/show/conical+set"} conical set
                inside the
                %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
                generated by the unit covectors under multiplication with
                %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %p
              (
              %a{:href => "wavefron+set#Hoermander90"}> Hörmander 90, def. 8.1.2
              )
            #WaveFrontSetIsBundleOverSingularSupport.num_remark
              %h6#remark_3 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                  is the
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/UV+divergence"} UV divergence
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} direction
                  %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
                  over the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(\mathbb{R}^n)
                The
                %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"} Paley-Wiener-Schwartz theorem
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DecayPropertyOfFourierTransformOfCompactlySupportedFunctions"}
              %ol
                %li
                  %p
                    Forgetting the
                    %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} direction
                    %a.existingWikiWord{:href => "/nlab/show/covectors"} covectors
                    in the
                    %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi WF
                          %mo{:stretchy => "false"} (
                          %mi u
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} WF(u)
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#WaveFrontSet"}
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi u
                          %annotation{:encoding => "application/x-tex"} u
                    %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#SingularSupportOfADistribution"}
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi WF
                                  %mo{:stretchy => "false"} (
                                  %mi u
                                  %mo{:stretchy => "false"} )
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                              %mtr
                                %mtd
                                  %msub
                                    %mi supp
                                    %mi sing
                                  %mo{:stretchy => "false"} (
                                  %mi u
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %mo ↪
                                %mtd
                                  %msup
                                    %mi ℝ
                                    %mi n
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          WF(u)
                          \\\
                          \\downarrow
                          \\\
                          supp_{sing}(u) &amp;\hookrightarrow&amp; \mathbb{R}^n
                          }
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                    is
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
                    %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
                    is
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi u
                        %annotation{:encoding => "application/x-tex"} u
                    is a
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular distribution
            #NonSingularDistributionTrivialWaveFrontSet.num_example
              %h6#example_10 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                  of
                  %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular distribution
                  is
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
              %p
                By prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#DecayPropertyOfFourierTransformOfCompactlySupportedFunctions"}
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#WaveFrontSetIsBundleOverSingularSupport"}
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular distribution
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DistributionsAreGeneralizedFunctions"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                is
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular
                if its wave front set is empty:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mspace{:width => "thickmathspace"}
                      %mtext non-singular
                      %mphantom
                        %mi AA
                      %mo ⇔
                      %mphantom
                        %mi AA
                      %mi WF
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"}
                      u \in \mathcal{D}'\;\text{non-singular}
                      \\phantom{AA}
                      \\Leftrightarrow
                      \\phantom{AA}
                      WF(u) = \emptyset
            #WaveFrontOfDeltaDistribution.num_example
              %h6#example_11 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mn 0
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\delta_0 \in \mathcal{D}'(\mathbb{R}^n)
              %p
                given by
                %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
                at the origin. Its
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#WaveFrontSet"}
                %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} directions
                at the origin:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi WF
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi δ
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo {
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mi k
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mi n
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                        %mo }
                      %mo ⊂
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ×
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ≃
                      %msup
                        %mi T
                        %mo *
                      %msup
                        %mi ℝ
                        %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      WF(\delta_0)
                      \\;=\;
                      \\left\{
                      (0,k)
                      \\;\vert\;
                      k \in \mathbb{R}^n \setminus \{0\}
                      \\right\}
                      \\subset
                      \\mathbb{R}^n \times \mathbb{R}^n
                      \\simeq
                      T^\ast \mathbb{R}^n
                      \\,.
            .proof
              %h6#proof_5 Proof
              %p
                First of all the
                %a.existingWikiWord{:href => "/nlab/show/singular+support+of+a+distribution"} singular support
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SingularSupportOfADistribution"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \delta_0
                is clearly
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi supp
                          %mi sing
                        %mo{:stretchy => "false"} (
                        %mi δ
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} supp_{sing}(\delta(0)) = \{0\}
                %a.maruku-ref{:href => "#WaveFrontSetIsBundleOverSingularSupport"}
                the wave front set vanishes over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \setminus \{0\}
              %p
                At the origin, any bump function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
                supported around the origin with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} b(0) = 1
                satisfies
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ⋅
                      %mi δ
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi δ
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \cdot \delta(0) = \delta(0)
                and hence the wave front set over the origin is the set of covectors along which the
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi δ
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat \delta(0)
                does not suitably decay. But this Fourier transform is in fact a
                %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#FourierTransformOfDeltaDistribution"}
            #WaveFrontSetOfHeavisideDistribution.num_example
              %h6#example_12 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/step+function"} step function
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Θ
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Theta \in \mathcal{D}'(\mathbb{R}^1)
                be the
                %a.existingWikiWord{:href => "/nlab/show/Heaviside+step+function"} Heaviside step function
                given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Θ
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msubsup
                        %mo ∫
                        %mn 0
                        %mn ∞
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi d
                      %mi x
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Theta(b) \coloneqq \int_0^\infty b(x)\, d x
                      \\,.
              %p
                Its
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#WaveFrontSet"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi WF
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %mi k
                      %mo ≠
                      %mn 0
                      %mo{:stretchy => "false"} }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      WF(H) = \{(0,k) \vert k \neq 0\}
                      \\,.
            #WaveFrontSetOfCompactlySupportedDistributions.num_prop
              %h6#proposition_9 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                  of
                  %a.existingWikiWord{:href => "/nlab/show/convolution+of+distributions"} convolution of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distributions"} compactly supported distributions
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ,
                      %mi v
                      %mo ∈
                      %mi ℰ
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u,v \in \mathcal{E}'(\mathbb{R}^n)
                be two
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distributions"} compactly supported distributions
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#WaveFrontSet"}
                %a.existingWikiWord{:href => "/nlab/show/convolution+of+distributions"} convolution of distributions
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ConvolutionOfADistributionWithACompactlySupportedDistribution"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi WF
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo ⋆
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo {
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo +
                        %mi y
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi WF
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mtext and
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi WF
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      WF(u \star v)
                      \\;=\;
                      \\left\{
                      (x + y, k)
                      \\;\vert\;
                      (x,k) \in WF(u) \,\text{and}\, (y,k) \in WF(u)
                      \\right\}
                      \\,.
            %p
              (
              %a{:href => "convolution+product+of+distributions#Bengel77"}> Bengel 77, prop. 3.1
              )
            #HoermanderCriterionForProductOfDistributions.num_prop
              %h6#proposition_10 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/H%C3%B6rmander%27s+criterion"} Hörmander's criterion
                  for
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ,
                      %mi v
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u, v \in \mathcal{D}'(\mathbb{R}^n)
                be two
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
                %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
                (def
                = succeed ")" do
                  %a.maruku-ref{:href => "#WaveFrontSet"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %msubsup
                        %mi T
                        %mi x
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} v \in T^\ast_x X
                a
                %a.existingWikiWord{:href => "/nlab/show/covector"} covector
                contained in one of the two wave front sets then the covector
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi v
                      %mo ∈
                      %msubsup
                        %mi T
                        %mi x
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} -v \in T^\ast_x X
                with the opposite
                %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} direction
                in
                %em not
                contained in the other wave front set, i.e. the
                %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                inside the
                %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi T
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T^\ast X
                of the pointwise
                %a.existingWikiWord{:href => "/nlab/show/sum"} sum
                of wave fronts with the
                %a.existingWikiWord{:href => "/nlab/show/zero+section"} zero section
                is
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mi WF
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi u
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi WF
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi u
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo )
                      %munder
