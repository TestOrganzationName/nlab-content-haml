                            %mo )
                          %mo *
                      %annotation{:encoding => "application/x-tex"} LinObs(E,\mathbf{L}) \simeq \left( ker(P)\right)^\ast
                %a.existingWikiWord{:href => "/nlab/show/dual+topological+vector+space"} dual topological vector space
                on the right. With this the second and third statement follows by prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#DistributionsOnSolutionSpaceAreTheGeneralizedPDESolutions"}
            %p
