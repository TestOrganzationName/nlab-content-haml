                        %mi X
                      %mo ∈
                      %msub
                        %mi 𝒞
                        %mrow
                          %msub
                            %mi I
                            %mn 1
                      %mo ∩
                      %msub
                        %mi 𝒞
                        %mrow
                          %msub
                            %mi I
                            %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{X} \in \mathcal{C}_{I_1} \cap \mathcal{C}_{I_2}
              %p a tuple of spacetime points which decomposes into causal order with respect to both these subsets, the corresponding mixed intersections of tuples are spacelike separated:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mn 1
                      %mo ∩
                      %mover
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi I
                            %mn 2
                        %mo ¯
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo &gt;
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mo &lt;
                      %mspace{:width => "thickmathspace"}
                      %mover
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi I
                            %mn 1
                        %mo ¯
                      %mo ∩
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{I}_1 \cap \overline{\mathbf{I}_2}
                      \\;
                      {\gt\!\!\!\!\lt}
                      \\;
                      \\overline{\mathbf{I}_1} \cap \mathbf{I}_2
                      \\,.
              %p
                By the assumption that the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi T
                        %mi k
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi k
                          %mo ≠
                          %mi n
                    %annotation{:encoding => "application/x-tex"} \{T_k\}_{k \neq n}
                satisfy causal factorization, this implies that the corresponding time-ordered products commute:
              #eq:TimeOrderedProductsOfMixedIntersectionsCommute.maruku-equation
                %span.maruku-eq-number (261)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mn 1
                      %mo ∩
                      %mover
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi I
                            %mn 2
                        %mo ¯
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mover
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi I
                            %mn 1
                        %mo ¯
                      %mo ∩
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mover
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi I
                            %mn 1
                        %mo ¯
                      %mo ∩
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi T
                      %mo{:stretchy => "false"} (
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mn 1
                      %mo ∩
                      %mover
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi I
                            %mn 2
                        %mo ¯
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      T(\mathbf{I}_1 \cap \overline{\mathbf{I}_2})
                      \\,
                      T(\overline{\mathbf{I}_1} \cap \mathbf{I}_2)
                      \\;=\;
                      T(\overline{\mathbf{I}_1} \cap \mathbf{I}_2)
                      \\,
                      T(\mathbf{I}_1 \cap \overline{\mathbf{I}_2})
                      \\,.
              %p
                Using this we find that the identifications of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} T_{n+1}
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mrow
                          %msub
                            %mi I
                            %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_{I_1}
                and on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mrow
                            %msub
                              %mi I
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_{I_2}
                = succeed "," do
                  %a.maruku-eqref{:href => "#eq:InductiveIdentificationOfTimeOrderedProductAwayFromDiagonal"} (260)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ∈
                      %msub
                        %mi 𝒞
                        %mrow
                          %msub
                            %mi I
                            %mn 1
                      %mo ∩
                      %msub
                        %mi 𝒞
                        %mrow
                          %msub
                            %mi I
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbf{X}  \in \mathcal{C}_{I_1} \cap \mathcal{C}_{I_2}
                we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi T
                              %mo{:stretchy => "false"} (
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi I
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mi T
                              %mo{:stretchy => "false"} (
                              %mover
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi I
                                    %mn 1
                                %mo ¯
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mi T
                              %mo{:stretchy => "false"} (
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi I
                                %mn 1
                              %mo ∩
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi I
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mi T
                              %mo{:stretchy => "false"} (
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi I
                                %mn 1
                              %mo ∩
                              %mover
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi I
                                    %mn 2
                                %mo ¯
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mi T
                              %mo{:stretchy => "false"} (
                              %mover
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi I
                                    %mn 1
                                %mo ¯
                              %mo ∩
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi I
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mi T
                              %mo{:stretchy => "false"} (
                              %mover
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi I
                                    %mn 1
                                %mo ¯
                              %mo ∩
                              %mover
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi I
                                    %mn 2
                                %mo ¯
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mi T
                              %mo{:stretchy => "false"} (
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi I
                                %mn 1
                              %mo ∩
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi I
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %munder
                                %mrow
                                  %mi T
                                  %mo{:stretchy => "false"} (
                                  %mover
                                    %mrow
                                      %msub
                                        %mstyle{:mathvariant => "bold"}
                                          %mi I
                                        %mn 1
                                    %mo ¯
                                  %mo ∩
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi I
                                    %mn 2
                                  %mo{:stretchy => "false"} )
                                  %mi T
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi I
                                    %mn 1
                                  %mo ∩
                                  %mover
                                    %mrow
                                      %msub
                                        %mstyle{:mathvariant => "bold"}
                                          %mi I
                                        %mn 2
                                    %mo ¯
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mi T
                              %mo{:stretchy => "false"} (
                              %mover
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi I
                                    %mn 1
                                %mo ¯
                              %mo ∩
                              %mover
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi I
                                    %mn 2
                                %mo ¯
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mi T
                              %mo{:stretchy => "false"} (
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi I
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mi T
                              %mo{:stretchy => "false"} (
                              %mover
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi I
                                    %mn 2
                                %mo ¯
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      T( \mathbf{I}_1 ) T( \overline{\mathbf{I}_1} )
                      \&amp; =
                      T( \mathbf{I}_1 \cap \mathbf{I}_2 )
                      T( \mathbf{I}_1 \cap \overline{\mathbf{I}_2} )
                      \\,
                      T( \overline{\mathbf{I}_1} \cap \mathbf{I}_2 )
                      T( \overline{\mathbf{I}_1} \cap \overline{\mathbf{I}_2} )
                      \\\
                      \&amp; =
                      T( \mathbf{I}_1 \cap \mathbf{I}_2 )
                      \\underbrace{
                      T( \overline{\mathbf{I}_1} \cap \mathbf{I}_2 )
                      T( \mathbf{I}_1 \cap \overline{\mathbf{I}_2} )
                      }
                      T( \overline{\mathbf{I}_1} \cap \overline{\mathbf{I}_2} )
                      \\\
                      \&amp; =
                      T( \mathbf{I}_2 )
                      T( \overline{\mathbf{I}_2} )
                      \\end{aligned}
              %p
                Here in the first step we expanded out the two factors using
                %a.maruku-eqref{:href => "#eq:InductiveIdentificationOfTimeOrderedProductAwayFromDiagonal"} (260)
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} I_2
                %a.maruku-eqref{:href => "#eq:TimeOrderedProductsOfMixedIntersectionsCommute"} (261)
                and in the last step we used again
                = succeed "," do
                  %a.maruku-eqref{:href => "#eq:InductiveIdentificationOfTimeOrderedProductAwayFromDiagonal"} (260)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} I_1
              %p To conclude, let
              #eq:PartitionCausalOfUnityForComplementOfDiagonal.maruku-equation
                %span.maruku-eq-number (262)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %mo (
                          %msub
                            %mi χ
                            %mi I
                          %mo ∈
                          %msubsup
                            %mi C
                            %mi cp
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Σ
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mi supp
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi χ
                            %mi I
                          %mo{:stretchy => "false"} )
                          %mo ⊂
                          %msub
                            %mi 𝒞
                            %mi i
                          %mo )
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mi I
                              %mo ⊂
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %mi n
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} }
                          %mrow
                            %mrow
                              %mi I
                              %mo ,
                              %mover
                                %mi I
                                %mo ¯
                              %mo ≠
                              %mi ∅
                    %annotation{:encoding => "application/x-tex"}
                      \\left(
                      \\chi_I
                      \\in
                      C^\infty_{cp}(\Sigma^{n+1}),
                      \\,
                      supp(\chi_I) \subset \mathcal{C}_i
                      \\right)_{ { I \subset \{1, \cdots, n+1\} } \atop { I, \overline{I} \neq \emptyset } }
              %p
                be a
                %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
                subordinate to the
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                formed by the
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mi I
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_I
              %p
                Then the above implies that setting for any
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ∈
                      %msup
                        %mi Σ
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo ∖
                      %mi diag
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{X} \in \Sigma^{n+1} \setminus diag(\Sigma)
              #eq:TimeOrderedProductsAwayFromDiagonalByInduction.maruku-equation
                %span.maruku-eq-number (263)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mi I
                              %mo ∈
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo ,
                              %mi ⋯
                              %mo ,
