            %p This we explain now.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#LorentzGroupAndSpinGroup
              %strong Lorentz group and spin group
            #LorentzGroup.num_defn
              %h6#definition_9 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"}> Lorentz group
                  )
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      O(d-1,1)  \hookrightarrow GL(\mathbb{R}^d)
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                of the
                %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
                on those
                %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                which preserve this bilinear form on
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                (def
                = succeed ")," do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\eta(A(-),A(-)) = \eta(-,-)
                      \\,.
              %p
                This is the
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz group
                in dimension
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
              %p
                The elements in the Lorentz group in the image of the
                %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SO
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SO(d-1) \hookrightarrow O(d-1,1)
                are
                %em
                  %a.existingWikiWord{:href => "/nlab/show/rotations"} rotations
                in space. The further elements in the special Lorentz group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SO(d-1,1)
                %em
                  %a.existingWikiWord{:href => "/nlab/show/boosts"} boosts
                in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/physics"} physics
              %p
                One distinguishes the following further
                %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
                of the
                %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz group
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(d-1,1)
              %ul
                %li
                  %p
                    the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/proper+Lorentz+group"} proper Lorentz group
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ↪
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          SO(d-1,1) \hookrightarrow O(d-1,1)
                  %p
                    is the subgroup of elements which have
                    %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
                    +1 (as elements
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ↪
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SO(d-1,1)\hookrightarrow GL(d)
                    of the
                    = succeed ");" do
                      %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
                %li
                  %p
                    the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/proper+orthochronous+Lorentz+group"} proper orthochronous
                    (or
                    = succeed ")" do
                      %em restricted
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi SO
                            %mo +
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ↪
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          SO^+(d-1,1) \hookrightarrow SO(d-1,1)
                  %p
                    is the further
                    %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                    of elements
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                    which preserve the time orientation of vectors
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                        %annotation{:encoding => "application/x-tex"} v
                    in that
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi v
                              %mn 0
                            %mo &gt;
                            %mn 0
                            %mo{:stretchy => "false"} )
                            %mo ⇒
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mi v
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 0
                            %mo &gt;
                            %mn 0
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (v^0 \gt 0) \Rightarrow ((A v)^0 \gt 0)
            #ConnectedComponentsOfLorentzGroup.num_prop
              %h6#proposition_8 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz group
              %p
                As a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(d-1,1)
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LorentzGroup"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
                %a.existingWikiWord{:href => "/nlab/show/proper+orthochronous+Lorentz+group"} proper orthochronous Lorentz group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi SO
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SO^+(3,1)
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#LorentzGroup"}
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi SO
                            %mo +
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi P
                        %annotation{:encoding => "application/x-tex"} SO^+(d-1,1)\cdot P
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi SO
                            %mo +
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi T
                        %annotation{:encoding => "application/x-tex"} SO^+(d-1,1)\cdot T
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msup
                            %mi SO
                            %mo +
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi P
                          %mi T
                        %annotation{:encoding => "application/x-tex"} SO^+(d-1,1)\cdot P T
                    ,
              %p
                where, as
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ≔
                      %mi diag
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      P \coloneqq diag(1,-1,-1, \cdots, -1)
              %p is the operation of point reflection at the origin in space, where
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ≔
                      %mi diag
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      T \coloneqq diag(-1,1,1, \cdots, 1)
              %p is the operation of reflection in time and hence where
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mi T
                      %mo =
                      %mi T
                      %mi P
                      %mo =
                      %mi diag
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      P T = T P = diag(-1,-1, \cdots, -1)
              %p is point reflection in spacetime.
            %p
              The following concept of the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CliffordAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              encodes the structure of the
              %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
              in terms of algebraic operation (“
              %a.existingWikiWord{:href => "/nlab/show/geometric+algebra"}> geometric algebra
              ”), such that the action of the
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz group
              becomes represented by a
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              (example
              %a.maruku-ref{:href => "#CliffordConjugtionReflectionAndRotation"}
              below). In particular this means that every element of the proper orthochronous Lorentz group may be “split in half” to yield a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/double+cover"} double cover
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              (def.
              %a.maruku-ref{:href => "#SpinGroup"}
              below).
            #CliffordAlgebra.num_defn
              %h6#definition_10 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"}> Clifford algebra
                  )
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Cl(\mathbb{R}^{d-1,1})
              %p
                for the
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                which is generated from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                generators
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi Γ
                        %mn 0
                      %mo ,
                      %msub
                        %mi Γ
                        %mn 1
                      %mo ,
                      %msub
                        %mi Γ
                        %mn 2
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi Γ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\Gamma_0, \Gamma_1, \Gamma_2, \cdots, \Gamma_{d-1}\}
                in odd degree (“Clifford generators”), subject to the
                %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} relation
              #eq:RelationCliffordAlgebra.maruku-equation
                %span.maruku-eq-number (11)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi a
                      %msub
                        %mi Γ
                        %mi b
                      %mo +
                      %msub
                        %mi Γ
                        %mi b
                      %msub
                        %mi Γ
                        %mi a
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                      %msub
                        %mi η
                        %mrow
                          %mi a
                          %mi b
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma_{a} \Gamma_b + \Gamma_b \Gamma_a = - 2\eta_{a b}
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                is the
                %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
                of
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                as in def.
                = succeed "." do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %p These relations say equivalently that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                            %mtd
                              %msubsup
                                %mi Γ
                                %mn 0
                                %mn 2
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                              %mn 1
                          %mtr
                            %mtd
                            %mtd
                              %msubsup
                                %mi Γ
                                %mi i
                                %mn 2
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mtext for
                              %mspace{:width => "thickmathspace"}
                              %mi i
                              %mo ∈
                              %mo{:stretchy => "false"} {
                              %mn 1
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %mi d
                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} }
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mi Γ
                                %mi a
                              %msub
                                %mi Γ
                                %mi b
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi Γ
                                %mi b
                              %msub
                                %mi Γ
                                %mi a
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mtext for
                              %mspace{:width => "thickmathspace"}
                              %mi a
                              %mo ≠
                              %mi b
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \&amp; \Gamma_0^2 = +1
                      \\\
                      \&amp; \Gamma_i^2 = -1 \;\; \text{for}\; i \in \{1,\cdots, d-1\}
                      \\\
                      \&amp; \Gamma_a \Gamma_b = - \Gamma_b \Gamma_a \;\;\; \text{for}\; a \neq b
                      \\end{aligned}
                      \\,.
              %p We write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi a
                            %mi p
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mi p
                          %mo !
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mi permutations
                          %mrow
                            %mi σ
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi σ
                          %mo{:stretchy => "false"} |
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mrow
                              %mi σ
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                      %mi ⋯
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mrow
                              %mi σ
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma_{a_1 \cdots a_p}
                      \\;\coloneqq\;
                      \\frac{1}{p!}
                      \\underset{{permutations \atop \sigma}}{\sum} (-1)^{\vert \sigma\vert } \Gamma_{a_{\sigma(1)}} \cdots \Gamma_{a_{\sigma(p)}}
              %p
                for the antisymmetrized product of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                Clifford generators. In particular, if all the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mi i
                    %annotation{:encoding => "application/x-tex"} a_i
                are pairwise distinct, then this is simply the plain product of generators
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi a
                            %mi n
                      %mo =
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                      %mi ⋯
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mi n
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mtext if
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ∀
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi i
                      %mo ≠
                      %msub
                        %mi a
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma_{a_1 \cdots a_n}
                      \=
                      \\Gamma_{a_1} \cdots \Gamma_{a_n}
                      \\;\;\;
                      \\text{if}
                      \\;
                      \\underset{i,j}{\forall} (a_i \neq a_j)
                      \\,.
              %p Finally, write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mo ¯
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\overline{(-)}
                      \\;\colon\;
                      Cl(\mathbb{R}^{d-1,1})
                      \\longrightarrow
                      Cl(\mathbb{R}^{d-1,1})
              %p
                for the algebra
                %a.existingWikiWord{:href => "/nlab/show/antihomomorphism"} anti-
                %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
                given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %msub
                            %mi Γ
                            %mi a
                        %mo ¯
                      %mo ≔
                      %msub
                        %mi Γ
                        %mi a
                    %annotation{:encoding => "application/x-tex"}
                      \\overline{\Gamma_a}
                      \\coloneqq
                      \\Gamma_a
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %msub
                            %mi Γ
                            %mi a
                          %msub
                            %mi Γ
                            %mi b
                        %mo ¯
                      %mo ≔
                      %msub
                        %mi Γ
                        %mi b
                      %msub
                        %mi Γ
                        %mi a
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\overline{\Gamma_a \Gamma_b}
                      \\coloneqq
                      \\Gamma_b \Gamma_a
                      \\,.
            #VectorsInsideCliffordAlgebra.num_remark
              %h6#remark_4 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/vectors"} vectors
                  inside
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              %p
                By construction, the
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                of
                %a.existingWikiWord{:href => "/nlab/show/linear+combinations"} linear combinations
                of the generators in a
                %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{d-1,1})
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CliffordAlgebra"}
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mo ^
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo ↪
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\widehat{(-)}
                      \\;\colon\;
                      \\mathbb{R}^{d-1,1}
                      \\hookrightarrow
                      Cl(\mathbb{R}^{d-1,1})
              %p via
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi a
                      %mo ↦
                      %msub
                        %mi Γ
                        %mi a
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      x_a \mapsto \Gamma_a
                      \\,,
              %p hence via
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo =
                      %msup
                        %mi v
                        %mi a
                      %msub
                        %mi x
                        %mi a
                      %mo ↦
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mo =
                      %msup
                        %mi v
                        %mi a
                      %msub
                        %mi Γ
                        %mi a
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      v = v^a x_a \mapsto \hat v = v^a \Gamma_a
                      \\,,
              %p
                such that the defining
                %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
                is identified with the
                %a.existingWikiWord{:href => "/nlab/show/anti-commutator"} anti-commutator
                in the Clifford algebra
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mn 1
                      %msub
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mn 2
                      %mo +
                      %msub
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mn 2
                      %msub
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\eta(v_1,v_2) = -\tfrac{1}{2}( \hat v_1 \hat v_2 + \hat v_2 \hat v_1)
                      \\,,
              %p
                where on the right we are, in turn, identifying
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                with the linear span of the unit in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mi d
                            %mo −
                            %mn 1
                            %mo ,
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{d-1,1})
            %p
              The key point of the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CliffordAlgebra"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/reflections"} reflections
              %a.existingWikiWord{:href => "/nlab/show/rotations"} rotations
              and
              %a.existingWikiWord{:href => "/nlab/show/boosts"} boosts
              via
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/conjugation+actions"} conjugation actions
            #CliffordConjugtionReflectionAndRotation.num_example
              %h6#example Example
              %p
                %strong (Clifford conjugation)
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
                the
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                of def.
                = succeed "," do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} v \in \mathbb{R}^{d-1,1}
                be any
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/vector"} vector
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mo ∈
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat v \in Cl(\mathbb{R}^{d-1,1})
                via remark
                = succeed "." do
                  %a.maruku-ref{:href => "#VectorsInsideCliffordAlgebra"}
              %p Then
              %ol
                %li
                  the
                  %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mo ↦
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msubsup
                          %mi Γ
                          %mi a
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %msub
                          %mi Γ
                          %mi a
                      %annotation{:encoding => "application/x-tex"} \hat v \mapsto -\Gamma_a^{-1} \hat v \Gamma_a
                  of a single Clifford generator
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Γ
                          %mi a
                      %annotation{:encoding => "application/x-tex"} \Gamma_a
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat v
                  sends
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                      %annotation{:encoding => "application/x-tex"} v
                  to its
              %p
                %a.existingWikiWord{:href => "/nlab/show/reflection"} reflection
                at the hyperplane
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mi a
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} x_a = 0
              %ol
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                          %mo ↦
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mi α
                              %mn 2
                          %msub
                            %mi Γ
                            %mrow
                              %mi a
                              %mi b
                          %mo{:stretchy => "false"} )
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mi α
                              %mn 2
                          %msub
                            %mi Γ
                            %mrow
                              %mi a
                              %mi b
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          \\hat v \mapsto \exp(- \tfrac{\alpha}{2} \Gamma_{a b}) \hat v \exp(\tfrac{\alpha}{2} \Gamma_{a b})
                  %p
                    sends
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                        %annotation{:encoding => "application/x-tex"} v
                    to the result of
                    %a.existingWikiWord{:href => "/nlab/show/rotation"} rotating
                    it in the
                    = succeed "-plane" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi b
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (a,b)
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi α
                          %annotation{:encoding => "application/x-tex"} \alpha
            .proof
              %h6#proof_5 Proof
              %p This is immediate by inspection:
              %p
                For the first statement, observe that conjugating the Clifford generator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi b
                    %annotation{:encoding => "application/x-tex"} \Gamma_b
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \Gamma_a
                yields
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi b
                    %annotation{:encoding => "application/x-tex"} \Gamma_b
                up to a sign, depending on whether
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a = b
                or not:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msubsup
                        %mi Γ
                        %mi a
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msub
                        %mi Γ
                        %mi b
                      %msub
                        %mi Γ
                        %mi a
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msub
                                  %mi Γ
                                  %mi b
                              %mtd
                                %mo{:stretchy => "false"} |
                                %mtext if
                                %mspace{:width => "thinmathspace"}
                                %mi a
                                %mo =
                                %mi b
                            %mtr
                              %mtd
                                %msub
                                  %mi Γ
                                  %mi b
                              %mtd
                                %mo{:stretchy => "false"} |
                                %mtext otherwise
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \- \Gamma_a^{-1} \Gamma_b \Gamma_a
                      \=
                      \\left\{
                      \\array{
                      \-\Gamma_b &amp; \vert \text{if}\, a = b
                      \\\
                      \\Gamma_b &amp; \vert \text{otherwise}
                      }
                      \\right.
                      \\,.
              %p
                Therefore for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mo =
                      %msup
                        %mi v
                        %mi b
                      %msub
                        %mi Γ
                        %mi b
                    %annotation{:encoding => "application/x-tex"} \hat v = v^b \Gamma_b
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Γ
                        %mi a
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %msub
                        %mi Γ
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \Gamma_a^{-1} \hat v \Gamma_a
                is the result of multiplying the
                = succeed "-component" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} -1
              %p For the second statement, observe that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi Γ
                        %mrow
                          %mi a
                          %mi b
                      %mo ,
                      %msub
                        %mi Γ
                        %mi c
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %msub
                        %mi Γ
                        %mi a
                      %msub
                        %mi η
                        %mrow
                          %mi b
                          %mi c
                      %mo −
                      %msub
                        %mi Γ
                        %mi b
                      %msub
                        %mi η
                        %mrow
                          %mi a
                          %mi c
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \-\tfrac{1}{2}[\Gamma_{a b}, \Gamma_c]
                      \=
                      \\Gamma_a \eta_{b c} - \Gamma_b \eta_{a c}
                      \\,.
              %p
                This is the canonical action of the Lorentzian
                %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+Lie+algebra"} special orthogonal Lie algebra
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰𝔬
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{so}(d-1,1)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi α
                          %mn 2
                      %msub
                        %mi Γ
                        %mi ab
                      %mo{:stretchy => "false"} )
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi α
                          %mn 2
                      %msub
                        %mi Γ
                        %mi ab
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi Γ
                        %mrow
                          %mi a
                          %mi b
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\exp(-\tfrac{\alpha}{2} \Gamma_{ab}) \hat v \exp(\tfrac{\alpha}{2} \Gamma_{ab})
                      \=
                      \\exp(\tfrac{1}{2}[\Gamma_{a b}, -])(\hat v)
              %p is the rotation action as claimed.
            #AmbiguityInCliffordConjugation.num_remark
              %h6#remark_5 Remark
              %p
                Since the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/reflections"} reflections
                %a.existingWikiWord{:href => "/nlab/show/rotations"} rotations
                and
                %a.existingWikiWord{:href => "/nlab/show/boosts"} boosts
                in example
                %a.maruku-ref{:href => "#CliffordConjugtionReflectionAndRotation"}
                are given by
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/conjugation+actions"} conjugation actions
              %ol
                %li
                  %p
                    the conjugation action by
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Γ
                            %mi a
                        %annotation{:encoding => "application/x-tex"} \Gamma_a
                    coincides precisely with the conjugation action by
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi Γ
                              %mi a
                          %annotation{:encoding => "application/x-tex"} -\Gamma_a
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
                    by
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mi α
                              %mn 4
                          %msub
                            %mi Γ
                            %mrow
                              %mi a
                              %mi b
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \exp(\tfrac{\alpha}{4} \Gamma_{a b})
                    coincides precisely with the conjugation action by
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mi α
                                %mn 2
                            %msub
                              %mi Γ
                              %mrow
                                %mi a
                                %mi b
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} -\exp(\tfrac{\alpha}{2}\Gamma_{a b})
            #SpinGroup.num_defn
              %h6#definition_11 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/spin+group"}> spin group
                  )
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
                is the group of even graded elements of the Clifford algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{d-1,1})
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CliffordAlgebra"}
                %a.existingWikiWord{:href => "/nlab/show/unitary+operator"} unitary
                with respect to the conjugation operation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{(-)}
                from def.
                = succeed ":" do
                  %a.maruku-ref{:href => "#CliffordAlgebra"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo {
                        %mi A
                        %mo ∈
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mi d
                            %mo −
                            %mn 1
                            %mo ,
                            %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi even
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mover
                          %mi A
                          %mo ¯
                        %mi A
                        %mo =
                        %mn 1
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Spin(d-1,1)
                      \\;\coloneqq\;
                      \\left\{
                      A \in Cl(\mathbb{R}^{d-1,1})_{even}
                      \\;\vert\;
                      \\overline{A} A = 1
                      \\right\}
                      \\,.
            #SpinDoubleCover.num_prop
              %h6#proposition_9 Proposition
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/function"} function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Spin(d-1,1)
                      \\longrightarrow
                      GL(\mathbb{R}^{d-1,1})
              %p
                from the
                %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SpinGroup"}
                %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
                in
                = succeed "-dimensions" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \in Spin(d-1,1) \hookrightarrow Cl(\mathbb{R}^{d-1,1})
                to the
                %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo ¯
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mi A
                    %annotation{:encoding => "application/x-tex"}
                      \\overline{A}(-) A
              %p
                (via the identification of Minkowski spacetime as the subspace of the
                %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
                containing the
                %a.existingWikiWord{:href => "/nlab/show/linear+combinations"} linear combinations
                of the generators, according to remark
                = succeed ")" do
                  %a.maruku-ref{:href => "#VectorsInsideCliffordAlgebra"}
              %p is
              %ol
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/group"} group
                    %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                    onto the
                    %a.existingWikiWord{:href => "/nlab/show/proper+orthochronous+Lorentz+group"} proper orthochronous Lorentz group
                    (def.
                    = succeed "):" do
                      %a.maruku-ref{:href => "#LorentzGroup"}
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ⟶
                          %msup
                            %mi SO
                            %mo +
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          Spin(d-1,1) \longrightarrow SO^+(d-1,1)
                %li
                  %p
                    exhibiting a
                    = succeed "-" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mn 2
                          %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
            .proof
              %h6#proof_6 Proof
              %p
                That the function is a group homomorphism into the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
                %a.existingWikiWord{:href => "/nlab/show/linear+transformations"} linear transformations
                on the generators follows by using that it clearly lands in
                %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
                of the Clifford algebra.
              %p
                That the function lands in the
                %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(d-1,1) \hookrightarrow GL(d)
                follows from remark
                = succeed ":" do
                  %a.maruku-ref{:href => "#VectorsInsideCliffordAlgebra"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
