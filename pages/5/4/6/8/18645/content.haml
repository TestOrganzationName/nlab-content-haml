                by
              #eq:InductiveIdentificationOfTimeOrderedProductAwayFromDiagonal.maruku-equation
                %span.maruku-eq-number (240)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mi n
