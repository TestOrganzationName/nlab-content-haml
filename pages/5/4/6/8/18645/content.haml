            #InteractingFieldObservables.num_defn
              %h6#definition_5 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
                  –
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Bogoliubov%27s+formula"} Bogoliubov's formula
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
