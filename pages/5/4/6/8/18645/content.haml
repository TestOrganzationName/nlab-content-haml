              %p hence
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Θ
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Θ
                        %mi BV
                      %mo +
                      %munder
                        %munder
                          %mrow
                            %msub
                              %mi Θ
                              %mi BFV
                            %mo +
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                          %mo ⏟
                        %mi Lepage
                    %annotation{:encoding => "application/x-tex"}
                      \\Theta \;\coloneqq\; \Theta_{BV} + \underset{Lepage}{\underbrace{ \Theta_{BFV} + \mathbf{L} }}
              %p
                (where the sum of the two terms on the right is the
                %a.existingWikiWord{:href => "/nlab/show/Lepage+form"} Lepage form
                = succeed ")." do
