              %li
                %p
                  while at the same time all formulas (such as for the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations"} Euler-Lagrange equations
                  = succeed ")" do
                    %a.maruku-ref{:href => "#EulerLagrangeEquationsOnTrivialVectorFieldBundleOverMinkowskiSpacetime"}
            #JetBundleIsLocallyProManifold.num_prop
              %h6#proposition Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                  is a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/locally+pro-manifold"} locally pro-manifold
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
