                              %mi μ
                              %mi ν
                      %mo +
                      %msub
                        %mi c
                        %mrow
                          %mi μ
                          %mo ,
                          %mi ν
                          %mi ρ
                      %msub
                        %mo ∂
                        %mrow
                          %msub
                            %mi b
                            %mrow
                              %mi μ
                              %mi ν
                              %mo ,
                              %mi ρ
                      %mo +
                      %mi ⋯
                    %annotation{:encoding => "application/x-tex"}
