                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
            .proof
              %h6#proof Proof
              %p
                By prop.
                %a.maruku-ref{:href => "#HorizontalDerivativeOfPresymplecticCurrentVanishesOnShell"}
                the total spacetime derivative
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %msub
                        %mi Ω
                        %mi BFV
                    %annotation{:encoding => "application/x-tex"} d \Omega_{BFV}
                of the
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
                vanishes
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %msub
                        %mi Ω
                        %mi BFV
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi δ
                      %msub
                        %mi δ
                        %mi EL
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                    %annotation{:encoding => "application/x-tex"}
                      d \Omega_{BFV} = - \delta \delta_{EL} \mathbf{L}
              %p
                in that the
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#PullbackOfDifferential1FormsOnCartesianSpaces"}
                %a.existingWikiWord{:href => "/nlab/show/shell"} shell
                inclusion
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                      %mover
                        %mo ↪
                        %mrow
                          %msub
                            %mi i
                            %mi ℰ
                      %msubsup
                        %mi J
                        %mi Σ
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{E} \overset{i_{\mathcal{E}}}{\hookrightarrow} J^\infty_\Sigma(E)
                %a.maruku-eqref{:href => "#eq:ShellInJetBundle"} (51)
                vanishes:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi i
                                %mi ℰ
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mrow
                                %mo (
                                %mi d
                                %msub
                                  %mi Ω
                                  %mi BFV
                                %mo )
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi i
                                %mi ℰ
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mrow
                                %mo (
                                %mi δ
                                %msub
                                  %mi δ
                                  %mi EL
                                %mi ℒ
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi δ
                              %munder
                                %munder
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi i
                                      %mi ℰ
                                    %msup
                                      %mo{:stretchy => "false"} )
                                      %mo *
                                    %mrow
                                      %mo (
                                      %msub
                                        %mi δ
                                        %mi EL
                                      %mstyle{:mathvariant => "bold"}
                                        %mi L
                                      %mo )
                                  %mo ⏟
                                %mrow
                                  %mo =
                                  %mn 0
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      (i_{\mathcal{E}})^\ast
                      \\left(
                      d \Omega_{BFV}
                      \\right)
                      \&amp; =
                      \- (i_{\mathcal{E}})^\ast
                      \\left(
                      \\delta \delta_{EL} \mathcal{L}
                      \\right)
                      \\\
                      \&amp; =
                      \- \delta
                      \\underset{
                      \= 0
                      }{
                      \\underbrace{
                      (i_{\mathcal{E}})^\ast
                      \\left(
                      \\delta_{EL} \mathbf{L}
                      \\right)
                      }
                      }
                      \\\
                      \&amp; = 0
                      \\end{aligned}
              %p
                This implies that the transgression of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %msub
                        %mi Ω
                        %mi BFV
                    %annotation{:encoding => "application/x-tex"} d \Omega_{BFV}
                to the
                %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
                %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi Σ
                            %mi tra
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo =
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} \Gamma_{\Sigma_{tra}}(E)_{\delta_{EL}\mathbf{L} = 0}
                vanishes (since by definition
                %a.maruku-eqref{:href => "#eq:EquationOfMotionEL"} (65)
                that involves pulling back through the shell inclusion)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mrow
                          %msub
                            %mi Σ
                            %mi tra
                      %mo{:stretchy => "false"} (
                      %mi d
                      %msub
                        %mi Ω
                        %mi BFV
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\tau_{\Sigma_{tra}}(d \Omega_{BFV}) = 0
                      \\,.
              %p
                But then the claim follows with prop.
                = succeed ":" do
                  %a.maruku-ref{:href => "#TransgressionOfVariationaldifferentialFormsCompatibleWithVariationalDerivative"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo =
                              %msub
                                %mi τ
                                %mrow
                                  %msub
                                    %mi Σ
                                    %mi tra
                              %mo{:stretchy => "false"} (
                              %mi d
                              %msub
                                %mi Ω
                                %mi BFV
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} |
                                %mrow
                                  %msub
                                    %mi Σ
                                    %mi tra
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %msub
                                %mi τ
                                %mrow
                                  %mo ∂
                                  %msub
                                    %mi Σ
                                    %mi tra
                              %msub
                                %mi Ω
                                %mi BFV
                              %mspace{:width => "thinmathspace"}
                              %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      0
                      \&amp; =   \tau_{\Sigma_{tra}}(d \Omega_{BFV})
                      \\\
                      \&amp; = ((-)\vert_{\Sigma_{tra}})^\ast \tau_{\partial \Sigma_{tra}} \Omega_{BFV}
                      \\,.
                      \\end{aligned}
            #PPeierlsBracket.num_theorem
              %h6#theorem Theorem
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/polynomial+Poisson+algebra"} polynomial Poisson bracket
                  on
                  %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
                  – the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Peierls+bracket"} Peierls bracket
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                be a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %ol
                %li
                  %p
                    it is a
                    %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#FreeFieldTheory"}
                %li
                  %p
                    whose
                    %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
                    %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                          %mi Φ
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} P \Phi = 0
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#EulerLagrangeEquationsOnTrivialVectorFieldBundleOverMinkowskiSpacetime"}
                  %ol
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operator"} formally self-adjoint
                        or
                        %a.existingWikiWord{:href => "/nlab/show/formally+adjoint+differential+operator"} formally anti self-adjoint
                        (def.
                        = succeed ")" do
                          %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
                      %ul
                        %li
                          the integral over the witness
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mi K
                              %annotation{:encoding => "application/x-tex"} K
                          %a.maruku-eqref{:href => "#eq:FormallyAdjointDifferentialOperatorWitness"} (33)
                          is the
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
                        = succeed ":" do
                          %a.maruku-eqref{:href => "#eq:TransgressionOfPresymplecticCurrentToCauchySurface"} (115)
                        = succeed ";" do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %msub
                                  %mi ω
                                  %mrow
                                    %msub
                                      %mi Σ
                                      %mi p
                                %mo =
                                %munder
                                  %mo ∫
                                  %mrow
                                    %msub
                                      %mi Σ
                                      %mi p
                                %mi K
                              %annotation{:encoding => "application/x-tex"} \omega_{\Sigma_p} = \underset{\Sigma_p}{\int} K
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+operator"} Green hyperbolic
                        (def.
                        = succeed ")." do
                          %a.maruku-ref{:href => "#GreenHyperbolicDifferentialOperator"}
              %p Write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} G
                        %mi P
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi LinObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mi scp
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi reg
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi{:mathvariant => "normal"} G
                            %mi P
                      %msub
                        %mi Γ
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi scp
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo =
                          %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\mathrm{G}_P
                      \\;\colon\;
                      LinObs(E_{scp},\mathbf{L})^{reg}
                      \\overset{\mathrm{G}_P}{\longrightarrow}
                      \\Gamma_{\Sigma,scp}(E)_{\delta_{EL}\mathbf{L} = 0}
              %p
                for the linear map from regular linear field observables (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#RegularLinearFieldObservables"}
                %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
                with spatially compact support (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
                %a.maruku-eqref{:href => "#eq:RegularLinearObservablesAreCompactlySupportedSectionsModuloImageOfP"} (104)
                by the
                %a.existingWikiWord{:href => "/nlab/show/causal+Green+function"} causal Green function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} G
                        %mi P
                    %annotation{:encoding => "application/x-tex"} \mathrm{G}_P
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#AdvancedAndRetardedGreenFunctions"}
              %p
                Then for every
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi p
                      %mo ↪
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma_p \hookrightarrow \Sigma
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CauchySurface"}
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ω
                        %mrow
                          %msub
                            %mi Σ
                            %mi p
                    %annotation{:encoding => "application/x-tex"} \omega_{\Sigma_p}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#PhaseSpaceAssociatedWithCauchySurface"}
                = succeed "," do
                  %a.maruku-ref{:href => "#EvaluationOfTransgressedVariationalFormsOnTangentVectorsForFreeFieldTheory"}
              #eq:ForGreenHyperbolicFreeFieldTheoryCausalGreenFunctionIsInverseToPresymplecticFormOnRegularLinearObservables.maruku-equation
                %span.maruku-eq-number (116)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi ω
                                %mrow
                                  %msub
                                    %mi Σ
                                    %mi p
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi{:mathvariant => "normal"} G
                                %mi P
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thickmathspace"}
                              %mo =
                              %mspace{:width => "thickmathspace"}
                              %mi ev
                            %mtd
                              %mo{:lspace => "verythinmathspace"} :
                            %mtd
                              %mi LinObs
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi E
                                %mi scp
                              %mo ,
                              %mstyle{:mathvariant => "bold"}
                                %mi L
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi reg
                            %mtd
                              %mo ⊗
                            %mtd
                              %msub
                                %mi Γ
                                %mrow
                                  %mi Σ
                                  %mo ,
                                  %mi scp
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi ℂ
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi A
                            %mtd
                              %mo ,
                            %mtd
                              %mi Φ
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ↦
                            %mtd
                              %mi A
                              %mo{:stretchy => "false"} (
                              %mi Φ
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\omega_{\Sigma_p}(\mathrm{G}_P(-),(-))
                      \\;=\;
                      ev
                      \&amp;\colon&amp;
                      LinObs(E_{scp},\mathbf{L})^{reg} &amp;\otimes&amp; \Gamma_{\Sigma,scp}(E)
                      \&amp;\longrightarrow&amp;
                      \\mathbb{C}
                      \\\
                      \&amp;&amp; (A &amp;,&amp; \Phi) &amp;\mapsto&amp; A(\Phi)
                      }
              %p
                equals the
                %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
                of observables on field histories.
              %p
                This means that for every
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \Sigma_p
                the
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ω
                        %mrow
                          %msub
                            %mi Σ
                            %mi p
                    %annotation{:encoding => "application/x-tex"} \omega_{\Sigma_p}
                restricts to a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
