                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{-S,(-)\}
                regarded as a nilpotent derivation on the
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                this way the
                = succeed "." do
                  %em
                    free quantum
                    %a.existingWikiWord{:href => "/nlab/show/BV-differential"} BV-differential
            %p
              (
              %a{:href => "BV-differential#FredenhagenRejzner11b"}> Fredenhagen-Rejzner 11b, below (37)
              ,
              = succeed ")" do
                %a{:href => "BV-differential#Rejzner11"} Rejzner 11, below (5.28)
            .proof
              %h6#proof_8 Proof
              %p
                By example
                %a.maruku-ref{:href => "#BVDifferentialGlobal"}
                the action of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi S
                      %mo ′
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{-S',(-)\}
                on polyomial observables is to replace
                %a.existingWikiWord{:href => "/nlab/show/antifield"} antifield
                %a.existingWikiWord{:href => "/nlab/show/field+observables"} field observables
                by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi Φ
                        %mi a
                        %mo ‡
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ↦
                      %mspace{:width => "thickmathspace"}
                      %mo ±
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi P
                        %mrow
                          %mi A
                          %mi B
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Φ
                        %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{\Phi}^\ddagger_a(x)
                      \\;\mapsto\;
                      \\pm
                      (P_{A B}\mathbf{\Phi}^A)(x)
                      \\,,
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
                %a.existingWikiWord{:href => "/nlab/show/partial+integration"} partial integration
                this translates to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi S
                      %mo ′
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
