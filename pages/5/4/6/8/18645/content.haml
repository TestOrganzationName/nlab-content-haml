                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
