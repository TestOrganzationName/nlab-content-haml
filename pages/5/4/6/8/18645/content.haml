                      \\right\}
            #FieldHistoriesAsHistoriesOfFieldConfigurations.num_remark
              %h6#remark Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
                  are histories of spatial
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/field+configurations"} field configurations
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo ∈
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Phi \in \Gamma_\Sigma(E)
                of the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %a.existingWikiWord{:href => "/nlab/show/spacelike"} spacelike
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SpacelikeTimelikeLightlike"}
                %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi p
                      %mo ↪
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma_p \hookrightarrow \Sigma
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SmoothManifoldInsideDiffeologicalSpaces"}
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                in
                %a.existingWikiWord{:href => "/nlab/show/codimension"} codimension
                1, then the
                %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msub
                            %mi Σ
                            %mi p
                    %annotation{:encoding => "application/x-tex"} \Phi\vert_{\Sigma_p}
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} \Phi
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \Sigma_p
                may be thought of as a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/field+configuration"} field configuration
                in space. As different spatial slices
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \Sigma_p
                are chosen, one obtains such field configurations
                = succeed "." do
                  %em at different times
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo ∈
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Phi \in \Gamma_\Sigma(E)
                is a
                %em history
                of field configurations, hence a
                %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
                (def
                = succeed ")." do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
            #PossibleFieldHistories.num_remark
              %h6#remark_2 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/possible+worlds"} possible
                  field histories)
              %p
                After we give the set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
                of field histories
                %a.maruku-eqref{:href => "#eq:SetOfFieldHistories"} (18)
                %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometric
                structure, below in example
                %a.maruku-ref{:href => "#DiffeologicalSpaceOfFieldHistories"}
                and example
                = succeed "," do
                  %a.maruku-ref{:href => "#SupergeometricSpaceOfFieldHistories"}
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
                %em
                  %a.existingWikiWord{:href => "/nlab/show/possibility"} possible
                field histories; containing all field histories that qualify as being of the
                %a.existingWikiWord{:href => "/nlab/show/type"} type
                specified by the
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
              %p
                After we obtain
                %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
                below in def.
                = succeed "," do
                  %a.maruku-ref{:href => "#EulerLagrangeEquationsOnTrivialVectorFieldBundleOverMinkowskiSpacetime"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo =
                          %mn 0
                      %mover
                        %mo ↪
                        %mphantom
                          %mi AAA
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma_\Sigma(E)_{\delta_{EL}\mathbf{L}= 0}
                      \\overset{\phantom{AAA}}{\hookrightarrow}
                      \\Gamma_\Sigma(E)
              %p
                and called the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
                  %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:InclusionOfOnShellSpaceOfFieldHistories"} (41)
            %p
              For the time being, not to get distracted from the basic idea of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            #TrivialVectorBundleAsAFieldBundle.num_example
              %h6#example Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                  as a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %p
                In applications the
                %a.existingWikiWord{:href => "/nlab/show/field+fiber"} field fiber
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %mi V
                    %annotation{:encoding => "application/x-tex"} F = V
                is often a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional vector space
                %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivial
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                with
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is of course a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
                  %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#VectorBundle"}
              %p
                Choosing any
                %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϕ
                        %mi a
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi a
                          %mo =
                          %mn 1
                        %mi s
                    %annotation{:encoding => "application/x-tex"} (\phi^a)_{a = 1}^s
                of the field fiber, then over
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
                on the total space of the field bundle
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϕ
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      ( (x^\mu), ( \phi^a ) )
                      \\,,
              %p
                where the index
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
                ranges from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
                to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
                ranges from 1 to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                      %annotation{:encoding => "application/x-tex"} s
              %p
                If this trivial vector bundle is regarded as a
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                according to def.
                = succeed "," do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} \Phi
                is equivalently an
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                      %annotation{:encoding => "application/x-tex"} s
                %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
                of
                = succeed "-valued" do
                  %a.existingWikiWord{:href => "/nlab/show/real+number"} real
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Φ
                        %mi a
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Σ
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \Phi^a \colon \Sigma \to \mathbb{R}
                on spacetime:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo =
                      %mo{:stretchy => "false"} (
