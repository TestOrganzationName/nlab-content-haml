                              %mover
                                %mi g
                                %mo{:stretchy => "false"} ^
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %msup
                                %mi d
                                %mi n
                              %mi x
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %munder
                                %mo ∫
