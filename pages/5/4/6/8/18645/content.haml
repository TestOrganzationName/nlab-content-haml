                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#VectorBundle"}
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
