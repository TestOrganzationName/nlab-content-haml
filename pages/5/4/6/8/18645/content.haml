                                %mo ,
                                %mi μ
                              %mi a
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi ⋯
                            %mo )
                          %mo ∈
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi J
                            %mi Σ
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          f_{\mu_1 \cdots \mu_k} = f_{\mu_1 \cdots \mu_k}\left((x^\mu), (\phi^a), (\phi^a_{,\mu}), \cdots\right)
                          \\in C^\infty(J^\infty_\Sigma(E))
                  %p
                    any smooth function of the spacetime coordinates and the field coordinates (locally depending only on a finite order of these, by prop.
                    = succeed ")." do
                      %a.maruku-ref{:href => "#JetBundleIsLocallyProManifold"}
                %li
                  %p
                    In particular every horizontal
                    = succeed "-form" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (p+1)
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo ∈
                          %msup
                            %mi Ω
                            %mrow
                              %mi p
                              %mo +
                              %mn 1
                              %mo ,
                              %mn 0
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbf{L} \in \Omega^{p+1,0}(E)
                    is proportional to the above volume form
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo =
                          %mi L
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi dvol
                            %mi Σ
                        %annotation{:encoding => "application/x-tex"}
                          \\mathbf{L} = L \, dvol_\Sigma
                  %p
                    for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                          %mo =
                          %mi L
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi x
                            %mi μ
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ϕ
                            %mi a
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mo{:stretchy => "false"} (
