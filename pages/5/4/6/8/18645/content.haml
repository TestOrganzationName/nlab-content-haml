                            %mo !
                      %mi ⋯
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mrow
                            %msub
                              %mi k
                              %mi r
                            %mo !
                      %mspace{:width => "thinmathspace"}
                      %mi T
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mrow
                          %mi σ
                          %mo{:stretchy => "false"} (
