                      }
              %p
                which make the following
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commute
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
