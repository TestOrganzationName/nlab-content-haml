                    %annotation{:encoding => "application/x-tex"} S_{eff,vac}
                (def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#VacuumDiagram"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
