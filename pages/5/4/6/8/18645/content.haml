                            %mi AAAAA
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msub
                                    %mi X
                                    %mn 1
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi ℝ
                                    %mrow
                                      %msub
                                        %mi n
                                        %mn 2
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %mover
                                    %mo ⟶
                                    %mrow
                                      %msub
                                        %mi f
                                        %mo *
