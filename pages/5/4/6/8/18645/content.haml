                                %mn 2
                              %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\eta(\overline{A}v_1A , \overline{A} v_2 A)
                      \&amp;=
                      \\tfrac{1}{2}
                      \\left(
                      \\left(\overline{A} \hat v_1 A\right) \left(\overline{A}\hat v_2 A\right)
                      +
                      \\left(\overline{A} \hat v_2 A\right) \left(\overline{A} \hat v_1 A\right)
                      \\right)
                      \\\
                      \&amp; =
                      \\tfrac{1}{2}
                      \\left(
                      \\overline{A}(\hat v_1 \hat v_2 + \hat v_2 \hat v_1) A
                      \\right)
                      \\\
                      \&amp; =
                      \\overline{A} A \tfrac{1}{2}\left( \hat v_1 \hat v_2 + \hat v_2 \hat v_1\right)
                      \\\
                      \&amp; =
                      \\eta(v_1, v_2)
                      \\end{aligned}
                      \\,.
              %p
                That it moreover lands in the
                %a.existingWikiWord{:href => "/nlab/show/proper+Lorentz+group"} proper Lorentz group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SO
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SO(d-1,1)
                follows from observing (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#CliffordConjugtionReflectionAndRotation"}
                %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
                by a linear combination of generators, which are excluded from the group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
                (as that is defined to be in the even subalgebra).
              %p
                To see that the homomorphism is surjective, use that all elements of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SO
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SO(d-1,1)
                are products of
                %a.existingWikiWord{:href => "/nlab/show/rotations"} rotations
                in hyperplanes. If a hyperplane is spanned by the
                %a.existingWikiWord{:href => "/nlab/show/bivector"} bivector
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ω
                          %mrow
                            %mi a
                            %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\omega^{a b})
                %a.maruku-ref{:href => "#CliffordConjugtionReflectionAndRotation"}
                by the conjugation action by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mi α
                          %mn 2
                      %msup
                        %mi ω
                        %mrow
                          %mi a
                          %mi b
                      %msub
                        %mi Γ
                        %mrow
                          %mi a
                          %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\exp(\tfrac{\alpha}{2} \omega^{a b}\Gamma_{a b})
              %p
                for some
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \alpha
              %p
                That the
                %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                is clear from the fact that the only even Clifford elements which commute with all vectors are the multiples
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi ℝ
                      %mo ↪
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \in \mathbb{R} \hookrightarrow Cl(\mathbb{R}^{d-1,1})
                of the identity. For these
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi a
                        %mo ¯
                      %mo =
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \overline{a} = a
                and hence the condition
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi a
                        %mo ¯
                      %mi a
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \overline{a} a = 1
                is equivalent to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi a
                          %mn 2
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} a^2 = 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{+1,-1\}
                are in the
                %a.existingWikiWord{:href => "/nlab/show/center"} center
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
                = succeed "." do
                  %a.maruku-ref{:href => "#AmbiguityInCliffordConjugation"}
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#InTermsOfNormedDivisionAlgebraInDimension3To10
              %strong Spinors in dimensions 3, 4, 6 and 10
            %p
              We now discuss how
              %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SpinGroup"}
              %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
              over the four real
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
            #CliffordAlgebraInTermsOfNormedDivisionAlgebra.num_defn
              %h6#definition_12 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
                  via
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/normed+division+algebra"} normed division algebra
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                be one of the four real
                %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
                from prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#HurwitzTheorem"}
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
                %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
                from prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#ZornTheorem"}
              %p
                Define a
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
                %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi dim
                            %mi ℝ
                          %mo{:stretchy => "false"} (
                          %mi 𝕂
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo ⟶
                      %msub
                        %mi End
                        %mi ℝ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝕂
                        %mn 4
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma \;\colon\; \mathbb{R}^{dim_{\mathbb{R}}(\mathbb{K})+1,1} \longrightarrow End_{\mathbb{R}}(\mathbb{K}^4)
              %p
                from (the real vector space underlying)
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                to real
                %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝕂
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}^4
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi ψ
                            %mtr
                              %mtd
                                %mi ϕ
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mover
                                  %mi A
                                  %mo{:stretchy => "false"} ˜
                                %mi ϕ
                            %mtr
                              %mtd
                                %mi A
                                %mi ψ
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma(A)
                      \\left(
                      \\array{
                      \\psi
                      \\\
                      \\phi
                      }
                      \\right)
                      \\;\coloneqq\;
                      \\left(
                      \\array{
                      \- \tilde A \phi
                      \\\
                      A \psi
                      }
                      \\right)
                      \\,.
              %p
                Here on the right we are using the isomorphism from prop.
                %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
                for identifying a spacetime vector with a
                = succeed "-matrix," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mo ×
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2 \times 2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mo{:stretchy => "false"} (
                        %mo ˜
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \widetilde(-)
                from def.
                = succeed "." do
                  %a.maruku-ref{:href => "#TraceReversal"}
            .num_remark
              %h6#remark_6 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford multiplication
                  via
                  = succeed "-valued" do
                    %a.existingWikiWord{:href => "/nlab/show/octonion"} octonion
              %p
                Each operation of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma(A)
                in def.
                %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
                is clearly a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                being the non-associative
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                the octonions, then the composition of two such linear maps is not in general given by the usual matrix product.
            #SpinorRepsByNormedDivisionAlgebra.num_prop
              %h6#proposition_10 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
                  via
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              %p
                The map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                in def.
                %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
                gives a
                %a.existingWikiWord{:href => "/nlab/show/representation"} representation
                of the
                %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %msub
                            %mi dim
                            %mi ℝ
                          %mo{:stretchy => "false"} (
                          %mi 𝕂
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{dim_{\mathbb{R}}(\mathbb{K})+1,1}  )
                (
                %a{:href => "geometry+of+physics+--+supersymmetry#CliffordAlgebra"}> this def.
                ), i.e of
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Cl
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 2
                              %mo ,
                              %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{2,1})
                    for
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝕂
                            %mo =
                            %mi ℝ
                          %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{R}
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Cl
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 3
                              %mo ,
                              %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{3,1})
                    for
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝕂
                            %mo =
                            %mi ℂ
                          %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{C}
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Cl
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 5
                              %mo ,
                              %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{5,1})
                    for
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝕂
                            %mo =
                            %mi ℍ
                          %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{H}
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Cl
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 9
                              %mo ,
                              %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{9,1})
                    for
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝕂
                            %mo =
                            %mi 𝕆
                          %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{O}
              %p
                Hence this Clifford representation induces
                %a.existingWikiWord{:href => "/nlab/show/spin+representations"} representations
                of the
                %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi dim
                        %mi ℝ
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(dim_{\mathbb{R}}(\mathbb{K})+1,1)
                on the real vector spaces
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mo ±
                      %mo ≔
                      %msup
                        %mi 𝕂
                        %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      S_{\pm } \coloneqq \mathbb{K}^2
                      \\,.
              %p and hence on
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ≔
                      %msub
                        %mi S
                        %mo +
                      %mo ⊕
                      %msub
                        %mi S
                        %mo −
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      S \coloneqq S_+ \oplus S_-
                      \\,.
            %p
              (
              %a{:href => "geometry+of+physics+--+supersymmetry#BaezHuerta09"}> Baez-Huerta 09, p. 6
              )
            .proof
              %h6#proof_7 Proof
              %p We need to check that the Clifford relation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi Γ
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mo{:stretchy => "false"} )
                              %msup
                                %mo{:stretchy => "false"} )
                                %mn 2
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi η
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mo ,
                              %mi A
                              %mo{:stretchy => "false"} )
                              %mn 1
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                              %mi det
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      (\Gamma(A))^2
                      \&amp; = -\eta(A,A)1
                      \\\
                      \&amp; = + det(A)
                      \\end{aligned}
              %p
                is satisfied (where we used
                %a.maruku-eqref{:href => "#eq:RelationCliffordAlgebra"} (11)
                and
                = succeed ")." do
                  %a.maruku-eqref{:href => "#eq:MinkowskiSpacetimeFromHermitianMatricesWithDeterminant"} (8)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo ,
                      %mi ψ
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi 𝕂
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} (\phi,\psi) \in \mathbb{K}^4
                then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi ϕ
                            %mtr
                              %mtd
                                %mi ψ
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mo −
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mover
                                  %mi A
                                  %mo{:stretchy => "false"} ˜
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mi ϕ
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mi A
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi A
                                  %mo{:stretchy => "false"} ˜
                                %mi ψ
                                %mo{:stretchy => "false"} )
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      (\Gamma(A))^2
                      \\left(
                      \\array{
                      \\phi
                      \\\
                      \\psi
                      }
                      \\right)
                      \\;=\;
                      \-
                      \\left(
                      \\array{
                      \\tilde A(A \phi)
                      \\\
                      A(\tilde A \psi)
                      }
                      \\right)
                      \\,,
              %p where on the right we have in each component ordinary matrix product expressions.
              %p Now observe that both expressions on the right are sums of triple products that involve either one real factor or two factors that are conjugate to each other:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi A
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mi ψ
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mrow
                                %mo (
                                %mrow
                                  %mtable
                                    %mtr
                                      %mtd
                                        %msub
                                          %mi x
                                          %mn 0
                                        %mo +
                                        %msub
                                          %mi x
                                          %mn 1
                                      %mtd
                                        %mi y
                                    %mtr
                                      %mtd
                                        %msup
                                          %mi y
                                          %mo *
                                      %mtd
                                        %msub
                                          %mi x
                                          %mn 0
                                        %mo −
                                        %msub
                                          %mi x
                                          %mn 1
                                %mo )
                              %mo ⋅
                              %mrow
                                %mo (
                                %mrow
                                  %mtable
                                    %mtr
                                      %mtd
                                        %mo{:stretchy => "false"} (
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %msub
                                          %mi x
                                          %mn 0
                                        %mo +
                                        %msub
                                          %mi x
                                          %mn 1
                                        %mo{:stretchy => "false"} )
                                        %msub
                                          %mi ϕ
                                          %mn 1
                                        %mo +
                                        %mi y
                                        %msub
                                          %mi ϕ
                                          %mn 2
                                    %mtr
                                      %mtd
                                        %msup
                                          %mi y
                                          %mo *
                                        %msub
                                          %mi ϕ
                                          %mn 1
                                        %mo −
                                        %mo{:stretchy => "false"} (
                                        %msub
                                          %mi x
                                          %mn 0
                                        %mo +
                                        %msub
                                          %mi x
                                          %mn 1
                                        %mo{:stretchy => "false"} )
                                        %msub
                                          %mi ϕ
                                          %mn 2
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mrow
                                %mo (
                                %mrow
                                  %mtable
                                    %mtr
                                      %mtd
                                        %mo{:stretchy => "false"} (
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %msubsup
                                          %mi x
                                          %mn 0
                                          %mn 2
                                        %mo +
                                        %msubsup
                                          %mi x
                                          %mn 1
                                          %mn 2
                                        %mo{:stretchy => "false"} )
                                        %msub
                                          %mi ϕ
                                          %mn 1
                                        %mo +
                                        %mo{:stretchy => "false"} (
                                        %msub
                                          %mi x
                                          %mn 0
                                        %mo +
                                        %msub
                                          %mi x
                                          %mn 1
                                        %mo{:stretchy => "false"} )
                                        %mo{:stretchy => "false"} (
                                        %mi y
                                        %msub
                                          %mi ϕ
                                          %mn 2
                                        %mo{:stretchy => "false"} )
                                        %mo +
                                        %mi y
                                        %mo{:stretchy => "false"} (
                                        %msup
                                          %mi y
                                          %mo *
                                        %msub
                                          %mi ϕ
                                          %mn 1
                                        %mo{:stretchy => "false"} )
                                        %mo −
                                        %mi y
                                        %mo{:stretchy => "false"} (
                                        %mo{:stretchy => "false"} (
                                        %msub
                                          %mi x
                                          %mn 0
                                        %mo +
                                        %msub
                                          %mi x
                                          %mn 1
                                        %mo{:stretchy => "false"} )
                                        %msub
                                          %mi ϕ
                                          %mn 2
                                        %mo{:stretchy => "false"} )
                                    %mtr
                                      %mtd
                                        %mi ⋯
                                %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      A (\tilde A \psi)
                      \&amp; =
                      \\left(
                      \\array{
                      x_0 + x_1 &amp; y
                      \\\
                      y^\ast &amp; x_0 - x_1
                      }
                      \\right)
                      \\cdot
                      \\left(
                      \\array{
                      (-x_0 + x_1) \phi_1 + y \phi_2
                      \\\
                      y^\ast \phi_1 - (x_0 + x_1)\phi_2
                      }
                      \\right)
                      \\\
                      \&amp; =
                      \\left(
                      \\array{
                      (-x_0^2 + x_1^2) \phi_1 + (x_0 + x_1)(y \phi_2) + y (y^\ast \phi_1) - y( (x_0 + x_1) \phi_2 )
                      \\\
                      \\cdots
                      }
                      \\right)
                      \\end{aligned}
                      \\,.
              %p
                Since the
                %a.existingWikiWord{:href => "/nlab/show/associators"} associators
                of triple products that involve a real factor and those involving both an element and its conjugate vanish by prop.
                %a.maruku-ref{:href => "#PropertiesOfAssociatorInAlternativeAlgebra"}
                (hence ultimately by Artin’s theorem, prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#ArtinTheorem"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi ϕ
                            %mtr
                              %mtd
                                %mi ψ
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mo −
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi A
                                  %mo{:stretchy => "false"} ˜
                                %mi A
                                %mo{:stretchy => "false"} )
                                %mi ϕ
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi A
                                %mover
                                  %mi A
                                  %mo{:stretchy => "false"} ˜
                                %mo{:stretchy => "false"} )
                                %mi ψ
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (\Gamma(A))^2
                      \\left(
                      \\array{
                      \\phi
                      \\\
                      \\psi
                      }
                      \\right)
                      \\;=\;
                      \-
                      \\left(
                      \\array{
                      (\tilde A A) \phi
                      \\\
                      (A \tilde A) \psi
                      }
                      \\right)
                      \\,.
              %p
                This implies the statement via the equality
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi A
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ˜
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ˜
                      %mi A
                      %mo =
                      %mi det
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} -A \tilde A = -\tilde A A = det(A)
                (prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#DeterminantViaProductWithTraceReversal"}
            #RealSpinorPairingsViaDivisionAlg.num_prop
              %h6#proposition_11 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear
                  pairings)
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                be one of the four real
                %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mo ±
                      %msub
                        %mo ≃
                        %mi ℝ
                      %msup
                        %mi 𝕂
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S_\pm \simeq_{\mathbb{R}}\mathbb{K}^2
                the corresponding
                %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
                from prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebra"}
              %p
                Then there are
                %a.existingWikiWord{:href => "/nlab/show/bilinear+maps"} bilinear maps
                from two
                %a.existingWikiWord{:href => "/nlab/show/spinors"} spinors
                (according to prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebra"}
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mo ¯
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi S
                        %mo +
                      %mo ⊗
                      %msub
                        %mi S
                        %mo −
                      %mo ⟶
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      \\overline{(-)}(-) \;\colon\; S_+ \otimes S_-\longrightarrow \mathbb{R}
              %p
                as well as to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi 𝕂
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{dim(\mathbb{K}+1,1)}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mo ¯
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi S
                        %mo ±
                      %mo ⊗
                      %msub
                        %mi S
                        %mo ±
                      %mo ⟶
                      %msup
                        %mi ℝ
                        %mrow
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi 𝕂
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\overline{(-)}\Gamma (-) \;\colon\; S_\pm \otimes S_{\pm}\longrightarrow \mathbb{R}^{dim(\mathbb{K}+1,1)}
              %p
                given, respectively, by forming the
                %a.existingWikiWord{:href => "/nlab/show/real+part"} real part
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Conjugation"}
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕂
                      %annotation{:encoding => "application/x-tex"} \mathbb{K}
                %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mo ¯
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi S
                        %mo +
                      %mo ⊗
                      %msub
                        %mi S
                        %mo −
                      %mo ⟶
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      \\overline{(-)}(-) \colon S_+\otimes S_- \longrightarrow \mathbb{R}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo ,
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mover
                        %mi ψ
                        %mo ¯
                      %mi ϕ
                      %mo ≔
                      %mi Re
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ψ
                        %mo †
                      %mo ⋅
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (\psi,\phi)\mapsto \overline{\psi} \phi \coloneqq Re(\psi^\dagger \cdot \phi)
              %p
                and by forming the product of a column vector with a row vector to produce a matrix, possibly up to trace reversal (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TraceReversal"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi 𝕂
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 1
                      %mo ≃
                      %msubsup
                        %mi Mat
                        %mrow
                          %mn 2
                          %mo ×
                          %mn 2
                        %mi her
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{dim(\mathbb{K})+1,1} \simeq Mat^{her}_{2 \times 2}(\mathbb{K})
                from prop.
                = succeed ":" do
                  %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mo +
                      %mo ⊗
                      %msub
                        %mi S
                        %mo +
                      %mo ⟶
                      %msup
                        %mi ℝ
                        %mrow
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi 𝕂
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      S_+ \otimes S_+ \longrightarrow \mathbb{R}^{dim(\mathbb{K})+1,1}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo ,
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mover
                        %mi ψ
                        %mo ¯
                      %mi Γ
                      %mi ϕ
                      %mo ≔
                      %mover
                        %mrow
                          %mi ψ
                          %msup
                            %mi ϕ
                            %mo †
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mi ϕ
                          %msup
                            %mi ψ
                            %mo †
                        %mo ˜
                    %annotation{:encoding => "application/x-tex"}
                      (\psi , \phi) \mapsto \overline{\psi}\Gamma \phi \coloneqq
                      \\widetilde{\psi \phi^\dagger + \phi \psi^\dagger}
              %p and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mo −
                      %mo ⊗
                      %msub
                        %mi S
                        %mo −
                      %mo ⟶
                      %msup
                        %mi ℝ
                        %mrow
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi 𝕂
                          %mo +
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      S_- \otimes S_- \longrightarrow \mathbb{R}^{dim(\mathbb{K}+1,1)}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo ,
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mrow
                        %mi ψ
                        %msup
                          %mi ϕ
                          %mo †
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi ϕ
                        %msup
                          %mi ψ
                          %mo †
                    %annotation{:encoding => "application/x-tex"}
                      (\psi , \phi) \mapsto {\psi \phi^\dagger + \phi \psi^\dagger}
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %msubsup
                        %mi Mat
                        %mrow
                          %mn 2
                          %mo ×
                          %mn 2
                        %mi her
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \in Mat^{her}_{2 \times 2}(\mathbb{K})
                the
                = succeed "-component" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi ψ
                        %mo ¯
                      %mi Γ
                      %mi ϕ
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Re
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ψ
                        %mo †
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\eta(\overline{\psi}\Gamma \phi, A)
                      \=
                      Re (\psi^\dagger (A\phi))
                      \\,.
              %p These pairings have the following properties
              %ol
                %li
                  %p
                    both are
                    = succeed "-equivalent;" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mi dim
                            %mo{:stretchy => "false"} (
                            %mi 𝕂
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mn 1
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} Spin(dim(\mathbb{K})+1,1)
                %li
                  %p
                    the pairing
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                            %mo ¯
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \overline{(-)}\Gamma(-)
                    is
                    = succeed ":" do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/symmetric+bilinear+form"} symmetric
                  #eq:SpinorToVectorPairingIsSymmetric.maruku-equation
                    %span.maruku-eq-number (12)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mrow
                              %msub
                                %mi ψ
                                %mn 1
                            %mo ¯
                          %mspace{:width => "thinmathspace"}
                          %mi Γ
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi ψ
                            %mn 2
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mover
                            %mrow
                              %msub
                                %mi ϕ
                                %mn 2
                            %mo ¯
                          %mspace{:width => "thinmathspace"}
                          %mi Γ
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi ψ
                            %mn 1
                          %mphantom
                            %mi AAAA
                          %mtext for
                          %mphantom
                            %mi AA
                          %msub
                            %mi ψ
                            %mn 1
                          %mo ,
                          %msub
                            %mi ψ
                            %mn 2
                          %mo ∈
                          %msub
                            %mi S
                            %mo +
                          %mo ⊕
                          %msub
                            %mi S
                            %mo −
                        %annotation{:encoding => "application/x-tex"}
                          \\overline{\psi_1} \,\Gamma\, \psi_2 = + \overline{\phi_2}\, \Gamma\, \psi_1
                          \\phantom{AAAA}
                          \\text{for} \phantom{AA} \psi_1, \psi_2 \in S_+ \oplus S_-
            %p
              (
              %a{:href => "geometry+of+physics+--+supersymmetry#BaezHuerta09"}> Baez-Huerta 09, prop. 8, prop. 9
              ).
            #TwoComponentSpinorNotation.num_remark
              %h6#remark_7 Remark
              %p
                %strong
                  (two-component
                  %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
                  notation)
              %p
                In the
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/physics"} physics
                %a.existingWikiWord{:href => "/nlab/show/QFT"} QFT
                literature the expressions for
                %a.existingWikiWord{:href => "/nlab/show/spin+representations"} spin representations
                given by prop.
                %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebra"}
                are traditionally written in
                %em two-component spinor notation
                as follows:
              %ul
                %li
                  %p
                    An element of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mo +
                        %annotation{:encoding => "application/x-tex"} S_+
                    is denoted
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi χ
                            %mi a
                          %mo ∈
                          %mi 𝕂
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi a
                              %mo =
                              %mn 1
                              %mo ,
                              %mn 2
                        %annotation{:encoding => "application/x-tex"} (\chi_a \in \mathbb{K})_{a = 1,2}
                    and called a
                    = succeed ";" do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/Weyl+spinor"} left handed spinor
                %li
                  %p
                    an element of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mo −
                        %annotation{:encoding => "application/x-tex"} S_-
                    is denoted
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ξ
                            %mrow
                              %mo †
                              %mover
                                %mi a
                                %mo ˙
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mover
                                %mi a
                                %mo ˙
                              %mo =
                              %mn 1
                              %mo ,
                              %mn 2
                        %annotation{:encoding => "application/x-tex"} (\xi^{\dagger \dot a})_{\dot a = 1,2}
                    and called a
                    = succeed ";" do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/Weyl+spinor"} right handed spinor
                %li
                  %p
                    an element of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                          %mo =
                          %msub
                            %mi S
                            %mo +
                          %mo ⊕
                          %msub
                            %mi S
                            %mo −
                        %annotation{:encoding => "application/x-tex"} S = S_+ \oplus S_-
                    is denoted
                  #eq:TwoComponentNotationForDiracSpinor.maruku-equation
                    %span.maruku-eq-number (13)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ψ
                            %mi α
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mrow
                            %mo (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi χ
                              %mi a
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ξ
                              %mrow
                                %mo †
                                %mover
                                  %mi a
                                  %mo ˙
                            %mo{:stretchy => "false"} )
                            %mo )
                        %annotation{:encoding => "application/x-tex"}
                          (\psi^\alpha) = \left( (\chi_a), (\xi^{\dagger \dot a}) \right)
                  %p
                    and called a
                    = succeed ";" do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/Dirac+spinor"} Dirac spinor
              %p
                and the Clifford action of prop.
                %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
                corresponds to the generalized “
                %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"}> Pauli matrices
                ”:
              %ul
                %li
                  %p
                    a hermitian matrix
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo ∈
                          %msubsup
                            %mi Mat
                            %mrow
                              %mn 2
                              %mo ×
                              %mn 2
                            %mi her
                          %mo{:stretchy => "false"} (
                          %mi 𝕂
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} A \in Mat^{her}_{2\times 2}(\mathbb{K})
                    as in prop
                    %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
                    regarded as a linear map
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mo −
                          %mo →
                          %msub
                            %mi S
                            %mo +
                        %annotation{:encoding => "application/x-tex"} S_- \to S_+
                    via def.
                    %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
                    is denoted
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo (
                            %msub
                              %mi x
                              %mi μ
                            %msubsup
                              %mi σ
                              %mrow
                                %mi a
                                %mover
                                  %mi a
                                  %mo ˙
                              %mi μ
                            %mo )
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mrow
                            %mo (
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %msub
                                      %mi x
                                      %mn 0
                                    %mo +
                                    %msub
                                      %mi x
                                      %mn 1
                                  %mtd
                                    %mi y
                                %mtr
                                  %mtd
                                    %msup
                                      %mi y
                                      %mo *
                                  %mtd
                                    %msub
                                      %mi x
                                      %mn 0
                                    %mo −
                                    %msub
                                      %mi x
                                      %mn 1
                            %mo )
                          %mspace{:width => "thinmathspace"}
                          %mo ;
                        %annotation{:encoding => "application/x-tex"}
                          \\left(x_\mu \sigma^\mu_{a \dot a}\right)
                          \\;\coloneqq\;
                          \\left( \array{  x_0 + x_1 &amp; y  \\ y^\ast &amp; x_0 - x_1 } \right)    \,;
                %li
                  %p
                    the negative of the trace-reversal (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#TraceReversal"}
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi S
                              %mo +
                            %mo →
                            %msub
                              %mi S
                              %mo −
                          %annotation{:encoding => "application/x-tex"} S_+ \to S_-
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo (
                            %msub
                              %mi x
                              %mi μ
                            %msup
                              %mover
                                %mi σ
                                %mo ˜
                              %mrow
                                %mi μ
                                %mover
                                  %mi a
                                  %mo ˙
                                %mi a
                            %mo )
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mo −
                          %mrow
                            %mo (
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %msub
                                      %mi x
                                      %mn 0
                                    %mo +
                                    %msub
                                      %mi x
                                      %mn 1
                                  %mtd
                                    %mi y
                                %mtr
                                  %mtd
                                    %msup
                                      %mi y
                                      %mo *
                                  %mtd
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %msub
                                      %mi x
                                      %mn 0
                                    %mo −
                                    %msub
                                      %mi x
                                      %mn 1
                            %mo )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          \\left(
                          x_\mu \widetilde \sigma^{\mu \dot a a}
                          \\right)
                          \\;\coloneqq\;
                          \-
                          \\left( \array{  -x_0 + x_1 &amp; y  \\ y^\ast &amp; -x_0 - x_1 } \right)
                          \\,.
                %li
                  %p
                    the corresponding Clifford generator
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi S
                            %mo +
                          %mo ⊕
                          %msub
                            %mi S
                            %mo −
                          %mo →
                          %msub
                            %mi S
                            %mo +
                          %mo ⊕
                          %msub
                            %mi S
                            %mo −
                        %annotation{:encoding => "application/x-tex"} \Gamma(A) \;\colon\; S_+ \oplus S_- \to S_+ \oplus S_-
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi x
                            %mi μ
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi γ
                            %mi μ
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi α
                              %mi β
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mrow
                            %mo (
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mn 0
                                  %mtd
                                    %msub
                                      %mi x
                                      %mi μ
                                    %msubsup
                                      %mi σ
                                      %mrow
                                        %mi a
                                        %mover
                                          %mi b
                                          %mo ˙
                                      %mi μ
                                %mtr
                                  %mtd
                                    %msub
                                      %mi x
                                      %mi μ
                                    %msup
                                      %mover
                                        %mi σ
                                        %mo ˜
                                      %mrow
                                        %mi μ
                                        %mover
                                          %mi a
                                          %mo ˙
                                        %mi b
                            %mo )
                        %annotation{:encoding => "application/x-tex"}
                          x_\mu (\gamma^\mu)_{\alpha \beta}
                          \\;\coloneqq\;
                          \\left(
                          \\array{
                          0 &amp; x_\mu \sigma^\mu_{a \dot b}
                          \\\
                          x_\mu \widetilde \sigma^{\mu \dot a b}
                          }
                          \\right)
                %li
                  %p
                    the bilinear spinor-to-vector pairing from prop.
                    %a.maruku-ref{:href => "#RealSpinorPairingsViaDivisionAlg"}
                    is written as the
                    %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo (
                            %mover
                              %mi ψ
                              %mo ¯
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi γ
                              %mi μ
                            %mspace{:width => "thinmathspace"}
                            %mi ϕ
                            %mo )
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mover
                            %mi ψ
                            %mo ¯
                          %mspace{:width => "thinmathspace"}
                          %mi Γ
                          %mspace{:width => "thinmathspace"}
                          %mi ϕ
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          \\left( \overline{\psi} \, \gamma^\mu \, \phi\right)
                          \\;\coloneqq\;
                          \\overline{\psi}\,\Gamma \,\phi
                          \\,,
                  %p
                    where the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Dirac+conjugate"} Dirac conjugate
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi ψ
                            %mo ¯
                        %annotation{:encoding => "application/x-tex"} \overline{\psi}
                    on the left is given on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ψ
                            %mi α
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi χ
                            %mi a
                          %mo ,
                          %msup
                            %mi ξ
                            %mrow
                              %mo †
                              %mover
                                %mi c
                                %mo ˙
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\psi_\alpha) = (\chi_a, \xi^{\dagger \dot c})
                    by
                  #eq:DiracConjugate.maruku-equation
                    %span.maruku-eq-number (14)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                              %mtr
                                %mtd
                                  %mover
                                    %mi ψ
                                    %mo ¯
                                %mtd
                                  %mo ≔
                                  %msup
                                    %mi ψ
                                    %mo †
                                  %msup
                                    %mi γ
                                    %mn 0
                              %mtr
                                %mtd
                                %mtd
                                  %mo =
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi ξ
                                    %mi a
                                  %mo ,
                                  %msubsup
                                    %mi χ
                                    %mover
                                      %mi a
                                      %mo ˙
                                    %mo †
                                  %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          \\begin{aligned}
                          \\overline{\psi}
                          \&amp; \coloneqq
                          \\psi^\dagger \gamma^0
                          \\\
                          \&amp; =
                          ( \xi^a, \chi^\dagger_{\dot a} )
                          \\end{aligned}
                  %p
                    hence, with
                    = succeed ":" do
                      %a.maruku-eqref{:href => "#eq:TwoComponentNotationForDiracSpinor"} (13)
                  #eq:TwoComponentNotationForSpinorToVectorPairing.maruku-equation
                    %span.maruku-eq-number (15)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                              %mtr
                                %mtd
                                  %mover
                                    %mrow
                                      %msub
                                        %mi ψ
                                        %mn 1
                                    %mo ¯
                                  %mspace{:width => "thinmathspace"}
                                  %msup
                                    %mi γ
                                    %mi μ
                                  %mspace{:width => "thinmathspace"}
                                  %msub
                                    %mi ψ
                                    %mn 2
                                %mtd
                                  %mo =
                                  %msubsup
                                    %mi ψ
                                    %mn 1
                                    %mo †
                                  %mspace{:width => "thinmathspace"}
                                  %msup
                                    %mi γ
                                    %mn 0
                                  %msup
                                    %mi γ
                                    %mi μ
                                  %mspace{:width => "thinmathspace"}
                                  %msub
                                    %mi ψ
                                    %mn 2
                              %mtr
                                %mtd
                                %mtd
                                  %mo =
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi ξ
                                    %mn 1
                                  %msup
                                    %mo{:stretchy => "false"} )
                                    %mi a
                                  %mspace{:width => "thinmathspace"}
                                  %msubsup
                                    %mi σ
                                    %mrow
                                      %mi a
                                      %mover
                                        %mi c
                                        %mo ˙
                                    %mi μ
                                  %mspace{:width => "thinmathspace"}
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi ξ
                                    %mn 2
                                  %msup
                                    %mo{:stretchy => "false"} )
                                    %mrow
                                      %mo †
                                      %mover
                                        %mi c
                                        %mo ˙
                                  %mo +
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi χ
                                    %mn 1
                                  %msubsup
                                    %mo{:stretchy => "false"} )
                                    %mover
                                      %mi a
                                      %mo ˙
                                    %mo †
                                  %mspace{:width => "thinmathspace"}
                                  %msup
                                    %mover
                                      %mi σ
                                      %mo ˜
                                    %mrow
                                      %mi μ
                                      %mover
                                        %mi a
                                        %mo ˙
                                      %mi c
                                  %mspace{:width => "thinmathspace"}
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi χ
                                    %mn 2
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mi c
                        %annotation{:encoding => "application/x-tex"}
                          \\begin{aligned}
                          \\overline{\psi_1} \,\gamma^\mu\, \psi_2
                          \&amp; =
                          \\psi_1^\dagger \, \gamma^0 \gamma^\mu \, \psi_2
                          \\\
                          \&amp; =
                          (\xi_1)^a \, \sigma^\mu_{a \dot c}\, (\xi_2)^{\dagger \dot c}
                          +
                          (\chi_1)^\dagger_{\dot a} \, \widetilde \sigma^{\mu \dot a c} \, (\chi_2)_c
                          \\end{aligned}
              %p
                Finally, it is common to abbreviate contractions with the
                %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
                generators
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi γ
                        %mi μ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\gamma^\mu)
                by a slash, as in
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} /
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi γ
                        %mi μ
                      %msub
                        %mi k
                        %mi μ
                    %annotation{:encoding => "application/x-tex"}
                      k\!\!\!/\, \;\coloneqq\; \gamma^\mu k_\mu
              %p or
              #eq:FeynmanSlashNotationForMasslessDiracOperator.maruku-equation
                %span.maruku-eq-number (16)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∂
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo{:stretchy => "false"} /
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi i
                      %msup
                        %mi γ
                        %mi μ
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %msup
                            %mi x
                            %mi μ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      i \partial\!\!\!/\,
                      \\;\coloneqq\;
                      i \gamma^\mu \frac{\partial}{\partial x^\mu}
                      \\,.
              %p
                This is called the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Feynman+slash+notation"} Feynman slash notation
            %p
              (e.g.
              = succeed "," do
                %a{:href => "Dirac+field#DermisekI8"} Dermisek I-8
              = succeed ")" do
                %a{:href => "Dirac+field#DermisekI9"} Dermisek I-9
            %p
              Below we spell out the example of the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              of the
              %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              in detail (example
              = succeed ")." do
                %a.maruku-ref{:href => "#LagrangianDensityForDiracField"}
              %em massive chiral spinor fields
              one also needs the following, here we just mention this for completeness:
            #ChiralSpinorMassPairing.num_defn
              %h6#proposition_12 Proposition
              %p
                %strong (chiral spinor mass pairing)
              %p In dimension 2+1 and 3+1, there exists a non-trivial skew-symmetric pairing
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi S
                      %mo ∧
                      %mi S
                      %mo ⟶
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      \\epsilon
                      \\;\colon\;
                      S \wedge S
                      \\longrightarrow
                      \\mathbb{R}
              %p
                which may be normalized such that in the two-component spinor basis of remark
                %a.maruku-ref{:href => "#TwoComponentSpinorNotation"}
                we have
              #eq:ConjugationOfLeftRightCliffordGeneratorToRightLeft.maruku-equation
                %span.maruku-eq-number (17)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mover
                          %mi σ
                          %mo{:stretchy => "false"} ˜
                        %mrow
                          %mi μ
                          %mover
                            %mi a
                            %mo ˙
                          %mi a
                      %mo =
                      %msup
                        %mi ϵ
                        %mrow
                          %mi a
                          %mi b
                      %msup
                        %mi ϵ
                        %mrow
                          %mover
                            %mi a
                            %mo ˙
                          %mover
                            %mi b
                            %mo ˙
                      %msubsup
                        %mi σ
                        %mrow
                          %mi b
                          %mover
                            %mi b
                            %mo ˙
                        %mi μ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\tilde \sigma^{\mu \dot a a} = \epsilon^{a b} \epsilon^{\dot a \dot b} \sigma^\mu_{b \dot b}
                      \\,.
            .proof
              %h6#proof_8 Proof
              %p
                Take the non-vanishing components of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
                to be
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϵ
                        %mrow
                          %mn 1
                          %mn 2
                      %mo =
                      %msup
                        %mi ϵ
                        %mrow
                          %mover
                            %mn 1
                            %mo ˙
                          %mover
                            %mn 2
                            %mo ˙
                      %mo =
                      %msub
                        %mi ϵ
                        %mn 21
                      %mo =
                      %msub
                        %mi ϵ
                        %mrow
                          %mover
                            %mn 2
                            %mo ˙
                          %mover
                            %mn 1
                            %mo ˙
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      \\epsilon^{1 2} = \epsilon^{\dot 1 \dot 2} = \epsilon_{21} = \epsilon_{\dot 2 \dot 1} =  1
              %p and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϵ
                        %mrow
                          %mn 2
                          %mn 1
                      %mo =
                      %msup
                        %mi ϵ
                        %mrow
                          %mover
                            %mn 2
                            %mo ˙
                          %mover
                            %mn 1
                            %mo ˙
                      %mo =
                      %msub
                        %mi ϵ
                        %mrow
                          %mn 1
                          %mn 2
                      %mo =
                      %msub
                        %mi ϵ
                        %mrow
                          %mover
                            %mn 1
                            %mo ˙
                          %mover
                            %mn 2
                            %mo ˙
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\epsilon^{2 1} = \epsilon^{\dot 2 \dot 1} = \epsilon_{1 2} = \epsilon_{\dot 1 \dot 2} = -1
                      \\,.
              %p
                With this equation
                %a.maruku-eqref{:href => "#eq:ConjugationOfLeftRightCliffordGeneratorToRightLeft"} (17)
                is checked explicitly. It is clear that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
                thus defined is skew symmetric as long as the component algebra is commutative, which is the case for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                being
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                or
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#CausalStructure
              %strong Causal structure
            %p
              We need to consider the following concepts and constructions related to the
              %a.existingWikiWord{:href => "/nlab/show/causal+structure"} causal structure
              of
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
            #SpacelikeTimelikeLightlike.num_defn
              %h6#definition_13 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/spacelike"}> spacelike
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
                  %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} directions
                  %a.existingWikiWord{:href => "/nlab/show/past"} past
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/future"} future
              %p
                Given two points
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} x,y \in \Sigma
                in
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ≔
                      %mi y
                      %mo −
                      %mi x
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      v \coloneqq y - x \in \mathbb{R}^{p,1}
              %p
                for their difference, using the
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                structure underlying
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %p
                Recall the Minkowski
                %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mi p
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
                = succeed "." do
                  %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
                %a.maruku-ref{:href => "#MinkowskiMetricAndPhysicalUnitOfLength"}
                we say that the difference vector
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                is
              %ol
                %li
                  %p
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/spacelike"} spacelike
                    if
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi η
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo &gt;
                            %mn 0
                          %annotation{:encoding => "application/x-tex"} \eta(v,v) \gt 0
                %li
                  %p
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
                    if
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi η
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo &lt;
                            %mn 0
                          %annotation{:encoding => "application/x-tex"} \eta(v,v) \lt 0
                %li
                  %p
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
                    if
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi η
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mn 0
                          %annotation{:encoding => "application/x-tex"} \eta(v,v) = 0
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                is
                %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
                or
                %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
                then we say that
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                        %annotation{:encoding => "application/x-tex"} y
                    is in the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/future"} future
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                        %annotation{:encoding => "application/x-tex"} x
                    if
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi y
                              %mn 0
                            %mo −
                            %msup
                              %mi x
                              %mn 0
                            %mo ≥
                            %mn 0
                          %annotation{:encoding => "application/x-tex"} y^0 - x^0 \geq 0
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                        %annotation{:encoding => "application/x-tex"} y
                    is in the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/past"} past
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                        %annotation{:encoding => "application/x-tex"} x
                    if
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi y
                              %mn 0
                            %mo −
                            %msup
                              %mi x
                              %mn 0
                            %mo ≤
                            %mn 0
                          %annotation{:encoding => "application/x-tex"} y^0 - x^0 \leq 0
            #CausalPastAndFuture.num_defn
              %h6#definition_14 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/causal+cones"}> causal cones
                  )
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} x \in \Sigma
                a point in spacetime (an
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/event"} event
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi V
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msup
                        %mi V
                        %mo −
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"}
                      V^+(x), V^-(x) \subset \Sigma
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
                of
                %a.existingWikiWord{:href => "/nlab/show/events"} events
                that are in the
                %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
                %a.existingWikiWord{:href => "/nlab/show/future"} future
                or in the
                %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
                %a.existingWikiWord{:href => "/nlab/show/past"} past
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                = succeed ")" do
                  %a.maruku-ref{:href => "#SpacelikeTimelikeLightlike"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/open+future+cone"} open future cone
                and
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/open+past+cone"} open past cone
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mover
                          %mi V
                          %mo ¯
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msup
                        %mover
                          %mi V
                          %mo ¯
                        %mo −
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"}
                      \\overline{V}^+(x), \overline{V}^-(x) \subset \Sigma
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
                of
                %a.existingWikiWord{:href => "/nlab/show/events"} events
                that are in the
                %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
                or
                %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
                %a.existingWikiWord{:href => "/nlab/show/future"} future
                or
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/past"} past
                %em
                  %a.existingWikiWord{:href => "/nlab/show/closed+future+cone"} closed future cone
                and
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/closed+past+cone"} closed past cone
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/union"} union
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msup
                        %mover
                          %mi V
                          %mo ¯
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %msup
                        %mover
                          %mi V
                          %mo ¯
                        %mo −
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      J(x) \coloneqq \overline{V}^+(x) \cup \overline{V}^-(x)
              %p
                of the closed
                %a.existingWikiWord{:href => "/nlab/show/future+cone"} future cone
                and
                %a.existingWikiWord{:href => "/nlab/show/past+cone"} past cone
                is called the full
                %em
                  %a.existingWikiWord{:href => "/nlab/show/causal+cone"} causal cone
                of the
                %a.existingWikiWord{:href => "/nlab/show/event"} event
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                is the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/light+cone"} light cone
              %p
                More generally for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊂
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} S \subset \Sigma
                a
                %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                of
                %a.existingWikiWord{:href => "/nlab/show/events"} events
                we write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mover
                          %mi V
                          %mo ¯
                        %mo ±
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ∪
                        %mrow
                          %mi x
                          %mo ∈
                          %mi S
                      %msup
                        %mover
                          %mi V
                          %mo ¯
                        %mo ±
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\overline{V}^\pm(S)
                      \\;\coloneqq\;
                      \\underset{x \in S}{\cup} \overline{V}^{\pm}(x)
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/union"} union
                of the future/past closed cones of all events in the subset.
            #CompactlySourceCausalSupport.num_defn
              %h6#definition_15 Definition
              %p
                %strong (compactly sourced causal support)
              %p
                Consider a
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{}{\to} \Sigma
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#VectorBundle"}
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %p
                Write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_{\Sigma}(E)
                for the
                %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} spaces of smooth sections
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Sections"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi Γ
                                %mi cp
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mspace{:width => "thinmathspace"}
                              %mtext compact support
                          %mtr
                            %mtd
                              %msub
                                %mi Γ
                                %mrow
                                  %mi Σ
                                  %mo ,
                                  %mo ±
                                  %mi cp
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mspace{:width => "thinmathspace"}
                              %mtext compactly sourced future/past support
                          %mtr
                            %mtd
                              %msub
                                %mi Γ
                                %mrow
                                  %mi Σ
                                  %mo ,
                                  %mi scp
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mspace{:width => "thinmathspace"}
                              %mtext spacelike compact support
                          %mtr
                            %mtd
                              %msub
                                %mi Γ
                                %mrow
                                  %mi Σ
                                  %mo ,
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} /
                                  %mi p
                                  %mo{:stretchy => "false"} )
                                  %mi cp
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mspace{:width => "thinmathspace"}
                              %mtext future/past compact support
                          %mtr
                            %mtd
                              %msub
                                %mi Γ
                                %mrow
                                  %mi Σ
                                  %mo ,
                                  %mi tcp
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mspace{:width => "thinmathspace"}
                              %mtext timelike compact support
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\Gamma_{cp}(E) &amp; \,\text{compact support}
                      \\\
                      \\Gamma_{\Sigma,\pm cp}(E) &amp; \,\text{compactly sourced future/past support}
                      \\\
                      \\Gamma_{\Sigma,scp}(E) &amp; \,\text{spacelike compact support}
                      \\\
                      \\Gamma_{\Sigma,(f/p)cp}(E) &amp; \,\text{future/past compact support}
                      \\\
                      \\Gamma_{\Sigma,tcp}(E) &amp; \,\text{timelike compact support}
                      \\end{aligned}
              %p
                for the subsets on those smooth sections whose
                %a.existingWikiWord{:href => "/nlab/show/support"} support
                is
              %ol
                %li
                  %p
                    (
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi cp
                        %annotation{:encoding => "application/x-tex"} cp
                    ) inside a
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/compact+subset"} compact subset
                %li
                  %p
                    (
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mo ±
                          %mi cp
                        %annotation{:encoding => "application/x-tex"} \pm cp
                    ) inside the
                    = succeed "/" do
                      %a.existingWikiWord{:href => "/nlab/show/closed+future+cone"} closed future cone
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/closed+past+cone"} closed past cone
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/compact+subset"} compact subset
                %li
                  %p
                    (
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi scp
                        %annotation{:encoding => "application/x-tex"} scp
                    ) inside the
                    %a.existingWikiWord{:href => "/nlab/show/closed+causal+cone"} closed causal cone
                    of a
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/compact+subset"} compact subset
                    %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
                    with every (
                    %a.existingWikiWord{:href => "/nlab/show/spacelike"}> spacelike
                    )
                    %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
                    is compact (
                    %a{:href => "#Sanders12"}> Sanders 13, theorem 2.2
                    ),
                %li
                  %p
                    (
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi fcp
                        %annotation{:encoding => "application/x-tex"} fcp
                    ) inside the past of a Cauchy surface (
                    %a{:href => "#Sanders12"}> Sanders 13, def. 3.2
                    ),
                %li
                  %p
                    (
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi pcp
                        %annotation{:encoding => "application/x-tex"} pcp
                    ) inside the future of a Cauchy surface (
                    %a{:href => "#Sanders12"}> Sanders 13, def. 3.2
                    ),
                %li
                  %p
                    (
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi tcp
                        %annotation{:encoding => "application/x-tex"} tcp
                    ) inside the future of one Cauchy surface and the past of another (
                    %a{:href => "#Sanders12"}> Sanders 13, def. 3.2
                    ).
            %p
              (
              %a{:href => "space+of+sections#Baer14"}> Bär 14, section 1
              ,
              = succeed ")" do
                %a{:href => "Green+hyperbolic+differential+operator#Khavkine14"} Khavkine 14, def. 2.1
            #CausalOrdering.num_defn
              %h6#definition_16 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/causal+order"}> causal order
                  )
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/relation"} relation
                on the set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P(\Sigma)
                of
                %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
                of
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                which says a
                %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 1
                      %mo ⊂
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} S_1 \subset \Sigma
                is
                %em not prior
                to a subset
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mn 2
                        %mo ⊂
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} S_2 \subset \Sigma
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mn 1
                        %mrow
                          %mo ∨
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo ∧
                        %msub
                          %mi S
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} S_1 {\vee\!\!\!\wedge} S_2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S_1
                does not
                %a.existingWikiWord{:href => "/nlab/show/intersection"} intersect
                the
                %a.existingWikiWord{:href => "/nlab/show/causal+past"} causal past
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S_2
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#CausalPastAndFuture"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S_2
                does not intersect the
                %a.existingWikiWord{:href => "/nlab/show/causal+future"} causal future
                of
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S_1
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi S
                                %mn 1
                              %mrow
                                %mo ∨
                                %mspace{:width => "negativethinmathspace"}
                                %mspace{:width => "negativethinmathspace"}
                                %mspace{:width => "negativethinmathspace"}
                                %mo ∧
                              %msub
                                %mi S
                                %mn 2
                            %mtd
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mo ≔
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %msub
                                %mi S
                                %mn 1
                              %mo ∩
                              %msup
                                %mover
                                  %mi V
                                  %mo ¯
                                %mo −
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi S
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mi ∅
                          %mtr
                            %mtd
                            %mtd
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mo ⇔
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %msub
                                %mi S
                                %mn 2
                              %mo ∩
                              %msup
                                %mover
                                  %mi V
                                  %mo ¯
                                %mo +
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi S
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mi ∅
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      S_1 {\vee\!\!\!\wedge} S_2
                      \&amp; \;\;\coloneqq\;\;
                      S_1 \cap \overline{V}^-(S_2) = \emptyset
                      \\\
                      \&amp; \;\;\Leftrightarrow\;\; S_2 \cap \overline{V}^+(S_1) = \emptyset
                      \\end{aligned}
                      \\,.
              %p
                (Beware that this is just a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/relation"} relation
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/ordering"} ordering
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} relation
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 1
                      %mrow
                        %mo ∨
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mo ∧
                      %msub
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S_1 {\vee\!\!\!\wedge} S_2
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 2
                      %mrow
                        %mo ∨
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mo ∧
                      %msub
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S_2 {\vee\!\!\!\wedge} S_1
                we say that the two subsets are
                %em
                  %a.existingWikiWord{:href => "/nlab/show/spacelike"} spacelike
                  separated
                and write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 1
                      %mrow
                        %mo &gt;
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mo &lt;
                      %msub
                        %mi S
                        %mn 2
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi S
                        %mn 1
                      %mrow
                        %mo ∨
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mo ∧
                      %msub
                        %mi S
                        %mn 2
                      %mspace{:width => "thickmathspace"}
                      %mtext and
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi S
                        %mn 2
                      %mrow
                        %mo ∨
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mo ∧
                      %msub
                        %mi S
                        %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      S_1 {\gt\!\!\!\!\lt} S_2
                      \\;\;\;\coloneqq\;\;\;
                      S_1 {\vee\!\!\!\wedge} S_2 \;\text{and}\; S_2 {\vee\!\!\!\wedge} S_1
                      \\,.
            #CausalComplementOfSubsetOfLorentzianManifold.num_example
              %h6#definition_17 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/causal+complement"} causal complement
                  and
                  %a.existingWikiWord{:href => "/nlab/show/causal+closure"} causal closure
                  of subset of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} S \subset X
                a
                %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                %em
                  %a.existingWikiWord{:href => "/nlab/show/causal+complement"} causal complement
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} S^\perp
                is the
                %a.existingWikiWord{:href => "/nlab/show/complement"} complement
                of the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/causal+cone"} causal cone
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mo ⊥
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi S
                      %mo ∖
                      %msub
                        %mi J
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      S^\perp \;\coloneqq\; S \setminus J_X(S)
                      \\,.
              %p
                The causal complement
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mo ⊥
                          %mo ⊥
                    %annotation{:encoding => "application/x-tex"} S^{\perp \perp}
                of the causal complement
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} S^\perp
                is called the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/causal+closure"} causal closure
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo =
                      %msup
                        %mi S
                        %mrow
                          %mo ⊥
                          %mo ⊥
                    %annotation{:encoding => "application/x-tex"}
                      S = S^{\perp \perp}
              %p
                then the subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is called a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/causally+closed+subset"} causally closed subset
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CausClsdSubsets
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"}
                      CausClsdSubsets(\Sigma) \;\in\; Cat
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/partially+ordered+set"} partially ordered set
                of causally closed subsets, partially ordered by inclusion
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒪
                          %mn 1
                        %mo ⊂
                        %msub
                          %mi 𝒪
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathcal{O}_1 \subset \mathcal{O}_2
            #CutoffFunctions.num_defn
              %h6#definition_18 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"}> adiabatic switching
                  )
              %p
                For a
                %a.existingWikiWord{:href => "/nlab/show/causally+closed+subset"} causally closed subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo ⊂
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \mathcal{O} \subset \Sigma
                of
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CausalComplementOfSubsetOfLorentzianManifold"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatic switching
                  function
                or
                %em
                  %a.existingWikiWord{:href => "/nlab/show/infrared+cutoff"} infrared cutoff
                  function
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
                is a
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi sw
                    %annotation{:encoding => "application/x-tex"} g_{sw}
                of
                %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
                (a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
                %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
                is the
                %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
                with value
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cutoffs
                      %mo{:stretchy => "false"} (
                      %mi 𝒪
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo {
                        %msub
                          %mi g
                          %mi sw
                        %mo ∈
                        %msubsup
                          %mi C
                          %mi c
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %mo ∃
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mrow
                                %mi U
                                %mo ⊃
                                %mi 𝒪
                            %mrow
                              %mtext neighbourhood
                        %mrow
                          %mo (
                          %msub
                            %mi g
                            %mi sw
                          %msub
                            %mo{:stretchy => "false"} |
                            %mi U
                          %mo =
                          %mn 1
                          %mo )
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Cutoffs(\mathcal{O})
                      \\;\coloneqq\;
                      \\left\{
                      g_{sw} \in C^\infty_c(\Sigma)
                      \\;\vert\;
                      \\underset{ {U \supset \mathcal{O}} \atop { \text{neighbourhood} } }{\exists}
                      \\left(
                      g_{sw}\vert_U = 1
                      \\right)
                      \\right\}
                      \\,.
              %p
                Often we consider the vector space space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ⟨
                      %mi g
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} C^\infty(\Sigma)\langle g \rangle
                spanned by a formal variable
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                (the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msubsup
                                %mi C
                                %mi c
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi Σ
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mo ≃
                            %mtd
                              %msubsup
                                %mi C
                                %mi c
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ⟨
                              %mi g
                              %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      C_c^\infty(\Sigma) &amp;\overset{\simeq}{\longrightarrow}&amp; C_c^\infty(X)\langle g\rangle
                      }
              %p
                which are thus bump functions constant over a neighbourhood
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
                not on 1 but on the formal parameter
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi sw
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi U
                      %mo =
                      %mi g
                      %mspace{:width => "thinmathspace"}
                    %annotation{:encoding => "application/x-tex"}
                      g_{sw}\vert_U = g
                      \\,
              %p
                In this sense we may think of the adiabatic switching as
                %em being
                the spacetime-depependent coupling “constant”.
            %p
              The following lemma
              %a.maruku-ref{:href => "#CausalPartition"}
              will be key in the derivation (proof of prop.
              %a.maruku-ref{:href => "#CausalLocalityOfThePerturbativeSMatrix"}
              below) of the
              %a.existingWikiWord{:href => "/nlab/show/causal+locality"} causal locality
              of
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+quantum+observables"} algebra of quantum observables
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
            #CausalPartition.num_lemma
              %h6#lemma Lemma
              %p
                %strong (causal partition)
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo ⊂
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \mathcal{O} \subset \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/causally+closed+subset"} causally closed subset
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CausalComplementOfSubsetOfLorentzianManifold"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in C^\infty_{cp}(\Sigma)
                be a
                %a.existingWikiWord{:href => "/nlab/show/compact+support"} compactly supported
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                which vanishes on a
                %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⊃
                        %mi 𝒪
                      %annotation{:encoding => "application/x-tex"} U \supset \mathcal{O}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %msub
                          %mo{:stretchy => "false"} |
                          %mi U
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} f\vert_U = 0
              %p
                Then there exists a
                %em causal partition
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                in that there exist compactly supported smooth functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi r
                      %mo ∈
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a,r \in C^\infty_{cp}(\Sigma)
                such that
              %ol
                %li
                  %p
                    they sum up to
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi f
                          %annotation{:encoding => "application/x-tex"} f
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo =
                          %mi a
                          %mo +
                          %mi r
                        %annotation{:encoding => "application/x-tex"}
                          f = a + r
                %li
                  %p
                    their
                    %a.existingWikiWord{:href => "/nlab/show/support"} support
                    satisfies the following causal ordering (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#CausalOrdering"}
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi supp
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo ∨
                            %mspace{:width => "negativethinmathspace"}
                            %mspace{:width => "negativethinmathspace"}
                            %mspace{:width => "negativethinmathspace"}
                            %mo ∧
                          %mi 𝒪
                          %mrow
                            %mo ∨
                            %mspace{:width => "negativethinmathspace"}
                            %mspace{:width => "negativethinmathspace"}
                            %mspace{:width => "negativethinmathspace"}
                            %mo ∧
                          %mi supp
                          %mo{:stretchy => "false"} (
                          %mi r
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          supp(a) {\vee\!\!\!\wedge} \mathcal{O} {\vee\!\!\!\wedge} supp(r)
                          \\,.
            .proof
              %h6#proof_idea Proof idea
              %p
                By assumption
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
                has a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \Sigma_p
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                %a.existingWikiWord{:href => "/nlab/show/leaf"} leaf
                of a
                %a.existingWikiWord{:href => "/nlab/show/foliation"} foliation
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                by Cauchy surfaces, given by a
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msub
                        %mi Σ
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \Sigma \simeq (-1,1) \times \Sigma_p
                with the original
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \Sigma_p
                at zero. There exists then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \epsilon \in (0,1)
                such that the restriction of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} supp(f)
                to the interval
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi ϵ
                      %mo ,
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-\epsilon, \epsilon)
                is in the
                %a.existingWikiWord{:href => "/nlab/show/causal+complement"} causal complement
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi 𝒪
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{\mathcal{O}}
                of the given region (def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#CausalComplementOfSubsetOfLorentzianManifold"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∩
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi ϵ
                      %mo ,
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msub
                        %mi Σ
                        %mi p
                      %mspace{:width => "thickmathspace"}
                      %mo ⊂
                      %mspace{:width => "thickmathspace"}
                      %mover
                        %mi 𝒪
                        %mo ¯
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      supp(f) \cap (-\epsilon, \epsilon) \times \Sigma_p
                      \\;\subset\;
                      \\overline{\mathcal{O}}
                      \\,.
              %p
                Let then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi χ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Σ
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \chi \colon \Sigma \to \mathbb{R}
                be any
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                with
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi χ
                          %msub
                            %mo{:stretchy => "false"} |
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %mo ,
                              %mn 0
                              %mo{:stretchy => "false"} ]
                              %mo ×
                              %msub
                                %mi Σ
                                %mi p
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} \chi\vert_{(-1,0] \times \Sigma_p} = 1
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi χ
                          %msub
                            %mo{:stretchy => "false"} |
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi ϵ
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ×
                              %msub
                                %mi Σ
                                %mi p
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \chi\vert_{(\epsilon,1) \times \Sigma_p} = 0
                    \.
              %p Then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ≔
                      %mi χ
                      %mo ⋅
                      %mi f
                      %mphantom
                        %mi AAA
                      %mtext and
                      %mphantom
                        %mi AAA
                      %mi a
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %mi χ
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi f
                    %annotation{:encoding => "application/x-tex"}
                      r \coloneqq \chi \cdot f
                      \\phantom{AAA}
                      \\text{and}
                      \\phantom{AAA}
                      a \coloneqq (1-\chi) \cdot f
              %p are smooth functions as required.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              This concludes our discussion of
              %a.existingWikiWord{:href => "/nlab/show/spin"} spin
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a{:href => "#Fields"} next chapter
              we consider the concept of
              %em
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
          %div
            %h2#Fields Fields
            %p In this chapter we discuss these topics:
            %ul
              %li
                %p
                  %em
                    %a{:href => "#FieldBundles"} Field bundles
              %li
                %p
                  %em
                    %a{:href => "#NonFiniteDimensionalGeometry"} Spaces of field histories
              %li
                %p
                  %em
                    %a{:href => "#InfinitesimalGeometry"} Infinitesimal geometry
              %li
                %p
                  %em
                    %a{:href => "#Supergeometry"} Fermion fields and Supergeometry
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
              on a given
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (a history of spatial
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field+configurations"} field configurations
              %a.maruku-ref{:href => "#FieldHistoriesAsHistoriesOfFieldConfigurations"}
              below) is a
              %a.existingWikiWord{:href => "/nlab/show/quantity"} quantity
              assigned to each point of spacetime (each
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/event"} event
              %em
                %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
                %a.existingWikiWord{:href => "/nlab/show/field+history"} history
              (example
              %a.maruku-ref{:href => "#Electromagnetism"}
              below) is at each point of spacetime a collection of
              %a.existingWikiWord{:href => "/nlab/show/vectors"} vectors
              that encode the direction in which a
              %a.existingWikiWord{:href => "/nlab/show/charged+particle"} charged particle
              passing through that point would feel a
              %a.existingWikiWord{:href => "/nlab/show/force"} force
              (the “
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+force"}> Lorentz force
              ”, see example
              %a.maruku-ref{:href => "#Electromagnetism"}
              below).
            %p
              This is readily formalized (def.
              %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              below): If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              of “values” that the given kind of field may take at any spacetime point, then a field history
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              is modeled as a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              from spacetime to this space of values:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Σ
                    %mo ⟶
                    %mi F
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi
                    \\;\colon\;
                    \\Sigma
                    \\longrightarrow
                    F
                    \\,.
            %p
              It will be useful to unify
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              and the space of
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              values (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/field+fiber"} field fiber
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi Σ
                    %mo ×
                    %mi F
                  %annotation{:encoding => "application/x-tex"}
                    E \;\coloneqq\; \Sigma \times F
            %p
              and to think of this equipped with the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              map onto the first factor as a
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              of spaces of field values over spacetime
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                          %mtd
                            %mo ≔
                          %mtd
                            %mi Σ
                            %mo ×
                            %mi F
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi fb
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi pr
                                    %mn 1
                        %mtr
                          %mtd
                            %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E &amp;\coloneqq&amp; \Sigma \times F
                    \\\
                    {}^{\mathllap{fb}}\downarrow &amp; \swarrow_{\mathrlap{pr_1}}
                    \\\
                    \\Sigma
                    }
                    \\,.
            %p
              This is then called the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              of field values is the
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              of this
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#FiberBundle"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/field+fiber"} field fiber
              = succeed ".)" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/fiber+bundles+in+physics"} fiber bundles in physics
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to}\Sigma
              %em
                %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
              is a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of that bundle (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Sections"}
              %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
              concerns the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of all possible field histories
              %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
              of the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (example
              %a.maruku-ref{:href => "#DiffeologicalSpaceOfFieldHistories"}
              below). This is a very “large”
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+space"} generalized smooth space
              %em
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
              (def.
              %a.maruku-ref{:href => "#DiffeologicalSpace"}
              below).
            %p
              Or rather, in the presence of
              %a.existingWikiWord{:href => "/nlab/show/fermion+fields"} fermion fields
              such as the
              %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              (example
              %a.maruku-ref{:href => "#DiracFieldBundle"}
              below), the
              %a.existingWikiWord{:href => "/nlab/show/Pauli+exclusion+principle"} Pauli exclusion principle
              demands that the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/supermanifold"} super-manifold
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              (example
              %a.maruku-ref{:href => "#DiracSpaceOfFieldHistories"}
              below) is a
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} super-geometric
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+space"} generalized smooth space
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+smooth+set"} super smooth set
              (def.
              %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
              below).
            %p
              This smooth structure on the
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              will be crucial when we discuss
              %a.existingWikiWord{:href => "/nlab/show/observables"} observables
              of a
              %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
              = succeed "," do
                %a{:href => "#Observables"} below
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              %em linear
              observables of a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
              are given by
              %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#LinearObservablesAreTheCompactlySupportedDistributions"}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/delta+distributions"} delta distributions
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              themselves.
            %p
              Hence there are these aspects of the concept of “
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"}> field
              ” in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %strong
                aspects of the concept of
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            %table
              %thead
                %tr
                  %th aspect
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/term"} term
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/type"} type
                  %th description
                  %th def.
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field component
                  %td{:style => "text-align: left;"}
