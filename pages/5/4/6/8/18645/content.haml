                      }
              %p
                of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mn 1
                      %mo ,
                      %msub
                        %mi e
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} e_1, e_2
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo [
                        %mi R
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi e
                          %mn 1
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
