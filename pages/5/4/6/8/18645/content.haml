            %p One defines the following operations on these real algebras:
            #Conjugation.num_defn
              %h6#definition_4 Definition
              %p
                %strong
                  (conjugation,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/real+part"} real part
                  %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary part
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕂
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mi ℝ
                        %mo ,
                        %mi ℂ
                        %mo ,
                        %mi ℍ
                        %mo ,
                        %mi 𝕆
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \mathbb{K} \in \{\mathbb{R}, \mathbb{C}, \mathbb{H}, \mathbb{O}\}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝕂
                      %mo ⟶
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"}
                      (-)^\ast
                      \\;\colon\;
                      \\mathbb{K}
                      \\longrightarrow
                      \\mathbb{K}
              %p
                be the
                %a.existingWikiWord{:href => "/nlab/show/antihomomorphism"} antihomomorphism
                of real algebras
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi r
                              %mi a
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mo =
                              %mi r
                              %msup
                                %mi a
                                %mo *
                            %mtd
                              %mo ,
                              %mtext for
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mi r
                              %mo ∈
                              %mi ℝ
                              %mo ,
                              %mi a
                              %mo ∈
                              %mi 𝕂
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi a
                              %mi b
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mo =
                              %msup
                                %mi b
                                %mo *
                              %msup
                                %mi a
                                %mo *
                            %mtd
                              %mo ,
                              %mtext for
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mi a
                              %mo ,
                              %mi b
                              %mo ∈
                              %mi 𝕂
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      (r a)^\ast  = r a^\ast &amp;, \text{for}\;\; r \in \mathbb{R}, a \in \mathbb{K}
                      \\\
                      (a b)^\ast = b^\ast a^\ast &amp;,\text{for}\;\; a,b \in \mathbb{K}
                      \\end{aligned}
              %p
                given on the generators of def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TheComplexNumbers"}
                %a.maruku-ref{:href => "#TheQuaternions"}
                and def.
                %a.maruku-ref{:href => "#TheOctonions"}
                by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi e
                        %mi i
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mi e
                        %mi i
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (e_i)^\ast = - e_i
                      \\,.
              %p
                This operation makes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                into a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
                this is called
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
                = succeed "." do
                  %em conjugation
              %p Let then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Re
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝕂
                      %mo ⟶
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      Re \;\colon\; \mathbb{K} \longrightarrow \mathbb{R}
              %p
                be the
                %a.existingWikiWord{:href => "/nlab/show/function"} function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Re
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo +
                      %msup
                        %mi a
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Re(a) \;\coloneqq\; \tfrac{1}{2}(a + a^\ast)
              %p
                (“
                %a.existingWikiWord{:href => "/nlab/show/real+part"}> real part
                ”) and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Im
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝕂
                      %mo ⟶
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      Im \;\colon\; \mathbb{K} \longrightarrow \mathbb{R}
              %p
                be the
                %a.existingWikiWord{:href => "/nlab/show/function"} function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Im
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo −
                      %msup
                        %mi a
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Im(a) \;\coloneqq \; \tfrac{1}{2}(a - a^\ast)
              %p
                (“
                %a.existingWikiWord{:href => "/nlab/show/imaginary+part"}> imaginary part
                ”).
              %p
                It follows that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} a \in \mathbb{K}
                then the product of a with its conjugate is in the real
                %a.existingWikiWord{:href => "/nlab/show/center"} center
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %msup
                        %mi a
                        %mo *
                      %mo =
                      %msup
                        %mi a
                        %mo *
                      %mi a
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mi ℝ
                      %mo ↪
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"}
                      a a^\ast = a^\ast a \;\in \mathbb{R} \hookrightarrow \mathbb{K}
              %p
                and we write the
                %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
                of this expression as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi a
                        %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msqrt
                        %mrow
                          %mi a
                          %msup
                            %mi a
                            %mo *
                    %annotation{:encoding => "application/x-tex"}
                      {\vert a\vert}
                      \\;\coloneqq\;
                      \\sqrt{a a^\ast}
              %p
                called the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/norm"} norm
                or
                %em
                  %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
                %a.existingWikiWord{:href => "/nlab/show/function"} function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝕂
                      %mo ⟶
                      %mi ℝ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      {\vert -\vert}
                      \\;\colon\;
                      \\mathbb{K}
                      \\longrightarrow
                      \\mathbb{R}
                      \\,.
              %p
                This norm operation clearly satisfies the following properties (for all
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ∈
                        %mi 𝕂
                      %annotation{:encoding => "application/x-tex"} a,b \in \mathbb{K}
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi a
                          %mo{:stretchy => "false"} |
                          %mo ≥
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \vert a \vert \geq 0
                    ;
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi a
                            %mo{:stretchy => "false"} |
                          %mo =
                          %mn 0
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo ⇔
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi a
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} {\vert a \vert } = 0 \;\;\;\;\; \Leftrightarrow\;\;\;\;\;\; a = 0
                    ;
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi a
                            %mi b
                            %mo{:stretchy => "false"} |
                          %mo =
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi a
                            %mo{:stretchy => "false"} |
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi b
                            %mo{:stretchy => "false"} |
                        %annotation{:encoding => "application/x-tex"} {\vert a b \vert } = {\vert a \vert} {\vert b \vert}
              %p
                and hence makes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/normed+algebra"} normed algebra
              %p
                Since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/division+algebra"} division algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/division+algebra"} division algebra
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi b
                      %mo =
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⇒
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi a
                      %mo =
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mtext or
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi b
                      %mo =
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      a b = 0 \;\;\;\;\;\; \Rightarrow \;\;\;\;\;\; a = 0 \;\; \text{or} \;\; b = 0
                      \\,.
              %p
                Hence the conjugation operation makes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                a
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/normed+division+algebra"} normed division algebra
            #SequenceOfInclusionsOfRealNormedDivisionAlgebras.num_remark
              %h6#remark Remark
              %p
                %strong
                  (sequence of inclusions of real
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              %p
                Suitably embedding the sets of generators in def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TheComplexNumbers"}
                %a.maruku-ref{:href => "#TheQuaternions"}
                and def.
                %a.maruku-ref{:href => "#TheOctonions"}
                into each other yields sequences of real
                %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
                %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} inclusions
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo ↪
                      %mi ℂ
                      %mo ↪
                      %mi ℍ
                      %mo ↪
                      %mi 𝕆
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{R}
                      \\hookrightarrow
                      \\mathbb{C}
                      \\hookrightarrow
                      \\mathbb{H}
                      \\hookrightarrow
                      \\mathbb{O}
                      \\,.
              %p For example for the first two inclusions we may send each generator to the generator of the same name, and for the last inclusion me may choose
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mo ↦
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %msub
                                %mi e
                                %mn 1
                            %mtd
                              %mo ↦
                            %mtd
                              %msub
                                %mi e
                                %mn 3
                          %mtr
                            %mtd
                              %msub
                                %mi e
                                %mn 2
                            %mtd
                              %mo ↦
                            %mtd
                              %msub
                                %mi e
                                %mn 4
                          %mtr
                            %mtd
                              %msub
                                %mi e
                                %mn 3
                            %mtd
                              %mo ↦
                            %mtd
                              %msub
                                %mi e
                                %mn 6
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      1 &amp;\mapsto&amp; 1
                      \\\
                      e_1 &amp;\mapsto &amp; e_3
                      \\\
                      e_2 &amp;\mapsto&amp; e_4
                      \\\
                      e_3 &amp;\mapsto&amp; e_6
                      }
            #HurwitzTheorem.num_prop
              %h6#proposition Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Hurwitz+theorem"}> Hurwitz theorem
                  \:
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \mathbb{C}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℍ
                      %annotation{:encoding => "application/x-tex"} \mathbb{H}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕆
                      %annotation{:encoding => "application/x-tex"} \mathbb{O}
                  are the normed real division algebras)
              %p
                The four algebras of
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                    %annotation{:encoding => "application/x-tex"} \mathbb{H}
                and
                %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕆
                    %annotation{:encoding => "application/x-tex"} \mathbb{O}
                from def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TheComplexNumbers"}
                %a.maruku-ref{:href => "#TheQuaternions"}
                and def.
                %a.maruku-ref{:href => "#TheOctonions"}
                respectively, which are real
                %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
                via def.
                = succeed "," do
                  %a.maruku-ref{:href => "#Conjugation"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                %em only
                real normed division algebras that exist.
            .num_remark
              %h6#remark_2 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Cayley-Dickson+construction"} Cayley-Dickson construction
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/sedenions"} sedenions
              %p
                While prop.
                %a.maruku-ref{:href => "#HurwitzTheorem"}
                says that the sequence from remark
                %a.maruku-ref{:href => "#SequenceOfInclusionsOfRealNormedDivisionAlgebras"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo ↪
                      %mi ℂ
                      %mo ↪
                      %mi ℍ
                      %mo ↪
                      %mi 𝕆
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{R}
                      \\hookrightarrow
                      \\mathbb{C}
                      \\hookrightarrow
                      \\mathbb{H}
                      \\hookrightarrow
                      \\mathbb{O}
              %p
                is maximal in the
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                of real normed non-associative
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
                = succeed "." do
                  %em
                    forming the
                    %a.existingWikiWord{:href => "/nlab/show/Cayley-Dickson+double+algebra"} Cayley-Dickson double algebra
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo ↪
                      %mi ℂ
                      %mo ↪
                      %mi ℍ
                      %mo ↪
                      %mi 𝕆
                      %mo ↪
                      %mi 𝕊
                      %mo ↪
                      %mi ⋯
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{R}
                      \\hookrightarrow
                      \\mathbb{C}
                      \\hookrightarrow
                      \\mathbb{H}
                      \\hookrightarrow
                      \\mathbb{O}
                      \\hookrightarrow
                      \\mathbb{S}
                      \\hookrightarrow
                      \\cdots
              %p
                where the next algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕊
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}
                is called the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/sedenions"} sedenions
            %p
              What actually matters for the following relation of the real normed division algebras to
              %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
              is that they are also
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
            #AlternativeAlgebra.num_defn
              %h6#definition_5 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"}> alternative algebras
                  )
              %p
                Given any
                %a.existingWikiWord{:href => "/nlab/show/non-associative+algebra"} non-associative algebra
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo −
                      %mspace{:width => "thickmathspace"}
                      %mi A
                      %mo ⊗
                      %mi A
                      %mo ⊗
                      %mi A
                      %mo ⟶
                      %mi A
                    %annotation{:encoding => "application/x-tex"}
                      [-,-,-] \;-\; A \otimes A \otimes A \longrightarrow A
              %p
                given on any elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a,b,c \in A
                by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} ]
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mi c
                      %mo −
                      %mi a
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      [a,b,c] \coloneqq (a b) c - a (b c)
              %p
                is called the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                (in analogy with the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} ]
                      %mo ≔
                      %mi a
                      %mi b
                      %mo −
                      %mi b
                      %mi a
                    %annotation{:encoding => "application/x-tex"} [a,b] \coloneqq a b - b a
                ).
              %p
                If the associator is completely antisymmetric (in that for any
                %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
                of three elements then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi a
                        %mrow
                          %msub
                            %mi σ
                            %mn 1
                      %mo ,
                      %msub
                        %mi a
                        %mrow
                          %msub
                            %mi σ
                            %mn 2
                      %mo ,
                      %msub
                        %mi a
                        %mrow
                          %msub
                            %mi σ
                            %mn 3
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi σ
                          %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %msub
                        %mi a
                        %mn 2
                      %mo ,
                      %msub
                        %mi a
                        %mn 3
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [a_{\sigma_1}, a_{\sigma_2}, a_{\sigma_3}] = (-1)^{\vert \sigma\vert} [a_1, a_2, a_3]
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi σ
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} \vert \sigma \vert
                the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature of the permutation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is called an
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative algebra
              %p
                If the
                %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
                of the
                %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
                is different from 2, then alternativity is readily seen to be equivalent to the conditions that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a,b \in A
                then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mi b
                      %mo =
                      %mi a
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mtext and
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mi b
                      %mo =
                      %mi a
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (a a)b = a (a b)
                      \\;\;\;\;\;
                      \\text{and}
                      \\;\;\;\;\;
                      (a b) b = a (b b)
                      \\,.
            %p We record some basic properties of associators in alternative star-algebras that we need below:
            #PropertiesOfAssociatorInAlternativeAlgebra.num_prop
              %h6#proposition_2 Proposition
              %p
                %strong
                  (properties of
                  %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/star+algebras"} star algebras
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                be an
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative algebra
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#AlternativeAlgebra"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
                = succeed "):" do
                  %a.maruku-ref{:href => "#Conjugation"}
              %ol
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                    vanishes when at least one argument is
                    %a.existingWikiWord{:href => "/nlab/show/real+part"} real
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi Re
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi b
                          %mo ,
                          %mi c
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"}
                          [Re(a),b,c]
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                    changes sign when one of its arguments is conjugated
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi a
                          %mo ,
                          %mi b
                          %mo ,
                          %mi c
                          %mo{:stretchy => "false"} ]
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi a
                            %mo *
                          %mo ,
                          %mi b
                          %mo ,
                          %mi c
                          %mo{:stretchy => "false"} ]
                          %mspace{:width => "thinmathspace"}
                          %mo ;
                        %annotation{:encoding => "application/x-tex"}
                          [a,b,c] = -[a^\ast,b,c]
                          \\,;
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                    vanishes when one of its arguments is the conjugate of another
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi a
                          %mo ,
                          %msup
                            %mi a
                            %mo *
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} ]
                          %mo =
                          %mn 0
                          %mspace{:width => "thinmathspace"}
                          %mo ;
                        %annotation{:encoding => "application/x-tex"}
                          [a,a^\ast, b] = 0
                          \\,;
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                    is purely
                    %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Re
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} [
                          %mi a
                          %mo ,
                          %mi b
                          %mo ,
                          %mi c
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          Re([a,b,c]) = 0
                          \\,.
            .proof
              %h6#proof Proof
              %p That the associator vanishes as soon as one argument is real is just the linearity of an algebra product over the ground ring.
              %p Hence in fact
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi Im
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Im
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Im
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      [a,b,c] = [Im(a), Im(b), Im(c)]
                      \\,.
              %p This implies the second statement by linearity. And so follows the third statement by skew-symmetry:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo ,
                      %msup
                        %mi a
                        %mo *
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo ,
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      [a,a^\ast,b] = -[a,a,b] = 0
                      \\,.
              %p The fourth statement finally follows by this computation:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mspace{:width => "thinmathspace"}
                              %mo{:stretchy => "false"} [
                              %mi a
                              %mo ,
                              %mi b
                              %mo ,
                              %mi c
                              %msup
                                %mo{:stretchy => "false"} ]
                                %mo *
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} [
                              %msup
                                %mi c
                                %mo *
                              %mo ,
                              %msup
                                %mi b
                                %mo *
                              %mo ,
                              %msup
                                %mi a
                                %mo *
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} [
                              %mi c
                              %mo ,
                              %mi b
                              %mo ,
                              %mi a
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} [
                              %mi a
                              %mo ,
                              %mi b
                              %mo ,
                              %mi c
                              %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\,[ a, b, c]^\ast
                      \&amp; =
                      \-[c^\ast, b^\ast, a^\ast]
                      \\\
                      \&amp; =
                      \-[c,b,a]
                      \\\
                      \&amp; =
                      \-[a,b,c]
                      \\end{aligned}
                      \\,.
              %p
                Here the first equation follows by inspection and using that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mi b
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mo =
                        %msup
                          %mi b
                          %mo *
                        %msup
                          %mi a
                          %mo *
                      %annotation{:encoding => "application/x-tex"} (a b)^\ast = b^\ast a^\ast
            %p It is immediate to check that:
            #RCHOAreAlternative.num_prop
              %h6#proposition_3 Proposition
              %p
                %strong
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  ,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \mathbb{C}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℍ
                      %annotation{:encoding => "application/x-tex"} \mathbb{H}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕆
                      %annotation{:encoding => "application/x-tex"} \mathbb{O}
                  are real
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
              %p
                The real algebras of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                = succeed "," do
                  %a.maruku-ref{:href => "#TheComplexNumbers"}
                %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
                def.
                %a.maruku-ref{:href => "#TheQuaternions"}
                and
                %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
                def.
                %a.maruku-ref{:href => "#TheOctonions"}
                are
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#AlternativeAlgebra"}
            .proof
              %h6#proof_2 Proof
              %p
                Since the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                and
                %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
                are
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                vanishes identically. It only remains to see that the associator of the
                %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
                is skew-symmetric. By linearity it is sufficient to check this on generators. So let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi i
                      %mo →
                      %msub
                        %mi e
                        %mi j
                      %mo →
                      %msub
                        %mi e
                        %mi k
                    %annotation{:encoding => "application/x-tex"} e_i \to e_j \to e_k
                be a circle or a cyclic permutation of an edge in the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Fano+plane"} Fano plane
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi e
                                %mi i
                              %msub
                                %mi e
                                %mi j
                              %mo{:stretchy => "false"} )
                              %msub
                                %mi e
                                %mi j
                            %mtd
                              %mo =
                              %msub
                                %mi e
                                %mi k
                              %msub
                                %mi e
                                %mi j
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi e
                                %mi j
                              %msub
                                %mi e
                                %mi k
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi e
                                %mi i
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %msub
                                %mi e
                                %mi i
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi e
                                %mi j
                              %msub
                                %mi e
                                %mi j
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      (e_i e_j) e_j
                      \&amp;=
                      e_k e_j
                      \\\
                      \&amp;=
                      \- e_j e_k
                      \\\
                      \&amp; =
                      \-e_i
                      \\\
                      \&amp; =
                      e_i (e_j e_j)
                      \\end{aligned}
              %p and similarly
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi e
                                %mi i
                              %msub
                                %mi e
                                %mi i
                              %mo{:stretchy => "false"} )
                              %msub
                                %mi e
                                %mi j
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi e
                                %mi j
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi e
                                %mi k
                              %msub
                                %mi e
                                %mi i
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %msub
                                %mi e
                                %mi i
                              %msub
                                %mi e
                                %mi k
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %msub
                                %mi e
                                %mi i
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi e
                                %mi i
                              %msub
                                %mi e
                                %mi j
                              %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      (e_i e_i ) e_j
                      \&amp;=
                      \- e_j
                      \\\
                      \&amp;=
                      \- e_k e_i
                      \\\
                      \&amp;=
                      e_i e_k
                      \\\
                      \&amp;=
                      e_i (e_i e_j)
                      \\end{aligned}
                      \\,.
            %p
              The analog of the
              %a.existingWikiWord{:href => "/nlab/show/Hurwitz+theorem"} Hurwitz theorem
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
            #ZornTheorem.num_prop
              %h6#proposition_4 Proposition
              %p
                %strong
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  ,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \mathbb{C}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℍ
                      %annotation{:encoding => "application/x-tex"} \mathbb{H}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕆
                      %annotation{:encoding => "application/x-tex"} \mathbb{O}
                  are precisely the
                  %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
                  %a.existingWikiWord{:href => "/nlab/show/real+number"} real
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              %p
                The only
                %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
                over the
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                which are also
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#AlternativeAlgebra"}
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                themselves, the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
                and the
                %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
                from prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#RCHOAreAlternative"}
            %p
              This is due to (
              %a{:href => "normed+division#algebra#Zorn30"}> Zorn 30
              ).
            %p For the following, the key point of alternative algebras is this equivalent characterization:
            #ArtinTheorem.num_prop
              %h6#proposition_5 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative algebra
                  detected on subalgebras spanned by any two elements)
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/nonassociative+algebra"} nonassociative algebra
                is alternative, def.
                = succeed "," do
                  %a.maruku-ref{:href => "#AlternativeAlgebra"}
                %a.existingWikiWord{:href => "/nlab/show/subalgebra"} subalgebra
                generated by any two elements is an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            %p
              This is due to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Emil+Artin"} Emil Artin
              = succeed ")." do
                %a{:href => "alternative+algebra#Schafer95"} Schafer 95, p. 18
            %p
              Proposition
              %a.maruku-ref{:href => "#ArtinTheorem"}
              is what allows to carry over a minimum of
              %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
              also to the
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
              such as to yield a representation of the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 9
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{9,1}
              %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebra"}
              below.
            %p
              So we will be looking at a
              %a.existingWikiWord{:href => "/nlab/show/fragment"} fragment
              of
              %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
              over these four
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            #MatrixNotation.num_defn
              %h6#definition_6 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
                  with values in real
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                be one of the four real
                %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
                from prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#HurwitzTheorem"}
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
                %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
                from prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#ZornTheorem"}
              %p
                Say that an
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ×
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n \times n
                %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
                with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %msub
                        %mi Mat
                        %mrow
                          %mi n
                          %mo ×
                          %mi n
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      A\in Mat_{n\times n}(\mathbb{K})
              %p
                is a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/hermitian+matrix"} hermitian matrix
                if the
                %a.existingWikiWord{:href => "/nlab/show/transpose+matrix"} transpose matrix
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi A
                        %mi t
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi i
                          %mi j
                      %mo ≔
                      %msub
                        %mi A
                        %mrow
                          %mi j
                          %mi i
                    %annotation{:encoding => "application/x-tex"} (A^t)_{i j} \coloneqq A_{j i}
                equals the componentwise
                %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} conjugated
                matrix (def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#Conjugation"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mi t
                      %mo =
                      %msup
                        %mi A
                        %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      A^t = A^\ast
                      \\,.
              %p Hence with the notation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo †
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi t
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"}
                      (-)^\dagger \coloneqq ((-)^t)^\ast
              %p
                we have that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is a
                %a.existingWikiWord{:href => "/nlab/show/hermitian+matrix"} hermitian matrix
                precisely if
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %msup
                        %mi A
                        %mo †
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      A = A^\dagger
                      \\,.
              %p
                We write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Mat
                        %mrow
                          %mn 2
                          %mo ×
                          %mn 2
                        %mi her
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Mat_{2 \times 2}^{her}(\mathbb{K})
                for the
                %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
                of hermitian matrices.
            #TraceReversal.num_defn
              %h6#definition_7 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/trace"} trace
                  reversal)
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %msubsup
                        %mi Mat
                        %mrow
                          %mn 2
                          %mo ×
                          %mn 2
                        %mi her
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \in Mat_{2 \times 2}^{her}(\mathbb{K})
                be a hermitian
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mo ×
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2 \times 2
                matrix as in def.
                = succeed "." do
                  %a.maruku-ref{:href => "#MatrixNotation"}
                %em trace reversal
                is the result of subtracting its
                %a.existingWikiWord{:href => "/nlab/show/trace"} trace
                times the identity matrix:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ˜
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi A
                      %mo −
                      %mo{:stretchy => "false"} (
                      %mi tr
                      %mi A
                      %mo{:stretchy => "false"} )
                      %msub
                        %mn 1
                        %mrow
                          %mi n
                          %mo ×
                          %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\tilde A \;\coloneqq\; A - (tr A) 1_{n\times n}
                      \\,.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#MinkowskiSpacetimeInCriticalDimensions
              %strong Minkowski spacetime in dimensions 3,4,6 and 10
            %p
              We now discover
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              of dimension 3,4,6 and 10, in terms of the real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              from prop.
              = succeed ":" do
                %a.maruku-ref{:href => "#ZornTheorem"}
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              and def.
              %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              below.
            #SpacetimeAsMatrices.num_prop
              %h6#propositiondefinition Proposition/Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                  as
                  %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
                  of
                  %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
                  in
                  %a.existingWikiWord{:href => "/nlab/show/real+number"} real
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                be one of the four real
                %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
                from prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#HurwitzTheorem"}
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
                %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
                from prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#ZornTheorem"}
              %p
                Then the
                %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mo ×
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2 \times 2
                %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#MatrixNotation"}
                %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                whose
                %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %msubsup
                          %mo{:stretchy => "false"} |
                          %mi η
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} {\vert -\vert^2_\eta}
                is the negative of the
                %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
                operation on matrices is
                = succeed ":" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              #eq:MinkowskiSpacetimeFromHermitianMatricesWithDeterminant.maruku-equation
                %span.maruku-eq-number (8)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msup
                                %mi ℝ
                                %mrow
                                  %msub
                                    %mi dim
                                    %mi ℝ
                                  %mo{:stretchy => "false"} (
                                  %mi 𝕂
                                  %mo{:stretchy => "false"} )
                                  %mo +
                                  %mn 1
                                  %mo ,
                                  %mn 1
                            %mtd
                              %mo ≔
                              %mrow
                                %mo (
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %msub
                                      %mi dim
                                      %mrow
                                        %mi ℝ
                                        %mo{:stretchy => "false"} (
                                        %mi 𝕂
                                        %mo{:stretchy => "false"} )
                                    %mo +
                                    %mn 2
                                %mo ,
                                %mrow
                                  %mo{:stretchy => "false"} |
                                  %mo −
                                  %msubsup
                                    %mo{:stretchy => "false"} |
                                    %mi η
                                    %mn 2
                                %mo )
                            %mtd
                              %mo ≔
                              %mrow
                                %mo (
                                %msubsup
                                  %mi Mat
                                  %mrow
                                    %mn 2
                                    %mo ×
                                    %mn 2
                                  %mi her
                                %mo{:stretchy => "false"} (
                                %mi 𝕂
                                %mo{:stretchy => "false"} )
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi det
                                %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\mathbb{R}^{dim_{\mathbb{R}}(\mathbb{K})+1,1}
                      \&amp;
                      \\coloneqq
                      \\left(
                      \\mathbb{R}^{dim_{\mathbb{R}(\mathbb{K})}+2}
                      ,
                      {\vert -\vert^2_\eta}
                      \\right)
                      \&amp; \coloneqq
                      \\left(Mat_{2 \times 2}^{her}(\mathbb{K}), -det \right)
                      \\end{aligned}
                      \\,.
              %p hence
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 2
                              %mo ,
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2,1}
                    for
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝕂
                            %mo =
                            %mi ℝ
                          %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{R}
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 3
                              %mo ,
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^{3,1}
                    for
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝕂
                            %mo =
                            %mi ℂ
                          %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{C}
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 5
                              %mo ,
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^{5,1}
                    for
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝕂
                            %mo =
                            %mi ℍ
                          %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{H}
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 9
                              %mo ,
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^{9,1}
                    for
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝕂
                            %mo =
                            %mi 𝕆
                          %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{O}
              %p
                Here we think of the
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                on the left as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
                with
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ≔
                      %msub
                        %mi dim
                        %mi ℝ
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      p \coloneqq dim_{\mathbb{R}}(\mathbb{K})+1
              %p
                equipped with the canonical coordinates labeled
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi x
                          %mi μ
                        %msubsup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi μ
                            %mo =
                            %mn 0
                          %mi p
                      %annotation{:encoding => "application/x-tex"} (x^\mu)_{\mu = 0}^p
              %p
                As a
                %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
                the identification is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mn 0
                      %mo ,
                      %msup
                        %mi x
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msup
                        %mi x
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ↦
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msup
                                  %mi x
                                  %mn 0
                                %mo +
                                %msup
                                  %mi x
                                  %mn 1
                              %mtd
                                %mi y
                            %mtr
                              %mtd
                                %msup
                                  %mi y
                                  %mo *
                              %mtd
                                %msup
                                  %mi x
                                  %mn 0
                                %mo −
                                %msup
                                  %mi x
                                  %mn 1
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mtext with
                      %mspace{:width => "thickmathspace"}
                      %mi y
                      %mo ≔
                      %msup
                        %mi x
                        %mn 2
                      %mn 1
                      %mo +
                      %msup
                        %mi x
                        %mn 3
                      %msub
                        %mi e
                        %mn 1
                      %mo +
                      %msup
                        %mi x
                        %mn 4
                      %msub
                        %mi e
                        %mn 2
                      %mo +
                      %mi ⋯
                      %mo +
                      %msup
                        %mi x
                        %mrow
                          %mn 2
                          %mo +
                          %msub
                            %mi dim
                            %mrow
                              %mi ℝ
                              %mo{:stretchy => "false"} (
                              %mi 𝕂
                              %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi e
                        %mrow
                          %msub
                            %mi dim
                            %mi ℝ
                          %mo{:stretchy => "false"} (
                          %mi 𝕂
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (x^0, x^1, \cdots, x^{d-1})
                      \\;\mapsto\;
                      \\left(
                      \\array{
                      x^0 + x^1 &amp; y
                      \\\
                      y^\ast &amp; x^0 - x^1
                      }
                      \\right)
                      \\;\;\;
                      \\text{with}\;
                      y \coloneqq x^2 1 + x^3 e_1 + x^4 e_2 +   \cdots + x^{2 + dim_{\mathbb{R}(\mathbb{K})}} \,e_{dim_{\mathbb{R}}(\mathbb{K})-1}
                      \\,.
              %p
                This means that the
                %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %msubsup
                          %mo{:stretchy => "false"} |
                          %mi η
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} {\vert - \vert^2_\eta}
                is given on an element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi v
                        %mi μ
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi μ
                          %mo =
                          %mn 0
                        %mi p
                    %annotation{:encoding => "application/x-tex"} v = (v^\mu)_{\mu = 0}^p
                by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi v
                          %mo{:stretchy => "false"} |
                        %mi η
                        %mn 2
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mo −
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi v
                        %mn 0
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo +
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi j
                          %mo =
                          %mn 1
                        %mi p
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi j
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      {\vert v \vert}^2_{\eta}
                      \\;=\;
                      \- (v^0)^2 + \underoverset{j = 1}{p}{\sum} (x^j)^2
                      \\,.
              %p
                By the
                %a.existingWikiWord{:href => "/nlab/show/polarization+identity"} polarization identity
                the
                %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %msubsup
                          %mo{:stretchy => "false"} |
                          %mi η
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} {\vert - \vert^2_\eta}
                induces a
                %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                      %mo ⊗
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                      %mo ⟶
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      \\eta \;\colon\; \mathbb{R}^{p,1}\otimes \mathbb{R}^{p,1} \longrightarrow \mathbb{R}
              %p given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi η
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi v
                                %mn 1
                              %mo ,
                              %msub
                                %mi v
                                %mn 2
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %msub
                                %mi η
                                %mrow
                                  %mi μ
                                  %mi ν
                              %msubsup
                                %mi v
                                %mn 1
                                %mi μ
                              %msubsup
                                %mi v
                                %mn 1
                                %mi ν
                          %mtr
                            %mtd
                            %mtd
                              %mo ≔
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msubsup
                                %mi v
                                %mn 1
                                %mn 0
                              %msubsup
                                %mi v
                                %mn 2
                                %mn 0
                              %mo +
                              %munderover
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi j
                                  %mo =
                                  %mn 1
                                %mi p
                              %msubsup
                                %mi v
                                %mn 1
                                %mi j
                              %msubsup
                                %mi v
                                %mn 2
                                %mi j
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\eta(v_1, v_2)
                      \&amp; =
                      \\eta_{\mu \nu} v_1^\mu v_1^\nu
                      \\\
                      \&amp; \coloneqq
                      \- v_1^0 v_2^0 + \underoverset{j  = 1}{p}{\sum} v_1^j v_2^j
                      \\end{aligned}
                      \\,.
              %p
                This is called the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
              %p
                Finally, under the above identification the operation of trace reversal from def.
                %a.maruku-ref{:href => "#TraceReversal"}
                corresponds to
                %em time reversal
                in that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msup
                                    %mi x
                                    %mn 0
                                  %mo +
                                  %msup
                                    %mi x
                                    %mn 1
                                %mtd
                                  %mi y
                              %mtr
                                %mtd
                                  %msup
                                    %mi y
                                    %mo *
                                %mtd
                                  %msup
                                    %mi x
                                    %mn 0
                                  %mo −
                                  %msup
                                    %mi x
                                    %mn 1
                          %mo )
                        %mo ˜
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msup
                                  %mi x
                                  %mn 0
                                %mo +
                                %msup
                                  %mi x
                                  %mn 1
                              %mtd
                                %mi y
                            %mtr
                              %mtd
                                %msup
                                  %mi y
                                  %mo *
                              %mtd
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msup
                                  %mi x
                                  %mn 0
                                %mo −
                                %msup
                                  %mi x
                                  %mn 1
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\widetilde{
                      \\left(
                      \\array{
                      x^0 + x^1 &amp; y
                      \\\
                      y^\ast &amp; x^0 - x^1
                      }
                      \\right)
                      }
                      \\;=\;
                      \\left(
                      \\array{
                      \-x^0 + x^1 &amp; y
                      \\\
                      y^\ast &amp; -x^0 - x^1
                      }
                      \\right)
                      \\,.
            .proof
              %h6#proof_3 Proof
              %p
                We need to check that under the given identification, the Minkowski norm-square is indeed given by minus the determinant on the corresponding hermitian matrices. This follows from the nature of the conjugation operation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (-)^\ast
                from def.
                = succeed ":" do
                  %a.maruku-ref{:href => "#Conjugation"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mo −
                              %mi det
                              %mrow
                                %mo (
                                %mrow
                                  %mtable
                                    %mtr
                                      %mtd
                                        %msup
                                          %mi x
                                          %mn 0
                                        %mo +
                                        %msup
                                          %mi x
                                          %mn 1
                                      %mtd
                                        %mi y
                                    %mtr
                                      %mtd
                                        %msup
                                          %mi y
                                          %mo *
                                      %mtd
                                        %msup
                                          %mi x
                                          %mn 0
                                        %mo −
                                        %msup
                                          %mi x
                                          %mn 1
                                %mo )
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi x
                                %mn 0
                              %mo +
                              %msup
                                %mi x
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi x
                                %mn 0
                              %mo −
                              %msup
                                %mi x
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo +
                              %mi y
                              %msup
                                %mi y
                                %mo *
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi x
                                %mn 0
                              %msup
                                %mo{:stretchy => "false"} )
                                %mn 2
                              %mo +
                              %munderover
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi i
                                  %mo =
                                  %mn 1
                                %mi p
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi x
                                %mi i
                              %msup
                                %mo{:stretchy => "false"} )
                                %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \-
                      det
                      \\left(
                      \\array{
                      x^0 + x^1 &amp; y
                      \\\
                      y^\ast &amp; x^0 - x^1
                      }
                      \\right)
                      \&amp; =
                      \-(x^0 + x^1)(x^0 - x^1)
                      +
                      y y^\ast
                      \\\
                      \&amp; =
                      \-(x^0)^2 + \underoverset{i = 1}{p}{\sum} (x^i)^2
                      \\end{aligned}
                      \\,.
            #MinkowskiMetricAndPhysicalUnitOfLength.num_remark
              %h6#remark_3 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/physical+units"} physical units
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/length"} length
              %p
                As the term “
                %a.existingWikiWord{:href => "/nlab/show/metric"}> metric
                ” suggests, in application to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/physics"} physics
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                in prop./def.
                %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
                is regarded as a
                = succeed ":" do
                  %em
                    measure of
                    %a.existingWikiWord{:href => "/nlab/show/length"} length
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %msub
                        %mi Γ
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi T
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} v \in \Gamma_x(T \mathbb{R}^{p,1})
                a
                %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
                at a point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                in Minkowski spacetime, interpreted as a displacement from
                %a.existingWikiWord{:href => "/nlab/show/event"} event
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                to event
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo +
                        %mi v
                      %annotation{:encoding => "application/x-tex"} x + v
              %ol
                %li
                  %p
                    if
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi η
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo &gt;
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \eta(v,v) \gt 0
                    then
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msqrt
                            %mrow
                              %mi η
                              %mo{:stretchy => "false"} (
                              %mi v
                              %mo ,
                              %mi v
                              %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"}
                          \\sqrt{\eta(v,v)} \in \mathbb{R}
                  %p
                    is interpreted as a measure for the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/spacelike"} spatial
                      %a.existingWikiWord{:href => "/nlab/show/distance"} distance
                    between
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                        %annotation{:encoding => "application/x-tex"} x
                    and
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi x
                            %mo +
                            %mi v
                          %annotation{:encoding => "application/x-tex"} x + v
                %li
                  %p
                    if
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi η
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo &lt;
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \eta(v,v) \lt 0
                    then
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msqrt
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi η
                              %mo{:stretchy => "false"} (
                              %mi v
                              %mo ,
                              %mi v
                              %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"}
                          \\sqrt{-\eta(v,v)} \in \mathbb{R}
                  %p
                    is interpreted as a measure for the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/timelike"} time
                      %a.existingWikiWord{:href => "/nlab/show/distance"} distance
                    between
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                        %annotation{:encoding => "application/x-tex"} x
                    and
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi x
                            %mo +
                            %mi v
                          %annotation{:encoding => "application/x-tex"} x + v
              %p
                But for this to make physical sense, an operational prescription needs to be specified that tells the experimentor how the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msqrt
                        %mrow
                          %mi η
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \sqrt{\eta(v,v)}
                is to be translated into an physical distance between actual
                %a.existingWikiWord{:href => "/nlab/show/events"} events
                in the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/observable+universe"} observable universe
              %p
                Such an operational prescription is called a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
                    of
                    %a.existingWikiWord{:href => "/nlab/show/length"} length
                = succeed "\u201D" do
                  %a.existingWikiWord{:href => "/nlab/show/centimeter"} centimeter
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cm
                    %annotation{:encoding => "application/x-tex"} cm
                is a physical unit of length, another one is “
                %a.existingWikiWord{:href => "/nlab/show/femtometer"}> femtometer
                ”
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi fm
                      %annotation{:encoding => "application/x-tex"} fm
              %p
                The combined information of a
                %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msqrt
                        %mrow
                          %mi η
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \sqrt{\eta(v,v)} \in \mathbb{R}
                and a
                %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
                of
                %a.existingWikiWord{:href => "/nlab/show/length"} length
                such as
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/meter"} meter
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msqrt
                        %mrow
                          %mi η
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi cm
                    %annotation{:encoding => "application/x-tex"}
                      \\sqrt{\eta(v,v)} \, cm
              %p
                is a prescription for finding actual distance in the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/observable+universe"} observable universe
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msqrt
                        %mrow
                          %mi η
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi fm
                    %annotation{:encoding => "application/x-tex"}
                      \\sqrt{\eta(v,v)} \, fm
              %p
                is another prescription, that translates the same
                %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msqrt
                        %mrow
                          %mi η
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \sqrt{\eta(v,v)}
                into another physical distance.
              %p
                But of course they are related, since
                %a.existingWikiWord{:href => "/nlab/show/physical+units"} physical units
                form a
                %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
                over the
                %a.existingWikiWord{:href => "/nlab/show/group"} group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℝ
                        %mrow
                          %mo &gt;
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\gt 0}
                of
                %a.existingWikiWord{:href => "/nlab/show/non-negative+number"} non-negative
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi fm
                      %mo =
                      %msup
                        %mn 10
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 13
                      %mi cm
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      fm = 10^{-13} cm
                      \\,,
              %p
                with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mn 10
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 13
                        %mo ∈
                        %msub
                          %mi ℝ
                          %mrow
                            %mo &gt;
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} 10^{-13} \in \mathbb{R}_{\gt 0}
              %p This means that once any one prescription of turning real numbers into spacetime distances is specified, then any other such prescription is obtained from this by rescaling these real numbers. For example
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msqrt
                                %mrow
                                  %mi η
                                  %mo{:stretchy => "false"} (
                                  %mi v
                                  %mo ,
                                  %mi v
                                  %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mi fm
                            %mtd
                              %mo =
                              %mrow
                                %mo (
                                %msup
                                  %mn 10
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 13
                                %msqrt
                                  %mrow
                                    %mi η
                                    %mo{:stretchy => "false"} (
                                    %mi v
                                    %mo ,
                                    %mi v
                                    %mo{:stretchy => "false"} )
                                %mo )
                              %mspace{:width => "thinmathspace"}
                              %mi cm
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %msqrt
                                %mrow
                                  %msup
                                    %mn 10
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 26
                                  %mi η
                                  %mo{:stretchy => "false"} (
                                  %mi v
                                  %mo ,
                                  %mi v
                                  %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mi cm
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\sqrt{\eta(v,v)} \, fm
                      \&amp; = \left( 10^{-13} \sqrt{\eta(v,v)}\right) \,cm
                      \\\
                      \&amp; =
                      \\sqrt{ 10^{-26} \eta(v,v) } \, cm
                      \\end{aligned}
                      \\,.
              %p
                The point to notice here is that, via the last line, we may think of this as
                %em
                  rescaling the
                  %a.existingWikiWord{:href => "/nlab/show/metric"} metric
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mn 10
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 30
                        %mi η
                      %annotation{:encoding => "application/x-tex"} 10^{-30} \eta
              %p
                In
                %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
                %a.existingWikiWord{:href => "/nlab/show/physical+units"} physical units
                of
                %a.existingWikiWord{:href => "/nlab/show/length"} length
                are typically expressed in terms of a
                %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
                of “
                %a.existingWikiWord{:href => "/nlab/show/action"}> action
                ”, called “
                %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"}> Planck's constant
                ”
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℏ
                      %annotation{:encoding => "application/x-tex"} \hbar
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Compton+wavelength"} Compton wavelength
              #eq:ComptonWavelength.maruku-equation
                %span.maruku-eq-number (9)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℓ
                        %mi m
                      %mo =
                      %mfrac
                        %mrow
                          %mn 2
                          %mi π
                          %mi ℏ
                        %mrow
                          %mi m
                          %mi c
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\ell_m = \frac{2\pi \hbar}{m c}
                      \\,.
              %p
                parameterized, in turn, by a
                %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
                of
                %a.existingWikiWord{:href => "/nlab/show/mass"} mass
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                      %annotation{:encoding => "application/x-tex"} m
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/electron"} electron
                %a.existingWikiWord{:href => "/nlab/show/Compton+wavelength"} Compton wavelength
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℓ
                        %mi e
                      %mo =
                      %mfrac
                        %mrow
                          %mn 2
                          %mi π
                          %mi ℏ
                        %mrow
                          %msub
                            %mi m
                            %mi e
                          %mi c
                      %mo ∼
                      %mn 386
                      %mspace{:width => "thinmathspace"}
                      %mi fm
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\ell_e =  \frac{2\pi \hbar}{m_e c} \sim 386 \, fm
                      \\,.
              %p
                Another
                %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
                of
                %a.existingWikiWord{:href => "/nlab/show/length"} length
                parameterized by a
                %a.existingWikiWord{:href => "/nlab/show/mass"} mass
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
                is the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Schwarzschild+radius"} Schwarzschild radius
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi r
                          %mi m
                        %mo ≔
                        %mn 2
                        %mi m
                        %mi G
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi c
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} r_m \coloneqq 2 m G/c^2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                is the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/gravitational+constant"} gravitational constant
                %a.existingWikiWord{:href => "/nlab/show/equation"} equation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mi ℓ
                                %mi m
                            %mtd
                              %mo =
                            %mtd
                              %msub
                                %mi r
                                %mi m
                          %mtr
                            %mtd
                              %mo ⇔
                            %mtd
                              %mn 2
                              %mi π
                              %mi ℏ
                              %mo{:stretchy => "false"} /
                              %mi m
                              %mi c
                            %mtd
                              %mo =
                            %mtd
                              %mn 2
                              %mi m
                              %mi G
                              %mo{:stretchy => "false"} /
                              %msup
                                %mi c
                                %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp; \ell_m &amp;=&amp; r_m
                      \\\
                      \\Leftrightarrow &amp; 2\pi\hbar / m c &amp;=&amp; 2 m G / c^2
                      }
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
                yields the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Planck+mass"} Planck mass
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi m
                        %mi P
                      %mo ≔
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %msqrt
                            %mi π
                      %msub
                        %mi m
                        %mrow
                          %mi ℓ
                          %mo =
                          %mi r
                      %mo =
                      %msqrt
                        %mfrac
                          %mrow
                            %mi ℏ
                            %mi c
                          %mi G
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      m_{P} \coloneqq \tfrac{1}{\sqrt{\pi}} m_{\ell = r} = \sqrt{\frac{\hbar c}{G}}
                      \\,.
              %p
                The corresponding
                %a.existingWikiWord{:href => "/nlab/show/Compton+wavelength"} Compton wavelength
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℓ
                        %mrow
                          %msub
                            %mi m
                            %mi P
                    %annotation{:encoding => "application/x-tex"} \ell_{m_{P}}
                is given by the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Planck+length"} Planck length
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℓ
                        %mi P
                    %annotation{:encoding => "application/x-tex"} \ell_P
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℓ
                        %mi P
                      %mo ≔
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mrow
                            %mn 2
                            %mi π
                      %msub
                        %mi ℓ
                        %mrow
                          %msub
                            %mi m
                            %mi P
                      %mo =
                      %msqrt
                        %mfrac
                          %mrow
                            %mi ℏ
                            %mi G
                          %mrow
                            %msup
                              %mi c
                              %mn 3
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\ell_{P} \coloneqq \tfrac{1}{2\pi} \ell_{m_P} = \sqrt{ \frac{\hbar G}{c^3} }
                      \\,.
            #MinkowskiSpacetime.num_defn
              %h6#definition_8 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                  as a
                  %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %p
                Prop./def.
                %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
                introduces
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 3
                      %mo ,
                      %mn 4
                      %mo ,
                      %mn 6
                      %mo ,
                      %mn 10
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} p+1 \in \{3,4,6,10\}
                as a a
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
                equipped with a
                %a.existingWikiWord{:href => "/nlab/show/norm"} norm
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mo −
                          %msub
                            %mo{:stretchy => "false"} |
                            %mi η
                      %annotation{:encoding => "application/x-tex"} {\vert - \vert_\eta}
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                corresponding to this is this vector space regaded as a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                (instead of just
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
                = succeed ")." do
                  %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
                over each point
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mrow
                            %mi p
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^{p,1}
                %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#TangentVectorFields"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi x
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                      %mo ≃
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      T_x \mathbb{R}^{p,1} \simeq \mathbb{R}^{p,1}
              %p
                and the
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
                equipped with the Lorentzian inner product from prop./def.
                %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
                on each
                %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi x
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} T_x \mathbb{R}^{p,1}
                (a “
                %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian
                = succeed "\u201D)" do
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                as such.
              %p We write
              #eq:MinkowskiVolume.maruku-equation
                %span.maruku-eq-number (10)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi dvol
                        %mi Σ
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi d
                      %msup
                        %mi x
                        %mn 0
                      %mo ∧
                      %mi d
                      %msup
                        %mi x
                        %mn 1
                      %mo ∧
                      %mi ⋯
                      %mo ∧
                      %mi d
                      %msup
                        %mi x
                        %mi p
                      %mo ∈
                      %msup
                        %mi Ω
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      dvol_\Sigma
                      \\;\coloneqq\;
                      d x^0 \wedge d x^1 \wedge \cdots \wedge d x^p
                      \\in \Omega^{p+1}(\mathbb{R}^{p,1})
              %p
                for the canonical
                %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
                on Minkowski spacetime.
              %p
                We use the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
                %a.existingWikiWord{:href => "/nlab/show/sum"} summation
                over the range of indices.
              %p
                For example a
                %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} differential 1-form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha \in \Omega^1(\mathbb{R}^{p,1})
                on Minkowski spacetime may be expanded as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo =
                      %msub
                        %mi α
                        %mi μ
                      %mi d
                      %msup
                        %mi x
                        %mi μ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\alpha = \alpha_\mu d x^\mu
                      \\,.
              %p
                Moreover we use square brackets around indices to indicate skew-symmetrization. For example a
                %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \beta \in \Omega^2(\mathbb{R}^{p,1})
                on Minkowski spacetime may be expanded as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi β
                            %mtd
                              %mo =
                              %msub
                                %mi β
                                %mrow
                                  %mi μ
                                  %mi ν
                              %mi d
                              %msup
                                %mi x
                                %mi μ
                              %mo ∧
                              %mi d
                              %msup
                                %mi x
                                %mi ν
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %msub
                                %mi β
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mi μ
                                  %mi ν
                                  %mo{:stretchy => "false"} ]
                              %mi d
                              %msup
                                %mi x
                                %mi μ
                              %mo ∧
                              %mi d
                              %msup
                                %mi x
                                %mi ν
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\beta
                      \&amp; = \beta_{\mu \nu} d x^\mu \wedge d x^\nu
                      \\\
                      \&amp; = \beta_{[\mu \nu]} d x^\mu \wedge d x^\nu
                      \\end{aligned}
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              The identification of
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
