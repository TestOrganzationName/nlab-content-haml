                        %mi j
                        %mo{:stretchy => "false"} ⟩
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \\alpha_i \in \Omega^{p+1,0}_\Sigma(E_{\text{BV-BRST}})\langle g \rangle
                      \\right\}
                      \\cup
                      \\left\{
                      \\beta_j \in \Omega^{p+1,0}_\Sigma(E_{\text{BV-BRST}})\langle j \rangle
                      \\right\}
              %p
                is a
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+forms"} horizontal differential forms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo {
                        %msub
                          %mi g
                          %mi i
                        %mo ,
                        %msub
                          %mi j
                          %mi j
                        %mo ∈
                        %msubsup
                          %mi C
                          %mi cp
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo{:stretchy => "false"} )
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
