            %p
              In fact prop.
              %a.maruku-ref{:href => "#ReverseTimOrderedProductsGiveReverseSMatrix"}
              is a special case of the following more general statement:
            #InversionFormulaForTimeOrderedProducts.num_prop
              %h6#proposition_7 Proposition
              %p
                %strong
                  (inversion relation for
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/reverse-time+ordered+products"} reverse-time ordered products
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi T
                        %mi k
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \{T_k\}_{k \in \mathbb{N}}
                be
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
                according to def.
                = succeed "." do
                  %a.maruku-ref{:href => "#TimeOrderedProduct"}
                %a.existingWikiWord{:href => "/nlab/show/reverse-time+ordered+products"} reverse-time ordered products
                according to def.
                %a.maruku-ref{:href => "#ReverseTimeOrderedProduct"}
                satisfies the following inversion relation for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ≠
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \mathbf{X} \neq \emptyset
                (in the condensed notation of remark
                = succeed "):" do
                  %a.maruku-ref{:href => "#NotationForTimeOrderedProductsAsGeneralizedFunctions"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi J
                          %mo ⊂
                          %mstyle{:mathvariant => "bold"}
                            %mi X
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi J
                      %mo{:stretchy => "false"} )
                      %mover
                        %mi T
                        %mo ¯
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ∖
                      %mstyle{:mathvariant => "bold"}
                        %mi J
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\underset{\mathbf{J} \subset \mathbf{X}}{\sum}
                      T(\mathbf{J}) \overline{T}(\mathbf{X} \setminus \mathbf{J})
