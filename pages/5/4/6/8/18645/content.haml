                              %mo ⋅
                              %msup
                                %mi a
                                %mo *
                              %mo ⋅
                              %mi a
                              %mo ⋅
                              %mi a
                              %mo +
                              %mn 4
                              %mi ℏ
                              %msup
                                %mi a
                                %mo *
                              %mo ⋅
                              %mi a
                              %mo +
                              %msup
                                %mi ℏ
                                %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      (a \cdot a ) \star_\pi (a^\ast \cdot a^\ast)
                      \&amp; =
                      a^\ast \cdot a^\ast \cdot a \cdot a
                      +
                      4 \hbar a^\ast \cdot a
                      +
                      \\hbar^2
                      }
              %p If we instead indicate the commutative pointwise product by colons and the star product by plain juxtaposition
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo :
                      %mi f
                      %mi g
                      %mo :
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi f
                      %mo ⋅
                      %mi g
                      %mphantom
                        %mi AAAA
                      %mi f
                      %mi g
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi f
                      %msub
                        %mo ⋆
                        %mi π
                    %annotation{:encoding => "application/x-tex"}
                      \:f g: \;\coloneqq\; f \cdot g
                      \\phantom{AAAA}
                      f g \;\coloneqq\; f \star_\pi
              %p then this reads
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo :
                              %mi a
                              %mi a
                              %mo :
                              %mspace{:width => "thinmathspace"}
                              %mo :
                              %msup
                                %mi a
