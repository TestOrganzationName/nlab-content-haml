                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
                its
                %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo ∖
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi ϵ
                      %mo ,
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}\setminus (-\epsilon, \epsilon)
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/integrable+function"} integrable
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+principal+value"} Cauchy principal value
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is, if it exists, the
                %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PV
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %munder
                        %mi lim
                        %mrow
                          %mi ϵ
                          %mo →
                          %mn 0
                      %munder
                        %mo ∫
                        %mrow
                          %mi ℝ
                          %mo ∖
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi ϵ
                          %mo ,
                          %mi ϵ
                          %mo{:stretchy => "false"} )
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi d
                      %mi x
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      PV(f) \coloneqq \underset{\epsilon \to 0}{\lim}
