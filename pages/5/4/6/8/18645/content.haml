            %p#StarProducts
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Moyal+star+products"} Moyal star products
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional vector space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo ∈
                    %mi V
                    %mo ⊗
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \pi \in V \otimes V
              be an element of the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              (not necessarily skew symmetric at the moment).
            %p
              We may canonically regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              is canonically regarded as a constant rank-2
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              by forming
              %a.existingWikiWord{:href => "/nlab/show/derivatives"} derivatives
              on the tensor product of the space of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi
                    \\;\colon\;
                    C^\infty(V) \otimes C^\infty(V)
                    \\longrightarrow
                    C^\infty(V) \otimes C^\infty(V)
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mo ∂
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\partial_i\}
              is a
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma(T V)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ⊗
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi π
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi i
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi j
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\pi(f \otimes g)
                    \\;=\;
                    \\pi^{i j}
                    (\partial_i f) \otimes (\partial_j g)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi i
                    %mi f
                    %mo ≔
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi f
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi i
                  %annotation{:encoding => "application/x-tex"} \partial_i f \coloneqq \frac{\partial f}{\partial x^i}
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
              of the
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              along the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coordinate"} coordinate
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
            %p For emphasis we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi prod
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi f
                            %mo ⊗
                            %mi g
                          %mtd
                            %mo ↦
                          %mtd
                            %mi f
                            %mo ⋅
                            %mi g
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C^\infty(V) \otimes C^\infty(V)
                    \&amp;\overset{prod}{\longrightarrow}&amp;
                    C^\infty(V)
                    \\\
                    f \otimes g &amp;\mapsto&amp; f \cdot g
                    }
            %p for the pointwise product of smooth functions.
            #StarPoduct.num_defn
              %h6#definition Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
                  induced by constant rank-2
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
              %p
                Given
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi π
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V,\pi)
                as above, then the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
                induced by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi
                on the
                %a.existingWikiWord{:href => "/nlab/show/formal+power+series+algebra"} formal power series algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} C^\infty(V) [ [\hbar] ]
                in a formal variable
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
                (“
                %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"}> Planck's constant
                ”) with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in the
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is the linear map
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⋆
                        %mi π
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo ⟶
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      (-) \star_\pi (-)
                      \\;\colon\;
                      C^\infty(V)[ [ \hbar ] ] \otimes C^\infty(V)[ [ \hbar ] ]
                      \\longrightarrow
                      C^\infty(V)[ [\hbar] ]
              %p given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
