                            %mi k
                          %annotation{:encoding => "application/x-tex"} k
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi f
                            %mrow
                              %msub
                                %mi μ
                                %mn 1
                              %mi ⋯
                              %msub
                                %mi μ
                                %mi k
                          %mi d
                          %msup
                            %mi x
                            %mrow
                              %msub
                                %mi μ
                                %mn 1
                          %mo ∧
                          %mi ⋯
                          %mo ∧
                          %mi d
                          %msup
                            %mi x
                            %mrow
                              %msub
                                %mi μ
                                %mi k
                          %mspace{:width => "thickmathspace"}
                          %mo ∈
                          %mspace{:width => "thickmathspace"}
                          %msubsup
                            %mi Ω
                            %mi Σ
                            %mrow
                              %mi k
                              %mo ,
                              %mn 0
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          f_{\mu_1 \cdots \mu_k} d x^{\mu_1} \wedge \cdots \wedge d x^{\mu_k}
                          \\;\in\;
                          \\Omega^{k,0}_{\Sigma}(E)
                  %p for
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi f
                            %mrow
                              %msub
                                %mi μ
                                %mn 1
                              %mi ⋯
                              %msub
                                %mi μ
                                %mi k
                          %mo =
                          %msub
                            %mi f
                            %mrow
                              %msub
                                %mi μ
                                %mn 1
                              %mi ⋯
                              %msub
                                %mi μ
                                %mi k
                          %mrow
                            %mo (
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi x
                              %mi μ
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ϕ
                              %mi a
                            %mo{:stretchy => "false"} )
                            %mo ,
