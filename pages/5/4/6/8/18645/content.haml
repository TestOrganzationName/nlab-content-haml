                      %mo{:stretchy => "false"} (
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mo ¯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      T_{n+1}(\mathbf{X})
                      \\;\coloneqq\;
                      \\underset{
                      { I \in \{1, \cdots, n+1\} }
                      \\atop
                      { I, \overline{I} \neq \emptyset }
                      }{\sum}
                      \\chi_i(\mathbf{X}) T( \mathbf{I} ) T( \overline{\mathbf{I}} )
              %p is well defined and satisfies causal factorization.
            #TimeOrderedProductOfFixedInteraction.num_remark
              %h6#remark Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
                  of fixed
                  %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
                  as
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo ′
                      %mo ,
                      %msub
                        %mi Δ
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
                be a
                %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge-fixed
                %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
                according to def.
                = succeed "," do
                  %a.maruku-ref{:href => "#VacuumFree"}
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                is a
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              %p and let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi LoObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ⟨
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"}
                      g S_{int} + j A
                      \\;\in\;
                      LoObs(E_{\text{BV-BRST}})[ [ \hbar, g, j] ]\langle g,j\rangle
              %p
                be a polynomial
                %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
                as in def.
                = succeed "," do
                  %a.maruku-ref{:href => "#FormalParameters"}
                %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %mo {
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mrow
                              %mi int
                              %mo ,
                              %mi i
                          %mo ,
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi α
                            %mrow
                              %mi i
                              %mo ′
                          %mo ∈
                          %msubsup
                            %mi Ω
                            %mi Σ
                            %mrow
                              %mi p
                              %mo +
                              %mn 1
                              %mo ,
                              %mn 0
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi E
                            %mtext BV-BRST
                          %mo{:stretchy => "false"} )
                          %mo }
                        %mrow
                          %mi i
                          %mo ,
                          %mi i
                          %mo ′
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \\mathbf{L}_{int,i}, \mathbf{\alpha}_{i'} \in \Omega^{p+1,0}_\Sigma(E_{\text{BV-BRST}})
                      \\right\}_{i,i'}
              %p
                of
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
                which are monomials in the field and jet coordinates, and a corresponding finite set
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo {
                        %msub
                          %mi g
                          %mrow
                            %mi sw
                            %mo ,
                            %mi i
                        %mo ∈
                        %msubsup
                          %mi C
                          %mi cp
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ⟨
                        %mi g
                        %mo{:stretchy => "false"} ⟩
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi j
                          %mrow
                            %mi sw
                            %mo ,
                            %mi i
                            %mo ′
                        %mo ∈
                        %msubsup
                          %mi C
                          %mi cp
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ⟨
                        %mi j
                        %mo{:stretchy => "false"} ⟩
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      g_{sw,i} \in C^\infty_{cp}(\Sigma)\langle g \rangle
                      \\,,\,
                      j_{sw,i'} \in C^\infty_{cp}(\Sigma)\langle j \rangle
                      \\right\}
              %p
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/adiabatic+switchings"} adiabatic switchings
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi τ
                        %mi Σ
                      %mrow
                        %mo (
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi i
                        %msub
                          %mi g
                          %mrow
                            %mi sw
                            %mo ,
                            %mi i
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mrow
                            %mi int
                            %mo ,
                            %mi i
                        %mspace{:width => "thickmathspace"}
                        %mo +
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi i
                            %mo ′
                        %msub
                          %mi j
                          %mrow
                            %mi sw
                            %mo ,
                            %mi i
                            %mo ′
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi α
                          %mrow
                            %mi i
                            %mo ′
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      g S_{int} + j A
                      \\;=\;
                      \\tau_{\Sigma}
                      \\left(
                      \\underset{i}{\sum}
                      g_{sw,i} \mathbf{L}_{int,i}
                      \\;+\;
                      \\underset{i'}{\sum}
                      j_{sw,i'} \mathbf{\alpha}_{i'}
                      \\right)
              %p
                is the
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression of variational differential forms
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TransgressionOfVariationalDifferentialFormsToConfigrationSpaces"}
                %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatic switching
                with these
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
              %p
                In order to discuss the
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                      %mo{:stretchy => "false"} (
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}(g S_{int} + j A)
                and hence the
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
                of the special form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi k
                      %mrow
                        %mo (
                        %munder
                          %munder
                            %mrow
                              %mi g
                              %msub
                                %mi S
                                %mi int
                              %mo +
                              %mi j
                              %mi A
                              %mo ,
                              %mi ⋯
                              %mo ,
                              %mi g
                              %msub
                                %mi S
                                %mi int
                              %mo +
                              %mi j
                              %mi A
                            %mo ⏟
                          %mrow
                            %mi k
                            %mspace{:width => "thinmathspace"}
                            %mtext factors
                        %mo )
                    %annotation{:encoding => "application/x-tex"} T_k\left(  \underset{k \, \text{factors}}{\underbrace{g S_{int} + j A, \cdots, g S_{int} + j A }} \right)
                it is sufficient to restrict attention to the
                %a.existingWikiWord{:href => "/nlab/show/restriction"} restriction
                of each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi k
                    %annotation{:encoding => "application/x-tex"} T_k
                to the subspace of
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                induced by the finite set of
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mrow
                            %mi int
                            %mo ,
                            %mi i
                        %mo ,
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi α
                          %mrow
                            %mi i
                            %mo ′
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ,
                            %mi i
                            %mo ′
                      %annotation{:encoding => "application/x-tex"} \{\mathbf{L}_{int,i}, \mathbf{\alpha}_{i'}\}_{i,i'}
              %p
                This restriction is a
                %a.existingWikiWord{:href => "/nlab/show/continuous+linear+functional"} continuous linear functional
                on the corresponding space of
                %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi g
                          %mrow
                            %mi sw
                            %mo ,
                            %mi i
                        %mo ,
                        %msub
                          %mi j
                          %mrow
                            %mi sw
                            %mo ,
                            %mi i
                            %mo ′
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{g_{sw,i}, j_{sw,i'}\}
                %a.existingWikiWord{:href => "/nlab/show/distribution"} dstributional
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of a corresponding
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              %p
                In terms of this, prop.
                %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
                says that the choice of
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi k
                    %annotation{:encoding => "application/x-tex"} T_k
                is
                %a.existingWikiWord{:href => "/nlab/show/induction"} inductively
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                a choice of
                %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
                to the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo =
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \Sigma = \mathbb{R}^{p,1}
                is
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                and we impose the
                %a.existingWikiWord{:href => "/nlab/show/renormalization+condition"} renormalization condition
                “translation invariance” (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#RenormalizationConditions"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mi k
                    %annotation{:encoding => "application/x-tex"} T_k
                is a distribution on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Σ
                        %mrow
                          %mi k
                          %mo −
                          %mn 1
                      %mo =
                      %msup
                        %mi ℝ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Sigma^{k-1} = \mathbb{R}^{(p+1)(k-1)}
                and the
                %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
                is from the complement of the origina
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} 0 \in \mathbb{R}^{(p+1)(k-1)}
            %p
              Therefore we now discuss
              %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
              (def.
              %a.maruku-ref{:href => "#ExtensionOfDistributions"}
              below) on
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              from the complement of the origin to the origin. Since the space of choices of such extensions turns out to depend on the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+distributions"} scaling degree of distributions
              %a.maruku-ref{:href => "#ScalingDegree"}
              below).
            #RescaledDistribution.num_defn
              %h6#definition Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+distributions"}> rescaled distribution
                  )
              %p
                Let
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \lambda \in (0,\infty) \subset \mathbb{R}
                a
                %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
                %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
                write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi ℝ
                                %mi n
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi s
                                    %mi λ
                            %mtd
                              %msup
                                %mi ℝ
                                %mi n
                          %mtr
                            %mtd
                              %mi x
                            %mtd
                              %mo ↦
                            %mtd
                              %mi λ
                              %mi x
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathbb{R}^n
                      \&amp;\overset{s_\lambda}{\longrightarrow}&amp;
                      \\mathbb{R}^n
                      \\\
                      x &amp;\mapsto&amp; \lambda x
                      }
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
                given by multiplication with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                      %annotation{:encoding => "application/x-tex"} \lambda
                = succeed "-structure" do
                  %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %p
                Then for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(\mathbb{R}^n)
                a
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                on the
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                the
                %em rescaled distribution
                is the
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+a+distribution"} pullback
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
                along
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi m
                        %mi λ
                    %annotation{:encoding => "application/x-tex"} m_\lambda
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mi λ
                      %mo ≔
                      %msubsup
                        %mi s
                        %mi λ
                        %mo *
                      %mi u
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      u_\lambda
                      \\coloneqq
                      s_\lambda^\ast u
                      \\;\in\;
                      \\mathcal{D}'(\mathbb{R}^n)
                      \\,.
              %p Explicitly, this is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi 𝒟
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi ℝ
                                %mi n
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo{:stretchy => "false"} ⟨
                                  %msub
                                    %mi u
                                    %mi λ
                                  %mo ,
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} ⟩
                            %mtd
                              %mi ℝ
                          %mtr
                            %mtd
                              %mi b
                            %mtd
                              %mo ↦
                            %mtd
                              %msup
                                %mi λ
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi n
                              %mo{:stretchy => "false"} ⟨
                              %mi u
                              %mo ,
                              %mi b
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi λ
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo ⋅
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ⟩
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathcal{D}(\mathbb{R}^n)
                      \&amp;\overset{ \langle  u_\lambda, - \rangle}{\longrightarrow}&amp;
                      \\mathbb{R}
                      \\\
                      b &amp;\mapsto&amp; \lambda^{-n} \langle u , b(\lambda^{-1}\cdot (-))\rangle
                      }
                      \\,.
              %p
                Similarly for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊂
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X \subset \mathbb{R}^n
                an
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                which is invariant under
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mi λ
                      %annotation{:encoding => "application/x-tex"} s_\lambda
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(X)
                is is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi u
                          %mi λ
                        %mo ≔
                        %msubsup
                          %mi s
                          %mi λ
                          %mo *
                        %mi u
                      %annotation{:encoding => "application/x-tex"} u_\lambda \coloneqq s_\lambda^\ast u
            #ScalingDegree.num_defn
              %h6#definition_2 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+a+distribution"}> scaling degree of a distribution
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊂
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X \subset \mathbb{R}^n
                be an
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                of
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                which is invariant under
                %a.existingWikiWord{:href => "/nlab/show/rescaling"} rescaling
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi λ
                    %annotation{:encoding => "application/x-tex"} s_\lambda
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#RescaledDistribution"}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                        %mo ∈
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \lambda \in (0,\infty)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(X)
                be a
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                on this subset. Then
              %ol
                %li
                  %p
                    The
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+a+distribution"} scaling degree
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi u
                        %annotation{:encoding => "application/x-tex"} u
                    is the
                    %a.existingWikiWord{:href => "/nlab/show/infimum"} infimum
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi sd
                          %mo{:stretchy => "false"} (
                          %mi u
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %mi inf
                          %mrow
                            %mo {
                            %mi ω
                            %mo ∈
                            %mi ℝ
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} |
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mi lim
                              %mrow
                                %mi λ
                                %mo →
                                %mn 0
                            %msup
                              %mi λ
                              %mi ω
                            %msub
                              %mi u
                              %mi λ
                            %mo =
                            %mn 0
                            %mo }
                        %annotation{:encoding => "application/x-tex"}
                          sd(u)
                          \\;\coloneqq\;
                          inf
                          \\left\{
                          \\omega \in \mathbb{R}
                          \\;\vert\;
                          \\underset{\lambda \to 0}{\lim}
                          \\lambda^\omega u_\lambda
                          \= 0
                          \\right\}
                  %p
                    of the set of
                    %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ω
                        %annotation{:encoding => "application/x-tex"} \omega
                    such that the
                    %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
                    of the rescaled distribution
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi λ
                            %mi ω
                          %msub
                            %mi u
                            %mi λ
                        %annotation{:encoding => "application/x-tex"} \lambda^\omega u_\lambda
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#RescaledDistribution"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ω
                        %annotation{:encoding => "application/x-tex"} \omega
                    one sets
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi sd
                            %mo{:stretchy => "false"} (
                            %mi u
                            %mo{:stretchy => "false"} )
                            %mo ≔
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} sd(u) \coloneqq \infty
                %li
                  %p
                    The
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi u
                        %annotation{:encoding => "application/x-tex"} u
                    is the difference of the scaling degree by the
                    %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                    of the underlying space:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi sd
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      deg(u) \coloneqq sd(u) - n
                      \\,.
            #NonSingularDistributionsScalingDegree.num_example
              %h6#example Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+distributions"} scaling degree
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo =
                      %msub
                        %mi u
                        %mi f
                    %annotation{:encoding => "application/x-tex"} u = u_f
                is a
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"} non-singular distribution
                given by
                %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi 𝒟
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \in C^\infty(X) \subset \mathcal{D}'(X)
                %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+a+distribution"} scaling degree
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ScalingDegree"}
                %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sd
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi u
                        %mi f
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      sd(u_f) \leq 0
                      \\,.
              %p
                Specifically if the first non-vanishing
                %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mi α
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \partial_\alpha f(0)
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                at 0 occurs at order
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi α
                          %mo{:stretchy => "false"} |
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} {\vert \alpha\vert} \in \mathbb{N}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi u
                        %mi f
                    %annotation{:encoding => "application/x-tex"} u_f
                is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi α
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} -{\vert \alpha\vert}
            .proof
              %h6#proof_2 Proof
              %p
                By definition we have for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R}^n)
                any
                %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
                that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mrow
                                %mo ⟨
                                %msup
                                  %mi λ
                                  %mi ω
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi u
                                  %mi f
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi λ
                                %mo ,
                                %mi n
                                %mo ⟩
                            %mtd
                              %mo =
                              %msup
                                %mi λ
                                %mrow
                                  %mi ω
                                  %mo −
                                  %mi n
                              %munder
                                %mo ∫
                                %mrow
                                  %msup
                                    %mi ℝ
                                    %mi n
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mi g
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi λ
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mi x
                              %mo{:stretchy => "false"} )
                              %msup
                                %mi d
                                %mi n
                              %mi x
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %msup
                                %mi λ
                                %mi ω
                              %munder
                                %mo ∫
                                %mrow
                                  %msup
                                    %mi ℝ
                                    %mi n
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi λ
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mi g
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %msup
                                %mi d
                                %mi n
                              %mi x
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\left\langle
                      \\lambda^{\omega}
                      (u_f)_\lambda,
                      n
                      \\right\rangle
                      \&amp; =
                      \\lambda^{\omega-n}
                      \\underset{\mathbb{R}^n}{\int}
                      f(x) g(\lambda^{-1} x)
                      d^n x
                      \\\
                      \&amp; =
                      \\lambda^{\omega}
                      \\underset{\mathbb{R}^n}{\int}
                      f(\lambda x) g(x)
                      d^n x
                      \\end{aligned}
                      \\,,
              %p
                where in last line we applied
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/change+of+integration+variables"} change of integration variables
              %p
                The limit of this expression is clearly zero for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo &gt;
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \omega \gt 0
              %p
                If moreover the first non-vanishing
                %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                occurs at order
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi α
                          %mo{:stretchy => "false"} |
                        %mo =
                        %mi k
                      %annotation{:encoding => "application/x-tex"} {\vert \alpha \vert} = k
                %a.existingWikiWord{:href => "/nlab/show/Hadamard%27s+lemma"} Hadamard's lemma
                says that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mrow
                          %mo (
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mi i
                          %msub
                            %mi α
                            %mi i
                          %mo !
                          %mo )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ∂
                        %mi α
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mi i
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi i
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi α
                            %mi i
                      %mo +
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mi β
                              %mo ∈
                              %msup
                                %mi ℕ
                                %mi n
                          %mrow
                            %mrow
                              %mrow
                                %mo{:stretchy => "false"} |
                                %mi β
                                %mo{:stretchy => "false"} |
                              %mo =
                              %mrow
                                %mo{:stretchy => "false"} |
                                %mi α
                                %mo{:stretchy => "false"} |
                              %mo +
                              %mn 1
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mi i
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi i
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi β
                            %mi i
                      %msub
                        %mi h
                        %mi β
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      f(x)
                      \\;=\;
                      \\left( \underset{i}{\prod} \alpha_i ! \right)^{-1}
                      (\partial_\alpha f(0))
                      \\underset{i}{\prod} (x^i)^{\alpha_i}
                      +
                      \\underset{ {\beta \in \mathbb{N}^n} \atop { {\vert \beta\vert} = {\vert \alpha \vert} + 1 }  }{\sum}
                      \\underset{i}{\prod} (x^i)^{\beta_i}
                      h_{\beta}(x)
              %p
                where the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mi β
                    %annotation{:encoding => "application/x-tex"} h_{\beta}
                are
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mrow
                                %mo ⟨
                                %msup
                                  %mi λ
                                  %mi ω
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi u
                                  %mi f
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi λ
                                %mo ,
                                %mi n
                                %mo ⟩
                            %mtd
                              %mo =
                              %msup
                                %mi λ
                                %mrow
                                  %mi ω
                                  %mo +
                                  %mrow
                                    %mo{:stretchy => "false"} |
                                    %mi α
                                    %mo{:stretchy => "false"} |
                              %munder
                                %mo ∫
                                %mrow
                                  %msup
                                    %mi ℝ
                                    %mi n
                              %msup
                                %mrow
                                  %mo (
                                  %munder
                                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                                    %mi i
                                  %msub
                                    %mi α
                                    %mi i
                                  %mo !
                                  %mo )
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo{:stretchy => "false"} (
                              %msub
                                %mo ∂
                                %mi α
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                                %mi i
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi x
                                %mi i
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %msub
                                    %mi α
                                    %mi i
                              %mi b
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %msup
                                %mi d
                                %mi n
                              %mi x
                          %mtr
                            %mtd
                            %mtd
                              %mphantom
                                %mo =
                              %mo +
                              %msup
                                %mi λ
                                %mrow
                                  %mi ω
                                  %mo +
                                  %mrow
                                    %mo{:stretchy => "false"} |
                                    %mi α
                                    %mo{:stretchy => "false"} |
                                  %mo +
                                  %mn 1
                              %munder
                                %mo ∫
                                %mrow
                                  %msup
                                    %mi ℝ
                                    %mi n
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                                %mi i
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi x
                                %mi i
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %msub
                                    %mi β
                                    %mi i
                              %msub
                                %mi h
                                %mi β
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mi b
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %msup
                                %mi d
                                %mi n
                              %mi x
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\left\langle
                      \\lambda^{\omega}
                      (u_f)_\lambda,
                      n
                      \\right\rangle
                      \&amp; =
                      \\lambda^{\omega + {\vert \alpha\vert }}
                      \\underset{\mathbb{R}^n}{\int}
                      \\left( \underset{i}{\prod} \alpha_i ! \right)^{-1}
                      (\partial_\alpha f(0))
                      \\underset{i}{\prod} (x^i)^{\alpha_i}
                      b(x)
                      d^n x
                      \\\
                      \&amp; \phantom{=}
                      +
                      \\lambda^{\omega + {\vert \alpha\vert} + 1}
                      \\underset{\mathbb{R}^n}{\int}
                      \\underset{i}{\prod} (x^i)^{\beta_i}
                      h_{\beta}(x)
                      b(x)
                      d^n x
                      \\end{aligned}
                      \\,.
              %p
                This makes manifest that the expression goes to zero with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \lambda \to 0
                precisely for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo &gt;
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi α
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} \omega \gt - {\vert \alpha \vert}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sd
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi u
                        %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi α
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"}
                      sd(u_f) = -{\vert \alpha \vert}
              %p in this case.
            #DerivativesOfDeltaDistributionScalingDegree.num_example
              %h6#example_2 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+a+distribution"} scaling degree
                  of
                  %a.existingWikiWord{:href => "/nlab/show/derivative+of+a+distribution"} derivatives
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/delta-distributions"} delta-distributions
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
