                            %a.existingWikiWord{:href => "/nlab/show/strong+adiabatic+limit"} strong adiabatic limit
                    %li
                      %p
                        as the true
                        %a.existingWikiWord{:href => "/nlab/show/n-point+functions"} n-point functions
                        the corresponding
                        %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
                      .maruku-equation
                        %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
