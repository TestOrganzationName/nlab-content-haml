                      \\;\colon\;
                      LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j] ]
                      \\longrightarrow
                      LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j] ]
              %p
                which relates the corresponding two
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                schemes via
              #eq:SMatrixScemesRelatedByRunningFunction.maruku-equation
