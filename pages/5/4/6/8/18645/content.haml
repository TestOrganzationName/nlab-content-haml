                                %mi x
                                %mn 0
                              %mo −
                              %msup
                                %mi y
                                %mn 0
                              %mo{:stretchy => "false"} )
                              %mo &gt;
                              %mn 0
                            %annotation{:encoding => "application/x-tex"} (x^0 - y^0) \gt 0
                        the
                        %a.existingWikiWord{:href => "/nlab/show/integrand"} integrand
                        decays for
                        %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive
                        %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary part
                        and hence the integration over
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi k
                                %mn 0
                            %annotation{:encoding => "application/x-tex"} k_0
                        may be deformed to a
                        %a.existingWikiWord{:href => "/nlab/show/Jordan+curve"} contour
                        which encircles the
                        %a.existingWikiWord{:href => "/nlab/show/pole"} pole
                        in the
                        = succeed ";" do
                          %a.existingWikiWord{:href => "/nlab/show/upper+half+plane"} upper half plane
                    %li
                      %p
                        for
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi x
                                %mn 0
                              %mo −
                              %msup
                                %mi y
                                %mn 0
                              %mo{:stretchy => "false"} )
                              %mo &lt;
                              %mn 0
                            %annotation{:encoding => "application/x-tex"} (x^0 - y^0) \lt 0
                        the integrand decays for
                        %a.existingWikiWord{:href => "/nlab/show/negative+real+number"} negative
                        %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary part
                        and hence the integration over
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi k
                                %mn 0
                            %annotation{:encoding => "application/x-tex"} k_0
                        may be deformed to a
                        %a.existingWikiWord{:href => "/nlab/show/Jordan+curve"} contour
                        which encircles the
                        %a.existingWikiWord{:href => "/nlab/show/pole"} pole
                        in the
                        %a.existingWikiWord{:href => "/nlab/show/lower+half+plane"} lower half plane
                  %p
                    and then apply
                    %a.existingWikiWord{:href => "/nlab/show/Cauchy%27s+integral+formula"} Cauchy's integral formula
                    which picks out
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 2
                          %mi π
                          %mi i
                        %annotation{:encoding => "application/x-tex"} 2\pi i
                    times the
                    %a.existingWikiWord{:href => "/nlab/show/residue"} residue
                    a these poles.
                  %p
                    %img{:height => "300", :src => "https://ncatlab.org/nlab/files/ContourForFeynmanPropagator.png"}/
                  %p
                    Notice that when completing to a contour in the
                    %a.existingWikiWord{:href => "/nlab/show/lower+half+plane"} lower half plane
                    we pick up a minus signs from the fact that now the contour runs clockwise.
                %li
                  %p
                    In the fourth step we used prop.
                    = succeed "." do
                      %a.maruku-ref{:href => "#ModeExpansionForFeynmanPropagatorOfKleinGordonEquationOnMinkowskiSpacetime"}
            %p It follows that:
            %p
            #GreenFunctionFeynmanPropagator.num_prop
              %h6 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                  is
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Green+function"} Green function
                %br/
                The
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi F
                    %annotation{:encoding => "application/x-tex"} \Delta_F
                for the
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
                on
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FeynmanPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/Green+function"} Green function
                for the
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
                in that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %msub
                          %mo □
                          %mi x
                        %mo −
                        %msup
                          %mrow
                            %mo (
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mrow
                                  %mi m
                                  %mi c
                                %mi ℏ
                            %mo )
                          %mn 2
                        %mo )
                      %msub
                        %mi Δ
                        %mi F
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mi δ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo −
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\left( \Box_x - \left( \tfrac{m c}{\hbar}\right)^2 \right) \Delta_{F}(x,y)
                      \=
                      (+i) \delta(x-y)
                      \\,.
              %p
            .proof
              %h6#proof_21 Proof
              %p
                Equation
                %a.maruku-eqref{:href => "#eq:FeynmanPropagatorInCauchyPrincipalValueForm"} (?)
                in prop.
                %a.maruku-ref{:href => "#FeynmanPropagatorAsACauchyPrincipalvalue"}
                says that the Feynman propagator is the
                %a.existingWikiWord{:href => "/nlab/show/Fourier+inversion+theorem"} inverse
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
                of
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %msub
                            %mi Δ
                            %mi F
                        %mo ^
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi i
                      %mo{:stretchy => "false"} )
                      %munder
                        %mi lim
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mi ϵ
                              %mo ∈
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo ,
                              %mn ∞
                              %mo{:stretchy => "false"} )
                          %mrow
                            %mrow
                              %mi ϵ
                              %mo →
                              %mn 0
                      %mfrac
                        %mn 1
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mi k
                            %mi μ
                          %msup
                            %mi k
                            %mi μ
                          %mo −
                          %msup
                            %mrow
                              %mo (
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mi m
                                    %mi c
                                  %mi ℏ
                              %mo )
                            %mn 2
                          %mo ±
                          %mi i
                          %mi ϵ
                    %annotation{:encoding => "application/x-tex"}
                      \\widehat{\Delta_F}(k)
                      \\;=\;
                      (+i)
                      \\underset{ {\epsilon \in (0,\infty)} \atop {\epsilon \to 0} }{\lim}
                      \\frac{
                      1
                      }{
                      \- k_\mu k^\mu - \left( \tfrac{m c}{\hbar} \right)^2 \pm i \epsilon
                      }
              %p
                This implies the statement as in the proof of prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#AdvancedRetardedPropagatorsForKleinGordonOnMinkowskiSpacetime"}
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:LimitOfDistributionsForFourierTransformedPropagators"} (141)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#WaveFrontSetsOfPropagatorsForKleinGordonOperatorOnMinkowskiSpacetime
              %strong
                %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
                and
                %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
            %p
              We now discuss the
              %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SingularSupportOfADistribution"}
              %a.existingWikiWord{:href => "/nlab/show/wave+front+sets"} wave front sets
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WaveFrontSet"}
              %a.existingWikiWord{:href => "/nlab/show/propagators"} propagators
              for the
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            #SingularSupportOfCausalPropagatorForKleinGordonEquationOnMinkowskiSpacetimeIsTheLightCone.num_prop
              %h6#proposition_29 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
                  on
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                  is the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/light+cone"} light cone
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
                of the
                %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi S
                    %annotation{:encoding => "application/x-tex"} \Delta_S
                for the
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
                on
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %a.existingWikiWord{:href => "/nlab/show/translation"} translation
                %a.existingWikiWord{:href => "/nlab/show/invariant"} invariance
                as a
                %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
                in a single variable
                %a.maruku-eqref{:href => "#eq:TranslationInvariantKleinGordonPropagatorsOnMinkowskiSpacetime"} (136)
                is the
                %a.existingWikiWord{:href => "/nlab/show/light+cone"} light cone
                of the origin:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi supp
                        %mi sing
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Δ
                        %mi S
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo {
                        %mi x
                        %mo ∈
                        %msup
                          %mi ℝ
                          %mrow
                            %mi p
                            %mo ,
                            %mn 1
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thinmathspace"}
                        %msubsup
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi x
                            %mo{:stretchy => "false"} |
                          %mi η
                          %mn 2
                        %mo =
                        %mn 0
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      supp_{sing}(\Delta_S)
                      \\;=\;
                      \\left\{
                      x \in \mathbb{R}^{p,1}
                      \\,\vert\,
                      {\vert x\vert}^2_\eta = 0
                      \\right\}
                      \\,.
            .proof
              %h6#proof_22 Proof
              %p
                By prop.
                %a.maruku-ref{:href => "#CausalPropagatorAsFourierTransformOfDeltaDistributionOnTransformedKGOperator"}
                the causal propagator is equivalently the
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
                of the
                %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
                of the
                %a.existingWikiWord{:href => "/nlab/show/mass+shell"} mass shell
                times the
                %a.existingWikiWord{:href => "/nlab/show/sign+function"} sign function
                of the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/angular+frequency"} angular frequency
                = succeed ")" do
                  %a.maruku-ref{:href => "#BasicPropertiesOfFourierTransformOverCartesianSpaces"}
                %a.existingWikiWord{:href => "/nlab/show/convolution+of+distributions"} convolution of distributions
                of the separate Fourier transforms:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi Δ
                                %mi S
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ∝
                              %mover
                                %mrow
                                  %mi δ
                                  %mrow
                                    %mo (
                                    %msup
                                      %mi η
                                      %mrow
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mn 1
                                    %mo{:stretchy => "false"} (
                                    %mi k
                                    %mo ,
                                    %mi k
                                    %mo{:stretchy => "false"} )
                                    %mo +
                                    %msup
                                      %mrow
                                        %mo (
                                        %mstyle{:displaystyle => "false"}
                                          %mfrac
                                            %mrow
                                              %mi m
                                              %mi c
                                            %mi ℏ
                                        %mo )
                                      %mn 2
                                    %mo )
                                  %mi sgn
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi k
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                                %mo ^
                          %mtr
                            %mtd
                            %mtd
                              %mo ∝
                              %mover
                                %mrow
                                  %mi δ
                                  %mrow
                                    %mo (
                                    %msup
                                      %mi η
                                      %mrow
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mn 1
                                    %mo{:stretchy => "false"} (
                                    %mi k
                                    %mo ,
                                    %mi k
                                    %mo{:stretchy => "false"} )
                                    %mo +
                                    %msup
                                      %mrow
                                        %mo (
                                        %mstyle{:displaystyle => "false"}
                                          %mfrac
                                            %mrow
                                              %mi m
                                              %mi c
                                            %mi ℏ
                                        %mo )
                                      %mn 2
                                    %mo )
                                %mo ^
                              %mo ⋆
                              %mover
                                %mrow
                                  %mi sgn
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi k
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                                %mo ^
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\Delta_S(x)
                      \&amp; \propto
                      \\widehat{
                      \\delta\left( \eta^{-1}(k,k) + \left( \tfrac{m c}{\hbar}\right)^2 \right) sgn( k_0 )
                      }
                      \\\
                      \&amp;\propto
                      \\widehat{\delta\left( \eta^{-1}(k,k) + \left( \tfrac{m c}{\hbar}\right)^2 \right)}
                      \\star
                      \\widehat{sgn( k_0 )}
                      \\end{aligned}
              %p
                By prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#FourierTransformOfDeltaDistributionappliedToMassShell"}
                %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
                of the first convolution factor is the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/light+cone"} light cone
              %p The second factor is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mover
                                %mrow
                                  %mi sgn
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi k
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                                %mo ^
                            %mtd
                              %mo ∝
                              %mrow
                                %mo (
                                %mn 2
                                %mover
                                  %mrow
                                    %mi Θ
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi k
                                      %mn 0
                                    %mo{:stretchy => "false"} )
                                  %mo ^
                                %mo −
                                %mover
                                  %mn 1
                                  %mo ^
                                %mo )
                              %mi δ
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi k
                                %mo{:stretchy => "false"} →
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ∝
                              %mrow
                                %mo (
                                %mn 2
                                %mstyle{:displaystyle => "false"}
                                  %mfrac
                                    %mn 1
                                    %mrow
                                      %mi i
                                      %msup
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msup
                                        %mn 0
                                        %mo +
                                %mo −
                                %mi δ
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi x
                                  %mn 0
                                %mo{:stretchy => "false"} )
                                %mo )
                              %mi δ
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi k
                                %mo{:stretchy => "false"} →
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\widehat{sgn(k_0)}
                      \&amp; \propto
                      \\left(2\widehat{\Theta(k_0)} - \widehat{1}\right) \delta(\vec k)
                      \\\
                      \&amp; \propto
                      \\left(2\tfrac{1}{i x^0 + 0^+}  - \delta(x^0)\right) \delta(\vec k)
                      \\end{aligned}
              %p
                (by example
                %a.maruku-ref{:href => "#FourierTransformOfDeltaDistribution"}
                and example
                = succeed ")" do
                  %a.maruku-ref{:href => "#RelationToFourierTransformOfHeavisideDistribution"}
                %a.existingWikiWord{:href => "/nlab/show/wave+front+set"} wave front set
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#WaveFrontSet"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi WF
                      %mrow
                        %mo (
                        %mover
                          %mrow
                            %mi sgn
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi k
                              %mn 0
                            %mo{:stretchy => "false"} )
                          %mo ^
                        %mo )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi k
                      %mo ∈
                      %mi S
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"}
                      WF\left(\widehat{sgn(k_0)}\right) = \{(0,k) \;\vert\; k \in S(\mathbb{R}^{p+1})\}
              %p
                (by example
                %a.maruku-ref{:href => "#WaveFrontOfDeltaDistribution"}
                and example
                = succeed ")." do
                  %a.maruku-ref{:href => "#PrincipalValueOfInverseFunctionCharacteristicEquation"}
              %p
                With this the statement follows, via a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
                = succeed "." do
                  %a{:href => "convolution+product+of+distributions#WaveFrontSetOfCompactlySupportedDistributions"} this prop.
              %p
                For illustration we now make this general argument more explicit in the special case of
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                      %mo =
                      %mn 3
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      p + 1 = 3 + 1
              %p
                by computing an explicit form for the
                %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
                in terms of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
                %a.existingWikiWord{:href => "/nlab/show/Heaviside+distribution"} Heaviside distribution
                and
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Bessel+functions"} Bessel functions
              %p
                We follow (
                %a{:href => "causal+perturbation+theory#Scharf95"}> Scharf 95 (2.3.18)
                ).
              %p
                Consider the formula for the
                %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
                in terms of the mode expansion
