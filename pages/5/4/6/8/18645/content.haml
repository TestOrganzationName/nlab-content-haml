                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi b
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mrow
                                      %mi α
                                      %mo ∈
                                      %msup
                                        %mi ℕ
                                        %mi n
                                  %mrow
                                    %mrow
                                      %mrow
                                        %mo{:stretchy => "false"} |
