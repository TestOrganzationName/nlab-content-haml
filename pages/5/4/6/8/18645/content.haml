            %p
              While the
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              with its
              %a.existingWikiWord{:href => "/nlab/show/vacuum+state"} vacuum state
              provides a
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
              of the
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+observables"} algebra of observables
              of
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theories"} Lagrangian field theories
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              implies that the physically relevant observables are just the
              %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariant
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              ones, exhibited by the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+differential"} BV-BRST differential
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi S
                      %mo ′
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi S
                      %msub
                        %mo ′
                        %mi BRST
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{-S' + S'_{BRST}, (-)\}
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/gauge+theories"} gauge theories
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+differential"} BV-BRST differential
              needs to be lifted to the
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+algebra"} noncommutative algebra
              of
              %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
              – this is called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/BV-BRST+quantization"} BV-BRST quantization
            %p
              To do so, we may regard the
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %msub
                      %mo ′
                      %mi BRST
                  %annotation{:encoding => "application/x-tex"} S'_{BRST}
              as an
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              term, to be dealt with later via
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/scattering+theory"} scattering theory
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi S
                      %mo ′
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{-S',(-)\}
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered
              version
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi S
                    %mo ′
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \{-S',(-)\}_{\mathcal{T}}
              (prop.
              %a.maruku-ref{:href => "#GaugeFixedActionFunctionalTimeOrderedAntibracket"}
              below) plus a quantum correction, called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/BV-operator"} BV-operator
              (def.
              %a.maruku-ref{:href => "#ForGaugeFixedFreeLagrangianFieldTheoryBVOperator"}
              below) or
              %em
                %a.existingWikiWord{:href => "/nlab/show/BV-Laplacian"} BV-Laplacian
              (prop.
              %a.maruku-ref{:href => "#ComponentsBVOperator"}
              below).
            %p
              Applied to
              %a.existingWikiWord{:href => "/nlab/show/observables"} observables
              this relation is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Schwinger-Dyson+equation"} Schwinger-Dyson equation
              (prop.
              %a.maruku-ref{:href => "#DysonSchwinger"}
              below), which expresses the
              = succeed "-correction" do
                %a.existingWikiWord{:href => "/nlab/show/quantum+physics"} quantum
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge field
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              as seen by
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              of
              %a.existingWikiWord{:href => "/nlab/show/observables"} observables
              (example
              %a.maruku-ref{:href => "#SchwingerDysonDistributional"}
              below.)
            %p
              After introducing
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              %a.existingWikiWord{:href => "/nlab/show/interactions"} interactions
              via
              %a.existingWikiWord{:href => "/nlab/show/scattering+theory"} scattering theory
              in the
              %a{:href => "#InteractingQuantumFields"} next chapter
              the quantum correction to the
              %a.existingWikiWord{:href => "/nlab/show/BV-differential"} BV-differential
              by the
              %a.existingWikiWord{:href => "/nlab/show/BV-operator"} BV-operator
              becomes the “
              %a.existingWikiWord{:href => "/nlab/show/quantum+master+equation"}> quantum master equation
              ” and the
              %a.existingWikiWord{:href => "/nlab/show/Schwinger-Dyson+equation"} Schwinger-Dyson equation
              becomes the “
              %a.existingWikiWord{:href => "/nlab/show/master+Ward+identity"}> master Ward identity
              ”. When choosing
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} renormalization
              these identities become
              %em conditions
              to be satisfied by
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} renormalization
              choices in order for the interacting quantum BV-BRST differential, and hence for
              %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariant
              quantum observables, to be well defined in
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/gauge+theories"} gauge theories
              = succeed "." do
                %em
                  %a{:href => "#Renormalization"} Renormalization
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#WickAlgebraAbstract
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
            %p
              The abstract
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              of a
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
              with
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green hyperbolic differential equation
              is directly analogous to the
              = succeed "-algebra" do
                %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WickAlgebraOfAlmostKaehlerVectorSpace"}
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              with the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+space"} Kähler space
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            #WightmanPropagatorAsKaehlerVectorSpaceStructure.num_remark
              %h6#remark Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
                  as
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                be a
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                whose
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
                %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green hyperbolic differential equation
                %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
                is analogous to the rank-2 tensor on a
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
                as follows:
              %table
                %thead
                  %tr
                    %th
                      %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
                      %br/
                      of
                      %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                      %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equation"} Green hyperbolic
                      %br/
                      %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                    %th
                      %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional
                      %br/
                      %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
                %tbody
                  %tr
                    %td{:style => "text-align: left;"}
                      %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
                      %br/
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
                    %td{:style => "text-align: left;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 2
                                %mi n
                          %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2n}
                  %tr
                    %td{:style => "text-align: left;"}
                      %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
                      %br/
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi τ
                              %mrow
                                %msub
                                  %mi Σ
                                  %mi p
                            %msub
                              %mi Ω
                              %mi BFV
                          %annotation{:encoding => "application/x-tex"} \tau_{\Sigma_p} \Omega_{BFV}
                    %td{:style => "text-align: left;"}
                      %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+form"} Kähler form
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi ω
                          %annotation{:encoding => "application/x-tex"} \omega
                  %tr
                    %td{:style => "text-align: left;"}
                      %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Δ
                          %annotation{:encoding => "application/x-tex"} \Delta
                    %td{:style => "text-align: left;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi ω
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                          %annotation{:encoding => "application/x-tex"} \omega^{-1}
                  %tr
                    %td{:style => "text-align: left;"}
                      %a.existingWikiWord{:href => "/nlab/show/Peierls-Poisson+bracket"} Peierls-Poisson bracket
                      %br/
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msub
