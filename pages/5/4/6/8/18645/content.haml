                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
                %a.existingWikiWord{:href => "/nlab/show/derivative+of+distributions"} distributional derivative
                on the
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distributional
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                of the given polynomial observable.
              %p
                Now by prop.
                %a.maruku-ref{:href => "#RetainsOrShrinksWaveFrontSetDifferentialOperator"}
                the application of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi P
