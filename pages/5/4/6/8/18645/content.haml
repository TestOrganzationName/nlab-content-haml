            #VerticalTangentBundle.num_example
              %h6#example_6 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/vertical+tangent+bundle"}> vertical tangent bundle
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
