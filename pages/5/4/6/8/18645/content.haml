                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      P
                      \\;\colon\;
                      \\Gamma_\Sigma(E)
                      \\longrightarrow
                      \\Gamma_{\Sigma}(E^\ast)
              %p
                is of
                %em second order
                if it has a coordinate expansion of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mi Φ
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi a
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi P
                        %mrow
                          %mi a
                          %mi b
                        %mrow
                          %mi μ
                          %mi ν
                      %mfrac
                        %mrow
                          %msup
                            %mo ∂
                            %mn 2
                          %msup
                            %mi Φ
                            %mi b
                        %mrow
                          %mo ∂
                          %msup
                            %mi x
                            %mi μ
                          %mo ∂
                          %msup
                            %mi x
                            %mi ν
                      %mo +
                      %msubsup
                        %mi P
                        %mrow
                          %mi a
                          %mi b
                        %mi μ
                      %mfrac
                        %mrow
                          %mo ∂
                          %msup
                            %mi Φ
                            %mi b
                        %mrow
                          %mo ∂
                          %msup
                            %mi x
                            %mi μ
                      %mo +
                      %msub
                        %mi P
                        %mrow
                          %mi a
                          %mi b
                      %msup
                        %mi Φ
                        %mi b
                    %annotation{:encoding => "application/x-tex"}
                      (P \Phi)_a
                      \\;=\;
                      P^{\mu \nu}_{a b} \frac{\partial^2 \Phi^b}{\partial x^\mu \partial x^\nu}
                      +
                      P^\mu_{a b} \frac{\partial \Phi^b}{\partial x^\mu}
                      +
                      P_{a b} \Phi^b
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi P
                        %mrow
                          %mi a
