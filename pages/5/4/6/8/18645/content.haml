                along its
                %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#JetProlongation"}
                %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
                = succeed ":" do
                  %a.maruku-eqref{:href => "#eq:TensorFaraday"} (20)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                  %mo (
                                  %msubsup
                                    %mi j
                                    %mi Σ
                                    %mn ∞
