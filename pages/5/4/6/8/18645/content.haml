                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; \Gamma_{\Sigma_{tra}}(E)_{\delta_{EL} \mathbf{L} = 0}
                      \\\
                      \&amp; {}^{\mathllap{ (-)\vert_{in} }}\swarrow &amp;&amp; \searrow^{\mathrlap{ (-)\vert_{out} }}
                      \\\
                      \\Gamma_{\Sigma^{(in)}}(E)_{\delta_{EL}\mathbf{L}= 0}
                      \&amp;&amp; &amp;&amp;
                      \\Gamma_{\Sigma^{(out)}}(E)_{\delta_{EL}\mathbf{L}= 0}
                      \\\
                      \&amp; {}_{\mathllap{\omega_{in}}}\searrow &amp;&amp; \swarrow_{\mathrlap{\omega_{out}}}
                      \\\
                      \&amp;&amp; \mathbf{\Omega}^{2}
                      }
              %p
                in that the
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
                of the two
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+forms"} presymplectic forms
                %a.maruku-eqref{:href => "#eq:TransgressionOfPresymplecticCurrentToCauchySurface"} (115)
                coincides on the space of field histories:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
