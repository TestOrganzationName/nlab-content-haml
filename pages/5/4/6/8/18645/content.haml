            .proof
              %h6#proof_5 Proof
              %p Regarding the first statement, consider a horizontally exact variational form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi α
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi cp
                        %mrow
                          %mi r
                          %mo ,
                          %mi s
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d \alpha \in \Omega^{r,s}_{\Sigma,cp}(E)
                      \\,.
              %p
                By prop.
                %a.maruku-ref{:href => "#PullbackAlongJetProlongationIntertwinesHorizontalDerivative"}
                the pullback of this form along the jet prolongation of fields is exact in the
                = succeed "-direction:" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
