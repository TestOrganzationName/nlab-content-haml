                                %mfrac
                                  %mrow
                                    %mi m
                                    %mi c
                                  %mi ℏ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      D
                      \&amp; \coloneqq
                      \-i {\partial\!\!\!/\,}
                      + \tfrac{m c}{\hbar}
                      \\\
                      \&amp; =
                      \-i \gamma^\mu \frac{\partial}{\partial x^\mu} + \tfrac{m c}{\hbar}
                      \\end{aligned}
                      \\,.
              %p
                Its
                %a.existingWikiWord{:href => "/nlab/show/advanced+and+retarded+propagators"} advanced and retarded propagators
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#AdvancedAndRetardedGreenFunctions"}
                %a.existingWikiWord{:href => "/nlab/show/derivatives+of+distributions"} derivatives of distributions
                of the advanced and retarded propagators
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mo ±
                    %annotation{:encoding => "application/x-tex"} \Delta_\pm
                for the
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#AdvancedRetardedPropagatorsForKleinGordonOnMinkowskiSpacetime"}
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo ∂
