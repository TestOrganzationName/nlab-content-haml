                        %mrow
                          %mi μ
                          %mi ν
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi P
                        %mrow
                          %mi a
                          %mi b
                        %mi μ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
