                              %msub
                                %mi dvol
                                %mi Σ
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ≔
                              %msub
                                %mi τ
                                %mi Σ
                              %mrow
                                %mo (
                                %msub
                                  %mi a
                                  %mi sw
                                %msup
                                  %mi v
                                  %mi a
                                %mfrac
                                  %mrow
                                    %msub
                                      %mi δ
                                      %mi EL
                                    %mstyle{:mathvariant => "bold"}
                                      %mi L
                                    %mo ′
                                  %mrow
                                    %mi δ
                                    %msup
                                      %mi ϕ
                                      %mi a
                                %mspace{:width => "thinmathspace"}
                                %msub
                                  %mi dvol
                                  %mi Σ
                                %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      (div \mathbf{J})_{sw}
                      \&amp; \coloneqq
                      \\underset{\Sigma}{\int}
                      \\underset{
                      A^a(x)
                      }{
                      \\underbrace{
                      a_{sw}(x)
                      v^a( \mathbf{\Phi}(x), D\mathbf{\Phi}(x), \cdots )
                      }
                      }
                      \\frac{\delta S'}{\delta \mathbf{\Phi}^a(x)}
                      \\,
                      dvol_\Sigma(x)
                      \\\
                      \&amp; \coloneqq
                      \\tau_\Sigma
                      \\left(
                      a_{sw}  v^a \frac{\delta_{EL} \mathbf{L}'}{\delta \phi^a}
                      \\, dvol_\Sigma
                      \\right)
                      \\end{aligned}
              %p
                by
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression of variational differential forms
              %p This is such that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo {
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi S
                        %mo ′
                        %mo ,
                        %msub
                          %mi A
                          %mi sw
                        %mo }
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi div
                      %mstyle{:mathvariant => "bold"}
                        %mi J
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi sw
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \-S' , A_{sw}
                      \\right\}
                      \=
                      (div \mathbf{J})_{sw}
                      \\,.
              %p
                Hence applied to this choice of local observable
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %a.maruku-eqref{:href => "#eq:RearrangedMasterWardWithOnShell"} (259)
                now says that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℛ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mrow
                        %mo (
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi div
                        %mstyle{:mathvariant => "bold"}
                          %mi J
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi sw
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi ℛ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mrow
                        %mo (
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} {
                        %mi g
                        %msub
                          %mi S
                          %mi int
                        %mo ,
                        %msub
                          %mi A
                          %mi sw
                        %msub
                          %mo{:stretchy => "false"} }
                          %mi 𝒯
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                        %mo )
                      %mphantom
                        %mi AAA
                      %mtext on-shell
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{R}^{-1}
                      \\left(
                      {\, \atop \,}
                      (div \mathbf{J})_{sw}
                      \\right)
                      \\;=\;
                      \\mathcal{R}^{-1}
                      \\left(
                      {\, \atop \,}
                      \\{g S_{int}, A_{sw} \}_{\mathcal{T}}
                      {\, \atop \,}
                      \\right)
                      \\phantom{AAA}
                      \\text{on-shell}
              %p
                Hence the
                = succeed "-version" do
                  %a.existingWikiWord{:href => "/nlab/show/interacting+field+observable"} interacting field observable
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℛ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi div
                      %mstyle{:mathvariant => "bold"}
                        %mi J
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{R}^{-1}(div\mathbf{J})
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi div
                      %mstyle{:mathvariant => "bold"}
                        %mi J
                    %annotation{:encoding => "application/x-tex"} div \mathbf{J}
                need not vanish itself on-shell, instead there may be a correction as shown on the right.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              This concludes our discussion of perturbative
              %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+theories"} interacting field theories
              %em
                %a{:href => "#Renormalization"} next chapter
              wé discuss explicitly the
              %a.existingWikiWord{:href => "/nlab/show/induction"} inductive
              construction via
              %em
                %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
              of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
              as well as the various incarnations of the
              %a.existingWikiWord{:href => "/nlab/show/renormalization+group"} re-normalization group
              passing between different choices of such
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalizations
          %div
            %h2#Renormalization Renormalization
            %p In this chapter we discuss the following topics:
            %ul
              %li
                %p
                  %em
                    %a{:href => "#EpsteinGlaserRenormalization"} Epstein-Glaser normalization
              %li
                %p
                  %em
                    %a{:href => "#SPRenormalizationGroup"} Stückelberg-Petermann re-normalization
              %li
                %p
                  %em
                    %a{:href => "#UVRegularizationViaZ"} UV-Regularization via Counterterms
              %li
                %p
                  %em
                    %a{:href => "#EffectiveQFTFlowWislonian"} Wilson-Polchinski effective QFT flow
              %li
                %p
                  %em
                    %a{:href => "#RGFlowGeneral"} Renormalization group flow
              %li
                %p
                  %em
                    %a{:href => "#ScalingTransformatinRGFlow"} Gell-Mann &amp; Low RG Flow
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              In the
              %a{:href => "#InteractingQuantumFields"} previous chapter
              we have seen that the construction of
              %a.existingWikiWord{:href => "/nlab/show/interacting+quantum+field+theory"} interacting
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theories"} perturbative quantum field theories
              is given by perturbative
              %a.existingWikiWord{:href => "/nlab/show/S-matrix+schemes"} S-matrix schemes
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TimeOrderedProduct"}
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#FeynmanPerturbationSeriesAwayFromCoincidingPoints"}
              = succeed ")" do
                %a.maruku-ref{:href => "#TimeOrderedProductAwayFromDiagonal"}
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#TimeOrderedProductAwayFromDiagonal"}
              = succeed ")." do
                %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ExtensionOfTimeOrderedProoductsRenormalization"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
            %p
              In this rigorous discussion no “infinite divergent quantities” (as in the original informal discussion due to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Schwinger-Tomonaga-Feynman-Dyson"} Schwinger-Tomonaga-Feynman-Dyson
              %em normalization
              of the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
              (as prominently highlighted in
              = succeed ")." do
                %a{:href => "causal+perturbation+theoryscatt#Scharf95"} Scharf 95, see title, introduction, and section 4.3
            %p
              The construction of
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFTs"} perturbative QFTs
              may be explicitly described by an
              %a.existingWikiWord{:href => "/nlab/show/induction"} inductive
              %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
              of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
              to coinciding interaction points. This is called
            %ul
              %li
                %em>
                  %a{:href => "#EpsteinGlaserRenormalization"} Epstein-Glaser renormalization
                \.
            %p
              This inductive construction has the advantage that it gives accurate control over the space of available choices of (“re”-)normalizations (theorem
              %a.maruku-ref{:href => "#ExistenceRenormalization"}
              below) but it leaves the nature of the “new interactions” that are to be chosen at coinciding interaction points somwewhat implicit.
            %p
              Alternatively, one may
              %a.existingWikiWord{:href => "/nlab/show/vertex+redefinition"} re-define the interactions
              explicitly (by adding “
              %a.existingWikiWord{:href => "/nlab/show/counterterms"}> counterterms
              ”, remark
              %a.maruku-ref{:href => "#TermCounter"}
              below), depending on a chosen
              = succeed "-scale" do
                %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
              %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
              below), and construct the
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              as the “cutoff is removed” (prop.
              %a.maruku-ref{:href => "#UVRegularization"}
              below). This is called (“re”-)normalization by
            %ul
              %li
                %em>
                  %a{:href => "#UVRegularizationViaZ"} UV-Regularization via Counterterms
                \.
            %p
              This still leaves open the question how to choose the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/counterterms"} counterterms
              %em
                %a.existingWikiWord{:href => "/nlab/show/relative+effective+action"} relative effective action
              induced by the choice of
              %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
              at any given cutoff scale (def.
              %a.maruku-ref{:href => "#EffectiveActionRelative"}
              below). This is the perspective of
              %em
                %a.existingWikiWord{:href => "/nlab/show/effective+quantum+field+theory"} effective quantum field theory
              (remark
              %a.maruku-ref{:href => "#pQFTEffective"}
              below).
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
              change of these
              %a.existingWikiWord{:href => "/nlab/show/relative+effective+actions"} relative effective actions
              follows a universal
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              %em
                %a.existingWikiWord{:href => "/nlab/show/Polchinski%27s+flow+equation"} Polchinski's flow equation
              (prop.
              %a.maruku-ref{:href => "#FlowEquationPolchinski"}
              below). This makes the problem of (“re”-)normalization be that of solving this
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              subject to chosen initial data. This is the perspective on (“re”-)normalization called
            %ul
              %li
                %em>
                  %a{:href => "#EffectiveQFTFlowWislonian"} Wilson-Polchinski effective QFT flow
                \.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
              (theorem
              %a.maruku-ref{:href => "#PerturbativeRenormalizationMainTheorem"}
              below) states that different
              %a.existingWikiWord{:href => "/nlab/show/S-matrix+schemes"} S-matrix schemes
              are precisely related by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
            %ul
              %li
                %em>
                  %a{:href => "#SPRenormalizationGroup"} Stückelberg-Petermann renormalization group
                \.
            %p
              If a sub-collection of
              %a.existingWikiWord{:href => "/nlab/show/renormalization+schemes"} renormalization schemes
              is parameterized by some
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi RG
                    %annotation{:encoding => "application/x-tex"} RG
              %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem
              implies
              %a.existingWikiWord{:href => "/nlab/show/vertex+redefinitions"} vertex redefinitions
              depending on pairs of elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RG
                  %annotation{:encoding => "application/x-tex"} RG
              (prop.
              %a.maruku-ref{:href => "#FlowRenormalizationGroup"}
              below). This is known as
            %ul
              %li
                %em
                  %a{:href => "#RGFlowGeneral"} Renormalization group flow
            %p
              Specifically
              %a.existingWikiWord{:href => "/nlab/show/scaling+transformations"} scaling transformations
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              yield such a collection of
              %a.existingWikiWord{:href => "/nlab/show/renormalization+schemes"} renormalization schemes
              (prop.
              %a.maruku-ref{:href => "#RGFlowScalingTransformations"}
              below); the corresponding
              %a.existingWikiWord{:href => "/nlab/show/renormalization+group+flow"} renormalization group flow
              is known as
            %ul
              %li
                %em>
                  %a{:href => "#ScalingTransformatinRGFlow"} Gell-Mann &amp; Low RG flow
                \.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
              behaviour of this flow is known as the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/beta+function"} beta function
              %em
                %a.existingWikiWord{:href => "/nlab/show/running+of+the+coupling+constants"} running of the coupling constants
              with scale (def.
              %a.maruku-ref{:href => "#CouplingRunning"}
              below).
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#EpsteinGlaserRenormalization
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser normalization
            %p
              The construction of
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theories"} perturbative quantum field theories
              around a given
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              is equivalently, by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#InteractingFieldAlgebraOfObservablesIsFormalDeformationQuantization"}
              %a.existingWikiWord{:href => "/nlab/show/S-matrices"} S-matrices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}(g S_{int} + j A)
              in the sense of
              %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                    %annotation{:encoding => "application/x-tex"} g S_{int} + j A
              %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
              the construction of these
              %a.existingWikiWord{:href => "/nlab/show/S-matrices"} S-matrices
              is
              %a.existingWikiWord{:href => "/nlab/show/induction"} inductively
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              a choice of
              %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
              (remark
              %a.maruku-ref{:href => "#TimeOrderedProductOfFixedInteraction"}
              and def.
              %a.maruku-ref{:href => "#ExtensionOfDistributions"}
              below) of the corresponding
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              of the
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              to the locus of coinciding interaction points. An inductive construction of the
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              this way is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser-("re"-)normalization
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ExtensionOfTimeOrderedProoductsRenormalization"}
            %p
              By paying attention to the
              %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+distributions"} scaling degree
              (def.
              %a.maruku-ref{:href => "#ScalingDegree"}
              below) one may precisely characterize the space of choices in the
              %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
              (prop.
              %a.maruku-ref{:href => "#SpaceOfPointExtensions"}
              below): For a given
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                  %annotation{:encoding => "application/x-tex"} g S_{int} + j A
              it is inductively in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              a
              %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite-dimensional
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/affine+space"} affine space
              %a.maruku-ref{:href => "#ExistenceRenormalization"}
              below.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            #RenormalizationIsInductivelyExtensionToDiagonal.num_prop
              %h6#proposition Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
                  is
                  %a.existingWikiWord{:href => "/nlab/show/induction"} inductive
                  %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension
                  of
                  %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
                  to
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
