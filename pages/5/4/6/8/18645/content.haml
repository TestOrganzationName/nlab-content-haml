                                  %mi A
                                  %mo{:stretchy => "false"} )
                                  %mo )
                                %mo *
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi f
                                %mrow
                                  %mi μ
                                  %mi ν
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mi A
