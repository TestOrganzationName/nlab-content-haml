            %p
              (
              %a{:href => "renormalization#Duetsch10"}> Dütsch 10, section 4
              )
            .num_example
              %h6#example_4 Example
              %p
                %strong (relativistic momentum cutoff)
              %p
                Recall from
                %a{:href => "Feynman+propagator#FeynmanPropagatorAsACauchyPrincipalvalue"} this prop.
                that the
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
                of the
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                for the
                %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
                on
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
                is,
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mover
                                  %mi Δ
                                  %mo ^
                                %mi F
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mfrac
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                  %mi i
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 2
                                  %mi π
                                  %msup
                                    %mo{:stretchy => "false"} )
                                    %mrow
                                      %mi p
                                      %mo +
                                      %mn 1
                              %mfrac
                                %mn 1
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi η
                                  %mo{:stretchy => "false"} (
                                  %mi k
                                  %mo ,
                                  %mi k
                                  %mo{:stretchy => "false"} )
                                  %mo −
                                  %msup
                                    %mrow
                                      %mo (
                                      %mstyle{:displaystyle => "false"}
                                        %mfrac
                                          %mrow
                                            %mi m
                                            %mi c
                                          %mi ℏ
                                      %mo )
                                    %mn 2
                                  %mo +
                                  %mi i
                                  %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\widehat{\Delta}_F(k)
                      \&amp; =
                      \\frac{+i}{(2\pi)^{p+1}}
                      \\frac{
                      1
                      }{
                      \- \eta(k,k) - \left( \tfrac{m c}{\hbar} \right)^2 + i 0
                      }
                      \\end{aligned}
              %p
                To produce a
                %a.existingWikiWord{:href => "/nlab/show/UV+cutoff"} UV cutoff
                in the sense of def.
                %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
                we would like to set this function to zero for
                %a.existingWikiWord{:href => "/nlab/show/wave+numbers"} wave numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi k
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} \vert \vec k\vert
                (hence
                %a.existingWikiWord{:href => "/nlab/show/momenta"} momenta
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℏ
                        %mo{:stretchy => "false"} |
                        %mover
                          %mi k
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} \hbar\vert \vec k\vert
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Λ
                      %annotation{:encoding => "application/x-tex"} \Lambda
              %p
                This needs to be done with due care: First, the
                %a.existingWikiWord{:href => "/nlab/show/Paley-Wiener-Schwartz+theorem"} Paley-Wiener-Schwartz theorem
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#PaleyWienerSchwartzTheorem"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mrow
                          %mi F
                          %mo ,
                          %mi Λ
                    %annotation{:encoding => "application/x-tex"} \Delta_{F,\Lambda}
                to be a test function and hence compactly supported, its
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi Δ
                          %mo ^
                        %mrow
                          %mi F
                          %mo ,
                          %mi Λ
                    %annotation{:encoding => "application/x-tex"} \widehat{\Delta}_{F,\Lambda}
                needs to be smooth and of bounded growth. So instead of multiplying
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi Δ
                          %mo ^
                        %mi F
                    %annotation{:encoding => "application/x-tex"} \widehat{\Delta}_F
                by a
                %a.existingWikiWord{:href => "/nlab/show/step+function"} step function
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
            %p
              (
              %a{:href => "UV+regularization#KellerKopperSchophaus97"}> Keller-Kopper-Schophaus 97, section 6.1
              ,
              = succeed ")" do
                %a{:href => "renormalization#Duetsch18"} Dütsch 18, example 3.126
            #SMatrixEffective.num_defn
              %h6#definition_6 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix+scheme"}> effective S-matrix scheme
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo ′
                      %mo ,
                      %msub
                        %mi Δ
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
                be a
                %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
                %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
                (according to def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#VacuumFree"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %mo {
                          %msub
                            %mi Δ
                            %mrow
                              %mi F
                              %mo ,
                              %mi Λ
                          %mo }
                        %mrow
                          %mi Λ
                          %mo ∈
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mn ∞
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \left\{ \Delta_{F,\Lambda}\right\}_{\Lambda \in [0,\infty)}
                be a choice of
                %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"} UV cutoffs
                for
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
                around this vacuum (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#CutoffsUVForPerturbativeQFT"}
              %p
                We say that the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/effective+S-matrix+scheme"} effective S-matrix scheme
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒮
                        %mi Λ
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}_\Lambda
                at cutoff scale
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Lambda \in [0,\infty)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi PolyObs
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi E
                                %mtext BV-BRST
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi mc
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi ℏ
                              %mo ,
                              %mi g
                              %mo ,
                              %mi j
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi 𝒮
                                    %mi Λ
                            %mtd
                              %mi PolyObs
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi E
                                %mtext BV-BRST
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi mc
                              %mo{:stretchy => "false"} [
                              %mo{:stretchy => "false"} [
                              %mi ℏ
                              %mo ,
                              %mi g
                              %mo ,
                              %mi j
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                              %mi O
                            %mtd
                              %mo ↦
                            %mtd
                              %msub
                                %mi 𝒮
                                %mi Λ
                              %mo{:stretchy => "false"} (
                              %mi O
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j] ]
                      \&amp;\overset{\mathcal{S}_{\Lambda}}{\longrightarrow}&amp;
                      PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j] ]
                      \\\
                      O &amp;\mapsto&amp; \mathcal{S}_\Lambda(O)
                      }
              %p
                is the
                %a.existingWikiWord{:href => "/nlab/show/exponential+series"} exponential series
              #eq:EffectiveSMatrixScheme.maruku-equation
                %span.maruku-eq-number (271)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi 𝒮
                                %mi Λ
                              %mo{:stretchy => "false"} (
                              %mi O
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≔
                              %msub
                                %mi exp
                                %mrow
                                  %mi F
                                  %mo ,
                                  %mi Λ
                              %mrow
                                %mo (
                                %mfrac
                                  %mn 1
                                  %mrow
                                    %mi i
                                    %mi ℏ
                                %mi O
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mn 1
                              %mo +
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi i
                                  %mi ℏ
                              %mi O
                              %mo +
                              %mfrac
                                %mn 1
                                %mn 2
                              %mfrac
                                %mn 1
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi i
                                  %mi ℏ
                                  %msup
                                    %mo{:stretchy => "false"} )
                                    %mn 2
                              %mi O
                              %msub
                                %mo ⋆
                                %mrow
                                  %mi F
                                  %mo ,
                                  %mi Λ
                              %mi O
                              %mo +
                              %mfrac
                                %mn 1
                                %mrow
                                  %mn 3
                                  %mo !
                              %mfrac
                                %mn 1
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi i
                                  %mi ℏ
                                  %msup
                                    %mo{:stretchy => "false"} )
                                    %mn 3
