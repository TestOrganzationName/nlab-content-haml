            #TransgressionOfVariationaldifferentialFormsCompatibleWithVariationalDerivative.num_prop
              %h6#proposition_8 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
                  compatible with
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                over a
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi r
                      %mo ↪
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma_r \hookrightarrow \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
                possibly
                %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} with boundary
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %msub
                          %mi Σ
                          %mi r
                        %mo ↪
                        %msub
                          %mi Σ
                          %mi r
                      %annotation{:encoding => "application/x-tex"} \partial \Sigma_r \hookrightarrow \Sigma_r
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi Σ
                            %mi r
                      %mo{:stretchy => "false"} (
                      %mi E
