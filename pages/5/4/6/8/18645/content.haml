                                            %mo{:stretchy => "false"} )
                                            %mo *
                                    %mtd
                                    %mtd
                                      %mi X
                                      %mo{:stretchy => "false"} (
                                      %msup
                                        %mi ℝ
                                        %mrow
                                          %msub
                                            %mi n
                                            %mn 3
                                      %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"}
                              \\array{
                              \&amp;&amp; X(\mathbb{R}^{n_2})
                              \\\
                              \&amp; {}^{\mathllap{f^\ast}}\swarrow &amp;&amp; \nwarrow^{\mathrlap{g^\ast}}
                              \\\
                              X(\mathbb{R}^{n_1})
                              \&amp;&amp; \underset{ (g \circ f)^\ast }{\longleftarrow} &amp;&amp;
                              X(\mathbb{R}^{n_3})
                              }
                %li
                  %p
                    (
                    %a.existingWikiWord{:href => "/nlab/show/sheaf"}> gluing
                    )
                  %p
                    If
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi f
                                %mi i
                          %msup
                            %mi ℝ
                            %mi n
                          %msub
                            %mo{:stretchy => "false"} }
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                        %annotation{:encoding => "application/x-tex"} \{ U_i \overset{f_i}{\to} \mathbb{R}^n\}_{i \in I}
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/differentiably+good+open+cover"} differentiably good open cover
                    of a
                    %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#DifferentiablyGoodOpenCover"}
                    = succeed "-plots" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi ℝ
                              %mi n
                          %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                    to a set of
                    = succeed "-plots" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi U
                              %mi i
                          %annotation{:encoding => "application/x-tex"} U_i
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mi n
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo ↪
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi f
                                %mi i
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %msub
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %mi X
