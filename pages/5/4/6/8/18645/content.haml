                            %mi μ
                            %mi ν
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi μ
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi ν
                        %mo −
                        %msup
                          %mi m
                          %mn 2
                        %msup
                          %mi ϕ
                          %mn 2
                        %mo )
                      %msub
                        %mi dvol
                        %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L}
                      \\;=\;
                      \\tfrac{1}{2}
                      \\left(
                      \\eta^{\mu \nu}\phi_{,\mu} \phi_{,\nu}
                      \-
                      m^2 \phi^2
                      \\right)
                      dvol_\Sigma
                      \\,.
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \nu \in \{0, 1, \cdots, p\}
                consider the vector field on the jet bundle given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mi ν
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi ν
                      %msub
                        %mo ∂
                        %mi ϕ
                      %mo +
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                          %mi ν
                      %msub
                        %mo ∂
                        %mrow
                          %msub
                            %mi ϕ
                            %mrow
                              %mo ,
                              %mi μ
                      %mo +
                      %mi ⋯
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      v_\nu
                      \\;\coloneqq\;
                      \\phi_{,\nu} \partial_{\phi}
                      +
                      \\phi_{,\mu \nu} \partial_{\phi_{,\mu}}
                      +
                      \\cdots
                      \\,.
              %p
                This describes infinitesimal translations of the fields in the direction of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∂
                          %mi ν
                      %annotation{:encoding => "application/x-tex"} \partial_\nu
              %p
                And this is an
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#SymmetriesAndConservedCurrents"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mi v
                            %mi ν
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo =
                      %mi d
                      %mi L
                      %mo ∧
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mi ν
                      %msub
                        %mi dvol
                        %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\iota_{v_\nu} \mathbf{d}\mathbf{L}
                      \=
                      d L \wedge \iota_{\partial_\nu} dvol_\Sigma
                      \\,.
              %p
                With the formula
                %a.maruku-eqref{:href => "#eq:PresymplecticPotentialOfFreeScalarField"} (63)
                for the presymplectic potential
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Θ
                        %mi BFV
                      %mo =
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %mi δ
                      %mi ϕ
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mi ν
                      %msub
                        %mi dvol
                        %mi Σ
                    %annotation{:encoding => "application/x-tex"}
                      \\Theta_{BFV}
                      \=
                      \\eta^{\mu \nu} \phi_{,\mu} \delta \phi \iota_{\partial_{\nu}} dvol_\Sigma
              %p
                it hence follows from
                %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#NoethersFirstTheorem"}
                %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SymmetriesAndConservedCurrents"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi T
                                %mi ν
                            %mtd
                              %mo =
                              %mi L
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mo ∂
                                    %mi ν
                              %msub
                                %mi dvol
                                %mi Σ
                              %mo −
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mi v
                                    %mi ν
                              %msub
                                %mi Θ
                                %mi BFV
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mi L
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mo ∂
                                    %mi ν
                              %msub
                                %mi dvol
                                %mi Σ
                              %mo −
                              %msup
                                %mi η
                                %mrow
                                  %mi ρ
                                  %mi μ
                              %msub
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %mi ρ
                              %msub
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %mi ν
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mo ∂
                                    %mi μ
                              %msub
                                %mi dvol
                                %mi Σ
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:stretchy => "false"} (
                              %munder
                                %munder
                                  %mrow
                                    %msubsup
                                      %mi δ
                                      %mi ν
                                      %mi μ
                                    %mi L
                                    %mo −
                                    %msup
                                      %mi η
                                      %mrow
                                        %mi ρ
                                        %mi μ
                                    %msub
                                      %mi ϕ
                                      %mrow
                                        %mo ,
                                        %mi ρ
                                    %msub
                                      %mi ϕ
                                      %mrow
                                        %mo ,
                                        %mi ν
                                  %mo ⏟
                                %mrow
                                  %mo =
                                  %mo :
                                  %msubsup
                                    %mi T
                                    %mi ν
                                    %mi μ
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mo ∂
                                    %mi μ
                              %msub
                                %mi dvol
                                %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      T_\nu
                      \&amp; =
                      L \, \iota_{\partial_\nu} dvol_\Sigma
                      \-
                      \\iota_{v_\nu}\Theta_{BFV}
                      \\\
                      \&amp;
                      \=
                      L \, \iota_{\partial_\nu} dvol_\Sigma
                      \-
                      \\eta^{\rho \mu} \phi_{,\rho} \phi_{,\nu}
                      \\,
                      \\iota_{\partial_\mu} dvol_\Sigma
                      \\\
                      \&amp;  =
                      (
                      \\underset{=: T^\mu_\nu}{
                      \\underbrace{
                      \\delta^\mu_\nu  L
                      \-
                      \\eta^{\rho \mu} \phi_{,\rho} \phi_{,\nu}
                      }
                      }
                      )
                      \\,
                      \\iota_{\partial_\mu} dvol_\Sigma
                      \\end{aligned}
                      \\,.
              %p
                This
                %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
                is called the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/energy-momentum+tensor"} energy-momentum tensor
            #DiracCurrent.num_example
              %h6#example_2 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+current"}> Dirac current
                  )
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                of the
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
                on
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                in spacetime dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                      %mo =
                      %mn 3
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p + 1 = 3+1
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#LagrangianDensityForDiracField"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo =
                      %mi i
                      %mover
                        %mi ψ
                        %mo ¯
                      %msup
                        %mi γ
                        %mi μ
                      %msub
                        %mi ψ
                        %mrow
                          %mo ,
                          %mi μ
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi dvol
                        %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L} = i \overline{\psi} \gamma^\mu \psi_{,\mu} \, dvol_\Sigma
                      \\,.
              %p
                Then the prolongation (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EvolutionaryVectorField"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi i
                      %msub
                        %mi ψ
                        %mi α
                      %msub
                        %mo ∂
                        %mrow
                          %msub
                            %mi ψ
                            %mi α
                    %annotation{:encoding => "application/x-tex"}
                      v \;\coloneqq\; i \psi_\alpha \partial_{\psi_\alpha}
              %p
                is an
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#SymmetriesAndConservedCurrents"}
                %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
                that corresponds to this under
                %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem I
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#NoethersFirstTheorem"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mover
                        %mi ψ
                        %mo ¯
                      %msup
                        %mi γ
                        %mi μ
                      %mi ψ
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mi μ
                      %msub
                        %mi dvol
                        %mi Σ
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi Ω
                        %mi Σ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      i
                      \\overline{\psi} \gamma^\mu \psi \, \iota_{\partial_\mu} dvol_\Sigma
                      \\;\in\;
                      \\Omega^{p,0}_{\Sigma}(E)
                      \\,.
              %p
                This is called the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Dirac+current"} Dirac current
            .proof
              %h6#proof_4 Proof
              %p
                By equation
                %a.maruku-eqref{:href => "#eq:ProlongationOfEvolutionaryVectorFieldExplicit"} (77)
                the prolongation of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mo =
                      %mi i
                      %msub
                        %mi ψ
                        %mi α
                      %msub
                        %mo ∂
                        %mrow
                          %msub
                            %mi ψ
                            %mi α
                      %mo +
                      %mi i
                      %msub
                        %mi ψ
                        %mrow
                          %mi α
                          %mo ,
                          %mi μ
                      %msub
                        %mo ∂
                        %mrow
                          %msub
                            %mi ψ
                            %mrow
                              %mi α
                              %mo ,
                              %mi μ
                      %mo +
                      %mi ⋯
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\hat v
                      \=
                      i \psi_\alpha \partial_{\psi_\alpha}
                      +
                      i \psi_{\alpha,\mu} \partial_{\psi_{\alpha,\mu}}
                      +
                      \\cdots
                      \\,.
              %p
                Therefore the
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                is strictly invariant under the
                %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
                along
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat v
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi ℒ
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                              %mrow
                                %mo (
                                %mi i
                                %mover
                                  %mi ψ
                                  %mo ¯
                                %msup
                                  %mi γ
                                  %mi μ
                                %msub
                                  %mi ψ
                                  %mrow
                                    %mo ,
                                    %mi μ
                                %mo )
                              %msub
                                %mi dvol
                                %mi Σ
                            %mtd
                              %mo =
                              %munder
                                %munder
                                  %mrow
                                    %mi i
                                    %mover
                                      %mrow
                                        %mi i
                                        %mi ψ
                                      %mo ¯
                                    %msup
                                      %mi γ
                                      %mi μ
                                    %msub
                                      %mi ψ
                                      %mrow
                                        %mo ,
                                        %mi μ
                                  %mo ⏟
                                %mrow
                                  %mo =
                                  %mi i
                                  %mo ⋅
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi i
                                  %mo{:stretchy => "false"} )
                                  %mover
                                    %mi ψ
                                    %mo ¯
                                  %msup
                                    %mi γ
                                    %mi μ
                                  %msub
                                    %mi ψ
                                    %mrow
                                      %mo ,
                                      %mi μ
                              %msub
                                %mi dvol
                                %mi Σ
                              %mo +
                              %munder
                                %munder
                                  %mrow
                                    %mi i
                                    %mover
                                      %mi ψ
                                      %mo ¯
                                    %msup
                                      %mi γ
                                      %mi μ
                                    %mo{:stretchy => "false"} (
                                    %mi i
                                    %msub
                                      %mi ψ
                                      %mrow
                                        %mo ,
                                        %mi μ
                                    %mo{:stretchy => "false"} )
                                  %mo ⏟
                                %mrow
                                  %mi i
                                  %mo ⋅
                                  %mi i
                                  %mover
                                    %mi ψ
                                    %mo ¯
                                  %msup
                                    %mi γ
                                    %mi μ
                                  %msub
                                    %mi ψ
                                    %mrow
                                      %mo ,
                                      %mi μ
                              %msub
                                %mi dvol
                                %mi Σ
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mn 0
                              %mspace{:width => "thinmathspace"}
                              %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\mathcal{L}_{\hat v} \left(
                      i \overline{\psi} \gamma^\mu \psi_{,\mu}
                      \\right)
                      dvol_\Sigma
                      \&amp; =
                      \\underset{
                      \= i \cdot (-i) \overline{\psi} \gamma^\mu \psi_{,\mu}
                      }{
                      \\underbrace{
                      i \overline{i \psi} \gamma^\mu \psi_{,\mu}
                      }
                      }
                      dvol_\Sigma
                      +
                      \\underset{
                      i \cdot i \overline{\psi} \gamma^\mu \psi_{,\mu}
                      }{
                      \\underbrace{
                      i \overline{\psi} \gamma^\mu (i \psi_{,\mu})
                      }
                      }
                      dvol_\Sigma
                      \\\ &amp; =
                      0
                      \\,.
                      \\end{aligned}
              %p
                and so the formula for the corresponding conserved current
                %a.maruku-eqref{:href => "#eq:NoetherCurrent"} (79)
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi J
                                %mi v
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi ι
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                              %mrow
                                %mo (
                                %munder
                                  %munder
                                    %mrow
                                      %msub
                                        %mi Θ
                                        %mi BFV
                                    %mo ⏟
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mover
                                      %mi ψ
                                      %mo ¯
                                    %msup
                                      %mi γ
                                      %mi μ
                                    %mi δ
                                    %mi ψ
                                    %mspace{:width => "thinmathspace"}
                                    %msub
                                      %mi ι
                                      %mrow
                                        %msub
                                          %mo ∂
                                          %mi μ
                                    %msub
                                      %mi dvol
                                      %mi Σ
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                              %mi i
                              %mover
                                %mi ψ
                                %mo ¯
                              %msup
                                %mi γ
                                %mi μ
                              %mi ψ
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mo ∂
                                    %mi μ
                              %msub
                                %mi dvol
                                %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      J_v
                      \&amp; =
                      \- \iota_{\hat v}
                      \\left(
                      \\underset{
                      \-
                      \\overline{\psi}
                      \\gamma^\mu
                      \\delta \psi
                      \\,
                      \\iota_{\partial_\mu} dvol_\Sigma    }{
                      \\underbrace{
                      \\Theta_{BFV}
                      }
                      }
                      \\right)
                      \\\
                      \&amp;
                      \= + i \overline{\psi}\gamma^\mu \psi \, \iota_{\partial_\mu} dvol_\Sigma
                      \\end{aligned}
                      \\,,
              %p
                where under the brace we used example
                %a.maruku-ref{:href => "#PresymplecticCurrentDiracField"}
                to identify the
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+potential"} presymplectic potential
                for the
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              Since an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+a+Lagrangian"} infinitesimal symmetry of a Lagrangian
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetriesAndConservedCurrents"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivative"} total spacetime derivative
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              by construction depend on the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              only up to a
              %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivative"} total spacetime derivative
              (prop.
              = succeed ")," do
