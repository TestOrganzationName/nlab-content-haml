                    %annotation{:encoding => "application/x-tex"} \Omega^n(\mathbb{R}^k)
                for the sub-module of degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                and call its elements the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/differential+n-forms"} differential n-forms
              %p
                Explicitly this means that a
                %a.existingWikiWord{:href => "/nlab/show/differential+n-form"} differential n-form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo ∈
                      %msup
                        %mi Ω
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \omega \in \Omega^n(\mathbb{R}^k)
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
                is a
                %a.existingWikiWord{:href => "/nlab/show/formal+linear+combination"} formal linear combination
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^k)
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#AlgebraOfSmoothFunctionsOnCartesianSpaces"}
                %a.existingWikiWord{:href => "/nlab/show/basis"} basis
                elements of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %msup
                        %mi x
                        %mrow
                          %msub
                            %mi i
                            %mn 1
                      %mo ∧
                      %mi ⋯
                      %mo ∧
                      %mi d
                      %msup
                        %mi x
                        %mrow
                          %msub
                            %mi i
                            %mi n
                    %annotation{:encoding => "application/x-tex"} d  x^{i_1} \wedge \cdots \wedge d x^{i_n}
                for
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mo &lt;
                        %msub
                          %mi i
                          %mn 2
                        %mo &lt;
                        %mi ⋯
                        %mo &lt;
                        %msub
                          %mi i
                          %mi n
                      %annotation{:encoding => "application/x-tex"} i_1 \lt i_2 \lt \cdots \lt i_n
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo =
                      %msub
                        %mi ω
                        %mrow
                          %msub
                            %mi i
                            %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi i
                            %mi n
                      %mi d
                      %msup
                        %mi x
                        %mrow
                          %msub
                            %mi i
                            %mn 1
                      %mo ∧
                      %mi ⋯
                      %mo ∧
                      %mi d
                      %msup
                        %mi x
                        %mrow
                          %msub
                            %mi i
                            %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\omega = \omega_{i_1, \cdots, i_n} d x^{i_1} \wedge \cdots \wedge d x^{i_n}
                      \\,.
            %p
              Now all the constructions for
              %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
              above extent naturally to
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/differential+n-forms"} differential n-forms
            #deRhamDifferential.num_defn
              %h6#definition_12 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/exterior+derivative"} exterior derivative
                  or
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                a
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d \colon C^\infty(\mathbb{R}^n) \to \Omega^1(\mathbb{R}^n)
                %a.maruku-eqref{:href => "#eq:deRhamDifferentialOnFunctionsOnCartesianSpace"} (5)
                uniquely extended as a
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                of degree +1 to the
                %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
                of
                %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DifferentialnForms"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      d
                      \\;\colon\;
                      \\Omega^\bullet(\mathbb{R}^n)
                      \\longrightarrow
                      \\Omega^\bullet(\mathbb{R}^n)
              %p
                meaning that for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ω
                        %mi i
                      %mo ∈
                      %msup
                        %mi Ω
                        %mrow
                          %msub
                            %mi k
                            %mi i
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \omega_i \in \Omega^{k_i}(\mathbb{R})
                then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ω
                        %mn 1
                      %mo ∧
                      %msub
                        %mi ω
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi d
                      %msub
                        %mi ω
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %msub
                        %mi ω
                        %mn 2
                      %mo +
                      %msub
                        %mi ω
                        %mn 1
                      %mo ∧
                      %mi d
                      %msub
                        %mi ω
                        %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d(\omega_1 \wedge \omega_2)
                      \\;=\;
                      (d \omega_1) \wedge \omega_2
                      +
                      \\omega_1 \wedge d \omega_2
                      \\,.
              %p In components this simply means that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi d
                              %mi ω
                            %mtd
                              %mo =
                              %mi d
                              %mrow
                                %mo (
                                %msub
                                  %mi ω
                                  %mrow
                                    %msub
                                      %mi i
                                      %mn 1
                                    %mi ⋯
                                    %msub
                                      %mi i
                                      %mi k
                                %mi d
                                %msup
                                  %mi x
                                  %mrow
                                    %msub
                                      %mi i
                                      %mn 1
                                %mo ∧
                                %mi ⋯
                                %mo ∧
                                %mi d
                                %msup
                                  %mi x
                                  %mrow
                                    %msub
                                      %mi i
                                      %mi k
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %msub
                                    %mi ω
                                    %mrow
                                      %msub
                                        %mi i
                                        %mn 1
                                      %mi ⋯
                                      %msub
                                        %mi i
                                        %mi k
                                %mrow
                                  %mo ∂
                                  %msup
                                    %mi x
                                    %mi a
                              %mi d
                              %msup
                                %mi x
                                %mi a
                              %mo ∧
                              %mi d
                              %msup
                                %mi x
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 1
                              %mo ∧
                              %mi ⋯
                              %mo ∧
                              %mi d
                              %msup
                                %mi x
                                %mrow
                                  %msub
                                    %mi i
                                    %mi k
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      d \omega
                      \&amp; =
                      d \left(\omega_{i_1 \cdots i_k} d x^{i_1} \wedge \cdots \wedge d x^{i_k}\right)
                      \\\
                      \&amp; =
                      \\frac{\partial \omega_{i_1 \cdots i_k}}{\partial x^{a}}
                      d x^a \wedge d x^{i_1} \wedge \cdots \wedge d x^{i_k}
                      \\end{aligned}
                      \\,.
              %p
                Since
                %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
                commute with each other, while differential 1-form anti-commute, this implies that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                is nilpotent
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi d
                        %mn 2
                      %mo =
                      %mi d
                      %mo ∘
                      %mi d
                      %mo =
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d^2 = d \circ d = 0
                      \\,.
              %p
                We say hence that
                %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
                form a
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
                %em
                  %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Ω
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\Omega^\bullet(\mathbb{R}^n), d)
            #ContractionOfFormsWithVectorFields.num_defn
              %h6#definition_13 Definition
              %p
                %strong
                  (contraction of
                  %a.existingWikiWord{:href => "/nlab/show/differential+n-forms"} differential n-forms
                  with
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
              %p
                The pairing
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi v
                      %mi ω
                      %mo =
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \iota_v \omega = \omega(v)
                of
                %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                with
                %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
                %a.maruku-eqref{:href => "#eq:PairingVectorFieldsWithDifferential1Forms"} (4)
                uniquely
                %a.existingWikiWord{:href => "/nlab/show/extension"} extends
                to the
                %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\mathbb{R}^n)
                of
                %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DifferentialnForms"}
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                of degree -1
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi v
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi Ω
                        %mrow
                          %mo •
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\iota_v \;\colon\; \Omega^{\bullet+1}(\mathbb{R}^n) \longrightarrow \Omega^\bullet(\mathbb{R}^n)
                      \\,.
              %p
                In particular for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ω
                        %mn 1
                      %mo ,
                      %msub
                        %mi ω
                        %mn 2
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \omega_1, \omega_2 \in \Omega^1(\mathbb{R}^n)
                two
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi v
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ω
                        %mn 1
                      %mo ∧
                      %msub
                        %mi ω
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
