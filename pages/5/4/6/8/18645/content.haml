                    of
                    %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian
                    equipped with
                    %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
                %tr
                  %td{:style => "text-align: left;"} “reduced”
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
                    have been
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy-quotiented
                    out
                %tr
                  %td{:style => "text-align: left;"} “covariant”
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Cauchy+surfaces"} Cauchy surfaces
                    exist degreewise
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#QuasiIsomorphismsBetweenBVBRSTComplexes
              %strong
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
                between
                %a.existingWikiWord{:href => "/nlab/show/local+BV-BRST+complexes"} local BV-BRST complexes
            %p
              Recall (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CochainCohomologyOfBVBRSTComplexInDegreeZero"}
              %a.existingWikiWord{:href => "/nlab/show/local+BV-BRST+complex"} local BV-BRST complex
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalBVBRSTComplexIsDerivedCriticalLocusOfEulerLagrangeForm"}
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+differential"} BV-BRST differential
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              which are
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              and
              %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariant
              is the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              in degree zero:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} |
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mtext gauge invariant on-shell
                          %mtr
                            %mtd
                              %mtext local observables
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    H^0(s \vert d)
                    \\;=\;
                    \\left\{
                    \\array{
                    \\text{gauge invariant on-shell}
                    \\\
                    \\text{local observables}
                    }
                    \\right\}
            %p
              The key point of having
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolved
              (in chapter
              = succeed ")" do
                %em
                  %a{:href => "#ReducedPhaseSpace"} Reduced phase space
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              by
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
              of the naive
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              with the
              %a.existingWikiWord{:href => "/nlab/show/shell"} shell
              by the
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebroid"} L-infinity algebroid
              whose
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              is called the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/local+BV-BRST+complex"} local BV-BRST complex
              %a.existingWikiWord{:href => "/nlab/show/reduced+phase+space"} reduced phase space
              into the
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} context
              of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
              this way provides the freedom of changing the choice of
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              and of
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              without actually changing the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              = succeed "," do
                %em
                  up to
                  %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complex"} BV-BRST complex
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebras"} differential graded-commutative superalgebras
              (such as
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complexes"} BV-BRST complexes
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
              between
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complexes"} BV-BRST complexes
            %ol
              %li
                %p
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixing
                  (def.
                  %a.maruku-ref{:href => "#GaugeFixingLagrangianDensity"}
                  below)
              %li
                %p
                  %em
                    adjoining
                    %a.existingWikiWord{:href => "/nlab/show/auxiliary+fields"} auxiliary fields
                  (def.
                  %a.maruku-ref{:href => "#AuxiliaryFields"}
                  below).
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#GaugeFixingChainMaps
              %strong
                %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixing
                %a.existingWikiWord{:href => "/nlab/show/chain+maps"} chain maps
            #ExponentialOfLocalAntibracket.num_prop
