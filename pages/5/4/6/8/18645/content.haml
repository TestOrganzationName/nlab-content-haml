                          %mo →
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E) \to \mathbb{R}
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/coordinate+function"} coordinate function
                    on
                    %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                    of
                    %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                  %td{:style => "text-align: left;"}
                    def.
                    = succeed "," do
                      %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                    %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/field+history"} field history
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi Φ
                        %annotation{:encoding => "application/x-tex"} \Phi
                    ,
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mfrac
