                      PolyObs(E)_{reg}[ [\hbar] ]
                      \\otimes
                      PolyObs(E)_{reg}[ [\hbar] ]
                      \&amp;\overset{}{\longrightarrow}&amp;
                      PolyObs(E)_{reg}[ [\hbar] ]
                      \\\
                      (A_1, A_2)
                      \&amp;\mapsto&amp;
                      \\phantom{\coloneqq} A_1 \star_F A_2
                      }
              %p hence
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                      %msub
                        %mo ⋆
                        %mi F
                      %msub
                        %mi A
                        %mn 2
