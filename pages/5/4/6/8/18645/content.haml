                %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} distributional support
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DistributionalSections"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
