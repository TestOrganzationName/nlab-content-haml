                      \\frac{- 2}{(2\pi)^{2} {\vert \vec x - \vec y\vert}}
                      \\underset{{\vert \vec k\vert} \in \mathbb{R}_{\geq 0}}{\int}
                      \\frac{ {\vert \vec k \vert} }{ \omega(\vec k)/c }
