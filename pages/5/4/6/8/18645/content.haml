                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          \\rho_v \left( {\, \atop \,} T(A_1, \cdots, A_n) {\, \atop \,}\right)
                          \\;=\;
                          T(\rho_{v}(A_1), \cdots, \rho_v(A_n))
                %li
                  %p
                    (
                    %a.existingWikiWord{:href => "/nlab/show/quantum+master+equation"}> quantum master equation
                    ,
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/master+Ward+identity"} master Ward identity
                    %a.maruku-ref{:href => "#QuantumMasterEquation"}
                  %p
                    (if this condition fails, the corresponding
                    %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} quantum anomaly
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#RenormalizationConditions"}
                    = succeed ")" do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/gauge+anomaly"} gauge anomaly
            %p
              (
              %a{:href => "S-matrix#Duetsch18"}> Dütsch 18, p. 150 and section 4.2
              )
            .proof
              %h6#proof_15 Proof
              %p
                For the first two statements this is obvious from prop.
                %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
                and prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#TimeOrderedProductAwayFromDiagonal"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msup
                            %mi Σ
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo ∖
                          %mi diag
                          %mo{:stretchy => "false"} (
                          %mi Σ
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T_{n+1}\vert_{\Sigma^{n+1} \setminus diag(\Sigma)}
                is uniquely specified from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi T
                        %mi k
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi k
                          %mo ≤
                          %mi n
                    %annotation{:encoding => "application/x-tex"} \{T_k\}_{k \leq n}
                via the
                %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
                induced by the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                = succeed ")." do
                  %a.maruku-ref{:href => "#FeynmanPropagatorAsACauchyPrincipalvalue"}
              %p
                The third statement requires work. That the
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+master+equation"} quantum master equation
                %a.existingWikiWord{:href => "/nlab/show/master+Ward+identity"} master Ward identity
                always holds on
                %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
                is prop.
                %a.maruku-ref{:href => "#QuantumMasterEquation"}
                below. That it holds for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msup
                            %mi Σ
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo ∖
                          %mi diag
                          %mo{:stretchy => "false"} (
                          %mi Σ
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T_{n+1}\vert_{\Sigma^{n+1} \setminus diag(\Sigma)}
                if it holds for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi T
                        %mi k
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi k
                          %mo ≤
                          %mi n
                    %annotation{:encoding => "application/x-tex"} \{T_k\}_{k \leq n}
                is shown in
                = succeed "." do
                  %a{:href => "S-matrix#Duetsch18"} Duetsch 18, section 4.2.2
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              We discuss methods for
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} normalization
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#RenormalizationIsInductivelyExtensionToDiagonal"}
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} re-normalization
              in detail in the
              = succeed "." do
                %a{:href => "#Renormalization"} next chapter
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#FeynmanDiagrams
              %strong Feynman perturbation series
            %p
              By def
              %a.maruku-ref{:href => "#ExtensionOfTimeOrderedProoductsRenormalization"}
              and the
              %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
              (theorem
              = succeed ")," do
                %a.maruku-ref{:href => "#PerturbativeRenormalizationMainTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              schemes/
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              may be phrased as
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re-")normalization
              of the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              induced by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension of distributions
              of the this star-product to the locus of coinciding interaction points.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              is the
              %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
              of the binary contraction with the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              of
              %a.existingWikiWord{:href => "/nlab/show/products+of+distributions"} products of distributions
              labeled by
              %a.existingWikiWord{:href => "/nlab/show/finite+multigraphs"} finite multigraphs
              (def.
              %a.maruku-ref{:href => "#Graphs"}
              below), where each
              %a.existingWikiWord{:href => "/nlab/show/vertex"} vertex
              corresponds to an
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              or
              %a.existingWikiWord{:href => "/nlab/show/source+field"} source field
              insertion, and where each
              %a.existingWikiWord{:href => "/nlab/show/edge"} edge
              corresponds to one contractions of two of these with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              %a.existingWikiWord{:href => "/nlab/show/products+of+distributions"} products of distributions
              arising this way are the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
              (prop.
              %a.maruku-ref{:href => "#FeynmanPerturbationSeriesAwayFromCoincidingPoints"}
              below).
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              is decomposed as a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of distinct
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
              = succeed "/species" do
                %a.existingWikiWord{:href => "/nlab/show/types"} types
              %a.maruku-ref{:href => "#VerticesAndFieldSpecies"}
              below), then in addition to the
              %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
              also the edges in these
              %a.existingWikiWord{:href => "/nlab/show/graphs"} graphs
              receive labels, now by the field species whose particular
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              is being used in the contraction at that edges. These labeled graphs are now called
              %em
                %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
              (def.
              %a.maruku-ref{:href => "#FeynmanDiagram"}
              below) and the
              %a.existingWikiWord{:href => "/nlab/show/products+of+distributions"} products of distributions
              which they encode are their
              %em
                %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
              built by the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Feynman+rules"} Feynman rules
              (prop.
              %a.maruku-ref{:href => "#FeynmanDiagramAmplitude"}
              below).
            %p
              The choice of
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
              of the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              is thus equivalently a choice of
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
              of the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
              for all possible
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              by their
              %em
                %a.existingWikiWord{:href => "/nlab/show/loop+order"} loop order
              (prop.
              %a.maruku-ref{:href => "#FeynmanDiagramLoopOrder"}
              below).
            %p
              In conclusion, the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+rules"} Feynman rules
              make the perturbative
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              be equal to a
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              of
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
              labeled by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+graphs"} Feynman graphs
              %em
                %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
              (example
