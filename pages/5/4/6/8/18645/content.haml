            #FeynmanAmplitudesInCausalPerturbationTheoryExampleOfQED.num_example
              %h6#example_6 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
