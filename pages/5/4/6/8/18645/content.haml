                %a.existingWikiWord{:href => "/nlab/show/natural+bijections"} natural bijections
                of sets of plots
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
