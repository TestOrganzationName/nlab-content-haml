            #ClassicalWeilAlgebra.num_example
              %h6#example_10 Example
              %p
                %strong
                  (classical
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                be a
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                with corresponding
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} B \mathfrak{g}
                (example
                = succeed ")." do
                  %a.maruku-ref{:href => "#BasicExamplesOfLieAlgebroids"}
                = succeed ")" do
                  %a.maruku-ref{:href => "#WeilAlgebra"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} B \mathfrak{g}
                is the traditional Weil algebra of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                from classical
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} Lie theory
            #BVVariationalBicomplex.num_defn
              %h6#definition_10 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/variational+BV-bicomplex"}> variational BV-bicomplex
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                be a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundle"} gauge parameter bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
                = succeed ")." do
                  %a.maruku-ref{:href => "#GaugeParametersClosed"}
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %msub
                        %mo ×
                        %mi Σ
                      %mi T
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E/(\mathcal{G} \times_\Sigma T \Sigma)
                from example
                = succeed "," do
                  %a.maruku-ref{:href => "#LocalOffShellBRSTComplex"}
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                is the
                %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
                of the theory.
              %p
                Then its
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %msub
                        %mo ×
                        %mi Σ
                      %mi T
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(E/(\mathcal{G} \times_\Sigma T \Sigma))
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#WeilAlgebra"}
                %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/BRST+differential"} BRST differential
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi d
                                %mi W
                            %mtd
                              %mo =
                              %mstyle{:mathvariant => "bold"}
                                %mi d
                              %mo −
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mo −
                              %msub
                                %mi s
                                %mi BRST
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mi δ
                              %mo +
                              %msub
                                %mi s
                                %mi BRST
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      d_{W}
                      \&amp; = \mathbf{d} - (d - s_{BRST})
                      \\\
                      \&amp; =
                      \\delta + s_{BRST}
                      \\end{aligned}
                      \\,.
              %p
                Therefore we speak of the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/variational+BRST-bicomplex"} variational BRST-bicomplex
                and write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
