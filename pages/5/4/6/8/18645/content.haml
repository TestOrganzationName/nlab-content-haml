                      %annotation{:encoding => "application/x-tex"} g
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
                in a space of
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theories"} Lagrangian field theories
                at the point
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℏ
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \hbar = 0
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} g = 0
              %p
                In fact, a simple argument (due to
                = succeed ")" do
                  %a{:href => "perturbative+quantum+field+theory#Dyson52"} Dyson 52
                %em never
                converge for
                %em any
                %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive
                value of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
                and/or
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                would imply a
                %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive
                %em
                  %a.existingWikiWord{:href => "/nlab/show/radius+of+convergence"} radius of convergence
                around
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} g = 0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi g
                    %annotation{:encoding => "application/x-tex"} -g
                and even for
                %a.existingWikiWord{:href => "/nlab/show/imaginary+number"} imaginary
                values of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                %a.existingWikiWord{:href => "/nlab/show/interactions"} interactions
                for which no converging field theory is to be expected. (See
                %a{:href => "perturbative+quantum+field+theory#Helling"} Helling, p. 4
                for the example of
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/phi%5E4+theory"} phi^4 theory
              %p
                In physical practice one tries to interpret these non-converging
                %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
                as
                %em
                  %a.existingWikiWord{:href => "/nlab/show/asymptotic+expansions"} asymptotic expansions
                of actual but hypothetical functions in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℏ
                        %mo ,
                        %mi g
                      %annotation{:encoding => "application/x-tex"} \hbar, g
                %em
                  %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative quantum field theory
                that one imagines is being approximated by
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
                methods. An
                %em
                  %a.existingWikiWord{:href => "/nlab/show/asymptotic+expansion"} asymptotic expansion
                of a function is a
                %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
                which may not converge, but which has for every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                an estimate for how far the
                %a.existingWikiWord{:href => "/nlab/show/sum"} sum
                of the first
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                terms in the series may differ from the function being approximated.
              %p
                For examples such as
                %a.existingWikiWord{:href => "/nlab/show/quantum+electrodynamics"} quantum electrodynamics
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+chromodynamics"} quantum chromodynamics
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
                %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
                %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
                to the first handful of
                %a.existingWikiWord{:href => "/nlab/show/loop+orders"} loop orders
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
                happens to agree with
                %a.existingWikiWord{:href => "/nlab/show/experiment"} experiment
                (such as at the
                %a.existingWikiWord{:href => "/nlab/show/LHC"} LHC
                collider) to high precision (for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/QED"} QED
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/QCD"} QCD
                = succeed ")." do
                  %a.maruku-ref{:href => "#AdiabaticLimit"}
              %p
                In summary this says that
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
                is an extremely
                %em coarse
                and restrictive approximation to what should be genuine
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative quantum field theory
              %p
                This is strong motivation for going beyond
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
                to understand and construct genuine
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative quantum field theory
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting field theory
                in
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≥
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} \geq 4
                has been non-perturbatively quantized. Already a single aspect of the
                %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative
                %a.existingWikiWord{:href => "/nlab/show/quantization+of+Yang-Mills+theory"} quantization of Yang-Mills theory
                (as in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/QCD"} QCD
                %em
                  %a{:href => "http://www.claymath.org/millennium-problems/yang%E2%80%93mills-and-mass-gap"} Millennium Problems
                of our age; and speculation about
                %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative
                %a.existingWikiWord{:href => "/nlab/show/quantum+gravity"} quantum gravity
                is the subject of much activity.
              %p
                Now, as the name indicates, the
                %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
                of
                %em
                  %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
                %em not
                address
                %a.existingWikiWord{:href => "/nlab/show/non-perturbative+effect"} non-perturbative aspects
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/non-perturbative+field+theory"} non-perturbative field theory
                %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
                that are axiomatized by
                %a.existingWikiWord{:href => "/nlab/show/Bogoliubov%27s+formula"} Bogoliubov's formula
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#InteractingFieldObservables"}
                %em not
                addressed by the theory. The point of the axioms of
                %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
                is to give rigorous mathematical meaning to
                %em everything else
                in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
            #DysonCausalFactorization.num_remark
              %h6#remark_6 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Dyson+series"} Dyson series
                  and
                  %a.existingWikiWord{:href => "/nlab/show/Schr%C3%B6dinger+equation"} Schrödinger equation
                  in
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/interaction+picture"} interaction picture
              %p
                The axiom “
                %a.existingWikiWord{:href => "/nlab/show/causal+additivity"}> causal additivity
                ”
                %a.maruku-eqref{:href => "#eq:CausalAdditivity"} (230)
                on an
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                scheme (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
                %a.maruku-ref{:href => "#CausalFactorizationAlreadyImpliesSMatrix"}
                below):
              %ul
                %li
                  %p
                    (
                    %a.existingWikiWord{:href => "/nlab/show/causal+factorization"}> causal factorization
                    )
                  %p
                    For all
                    %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi O
                            %mn 1
                          %mo ,
