                        %annotation{:encoding => "application/x-tex"} m
                    is
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mn 2
                          %mi i
                          %mspace{:width => "thinmathspace"}
                          %mover
                            %mrow
                              %mi δ
                              %mi ψ
                            %mo ¯
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi γ
                            %mi μ
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi ψ
                            %mrow
                              %mo ,
                              %mi μ
                          %mspace{:width => "thinmathspace"}
                          %mo ∧
                          %msub
                            %mi dvol
                            %mi Σ
                        %annotation{:encoding => "application/x-tex"}
                          \\delta_{EL} \mathbf{L}
                          \\;=\;
                          2 i\,
                          \\overline{\delta \psi}
                          \\,\gamma^\mu\, \psi_{,\mu}
                          \\,
                          \\wedge dvol_\Sigma
                  %p
                    and in the case that
                    %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                    %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                    is
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                          %mo =
                          %mn 4
                        %annotation{:encoding => "application/x-tex"} p +1 = 4
                    and arbitrary
                    %a.existingWikiWord{:href => "/nlab/show/mass"} mass
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi m
                            %mo ∈
                            %mi ℝ
                          %annotation{:encoding => "application/x-tex"} m\in \mathbb{R}
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mrow
                            %mo (
                            %mover
                              %mrow
                                %mi δ
                                %mi ψ
                              %mo ¯
                            %mrow
                              %mo (
                              %mi i
                              %msup
                                %mi γ
                                %mi μ
                              %msub
                                %mi ψ
                                %mrow
                                  %mo ,
                                  %mi μ
                              %mo +
                              %mi m
                              %mi ψ
                              %mo )
                            %mo +
                            %mrow
                              %mo (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi i
                              %msup
                                %mi γ
                                %mi μ
                              %mover
                                %mrow
                                  %msub
                                    %mi ψ
                                    %mrow
                                      %mo ,
                                      %mi μ
                                %mo ¯
                              %mo +
                              %mi m
                              %mover
                                %mi ψ
                                %mo ¯
                              %mo )
                            %mo{:stretchy => "false"} (
                            %mi δ
                            %mi ψ
                            %mo{:stretchy => "false"} )
                            %mo )
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi dvol
                            %mi Σ
                        %annotation{:encoding => "application/x-tex"}
                          \\delta_{EL} \mathbf{L}
                          \\;=\;
                          \\left(
                          \\overline{\delta \psi}
                          \\left(
                          i \gamma^\mu \psi_{,\mu} + m \psi
                          \\right)
                          +
                          \\left(
                          \- i \gamma^\mu\overline{\psi_{,\mu}} + m \overline{\psi}
                          \\right)
                          (\delta \psi)
                          \\right)
                          \\,
                          dvol_\Sigma
                %li
                  %p
                    its
                    %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Ω
                            %mi BFV
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mover
                            %mrow
                              %mi δ
                              %mi ψ
                            %mo ¯
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi γ
                            %mi μ
                          %mspace{:width => "thinmathspace"}
                          %mi δ
                          %mi ψ
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi ι
                            %mrow
                              %msub
                                %mo ∂
                                %mi μ
                          %msub
                            %mi dvol
                            %mi Σ
                        %annotation{:encoding => "application/x-tex"}
                          \\Omega_{BFV}
                          \\;=\;
                          \\overline{\delta \psi}\,\gamma^\mu \,\delta \psi \, \iota_{\partial_\mu} dvol_\Sigma
            .proof
              %h6#proof_8 Proof
              %p
                In any case the
                %a.existingWikiWord{:href => "/nlab/show/canonical+momentum"} canonical momentum
                of the
                %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
                according to example
                %a.maruku-ref{:href => "#CanonicalMomentum"}
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msubsup
                                %mi p
                                %mi μ
                                %mi α
                            %mtd
                              %mo ≔
                              %mfrac
                                %mo ∂
                                %mrow
                                  %mo ∂
                                  %msubsup
                                    %mi ψ
                                    %mrow
                                      %mo ,
                                      %mi μ
                                    %mi α
                              %mrow
                                %mo (
                                %mi i
                                %mover
                                  %mi ψ
                                  %mo ¯
                                %mspace{:width => "thinmathspace"}
                                %msup
                                  %mi γ
                                  %mi ν
                                %mspace{:width => "thinmathspace"}
                                %msub
                                  %mi ψ
                                  %mrow
                                    %mo ,
                                    %mi ν
                                %mo +
                                %mi m
                                %mover
                                  %mi ψ
                                  %mo ¯
                                %mi ψ
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %msup
                                %mover
                                  %mi ψ
                                  %mo ¯
                                %mi β
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi γ
                                %mi μ
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi β
                              %msup
                                %mrow
                                %mi α
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      p^\alpha_\mu
                      \&amp; \coloneqq
                      \\frac{\partial }{\partial \psi^\alpha_{,\mu}}
                      \\left(
                      i \overline {\psi} \, \gamma^\nu \, \psi_{,\nu}
                      +
                      m \overline{\psi} \psi
                      \\right)
                      \\\
                      \&amp; =
                      \\overline{\psi}^\beta (\gamma^\mu)_\beta{}^\alpha
                      \\end{aligned}
              %p
                This yields the
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
                as claimed, by example
                = succeed "." do
                  %a.maruku-ref{:href => "#CanonicalMomentum"}
              %p
                Now regarding the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 3
                        %mo ,
                        %mn 4
                        %mo ,
                        %mn 6
                        %mo ,
                        %mn 10
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} p+1 \in \{3,4,6,10\}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi i
                      %mover
                        %mi ψ
                        %mo ¯
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi γ
                        %mi μ
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi ψ
                        %mrow
                          %mo ,
                          %mi μ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      L
                      \\;=\;
                      i \overline{\psi} \, \gamma^\mu \, \psi_{,\mu}
                      \\,.
              %p Then we compute as follows:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi δ
                                %mi EL
                              %mi L
                            %mtd
                              %mo =
                              %mi i
                              %mspace{:width => "thinmathspace"}
                              %mover
                                %mrow
                                  %mi δ
                                  %mi ψ
                                %mo ¯
                              %mspace{:width => "thinmathspace"}
                              %msup
                                %mi γ
                                %mi μ
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi ψ
                                %mrow
                                  %mo ,
                                  %mi μ
                              %munder
                                %munder
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mi i
                                    %mover
                                      %mrow
                                        %msub
                                          %mi ψ
                                          %mrow
                                            %mo ,
                                            %mi μ
                                      %mo ¯
                                    %mspace{:width => "thinmathspace"}
                                    %msup
                                      %mi γ
                                      %mi μ
                                    %mspace{:width => "thinmathspace"}
                                    %mi δ
                                    %mi ψ
                                  %mo ⏟
                                %mrow
                                  %mo =
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                  %mi i
                                  %mspace{:width => "thinmathspace"}
                                  %mover
                                    %mrow
                                      %mi δ
                                      %mi ψ
                                    %mo ¯
                                  %mspace{:width => "thinmathspace"}
                                  %msup
                                    %mi γ
                                    %mi μ
                                  %mspace{:width => "thinmathspace"}
                                  %msub
                                    %mi ψ
                                    %mrow
                                      %mo ,
                                      %mi μ
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mn 2
                              %mi i
                              %mspace{:width => "thinmathspace"}
                              %mover
                                %mrow
                                  %mi δ
                                  %mi ψ
                                %mo ¯
                              %mspace{:width => "thinmathspace"}
                              %msup
                                %mi γ
                                %mi μ
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi ψ
                                %mrow
                                  %mo ,
                                  %mi μ
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\delta_{EL} L
                      \&amp; =
                      i \,\overline{\delta \psi} \, \gamma^\mu \, \psi_{,\mu}
                      \\underset{
                      \= +
                      i \,\overline{\delta \psi} \, \gamma^\mu \, \psi_{,\mu}
                      }{
                      \\underbrace{
                      \-
                      i \overline{\psi_{,\mu}} \, \gamma^\mu \, \delta \psi
                      }
                      }
                      \\\
                      \&amp; =
                      2 i \, \overline{\delta \psi} \, \gamma^\mu \, \psi_{,\mu}
                      \\end{aligned}
              %p
                Here the first equation is the general formula
                %a.maruku-eqref{:href => "#eq:EulerLagrangeEquationGeneral"} (50)
                for the Euler-Lagrange variation, while the identity under the braces combines two facts (as in remark
                %a.maruku-ref{:href => "#LagrangianDensityOfDiracFieldSupergeometricNature"}
                above):
              %ol
                %li
                  %p
                    the symmetry
                    %a.maruku-eqref{:href => "#eq:SpinorToVectorPairingIsSymmetric"} (12)
                    of the spinor pairing
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                            %mo ¯
                          %msup
                            %mi γ
                            %mi μ
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \overline{(-)}\gamma^\mu(-)
                    (prop.
                    = succeed ");" do
                      %a.maruku-ref{:href => "#RealSpinorPairingsViaDivisionAlg"}
                %li
                  %p
                    the anti-commutativity
                    %a.maruku-eqref{:href => "#eq:DiracFieldJetCoordinatesAnticommute"} (46)
                    of the Dirac field and jet coordinates, due to their
                    %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometric
                    nature (remark
                    = succeed ")." do
                      %a.maruku-ref{:href => "#DiracFieldSupergeometric"}
              %p
                Finally in the special case of the massive Dirac field in spacetime dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                      %mo =
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} p+1 = 4
                the Lagrangian function is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi i
                      %mspace{:width => "thinmathspace"}
                      %mover
                        %mi ψ
                        %mo ¯
                      %msup
                        %mi γ
                        %mi μ
                      %msub
                        %mi ψ
                        %mrow
                          %mo ,
                          %mi μ
                      %mo +
                      %mi m
                      %mover
                        %mi ψ
                        %mo ¯
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"}
                      L
                      \\;=\;
                      i \, \overline{\psi} \gamma^\mu \psi_{,\mu} + m \overline{\psi}\psi
              %p
                where now
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ψ
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \psi_\alpha
                takes values in the
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
                (as opposed to in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                    %annotation{:encoding => "application/x-tex"} \mathbb{H}
                or
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕆
                      %annotation{:encoding => "application/x-tex"} \mathbb{O}
                %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
                equivalently by treeating
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi ψ
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{\psi}
                as independent components of the field. This immediately yields the claim.
            #TrivialLagrangianDensities.num_example
              %h6#example_15 Example
              %p
                %strong
                  (trivial
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
                  and the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+complex"} Euler-Lagrange complex
              %p
                If a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                    %annotation{:encoding => "application/x-tex"} \mathbf{L}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LagrangianForFreeScalarFieldOnMinkowskiSpacetime"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivative"} total spacetime derivative
                = succeed ")" do
                  %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi d
                      %mstyle{:mathvariant => "bold"}
                        %mi ℓ
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{L} \;=\; d \mathbf{\ell}
              %p
                for any
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi ℓ
                        %mo ∈
                        %msubsup
                          %mi Ω
                          %mi Σ
                          %mrow
                            %mi p
                            %mo ,
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{\ell} \in \Omega^{p,0}_\Sigma(E)
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
                as well as its
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mi EL
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo =
                      %mn 0
                      %mphantom
                        %mi AA
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mphantom
                        %mi AA
                      %msub
                        %mi Ω
                        %mi BFV
                      %mo =
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\delta_{EL}\mathbf{L} = 0
                      \\phantom{AA}
                      \\,,
                      \\phantom{AA}
                      \\Omega_{BFV} = 0
                      \\,.
              %p
                This is because with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mo ∘
                      %mi d
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi d
                      %mo ∘
                      %mi δ
                    %annotation{:encoding => "application/x-tex"} \delta \circ d = - d \circ \delta
                %a.maruku-eqref{:href => "#eq:HorizontalAndVerticalDerivativeAnticommute"} (37)
                the defining unique decomposition
                %a.maruku-eqref{:href => "#eq:dLDecomposition"} (49)
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                    %annotation{:encoding => "application/x-tex"} \delta \mathbf{L}
                is given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi δ
                              %mstyle{:mathvariant => "bold"}
                                %mi L
                            %mtd
                              %mo =
                              %mi δ
                              %mi d
                              %mstyle{:mathvariant => "bold"}
                                %mi ℓ
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %munder
                                %munder
                                  %mn 0
                                  %mo ⏟
                                %mrow
                                  %mo =
                                  %msub
                                    %mi δ
                                    %mi EL
                                  %mstyle{:mathvariant => "bold"}
                                    %mi L
                              %mo −
                              %mi d
                              %munder
                                %munder
                                  %mrow
                                    %mi δ
                                    %mstyle{:mathvariant => "bold"}
                                      %mi l
                                  %mo ⏟
                                %mrow
                                  %msub
                                    %mi Θ
                                    %mi BFV
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\delta \mathbf{L}
                      \&amp; =
                      \\delta d \mathbf{\ell}
                      \\\
                      \&amp; =
                      \\underset{= \delta_{EL}\mathbf{L}}{\underbrace{0}}
                      \-
                      d \underset{\Theta_{BFV}}{\underbrace{\delta \mathbf{l}}}
                      \\end{aligned}
              %p
                which then implies with
                %a.maruku-eqref{:href => "#eq:PresymplecticCurrent"} (55)
