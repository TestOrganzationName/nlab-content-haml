                                %mtable
                                  %mtr
                                    %mtd
                                      %mtext linear off-shell
                                  %mtr
                                    %mtd
                                      %mtext observables
                                  %mtr
                                    %mtd
                                      %mtext of the scalar field
                            %mtd
                            %mtd
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mtext compactly supported
                                  %mtr
                                    %mtd
                                      %mtext distributions
                                  %mtr
                                    %mtd
                                      %mtext on spacetime
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      LinObs(\Sigma \times \mathbb{R}) &amp;\overset{\simeq}{\longrightarrow}&amp; \mathcal{E}'(\Sigma)
                      \\\
                      \\array{
                      \\text{linear off-shell}
                      \\\
                      \\text{observables}
                      \\\
                      \\text{of the scalar field}
                      }
                      \&amp;&amp;
                      \\array{
                      \\text{compactly supported}
                      \\\
                      \\text{distributions}
                      \\\
                      \\text{on spacetime}
                      }
                      }
                      \\,,
              %p
                saying that all
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distributions"} compactly supported distributions
                arise from linear off-shell observables of the
                %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
                this way, and uniquely so.
            %p
              For
              %strong proof
              see at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/distributions+are+the+smooth+linear+functionals"} distributions are the smooth linear functionals
              %a{:href => "distributions+are+the+smooth+linear+functionals#CompactlySupportedDistributionsAreTheSmoothLinearFunctionals"} this prop.
            %p
              The identification from prop.
              %a.maruku-ref{:href => "#LinearObservablesAreTheCompactlySupportedDistributions"}
              of linear off-shell observables with
              %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distributions"} compactly supported distributions
              makes available powerful tools from
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functional+analysis"} functional analysis
            #DistributionsAreGeneralizedFunctions.num_prop
              %h6#proposition_2 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
                  are
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/generalized+functions"} generalized functions
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+function"} compactly supported
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in C^\infty_{cp}(\mathbb{R}^n)
                on the
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                induces a
                %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
                (prop.
                = succeed ")," do
                  %a.maruku-ref{:href => "#LinearObservablesAreTheCompactlySupportedDistributions"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/continuous+linear+functional"} continuous linear functional
                %a.existingWikiWord{:href => "/nlab/show/integration"} integration
                against
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
                times the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi C
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi ℝ
                                %mi n
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi ℝ
                          %mtr
                            %mtd
                              %mi f
                            %mtd
                              %mo ↦
                            %mtd
                              %msub
                                %mo ∫
                                %mrow
                                  %msup
                                    %mi ℝ
                                    %mi n
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mi b
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mi dvol
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      C^\infty(\mathbb{R}^n) &amp;\longrightarrow&amp; \mathbb{R}
                      \\\
                      f &amp;\mapsto&amp; \int_{\mathbb{R}^n} f(x) b(x) \, dvol(x)
                      }
              %p
                The distributions arising this way are called the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
              %p
                This construction is clearly a
                %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} inclusion
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mi cp
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ↪
                        %mphantom
                          %mi AAA
                      %mi ℰ
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      C^\infty_{cp}(\mathbb{R}^n) \overset{\phantom{AAA}}{\hookrightarrow} \mathcal{E}'(\mathbb{R}^n)
              %p
                and in fact this is a
                %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense subspace
                inclusion for the space of compactly supported distributions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}'(\mathbb{R}^n)
                equipped with the
                %a.existingWikiWord{:href => "/nlab/show/dual+space"} dual space
                topology (
                %a{:href => "dual+vector+space#LinearDualOfATopologicalVectorSpace"}> this def.
                ) to the
                %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+space"} Fréchet space
                structure on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^n)
                from prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#LinearObservablesAreTheCompactlySupportedDistributions"}
              %p
                Hence every
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distribution"} compactly supported distribution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
                is the
                %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
                of a
                %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi b
                        %mi n
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \{b_n\}_{n \in \mathbb{N}}
                of
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+function"} compactly supported
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                in that for every
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R}^n)
                we have that the value
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} u(f) \in \mathbb{R}
                is the
                %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
                of
                %a.existingWikiWord{:href => "/nlab/show/integrals"} integrals
                against
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi b
                          %mi n
                        %mi dvol
                      %annotation{:encoding => "application/x-tex"} b_n dvol
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mi lim
                        %mrow
                          %mi n
                          %mo →
                          %mn ∞
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi b
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi dvol
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      u(f)
                      \\;=\;
                      \\underset{n \to \infty}{\lim}\, \int_{\mathbb{R}^n} f(x) b_n(x) dvol(x)
                      \\,.
            %p
              (e. g.
              = succeed ")" do
                %a{:href => "non-singular+distributionFourier+transform#Hoermander90Fourier+transform#Hoermander90"} Hörmander 90, theorem 4.1.5
            %p
              Proposition
              %a.maruku-ref{:href => "#DistributionsAreGeneralizedFunctions"}
              with prop.
              %a.maruku-ref{:href => "#LinearObservablesAreTheCompactlySupportedDistributions"}
              implies that with due care we may think of
              %em all
              linear off-shell observables as arising from
              %a.existingWikiWord{:href => "/nlab/show/integration"} integration
              of
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              against some “
              %a.existingWikiWord{:href => "/nlab/show/generalized+function"}> generalized smooth functions
              ” (namely a
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              of actual smooth functions):
            #LinearObservablesAsGeneralizedFunctions.num_remark
              %h6#remark Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
                  %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                  %a.existingWikiWord{:href => "/nlab/show/observables"} observables
                  of
                  %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
                  as
                  %a.existingWikiWord{:href => "/nlab/show/integration"} integration
                  against
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/generalized+functions"} generalized functions
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                be a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                with field coordinates
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ϕ
                          %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\phi^a)
              %p
                Prop.
                %a.maruku-ref{:href => "#LinearObservablesAreTheCompactlySupportedDistributions"}
                implies immediately that in this situation linear off-shell observables
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LinearObservables"}
                %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A_a)
                of
                %a.existingWikiWord{:href => "/nlab/show/compactly+supported+distributions"} compactly supported distributions
                via
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi Φ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi a
                      %msub
                        %mi A
                        %mi a
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Φ
                        %mi a
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      A(\Phi) = \underset{a}{\sum} A_a(\Phi^a)
                      \\,.
              %p
                With prop.
                %a.maruku-ref{:href => "#DistributionsAreGeneralizedFunctions"}
                it follows furthermore that there is a
                %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
                of
                %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi α
                        %mi n
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi a
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \{(\alpha_n)_{a}\}_{n \in \mathbb{N}}
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi a
                    %annotation{:encoding => "application/x-tex"} A_a
                is the
                %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
                of the
                %a.existingWikiWord{:href => "/nlab/show/integrations"} integrations
                against these:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi Φ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mi lim
                        %mrow
                          %mi n
                          %mo →
                          %mn ∞
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ∫
                        %mi Σ
                      %msup
                        %mi Φ
                        %mi a
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi α
                        %mi n
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi a
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi dvol
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      A(\Phi)
                      \\;=\;
                      \\underset{n \to \infty}{\lim}
                      \\,
                      \\int_\Sigma \Phi^a(x) (\alpha_n)_a(x) \, dvol(x)
                      \\,,
              %p
                where now the
                %a.existingWikiWord{:href => "/nlab/show/sum"} sum
                over the index
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
                is again left notationally implicit.
              %p
                For handling distributions/linear off-shell observables it is therefore useful to adopt, with due care, shorthand notation as if the
                %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limits
                of the
                %a.existingWikiWord{:href => "/nlab/show/sequences"} sequences
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi α
                        %mi n
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi a
                    %annotation{:encoding => "application/x-tex"} (\alpha_n)_a
                actually existed, as “
                %a.existingWikiWord{:href => "/nlab/show/generalized+functions"}> generalized functions
                ”
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi α
                          %mi a
                      %annotation{:encoding => "application/x-tex"} \alpha_a
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mi Σ
                      %msup
                        %mi Φ
                        %mi a
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi α
                        %mi a
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi dvol
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi Φ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\int_\Sigma \Phi^a(x) \alpha_a(x) \, dvol(x)
                      \\;\coloneqq\;
                      A(\Phi)
                      \\,,
              %p
                This suggests that basic operations on functions, such as their pointwise product, should be
                %a.existingWikiWord{:href => "/nlab/show/extension"} extended
                to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of
                the distributions being multiplied cancel out – the mathematical reflection of “
                %a.existingWikiWord{:href => "/nlab/show/UV-divergences"}> UV-divergences
                ” in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
                %em
                  %a{:href => "#FreeQuantumFields"} Free quantum fields
                below.
            %p
              These considerations generalize from the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              of the
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              to general
              %a.existingWikiWord{:href => "/nlab/show/field+bundles"} field bundles
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundles"} smooth vector bundles
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#VectorBundle"}
            #TVSStructureOnSpacesOfSmoothSections.num_defn
              %h6#definition_3 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+space"} Fréchet
                  %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
                  on
                  %a.existingWikiWord{:href => "/nlab/show/spaces+of+smooth+sections"} spaces of smooth sections
                  of a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#VectorBundle"}
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                (def.
                = succeed ");" do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
                as in example
                = succeed "." do
                  %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              %p
                On its
                %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
                %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} of smooth sections
                consider the
                %a.existingWikiWord{:href => "/nlab/show/seminorms"} seminorms
                indexed by a
                %a.existingWikiWord{:href => "/nlab/show/compact+subset"} compact subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo ⊂
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} K \subset \Sigma
                and a
                %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
                and given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Γ
                                %mi Σ
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %msubsup
                                    %mi p
                                    %mi K
                                    %mi k
                            %mtd
                              %mo{:stretchy => "false"} [
                              %mn 0
                              %mo ,
                              %mn ∞
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi Φ
                            %mtd
                              %mo ↦
                            %mtd
                              %munder
                                %mi max
                                %mrow
                                  %mrow
                                    %mo{:stretchy => "false"} |
                                    %mi α
                                    %mo{:stretchy => "false"} |
                                  %mo ≤
                                  %mi k
                              %mrow
                                %mo (
                                %munder
                                  %mi sup
                                  %mrow
                                    %mi x
                                    %mo ∈
                                    %mi K
                                %mrow
                                  %mo{:stretchy => "false"} |
                                  %msup
                                    %mo ∂
                                    %mi α
                                  %mi Φ
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} |
                                %mo )
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\Gamma_\Sigma(E) &amp;\overset{p_K^k}{\longrightarrow}&amp;
                      [0,\infty)
                      \\\
                      \\Phi &amp;\mapsto&amp;  \underset{ {\vert \alpha\vert} \leq k}{max} \left( \underset{x \in K}{sup} {\vert \partial^\alpha \Phi(x)\vert}\right) \,,
                      }
              %p
                where on the right we have the
                %a.existingWikiWord{:href => "/nlab/show/absolute+values"} absolute values
                of the
                %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} \Phi
                index by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                %a.maruku-eqref{:href => "#eq:PartialDerivativeWithManyIndices"} (1)
                with respect to any choice of
                %a.existingWikiWord{:href => "/nlab/show/norm"} norm
                on the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              %p
                This makes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
                a
                %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+space"} Fréchet
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo ⊂
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} K \subset \Sigma
                any
                %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
                then the sub-space of sections
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi K
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma_{\Sigma,K}(E) \hookrightarrow \Gamma_\Sigma(E)
              %p
                of sections whose
                %a.existingWikiWord{:href => "/nlab/show/support"} support
                is inside
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                becomes a
                %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+space"} Fréchet
                %a.existingWikiWord{:href => "/nlab/show/topological+vector+spaces"} topological vector spaces
                with the induced
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/closed+subspaces"} closed subspaces
              %p
                Finally, the
                %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
                of smooth sections with prescribed causal support (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
                %a.existingWikiWord{:href => "/nlab/show/inductive+limits"} inductive limits
                of vector spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi K
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_{\Sigma,K}(E)
                as above, and hence they inherit
                %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                by forming the corresponding
                %a.existingWikiWord{:href => "/nlab/show/inductive+limit"} inductive limit
                in the
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/topological+vector+spaces"} topological vector spaces
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi cp
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mi lim
                        %munder
                          %mo ⟶
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mrow
                                %mi K
                                %mo ⊂
                                %mi Σ
                            %mrow
                              %mrow
                                %mi K
                                %mspace{:width => "thinmathspace"}
                                %mtext compact
                      %msub
                        %mi Γ
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi K
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma_{\Sigma,cp}(E)
                      \\;\coloneqq\;
                      \\underset{\underset{ {K \subset \Sigma} \atop {K\, \text{compact}} }{\longrightarrow}}{\lim}
                      \\Gamma_{\Sigma,K}(E)
              %p etc.
            %p
              (
              %a{:href => "space+of+sections#Baer14"}> Bär 14, 2.1
              )
            #DistributionalSections.num_defn
              %h6#definition_4 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/distribution"} distributional
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#VectorBundle"}
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector
                %a.existingWikiWord{:href => "/nlab/show/spaces+of+smooth+sections"} spaces of smooth sections
                with restricted support from def.
                %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
                structures of
                %a.existingWikiWord{:href => "/nlab/show/topological+vector+spaces"} topological vector spaces
                via def.
                = succeed "." do
                  %a.maruku-ref{:href => "#TVSStructureOnSpacesOfSmoothSections"}
                %a.existingWikiWord{:href => "/nlab/show/dual+topological+vector+spaces"} dual topological vector spaces
                by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %msub
                        %mo ′
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Γ
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi cp
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma'_{\Sigma}( E ^*)
                      \\;\coloneqq\;
                      (\Gamma_{\Sigma,cp}(E))^*
                      \\,.
              %p
                This is called the space of
                %em distributional sections
                of the
                %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual vector bundle
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mo *
                      %annotation{:encoding => "application/x-tex"} {E}^*
              %p
                The
                %em
                  %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} support of a distributional section
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} supp(u)
                is the set of points in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                such that for every neighbourhood of that point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
                does not vanish on all sections with support in that neighbourhood.
              %p
                Imposing the same restrictions to the
                %a.existingWikiWord{:href => "/nlab/show/supports+of+distributions"} supports of distributional sections
                as in def.
                = succeed "," do
                  %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %msub
                        %mo ′
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi cp
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Γ
                      %msub
                        %mo ′
                        %mrow
                          %mi Σ
                          %mo ,
                          %mo ±
                          %mi cp
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Γ
                      %msub
                        %mo ′
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi scp
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Γ
                      %msub
                        %mo ′
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi fcp
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Γ
                      %msub
                        %mo ′
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi pcp
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Γ
                      %msub
                        %mo ′
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi tcp
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ⊂
                      %mspace{:width => "thickmathspace"}
                      %mi Γ
                      %msub
                        %mo ′
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma'_{\Sigma,cp}(E^\ast) ,
                      \\Gamma'_{\Sigma,\pm cp}(E^\ast) ,
                      \\Gamma'_{\Sigma,scp}(E^\ast) ,
                      \\Gamma'_{\Sigma,fcp}(E^\ast) ,
                      \\Gamma'_{\Sigma,pcp}(E^\ast) ,
                      \\Gamma'_{\Sigma,tcp}(E^\ast)
                      \\;\subset\;
                      \\Gamma'_{\Sigma}(E^\ast) .
            %p
              (
              %a{:href => "Green+hyperbolic+differential+operator#Sanders12"}> Sanders 13
              ,
              = succeed ")" do
                %a{:href => "Green+hyperbolic+differential+operator#Baer14"} Bär 14
            %p
              As before in prop.
              %a.maruku-ref{:href => "#DistributionsAreGeneralizedFunctions"}
              the actual
              %a.existingWikiWord{:href => "/nlab/show/smooth+sections"} smooth sections
              yield examples of distributional sections, and all distributional sections arise as
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limits
              of integrations against smooth sections:
            #NonSingularDistributionalSections.num_prop
              %h6#proposition_3 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/non-singular+distribution"}> non-singular distributional sections
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a
                %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
                over
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mi cp
                      %mo ,
                      %mo ±
                      %mi cp
                      %mo ,
                      %mi scp
                      %mo ,
                      %mi tcp
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} s \in \{cp, \pm cp, scp, tcp\}
                be any of the
                %a.existingWikiWord{:href => "/nlab/show/support"} support
                conditions from def.
                = succeed "." do
                  %a.maruku-ref{:href => "#CompactlySourceCausalSupport"}
              %p
                Then the operation of regarding a
                %a.existingWikiWord{:href => "/nlab/show/compact+support"} compactly supported
                %a.existingWikiWord{:href => "/nlab/show/smooth+section"} smooth section
                of the
                %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual vector bundle
                as a
                %a.existingWikiWord{:href => "/nlab/show/functional"} functional
                on sections with this support property is a
                %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense subspace
                inclusion into the
                %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
                of distributional sections from def.
                = succeed ":" do
                  %a.maruku-ref{:href => "#DistributionalSections"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Γ
                                %mrow
                                  %mi Σ
                                  %mo ,
                                  %mi cp
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi E
                                %mo *
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ↪
                                %mrow
                                  %mphantom
                                    %mi A
                                  %msub
                                    %mi u
                                    %mrow
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} )
                                  %mphantom
                                    %mi A
                            %mtd
                              %mi Γ
                              %msub
                                %mo ′
                                %mrow
                                  %mi Σ
                                  %mo ,
                                  %mi s
                              %mo{:stretchy => "false"} (
                              %mi E
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi b
                            %mtd
                              %mo ↦
                            %mtd
                              %mrow
                                %mo (
                                %mi Φ
                                %mo ↦
                                %munder
                                  %mo ∫
                                  %mi Σ
                                %mi b
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                                %mi Φ
                                %mo{:stretchy => "false"} (
