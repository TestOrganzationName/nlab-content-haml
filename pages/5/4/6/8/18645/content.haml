                      }
                      }
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#LinearOffShellObservablesAreDistributions
              %strong Polynomial off-shell Observables and Distributions
            %p
              We consider here
              %em
                %a.existingWikiWord{:href => "/nlab/show/linear+observables"} linear observables
              (def.
              %a.maruku-ref{:href => "#LinearObservables"}
              below) and more generally
              %em quadratic observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuadraticObservables"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/polynomial+observables"} polynomial observables
              (def.
              %a.maruku-ref{:href => "#PolynomialObservables"}
              below) for
              %a.existingWikiWord{:href => "/nlab/show/free+field+theories"} free field theories
              and discuss how these are equivalently given by
              %a.existingWikiWord{:href => "/nlab/show/integration"} integration
              against
              %a.existingWikiWord{:href => "/nlab/show/generalized+functions"} generalized functions
              called
              %em
                %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              (prop.
              %a.maruku-ref{:href => "#LinearObservablesAreTheCompactlySupportedDistributions"}
              and prop.
              %a.maruku-ref{:href => "#DistributionsAreGeneralizedFunctions"}
              below).
            %p
              This is the basis for the discussion of
              %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
              for
              %a.existingWikiWord{:href => "/nlab/show/free+field+theories"} free field theories
              = succeed "." do
                %a{:href => "#FreeQuantumFields"} further below
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            #LinearObservables.num_defn
              %h6#definition_2 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
                  %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/observables"} observables
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                be a
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %a.existingWikiWord{:href => "/nlab/show/super+vector+bundle"} super
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                (as in example
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
                and as opposed to more general non-linear
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/fiber+bundles"} fiber bundles
              %p
                This means that the
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#SupergeometricSpaceOfFieldHistories"}
                %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                by spacetime-pointwise (i.e.
                = succeed "-wise)" do
                  %a.existingWikiWord{:href => "/nlab/show/event"} event
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              %p
                Then an
                %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
                %a.existingWikiWord{:href => "/nlab/show/observable"} observable
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Observable"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"}
                      A \;\colon\; \Gamma_\Sigma(E) \longrightarrow \mathbb{C}
              %p
                is a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/linear+observable"} linear observable
                if it is a
                %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
                with respect to this vector space structure, hence if
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mrow
                        %mo (
                        %mi c
                        %msub
                          %mi Φ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi c
                        %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Φ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo )
                      %mphantom
                        %mi AAAA
                      %mtext and
                      %mphantom
                        %mi AAAA
                      %mi A
                      %mrow
                        %mo (
                        %msub
                          %mi Φ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo +
                        %mi Φ
                        %msub
                          %mo ′
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo )
                      %mo =
                      %mi A
                      %mrow
                        %mo (
                        %msub
                          %mi Φ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %msub
                          %mo ′
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      A\left( c \Phi_{(-)}) = c A(\Phi_{(-)} \right)
                      \\phantom{AAAA}
                      \\text{and}
                      \\phantom{AAAA}
                      A\left(\Phi_{(-)} + \Phi'_{(-)} \right)
                      \=
                      A\left( \Phi_{(-)}) + A(\Phi'_{(-)} \right)
              %p
                for all plots of
                %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Φ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo ,
                        %mi Φ
                        %msub
                          %mo ′
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Phi_{(-)}, \Phi'_{(-)}
              %p
                If moreover
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                is a
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FreeFieldTheory"}
                %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
                %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
                inherits this linear structure and we may similarly speak of linear on-shell observables.
              %p We write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi LinObs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi Obs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      LinObs(E,\mathbf{L}) \hookrightarrow Obs(E,\mathbf{L})
              %p
                for the subspace of
                %a.existingWikiWord{:href => "/nlab/show/linear+observables"} linear observables
                inside all
                %a.existingWikiWord{:href => "/nlab/show/observables"} observables
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Observable"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi LinObs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi Obs
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      LinObs(E) \hookrightarrow Obs(E)
              %p
                for the linear off-shell observables inside all off-shell observables, and similarly for the subspaces of
                %a.existingWikiWord{:href => "/nlab/show/linear+observables"} linear observables
                on
                %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
                of spatially compact supprt
                = succeed ":" do
                  %a.maruku-eqref{:href => "#eq:SpaceOfObservablesOnFieldHistoriesOfSpatiallyCompactSupport"} (88)
              #eq:LinearObservablesOnSpatiallyCompactlySupportedOnShellFieldHistories.maruku-equation
                %span.maruku-eq-number (90)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi LinObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mi scp
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi Obs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mi scp
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi L
