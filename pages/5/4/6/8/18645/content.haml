                          %msup
                            %mo{:stretchy => "false"} )
                            %mo *
                          %msub
                            %mi τ
                            %mrow
                              %mo ∂
                              %msub
                                %mi Σ
                                %mi r
                          %mo{:stretchy => "false"} (
                          %mi α
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          \\tau_{\Sigma_r}(d \alpha) \;=\; ((-)\vert_{\partial \Sigma})^\ast \tau_{\partial \Sigma_r}( \alpha)
                %li
                  %p
                    Transgression intertwines, up to a sign, the
                    %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi δ
                        %annotation{:encoding => "application/x-tex"} \delta
                    on variational differential forms with the plain de Rham differential on the space of field histories:
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
