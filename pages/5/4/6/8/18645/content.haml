                = succeed ")." do
                  %a.maruku-ref{:href => "#ShellForSpacetimeIndependentLagrangians"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mo ×
