                            %mi k
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi T
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mrow
