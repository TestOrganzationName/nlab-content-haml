                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi exp
                      %mrow
                        %mo (
                        %munder
                          %mo ∫
                          %mrow
                            %mi Σ
                            %mo ×
                            %mi Σ
                        %msubsup
                          %mi Δ
                          %mi F
                          %mrow
                            %mi a
                            %mi b
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mfrac
                          %mi δ
                          %mrow
                            %mi δ
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi Φ
