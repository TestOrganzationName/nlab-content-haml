              does not in general exist, it may be “regularized” by applying suitable
              %a.existingWikiWord{:href => "/nlab/show/interaction+vertex+redefinitions"} interaction vertex redefinitions
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒵
                        %mi Λ
                    %annotation{:encoding => "application/x-tex"} \mathcal{Z}_\Lambda
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/counterterms"} counter
              %a.maruku-ref{:href => "#TermCounter"}
              below) the coresponding UV-divergences.
            %p
              This perspective of
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization via
              via
              %em
                %a.existingWikiWord{:href => "/nlab/show/counterterms"} counterterms
              is often regarded as the primary one. Its elegant proof in prop.
              %a.maruku-ref{:href => "#UVRegularization"}
              below, however relies on the
              %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser renormalization
              via inductive
              %a.existingWikiWord{:href => "/nlab/show/extensions+of+distributions"} extensions of distributions
              and uses the same kind of argument as in the proof of the
              %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
              (theorem
              %a.maruku-ref{:href => "#PerturbativeRenormalizationMainTheorem"}
              via prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#AnyTwoSMatrixRenormalizationSchemesDifferByAUniqueVertexRedefinition"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/St%C3%BCckelberg-Petermann+renormalization+group"} Stückelberg-Petermann renormalization group
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            #CutoffsUVForPerturbativeQFT.num_defn
              %h6#definition_5 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/UV+cutoffs"}> UV cutoffs
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
