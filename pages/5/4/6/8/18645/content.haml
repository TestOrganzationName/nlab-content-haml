                        %annotation{:encoding => "application/x-tex"} O_1, O_2 \in LocObs(E_{\text{BV-BRST}})[ [\hbar, h, j] ]\langle g , j\rangle
                    we have
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo (
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                            %mi supp
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi O
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo ∨
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mo ∧
                            %mi supp
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi O
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                            %mo )
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo ⇒
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mrow
                            %mo (
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                            %mi 𝒮
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi O
                              %mn 1
                            %mo +
                            %msub
                              %mi O
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi 𝒮
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi O
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mi 𝒮
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi O
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                              %mrow
