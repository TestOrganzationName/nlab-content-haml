                    %annotation{:encoding => "application/x-tex"}
                      \\Delta_{\pm} \in \mathcal{D}(\mathbb{R}^{p,1} \times \mathbb{R}^{p,1})
              %p
                such that, in the notation of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+functions"} generalized functions
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
