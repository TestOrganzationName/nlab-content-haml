                                  %mn 2
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi α
                                  %mn 2
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %msub
                                      %mi a
                                      %mn 2
