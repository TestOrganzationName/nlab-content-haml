                                        %mi ℝ
                                        %mrow
                                          %msub
                                            %mi n
                                            %mn 1
                                      %mo{:stretchy => "false"} )
                                    %mtd
                                    %mtd
                                      %munder
                                        %mo ⟵
                                        %mrow
                                          %mo{:stretchy => "false"} (
                                          %mi g
                                          %mo ∘
                                          %mi f
