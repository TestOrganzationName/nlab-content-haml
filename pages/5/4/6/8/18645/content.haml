                      \&amp; \frac{\partial}{\partial x^\mu} F^{\mu \nu} = 0
                      \\\
                      \\Leftrightarrow\;\;  &amp;
                      d \star_\eta F = 0
                      \\end{aligned}
                      \\,,
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %mi d
                      %mi A
                    %annotation{:encoding => "application/x-tex"} F = d A
                is the
                %a.existingWikiWord{:href => "/nlab/show/Faraday+tensor"} Faraday tensor
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:TensorFaraday"} (20)
                = succeed "\u201D" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ⋆
                          %mi η
                      %annotation{:encoding => "application/x-tex"} \star_\eta
                %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
                induced by the
                %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"} pseudo-Riemannian metric
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                on
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %p
                These
                %a.existingWikiWord{:href => "/nlab/show/PDEs"} PDEs
                are called the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
                    %a.existingWikiWord{:href => "/nlab/show/Maxwell%27s+equations"} Maxwell's equations
              %p
                This, too, is a
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
                according to def.
                = succeed "." do
                  %a.maruku-ref{:href => "#FreeFieldTheory"}
            #EquationOfMotionOfDiracFieldIsDiracEquation.num_example
              %h6#example_19 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
                  of
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
                  is
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Dirac+equation"} Dirac equation
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                of the
                %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
                on
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                from example
                = succeed "," do
                  %a.maruku-ref{:href => "#LagrangianDensityForDiracField"}
                %a.existingWikiWord{:href => "/nlab/show/field+fiber"} field fiber
                the
                %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                regarded as a
                %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mi odd
                    %annotation{:encoding => "application/x-tex"} S_{odd}
                and
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                given by the spinor bilinear pairing
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi i
                      %mover
                        %mi ψ
                        %mo ¯
                      %msup
                        %mi γ
                        %mi μ
                      %msub
                        %mo ∂
                        %mi μ
                      %mi ψ
                      %mo +
                      %mi m
                      %mover
                        %mi ψ
                        %mo ¯
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"}
                      L
                      \\;=\;
                      i \overline{\psi} \gamma^\mu \partial_\mu \psi + m \overline{\psi}\psi
              %p
                (in spacetime dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 3
                      %mo ,
                      %mn 4
                      %mo ,
                      %mn 6
                      %mo ,
                      %mn 10
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} p+1 \in \{3,4,6,10\}
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} m = 0
                unless
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo =
                        %mn 4
                      %annotation{:encoding => "application/x-tex"} p+1 = 4
              %p
                By example
                %a.maruku-ref{:href => "#PresymplecticCurrentDiracField"}
                the
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+derivative"} Euler-Lagrange
                %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
                %a.maruku-eqref{:href => "#eq:DifferentialOperatorEulerLagrangeDerivative"} (66)
                for the
                %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
                is of the form
              #eq:DiracOperatorAsELOperator.maruku-equation
                %span.maruku-eq-number (72)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Γ
                                %mi Σ
                              %mo{:stretchy => "false"} (
                              %mi Σ
                              %mo ×
                              %mi S
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                            %mtd
                              %msub
                                %mi Γ
                                %mi Σ
                              %mo{:stretchy => "false"} (
                              %mi Σ
                              %mo ×
                              %msup
                                %mi S
                                %mo *
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi Ψ
                            %mtd
                              %mo ↦
                            %mtd
                              %mover
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                %mo ¯
                              %mi D
                              %mi ψ
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\Gamma_\Sigma(\Sigma \times S)
                      \&amp;\overset{  }{\longrightarrow}&amp;
                      \\Gamma_\Sigma(\Sigma \times S^\ast)
                      \\\
                      \\Psi &amp;\mapsto&amp; \overline{(-)} D \psi
                      }
              %p
                so that the corresponding
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange
                %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EulerLagrangeEquationsOnTrivialVectorFieldBundleOverMinkowskiSpacetime"}
              #eq:DiracEquation.maruku-equation
                %span.maruku-eq-number (73)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %munder
                          %mrow
                            %mo (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi i
                            %msup
                              %mi γ
                              %mi μ
                            %msub
                              %mo ∂
                              %mi μ
                            %mo +
                            %mi m
                            %mo )
                          %mo ⏟
                        %mi D
                      %mi ψ
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\underset{D}{
                      \\underbrace{
                      \\left(-i \gamma^\mu \partial_\mu + m\right)
                      }}
                      \\psi \;=\; 0
                      \\,.
              %p
                This is the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+equation"} Dirac equation
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                is called a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Feynman+slash+notation"} Feynman slash notation
                from
                %a.maruku-eqref{:href => "#eq:FeynmanSlashNotationForMasslessDiracOperator"} (16)
                the corresponding
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
                reads
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi i
                        %mo ∂
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} /
                        %mspace{:width => "thinmathspace"}
                        %mo +
                        %mi m
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      D
                      \\;=\;
                      \\left(
                      \- i \partial\!\!\!/\, + m
                      \\right)
                      \\,.
              %p
                Hence this is a
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
                according to def.
                = succeed "." do
                  %a.maruku-ref{:href => "#FreeFieldTheory"}
              %p
                Observe that the “square” of the
                %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
                is the
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo □
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mi m
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \Box - m^2
                %a.maruku-eqref{:href => "#eq:KleinGordonEquation"} (69)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mrow
                                %mo (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mi i
                                %msup
                                  %mi γ
                                  %mi μ
                                %msub
                                  %mo ∂
                                  %mi μ
                                %mo +
                                %mi m
                                %mo )
                              %mrow
                                %mo (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %msup
                                  %mi γ
                                  %mi μ
                                %msub
                                  %mo ∂
                                  %mi μ
                                %mo +
                                %mi m
                                %mo )
                              %mi ψ
                            %mtd
                              %mo =
                              %mrow
                                %mo (
                                %msub
                                  %mo ∂
                                  %mi μ
                                %msup
                                  %mo ∂
                                  %mi μ
                                %mo −
                                %msup
                                  %mi m
                                  %mn 2
                                %mo )
                              %mi ψ
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mrow
                                %mo (
                                %mo □
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msup
                                  %mi m
                                  %mn 2
                                %mo )
                              %mi ψ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\left(
                      +i \gamma^\mu \partial_\mu + m
                      \\right)
                      \\left(-i \gamma^\mu \partial_\mu + m\right)\psi
                      \&amp;
                      \=
                      \\left(\partial_\mu \partial^\mu - m^2\right) \psi
                      \\\
                      \&amp; =
                      \\left(\Box - m^2\right) \psi
                      \\end{aligned}
                      \\,.
              %p
                This means that a
                %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
                which solves the
                %a.existingWikiWord{:href => "/nlab/show/Dirac+equations"} Dirac equations
                is in particular (on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %a.existingWikiWord{:href => "/nlab/show/solution"} solution
                to the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
            #SupergeometricNatureOfDiracEquation.num_prop
              %h6#remark_7 Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometric
                  nature of the
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+equation"} Dirac equation
                  as an
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange equation
              %p
                While the
                %a.existingWikiWord{:href => "/nlab/show/Dirac+equation"} Dirac equation
                %a.maruku-eqref{:href => "#eq:DiracEquation"} (73)
                of example
                %a.maruku-ref{:href => "#EquationOfMotionOfDiracFieldIsDiracEquation"}
                would make sense in itself also if the field coordinates
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
                and jet coordinates
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ψ
                        %mrow
                          %mo ,
                          %mi μ
                    %annotation{:encoding => "application/x-tex"} \psi_{,\mu}
                of the
                %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
                were not anti-commuting
                = succeed "," do
                  %a.maruku-eqref{:href => "#eq:DiracFieldJetCoordinatesAnticommute"} (46)
                %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometric
                nature (remark
                = succeed ")," do
                  %a.maruku-ref{:href => "#DiracFieldSupergeometric"}
                = succeed "," do
                  %a.maruku-ref{:href => "#LagrangianDensityOfDiracFieldSupergeometricNature"}
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange equation
                of a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            #DiracOperatorOnDiracSpinorsIsFormallySelfAdjointDifferentialOperator.num_example
              %h6#example_20 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
                  on
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+spinors"} Dirac spinors
                  is
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/formally+self-adjoint+differential+operator"} formally self-adjoint differential operator
              %p
                The
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"}> Dirac operator
                  , hence the
                  %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
                  corresponding to the
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+equation"} Dirac equation
                  of example
                  %a.maruku-ref{:href => "#EquationOfMotionOfDiracFieldIsDiracEquation"}
                  via def.
                  %a.maruku-ref{:href => "#DifferentialOperator"}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/formally+self-adjoint+differential+operator"} formally anti-self adjoint
                  (def.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mo *
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi D
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      D^\ast = - D
                      \\,.
            .proof
              %h6#proof_10 Proof
              %p
                By
                %a.maruku-eqref{:href => "#eq:DiracOperatorAsELOperator"} (72)
                we are to regard the Dirac operator as taking values in the
                %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual
                %a.existingWikiWord{:href => "/nlab/show/spin+bundle"} spin bundle
                by using the
                %a.existingWikiWord{:href => "/nlab/show/Dirac+conjugate"} Dirac conjugate
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{(-)}
                = succeed ":" do
                  %a.maruku-eqref{:href => "#eq:DiracConjugate"} (14)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Γ
                                %mi Σ
                              %mo{:stretchy => "false"} (
                              %mi Σ
                              %mo ×
                              %mi S
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                            %mtd
                              %msub
                                %mi Γ
                                %mi Σ
                              %mo{:stretchy => "false"} (
                              %mi Σ
                              %mo ×
                              %msup
                                %mi S
                                %mo *
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi Ψ
                            %mtd
                              %mo ↦
                            %mtd
                              %mover
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                %mo ¯
                              %mi D
                              %mi Ψ
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\Gamma_\Sigma(\Sigma \times S)
                      \&amp;\overset{}{\longrightarrow}&amp;
                      \\Gamma_\Sigma(\Sigma \times S^\ast)
                      \\\
                      \\Psi &amp;\mapsto&amp; \overline{(-)} D \Psi
                      }
              %p
                Then we need to show that there is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K(-,-)
                such that for all
                %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                of
                %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
                %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ψ
                        %mn 1
                      %mo ,
                      %msub
                        %mi Ψ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \Psi_1, \Psi_2
                we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %msub
                            %mi Ψ
                            %mn 2
                        %mo ¯
                      %msup
                        %mi γ
                        %mi μ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ∂
                        %mi μ
                      %msub
                        %mi Ψ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mover
                        %mrow
                          %msub
                            %mi Ψ
                            %mn 1
                        %mo ¯
                      %msup
                        %mi γ
                        %mi μ
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo ∂
                        %mi μ
                      %msub
                        %mi Ψ
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi d
                      %mi K
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ψ
                        %mn 1
                      %mo ,
                      %msub
                        %mi ψ
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\overline{\Psi_2}\gamma^\mu (\partial_\mu \Psi_1)
                      \-
                      \\overline{\Psi_1}\gamma^\mu (-\partial_\mu \Psi_2)
                      \\;=\;
                      d K(\psi_1, \psi_2)
                      \\,.
              %p
                But the spinor-to-vector pairing is symmetric
                = succeed "," do
                  %a.maruku-eqref{:href => "#eq:SpinorToVectorPairingIsSymmetric"} (12)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
