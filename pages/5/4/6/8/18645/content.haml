                                %mo{:stretchy => "false"} )
                              %mo ⏟
                            %mrow
                              %mi deg
                              %mo =
                              %mn 0
                          %mo ⊕
                          %munder
                            %munder
                              %mrow
                                %msup
                                  %mi C
                                  %mn ∞
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                                %mo ⊗
                                %msup
                                  %mi 𝔤
                                  %mo *
                              %mo ⏟
                            %mrow
                              %mi deg
                              %mo =
                              %mn 1
                          %mo ⊕
                          %munder
                            %munder
                              %mrow
                                %msup
