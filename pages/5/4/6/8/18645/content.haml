                      \&amp;
                      \\left(
                      \\phi^a
                      \\right)
                      \&amp;
                      \\\
                      deg = &amp;
                      \&amp;
                      \-1
                      \&amp;
                      0
                      \&amp;
                      \\end{aligned}
              %p
                and
                %a.existingWikiWord{:href => "/nlab/show/differential"} differential
                given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mi d
                                %mrow
                                  %mi CE
                                  %mrow
                                    %mo (
                                    %msub
                                      %mi X
                                      %mrow
                                        %mi d
                                        %mi S
                                        %mo ≃
                                        %mn 0
                                    %mo )
                          %mtr
                            %mtd
                              %msup
                                %mi ϕ
                                %mi a
                            %mtd
                              %mo ↦
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %msubsup
                                %mi ϕ
                                %mi a
                                %mo ‡
                            %mtd
                              %mo ↦
                            %mtd
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi S
                                %mrow
                                  %mo ∂
                                  %msup
                                    %mi ϕ
                                    %mi a
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp; d_{CE\left( X_{d S \simeq 0} \right)}
                      \\\
                      \\phi^a &amp;\mapsto&amp; 0
                      \\\
                      \\phi^\ddagger_a &amp;\mapsto&amp; \frac{\partial S}{\partial \phi^a}
                      }
                      \\,.
              %p
                Hence the
                %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
                of the
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                of the derived critical locus indegree 0 is the
                %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(X)
                by the ideal which is generated by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mfrac
                          %mrow
                            %mo ∂
                            %mi S
                          %mrow
                            %mo ∂
                            %msup
                              %mi ϕ
                              %mi a
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \left( \frac{\partial S}{\partial \phi^a} \right)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 0
                      %mrow
                        %mo (
                        %mi CE
                        %mrow
                          %mo (
                          %msub
                            %mi X
                            %mrow
                              %mi d
                              %mi S
                              %mo ≃
                              %mn 0
                          %mo )
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mrow
                        %mo (
                        %mfrac
                          %mrow
                            %mo ∂
                            %mi S
                          %mrow
                            %mo ∂
                            %msup
                              %mi ϕ
                              %mi a
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      H^0\left(
                      CE\left( X_{d S \simeq 0}  \right)
                      \\right)
                      \\;=\;
                      C^\infty(X)/\left( \frac{\partial S}{\partial \phi^a} \right)
                      \\,.
              %p
                But under the assumption that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a
                %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
                or
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
                of a point, this quotient algebra is just the
                %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
                on the ordinary
                %a.existingWikiWord{:href => "/nlab/show/critical+locus"} critical locus
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mrow
                            %mi d
                            %mi S
                            %mo =
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} X_{d S = 0}
              %p
                (The quotient says that every function on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                which vanishes where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi S
                        %mrow
                          %mo ∂
                          %msup
                            %mi ϕ
                            %mi a
                    %annotation{:encoding => "application/x-tex"} \frac{\partial S}{\partial \phi^a}
                vanishes is
                %a.existingWikiWord{:href => "/nlab/show/zero"} zero
                in the quotient. This means that the quotient algebra consists of the functions on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                modulo the
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                that identifies two if they agree on the critical locus
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mrow
                            %mi d
                            %mi S
                            %mo =
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} X_{d S = 0}
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mrow
                            %mi d
                            %mi S
                            %mo =
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} X_{d S = 0}
              %p
                Hence the
                %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
                yields the ordinary
                %a.existingWikiWord{:href => "/nlab/show/critical+locus"} critical locus
                in
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 0
                      %mrow
                        %mo (
                        %mi CE
                        %mrow
                          %mo (
                          %msub
                            %mi X
                            %mrow
                              %mi d
                              %mi S
                              %mo ≃
                              %mn 0
                          %mo )
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi C
                        %mn ∞
                      %mrow
                        %mo (
                        %msub
                          %mi X
                          %mrow
                            %mi d
                            %mi S
                            %mo =
                            %mn 0
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      H^0\left(
                      CE\left( X_{d S \simeq 0} \right)
                      \\right)
                      \\;\simeq\;
                      C^\infty\left( X_{d S = 0} \right)
                      \\,.
              %p
                However, it is not in general the case that the
                %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
                is a
                %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
                of the ordinary
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/critical+locus"} critical locus
                %a.existingWikiWord{:href => "/nlab/show/negative+number"} negative
                degree vanishes. Instead, the cohomology of the
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                of a
                %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
                in
                %a.existingWikiWord{:href => "/nlab/show/negative+number"} negative
                degree detects
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
                and more generally
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+action"} L-∞ algebra action
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                under which
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is invariant. If this action is incorporated into
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                by passing to the
                %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} X/\mathfrak{g}
                and then forming the
                %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi 𝔤
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi d
                          %mi S
                          %mo ≃
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} (X/\mathfrak{g})_{d S \simeq 0}
                in there, as in example
                = succeed "." do
                  %a.maruku-ref{:href => "#ArchetypeOfBVBRSTComplex"}
              %p
                This issue we discuss in detail in the chapter
                = succeed "," do
                  %em
                    %a{:href => "#GaugeFixing"} Gauge fixing
                %a.maruku-ref{:href => "#BVComplexIsHomologicalResolutionPreciselyIfNoNonTrivialImplicitGaugeSymmetres"}
                below.
            %p
              In order to generalize the statement of example
              %a.maruku-ref{:href => "#OrdinaryCriticalLocusAsCohomologyOfDerivedCriticalLocus"}
              to the case that a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              is taken into account, we need to realize the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of a
              %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
              in a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
              is the
              %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
              of a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
            #DerivedCriticalLocusOfActionLiAlgebroidBicomplexStructure.num_prop
              %h6#proposition_2 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                  of
                  %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
                  is
                  %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
                  of
                  %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/bicomplex"} bicomplex
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi 𝔤
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi d
                          %mi S
                          %mo ≃
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} (X/\mathfrak{g})_{d S \simeq 0}
                be a
                %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
                inside an
                %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
                as in example
                = succeed "." do
                  %a.maruku-ref{:href => "#ArchetypeOfBVBRSTComplex"}
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+differential"} Chevalley-Eilenberg differential
                %a.maruku-eqref{:href => "#eq:ExplicitCEDifferentialInCotangentBundleOfActionLieAlgebroid"} (183)
                may be decomposed as the sum of two anti-commuting differential
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mrow
                            %mo (
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi 𝔤
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi d
                                %mi S
                                %mo ≃
                                %mn 0
                            %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi s
                        %mi BRST
                      %mo +
                      %msub
                        %mi s
                        %mi BS
                    %annotation{:encoding => "application/x-tex"}
                      d_{CE\left( (X/\mathfrak{g})_{d S \simeq 0}  \right)}
                      \\;=\;
                      s_{BRST} +  s_{BS}
              %p
                which are defined on the generators of the
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                as follows:
              #eq:ExplicitBVandBRSTDifferentialInCotangentBundleOfActionLieAlgebroid.maruku-equation
                %span.maruku-eq-number (184)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
