                        %mo{:stretchy => "false"} [
                        %mi ℏ
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} 1 \in C^\infty(V) \hookrightarrow C^\infty(V)[ [ \hbar ] ]
              %p
                Hence the
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
