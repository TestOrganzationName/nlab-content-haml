                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi r
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi σ
                                  %mo ∈
                                  %mi Unshuffl
                                  %mo{:stretchy => "false"} (
                                  %mi k
                                  %mo ,
                                  %mi r
                                  %mo{:stretchy => "false"} )
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mi T
                              %mo{:stretchy => "false"} (
