                        %mo =
                        %mtext not really!
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %munder
                        %mo ∫
                        %mrow
                          %mi Φ
                          %mo ∈
                          %msub
                            %mi Γ
                            %mi Σ
                          %mo{:stretchy => "false"} (
                          %msub
