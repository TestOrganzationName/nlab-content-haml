              see also
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+smooth+sets"} geometry of physics – smooth sets
            #SmoothManifoldsAreDiffeologicalSpaces.num_example
              %h6#example_7 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                  are
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DiffeologicalSpace"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo ∈
                      %mi X
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Phi \in X(\mathbb{R}^n)
                to the ordinary
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Φ
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi ℝ
                          %mi n
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \Phi \colon \mathbb{R}^n \to X
              %p
                Under this identification, a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi s
                      %mo →
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi s
                    %annotation{:encoding => "application/x-tex"} f \;\colon\; (X_1)_s \to (X_2)_s
                between the underlying sets of two
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                is a
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                in the ordinary sense precisely if it is a smooth function in the sense of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
              %p
                Stated more
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/category+theory"} abstractly
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
                over a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/subcanonical+site"} subcanonical site
              %p
                More generally, the same construction makes every
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
            #DiffeologicalSpaceOfFieldHistories.num_example
              %h6#example_8 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi fb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                be a smooth
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
                of
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
                %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DiffeologicalSpace"}
              #eq:SpaceOfFieldHistories.maruku-equation
                %span.maruku-eq-number (22)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi DiffeologicalSpaces
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma_\Sigma(E) \in DiffeologicalSpaces
              %p
                by declaring that a smooth family
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
                of field histories, parameterized over any
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                is a smooth function out of the
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                manifold of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi U
                              %mo ×
                              %mi Σ
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi Φ
                                    %mrow
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi E
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi u
                              %mo ,
                              %mi x
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ↦
                            %mtd
                              %msub
                                %mi Φ
                                %mi u
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      U \times \Sigma &amp;\overset{\Phi_{(-)}(-)}{\longrightarrow}&amp; E
                      \\\
                      (u,x) &amp;\mapsto&amp; \Phi_u(x)
                      }
              %p
                such that for each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} u \in U
                we have
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ∘
                        %msub
                          %mi Φ
                          %mi u
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi id
                          %mi Σ
                      %annotation{:encoding => "application/x-tex"} p \circ \Phi_{u}(-) = id_\Sigma
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi E
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi Φ
                                      %mrow
                                        %mo{:stretchy => "false"} (
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mo{:stretchy => "false"} )
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                              %mo ↗
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi fb
                          %mtr
                            %mtd
                              %mi U
                              %mo ×
                              %mi Σ
                            %mtd
                              %munder
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi pr
                                    %mn 2
                            %mtd
                              %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; E
                      \\\
                      \&amp; {}^{\mathllap{\Phi_{(-)}(-)}}\nearrow &amp; \downarrow^{\mathrlap{fb}}
                      \\\
                      U \times \Sigma &amp;\underset{pr_2}{\longrightarrow}&amp; \Sigma
                      }
                      \\,.
            %p
              The following example
              %a.maruku-ref{:href => "#FrechetManifoldsAreDiffeologicalSpaces"}
              is included only for readers who wonder how
              %a.existingWikiWord{:href => "/nlab/show/infinite-dimensional+manifolds"} infinite-dimensional manifolds
              fit in. Since we will never actually use
              = succeed "-structure," do
                %a.existingWikiWord{:href => "/nlab/show/infinite-dimensional+manifold"} infinite-dimensional manifold
            #FrechetManifoldsAreDiffeologicalSpaces.num_example
              %h6#example_9 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifolds"} Fréchet manifolds
                  are
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
              %p
                Consider the particular type of
                %a.existingWikiWord{:href => "/nlab/show/infinite-dimensional+manifolds"} infinite-dimensional manifolds
                called
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifolds"} Fréchet manifolds
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                are an example, for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifold"} Fréchet manifold
                there is a concept of
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U \to X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                the structure of a
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DiffeologicalSpace"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                to be these smooth functions
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U \to X
              %p
                It turns out that then that for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                two
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifolds"} Fréchet manifolds
                %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
                between the
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \to Y
                between them regarded as
                %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifolds"} Fréchet manifolds
                and [regarded as . Hence it does not matter which of the two perspectives we take (unless of course a  more general than a  enters the picture, at which point the second definition generalizes, whereas the first does not).]
              %p
                Stated more
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/category+theory"} abstractly
                %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifolds"} Fréchet manifolds
                form a
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                of that of
                %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
                (
                %a{:href => "Fr&#233;chet+manifold#FFEmbeddingOfFrechetInDiffeological"}> this prop.
                ):
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FrechetManifolds
                      %mo ↪
                      %mi DiffeologicalSpaces
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      FrechetManifolds \hookrightarrow DiffeologicalSpaces
                      \\,.
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                is a
                %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ≃
                      %mi Σ
                      %mo ×
                      %mi F
                      %mo →
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \simeq \Sigma \times F \to \Sigma
                is a
                %a.existingWikiWord{:href => "/nlab/show/trivial+fiber+bundle"} trivial fiber bundle
                with
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
                carries a standard structure of a
                %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifold"} Fréchet manifold
                (see at
                = succeed ")." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/manifold+structure+of+mapping+spaces"} manifold structure of mapping spaces
                %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+manifolds"} Fréchet manifolds
                into
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
                %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
                agrees with that from example
                %a.maruku-ref{:href => "#DiffeologicalSpaceOfFieldHistories"}
                (see
                = succeed ")" do
                  %a{:href => "Fr&#233;chet+manifold#CompatibilityWithDiffeologicalMappingSpaces"} this prop.
            %p
              Once the step from
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              to
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DiffeologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
              of the space entirely by how we may probe it by mapping smooth Cartesian spaces into it, it becomes clear that the underlying set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi s
                  %annotation{:encoding => "application/x-tex"} X_s
              of a diffeological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is not actually crucial to support the concept: The space is already entirely defined
              %a.existingWikiWord{:href => "/nlab/show/structuralism"} structurally
              by the system of smooth plots it has, and the underlying set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi s
                  %annotation{:encoding => "application/x-tex"} X_s
              is recovered from these as the set of plots from the point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^0
            %p
              This is crucial for
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
              %a.existingWikiWord{:href => "/nlab/show/spaces+of+field+histories"} spaces of field histories
              of
              %a.existingWikiWord{:href => "/nlab/show/fermionic+fields"} fermionic fields
              (def.
              %a.maruku-ref{:href => "#FermionicBosonicFields"}
              below) such as the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              (example
              %a.maruku-ref{:href => "#DiracSpaceOfFieldHistories"}
              below) do not have underlying sets of points the way
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
              have. Informally, the reason is that a point is a
              %a.existingWikiWord{:href => "/nlab/show/bosonic"} bosonic
              object, while and the nature of
              %a.existingWikiWord{:href => "/nlab/show/fermionic+fields"} fermionic fields
              is
              %a.existingWikiWord{:href => "/nlab/show/antimodal+type"} the opposite of
              bosonic.
            %p
              But we may just as well drop the mentioning of the underlying set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi s
                  %annotation{:encoding => "application/x-tex"} X_s
              in the definition of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+spaces"} generalized smooth spaces
              %a.maruku-ref{:href => "#DiffeologicalSpace"}
              we obtain the following more general and more useful definition (still “bosonic”, though, the
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometric
              version is def.
              %a.maruku-ref{:href => "#SuperFormalSmoothSet"}
              below):
            #SmoothSet.num_defn
              %h6#definition_3 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/smooth+set"}> smooth set
                  )
              %p
                A
                %em
                  %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is
              %ol
                %li
                  %p
                    for each
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                    a choice of
                    %a.existingWikiWord{:href => "/nlab/show/set"} set
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mi n
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi Set
                        %annotation{:encoding => "application/x-tex"}
                          X(\mathbb{R}^n) \in Set
                  %p
                    to be called the set of
                    %em smooth functions
                    or
                    %em plots
                    from
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                    to
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X
                %li
                  %p
                    for each
                    %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 1
                          %mo ⟶
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 2
                        %annotation{:encoding => "application/x-tex"} f \;\colon\; \mathbb{R}^{n_1} \longrightarrow \mathbb{R}^{n_2}
                    between
                    %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                    a choice of function
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi f
                            %mo *
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %mi X
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ⟶
                          %mi X
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          f^\ast \;\colon\; X(\mathbb{R}^{n_2}) \longrightarrow X(\mathbb{R}^{n_1})
                  %p to be thought of as the precomposition operation
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo (
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                            %mover
                              %mo ⟶
                              %mi Φ
                            %mi X
                            %mo )
                          %mspace{:width => "thickmathspace"}
                          %mover
                            %mo ↦
                            %mrow
                              %msup
                                %mi f
                                %mo *
                          %mspace{:width => "thickmathspace"}
                          %mrow
                            %mo (
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mover
                              %mo →
                              %mi f
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                            %mover
                              %mo →
                              %mi Φ
                            %mi X
                            %mo )
                        %annotation{:encoding => "application/x-tex"}
                          \\left(
                          \\mathbb{R}^{n_2} \overset{\Phi}{\longrightarrow} X
                          \\right)
                          \\;\overset{f^\ast}{\mapsto}\;
                          \\left(
                          \\mathbb{R}^{n_1} \overset{f}{\to} \mathbb{R}^{n_2} \overset{\Phi}{\to} X
                          \\right)
              %p such that
              %ol
                %li
                  %p
                    (
                    %a.existingWikiWord{:href => "/nlab/show/functor"}> functoriality
                    )
                  %ol
                    %li
                      %p
                        If
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
