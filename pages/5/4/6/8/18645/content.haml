                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mi 𝒪
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                      %mi IntObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo ,
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mi int
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi 𝒪
                      %mo{:stretchy => "false"} )
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    IntObs(E_{\text{BV-BRST}}, \mathbf{L}_{int})
                    \\;\coloneqq\;
                    \\underset{\underset{\mathcal{O}}{\longrightarrow}}{\lim}
                    \\left(
                    {\, \atop \,}
                    IntObs(E_{\text{BV-BRST}}, \mathbf{L}_{int})(\mathcal{O})
                    {\, \atop \,}
                    \\right)
                    \\,.
            %p
              This is also called the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+adiabatic+limit"} algebraic adiabatic limit
              %a.existingWikiWord{:href => "/nlab/show/algebras+of+observables"} algebras of observables
              of
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              “in the infrared”. The only remaining step in the construction of a
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              that remains is then to find an
              %a.existingWikiWord{:href => "/nlab/show/interacting+vacuum+state"} interacting vacuum state
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ⟩
                      %mi int
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi IntObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\left\langle
                    \-
                    \\right\rangle_{int}
                    \\;\colon\;
                    IntObs(E_{\text{BV-BRST}}, \mathbf{L}_{int})
                    \\longrightarrow
                    \\mathbb{C}[ [ \hbar, g] ]
            %p
              on the global
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+algebra"} interacting field algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Obs
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mi int
                    %annotation{:encoding => "application/x-tex"} Obs_{\mathbf{L}_{int}}
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/adiabatic+limit"} adiabatic limit
              %a.maruku-ref{:href => "#AdiabaticLimit"}
              below.
            %p
              In conclusion so far, the
              %a.existingWikiWord{:href => "/nlab/show/algebraic+adiabatic+limit"} algebraic adiabatic limit
              yields, starting with a
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+algebras+of+observables"} interacting field algebras of observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuntumMollerOperator"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              (
              %a.existingWikiWord{:href => "/nlab/show/loop+order"}> loop order
              , prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#FeynmanDiagramLoopOrder"}
              %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#FeynmanPerturbationSeries"}
              = succeed ")." do
                %a.maruku-ref{:href => "#SMatrixVacuumContribution"}
            %p
              But this
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+algebra+of+observables"} interacting field algebra of observables
              still involves all the
              %a.existingWikiWord{:href => "/nlab/show/auxiliary+fields"} auxiliary fields
              of the
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              (as in example
              %a.maruku-ref{:href => "#FieldSpeciesQED"}
              for QED), while the actual physical
              %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariant
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              observables should be (just) the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+differential"} BV-BRST differential
              on this enlarged space of observables. Hence for the construction of
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              to conclude, it remains to pass the
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+differential"} BV-BRST differential
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              of observables to a
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              on the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+algebra"} interacting field algebra
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              is well defined.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              away from coinciding interaction points are uniquely fixed (prop.
              %a.maruku-ref{:href => "#TimeOrderedProductAwayFromDiagonal"}
              below), one finds that also this
              %em interacting quantum BV-differential
              is uniquely fixed, on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
              with the
              %a.existingWikiWord{:href => "/nlab/show/quantum+M%C3%B8ller+operators"} quantum Møller operators
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#BVDifferentialInteractingQuantum"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+master+equation"} quantum master equation
              or equivalently the
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+master+Ward+identity"} quantum master Ward identity
              (prop.
              %a.maruku-ref{:href => "#QuantumMasterEquation"}
              below).
            %p
              In its incarnation as the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/master+Ward+identity"} master Ward identity
              %a.existingWikiWord{:href => "/nlab/show/shell"} shell
              of the free classical field theory and that of the interacting quantum field theory, thus generalizing the
              %a.existingWikiWord{:href => "/nlab/show/Schwinger-Dyson+equation"} Schwinger-Dyson equation
              to
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting field theory
              (example
              %a.maruku-ref{:href => "#SchwingerDysonReductionOfQuantumMasterWardIdentity"}
              below). Applied to
              %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem
              it expresses the possible failure of
              %a.existingWikiWord{:href => "/nlab/show/conserved+currents"} conserved currents
              associated with
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries+of+the+Lagrangian"} infinitesimal symmetries of the Lagrangian
              to still be conserved in the
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              (example
              %a.maruku-ref{:href => "#NoetherCurrentConservationQuantumCorrection"}
              below).
            %p
              As one
              %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extends
              the
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              to coinciding interaction points in
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
              of the
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              (def.
              %a.maruku-ref{:href => "#ExtensionOfTimeOrderedProoductsRenormalization"}
              below), the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/quantum+master+equation"} quantum master equation
              %a.existingWikiWord{:href => "/nlab/show/master+Ward+identity"} master Ward identity
              becomes a
              %em
                %a.existingWikiWord{:href => "/nlab/show/renormalization+condition"} renormalization condition
              (prop.
              %a.maruku-ref{:href => "#BasicConditionsRenormalization"}
              below). If this condition fails one says that the
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              has a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} quantum anomaly
              %em
                %a.existingWikiWord{:href => "/nlab/show/gauge+anomaly"} gauge anomaly
              if the
              %a.existingWikiWord{:href => "/nlab/show/Ward+identity"} Ward identity
              of an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetry"} infinitesimal gauge symmetry
              is violated.
            %p
              These issues of
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} "(re)-"normalization
              we discuss in detail in the
              = succeed "." do
                %a{:href => "#Renormalization"} next chapter
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p#FreeFieldVacua
              %strong Free field vacua
            %p
              In considering
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              %a.existingWikiWord{:href => "/nlab/show/perturbation+theory"} perturbation theory
              in formal
              %a.existingWikiWord{:href => "/nlab/show/deformation"} deformation
              parameters around a fixed
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
              in a chosen
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hadamard+vacuum+state"} Hadamard vacuum state
            %p For convenient referencing we collect all the structure and notation that goes into this in the following definitions:
            #VacuumFree.num_defn
              %h6#definition Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                  %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
                  %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian
                  %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              %p Let
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                        %annotation{:encoding => "application/x-tex"} \Sigma
                    be a
                    %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                    (e.g.
                    = succeed ");" do
                      %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                    a
                    %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                    %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                    (def.
                    = succeed ")," do
                      %a.maruku-ref{:href => "#FreeFieldTheory"}
                    %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi E
                            %mover
                              %mo →
                              %mi fb
                            %mi Σ
                          %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒢
                          %mover
                            %mo →
                            %mi fb
                          %mi Σ
                        %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{fb}{\to} \Sigma
                    a
                    %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundle"} gauge parameter bundle
                    for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
                    (def.
                    = succeed ")," do
                      %a.maruku-ref{:href => "#GaugeParameters"}
                    = succeed "-" do
                      %a.existingWikiWord{:href => "/nlab/show/BRST-complex"} BRST
                    %a.existingWikiWord{:href => "/nlab/show/reduced+phase+space"} reduced
                    %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo (
                            %mi E
                            %msub
                              %mo ×
                              %mi Σ
                            %mi 𝒢
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mo −
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi L
                              %mi BRST
                            %mo )
                        %annotation{:encoding => "application/x-tex"} \left( E \times_\Sigma \mathcal{G}[1], \mathbf{L} - \mathbf{L}_{BRST}\right)
                    (example
                    = succeed ");" do
                      %a.maruku-ref{:href => "#LocalOffShellBRSTComplex"}
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi E
                            %mtext BV-BRST
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %mo ′
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mstyle{:mathvariant => "bold"}
                            %mi L
                          %msub
                            %mo ′
                            %mi BRST
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}' - \mathbf{L}'_{BRST})
                    a
                    %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixing
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#GaugeFixingLagrangianDensity"}
                    %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded
                    %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST
                    %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
