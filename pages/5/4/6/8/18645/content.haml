                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;
                      \\left(
                      c^\ddagger_{\alpha}
                      \\right)
                      \&amp;
                      \\left(
                      \\phi^\ddagger_a
                      \\right)
                      \&amp;
                      \\left(
                      \\phi^a
                      \\right)
                      \&amp;
                      \\left(
                      c^\alpha
                      \\right)
                      \\\
                      deg_{gh} =
                      \&amp;
                      0
                      \&amp;
                      0
                      \&amp;
                      0
                      \&amp;
                      +1
                      \\\
                      deg_{af} =
                      \&amp;
