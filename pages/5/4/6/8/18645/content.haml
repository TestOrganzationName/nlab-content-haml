                          %mo ⋆
                          %mover
                            %mi g
                            %mo ^
                        %annotation{:encoding => "application/x-tex"}
                          \\widehat {(f \star g)} = \widehat{f} \cdot \widehat{g}
                          \\phantom{AAAA}
                          \\widehat{ f \cdot g } = (2\pi)^{-n} \widehat{f} \star \widehat{g}
                %li
                  %p
                    (
                    %a.existingWikiWord{:href => "/nlab/show/unitary+operator"}> unitarity
                    ,
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/Parseval%27s+theorem"} Parseval's theorem
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ∫
