                      \\;=\;
                      \\underset{n \leq N}{\sum}
                      D^{\mu_1 \cdots \mu_n}
                      \\frac{\partial}{\partial x^{\mu^1}}
                      \\cdots
                      \\frac{\partial}{\partial x^{\mu^n}}
                      +
                      D^0
              %p
                be a
                %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#DifferentialOperator"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/symbol+of+a+differential+operator"} symbol of a differential operator
                is the
