                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi deg
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mi u
                          %mo{:stretchy => "false"} )
                          %mo ≤
                          %mi deg
                          %mo{:stretchy => "false"} (
