              %p
                is a corresponding set of
                %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
                on
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                (
                %a.existingWikiWord{:href => "/nlab/show/adiabatic+switchings"}> adiabatic switchings
                ), so that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo {
                        %msub
                          %mi S
                          %mi j
                        %mo{:lspace => "verythinmathspace"} :
                        %mi Φ
                        %mo ↦
                        %munder
                          %mo ∫
                          %mi Σ
                        %msub
                          %mi g
                          %mi i
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mrow
                          %mo (
                          %msubsup
                            %mi j
