                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"}
                          \\nu \coloneqq {\vert V\vert} \in \mathbb{N}
                  %p
                    (the number of
                    = succeed ");" do
                      %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
                %li
                  %p
                    for each
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
