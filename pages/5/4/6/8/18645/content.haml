                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} (e_1)^2 = -1
                  \.
            #TheQuaternions.num_defn
              %h6#definition_2 Definition
              %p
                %strong
