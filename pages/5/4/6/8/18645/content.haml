                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mi odd
                      %annotation{:encoding => "application/x-tex"} S_{odd}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
