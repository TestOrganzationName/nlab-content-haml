                    %td{:style => "text-align: left;"}
                    %td{:style => "text-align: left;"}
                      %math#mathml_0c965b27b918c973b0d6a80ade615bbc435d8f77_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
