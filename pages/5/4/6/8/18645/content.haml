                      \\cdots
                      \=
                      \\underset{k \in \mathbb{N}}{\sum}
                      \\tfrac{1}{k!}
                      \\underoverset{r = 1}{k}{\sum}
                      (-1)^r
                      \\!\!\!
                      \\underset{ {\sigma \in \Sigma(k)} \atop { { k_1 + \cdots + k_r = k } \atop { \underset{i}{\forall} (k_i \geq 1) } } }{\sum}
                      \\!\!\!
                      \\tfrac{1}{k_1!} \cdots \tfrac{1}{k_r !}
                      \\,
