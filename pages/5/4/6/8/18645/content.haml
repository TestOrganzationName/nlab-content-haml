                                %mi I
                                %mo ¯
                              %mo ≠
                              %mi ∅
                      %msub
                        %mi χ
                        %mi i
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} )
