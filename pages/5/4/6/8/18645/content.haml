            #DualVectorBundle.num_defn
              %h6#definition_8 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"}> dual vector bundle
                  )
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi vb
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} E \overset{vb}{\to} \Sigma
                a
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#VectorBundle"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual vector bundle
                is the vector bundle whose
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                %a.maruku-eqref{:href => "#eq:FiberOfAFiberBundle"} (2)
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi Σ
