                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)_{conn} \to \mathbf{B}U(1)_{diff}
              as indicated.
            %p
              The corresponding total map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mn 1
                      %mi dR
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c_1^{dR}(g)
              represented by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mn 1
                      %mi dR
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c_1^{dR}(\nabla)
              is the cocycle for the
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              2-form of this connection. This represents the first
              %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
              of the bundle in de Rham cohomology.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi A
                %annotation{:encoding => "application/x-tex"} X,A
            smooth 2-groupoids, write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,A)
            for the 2-groupoid of 2-anafunctors between them.
          .num_remark
            %h6#corollary_2 Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
