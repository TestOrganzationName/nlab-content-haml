                    \\\
                    C(V) &amp;\stackrel{}{\to}&amp; \mathbf{B} U(1)_{diff} &amp;\to&amp; \mathbf{\flat}_{dR} \mathbf{B}^2 U(1)
                    \\\
                    \\downarrow^{\mathrlap{\simeq}} &amp;&amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    C(U) &amp;\stackrel{g}{\to}&amp; \mathbf{B}U(1)
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    X
                    }
                    \\,.
            %p
              If we take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              to be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mi U
                    %annotation{:encoding => "application/x-tex"} V = U
              %a.existingWikiWord{:href => "/nlab/show/pseudo-connection"} pseudo-connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
