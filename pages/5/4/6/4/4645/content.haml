                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mi ⋯
                    %mo +
                    %msub
                      %mi ι
                      %mi s
                    %msub
                      %mi F
                      %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{d}{d s} A_U
                    \=
                    d_U \lambda + [\lambda \wedge A] + [\lambda \wedge A \wedge A] + \cdots
                    +
                    \\iota_s F_A
                    \\,,
            %p
              where the sum is over all higher brackets of the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/Cartan+calculus"} Cartan calculus
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            an ordinary
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            one writes the corresponding
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} second Ehremsnn condition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mrow
                      %msub
                        %mo ∂
                        %mi s
                  %msub
                    %mi F
                    %mi A
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \iota_{\partial_s} F_A = 0
            equivalently
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mrow
                      %msub
                        %mo ∂
                        %mi s
                  %mi A
                  %mo =
                  %msub
                    %mi ad
                    %mi λ
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{L}_{\partial_s} A = ad_\lambda A
                  \\,.
          .num_defn
            %h6#definition_23 Definition
            %p
              Define the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
                of the gauge parameter
              to be
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mi λ
                    %mo :
                    %mo =
                    %mi d
                    %mi λ
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ∧
                    %mi λ
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ∧
                    %mi A
                    %mo ∧
                    %mi λ
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla \lambda := d \lambda + [A \wedge \lambda] + [A \wedge A \wedge \lambda] + \cdots
                    \\,.
          %p In this notation we have
          %ul
            %li
              %p the general identity
              #eq:ShiftedGaugeTrafo.maruku-equation
                %span.maruku-eq-number (1)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mi d
                        %mrow
                          %mi d
                          %mi s
                      %msub
                        %mi A
                        %mi U
                      %mo =
                      %mo ∇
                      %mi λ
                      %mo +
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mi A
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi s
                    %annotation{:encoding => "application/x-tex"}
                      \\frac{d}{d s} A_U = \nabla \lambda + (F_A)_s
            %li
              %p
                the
                %strong horizontality
                or
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/rheonomy"} rheonomy
                constraint or
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} second Ehresmann condition
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ι
                          %mrow
                            %msub
                              %mo ∂
                              %mi s
                        %msub
                          %mi F
                          %mi A
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \iota_{\partial_s} F_A = 0
                %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              #eq:GaugeTrafo.maruku-equation
                %span.maruku-eq-number (2)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mi d
                        %mrow
                          %mi d
                          %mi s
                      %msub
                        %mi A
                        %mi U
                      %mo =
                      %mo ∇
                      %mi λ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\frac{d}{d s} A_U = \nabla \lambda
                      
                      \\,.
          %p
            This is known as the equation for
            %strong
              infinitesimal
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            of an
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .num_lemma
            %h6#observation_13 Observation
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi vert
                  %annotation{:encoding => "application/x-tex"} A_{vert}
              – and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              – defines an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\lambda)
              in the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+group"} ∞-Lie group
              that integrates
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %p
              The unique solution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi U
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_U(s = 1)
              of the above
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} s = 1
              for the initial values
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi U
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_U(s = 0)
              we may think of as the result of acting on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi U
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_U(0)
              with the gauge transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi λ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp(\lambda)
          %h5#examples_3 Examples
          .num_prop
            %h6#proposition_12 Proposition
            %p
              %strong (connections on ordinary bundles)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              with simply connected
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
              the
              %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie+algebra-valued+forms"} groupoid of Lie algebra-valued forms
              we have an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 1
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_1 \exp(\mathfrak{g})_{conn} = \mathbf{B}G_{conn}
          .proof
            %h6#proof_2 Proof
            %p
              To see this, first note that the sheaves of objects on both sides are manifestly isomorphic, both are the sheaf of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^1(-,\mathfrak{g})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Omega^\bullet(U \times \Delta^1) \leftarrow W(\mathfrak{g}) : A
              which we may decompose into a horizontal and a verical pice as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi A
                      %mi U
                    %mo +
                    %mi λ
                    %mo ∧
                    %mi d
                    %mi t
                  %annotation{:encoding => "application/x-tex"} A = A_U + \lambda \wedge d t
              the condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi t
                    %msub
                      %mi F
                      %mi A
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \iota_{\partial_t} F_A = 0
              is equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi t
                    %mi A
                    %mo =
                    %msub
                      %mi d
                      %mi U
                    %mi λ
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi λ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\partial}{\partial t} A
                    \=
                    d_U \lambda + [\lambda, A]
                    \\,.
            %p
              For any initial value
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(0)
              this has the unique solution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi t
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo +
                    %msub
                      %mi d
                      %mi U
                    %mo{:stretchy => "false"} )
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A(t) = g(t)^{-1} (A + d_{U}) g(t)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g : [0,1] \to G
              is the
              %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                          %mtd
                            %mfrac
                              %mo ∂
                              %mrow
                                %mo ∂
                                %mi t
                            %mrow
                              %mo (
                              %msub
                                %mi g
                                %mo{:stretchy => "false"} (
                              %mi t
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mo +
                              %msub
                                %mi d
                                %mi U
                              %mo{:stretchy => "false"} )
                              %mi g
                              %mo{:stretchy => "false"} (
                              %mi t
                              %mo{:stretchy => "false"} )
                              %mo )
                        %mtr
                          %mtd
                            %mo =
                          %mtd
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi t
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo +
                            %msub
                              %mi d
                              %mi U
                            %mo{:stretchy => "false"} )
                            %mi λ
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi t
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi λ
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo +
                            %msub
                              %mi d
                              %mi U
                            %mo{:stretchy => "false"} )
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \&amp;
                    \\frac{\partial}{\partial t}
                    \\left(
                    g_(t)^{-1} (A + d_{U}) g(t)
                    \\right)
                    \\\
                    \= &amp;
                    g(t)^{-1} (A + d_{U}) \lambda g(t)
                    \-
                    g(t)^{-1} \lambda (A + d_{U}) g(t)
                    \\end{aligned}
            %p
              (where for ease of notaton we write actions as if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              were a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/matrix+Lie+group"} matrix Lie group
            %p
              In particular this implies that the endpoints of the path of
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo +
                    %msub
                      %mi d
                      %mi U
                    %mo{:stretchy => "false"} )
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A(1) = g(1)^{-1} (A + d_U) g(1)
                    \\,.
            %p
              In the same fashion one sees that given 2-cell in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})(U)
              and any 1-form on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              at one vertex, there is a unique lift to a 2-cell in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{conn}
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mn 1
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mstyle{:mathvariant => "bold"}
