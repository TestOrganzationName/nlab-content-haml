                    %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(N)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/matrix+Lie+group"} matrix Lie group
              %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
              function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mo :
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    det : U(N) \to U(1)
            %p
              and by the standard properties of the determinant, this is in fact a group homomorphism. Therefore this has a
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              to a morphism of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi det
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}det : \mathbf{B}U(N) \to \mathbf{B}U(1)
                    \\,.
            %p
              Under
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+simplicial+topological+spaces"} geometric realization
              this maps to a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi det
                    %mo{:stretchy => "false"} |
                    %mo :
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    |\mathbf{B} det| : B U(N) \to B U(1) \simeq K(\mathbb{Z},2)
            %p
              of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
              on the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B U(N)
              %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
              (see
              %a.existingWikiWord{:href => "/nlab/show/determinant+line+bundle"} determinant line bundle
              for more on this).
            %p
              By postcomposion with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi det
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}det
              of the classifying morphisms for principal bundles, it acts on principal bundles: postcomposition of a
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
              cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                            %mo :
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi g
                                  %mrow
                                    %mi i
                                    %mi j
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P : &amp; C(\{U_i\}) &amp;\stackrel{(g_{i j})}{\to}&amp; \mathbf{B} U(N)
                    \\\
                    \&amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    \&amp; X
                    }
            %p
              for a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(N)
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              on a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with this characteristic class yields the cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi det
                            %mi P
                            %mo :
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi g
                                  %mrow
                                    %mi i
                                    %mi j
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi det
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    det P : &amp; C(\{U_i\}) &amp;\stackrel{(g_{i j})}{\to}&amp; \mathbf{B} U(N)
                    \&amp;\stackrel{\mathbf{B}det}{\to}&amp; \mathbf{B}U(1)
                    \\\
                    \&amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    \&amp; X
                    }
            %p
              for a circle bundle (or its
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi det
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (det (g_{i j}))
              %a.existingWikiWord{:href => "/nlab/show/determinant+line+bundle"} determinant line bundle
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi det
                    %mi P
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msup
                      %mi H
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [det P] \in
                    H^2(X, \mathbb{Z})
            %p
              of this line bundle is a characteristic of the original unitary bundle: its first
              %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c_1(P)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi det
                    %mi P
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [det P] = c_1(P)
                    \\,.
            %p
              This construction directly extends to the case where the bundles carry
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connections
            %p
              We may canonically identify the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{u}(n)
              with the
              %a.existingWikiWord{:href => "/nlab/show/matrix+Lie+algebra"} matrix Lie algebra
              of skew-hermitian matrices on which we have the
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
              operation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tr
                    %mo :
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi i
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    tr : \mathfrak{u}(n) \to \mathfrak{u}(1) = i \mathbb{R}
                    \\,.
            %p
              This is the differential version of the determinant in that when regarding the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              as the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal neighbourhood
              of the neutral element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(N)
              (see
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
              for more on this) the determinant becomes the trace under the exponential map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo +
                    %mi ϵ
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo +
                    %mi ϵ
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    det (1 + \epsilon A) = 1 + \epsilon tr(A)
            %p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϵ
                        %mn 2
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \epsilon^2 = 0
            %p
              It follows that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi tra
                      %mo ∇
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} tra_\nabla : \mathbf{P}_1(U_i) \to \mathbf{B}U(N)
              the
              %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
              of a
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              locally given by a 1-forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ,
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^1(U_i, \mathfrak{u}(N))
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi tra
                      %mo ∇
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi 𝒫
                    %mi exp
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msup
                      %mi γ
                      %mo *
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    tra_\nabla(\gamma) = \mathcal{P} \exp \int_{[0,1]} \gamma^* A
            %p the determinant parallel transport
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %msub
                      %mi tra
                      %mo ∇
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi tra
                          %mo ∇
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi det
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    det tra_\nabla : \mathbf{P}_1(U_i) \stackrel{tra_\nabla}{\to}
                    \\mathbf{B} U(N) \stackrel{det}{\to} \mathbf{B}U(1)
            %p is locally given by the formula
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %msub
                      %mi tra
                      %mo ∇
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi 𝒫
                    %mi exp
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msup
                      %mi γ
                      %mo *
                    %mi tr
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    det tra_\nabla(\gamma) = \mathcal{P} \exp \int_{[0,1]} \gamma^* tr A
            %p which means that the local connection forms on the determinant line bundle are obtained from those of the unitary bundle by tracing.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi det
                    %mo ,
                    %mi tr
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo ↦
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi det
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi tr
                    %msub
                      %mi A
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (det,tr) : \{(g_{i j}), (A_i)\} \mapsto
                    \\{(det  g_{i j}), (tr A_i)\}
                    \\,.
            %p This construction extends to a functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi det
                    %mo ,
                    %mi tr
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi Bund
                      %mi conn
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi Bund
                      %mi conn
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\hat \mathbf{c}_1) := (det, tr) :  U(N) Bund_{conn}(X) \to U(1) Bund_{conn}(X)
            %p
              natural in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(n)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle bundles with connection
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            %p This assignment remembers of a unitary bundle one inegral class and its differential refinement:
            %ul
              %li
                %p
                  the integral class of the determinant bundle is the first
                  %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
                  the
                  = succeed "-bundle" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} U(N)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mover
                            %mstyle{:mathvariant => "bold"}
                              %mi c
                            %mo{:stretchy => "false"} ^
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %msub
                          %mi c
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        [\hat \mathbf{c}_1(P)] = c_1(P)
                        \\,;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                  2-form of its connection is a representative in de Rham cohomology of this class
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi F
                          %mrow
                            %msub
                              %mo ∇
                              %mrow
                                %msub
                                  %mover
                                    %mstyle{:mathvariant => "bold"}
                                      %mi c
                                    %mo{:stretchy => "false"} ^
                                  %mn 1
                                %mo{:stretchy => "false"} (
                                %mi P
                                %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %msub
                          %mi c
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi P
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi dR
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        [F_{\nabla_{\hat \mathbf{c}_1(P)}}] = c_1(P)_{dR}
                        \\,.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi H
                              %mi diff
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msup
                              %mi H
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi ℤ
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi cl
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mover
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                                %mo{:stretchy => "false"} ^
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi tr
                            %msub
                              %mi F
                              %mo ∇
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; H^2_{diff}(X)
                    \\\
                    \&amp; \swarrow &amp;&amp;  \searrow
                    \\\
                    H^2(X,\mathbb{Z}) &amp;&amp; &amp;&amp; \Omega^2_{cl}(X)
                    }
                    \\;\;\;\;
                    \\array{
                    \&amp;&amp; \hat \mathbf{c}_1
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    c_1(P) &amp;&amp;&amp;&amp; tr F_\nabla
                    }
                    \\,.
            %p
              Equivalently this assignment is given by postcomposition of cocycles with a morphism of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hat \mathbf{c}_1 : \mathbf{B}U(N)_{conn} \to \mathbf{B}U(1)_{conn}
                    \\,.
            %p
              We say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}_1
              is a
              = succeed "," do
                %strong differential characteristic class
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
          %p
            In (
            %a{:href => "http://nlab.mathforge.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos+--+references#CechCocyclesForCharClasses"}> BrylinskiMacLaughlin
            ) an algorithm is given for contructing differential characteristic classes on Cech cocycles in this fashion for more general
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cocycles
          %p
            For instance these authors give the following construction for the diffrential refinement of the first
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
          #BMConstruction.num_example
            %h6#example_4 Example
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(N)
              for the
              %a.existingWikiWord{:href => "/nlab/show/Spin+group"} Spin group
              and consider the canonical
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
              3-cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟩
                    %mo :
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi b
                      %mn 2
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\mu = \langle -,[-,-]\rangle : \mathfrak{so}(n) \to \mathbf{b}^2 \mathbb{R}
            %p
              on
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle -,- \rangle
              is the
              %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo →
                    %mi X
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (P \to X, \nabla)
              be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(N)
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} with connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^1(P, \mathfrak{so}(N))
              be the
              %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} Ehresmann connection
              1-form on the total space of the bundle.
            %p
              Then construct a
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cocycle
              for
              %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
              in degree 4 as follows:
            %ol
              %li
                %p
                  pick an
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
                  such that there is a choice of local
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/section"} section
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi σ
                            %mi i
                          %mo :
                          %msub
                            %mi U
                            %mi i
                          %mo →
                          %mi P
                        %annotation{:encoding => "application/x-tex"} \sigma_i : U_i \to P
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo ,
                        %msub
                          %mi A
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi σ
                          %mi i
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %msub
                          %mi σ
                          %mi j
                        %mo ,
                        %msubsup
                          %mi σ
                          %mi i
                          %mo *
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (g_{i j}, A_i) := (\sigma_i^{-1} \sigma_j, \sigma_i^* A)
                %p
                  for the induced
                  %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
                  cocycle.
              %li
                %p Choose a lift of this cocycle to an assignment
                %ul
                  %li
                    %p
                      of based paths in
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} Spin(N)
                      to double intersections
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mover
                                %mi g
                                %mo{:stretchy => "false"} ^
                              %mrow
                                %mi i
                                %mi j
                            %mo :
                            %msub
                              %mi U
                              %mrow
                                %mi i
                                %mi j
                            %mo ×
                            %msup
                              %mi Δ
                              %mn 1
                            %mo →
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                          %annotation{:encoding => "application/x-tex"}
                            \\hat g_{i j} : U_{i j}\times \Delta^1 \to Spin(N)
                            \\,,
                    %p
                      with
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mover
                                %mi g
                                %mo{:stretchy => "false"} ^
                              %mrow
                                %mi i
                                %mi j
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi e
                          %annotation{:encoding => "application/x-tex"} \hat g_{i j}(0) = e
                      and
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mover
                                  %mi g
                                  %mo{:stretchy => "false"} ^
                                %mrow
                                  %mi i
                                  %mi j
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo =
                              %msub
                                %mi g
                                %mrow
                                  %mi i
                                  %mi j
                            %annotation{:encoding => "application/x-tex"} \hat g_{i j}(1) = g_{i j}
                  %li
                    %p of based 2-simplices between these paths to triple intersections
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mover
                                %mi g
                                %mo{:stretchy => "false"} ^
                              %mrow
                                %mi i
                                %mi j
                                %mi k
                            %mo :
                            %msub
                              %mi U
                              %mrow
                                %mi i
                                %mi j
                                %mi k
                            %mo ×
                            %msup
                              %mi Δ
                              %mn 2
                            %mo →
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ;
                          %annotation{:encoding => "application/x-tex"}
                            \\hat g_{i j k} : U_{i j k}\times \Delta^2 \to Spin(N)
                            \\,;
                    %p restricting to these paths in the obvious way;
                  %li
                    %p similarly of based 3-simplices between these paths to quadruple intersections
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mover
                                %mi g
                                %mo{:stretchy => "false"} ^
                              %mrow
                                %mi i
                                %mi j
                                %mi k
                                %mi l
                            %mo :
                            %msub
                              %mi U
                              %mrow
                                %mi i
                                %mi j
                                %mi k
                                %mi l
                            %mo ×
                            %msup
                              %mi Δ
                              %mn 3
                            %mo →
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                          %annotation{:encoding => "application/x-tex"}
                            \\hat g_{i j k l} : U_{i j k l}\times \Delta^3 \to Spin(N)
                            \\,.
            %p
              Such lifts always exists, because the Spin group is
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              (because already
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(N)
              is),
              %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
              (because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(N)
              is the
              %a.existingWikiWord{:href => "/nlab/show/universal+cover"} universal cover
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SO
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SO(N)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_2(Spin(N)) = 0
              (because this is the case for every compact Lie group).
            %ol
              %li
                %p
                  Define from this a
                  %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne-cochain
                  by setting
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                            %mi k
                            %mi l
                        %mo ,
                        %msub
                          %mi A
                          %mrow
                            %mi i
                            %mi j
                            %mi k
                        %mo ,
                        %msub
                          %mi B
                          %mrow
                            %mi i
                            %mi j
                        %mo ,
                        %msub
                          %mi C
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msub
                                    %mo ∫
                                    %mrow
                                      %msup
                                        %mi Δ
                                        %mn 3
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi σ
                                    %mi i
                                  %mo ⋅
                                  %msub
                                    %mover
                                      %mi g
                                      %mo{:stretchy => "false"} ^
                                    %mrow
                                      %mi i
                                      %mi j
                                      %mi k
                                      %mi l
                                  %msup
                                    %mo{:stretchy => "false"} )
                                    %mo *
                                  %mi μ
                                  %mo{:stretchy => "false"} (
                                  %mi A
                                  %mo{:stretchy => "false"} )
                                  %mi mod
                                  %mi ℤ
                                  %mo ,
                              %mtr
                                %mtd
                                  %msub
                                    %mo ∫
                                    %mrow
                                      %msup
                                        %mi Δ
                                        %mn 2
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi σ
                                    %mi i
                                  %mo ⋅
                                  %msub
                                    %mover
                                      %mi g
                                      %mo{:stretchy => "false"} ^
                                    %mrow
                                      %mi i
                                      %mi j
                                      %mi k
                                  %msup
                                    %mo{:stretchy => "false"} )
                                    %mo *
                                  %mi cs
                                  %mo{:stretchy => "false"} (
                                  %mi A
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                              %mtr
                                %mtd
                                  %msub
                                    %mo ∫
                                    %mrow
                                      %msup
                                        %mi Δ
                                        %mn 1
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi σ
                                    %mi i
                                  %mo ⋅
                                  %msub
                                    %mover
                                      %mi g
                                      %mo{:stretchy => "false"} ^
                                    %mrow
                                      %mi i
                                      %mi j
                                  %msup
                                    %mo{:stretchy => "false"} )
                                    %mo *
                                  %mi cs
                                  %mo{:stretchy => "false"} (
                                  %mi A
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                              %mtr
                                %mtd
                                  %msubsup
                                    %mi σ
                                    %mi i
                                    %mo *
                                  %mi μ
                                  %mo{:stretchy => "false"} (
                                  %mi A
                                  %mo{:stretchy => "false"} )
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        (g_{i j k l}, A_{i j k}, B_{i j}, C_{i})
                        \:=
                        \\left(
                        \\array{
                        \\int_{\Delta^3} (\sigma_i \cdot\hat g_{i j k l})^* \mu(A) mod \mathbb{Z},
                        \\\
                        \\int_{\Delta^2} (\sigma_i\cdot \hat g_{i j k})^* cs(A),
                        \\\
                        \\int_{\Delta^1} (\sigma_i \cdot \hat g_{i j})^* cs(A),
                        \\\
                        \\sigma_i^* \mu(A)
                        }
                        \\right)
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cs
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} ⟨
                        %mi A
                        %mo ∧
                        %msub
                          %mi F
                          %mi A
                        %mo{:stretchy => "false"} ⟩
                        %mo +
                        %mi c
                        %mo{:stretchy => "false"} ⟨
                        %mi A
                        %mo ∧
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ∧
                        %mi A
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} cs(A) = \langle A \wedge F_A\rangle + c \langle A \wedge [A \wedge A]\rangle
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons form
                  of the connection form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  with respect to the cocycle
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi μ
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} ⟨
                          %mi A
                          %mo ∧
                          %mo{:stretchy => "false"} [
                          %mi A
                          %mo ∧
                          %mi A
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ⟩
                        %annotation{:encoding => "application/x-tex"} \mu(A) = \langle A \wedge [A \wedge A]\rangle
            %p They then prove:
            %ol
              %li
                %p
                  This is indeed a
                  %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
                  cocycle;
              %li
                %p
                  It represents the differential refinement of the first fractional
                  %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                        %annotation{:encoding => "application/x-tex"} P
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msubsup
                            %mi H
                            %mi diff
                            %mn 4
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %msup
                            %mi H
                            %mn 4
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi ℤ
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msubsup
                            %mi Ω
                            %mi cl
                            %mn 4
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mfrac
                            %mn 1
                            %mn 2
                          %msub
                            %mover
                              %mstyle{:mathvariant => "bold"}
                                %mi p
                              %mo{:stretchy => "false"} ^
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mfrac
                            %mn 1
                            %mn 2
                          %msub
                            %mi p
                            %mn 1
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi d
                          %mi cs
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; H^4_{diff}(X)
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  H^4(X,\mathbb{Z}) &amp;&amp;&amp;&amp; \Omega^4_{cl}(X)
                  }
                  \\;\;\;\;
                  \\array{
                  \&amp;&amp; \frac{1}{2} \hat \mathbf{p}_1
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  \\frac{1}{2}p_1 &amp;&amp;&amp;&amp; d cs(A)
                  }
          %p
            In the form in which we have (re)stated this result here the second statement amounts, in view of the first statement, to the observation that the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            4-form of the Deligne cocycle is proportional to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mi cl
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\langle F_A \wedge F_A \rangle \in \Omega^4_{cl}(X)
          %p
            which represents the first Pontryagin class in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            %em Ansatz
            come from? And is it
            %em natural
            ? For instance: does this construction extend to a morphism of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi N
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2}\hat \mathbf{p}_1 : \mathbf{B} Spin(N)_{conn}
                  \\to \mathbf{B}^3 U(1)_{conn}
          %p
            from Spin-
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"}> principal bundle
            s with connection to
            = succeed "?" do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 3-bundles with connection
          %p
            In the following we give a natural presentation of the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+homomorphism"} ∞-Chern-Weil homomorphism
            by means of
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of
            = succeed "-algebraic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
            %a.maruku-ref{:href => "#ReproducingBrylinskiMacLaughlin"}
            we reproduce the above example.
          %p The construction proceeds in the following broad steps
          %ol
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} infinitesimal
                analog of a characteristic class
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo :
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{c} : \mathbf{B}G \to \mathbf{B}^n U(1)
                is a
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} L-∞ algebra cocycle
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo :
                      %mi 𝔤
                      %mo →
                      %msup
                        %mi b
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mi ℝ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mu : \mathfrak{g} \to b^{n-1} \mathbb{R}
                      \\,.
            %li
              %p
                There is a formal procedure of universal
                %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
                which sends this to a morphism of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi b
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      \\exp(\mu) : \exp(\mathfrak{g}) \to \exp(b^{n-1} \mathbb{R}) \simeq \mathbf{B}^n \mathbb{R}
              %p
                presented by a morphism of
                %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
                on
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %li
              %p
                By finding a
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cs
                    %annotation{:encoding => "application/x-tex"} cs
                that witnesses the
                %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
                to an
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                this construction has a differential refinement to a morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %mo ,
                      %mi cs
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %msub
                        %mi ℝ
                        %mi conn
                    %annotation{:encoding => "application/x-tex"}
                      \\exp(\mu,cs) : \exp(\mathfrak{g})_{conn} \to \mathbf{B}^n \mathbb{R}_{conn}
              %p
                that sends
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} L_\infty
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} line n-bundles with connection
            %li
              %p
                The
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/truncated"} truncation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi cosk
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_{n+1} \exp(\mathfrak{g})
                of the object on the left produces the smooth
                = succeed "-groups" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi cosk
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_{n+1} \exp(\mathfrak{g}) \simeq \mathbf{B}G
                – and the corresponding truncation of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %mo ,
                      %mi cs
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp((\mu,cs))
                carves out the
                %a.existingWikiWord{:href => "/nlab/show/lattice"} lattice
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/period"} period
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                of the cocycle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
                inside
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %mo ,
                      %mi cs
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi G
                        %mi conn
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi ℝ
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi Γ
                        %mi conn
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\exp(\mu,cs) : \mathbf{B}G_{conn} \to \mathbf{B}^n \mathbb{R}/\Gamma_{conn}
                      \\,.
              %p
                Typically we have
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \Gamma \simeq \mathbb{Z}
                such that this then reads
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %mo ,
                      %mi cs
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi G
                        %mi conn
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\exp(\mu,cs) : \mathbf{B}G_{conn} \to \mathbf{B}^n U(1)_{conn}
                      \\,.
          %h3#LieTheory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Lie theory
          %p
            We discuss
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            to
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
          %h4#InfLieAlgebroids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Lie algebroids
          %p
            There is a precise sense in which one may think of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            as the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal
            sub-object of the delooping groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            of the corresponding Lie group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-theory)," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} ∞-Lie groupoid
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            A quick but useful way of formalizing what this means is to observe that ordinary (finite-dimensional)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathfrak{g}, [-,-])
            are entirely encoded, dually, in their
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ,
                    %mi d
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g}) = (\wedge^\bullet \mathfrak{g}^*, d = [-,-]^*)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded-commutative algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            (which is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            for our purposes here) on the vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*[1]
            equipped a differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            of degree +1 and squaring to 0.
          %p
            Simply by replacing in this characterization the vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
            be an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}[1]
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            are the infinitesimal
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            by an algebra of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔞
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}_0
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔞
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                  %mo →
                  %mi 𝔟
                %annotation{:encoding => "application/x-tex"} \mathfrak{a} \to \mathfrak{b}
            of such
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{a}) \leftarrow CE(\mathfrak{b})
          %p The following definition glosses over some fine print but is entirely sufficient for our present discussion.
          .num_defn
            %h6#definition_14 Definition
            %p
              The category of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/dgAlg"} dgAlg
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi LieAlgbd
                    %mo ⊂
                    %mo{:stretchy => "false"} (
                    %mi dgAlg
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    \\infty LieAlgbd \subset (dgAlg)^{op}
            %p
              on graded-commutative cochain
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
              is a
              %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
              over the degree-0 algebra.
          .num_example
            %h6#examples Examples
            %ul
              %li
                %p
                  A
                  %em strict
                  = succeed "-Lie" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                  %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo ,
                        %mo ∂
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathfrak{g}, \partial, [-,-])
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi 𝔤
                          %mo *
                        %mo ,
                        %msup
                          %mo ∂
                          %mo *
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathfrak{g}^*, \partial^*)
                  a
                  %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
                  in non-negative degree. With
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔤
                          %mo *
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
                  denoting the degreewise dual, the corresponding CE-algebra is
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msup
                            %mo ∧
                            %mo •
                          %msup
                            %mi 𝔤
                            %mo *
                          %mo ,
                          %msub
                            %mi d
                            %mi CE
                          %mo =
                          %mo{:stretchy => "false"} [
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msup
                            %mo{:stretchy => "false"} ]
                            %mo *
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %msup
                            %mo ∂
                            %mo *
                        %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g}) = (\wedge^\bullet \mathfrak{g}^*, d_{CE} = [-,-]^* + \partial^*
              %li
                %p
                  We had already seen
                  %a{:href => "#ConnectionOn2Bundle"} above
                  the infinitesimal approximation of a
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/Lie+2-group"} Lie 2-group
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Lie+2-algebra"} Lie 2-algebra
                  %a.existingWikiWord{:href => "/nlab/show/strict+2-group"} strict 2-group
                  it is encoded equivalently by a
                  %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
                  of ordinary Lie groups, and the corresponding Lie 2-algebra is given by a
                  %a.existingWikiWord{:href => "/nlab/show/differential+crossed+module"} differential crossed module
                  of ordinary
                  = succeed "s." do
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mi X
                      %annotation{:encoding => "application/x-tex"} T X
                  of a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is the infinitesimal approximation to its
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
                  %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi Ω
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CE(T X) = \Omega^\bullet(X)
                  \.
              %li
                %p
                  For
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ≥
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n \geq 1
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi b
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} b^{n-1}\mathbb{R}
                  is the infinitesimal approximation to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi n
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi ℝ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(\mathbb{R})
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi n
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}^n \mathbb{R}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %li
                %p
                  For any
                  = succeed "-Lie" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  there is an
                  = succeed "-Lie" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi inn
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} inn(\mathfrak{g})
                  defined by the fact that its CE-algebra is the
                  %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
                  of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi inn
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msup
                          %mo ∧
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi 𝔤
                          %mo *
                        %mo ⊕
                        %msup
                          %mi 𝔤
                          %mo *
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi d
                          %mi W
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msup
                              %mi 𝔤
                              %mo *
                        %mo =
                        %msub
                          %mi d
                          %mi CE
                        %mo +
                        %mi σ
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        CE(inn(\mathfrak{g})) =
                        W(\mathfrak{g}) =
                        (\wedge^\bullet (\mathfrak{g}^* \oplus \mathfrak{g}^*[1]),
                        d_{W}|_{\mathfrak{g}^*} = d_{CE} + \sigma )
                        \\,,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo :
                        %msup
                          %mi 𝔤
                          %mo *
                        %mo →
                        %msup
                          %mi 𝔤
                          %mo *
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \sigma : \mathfrak{g}^* \to \mathfrak{g}^*[1]
                  is the grading shift isomorphism, extended as a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
          %h4#LieIntegration Lie integration
          %p
            We discuss
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} L-∞ algebroid
            to a
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
            of which it is the infinitesimal approximation.
          %p
            The construction we want to describe may be understood as a generalization of the following proposition. This is classical, even if maybe not reflected in the standard textbook literature to the extent it deserves to be (see
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            for details and references).
          .num_def
            %h6#definition_15 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              a (finite-dimensional)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g}) \in [CartSp^{op}, sSet]
              be the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
              given by the assignment
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi U
                    %mo ↦
                    %msub
                      %mi Hom
                      %mi dgAlg
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi vert
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\mathfrak{g})  : U
                    \\mapsto Hom_{dgAlg}(CE(\mathfrak{g}), \Omega^\bullet(U \times \Delta^\bullet)_{vert})
                    \\,,
            %p
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              of
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              to the dg-algebra of
              %a.existingWikiWord{:href => "/nlab/show/vertical+differential+forms"} vertical differential forms
              with respect to the trivial
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %msup
                        %mi Δ
                        %mi k
                      %mo →
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U \times \Delta^k \to U
          .num_remark
            %h6#remark_9 Remark
            %p
              Shortly we will be considering variations of such assignments that are best thought about when writing out the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msubsup
                                %mi Ω
                                %mi vert
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo ×
                              %msup
                                %mi Δ
                                %mi k
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ←
                                %mrow
                                  %msub
                                    %mi A
                                    %mi vert
                            %mtd
                              %mi CE
                              %mo{:stretchy => "false"} (
                              %mi 𝔤
                              %mo{:stretchy => "false"} )
                      %mo }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\mathfrak{g})
                    \:
                    (U,[k])
                    \\mapsto
                    \\left\{
                    \\array{
                    \\Omega^\bullet_{vert}(U \times \Delta^k)
                    \&amp;\stackrel{A_{vert}}{\leftarrow}&amp;
                    CE(\mathfrak{g})
                    }
                    \\right\}
                    )
                    \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            an ordinary
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            it is an ancient (see
            = succeed ")" do
              %a{:href => "http://ncatlab.org/nlab/show/Chern-Weil%20theory#History"} Chern-Weil theory – history
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\Delta^k) \leftarrow CE(\mathfrak{g})
            are in natural bijection with
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie-algebra+valued+1-form"} Lie-algebra valued 1-form
            %em flat
            in that their
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            2-forms vanish: the 1-form itself determines precisely a morphism of the underlying
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
            %a{:href => "#http://ncatlab.org/nlab/show/Chern-Weil+theory#History"} historically
            led
            %span.newWikiWord
              Eli Cartan
              %a{:href => "/nlab/new/Eli+Cartan"} ?
            to
            %a.existingWikiWord{:href => "/nlab/show/Cartan+calculus"} Cartan calculus
            and the algebraic formulation of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
          %p
            One finds that it makes good sense to generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            any
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            or even
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi dgAlg
                  %mo{:stretchy => "false"} (
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom_{dgAlg}(CE(\mathfrak{g}), \Omega^\bullet(\Delta^k))
            as the set of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid+valued+differential+forms"} ∞-Lie algebroid valued differential forms
            whose curvature forms (generally a whole tower of them) vanishes.
          .num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be the
              %a.existingWikiWord{:href => "/nlab/show/simply-connected"} simply-connected
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              integrating
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              according to
              %a.existingWikiWord{:href => "/nlab/show/Lie%27s+three+theorems"} Lie's three theorems
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in [CartSp^{op}, Grpd]
              its
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              regarded as a
              = succeed "-valued" do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_1(-)
              for the
              %a.existingWikiWord{:href => "/nlab/show/truncated"} truncation
              operation that quotients out
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
            %p
              We have an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo =
                    %msub
                      %mi τ
                      %mn 1
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G
                    \=
                    \\tau_1
                    \\exp(\mathfrak{g})
                    \\,.
          %p
            To see this, observe that the presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})
            has as 1-morphisms
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi vert
                %annotation{:encoding => "application/x-tex"} A_{vert}
            on the interval, and as 2-morphisms
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %em flat
            1-forms on the disk, interpolating between these. By identifying these 1-forms with the pullback of the
            %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and 2-morphisms smooth
            %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
            relative endpoints between them. Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is
            %a.existingWikiWord{:href => "/nlab/show/simply-connected"} simply-connected
            this means that after dividing out 2-morphisms only the endpoints of these paths remain, which identify with the points in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            The following proposition establishes the Lie integraiton of the shifted 1-dimensional abelian
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b^{n-1} \mathbb{R}
          #IntegrationOfBnR.num_prop
            %h6#proposition_8 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %msub
                      %mi ℝ
                      %mi ch
                    %mo :
                    %mo =
                    %mi Ξ
                    %mi ℝ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}^n \mathbb{R}_{ch} :=
                    \\Xi \mathbb{R}[n]
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
              on
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              that is the image of the sheaf of
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represented
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and 0 in other degrees, under the
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ξ
                      %mo :
                      %msubsup
                        %mi Ch
                        %mo •
                        %mo +
                      %mo →
                      %mi sAb
                      %mo →
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} \Xi : Ch_\bullet^+ \to sAb \to sSet
            %p Then there is a canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mo •
                    %mo :
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %msub
                      %mi ℝ
                      %mi ch
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Delta^\bullet} :
                    \\exp(b^{n-1}\mathbb{R})
                    \\stackrel{\simeq}{\to}
                    \\mathbf{B}^n \mathbb{R}_{ch}
            %p
              given by
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
              of differential forms along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi n
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U \times \Delta^n \to U
              and this is an equivalence (a global equivalence in the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
          %p
            The proof of this statement is discussed at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
          %p
            This statement will make an appearance repeatedly in the following discussion. Whenever we translate a construction given in terms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(-)
            into a more convenient
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            representation.
          %h4#LieIntOfCocycles Characteristic classes from Lie integration
          %p
            We now describe
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
          %p
            To see characteristic classes in this picture, write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(b^{n-1} \mathbb{R})
            for the commutative real
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            on a single generator in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            with vanishing differential. As our notation suggests, this we may think as the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            of a
            %em higher Lie algebra
            – the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} b^{n-1} \mathbb{R}
            – which is an
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+object"} Eilenberg-MacLane object
            in the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} ∞-Lie algebra cohomology
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            with coefficients in
            = succeed "." do
