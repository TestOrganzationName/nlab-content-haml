              be a choice of one closed 2-form representative for each degree-2
              = succeed "-class" do
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi conn
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
