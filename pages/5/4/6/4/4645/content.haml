                          %mo •
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \int_{\Delta^\bullet} \exp(\mu)
              acts by sending each 3-cell to the number
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi i
                        %mi j
                        %mi k
                        %mi l
                    %mo ↦
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mn 3
                    %msubsup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi i
                        %mi j
                        %mi k
                        %mi l
                      %mo *
                    %mi μ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi mod
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\hat g_{i j k l} \mapsto \int_{\Delta^3} \hat g_{i j k l}^* \mu
                    \\;\;  mod \mathbb{Z}
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is regarded in this formula as a closed 3-form on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
            We say this is
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/Lie+infinity-groupoid#IntegrationOfCocycles"} Lie integration of Lie algebra cocycles
          .num_prop
            %h6#proposition_9 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              cocycle obtained this way is the first
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
              of the
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
            We shall show this below, as part of our
            = succeed "-algebraic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "." do
              %a{:href => "#BMConstruction"} above motivating example
          %h3#LieConnections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} L_\infty
            \-algebra valued connections
          %p
            %a{:href => "#LowDimension"} Above
            we described ordinary
            %a.existingWikiWord{:href => "/nlab/show/connections+on+bundles"} connections on bundles
            as well as
            %a.existingWikiWord{:href => "/nlab/show/connections+on+2-bundles"} connections on 2-bundles
            in terms of
            %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            over paths and surfaces, and showed how such is equivalently given by cocycles with coefficients in
            %a.existingWikiWord{:href => "/nlab/show/Lie-algebra+valued+differential+forms"} Lie-algebra valued differential forms
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-algebra+valued+differential+forms"} Lie 2-algebra valued differential forms
          %p
            Notably we saw (
            %a{:href => "#CurvatureCharacteristicsI"}> here
            ) for the case of ordinary
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} U \in
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            look like
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi U
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
