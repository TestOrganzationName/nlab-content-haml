                  \&amp;&amp; (x,j)
                  \\\
                  \&amp; {}^{\mathllap{c_1}}\nearrow &amp;\Downarrow^{g_{i j k}(x)}&amp; \searrow^{\mathrlap{c_2}}
                  \\\
                  (x,i) &amp;&amp;\stackrel{c_3}{\to}&amp;&amp; (x,k)
                  }
          %p subject to the condition that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 1
                  %mo ⋅
                  %msub
                    %mi c
                    %mn 2
                  %mo =
                  %msub
                    %mi c
                    %mn 3
                  %mo ⋅
                  %msub
                    %mi g
                    %mrow
                      %mi i
                      %mi j
                      %mi k
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  c_1 \cdot c_2 = c_3 \cdot g_{i j k}(x)
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi P
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde P
            was equivalent to the 0-groupoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo =
                  %mrow
                    %mo (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo →
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  P =
                  \\left(
                  C(U)_1 \times U(1) \stackrel{\to}{\to}
                  C(U)
                  \\right)
          %p with composition law
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi c
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %mo ⋅
                      %msub
                        %mi c
                        %mn 2
                      %mo ⋅
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                          %mi k
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ((x,i) \stackrel{c_1}{\to} (x,j) \stackrel{c_2}{\to} (x,k))
                  \=
                  ((x,i) \stackrel{(c_1 \cdot c_2 \cdot g_{i j k }(x))}{\to}
                  (x,k))
                  \\,.
          %p
            This is a
            %a.existingWikiWord{:href => "/nlab/show/groupoid+cohomology"} groupoid central extension
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}U(1) \to P \to C(U) \simeq X
                  \\,.
          %p
            Centrally extended groupoids of this kind are known in the literature as
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            %a.existingWikiWord{:href => "/nlab/show/surjective+submersion"} surjective submersion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo =
                  %mi U
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} Y = U \to X
            ). They may be thought of as given by a
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi L
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi U
                          %msub
                            %mo{:stretchy => "false"} )
                            %mn 1
                          %mo =
                          %mi U
                          %msub
                            %mo ×
                            %mi X
                          %mi U
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mo →
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi U
                          %msub
                            %mo{:stretchy => "false"} )
                            %mn 0
                          %mo =
                          %mi U
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  L
                  \\\
                  \\downarrow
                  \\\
                  (C(U)_1 = U \times_X U) &amp;\stackrel{\to}{\to}&amp; (C(U)_0 = U)
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; X
                  }
          %p
            over the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 1
                %annotation{:encoding => "application/x-tex"} C(U)_1
            of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mi g
                  %mo :
                  %msubsup
                    %mi π
                    %mn 1
                    %mo *
                  %mi L
                  %mo ⊗
                  %msubsup
                    %mi π
                    %mn 2
                    %mo *
                  %mi L
                  %mo →
                  %msubsup
                    %mi π
                    %mn 1
                    %mo *
                  %mi L
                %annotation{:encoding => "application/x-tex"}
                  \\mu_g : \pi_1^* L \otimes \pi_2^* L \to \pi_1^* L
          %p
            that satisfies an evident
            %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
            law, equivalent to the cocycle codition on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          %p
            So we see that bundle gerbes are presentations of Lie groupoids that are total spaces of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
          %p
            This is clearly the beginning of a pattern. Next we can form one more
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            and produce the Lie 3-groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^3 U(1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(U) \to \mathbf{B}^3 U(1)
            classifies a
            %em circle 3-bundle
            \. The total space object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi P
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde P
            in the pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi P
                            %mo{:stretchy => "false"} ˜
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi g
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 3
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo ≃
                      %mtr
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\tilde P &amp;\to&amp; \mathbf{E}\mathbf{B}^2 U(1)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  C(U) &amp;\stackrel{g}{\to}&amp; \mathbf{B}^3 U(1)
                  \\\
                  \\downarrow^{\mathrlap{\simeq}}
                  \\\
                  X
                  }
          %p
            is essentially what is known as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
          %h3#string_2bundles_and_nonabelian_bundle_gerbes String 2-bundles and nonabelian bundle gerbes
          %p
            Above we saw
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            is a special case of what is called a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-group"} Lie 2-group
            %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            in Lie groupoids.
          %p
            An example of a nonabelian Lie 2-group is the
            %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-group"} string Lie 2-group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi String
                  %annotation{:encoding => "application/x-tex"} String
            %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            of Lie 2-groups of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi String
                  %mo →
                  %mi Spin
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}U(1) \to String \to Spin
                  \\,.
          %p A quick way to understand the meaning of this 2-group is from the fact that:
          %p
            %strong Fact.
            Given a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
            classifies a
            %em circle 3-bundle
            (a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+3-bundle"} Chern-Simons circle 3-bundle
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                  %annotation{:encoding => "application/x-tex"} Spin
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            to a
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi String
                  %annotation{:encoding => "application/x-tex"} String
          %p
            Again, we can construct Lie 2-groupoids equivalent to the total space of a
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi String
                  %annotation{:encoding => "application/x-tex"} String
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi String
                %annotation{:encoding => "application/x-tex"} g : C(U) \to \mathbf{B}String
            by forming the pullback.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi P
                            %mo{:stretchy => "false"} ˜
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %mi String
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mi g
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi String
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo ≃
                      %mtr
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\tilde P &amp;\to&amp; \mathbf{E}String
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  C(U) &amp;\stackrel{g}{\to}&amp; \mathbf{B} String
                  \\\
                  \\downarrow^{\mathrlap{\simeq}}
                  \\\
                  X
                  }
          %p
            These groupoids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi P
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde P
            are in the literature known as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+bundle+gerbe"} nonabelian bundle gerbe
          %h3#ModelForPrincipalInfinityBundle
            A model for principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We have seen
            %a{:href => "#PrincipalBundles"} above
            that the theory of ordinary smooth
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            %a{:href => "#Cech2Cocycles"} then
            that the theory of smooth
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-groupoid"} Lie 2-groupoid
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            where in the next step we see smooth
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/3-groupoid"} 3-groupoid
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          %p
            A comprehensive discussion of such
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoids"} ∞-Lie groupoids
            is given there. In this introduction here we will just briefly describe the main
            %em tool
            for
            %em modelling
            these and describe principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/models+for+%E2%88%9E-stack+%28%E2%88%9E%2C1%29-toposes"} models for ∞-stack (∞,1)-toposes
          %p
            We first look at bare
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            and then discuss how to equip these with smooth structure.
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            is first of all supposed to be a structure that has
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k \geq 1
            go between
            = succeed "-morphisms." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k-1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            on the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplices
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [k]
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[k]
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi k
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi k
                    %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[k_1] \to \Delta[k_2]
            are all ways of mapping these into each other. So we think of such a simplicial set given by a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo :
                  %msup
                    %mi Δ
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"}
                  K : \Delta^{op} \to Set
          %p as specifying
          %ul
            %li
              %p
                a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi K
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} [0] \mapsto K_0
                of
                = succeed "s;" do
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
            %li
              %p
                a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi K
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} [1] \mapsto K_1
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %li
              %p
                a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi K
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} [2] \mapsto K_2
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
            %li
              %p
                a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 3
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi K
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} [3] \mapsto K_3
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/3-morphism"} 3-morphism
          %p and generally
          %ul
            %li
              a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %msub
                      %mi K
                      %mi k
                  %annotation{:encoding => "application/x-tex"} [k] \mapsto K_k
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
          %p as well as specifying
          %ul
            %li
              %p
                functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi K
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo →
                      %msub
                        %mi K
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([n] \hookrightarrow [n+1]) \mapsto (K_{n+1} \to K_n)
                that send
                = succeed "-morphisms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n+1
                = succeed "-morphisms;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %li
              %p
                functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi K
                        %mi n
                      %mo →
                      %msub
                        %mi K
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([n+1] \to [n]) \mapsto (K_{n} \to K_{n+1})
                that send
                = succeed "-morphisms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/identity"} identity
                = succeed "-morphisms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n+1)
          %p
            The fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is supposed to be a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            enforces that these assignments of sets and functions satisfy conditions that make consistent our interpretation of them as sets of
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
          %p
            But apart from this source-target matching, a generic simplicial set does not yet encode a notion of
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            of these morphisms.
          %p
            For instance for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mn 1
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Lambda^1[2]
            the simplicial set consisting of two attached 1-cells
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mn 1
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mn 2
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\Lambda^1[2] = \left\{
                  \\array{
                  \&amp;&amp; 1
                  \\\
                  \&amp; \nearrow &amp;&amp; \searrow
                  \\\
                  0 &amp;&amp;&amp;&amp; 2
                  }
                  \\right\}
          %p
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Λ
                    %mn 1
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} (f,g) : \Lambda^1[2] \to K
            an image of this situation in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                  %mover
                    %mo →
                    %mi f
                  %msub
                    %mi x
                    %mn 1
                  %mover
                    %mo →
                    %mi g
                  %msub
                    %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} x_0 \stackrel{f}{\to} x_1 \stackrel{g}{\to} x_2
            of two
            %em composable
            1-morphisms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            that may be thought of as the
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                  %mover
                    %mo →
                    %mi h
                  %msub
                    %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} x_0 \stackrel{h}{\to} x_2
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            (and not to violate the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
            equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                          %mo ↗
                        %mtd
                          %msup
                            %mo ⇓
                            %mpadded{:width => "0"}
                              %mo ≃
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi g
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 0
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mi h
                        %mtd
                        %mtd
                          %msub
                            %mi x
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; x_1
                  \\\
                  \&amp; {}^{\mathllap{f}}\nearrow &amp;\Downarrow^{\mathrlap{\simeq}}&amp;
                  \\searrow^{\mathrlap{g}}
                  \\\
                  x_0 &amp;&amp;\stackrel{h}{\to}&amp;&amp; x_2
                  }
                  \\,.
          %p
            From the picture it is clear that this is equivalent to demanding that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mn 1
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo ↪
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Lambda^1[2] \hookrightarrow \Delta[2]
            the obvious inclusion of the two abstract composable 1-morphisms into the 2-simplex we have a diagram of morphisms of simplicial sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi Λ
                            %mn 1
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo ,
                              %mi g
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi K
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mrow
                                %mo ∃
                                %mi h
                      %mtr
                        %mtd
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Lambda^1[2] &amp;\stackrel{(f,g)}{\to}&amp; K
                  \\\
                  \\downarrow &amp; \nearrow_{\mathrlap{\exists h}}
                  \\\
                  \\Delta[2]
                  }
                  \\,.
          %p
            A simplicial set where for all such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f,g)
            a corresponding such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            exists may be thought of as a collection of higher morphisms that is equipped with a notion of composition of adjacent 1-morphisms.
          %p
            For the purpose of describing
            = succeed "al" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mn 2
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\Lambda^2[2] = \left\{
                  \\array{
                  \&amp;&amp; 1
                  \\\
                  \&amp; &amp;&amp; \searrow
                  \\\
                  0 &amp;&amp;\to&amp;&amp; 2
                  }
                  \\right\}
          %p the simplicial set consisting of two 1-morphisms that touch at their end, hence for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Λ
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"}
                  (g,h) : \Lambda^2[2] \to K
          %p
            two such 1-morphisms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            had an inverse
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} g^{-1}
            we could use the above composition operation to compose that with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            and thereby find a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            connecting the sources of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi Λ
                            %mn 2
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo ,
                              %mi h
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mi K
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mrow
                                %mo ∃
                                %mi f
                      %mtr
                        %mtd
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 2
                          %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Lambda^2[2] &amp;\stackrel{(g,h)}{\to}&amp; K
                  \\\
                  \\downarrow &amp; \nearrow_{\mathrlap{\exists f}}
                  \\\
                  \\Delta[2]
                  }
                  \\,.
          %p
            Demanding that all such diagrams exist is therefore demanding that we have on 1-morphisms a composition operation with inverses in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            In order for this to qualify as an
            = succeed "-groupoid," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/associativity+law"} associativity law
            up to
            %a.existingWikiWord{:href => "/nlab/show/coherent"} coherent
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/tetrahedra"} tetrahedra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %em pentagonators
            and ever so on. It is a nontrivial but true and powerful fact, that all these
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherence
            conditions are captured by generalizing the above conditions to all dimensions in the evident way:
          %p
            let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mi i
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ↪
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Lambda^i[n] \hookrightarrow \Delta[n]
            be the simplicial set – called the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/horn"} horn
            – that consists of all cells of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[n]
            except the interior
            = succeed "-morphism" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "-morphism." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
          %p
            Then a simplicial set is called a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msup
                    %mi Λ
                    %mi i
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} f : \Lambda^i[n] \to K
            of such horns in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %em horn filler
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            in the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi Λ
                            %mi i
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi K
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mi σ
                      %mtr
                        %mtd
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Lambda^i[n] &amp;\stackrel{f}{\to}&amp; K
                  \\\
                  \\downarrow &amp; \nearrow_{\mathrlap{\sigma}}
                  \\\
                  \\Delta[n]
                  }
                  \\,.
          %p
            The basic example is the
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} N(C) \in sSet
            of an ordinary
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi k
                %annotation{:encoding => "application/x-tex"} N(C)_k
            being the set of sequences of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            composable morphisms in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
            from 1-groupoids into Kan complexes and hence may be thought of as embedding 1-groupoids in the context of general
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          %p
            But we need a bit more than just bare
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} ∞-Lie groupoid
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is to remember the rule which for each test space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            produces the
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} ∞-Lie groupoid
            we could test with each
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo =
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} U = \mathbb{R}^n
            and find the
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(U)
            of smooth
            = succeed "-parameter" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            This data of
            = succeed "-families" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            with values in Kan complexes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi KanCplx
                  %mo ↪
                  %mi sSet
                %annotation{:encoding => "application/x-tex"}
                  K : C^{op} \to KanCplx \hookrightarrow sSet
          %p
            hence with values in simplicial sets. This is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
            of sets. The
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]
            on the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of the category of test objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            serves as a model for the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-structure." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            While there are no
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/higher+morphism"} higher morphism
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            %em all
            these higher morphisms (up to equivalence!) is just the information of which morphisms of simplicial presheaves would become invertible if we were keeping track of higher morphism. These would-be invertible morphisms are called
            %em weak equivalences
            and denoted
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mn 1
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi K
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} K_1 \stackrel{\simeq}{\to} K_2
          %p
            For common choices of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            there is a well-understood way to define the weak equivalences
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ⊂
                    %mi mor
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} W \subset mor [C^{op}, sSet]
            %em
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            \. There is a well-developed but somewhat intricate theory of how exactly this 1-cagtegorical data models the full higher category of structured groupoids that we are after, but for our purposes we essentially only need to work inside the
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            of a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} on simplicial presheaves
          %ol
            %li
              %p
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"}> ∞-anafunctor
                  s
                – A morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \to Y
                between
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                = succeed "-structure" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X\to Y
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi C
                          %mi op
                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]
                %a.existingWikiWord{:href => "/nlab/show/span"} span
                of such ordinary morphisms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mover
                                %mi X
                                %mo{:stretchy => "false"} ^
                            %mtd
                              %mo →
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mo ≃
                          %mtr
                            %mtd
                              %mi X
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\hat X &amp;\to&amp; Y
                      \\\
                      \\downarrow^{\mathrlap{\simeq}}
                      \\\
                      X
                      }
              %p
                where the left leg is a weak equivalence. This is sometimes called an
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-anafunctor
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
            %li
              %p
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
                – For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
