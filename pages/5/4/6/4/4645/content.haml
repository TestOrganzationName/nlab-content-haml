                    %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)_{diff}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
