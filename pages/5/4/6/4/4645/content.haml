                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi diff
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
