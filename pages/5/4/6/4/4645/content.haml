                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"} ∞-anafunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo ←
                    %mo ≃
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                  %mover
                    %mo →
                    %mi g
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X \stackrel{\simeq}{\leftarrow} \hat X \stackrel{g}{\to} \mathbf{B}G
            has, under mild conditions, a natural generalization where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            is replaced by a
            %a.existingWikiWord{:href => "/nlab/show/concrete+sheaf"} non-concrete
            simplicial presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
            which we may think of as the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid+of+%E2%88%9E-Lie+algebra+valued+forms"} ∞-groupoid of ∞-Lie algebra valued forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn} \to \mathbf{B}G
            and an
            = succeed "-connection" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            on the
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is a lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            in the disgram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi G
                            %mi conn
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mo ∇
                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mover
                            %mi X
                            %mo{:stretchy => "false"} ^
                        %mtd
                          %mover
                            %mo →
                            %mi g
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo ≃
                      %mtr
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbf{B}G_{conn}
                  \\\
                  \&amp; {}^{\mathllap{\nabla}}\nearrow &amp; \downarrow
                  \\\
                  \\hat X &amp;\stackrel{g}{\to}&amp; \mathbf{B}G
                  \\\
                  \\downarrow^{\mathrlap{\simeq}}
                  \\\
                  X
                  }
                  \\,.
          %p
            In the language of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            as the
            = succeed "-stack" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            = succeed "-prestack" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi TrivBund
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G TrivBund(-)
            of
            %em trivial
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
            correspondingly as the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %msub
                    %mi TrivBund
                    %mo ∇
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G TrivBund_{\nabla}(- )
            of trivial
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-connections" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
            is a tautology. The real questions are:
          %ol
            %li
              %p
                What is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi G
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
                in concrete formulas?
            %li
              %p
                Why are these formulas what they are? What is the general abstract concept of an
                = succeed "-connection?" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          %p
            A comprehensive answer to the second question is provided by the general abstract concept of
            = succeed "." do
              %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"} differential cohomology in a cohesive topos
            %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"} ∞-anafunctor
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/path+n-groupoid"} path n-groupoid
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected (∞,1)-topos
            that comes canonically with a notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
          %p
            Below we begin the discussion of
            = succeed "-connections" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on a bundle
            in a way that will make its generalization to higher connections relatively straightforward:
          %ul
            %li
              %a{:href => "#ConnectionOnPrincipalBundle"}> Connections on principal bundles
              \.
          %p
            In an analogous way we can then describe certain classes of
            %a.existingWikiWord{:href => "/nlab/show/connections+on+a+2-bundle"} connections on a 2-bundle
            – subsuming the notion of
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle+gerbe"} connection on a bundle gerbe
            – in
          %ul
            %li
              %a{:href => "#ConnectionOn2Bundle"}> Connections on 2-bundles
              \.
          %p
            With that in hand we then revisit the discussion of connections on ordinary bundles. By associating to each bundle with connection its corresponding
            %em curvature 2-bundle with connection
            we obtain a more refined description of connections on bundles, one that is naturally adapted to the construction of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
          %ul
            %li
              %a{:href => "#CurvatureCharacteristicsI"}> Curvature characteristics of 1-bundles
              \.
          %p
            This turns out to be the kind of formulation of
            %a.existingWikiWord{:href => "/nlab/show/connections+on+an+%E2%88%9E-bundle"} connections on an ∞-bundle
            that drops out of the general abstract theory described at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+homomorphism"} ∞-Chern-Weil homomorphism
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundles+with+connection"} circle n-bundles with connection
            in terms of
            %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
            and the description of the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid+of+%E2%88%9E-Lie+algebra+valued+forms"} ∞-groupoid of ∞-Lie algebra valued forms
            in terms of
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            homomorphisms. The first aspect we discuss in
          %ul
            %li
              %a{:href => "#CirclenBundles"} Circle n-bundles with connection
          %p the second in
          %ul
            %li
              %a{:href => "#LieConnections"}> L-∞ algebra valued connections
              \.
          %p
            The combination of these two aspects yields naturally an explicit model for the
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
            and its generalization to higher bundles:
          %ul
            %li
              %a{:href => "#ChernWeilHomomorphism"} The ∞-Chern-Weil homomorphism
          %p
            Taken together, these constructions allow us to express a good deal of the general
            = succeed "-Chern-Weil" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
            (by (
            %a{:href => "http://nlab.mathforge.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos+--+references#CechCocyclesForCharClasses"}> BrylinskiMacLaughlin
            )) drops out from these constructions:
          %ul
            %li
              %a{:href => "#ChernSimons3Bund"}> Example: The Chern-Simons circle 3-bundle
              \.
          %h3#ConnectionOnPrincipalBundle Connections on a principal bundle
          %p
            There are different equivalent definitions of the classical notion of a connection. One that is useful for our purposes is that a connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            on a
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            is a rule
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi tra
                    %mo ∇
                %annotation{:encoding => "application/x-tex"} tra_\nabla
            for
            %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            along paths: a rule that assigns to each path
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \gamma : [0,1] \to X
            a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi tra
                    %mo ∇
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi P
                    %mi x
                  %mo →
                  %msub
                    %mi P
                    %mi y
                %annotation{:encoding => "application/x-tex"} tra_\nabla(\gamma) : P_x \to P_y
            between the fibers of the bundle above the endpoints of these paths, in a compatible way:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi P
                            %mi x
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi tra
                                %mo ∇
                              %mo{:stretchy => "false"} (
                              %mi γ
                              %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi P
                            %mi y
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi tra
                                %mo ∇
                              %mo{:stretchy => "false"} (
                              %mi γ
                              %mo ′
                              %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mi P
                            %mi z
                        %mtd
                        %mtd
                        %mtd
                          %mi P
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi x
                        %mtd
                          %mover
                            %mo →
                            %mi γ
                        %mtd
                          %mi y
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi γ
                              %mo ′
                        %mtd
                          %mi z
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  P_x &amp;\stackrel{tra_\nabla(\gamma)}{\to}&amp; P_y
                  \&amp;\stackrel{tra_\nabla(\gamma')}{\to}&amp; P_z &amp;&amp;&amp; P
                  \\\
                  \&amp;&amp; &amp;&amp; &amp;&amp;&amp; \downarrow
                  \\\
                  x &amp;\stackrel{\gamma}{\to}&amp; y &amp;\stackrel{\gamma'}{\to}&amp; z
                  \&amp;&amp;&amp;
                  X
                  }
                  \\,.
          %p
            In order to formalize this, we introduce a (
            %a.existingWikiWord{:href => "/nlab/show/diffeological+space"}> diffeological
            )
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            to be called the
            %a.existingWikiWord{:href => "/nlab/show/path+groupoid"} path groupoid
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ")." do
              %a{:href => "http://nlab.mathforge.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos+--+references#SWI"} [SWI]
          .num_defn
            %h6#definition Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [I,X]
              be the set of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} I = [0,1] \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %em
                a
                = succeed "-parameterized" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi I
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [I,X]
              is a smooth map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %mi I
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U \times I \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [I,X]
              a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
            %p
              Say a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \gamma \in [I,X]
              has
              %em
                %a.existingWikiWord{:href => "/nlab/show/sitting+instant"}> sitting instant
                s
              if it is constant in a neighbourhood of the boundary
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \partial I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi P
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi si
                    %mo ⊂
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [I,P]_{si} \subset [I,P]
              be the subset of paths with sitting instants.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi si
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mi si
                      %mi th
                  %annotation{:encoding => "application/x-tex"} [I,X]_{si} \to [I,X]_{si}^{th}
              be the projection to the set of
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/thin+homotopy"} thin homotopy
            %p
              Say a
              = succeed "-parameterized" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mi si
                      %mi th
                  %annotation{:encoding => "application/x-tex"} [I,X]_{si}^{th}
              is one that comes from a
              = succeed "-family" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi si
                  %annotation{:encoding => "application/x-tex"} [I,X]_{si}
              under this projection. (This makes also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mi si
                      %mi th
                  %annotation{:encoding => "application/x-tex"} [I,X]_{si}^{th}
              a
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
          .num_remark
            %h6#remark Remark
            %p
              The passage to the subset and quotient
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mi si
                      %mi th
                  %annotation{:encoding => "application/x-tex"} [I,X]_{si}^{th}
              of the set of all smooth paths in the above definition is essentially the minimal adjustment to enforce that the concatenation of smooth paths at their endpoints defines the composition operation in a groupoid.
          .num_prop
            %h6#definition_2 Definition
            %p
              The
              %strong path groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{P}_1(X)
              is the groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mi si
                      %mi th
                    %mover
                      %mo →
                      %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{P}_1(X) = ([I,X]_{si}^{th} \stackrel{\to}{\to} X)
            %p
              with source and target maps given by endpoint evaluation and composition given by concatenation of classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi γ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\gamma]
              of paths along any orientation preserving
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1] \to [0,2] \simeq [0,1] \coprod_{1,0} [0,1]
              of any of their representatives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi γ
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ∘
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi γ
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mo ≃
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi γ
                          %mn 2
                        %mo ,
                        %msub
                          %mi γ
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\gamma_2] \circ [\gamma_1] : [0,1]
                    \\stackrel{\simeq}{\to} [0,1] \coprod_{1,0} [0,1]
                    \\stackrel{(\gamma_2 , \gamma_1)}{\to}
                    X
                    \\,.
            %p
              This becomes an
              %a.existingWikiWord{:href => "/nlab/show/internal+groupoid"} internal groupoid
              in
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
              with the above
              = succeed "-families" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoid-valued+presheaf"} groupoid-valued presheaf
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi Grpd
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, Grpd]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi U
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi Diff
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mi I
                    %mo ,
                    %mi X
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mi si
                      %mi th
                    %mover
                      %mo →
                      %mo →
                    %mi Diff
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{P}_1(X) : U \mapsto (Diff(U \times I, X)_{si}^{th} \stackrel{\to}{\to} Diff(U,X) )
                    \\,.
          %p
            Observe now that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            its
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
            discussed
            = succeed "," do
              %a{:href => "#PrincipalBundles"} above
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi tra
                  %mo :
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi P
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} tra : \mathbf{P}_1(X) \to \mathbf{B}G
            sends each (thin-homotopy class of a) path to an element of the group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi tra
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi γ
                      %mo{:stretchy => "false"} ]
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mo •
                  %mover
                    %mo →
                    %mrow
                      %mi tra
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi G
                  %mo •
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  tra : (x \stackrel{[\gamma]}{\to} y)
                  \\mapsto
                  (
                  \\bullet
                  \\stackrel{tra(\gamma) \in G}{\to}
                  \\bullet
                  )
          %p such that composite paths map to products of group elements
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi tra
                  %mo :
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi y
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mi γ
                                  %mo{:stretchy => "false"} ]
                            %mo ↗
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mi γ
                                  %mo ′
                                  %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi γ
                                %mo ′
                                %mo{:stretchy => "false"} ]
                                %mo ∘
                                %mo{:stretchy => "false"} [
                                %mi γ
                                %mo{:stretchy => "false"} ]
                          %mtd
                          %mtd
                            %mi z
                    %mo )
                  %mo ↦
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo •
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi tra
                                  %mo{:stretchy => "false"} (
                                  %mi γ
                                  %mo{:stretchy => "false"} )
                            %mo ↗
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi tra
                                  %mo{:stretchy => "false"} (
                                  %mi γ
                                  %mo ′
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo •
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi tra
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                                %mi tra
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo ′
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mo •
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  tra :
                  \\left(
                  \\array{
                  \&amp;&amp; y
                  \\\
                  \&amp; {}^{\mathllap{[\gamma]}}\nearrow &amp;=&amp; \searrow^{\mathrlap{[\gamma']}}
                  \\\
                  x &amp;&amp;\stackrel{[\gamma']\circ [\gamma]}{\to}&amp;&amp; z
                  }
                  \\right)
                  \\mapsto
                  \\left(
                  \\array{
                  \&amp;&amp; \bullet
                  \\\
                  \&amp; {}^{\mathllap{tra(\gamma)}}\nearrow
                  \&amp;=&amp;
                  \\searrow^{\mathrlap{tra(\gamma')}}
                  \\\
                  \\bullet &amp;&amp;\stackrel{tra(\gamma)tra(\gamma')}{\to}&amp;&amp; \bullet
                  }
                  \\right)
          %p
            and such that
            = succeed "-families" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} U \to G
            of elements.
          %p
            There is a classical construction that yields such an assignment: the
            %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie-algebra+valued+1-form"} Lie-algebra valued 1-form
          .num_prop
            %h6#definition_3 Definition
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^1(X, \mathfrak{g})
              is a degree-1
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with values in the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi tra
                      %mi A
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    tra_A : \mathbf{P}_1(X) \to \mathbf{B}G
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi γ
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mi P
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msup
                      %mi γ
                      %mo *
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [\gamma] \mapsto P \exp(\int_{[0,1]} \gamma^* A) \; \in G
                    \\,,
            %p
              where the group element on the right is defined to be the value at 1 of the unique solution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} f :  [0,1] \to G
              of the
              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi dR
                    %mi f
                    %mo +
                    %msup
                      %mi γ
                      %mo *
                    %mi A
                    %mo ∧
                    %mi f
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    d_{dR} f + \gamma^*A \wedge f = 0
            %p
              for the boundary condition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi e
                    %annotation{:encoding => "application/x-tex"} f(0) = e
          .num_prop
            %h6#theorem Theorem
            %p
              This construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %msub
                      %mi tra
                      %mi A
                  %annotation{:encoding => "application/x-tex"} A \mapsto tra_A
              induces an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [CartSp^{op},Grpd](\mathbf{P}_1(X), \mathbf{B}G)
                    \\simeq
                    \\mathbf{B}G_{conn}(X)
                    \\,,
            %p
              where on the left we have the
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
              of
              %a.existingWikiWord{:href => "/nlab/show/groupoid-valued+presheaves"} groupoid-valued presheaves
              and where on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie-algebra+valued+1-forms"} groupoid of Lie-algebra valued 1-forms
              whose
            %ul
              %li
                %p
                  objects are 1-forms
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo ∈
                          %msup
                            %mi Ω
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} A \in \Omega^1(X,\mathfrak{g})
              %li
                %p
                  morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo :
                        %msub
                          %mi A
                          %mn 1
                        %mo →
                        %msub
                          %mi A
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} g : A_1 \to A_2
                  are labeled by
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} g \in C^\infty(X,G)
                  such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mn 2
                          %mo =
                          %msup
                            %mi g
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mi A
                          %mi g
                          %mo +
                          %msup
                            %mi g
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mi d
                          %mi g
                        %annotation{:encoding => "application/x-tex"} A_2 = g^{-1} A g + g^{-1}d g
          %p
            This equivalence is
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .num_defn
            %h6#definition_4 Definition
            %p
              Define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo :
                    %msup
                      %mi CartSp
                      %mi op
                    %mo →
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn} : CartSp^{op} \to Grpd
              to be the (generalized) Lie groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo :
                    %mi U
                    %mo ↦
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G_{conn} : U \mapsto [CartSp^{op}, Grpd](\mathbf{P}_1(-), \mathbf{B}G)
            %p
              whose
              = succeed "-parameterized" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie-algebra+valued+1-forms"} groupoid of Lie-algebra valued 1-forms
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
          .num_remark
            %h6#remark_2 Remark
            %p
              This equivalence in particular subsumes the classical facts that parallel transport
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ↦
                    %mi P
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msup
                      %mi γ
                      %mo *
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma \mapsto P \exp(\int_{[0,1]} \gamma^* A)
            %ul
              %li
                %p is invariant under orientation preserving reparameterizations of paths;
              %li
                %p sends reversed paths to inverses of group elements.
          .num_lemma
            %h6#observation_2 Observation
            %p
              There is an evident natural smooth functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to \mathbf{P}_1(X)
              that includes points in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as constant paths. This induces a natural morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn} \to \mathbf{B}G
              that forgets the 1-forms.
          .num_defn
            %h6#defintion Defintion
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              that corresponds to a cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g : C(U) \to \mathbf{B}G
              under the construction discussed
              = succeed "." do
                %a{:href => "#PrincipalBundles"} above
              %strong
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is a lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              of the cocycle through
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi G
                        %mi conn
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn} \to \mathbf{B}G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi G
                              %mi conn
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ∇
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbf{B}G_{conn}
                    \\\
                    \&amp; {}^{\mathllap{\nabla}}\nearrow &amp; \downarrow
                    \\\
                    C(U) &amp;\stackrel{g}{\to}&amp; \mathbf{B}G
                    }
                    \\,.
          .num_lemma
            %h6#observation_3 Observation
            %p
              This is equivalent to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} traditional definitions
          %p
            A morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \nabla : C(U) \to \mathbf{B}G_{conn}
            is
          %ul
            %li
              %p
                on each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
                a 1-form
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi i
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo ,
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A_i \in \Omega^1(U_i, \mathfrak{g})
            %li
              %p
                on each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} U_i \cap U_j
                a function
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo ∈
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo ,
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} g_{i j} \in C^\infty(U_i \cap U_j , G)
          %p such that
          %ul
            %li
              %p
                on each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} U_i \cap U_j
                we have
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi j
                        %mo =
                        %msubsup
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo +
                        %msub
                          %mi d
                          %mi dR
                        %mo{:stretchy => "false"} )
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                      %annotation{:encoding => "application/x-tex"} A_j = g_{i j}^{-1}( A + d_{dR} )g_{i j}
            %li
              %p
                on each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo ∩
                      %msub
                        %mi U
                        %mi k
                    %annotation{:encoding => "application/x-tex"} U_i \cap U_j \cap U_k
                we have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo ⋅
                        %msub
                          %mi g
                          %mrow
                            %mi j
                            %mi k
                        %mo =
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi k
                      %annotation{:encoding => "application/x-tex"} g_{i j} \cdot g_{j k} = g_{i k}
          .num_prop
            %h6#definition_5 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mi si
                      %mi th
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi h
                  %annotation{:encoding => "application/x-tex"} [I,X]_{si}^{th} \to [I,X]^h
              the projection onto the full quotient by smooth
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              classes of paths.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi h
                    %mover
                      %mo →
                      %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_1(X) = ([I,X]^h \stackrel{\to}{\to} X)
              for the smooth groupoid defined as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi P
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{P}_1(X)
          .num_prop
            %h6#proposition Proposition
            %p The above restricts to a natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [CartSp^{op}, Grpd](\mathbf{\Pi}_1(X), \mathbf{B}G)
                    \\simeq
                    \\mathbf{\flat}\mathbf{B}G
                    \\,,
            %p
              where on the left we have the
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
              of groupoid-valued presheaves, and on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full sub-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ⊂
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{\flat}\mathbf{B}G \subset \mathbf{B}G_{conn}
              on those
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              2-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi A
                    %mo =
                    %msub
                      %mi d
                      %mi dR
                    %mi A
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ∧
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F_A = d_{dR} A + [A \wedge A]
              vanishes.
            %p
              A connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              is
              %em flat
              precisely if it factors through the inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♭
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi G
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} \flat \mathbf{B}G \to \mathbf{B}G_{conn}
          %p
            For the purposes of
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
            we want a good way to extract the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            2-form in a general abstract way from a cocycle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo :
                    %mi X
                    %mover
                      %mo ←
                      %mo ≃
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \nabla : X \stackrel{\simeq}{\leftarrow }C(U) \to \mathbf{B}G_{conn}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connections+on+2-bundles"} connections on 2-bundles
          %h3#ConnectionOn2Bundle Connections on principal 2-bundles
          %p
            There is an evident higher dimensional generalization of the definition of connections on 1-bundles in terms of functors out of the
            %a.existingWikiWord{:href => "/nlab/show/path+groupoid"} path groupoid
            discussed
            = succeed "." do
              %a{:href => "#ConnectionOnPrincipalBundle"} above
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
            and in fact which in the
            %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+an+%28%E2%88%9E%2C1%29-topos"} full theory
            follows from first principles.
          %p
            (Constructions and results in this section are from
            = succeed ")" do
              %a{:href => "http://nlab.mathforge.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos+--+references#SchrWalII+III"} SWII, SWIII
          .num_defn
            %h6#definition_6 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/path+n-groupoid"} path 2-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{P}_2(X)
              is the smooth
              %a.existingWikiWord{:href => "/nlab/show/strict+2-groupoid"} strict 2-groupoid
              analogous to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi P
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{P}_1(X)
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
              = succeed "-classes" do
                %a.existingWikiWord{:href => "/nlab/show/thin+homotopy"} thin homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi Diff
                      %mn 2
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Delta^2_{Diff} \to X
              with
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/sitting+instant"} sitting instant
            %p
              In analogy to the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{P}_1(X) \to \mathbf{\Pi}_1(X)
              there is a projection to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{P}_2(X) \to \mathbf{\Pi}_2(X)
              to the 2-groupoid obtained by dividing out full homotopy of disks, relative boundary.
          .num_lemma
            %h6#observation_4 Observation
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a strict
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-group"} Lie 2-group
              coming from a
              %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
              = succeed ".Its" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi G
                        %mn 2
                      %mover
                        %mo →
                        %mi δ
                      %msub
                        %mi G
                        %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mi α
                      %mo :
                      %msub
                        %mi G
                        %mn 1
                      %mo →
                      %mi Aut
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi G
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([G_2 \stackrel{\delta}{\to} G_1], \alpha : G_1 \to Aut(G_2))
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              is the strict
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-groupoid"} Lie 2-groupoid
              coming from the
              %a.existingWikiWord{:href => "/nlab/show/crossed+complex"} crossed complex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi G
                        %mn 2
                      %mover
                        %mo →
                        %mi δ
                      %msub
                        %mi G
                        %mn 1
                      %mover
                        %mo →
                        %mo →
                      %mo *
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [G_2 \stackrel{\delta}{\to} G_1 \stackrel{\to}{\to} *]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo •
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi g
                                      %mn 1
                              %mo ↗
                            %mtd
                              %msup
                                %mo ⇓
                                %mpadded{:width => "0"}
                                  %mi k
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi g
                                      %mn 2
                          %mtr
                            %mtd
                              %mo •
                            %mtd
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %mi δ
                                  %mo{:stretchy => "false"} (
                                  %mi k
                                  %mo{:stretchy => "false"} )
                                  %msub
                                    %mi g
                                    %mn 1
                                  %msub
                                    %mi g
                                    %mn 2
                            %mtd
                            %mtd
                              %mo •
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi g
                        %mn 1
                      %mo ,
                      %msub
                        %mi g
                        %mn 2
                      %mo ∈
                      %msub
                        %mi G
                        %mn 1
                      %mo ,
                      %mi k
                      %mo ∈
                      %msub
                        %mi G
                        %mn 2
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G
                    \=
                    \\left\{
                    \\array{
                    \&amp;&amp; \bullet
                    \\\
                    \&amp; {}^{\mathllap{g_1}}\nearrow
                    \&amp; \Downarrow^{\mathrlap{k}}&amp;
                    \\searrow^{\mathrlap{g_2}}
                    \\\
                    \\bullet &amp;&amp;\underset{\delta(k) g_1 g_2 }{\to}&amp;&amp;
                    \\bullet
                    }
                    \\;\;
                    |
                    \\;\;
                    g_1, g_2 \in G_1, k \in G_2
                    \\right\}
                    \\,.
            %p
              This induces a
              %a.existingWikiWord{:href => "/nlab/show/differential+crossed+module"} differential crossed module
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔤
                        %mn 2
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi δ
                            %mo *
                      %msub
                        %mi 𝔤
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathfrak{g}_2 \stackrel{\delta_*}{\to} \mathfrak{g}_1)
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-algebra"} Lie 2-algebra
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          .num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
              Lie group then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}K
              is the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              2-group coming from the crossed module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [K \to 1]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbf{B}K
              is the 2-group coming from the complex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi K
                      %mo →
                      %mn 1
                      %mo →
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [K \to 1 \to 1]
          %p
            A smooth 2-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_2(X) \to \mathbf{B}G
            now assigns information also to surfaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi y
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi γ
                                    %mn 1
                            %mo ↗
                          %mtd
                            %msup
                              %mo ⇓
                              %mpadded{:width => "0"}
                                %mi Σ
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi γ
                                    %mn 2
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                          %mtd
                            %munder
                              %mo →
                              %mrow
                          %mtd
                          %mtd
                            %mi z
                    %mo )
                  %mo ↦
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi y
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi tra
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi γ
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                            %mo ↗
                          %mtd
                            %msup
                              %mo ⇓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi tra
                                  %mo{:stretchy => "false"} (
                                  %mi Σ
                                  %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi tra
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi γ
                                    %mn 2
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mi z
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  \&amp;&amp; y
                  \\\
                  \&amp; {}^{\mathllap{\gamma_1}}\nearrow
                  \&amp;\Downarrow^{\mathrlap{\Sigma}}&amp;
                  \\searrow^{\mathrlap{\gamma_2}}
                  \\\
                  x &amp;&amp;\underset{}{\to}&amp;&amp; z
                  }
                  \\right)
                  \\mapsto
                  \\left(
                  \\array{
                  \&amp;&amp; y
                  \\\
                  \&amp; {}^{\mathllap{tra(\gamma_1)}}\nearrow
                  \&amp;\Downarrow^{\mathrlap{tra(\Sigma)}}&amp;
                  \\searrow^{\mathrlap{tra(\gamma_2)}}
                  \\\
                  x &amp;&amp;\to&amp;&amp; z
                  }
                  \\right)
          %p
            and thus encodes a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
          .num_prop
            %h6#proposition_2 Proposition
            %p
              There is a natural equivalence of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mn 2
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    [CartSp^{op}, 2Grpd](\mathbf{\Pi}_2(X), \mathbf{B}G)
                    \\simeq
                    \\mathbf{\flat} \mathbf{B}G
            %p
              where on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid+of+Lie+2-algebra+valued+forms"} 2-groupoid of Lie 2-algebra valued forms
              whose
            %ul
              %li
                %p
                  objects are pairs
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo ∈
                          %msup
                            %mi Ω
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mi 𝔤
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} A \in \Omega^1(X,\mathfrak{g}_1)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi 𝔤
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B \in \Omega^2(X,\mathfrak{g}_2)
                  such that the 2-form
                  %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
                        %msub
                          %mi d
                          %mi dR
                        %mi A
                        %mo +
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ∧
                        %mi A
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %msub
                          %mi δ
                          %mo *
                        %mi B
                      %annotation{:encoding => "application/x-tex"}
                        F_2(A,B) := d_{dR} A + [A \wedge A] + \delta_* B
                %p and the 3-form curvature
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 3
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
                        %msub
                          %mi d
                          %mi dR
                        %mi B
                        %mo +
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ∧
                        %mi B
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        F_3(A,B) := d_{dR} B + [A \wedge B]
                %p vanish.
              %li
                %p
                  morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi λ
                        %mo ,
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ′
                        %mo ,
                        %mi B
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\lambda,a) : (A,B) \to (A',B')
                  are pairs
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo ∈
                          %msup
                            %mi Ω
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mi 𝔤
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} a \in \Omega^1(X,\mathfrak{g}_2)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                        %mo ∈
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi G
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \lambda \in C^\infty(X,G_1)
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ′
                        %mo =
                        %mi λ
                        %mi A
                        %msup
                          %mi λ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo +
                        %mi λ
                        %mi d
                        %msup
                          %mi λ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo +
                        %msub
                          %mi δ
                          %mo *
                        %mi a
                      %annotation{:encoding => "application/x-tex"} A' = \lambda A \lambda^{-1} + \lambda d \lambda^{-1} + \delta_* a
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo ′
                        %mo =
                        %mi λ
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo +
                        %msub
                          %mi d
                          %mi dR
                        %mi a
                        %mo +
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ∧
                        %mi a
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} B' = \lambda(B) + d_{dR} a + [A\wedge a]
              %li
                %p 2-morphisms are… (exercise).
          %p
            As before, this is natural in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mo ♭
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo :
                  %mi U
                  %mo ↦
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi CartSp
                    %mi op
                  %mo ,
                  %mn 2
                  %mi Grpd
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\flat}\mathbf{B}G : U \mapsto
                  [CartSp^{op}, 2Grpd](\mathbf{\Pi}_2(U), \mathbf{B}G)
                  \\,.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              If in the above definition we use
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{P}_2(X)
              instead of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_2(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_3(A,B)
              is not required to vanish.
          .num_defn
            %h6#definition_7 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
              classified by a cocycle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} C(U) \to \mathbf{B}G
              %em flat
              %strong
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+2-bundle"} connection on a 2-bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              on it is a lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mo ∇
                                    %mi flat
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbf{\flat}\mathbf{B}G
                    \\\
                    \&amp; {}^{\mathllap{\nabla_{flat}}}\nearrow &amp; \downarrow
                    \\\
                    C(U) &amp;\stackrel{g}{\to}&amp; \mathbf{B}G
                    }
                    \\,.
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi A
                    %annotation{:encoding => "application/x-tex"} G = \mathbf{B}A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+2-bundle"} connection on a 2-bundle
              (not necessarily flat) is a lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi P
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi A
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ∇
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; [\mathbf{P}_2(-),\mathbf{B}\mathbf{B}A]
                    \\\
                    \&amp; {}^{\mathllap{\nabla}}\nearrow &amp; \downarrow
                    \\\
                    C(U) &amp;\stackrel{g}{\to}&amp; \mathbf{B}\mathbf{B}A
                    }
                    \\,.
          .num_remark
            %h6#remark_3 Remark
            %p
              We do not state the last definition for general Lie 2-groups
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              2-anafunctors out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{P}_2(X)
              do not produce the fully general notion of 2-connections that we are after, but yield a special case in between flatness and non-flatness: the case where precisely the 2-form
              = succeed "-components" do
                %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              = succeed "." do
                %a{:href => "#below"} below
            %p
              Only for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}A
              does the 2-form curvature necessarily vanish anyway, so that in this case the definition by morphisms out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{P}_2(X)
              happens to already coincide with the proper general one. This serves in the following theorem as an illustration for the toolset that we are exposing, but for the purposes of introducing the full notion of
              = succeed "-Chern-Weil" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a{:href => "#CurvatureCharacteristicsI"} Curvature characteristics of 1-bundles
              how using these one does arrive at a functorial definition of 1-connections that does generalize to the fully general definition of
              = succeed "-connections." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          .num_prop
            %h6#theorem_2 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} C(U) \to [\mathbf{P}_2(-), \mathbf{B}^2 A]
              is a cocycle in
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
              in degree 3.
            %p
              Moreover, we have a natural equivalence of
              %a.existingWikiWord{:href => "/nlab/show/bicategories"} bicategories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mn 2
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi Gerb
                      %mo ∇
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [CartSp^{op}, 2Grpd](C(U), [\mathbf{P}_2(-), \mathbf{B}^2 U(1)])
                    \\simeq
                    U(1) Gerb_\nabla(X)
                    \\,,
            %p
              where on the right we have the bicategory of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            %p
              In particular the equivalence classes of cocycles form the degree-3
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi diff
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^3_{diff}(X, \mathbb{Z}) \simeq \pi_0( [C(U), [\mathbf{P}_2(-), \mathbf{B}^2 U(1)]])
                    \\,.
          .num_remark
            %h6#remark_4 Remark
            %p
              A cocycle as above naturally corresponds to a
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"} 2-anafunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Q
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi P
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Q &amp;\to&amp; \mathbf{B}^2 U(1)
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    \\mathbf{P}_2(X)
                    }
                    \\,.
            %p
              The value of this on 2-morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{P}_2(X)
              is the
              %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
              of the connection on the 2-bundle.
            %p
              This appears for instance in the
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              of the
              %a.existingWikiWord{:href => "/nlab/show/sigma+model"} sigma model
              that describes strings charged under a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kalb-Ramond+field"} Kalb-Ramond field
          %p The following example of a flat nonabelian 2-bundle is very degenerate as far as 2-bundles go, but does contain in it the seed of a full understanding of connections on 1-bundles.
          .num_defn
            %h6#definition_8 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %em
                %a.existingWikiWord{:href => "/nlab/show/inner+automorphism+2-group"} inner automorphism 2-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi INN
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} INN(G)
              is as a groupoid the
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+infinity-bundle"} universal G-bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{E}G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mover
                        %mo →
                        %mi Id
                      %mi G
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [G \stackrel{Id}{\to} G]
          %p
            The cartoon presentation of the delooping
            %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi INN
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}INN(G)
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi INN
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo •
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi g
                                    %mn 1
                            %mo ↗
                          %mtd
                            %msup
                              %mo ⇓
                              %mpadded{:width => "0"}
                                %mi k
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi g
                                    %mn 2
                        %mtr
                          %mtd
                            %mo •
                          %mtd
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %msub
                                  %mi g
                                  %mn 3
                                %mo =
                                %msub
                                  %mi g
                                  %mn 1
                                %msub
                                  %mi g
                                  %mn 2
                                %mi k
                          %mtd
                          %mtd
                            %mo •
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo ,
                    %mi k
                    %mo ∈
                    %mi G
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}INN(G)
                  \=
                  \\left\{
                  \\array{
                  \&amp;&amp; \bullet
                  \\\
                  \&amp; {}^{\mathllap{g_1}}\nearrow
                  \&amp; \Downarrow^{\mathrlap{k}}
                  \&amp; \searrow^{\mathrlap{g_2}}
                  \\\
                  \\bullet
                  \&amp;&amp;\underset{g_3 = g_1 g_2 k}{\to}&amp;&amp;
                  \\bullet
                  }
                  \\;\;
                  \\,,
                  \\;\;
                  g_1, g_2, k \in G
                  \\right\}
                  \\,.
          .num_remark
            %h6#remark_5 Remark
            %p
              This is the Lie 2-group whose
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-algebra"} Lie 2-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inn
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} inn(\mathfrak{g})
              is the one whose
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              is the
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          .num_example
            %h6#example_2 Example
            %p By the above theorem we have that there is a bijection of sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi INN
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo ≃
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\{\mathbf{\Pi}_2(X) \to \mathbf{B} INN(G)\}
                    \\simeq
                    \\Omega^1(X, \mathfrak{g})
            %p
              of flat
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi INN
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} INN(G)
            %ul
              %li
                %p
                  the 1-form component of the 2-connection is
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
              %li
                %p
                  the vanishing of the 2-form component of the 2-curvature
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi F
                          %mi A
                        %mo +
                        %mi B
                      %annotation{:encoding => "application/x-tex"} F_2(A,B) = F_A + B
                  identifies the 2-form component of the 2-connection with the
                  %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                  2-form,
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mi F
                            %mi A
                        %annotation{:encoding => "application/x-tex"} B = - F_A
              %li
                %p
                  the vanishing of the 3-form component of the 2-curvature
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 3
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi d
                        %mi B
                        %mo +
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ∧
                        %mi B
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %msub
                          %mi d
                          %mi A
                        %mo +
                        %mo{:stretchy => "false"} [
                        %mi A
                        %mo ∧
                        %msub
                          %mi F
                          %mi A
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} F_3(A,B) = d B + [A \wedge B] = d_A + [A \wedge F_A]
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
                  satisfied by any curvature 2-form.
          %p
            This means that 2-connections with values in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi INN
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} INN(G)
            actually model 1-connections
            %em and
            keep track of their curvatures. Using this we see in the next section a general abstract definition of connections on 1-bundles that naturally support the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
          %h3#CurvatureCharacteristicsI Curvature characteristics of 1-bundles
          %p
            We now describe connections on 1-bundles in terms of their
            %em flat curvature 2-bundles
            \. This gives a general abstract notion of connections that generalizes to
            %a.existingWikiWord{:href => "/nlab/show/connections+on+%E2%88%9E-bundles"} connections on ∞-bundles
            and that supports naturally the
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
          %p
            Throughout this section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            its
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            2-groupoid and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi INN
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} INN(G)
            its
            %a.existingWikiWord{:href => "/nlab/show/inner+automorphism+2-group"} inner automorphism 2-group
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi INN
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}INN(G)
            the corresponding delooping
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-groupoid"} Lie 2-groupoid
          #BGdiff.num_defn
            %h6#definition_9 Definition
            %p
              Define the smooth groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi diff
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{diff} \in [CartSp^{op}, Grpd]
              as the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi diff
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi INN
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi INN
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G_{diff} = \mathbf{B}G \times_{\mathbf{B}INN(G)} \mathbf{\flat} \mathbf{B}INN(G)
                    \\,.
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/groupoid-valued+presheaf"} groupoid-valued presheaf
              which assigns to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              the groupoid whose objects are
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi INN
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U &amp;\to&amp; \mathbf{B}G
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{\Pi}_2(U) &amp;\to&amp; \mathbf{B}INN(G)
                    }
                    \\,,
            %p
              where the vertical morphisms are the canonical inclusions discussed above, and whose morphisms are compatible pairs of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mrow
                                  %mo ↗
                                  %mo ↘
                              %mrow
                                %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mrow
                                  %mo ↗
                                  %mo ↘
                              %mrow
                                %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi INN
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U &amp;{{\nearrow \searrow} \atop {\to}}&amp; \mathbf{B}G
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{\Pi}_2(U) &amp;{{\nearrow \searrow} \atop {\to}}&amp; \mathbf{B} INN(G)
                    }
            %p of the horizontal morphisms.
          .num_remark
            %h6#remark_6 Remark
            %p
              By the above theorems, we have over any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} U \in
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              that
            %ul
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mi diff
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{diff}(U)
                  is a 1-form
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo ∈
                          %msup
                            %mi Ω
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ,
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} A \in \Omega^1(U,\mathfrak{g})
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn 1
                        %mover
                          %mo →
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo ,
                            %mi a
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi A
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} A_1 \stackrel{(g,a)}{\to} A_2
                  is labeled by a function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ,
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} g \in C^\infty(U,G)
                  and a 1-form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ,
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a \in \Omega^1(U,\mathfrak{g})
                  such that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn 2
                        %mo =
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %msub
                          %mi A
                          %mn 1
                        %mi g
                        %mo +
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mi d
                        %mi g
                        %mo +
                        %mi a
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        A_2 = g^{-1}A_1 g + g^{-1}d g  + a
                        \\,.
                %p
                  Notice that this can always be uniquely solved for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                        %annotation{:encoding => "application/x-tex"} a
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                        %annotation{:encoding => "application/x-tex"} g
              %li
                %p
                  there are
                  %em no
                  nontrivial
                  = succeed "s," do
                    %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi INN
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}INN(G)
                  is a 2-groupoid: since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G
                  is just a 1-groupoid this is enforced by the commutativity of the above diagram.
          %p From this it is clear that
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi diff
                    %mover
                      %mo →
                      %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{diff} \stackrel{\simeq}{\to} \mathbf{B}G
              is a weak equivalence.
          %p
            So
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi diff
