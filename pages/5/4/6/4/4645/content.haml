                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
