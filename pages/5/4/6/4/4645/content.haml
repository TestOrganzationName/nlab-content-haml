                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]
                %em good replacement
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
