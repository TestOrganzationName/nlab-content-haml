                  %mrow
                    %msubsup
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                      %mn 1
                      %mi dR
                  %annotation{:encoding => "application/x-tex"} \hat {\mathbf{c}}_1^{dR}
              yields a cocycle for a 2-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                      %mn 1
                      %mi dR
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat {\mathbf{c}}_1^{dR}(g)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
