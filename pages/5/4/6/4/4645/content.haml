                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msubsup
                              %mi H
                              %mi dR
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi diff
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ≃
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mi Bund
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{H}_{conn}(X,\mathbf{B}U(1)) &amp;\to&amp; H_{dR}^2(X)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{H}(X, \mathbf{B}U(1)_{diff}) &amp;\to&amp;
                    \\mathbf{H}(X, \mathbf{\flat}_{dR} \mathbf{B}^2 U(1))
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    \\mathbf{H}(X,\mathbf{B}U(1)) \simeq U(1) Bund(X)
                    }
            %p
              is equivalent to disjoint union of groupoids of
              = succeed "-bundles" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
          %h3#CirclenBundles
            Circle
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            there is a straightforward generalization of the above constructions to
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (G = \mathbf{B}^{n-1}A)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal n-bundle
            %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} with connection
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            = succeed "," do
              %a{:href => "http://nlab.mathforge.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos+--+references#SSSIII"} SSSIII
            = succeed ")." do
              %a{:href => "http://nlab.mathforge.org/schreiber/show/differential+cohomology+in+an+(?%2C1)-topos+--+references#FSSIII"} FSS
            %a{:href => "http://ncatlab.org/nlab/show/Lie+infinity-groupoid#BnU1"} circle n-group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G = \mathbf{B}^{n-1}U(1)
          %p
            There is a familiar traditional presentation for
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            in terms of
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundles+with+connection"} circle n-bundles with connection
          .num_defn
            %h6#definition_12 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %strong Deligne complex
              is the
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              of
              %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
              (on
              %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
              in general or on
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              for our purposes here) of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mi D
                      %mn ∞
                    %mo =
                    %mrow
                      %mo [
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi C
                                %mn ∞
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo ,
                              %mi ℝ
                              %mo{:stretchy => "false"} /
                              %mi ℤ
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi d
                                    %mi dR
                            %mtd
                              %msup
                                %mi Ω
                                %mn 1
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi d
                                    %mi dR
                            %mtd
                              %mi ⋯
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi d
                                    %mi dR
                            %mtd
                              %msup
                                %mi Ω
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi d
                                    %mi dR
                            %mtd
                              %msup
                                %mi Ω
                                %mi n
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi n
                            %mtd
                            %mtd
                              %mi n
                              %mo −
                              %mn 1
                            %mtd
                            %mtd
                              %mi ⋯
                            %mtd
                            %mtd
                              %mn 1
                            %mtd
                            %mtd
                              %mn 0
                      %mo ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}(n+1)^\infty_D =
                    \\left[
                    \\array{
                    C^\infty(-,\mathbb{R}/\mathbb{Z})
                    \&amp;\stackrel{d_{dR}}{\to}&amp;
                    \\Omega^1(-)
                    \&amp;\stackrel{d_{dR}}{\to}&amp;
                    \\cdots
                    \&amp;\stackrel{d_{dR}}{\to}&amp;
                    \\Omega^{n-1}(-)
                    \&amp;\stackrel{d_{dR}}{\to}&amp;
                    \\Omega^n(-)
                    \\\
                    n &amp;&amp; n-1 &amp;&amp; \cdots &amp;&amp; 1 &amp;&amp; 0
                    }
                    \\right]
                    \\,.
          %p
            This is similar to the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            with two important differences
          %ol
            %li
              %p
                In degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                we have the sheaf of
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(1)
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mi log
                        %mo :
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d log : C^\infty(-, U(1)) \to \Omega^1(-)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ℝ
                      %mo{:stretchy => "false"} /
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} U(1) \simeq \mathbb{R}/\mathbb{Z}
                then it is just the ordinary de Rham differential applied to any representative in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(-, \mathbb{R})
                of an element in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi ℝ
                        %mo{:stretchy => "false"} /
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\infty(-, \mathbb{R}/\mathbb{Z})
            %li
              %p
                In degree 0 we do not have closed differential
                = succeed "-forms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-forms." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %p
            As before we may use of the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ξ
                  %mo :
                  %msubsup
                    %mi Ch
                    %mo •
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mover
                    %mo →
                    %mo ≃
                  %mi sAb
                  %mover
                    %mo →
                    %mi U
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} \Xi : Ch_\bullet^{+} \stackrel{\simeq}{\to} sAb \stackrel{U}{\to} sSet
            to identify sheaves of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial sheaves
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
            %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (n+1)
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi CartSp
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Ξ
                  %mi ℤ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 1
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mi D
                    %mn ∞
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H_{diff}^{n+1}(X)
                  \=
                  \\pi_0 [CartSp^{op}, sSet](
                  C(\{U_i\}), \Xi \mathbb{Z}(n+1)^\infty_D
                  )
                  \\,.
          %p
            Further using the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            this is equivalently the cohomology of the Cech-Deligne
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (n+1)
            then is a tuple
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi i
                        %mi n
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi A
                    %mrow
                      %mi i
                      %mi j
                      %mi k
                  %mo ,
                  %msub
                    %mi B
                    %mrow
                      %mi i
                      %mi j
                  %mo ,
                  %msub
                    %mi C
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (g_{i_0, \cdots, i_n}, \cdots, A_{i j k}, B_{i j}, C_{i})
          %p with
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi i
                      %mo ∈
                      %msup
                        %mi Ω
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C_i \in \Omega^n(U_i)
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mrow
                          %mi i
                          %mi j
                      %mo ∈
                      %msup
                        %mi Ω
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B_{i j} \in \Omega^{n-1}(U_i \cap U_j)
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mrow
                          %mi i
                          %mi j
                          %mi k
                      %mo ∈
                      %msup
                        %mi Ω
                        %mrow
                          %mi n
                          %mo −
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo ∩
                      %msub
                        %mi U
                        %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_{i j k } \in \Omega^{n-2}(U_i \cap U_j \cap U_k)
            %li
              %p and so on
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi i
                            %mi n
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                      %mo ∩
                      %mi ⋯
                      %mo ∩
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mi n
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g_{i_0, \cdots, i_n} \in C^\infty(U_{i_0} \cap \cdots \cap U_{i_n} , U(1))
          %p satisfying the cocycle condition
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mi dR
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi deg
                  %mi δ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi i
                        %mi n
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi A
                    %mrow
                      %mi i
                      %mi j
                      %mi k
                  %mo ,
                  %msub
                    %mi B
                    %mrow
                      %mi i
                      %mi j
                  %mo ,
                  %msub
                    %mi C
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (d_{dR} + (-1)^{deg}\delta)
                  (g_{i_0, \cdots, i_n}, \cdots, A_{i j k}, B_{i j}, C_{i})
                  \= 0
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi i
                  %msubsup
                    %mi p
                    %mi i
                    %mo *
                %annotation{:encoding => "application/x-tex"} \delta = \sum_{i} (-1)^i p_i^*
            is the alternating sum of the pullback of forms along the face maps of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
          %p This is a sequence of conditions of the form
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi i
                      %mo −
                      %msub
                        %mi C
                        %mi j
                      %mo =
                      %mi d
                      %msub
                        %mi B
                        %mrow
                          %mi i
                          %mi j
                    %annotation{:encoding => "application/x-tex"} C_i - C_j = d B_{i j}
                ;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mrow
                          %mi i
                          %mi j
                      %mo −
                      %msub
                        %mi B
                        %mrow
                          %mi i
                          %mi k
                      %mo +
                      %msub
                        %mi B
                        %mrow
                          %mi j
                          %mi k
                      %mo =
                      %mi d
                      %msub
                        %mi A
                        %mrow
                          %mi i
                          %mi j
                          %mi k
                    %annotation{:encoding => "application/x-tex"} B_{i j} - B_{i k} + B_{j k} = d A_{i j k}
                ;
            %li
              %p and so on
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi δ
                      %mi g
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi i
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} (\delta g)_{i_0, \cdots, i_{n+1}} = 0
                \.
          %p
            For low
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            we have seen these conditions in the dicussion of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            = succeed "s)" do
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi i
                    %annotation{:encoding => "application/x-tex"} C_i
                are the local connection
                = succeed "-forms;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi i
                            %mi n
                    %annotation{:encoding => "application/x-tex"} g_{i_0, \cdots, i_n}
                is the transition function of the circle
                = succeed "-bundle." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %p
            We now indicate how the Deligne complex may be derived from differential refinement of cocycles for circle
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi ch
                  %mo :
                  %mo =
                  %mi Ξ
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}^n U(1)_{ch} := \Xi U(1)[n]
                  \\,,
          %p
            for the simplicial presheaf given under the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            by the chain complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mrow
                    %mo (
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mo →
                    %mi ⋯
                    %mo →
                    %mn 0
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  U(1)[n] =
                  \\left(
                  C^\infty(-,U(1)) \to 0 \to \cdots \to 0
                  \\right)
          %p
            with the sheaf represented by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1)
            in degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of a smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(U)
              its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"} ∞-anafunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi ch
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C(U) &amp;\stackrel{g}{\to}&amp; \mathbf{B}^n U(1)_{ch}
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    X
                    }
            %p
              are in natural bijection with tuples of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi ⋯
                        %msub
                          %mi i
                          %mi n
                    %mo :
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %mo ∩
                    %mi ⋯
                    %mo ∩
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mi n
                    %mo →
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    g_{i_0 \cdots i_n} : U_{i_0} \cap \cdots \cap U_{i_n} \to \mathbb{R}/\mathbb{Z}
            %p satisfying
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %mi g
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi ⋯
                        %msub
                          %mi i
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %mo :
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mi n
                    %msub
                      %mi g
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi ⋯
                        %msub
                          %mi i
                          %mrow
                            %mi k
                            %mo −
                            %mn 1
                        %msub
                          %mi i
                          %mi k
                        %mo ⋅
                        %msub
                          %mi i
                          %mi n
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\partial g)_{i_0 \cdots i_{n+1}}
                    \:=
                    \\sum_{k = 0}^{n} g_{i_0 \cdots i_{k-1} i_k \cdot i_n}
                    \= 0
                    \\,,
            %p
              that is, to cocycles in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              with values in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
            %p Transformations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msup
                              %mi Δ
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi g
                                %mover
                                  %mo →
                                  %mi λ
                                %mi g
                                %mo ′
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi ch
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi X
                            %mo ⋅
                            %msup
                              %mi Δ
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C(U)\cdot \Delta^1 &amp;\stackrel{(g \stackrel{\lambda}{\to} g')}{\to}&amp; \mathbf{B}^n U(1)_{ch}
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    X \cdot \Delta^1
                    }
            %p
              are in natural bijection with tuples of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi ⋯
                        %msub
                          %mi i
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %mo :
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %mo ∩
                    %mi ⋯
                    %mo ∩
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %mo →
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\lambda_{i_0 \cdots i_{n-1}} : U_{i_0} \cap \cdots \cap U_{i_{n-1}} \to \mathbb{R}/\mathbb{Z}
            %p such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mo ′
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi ⋯
                        %msub
                          %mi i
                          %mi n
                    %mo −
                    %msub
                      %mi g
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi ⋯
                        %msub
                          %mi i
                          %mi n
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mi λ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mi ⋯
                        %msub
                          %mi i
                          %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    g'_{i_0 \cdots i_n}
                    \-
                    g_{i_0  \cdots i_n}
                    \=
                    (\delta \lambda)_{i_0 \cdots i_n}
                    \\,,
            %p that is, to &amp;Ccaron;ech coboundaries.
          %p
            The
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            classified by such a cocycle we may call a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle"} circle n-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            this reproduces the ordinary
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n =2
            the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 3
                %annotation{:encoding => "application/x-tex"} n=3
            the
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
          %p
            To equip these circle
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^n U(1)_{diff}
