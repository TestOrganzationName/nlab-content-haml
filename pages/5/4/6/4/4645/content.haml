                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\flat}_{dR} \mathbf{B}^n U(1)
              constitute
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
              %em genuine
              connections. The non-globally defined forms
              %em also
              constitute curvature invariants, but of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/pseudo-connection"} pseudo-connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
