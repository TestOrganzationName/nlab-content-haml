                %annotation{:encoding => "application/x-tex"} x \in \mathbb{O}
            have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi r
                      %mn 2
                    %mo +
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
