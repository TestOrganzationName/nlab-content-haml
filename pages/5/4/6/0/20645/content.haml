            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} r \in \mathbb{R}
            and
