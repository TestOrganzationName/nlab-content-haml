                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(5) \to Spin(10)
            and a 2-1 map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 6
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 10
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(4) \times Spin(6) \to Spin(10)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S(U(2) \times U(3))
            (
            %a{:href => "#BaezHuerta10"}> BaezHuerta10
            ).
          %p
            In this grand unified theory, all the right-handed
            %a.existingWikiWord{:href => "/nlab/show/fermions"} fermions
            and antifermions in one generation form of the Standard Model including a right-handed neutrino, lie in a single representation of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 10
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(10)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spinor+representation"} spinor representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 16
                %annotation{:encoding => "application/x-tex"} \mathbf{16}
            because it is 16-dimensional. Similarly, the left-handed fermions and antifermions lie in the left-handed Weyl spinor representation, which is the dual
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 16
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \mathbf{16}\ast
          %p
            These representations can be constructed explicitly in a number of ways. For example, they are commonly described as the even and odd subspaces of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %msup
                      %mi ℂ
                      %mn 5
                  %annotation{:encoding => "application/x-tex"} \Lambda \mathbb{C}^5
          %h2#octonionic_construction_of_representation Octonionic construction of representation
          %p
            The group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 10
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(10)
            has two 16-dimensional faithful irreducible complex representations called its left-handed and right-handed Weyl
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spinor+representation"} spinor representation
            = succeed ")" do
              %a{:href => "#Bryant20"} Bryant 20
            %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            as follows.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi ℝ
                  %mo ⊕
                  %mi 𝕆
                %annotation{:encoding => "application/x-tex"} (r,x) \in \mathbb{R} \oplus \mathbb{O}
            define a linear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mrow
                      %mi r
                      %mo ,
                      %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℂ
                  %mo ⊗
                  %msup
                    %mi 𝕆
                    %mn 2
                  %mo →
                  %mi ℂ
                  %mo ⊗
                  %msup
                    %mi 𝕆
                    %mn 2
                %annotation{:encoding => "application/x-tex"} m_{r,x} \colon \mathbb{C} \otimes \mathbb{O}^2 \to \mathbb{C} \otimes \mathbb{O}^2
            as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mrow
                      %mi r
                      %mo ,
                      %mi x
                  %mo =
                  %mi i
                  %mrow
                    %mo (
                    %mtable{:columnalign => "center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi r
                        %mtd
                          %mi C
                          %msub
                            %mi R
                            %mi x
                      %mtr
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi C
                          %msub
                            %mi L
                            %mi x
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi r
                    %mo )
                %annotation{:encoding => "application/x-tex"} m_{r,x} = i \left( \begin{array}{cc} r &amp; C R_x \\ -C L_x &amp; -r  \end{array}   \right)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            here denotes multiplication by the real number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi x
                  %mo ,
                  %msub
                    %mi R
                    %mi x
                  %mo ,
                  %mi C
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝕆
                  %mo →
                  %mi 𝕆
                %annotation{:encoding => "application/x-tex"} L_x, R_x, C \colon \mathbb{O} \to \mathbb{O}
            are left multiplication by the octonion
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and octonionic conjugation, respectively. Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi m
                    %mrow
                      %mi r
                      %mo ,
                      %mi x
                    %mn 2
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mi r
                    %mn 2
                  %mo −
                  %msup
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} |
                    %mn 2
                %annotation{:encoding => "application/x-tex"} m_{r,x}^2 = - r^2 -{|x|}^2
            this map induces an action of the
            %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cliff
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo ⊕
                  %mi 𝕆
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cliff(\mathbb{R} \oplus \mathbb{O})
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo ⊗
                    %msup
                      %mi 𝕆
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{C} \otimes \mathbb{O}^2
            %em minus
            1). One can show that this action gives an isomorphism of complex associative algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cliff
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo ⊕
                  %mi 𝕆
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo ⊗
                  %msup
                    %mi 𝕆
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cliff(\mathbb{R} \oplus \mathbb{O}) \cong End(\mathbb{C} \otimes \mathbb{O}^2)
          %p
            where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo ⊗
                    %msup
                      %mi 𝕆
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} End(\mathbb{C} \otimes \mathbb{O}^2)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
