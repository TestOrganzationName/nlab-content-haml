                      %mi 𝕆
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{C} \otimes \mathbb{O}^2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 16
                  %mo ×
                  %mn 16
                %annotation{:encoding => "application/x-tex"} 16 \times 16
            complex matrices.
          %p
            The group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
