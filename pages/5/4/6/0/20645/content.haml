                            %mi L
                            %mi x
                        %mtd
                          %mi r
                    %mo )
                %annotation{:encoding => "application/x-tex"} \left( \begin{array}{cc} r &amp; C R_x \\ -C L_x &amp; r \end{array}   \right)
          %p
