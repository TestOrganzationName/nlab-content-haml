                          %mo ,
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; [\hat \mathbf{c}]
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  [c] &amp;&amp; &amp;&amp; [\langle F_\nabla \wedge \cdots F_\nabla\rangle]
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; [c]_{\mathbb{R}}
                  }
                  \\;\;\;\;\;\;\;\;\;
                  \\in
                  \\;\;\;\;\;\;\;\;\;
                  \\array{
                  \&amp;&amp; H_{diff}^n(X)
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  H^n(X,\mathbb{Z}) &amp;&amp; &amp;&amp; H_{dR}^n(X)
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; H^n(X, \mathbb{R})
                  }
                  \\,.
          %p
            A central
            %strong implication
            of the last step is that with the refinement from
            %a.existingWikiWord{:href => "/nlab/show/curvatures"} curvatures
            in
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            to
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundles+with+connection"} circle n-bundles with connection
            in
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            is that these come with a notion of
            %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
            and higher
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
          %ul
            %li
              %p
                the local connection form of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}
                is the
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cs
                      %mo{:stretchy => "false"} (
                      %mo ∇
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} cs(\nabla)
                of a
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cs
                    %annotation{:encoding => "application/x-tex"} cs
                of the
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle- \rangle
                evaluated on the given
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            %li
              %p
                the corresponding
                %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
                as an assignment
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mover
                        %mo →
                        %mi ϕ
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi exp
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                      %mstyle{:displaystyle => "false"}
                        %mrow
                          %msub
                            %mo ∫
                            %mi Σ
                        %msub
                          %mo ∇
                          %mover
                            %mstyle{:mathvariant => "bold"}
                              %mi c
                            %mo{:stretchy => "false"} ^
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mo ∈
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (\Sigma \stackrel{\phi}{\to} X)
                      \\mapsto
                      \\exp\Big(
                      \\textstyle{\int_\Sigma}
                      \\nabla_{\hat \mathbf{c}}
                      \\Big)
                      \\in U(1)
              %p
                of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n-1)
                %a.existingWikiWord{:href => "/nlab/show/dimensional"} dimensional
                manifolds in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the
                %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
                is the
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                of the corresponding
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
          %p Specifically
          %ul
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle  -,-\rangle
                the
                %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
                invariant polynomial on a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}
                the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+3-bundle"} Chern-Simons circle 3-bundle
                %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
                is the
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                of ordinary
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle -,-,-,-\rangle
                the next higher invariant polynomial on a semisimple Lie algebra,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+7-bundle"} Chern-Simons circle 7-bundle
          %p
            So the refined Chern-Weil homomorphism provides a large family of
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theories"} quantum field theories
            of Chern-Simons type in odd
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connections
            on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %a.existingWikiWord{:href => "/nlab/show/Lagrangians"} Lagrangians
            are [Chern-Simons element]]s on a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
          %p
            But the notion of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebroid"} L-∞ algebroid
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+homomorphism"} ∞-Chern-Weil homomorphism
            \. Accordingly this gives rise to a wide class of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theories"} quantum field theories
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theories"} ∞-Chern-Simons theories
          %h2#generalizations Generalizations
          %h3#to_principal_bundles
            To principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            The notions of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            and all the other ingredients of ordinary Chern-Weil theory generalize to notions in
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+group"} ∞-Lie group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            etc. The generalization of Chern-Weil theory to this context is discussed at
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+theory"}> ∞-Chern-Weil theory
              \.
          %h3#in_noncommutative_geometry In noncommutative geometry
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative
            analogue discussed in (
            %a{:href => "#AlekseevMeinrenken"}> AlekseevMeinrenken2000
            ).
          %h2#examples_and_applications Examples and applications
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gauss-Bonnet+theorem"} Gauss-Bonnet theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/differential+string+structure"} differential string structure
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/differential+fivebrane+structure"} differential fivebrane structure
          %h2#History History
          %blockquote
            %p
              (following notes provided by
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
          %p
            The beginnings of the
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and hence their
            = succeed "-description" do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            originate in the first half of the 20th century.
          %p In his survey of what was known in 1936 on the homology of compact Lie groups
          %ul
            %li
              %p
                %span.newWikiWord>
                  Eli Cartan
                  %a{:href => "/nlab/new/Eli+Cartan"} ?
                ,
                %em La topologie des espaces représentatifs des groupes de Lie
                Act. Sci. Ind., No. 358, Hermann, Paris, (1936).
              %p
                reprinted in
                %em Cartan’s Complete Works
                vol
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} I_2
                pp. 1307-1330
          %p
            E. Cartan conjectured that there should be a general result implying that the
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            of the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/classical+Lie+group"} classical Lie group
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
            = succeed "s" do
              %span.newWikiWord
                Poincare polynomial
                %a{:href => "/nlab/new/Poincare+polynomial"} ?
          %p In
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Heinz+Hopf"}> Heinz Hopf
              ,
              %em Über die Topologie der Gruppen-Mannigfaltigkeiten und ihre Verallgemeinerungen
              (German) Ann. of Math. (2) 42, (1941). 22–52.
          %p
            Hopf showed that such a characterization in terms of homology groups as
            %a.existingWikiWord{:href => "/nlab/show/intersection+pairing"} intersection pairing
            algebras holds for any
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/dimension"} finite dimensional
            %a.existingWikiWord{:href => "/nlab/show/connected"} connected
            %a.existingWikiWord{:href => "/nlab/show/orientable"} orientable
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            with a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo :
                  %mi M
                  %mo ×
                  %mi M
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} m:M\times M\to M
            such that left and right translation have non-zero degrees.
          %p Later in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Shiing-shen+Chern"}> Shiing-shen Chern
              ,
              %em Differential geometry of fiber bundles
              Proceedings of the International Congress of Mathematicians, Cambridge, Mass., 1950, vol. 2, pages 397-411, Amer. Math. Soc., Providence, R. I. (1952)
          %p
            with the development of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^\bullet(G)
            being
            %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
            to an
            %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
            on odd dimensional generators: the generating
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo ∈
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu \in CE(\mathfrak{g})
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                    %mi μ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d_{CE(\mathfrak{g})} \mu = 0
          %p Henri Cartan in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Henri+Cartan"}> Henri Cartan
                ,
                %em Notions d’algébre différentielle; applications aux groupes de Lie et aux variétés où opère un groupe de Lie
                , Coll. Topologie Algébrique Bruxelles (1950)
              %p 15-28
              %p
                section 7, titled
                %em Classes caracteristiques (reelles) d’un espace fibre principal
          %p
            at the end (1951) of an era of deRham cohomology dominance (prior to Serre’s thesis) abstracted the
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometric
            approach of Chern-Weil and the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
            to the
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            context with his notion of
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              \-algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            \. This involves what is known sometimes as the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cartan+calculus"} Cartan calculus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and the
            %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{L}_X
            with respect to vector fields. that is, he posits 3 operators on a differential-graded-commutative alggebra (dgca):
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            of degree 1,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mi X
                %annotation{:encoding => "application/x-tex"} i_X
            of degree -1 and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi X
                %annotation{:encoding => "application/x-tex"} L_X
            of degree 0 for X in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            subject to the relations:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi ι
                        %mi X
                      %mo ,
                      %msub
                        %mi ι
                        %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %msub
                        %mi ι
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\iota_X,\iota_Y] = \iota_{[X,Y]}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi ℒ
                        %mi X
                      %mo ,
                      %msub
                        %mi ι
                        %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %msub
                        %mi ι
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathcal{L}_X,\iota_Y]= \iota_{[X,Y]}
          %p and perhaps most useful
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi X
                    %mo =
                    %mi d
                    %msub
                      %mi ι
                      %mi X
                    %mo +
                    %mi i
                    %msub
                      %mi ι
                      %mi X
                    %mi d
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}_X = d \iota_X + i\iota_X d
          %p
            This is what he terms a
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %p
            For Cartan, an infinitesimal
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            on a
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            are projectors (at each point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi p
                  %mo :
                  %msub
                    %mi T
                    %mi p
                  %mi P
                  %mo →
                  %msubsup
                    %mi T
                    %mi p
                    %mi vert
                %annotation{:encoding => "application/x-tex"} \phi_p: T_p P\to T_p^{vert}
            equivariant with repect to the
            = succeed "-action." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^\bullet(P) \leftarrow \mathfrak{g}^* : A
          %p
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            %a.existingWikiWord{:href => "/nlab/show/Lie-algebra+valued+1-form"} Lie-algebra valued 1-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1(P,\mathfrak{g})
            – such that the two
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} Ehresmann condition
          %ol
            %li
              %p
                restricted to the fibers the 1-form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is the
                %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi X
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi ι
                        %mi X
                      %mi h
                    %annotation{:encoding => "application/x-tex"} \iota_X A(h) = \iota_X h
            %li
              %p the form is equivariant in that
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℒ
                        %mi X
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi A
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℒ
                        %mi X
                      %mi h
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}_X A (h) = A(\mathcal{L}_X h)
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} X\in \mathfrak{g}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∈
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} h\in \mathfrak{g}^*
            %em algebraic connection
            \.
          %p
            He then extends such an
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} graded algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^\bullet(P) \leftarrow CE(\mathfrak{g}) : A
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^*
          %p
            In general, this will not respect the differentials, hence not be a morphism of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            of the connection: the curvature tensor is the map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ↦
                    %msub
                      %mi d
                      %mi dR
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi CE
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h\mapsto d_{dR} A(h)-A(d_{CE} h)
          %blockquote
            %p
              Jim: HAVE TO BREAK OFF NOW - WHAT WILL COME NEXT IS the
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
              as a Cartan
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %ul
            %li
              Weil,
              %em Geometrie differentielle des espaces fibres
              (1949, unpublished) appears in Vol. 1, pp. 422-436, of his Collected Papers.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+classifying+space"} Sullivan model of classifying space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
          %h2#references References
          %div
            %h3#chernweil_homomorphism Chern-Weil homomorphism
            %h4#original_articles Original articles
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential-geometric
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
              (evaluating
              %a.existingWikiWord{:href => "/nlab/show/curvature+2-forms"} curvature 2-forms
              of
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+principal+bundle"} connections
              in
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomials"} invariant polynomials
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+map"} Cartan's map
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Henri+Cartan"}> Henri Cartan
                  , Section 7 of:
                  = succeed "," do
                    %em Cohomologie réelle d’un espace fibré principal différentiable. I : notions d’algèbre différentielle, algèbre de Weil d’un groupe de Lie
                  = succeed ")" do
                    %a{:href => "http://www.numdam.org/item/?id=SHC_1949-1950__2__A18_0"} numdam:SHC_1949-1950__2__A18_0
                %p
                  %br/
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Henri+Cartan"}> Henri Cartan
                  , Section 7 of:
                  = succeed "," do
                    %em Notions d’algèbre différentielle; applications aux groupes de Lie et aux variétés où opère un groupe de Lie
                  = succeed "," do
                    %em Colloque de Topologie (Espaces Fibrés) Tenu à Bruxelles du 5 au 8 juin 1950
                  = succeed "," do
                    %a{:href => "https://books.google.de/books/about/Colloque_de_topologie_espaces_fibres.html?id=sagqHQAACAAJ&redir_esc=y"} GoogleBooks
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/files/CartanNotionsDAlgebreDifferentielle.pdf", :title => "pdf"} pdf
                %p reprinted in the appendix of:
                %ul
                  %li#GuilleminSternberg99
                    %a.existingWikiWord{:href => "/nlab/show/Victor+Guillemin"}> Victor Guillemin
                    ,
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/Shlomo+Sternberg"} Shlomo Sternberg
                    = succeed "," do
                      %em Supersymmetry and equivariant de Rham theory
                    = succeed ")" do
                      %a{:href => "https://link.springer.com/book/10.1007/978-3-662-03992-2"} doi:10.1007/978-3-662-03992-2
            %p
              %br/
            %p
              (These two articles have the same content, with the same section outline, but not the same wording. The first one is a tad more detailed. The second one briefly attributes the construction to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Weil"} Weil
            %p and around equation (10) of:
            %ul
              %li#Chern50
                %a.existingWikiWord{:href => "/nlab/show/Shiing-shen+Chern"}> Shiing-shen Chern
                ,
                = succeed "," do
                  %em Differential geometry of fiber bundles
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/files/Chern-DifferentialGeometryOfFiberBundles.pdf", :title => "pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://www.mathunion.org/fileadmin/ICM/Proceedings/ICM1950.2/ICM1950.2.ocr.pdf"} full proceedings vol 2 pdf
            %p
              It is the independence of this construction under the choice of connection which
              %a{:href => "#Chern50"} Chern 50
              attributes (below equation 10) to the unpublished
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Weil"}> André Weil
                ,
                = succeed "," do
                  %em Géométrie différentielle des espaces fibres
                = succeed "," do
                  %em André Weil Oeuvres Scientifiques / Collected Papers
                = succeed ")" do
                  %a{:href => "https://www.springer.com/gp/book/9783662452561"} ISBN:978-3-662-45256-1
            %p
              The proof is later recorded, in print, in:
              = succeed "," do
                %a{:href => "#Chern51"} Chern 51, III.4
              = succeed "." do
                %a{:href => "#KobayashiNomizu63"} Kobayashi-Nomizu 63, XII, Thm 1.1
            %p
              But the main result of
              %a{:href => "#Chern50"} Chern 50
              (later called the
              %em fundamental theorem
              in
              = succeed ")" do
                %a{:href => "#Chern51"} Chern 51, XII.6
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theoretic
              %a.existingWikiWord{:href => "/nlab/show/universal+characteristic+classes"} universal characteristic classes
              from the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
              along the
              %a.existingWikiWord{:href => "/nlab/show/classifying+map"} classifying map
              of the given
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %p
              This fundamental theorem is equation (15) in
              %a{:href => "#Chern50"} Chern 50
              (equation 31 in
              = succeed ")," do
                %a{:href => "#Chern51"} Chern 51
            %blockquote
              %p
                methods initiated by
                %a.existingWikiWord{:href => "/nlab/show/Eli+Cartan"} E. Cartan
                and recently developed with success by
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Henri+Cartan"} H. Cartan
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Claude+Chevalley"} Chevalley
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Koszul"} Koszul
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jean+Leray"} Leray
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Weil"} Weil
                [13]
            %p Here reference 13 is:
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Koszul"}> Jean-Louis Koszul
                ,
                = succeed "," do
                  %em Homologie et cohomologie des algebres de Lie
                = succeed ")" do
                  %a{:href => "http://www.numdam.org/item/BSMF_1950__78__65_0"} numdam:BSMF_1950__78__65_0
            %p
              More in detail, Chern’s proof of the fundamental theorem (
              %a{:href => "#Chern50"}> Chern 50, (15)
              ,
              = succeed ")" do
                %a{:href => "#Chern51"} Chern 51, III (31)
            %ol
              %li
                %p
                  the fact that
                  %a.existingWikiWord{:href => "/nlab/show/invariant+polynomials"} invariant polynomials
                  constitute the
                  %a.existingWikiWord{:href => "/nlab/show/real+cohomology"} real cohomology
                  of the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi inv
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %msup
                            %mi H
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi G
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} inv(\mathfrak{g}) \simeq H^\bullet(B G)
                %ul
                  %li
                    %p
                      %a{:href => "#Chern51"} Chern 51, III.5
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/Raoul+Bott"}> Raoul Bott
                      ,
                      = succeed "," do
                        %em On the Chern-Weil homomorphism and the continuous cohomology of Lie-groups
                      = succeed ")" do
                        %a{:href => "https://doi.org/10.1016/0001-8708(73)90012-1"} doi:10.1016/0001-8708(73)90012-1
                %p Some authors later call this the “abstract Chern-Weil isomorphism”.
              %li
                %p
                  existence of
                  %a.existingWikiWord{:href => "/nlab/show/universal+connections"} universal connections
                  for manifolds in bounded dimension (see
                  = succeed ")," do
                    %a{:href => "cellular+approximation+theorem#FiniteDimensionalUniversalBundles"} here
                %ul
                  %li#NarasimhanRamanan61
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/Mudumbai+Narasimhan"}> Mudumbai Narasimhan
                      ,
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/Sundararaman+Ramanan"} Sundararaman Ramanan
                      = succeed "," do
                        %em Existence of Universal Connections
                      = succeed ")" do
                        %a{:href => "https://www.jstor.org/stable/2372896"} jstor:2372896
                  %li#NarasimhanRamanan63
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/Mudumbai+Narasimhan"}> Mudumbai Narasimhan
                      ,
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/Sundararaman+Ramanan"} Sundararaman Ramanan
                      = succeed "," do
                        %em Existence of Universal Connections II
                      = succeed ")" do
                        %a{:href => "https://www.jstor.org/stable/2373211"} jstor:2373211
                  %li#Schlafly80
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/Roger+Schlafly"}> Roger Schlafly
                      ,
                      = succeed "," do
                        %em Universal connections
                      = succeed ")" do
                        %a{:href => "https://doi.org/10.1007/BF01390314"} doi:10.1007/BF01390314
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/Roger+Schlafly"}> Roger Schlafly
                      ,
                      = succeed "," do
                        %em Universal connections: the local problem
                      = succeed ")" do
                        %a{:href => "https://projecteuclid.org/euclid.pjm/1102734394"} euclid:pjm/1102734394
            %h4#review Review
            %p
              Review of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
            %ul
              %li#Chern51
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Shiing-Shen+Chern"}> Shiing-Shen Chern
                  , Chapter III of:
                  = succeed "," do
                    %em Topics in Differential Geometry
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/files/Chern-IASNotes1951.pdf", :title => "pdf"} pdf
              %li#KobayashiNomizu63
                %p
