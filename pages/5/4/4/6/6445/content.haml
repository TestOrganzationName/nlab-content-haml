          #Matroid.num_defn
            %h6 Definition
            %p
              A
              %strong matroid
              on a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/Moore+closure"} closure operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cl
                    %mo{:lspace => "verythinmathspace"} :
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cl \colon P(X) \to P(X)
              satisfying the
              = succeed ":" do
                %em exchange axiom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} a, b \in X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊆
                      %mi X
                    %annotation{:encoding => "application/x-tex"} S \subseteq X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mi b
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ∖
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \in cl(S \cup\{b\}) \setminus cl(S)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ∖
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in cl(S \cup\{a\}) \setminus cl(S)
          %p
          .num_remark
            %h6 Remark
            %p
              Without loss of generality, the exchange axiom can be stated as: if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo +
                      %mo{:stretchy => "false"} {
                      %mi b
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ∖
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \in cl(S + \{b\}) \setminus cl(S)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo +
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ∖
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in cl(S + \{a\}) \setminus cl(S)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} b \in S
          %p
          .num_remark
            %h6 Remark
            %p
              When
              %a.existingWikiWord{:href => "/nlab/show/combinatorics"} combinatorialists
              speak of matroids as such,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is usually taken to be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              some finite
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of a
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cl
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mo ∩
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cl(S) \,\coloneqq\, X \cap Span(S)
              for any
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊆
                      %mi X
                    %annotation{:encoding => "application/x-tex"} S \subseteq X
          %p Further terminology:
          %p
          #Bases.num_defn
            %h6 Definition
            %p
              Under Def.
              = succeed ":" do
                %a.maruku-ref{:href => "#Matroid"}
            %ol
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ⊆
                        %mi X
                      %annotation{:encoding => "application/x-tex"} S \subseteq X
                  is called
                  %em independent
                  if there is a strict inclusion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cl
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi cl
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} cl(T) \subset cl(S)
                  for every strict inclusion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo ⊂
                        %mi S
                      %annotation{:encoding => "application/x-tex"} T \subset S
                  (this is the same as requiring
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∉
                        %mi cl
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo ∖
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x \notin cl(S\setminus \{x\})
                  for every
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ∈
                          %mi S
                        %annotation{:encoding => "application/x-tex"} x \in S
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} S \subset X
                  is called a
                  %em basis
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cl
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi X
                      %annotation{:encoding => "application/x-tex"} cl(S) = X
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  is independent.
              %li
                %p
                  A
                  %em hyperplane
                  is a closed subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  (meaning
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi cl
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi S
                        %annotation{:encoding => "application/x-tex"} cl(S) = S
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
            %p
          %p
            It is possible to axiomatize the notion of matroid by taking bases (Def.
            = succeed ")" do
              %a.maruku-ref{:href => "#Bases"}
            %em cryptomorphism
            between these differing definitions. Much of the power and utility of matroid theory comes from this multiplicity of definitions and the possibility of moving seamlessly between them; for example, a matroid structure might be easy to detect from the viewpoint of one definition, but not from another.
          #dim1.num_prop
            %h6#proposition Proposition
            %p
              Any two bases (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Bases"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              have the same
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
          %p
            The cardinality of such a basis is called of course the
            %em
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            of the matroid. Clearly then a finite matroid has a well-defined dimension.
          .proof
            %h6#proof Proof
            %p
              First, suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is an independent set and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is a finite basis, and suppose there are subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mo ⊆
                    %mi A
                    %mo ,
                    %msub
                      %mi B
                      %mn 0
                    %mo ⊆
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A_0 \subseteq A, B_0 \subseteq B
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mo ∪
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} A_0 \cup B_0
              is a basis. We claim that for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                      %mo ∖
                      %msub
                        %mi A
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} a \in A \setminus A_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} b \in B_0
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo{:stretchy => "false"} }
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mn 0
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_0 \cup \{a\} \cup (B_0 \setminus \{b\})
              is a basis. For, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊆
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C \subseteq B_0
              be of minimum cardinality such that
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 0
                      %mo ∪
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \in cl(A_0 \cup C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              must be inhabited since
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∉
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ⊇
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \notin cl(A \setminus \{a\}) \supseteq cl(A_0)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ∩
                      %msub
                        %mi A
                        %mn 0
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} C \cap A_0 = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              be an element of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mo ¬
                    %mi cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} a \in cl(A_0 \cup (C \setminus \{b\}) \cup \{b\}) \cap \neg cl(A_0 \cup (C \setminus \{b\})),
            %p
              it follows from the exchange axiom that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 0
                      %mo ∪
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mi b
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in cl(A_0 \cup (C \setminus \{b\}) \cup \{a\})
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 0
                      %mo ∪
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi B
                        %mn 0
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mi b
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in cl(A_0 \cup (B_0 \setminus \{b\}) \cup \{a\})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mn 0
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mo ∪
                    %msub
                      %mi B
                      %mn 0
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} cl(A_0 \cup (B_0 \setminus \{b\}) \cup \{a\}) = cl(A_0 \cup B_0 \cup \{a\}) = X
            %p
              so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ≔
                    %msub
                      %mi A
                      %mn 0
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mn 0
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} D \coloneqq A_0 \cup (B_0 \setminus \{b\}) \cup \{a\}
              “spans”
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is independent: if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
