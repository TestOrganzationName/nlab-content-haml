              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≠
                      %mi a
                    %annotation{:encoding => "application/x-tex"} x \neq a
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cl
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi cl
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mo ∪
                    %msub
                      %mi B
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cl(D \setminus \{x\}) \subseteq cl((A_0 \cup B_0) \setminus \{x\})
            %p
              with neither side containing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mo ∪
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} A_0 \cup B_0
              is independent; whereas if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} x = a
              and supposing to the contrary that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 0
                      %mo ∪
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi B
                        %mn 0
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mi b
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \in cl(D \setminus \{a\}) = cl((A_0 \cup (B_0 \setminus \{b\}))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_0 \cup (B \setminus \{b\})
              has the same span as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              already spans,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 0
                      %mo ∪
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi B
                        %mn 0
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mi b
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} b \in cl(A_0 \cup (B_0 \setminus \{b\}))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mo ∪
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} A_0 \cup B_0
              is independent. This proves the claim.
            %p
              Again assuming
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              independent and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is a finite basis, now we show that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi card
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi card
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} card(A) \leq card(B)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mi card
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} n = card(B)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi a
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a_1, \ldots, a_{n+1} \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 0
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} A_0 = \emptyset
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mn 0
                      %mo =
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B_0 = B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi b
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{a_1, \ldots, a_i\} \cup (B \setminus \{b_1, \ldots, b_i\})
              is a basis for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ≤
                      %mi i
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 1 \leq i \leq n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{a_1, \ldots, a_n\}
              spans
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi a
                        %mi n
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a_{n+1} \in cl(\{a_1, \ldots, a_{n}\})
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %h3#ModelTheoreticGeometry Model-theoretic geometry
          %p
            Essentially the very same notion arises in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+theory"} model theory
            %em infinite
            matroids. The notion arises in the study of geometry of strongly minimal sets, with applications to stability theory (part of Shelah’s classification theory).
          %p
          .num_defn
            %h6 Definition
            %p
            %p
              A
              %em pregeometry
              (in
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/model+theory"} model theory
              = succeed "," do
                %a.maruku-ref{:href => "#Matroid"}
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/closure+operator"} closure operator
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cl
                    %annotation{:encoding => "application/x-tex"} cl
              = succeed ":" do
                %em finitary
            %ul
              %li
                for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ⊆
                        %mi X
                      %annotation{:encoding => "application/x-tex"} S \subseteq X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \in cl(S)
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \in cl(S_0)
                for some
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
                %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mn 0
                        %mo ⊆
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S_0 \subseteq S
            %p
              A
              %em geometry
              is a pregeometry such that, in addition:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cl
                        %mo{:stretchy => "false"} (
                        %mo ∅
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo ∅
                      %annotation{:encoding => "application/x-tex"} cl(\varnothing) = \varnothing
                  (the
                  %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty subset
                  is closed),
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi cl
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} cl(\{x\}) = \{x\}
                  for every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  (all
                  %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                  subsets are closed).
            %p
          %p
            (See also
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometric+stability+theory"} geometric stability theory
          %p
            The language of independence, spanning, and basis carry over as before. A maximal independent set spans (i.e., is a basis), and maximal independent sets exist according to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} Zorn's lemma
          #welldefined.num_prop
            %h6#proposition_2 Proposition
            %p
              In a pregeometry
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi cl
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X, cl)
          .proof
            %h6#proof_2 Proof
            %p
              We already
              %a{:href => "#dim1"} proved this
              in the case where the pregeometry has a finite basis. Otherwise, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is independent and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is an infinite basis, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi A
                    %mo ∩
                    %mi X
                    %mo =
                    %mi A
                    %mo ∩
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mrow
                        %msub
                          %mi B
                          %mn 0
                        %mo ⊆
                        %mi B
                        %mspace{:width => "thickmathspace"}
                        %mi finite
                    %mi cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mrow
                        %msub
                          %mi B
                          %mn 0
                        %mo ⊆
                        %mi B
                        %mspace{:width => "thickmathspace"}
                        %mi finite
                    %mi A
                    %mo ∩
                    %mi cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A = A \cap X = A \cap \bigcup_{B_0 \subseteq B\; finite} cl(B_0) = \bigcup_{B_0 \subseteq B\; finite} A \cap cl(B_0)
            %p
              where the second equality follows from the finitary condition. Since each summand
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \cap cl(B_0)
              has cardinality less than that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} B_0
              by independence of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (noting that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} B_0
              is a basis of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi B
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} cl(B_0)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi card
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} card(B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi card
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi card
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} card(A) \leq card(B)
              it follows that any two bases have the same cardinality.
          %h2#Examples Examples
          %p Vector spaces, algebraic closures, graphs, restrictions, localizations, …
          %ul
            %li
              %p
                A
                %em graphic matroid
                is a matroid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                derived from a
                %a.existingWikiWord{:href => "/nlab/show/simple+graph"} simple graph
                by taking the underlying set of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                to be the set of edges
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                those
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊆
                      %mi E
                    %annotation{:encoding => "application/x-tex"} S \subseteq E
                such that the edges of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                (and their incident vertices) form a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/forest"} forest
            %li
              %p
                A
                %em vector matroid
                is a matroid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                derived from a a collection of vectors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                in a vector space. Independent sets of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                are those
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊆
                      %mi E
                    %annotation{:encoding => "application/x-tex"} S \subseteq E
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is linearly independent. Providing an equivalence to such a vector matroid is the problem of representability over a specified field.
            %li
              %p
                An
                %em algebraic matroid
                for a field extension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} /
                      %mi F
                    %annotation{:encoding => "application/x-tex"} K/F
                is derived from a collection of elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ⊂
                      %mi K
                    %annotation{:encoding => "application/x-tex"} E \subset K
                and independent sets of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                are those such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(S)
                has transcendence degree equal to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi S
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %annotation{:encoding => "application/x-tex"} \mid S \mid
                so all of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                are algebraically independent.
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                is a (finite) matroid, then the
                %em matroid dual
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi M
                        %mo *
                    %annotation{:encoding => "application/x-tex"} M^\ast
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                has the same underlying set as
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi M
                        %mo *
                    %annotation{:encoding => "application/x-tex"} M^\ast
                is precisely the complement of a basis of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi M
                        %mrow
                          %mo *
                          %mo *
                      %mo ≅
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M^{\ast\ast} \cong M
                (this is even an equality according to the definition).
            %li
              %p
                For a topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                the exchange condition is equivalent to
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∀
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi X
                      %mo :
                      %mi x
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ⇔
                      %mi y
                      %mo ∈
                      %mi cl
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \forall x,y \in X: x\in cl({y}) \Leftrightarrow y\in cl({x})
              %p
                In particular, every
                = succeed "-space" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} T1
          %h2#properties Properties
          %h3#mnevs_theorem Mnev’s theorem
          %p
            Mnëv’s universality theorem says that any
            %a.existingWikiWord{:href => "/nlab/show/semialgebraic+set"} semialgebraic set
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            defined over integers is stably equivalent to the realization space of some oriented matroid.
          %h3#combinatorial_optimization Combinatorial optimization
          %p (…)
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/oriented+matroid"} oriented matroid
