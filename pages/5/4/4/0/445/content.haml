                    %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
          %h2#properties Properties
          %h3#basic_properties Basic properties
          #PreservationOfUnionsAndIntersectionsOfSets.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/images+preserve+unions"} images preserve unions
                but not in general
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              be a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              between
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi S
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{S_i \subset X\}_{i \in I}
              be a set of
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi im
                          %mi f
                        %mrow
                          %mo (
                          %munder
                            %mo ∪
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi S
                            %mi i
                          %mo )
                        %mo =
                        %mrow
                          %mo (
                          %munder
                            %mo ∪
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi im
                            %mi f
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi S
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo )
                      %annotation{:encoding => "application/x-tex"} im_f\left( \underset{i \in I}{\cup}  S_i\right) = \left(\underset{i \in I}{\cup} im_f(S_i)\right)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi im
                          %mi f
                        %mrow
                          %mo (
                          %munder
                            %mo ∩
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi S
                            %mi i
                          %mo )
                        %mo ⊂
                        %mrow
                          %mo (
                          %munder
                            %mo ∩
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi im
                            %mi f
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi S
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo )
                      %annotation{:encoding => "application/x-tex"} im_f\left( \underset{i \in I}{\cap}  S_i\right) \subset \left(\underset{i \in I}{\cap} im_f(S_i)\right)
            %p
              The inclusion in the second item is in general proper. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an
              %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective function
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is
              %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
              then this is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mspace{:width => "thinmathspace"}
                      %mtext injective
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mrow
                        %mo (
                        %msub
                          %mi im
                          %mi f
                        %mrow
                          %mo (
                          %munder
                            %mo ∩
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi S
                            %mi i
                          %mo )
                        %mo =
                        %mrow
                          %mo (
                          %munder
                            %mo ∩
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi im
                            %mi f
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi S
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo )
                        %mo )
                    %annotation{:encoding => "application/x-tex"} (f\,\text{injective}) \Rightarrow \left(im_f\left( \underset{i \in I}{\cap}  S_i\right) = \left(\underset{i \in I}{\cap} im_f(S_i)\right)\right)
          %p
            For details see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/interactions+of+images+and+pre-images+with+unions+and+intersections"} interactions of images and pre-images with unions and intersections
          %h3#relation_to_factorization_systems Relation to factorization systems
          %p
            Suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is closed under composition, and that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo =
                  %mi m
                  %mi e
                %annotation{:encoding => "application/x-tex"} f = m e
            is an image factorization relative to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            has the property that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo =
                  %mi n
                  %mi g
                %annotation{:encoding => "application/x-tex"} e = n g
            for some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} n\in M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is an isomorphism — for then we would have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mi g
                %annotation{:encoding => "application/x-tex"} f = (m n) g
            and so by universality of images,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            would factor through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mi n
                  %annotation{:encoding => "application/x-tex"} m n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is the class of all monomorphisms and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/extremal+epimorphism"} extremal epimorphism
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has
            %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is closed under pullbacks, then we can say more:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            is
            %a.existingWikiWord{:href => "/nlab/show/orthogonality"} orthogonal
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi a
                        %mtd
                          %mover
                            %mo →
                            %mi h
                        %mtd
                          %mi b
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mi e
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi n
                      %mtr
                        %mtd
                          %mi c
                        %mtd
                          %munder
                            %mo →
                            %mi k
                        %mtd
                          %mi d
                %annotation{:encoding => "application/x-tex"}
                  \\array{a &amp; \overset{h}{\to} &amp; b\\
                  ^e\downarrow &amp;&amp; \downarrow^n\\
                  c  &amp; \underset{k}{\to} &amp; d}
          %p
            is a commutative square with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} n\in M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi k
                    %mo *
                  %mi n
                %annotation{:encoding => "application/x-tex"} k^*n
            is an
            = succeed "-morphism" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            factors. Hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi k
                    %mo *
                  %mi n
                %annotation{:encoding => "application/x-tex"} k^*n
            must be an isomorphism, and so the square admits a diagonal filler, which is unique since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi M
                %annotation{:encoding => "application/x-tex"} n\in M
            is monic. It follows that if all
            = succeed "-images" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is the right class of an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} orthogonal factorization system
            = succeed "-images" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %p
            Cf. at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%28epi%2C+mono%29+factorization+system"} (epi, mono) factorization system
          %p
            Conversely, it is easy to see that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,M)
            is an OFS on a category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "-images" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %p
            %strong Duality
          %p
            Note that the notion of factorization system is self-dual. Therefore, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,M)
            is a factorization system and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mover
                    %mo →
                    %mi e
                  %mi a
                  %mover
                    %mo →
                    %mi m
                  %mi d
                %annotation{:encoding => "application/x-tex"} c \overset{e}{\to} a \overset{m}{\to} d
            is an
            = succeed "-factorization" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,M)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} f\colon c\to d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            the
            = succeed "-image" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            (the least
            = succeed "-subobject" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            factors), but dually
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            is also the
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              \-coimage
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "-quotient" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            factors.
          %p However, see below for additional remarks on the usage of the terms “image” and “coimage.”
          %h3#AsEqualizer Construction via limits
          %p
            Suppose that the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            admits
            %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+colimits"} finite colimits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo =
                  %mi RegMono
                %annotation{:encoding => "application/x-tex"} M=RegMono
            consists of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/regular+monomorphisms"} regular monomorphisms
            = succeed "-image" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi c
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} f : c \to d
            may be constructed as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Im
                  %mi f
                  %mo ≃
                  %mi lim
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ⇉
                  %mi d
                  %msub
                    %mo ⊔
                    %mi c
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Im f \simeq lim (d \rightrightarrows d \sqcup_c d)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mo ⊔
                    %mi c
                  %mi d
                %annotation{:encoding => "application/x-tex"} d \sqcup_c d
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi c
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi d
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi f
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi d
                        %mtd
                          %mo →
                        %mtd
                          %mi d
                          %msub
                            %mo ⊔
                            %mi c
                          %mi d
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  c &amp;\stackrel{f}{\to}&amp; d
                  \\\
                  \\downarrow^{f} &amp;&amp; \downarrow
                  \\\
                  d &amp;\to&amp; d \sqcup_c d
                  }
                  \\,.
          %p
            In other words, the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/regular+image"} regular image
            is the
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cokernel+pair"} cokernel pair
            = succeed "-image," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RegMono
                  %annotation{:encoding => "application/x-tex"} RegMono
            %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            and colimits, a monomorphism is regular if and only if it is the equalizer of its cokernel pair.
          %p
            Dually, the
            %strong regular coimage
            of a morphism is the
            %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
            of its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/kernel+pair"} kernel pair
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            (and more generally in any
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            the regular image is the set-theoretic image topologized as a subspace of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/target"} codomain
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/source"} domain
          %p
            Note that some authors drop the “regular” and simply call these constructions the
            %strong image
            and
            %strong coimage
            respectively. This can be confusing, however, since in many cases (such as in any
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
            %em regular coimage
            coincides with the
            = succeed "-image" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo =
                  %mi Mono
                %annotation{:encoding => "application/x-tex"} M=Mono
            the class of all monomorphisms, which it is also natural to simply call the
            = succeed "." do
              %em image
          %h3#comparison_of_regular_images_and_coimages Comparison of regular images and coimages
          %p
            Suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mn 1
                %annotation{:encoding => "application/x-tex"} M_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mn 2
                %annotation{:encoding => "application/x-tex"} M_2
            are two classes with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 1
                    %mo ⊆
                    %msub
                      %mi M
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} M_1\subseteq M_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            has both an
            = succeed "-image" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} M_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi im
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} im_1(f)
            and an
            = succeed "-image" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} M_2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi im
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} im_2(f)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ternary+factorization+system"} ternary factorization system
          %p As a special case of this, we have:
          .num_lemma
            %h6#lemma Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has finite limits and colimits, then there is a unique map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %mi coim
                    %mi f
                    %mo →
                    %mi im
                    %mi f
                  %annotation{:encoding => "application/x-tex"}
                    u :  coim f \to im f
            %p from its regular coimage to its regular image such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo →
                    %mi coim
                    %mi f
                    %mover
                      %mo →
                      %mi u
                    %mi im
                    %mi f
                    %mo →
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f = (c \to coim f \stackrel{u}{\to} im f \to d)
                    \\,.
          .proof
            %h6#proof Proof
            %p
              Because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              coequalizes
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %msub
                        %mo ×
                        %mi d
                      %mi c
                      %mo ⇉
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c \times_d c \rightrightarrows c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                            %msub
                              %mo ×
                              %mi d
                            %mi c
                            %mo ⇉
                          %mtd
                            %mi c
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi d
                          %mtd
                            %mo ⇉
                          %mtd
                            %mi d
                            %msub
                              %mo ⊔
                              %mi c
                            %mi d
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi epi
                          %mtd
                            %msup
                              %mrow
                              %mi h
                            %mo ↗
                          %mtd
                            %msup
                              %mrow
                              %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mi mono
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi coim
                            %mi f
                          %mtd
                          %mtd
                            %mi im
                            %mi f
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    c
                    \&amp;\times_d c \rightrightarrows&amp;
                    c
                    \&amp;\stackrel{f}{\to}&amp;
                    d
                    \&amp;\rightrightarrows&amp;
                    d \sqcup_{c} d
                    \\\
                    \&amp;&amp; {}^{\;}\downarrow^{epi} &amp;{}^{h}\nearrow&amp; {}^{\;}\uparrow^{mono}
                    \\\
                    \&amp;&amp; coim f &amp;&amp; im f
                    }
            %p exists uniquely.
            %p
              Because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo →
                    %mi coim
                    %mi f
                  %annotation{:encoding => "application/x-tex"} c \to coim f
              is
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epi
              it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              equalizes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ⇉
                    %mi d
                    %msub
                      %mo ⊔
                      %mi c
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d \rightrightarrows d \sqcup_c d
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              in the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                            %msub
                              %mo ×
                              %mi d
                            %mi c
                            %mo ⇉
                          %mtd
                            %mi c
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi d
                          %mtd
                            %mo ⇉
                          %mtd
                            %mi d
                            %msub
                              %mo ⊔
                              %mi c
                            %mi d
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi epi
                          %mtd
                            %msup
                              %mrow
                              %mi h
                            %mo ↗
                          %mtd
                            %msup
                              %mrow
                              %mspace{:width => "thickmathspace"}
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mi mono
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi coim
                            %mi f
                          %mtd
                            %mover
                              %mo →
                              %mi u
                          %mtd
                            %mi im
                            %mi f
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    c
                    \&amp;\times_d c \rightrightarrows&amp;
                    c
                    \&amp;\stackrel{f}{\to}&amp;
                    d
                    \&amp;\rightrightarrows&amp;
                    d \sqcup_{c} d
                    \\\
                    \&amp;&amp; {}^{\;}\downarrow^{epi} &amp;{}^{h}\nearrow&amp; {}^{\;}\uparrow^{mono}
                    \\\
                    \&amp;&amp; coim f &amp;\stackrel{u}{\to}&amp; im f
                    }
            %p exists uniquely.
          %p
            If this map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is sometimes called a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strict+morphism"} strict morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has finite limits and colimits and every morphism is a strict morphism, then the regular image and regular coimage factorizations coincide and give an epi-mono factorization system.
          %h2#in_higher_category_theory In higher category theory
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            there are generalizations of the notion of image, such as these:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
              (of a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %li
              %a.existingWikiWord{:href => "/nlab/show/homotopy+image"}> homotopy image
              \.
          %p However, it is not clear that either serves as the proper categorification of the notion described above.
          %p
            There are several properties we might want a ‘higher image’ to have. For example, in an
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "," do
              %strong Cat
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/factorization+system+in+a+2-category"} factorization system in a 2-category
          %h3#InfImage
            In
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            A
            %strong
              (regular)
              = succeed "-image" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            of a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi c
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} f : c \to d
            in an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            with
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limits
            and -colimits should be defined to be the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
            over the
            %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+nerve"} Cech co-nerve
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi im
                  %mi f
                  %mo :
                  %mo =
                  %munder
                    %mi lim
                    %mo ←
                  %mrow
                    %mo (
                    %mi d
                    %mo ⇉
                    %mi d
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi c
                    %mi d
                    %mover
                      %mo ⇉
                      %mo →
                    %mi d
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi c
                    %mi d
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi c
                    %mi d
                    %mover
                      %mover
                        %mo ⇉
                        %mo →
                      %mo →
                    %mi ⋯
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  im f := \lim_{\leftarrow}
                  \\left(
                  d \rightrightarrows d \coprod_c d
                  \\stackrel{\to}{\rightrightarrows}
                  d \coprod_c d \coprod_c d
                  \\stackrel{\to}{\stackrel{\to}{\rightrightarrows}}
                  \\cdots
                  \\right)
                  \\,.
          %p Notice that
          %ul
            %li
              %p
                this reduces to the above
                %a{:href => "#AsEqualizer"} equalizer definition
                in the case that the ambient
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
            %li
              %p
                this implies that the inclusion
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi im
                      %mi f
                      %mo →
                      %mi d
                    %annotation{:encoding => "application/x-tex"} im f \to d
                is a
                %a.existingWikiWord{:href => "/nlab/show/regular+monomorphism"} regular monomorphism
                in the
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
                = succeed ")." do
                  %a{:href => "http://ncatlab.org/nlab/show/regular+monomorphism#Infty1Version"} here
          %p
            For more see
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/n-image"} n-image
          %h4#InfImageExamples Examples
          %p
            Applied to the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            this gives a notion of image of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functors
            between
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoids
            and hence a notion of image of
            %a.existingWikiWord{:href => "/nlab/show/functor"} functors
            between
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoids
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functors
            between
