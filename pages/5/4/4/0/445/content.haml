                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
              %p#RepleteImages
                See also at at
                %em
                  %a.existingWikiWord{:href => "/nlab/show/replete+subcategory"} replete subcategory
                the section
                = succeed "." do
                  %em
                    %a{:href => "replete+subcategory#RepletionAndRepleteImages"} Repletion and replete images
              %p
                Often it is desireable to instead treat
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
