                  %mi M
                  %mo ,
                  %mi q
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi odd
                %annotation{:encoding => "application/x-tex"}
                  Cl(M,q) = Cl(M,q)^{ev} \oplus Cl(M,q)^{odd}
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is projective of rank
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
