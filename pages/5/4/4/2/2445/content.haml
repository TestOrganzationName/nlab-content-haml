                                %msub
                                  %mi a
                                  %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo {
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mstyle{:displaystyle => "false"}
                                        %mfrac
                                          %mn 1
                                          %mn 2
                                      %msub
                                        %mi Γ
                                        %mrow
                                          %msub
                                            %mi a
                                            %mn 1
