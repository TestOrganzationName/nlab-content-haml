                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 4
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                            %mo ,
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi a
                                  %mn 2
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi b
                                  %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi g
                              %mrow
                                %msub
                                  %mi a
                                  %mn 2
                                %msub
                                  %mi b
                                  %mn 1
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 4
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                            %mo ,
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi b
                                  %mn 2
                            %mo{:stretchy => "false"} ]
                            %mo −
                            %msub
                              %mi g
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                                %msub
                                  %mi b
                                  %mn 1
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 4
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi a
                                  %mn 2
                            %mo ,
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi b
                                  %mn 2
                            %mo{:stretchy => "false"} ]
                            %mo +
                            %msub
                              %mi g
                              %mrow
                                %msub
                                  %mi a
                                  %mn 2
                                %msub
                                  %mi b
                                  %mn 2
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 4
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi b
                                  %mn 1
                            %mo ,
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo −
                            %msub
                              %mi g
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                                %msub
                                  %mi b
                                  %mn 2
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 4
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi b
                                  %mn 1
                            %mo ,
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi a
                                  %mn 2
                            %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\big[
                    \\tfrac{1}{4}
                    [\Gamma_{a_1}, \Gamma_{a_2}]
                    ,
                    \\;
                    \\tfrac{1}{4}
                    [\Gamma_{b_1}, \Gamma_{b_2}]
                    \\big]
                    \&amp; =
                    \\tfrac{1}{4}
                    \\Big[
                    \\big[
                    \\tfrac{1}{4}
                    [\Gamma_{a_1},\Gamma_{a_2}]
                    ,\,
                    \\Gamma_{b_1}
                    \\big]
                    ,\,
                    \\Gamma_{b_2}
                    \\Big]
                    +
                    \\tfrac{1}{4}
                    \\Big[
                    \\Gamma_{b_1},
                    \\big[
                    \\tfrac{1}{4}
                    [\Gamma_{a_1},\Gamma_{a_2}]
                    ,\,
                    \\Gamma_{b_2}
                    \\big]
                    \\Big]
                    \\\
                    \&amp; =
                    g_{a_2 b_1}
                    \\tfrac{1}{4}
                    [\Gamma_{a_1},\Gamma_{b_2}]
                    \-
                    g_{a_1 b_1}
                    \\tfrac{1}{4}
                    [\Gamma_{a_2},\Gamma_{b_2}]
                    +
                    g_{a_2 b_2}
                    \\tfrac{1}{4}
                    [\Gamma_{b_1},\Gamma_{a_1}]
                    \-
                    g_{a_1 b_2}
                    \\tfrac{1}{4}
                    [\Gamma_{b_1}, \Gamma_{a_2}]
                    \\end{aligned}
            %p
              Here the first step is again the graded
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
              (and is again also immediely checked by inspection), while the second step uses
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:CliffordLieActionOnVectorsInComponents"} (3)
          %p
            %br/
          %h3#relation_to__groups
            Relation to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                %annotation{:encoding => "application/x-tex"} Spin
            groups
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a projective
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            be nondegenerate. Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi q
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ×
                %annotation{:encoding => "application/x-tex"} Cl(M,q)^\times
            for the
            %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            of the Clifford algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(M,q)
          %p
            The
            %strong Clifford group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mrow
                      %mi M
                      %mo ,
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma_{M,q}(R)
            is the subgroup of elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            for which twisted conjugation stabilizes the submodule
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M \subset Cl(M,q)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ↦
                    %mi x
                    %mi y
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} y \mapsto x y\alpha(x)^{-1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is the automorphism of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CL
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CL(M,q)
            induced by the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} -1
            map on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "-stabilizing" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ↦
                    %mi y
                    %mo −
                    %mn 2
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi q
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mi x
                  %annotation{:encoding => "application/x-tex"} y \mapsto y - 2\frac{(x,y)}{q(x)}x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %mi M
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_{M,q}(R) \to O(M,q)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} R^\times
          %p
            The Clifford group is made of homogeneous elements in the
            = succeed "-grading," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2\mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
            norm
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo :
                  %msub
                    %mi Γ
                    %mrow
                      %mi M
                      %mo ,
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi R
                    %mo ×
                %annotation{:encoding => "application/x-tex"} Q: \Gamma_{M,q}(R) \to R^\times
            on the Clifford group, defined by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi x
                      %mi t
                    %mi x
                  %annotation{:encoding => "application/x-tex"} Q(x) = x^t x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %msup
                    %mi x
                    %mi t
                %annotation{:encoding => "application/x-tex"} x \mapsto x^t
            is the anti-involution of the Clifford algebra defined by opposite multiplication in the tensor algebra.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Pin+group"} Pin group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Pin
                    %mrow
                      %mi M
                      %mo ,
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pin_{M,q}(R)
            is the group elements of the Clifford group with
            %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
            norm 1. The
            %a.existingWikiWord{:href => "/nlab/show/Spin+group"} Spin group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Spin
                    %mrow
                      %mi M
                      %mo ,
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin_{M,q}(R)
            is the group of elements in the even subgroup of the Clifford group with
            %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
            norm 1.
          %p
            The restriction of the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mrow
                      %mi M
                      %mo ,
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma_{M,q}(R) \to O(M,q)
            to the Pin group may not be surjective, but it is for positive definite real vector spaces. The kernel is the group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mu_2(R)
            of elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            that square to 1. Similarly, the
            %a.existingWikiWord{:href => "/nlab/show/Spin+group"} Spin group
            has a map to the special orthogonal group with kernel
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu_2(R)
          %p
            One can use base change to define the groups given above as functors on commutative
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h3#AsQuantizedExteriorAlgebra Relation to exterior algebra (quantization)
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
            %a.existingWikiWord{:href => "/nlab/show/symbol+map"} symbol map
            (see there) constitutes an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            of the underlying
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} exterior algebra
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            One may understand the Clifford algebra as the
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
            induced from the
            %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
            regarded as an odd
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
          %h2#spinors Spinors
          %p
            For nondegenerate
            %a.existingWikiWord{:href => "/nlab/show/quadratic+forms"} quadratic forms
            on real vector spaces,
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spinors"} spinors
            %a.existingWikiWord{:href => "/nlab/show/spin+representations"} spin representations
            are distinguished linear representations of
            %a.existingWikiWord{:href => "/nlab/show/Spin+groups"} Spin groups
            that are not pulled back from the corresponding special orthogonal groups. In other words, the central element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} -1
            acts nontrivially. They can be realized as restrictions of representations of the even parts of Clifford algebras. Since even parts of Clifford algebras are (up to complexification) the sum of one or two matrix rings, their representation theory is quite simple.
          %p The specific nature of spinor representations possible depends on the signature of the vector space modulo 8. This is a manifestation of Bott periodicity. One always has a Dirac spinor - the fundamental (spin) representation of the complexified Clifford algebra. In even dimensions, this splits into two Weyl spinors (called half-spin representations). One may also have real representations called Majorana spinors, and these may decompose into Majorana-Weyl spinors.
          %p
            There are infinite dimensional Clifford algebra constructions that appear in conformal field theory. One may extend the above discussion to topological
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "-modules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h2#warnings Warnings
          %p There is a difference of sign convention between differential geometers (following Atiyah) and everyone else.
          %p Clifford algebras are often defined using bilinear forms instead of quadratic forms (and one often sees incorrect definitions of quadratic forms in terms of bilinear forms). Such definitions will yield wrong (or boring) objects when 2 is not invertible.
          %p Special orthogonal groups are often defined as the kernel of the determinant map on the corresponding orthogonal groups, but in characteristic 2, the determinant is trivial, while the Clifford grading (called the Dickson invariant) is not.
          %p
            The Clifford group is sometimes defined without the twist in the conjugation, and this means the map to the orthogonal group may not be a surjection, and the action on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is by negative reflections.
          %p The spinor norm is sometimes defined with the opposite sign.
          %p Special orthogonal groups over the reals are sometimes defined to be the connected component of the identity in the orthogonal group. In indefinite signature, this defines an index two subgroup of the special orthogonal group.
          %p
            Spin groups in signature
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (m,n)
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo ,
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} m,n \geq 2
            have fundamental groups of order two. They are simply connected when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is at most one.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+algebra"} geometric algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Clifford+module"}> Clifford module
                ,
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Clifford+bundle"} Clifford bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Clifford+module+bundle"} Clifford module bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fierz+identity"} Fierz identity
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spin+geometry"}> spin geometry
                ,
                %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-Clifford+algebra"} 2-Clifford algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Feynman+slash+notation"} Feynman slash notation
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Clifford+ring"} Clifford ring
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pythagorean+ring"} Pythagorean ring
          %h2#references References
          %p The notion of Clifford algebra is due to
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Clifford"}> William Clifford
                ,
                = succeed "," do
                  %em Applications of Grassmann’s extensive algebra
                %strong 1
                4 (1878) 350-358 &amp;lbrack;
                %a{:href => "https://doi.org/10.2307/2369379"}> doi:10.2307/2369379
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.jstor.org/stable/2369379"} jstor:2369379
              %blockquote
                %p
                  (referring to
                  = succeed "\u2018s" do
                    %a.existingWikiWord{:href => "/nlab/show/Hermann+Grassmann"} Hermann Grassmann
                  = succeed ")" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Ausdehnungslehre"} Ausdehnungslehre
          %p Further early discussion:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emil+Artin"}> Emil Artin
                , §V.4 in:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Geometric+Algebra"} Geometric Algebra
                = succeed "," do
                  %a{:href => "https://www.wiley.com/en-ae/Geometric+Algebra-p-9781118164549"} ISBN:978-1-118-16454-9
                = succeed "," do
                  %a{:href => "https://en.wikipedia.org/wiki/Geometric_Algebra_(book)"} Wikipedia entry
                = succeed "&rbrack;" do
                  %a{:href => "https://archive.org/details/geometricalgebra033556mbp/page/n5/mode/2upa"} ark:/13960/t4nk37034
            %li#Cartan66
              %p
                %a.existingWikiWord{:href => "/nlab/show/%C3%89lie+Cartan"}> Élie Cartan
                ,
                = succeed "," do
                  %em Theory of Spinors
          %p Brief introductions:
          %ul
            %li#CastellaniDAuriaFre
              %p
                %a.existingWikiWord{:href => "/nlab/show/Leonardo+Castellani"}> Leonardo Castellani
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"} Riccardo D'Auria
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Supergravity+and+Superstrings+-+A+Geometric+Perspective"} Supergravity and Superstrings - A Geometric Perspective
                = succeed "," do
                  %a{:href => "https://doi.org/10.1142/0224"} doi:10.1142/0224
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/files/CDF91-TOC.pdf", :title => "pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/CastellaniDAuriaFre-ChII7.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean+Gallier"}> Jean Gallier
                ,
                %em Clifford Algebras, Clifford Groups, and a Generalization of the Quaternions
                (
                %a{:href => "https://arxiv.org/abs/0805.0311"}> arXiv:0805.0311
                )
            %li
              %p
                Marc Lachieze-Rey,
                %em Spin and Clifford algebras, an introduction
                (
                %a{:href => "https://arxiv.org/abs/1007.2481"}> arXiv:1007.2481
                )
          %p Standard textbook accounts:
          %ul
            %li#LawsonMichelsohn89
              %p
                %a.existingWikiWord{:href => "/nlab/show/H.+Blaine+Lawson"}> H. Blaine Lawson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Marie-Louise+Michelsohn"} Marie-Louise Michelsohn
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Spin+geometry"} Spin geometry
                = succeed "&rbrack;" do
                  %a{:href => "https://press.princeton.edu/books/hardcover/9780691085425/spin-geometry-pms-38-volume-38"} ISBN 9780691085425
            %li#Lounesto
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pertti+Lounesto"}> Pertti Lounesto
                ,
                = succeed "," do
                  %em Clifford Algebras and Spinors
                = succeed "," do
                  %strong 286
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/CBO9780511526022"} doi:10.1017/CBO9780511526022
            %li#BudinichTrautman
              %p
                P. Budinich,
                = succeed ":" do
                  %span.newWikiWord
                    Andrej Trautman
                    %a{:href => "/nlab/new/Andrej+Trautman"} ?
                = succeed "," do
                  %em The Spinorial Chessboard
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-642-83407-3"} doi:10.1007/978-3-642-83407-3
            %li
              %p
                Jayme Vaz, Jr., Roldão da Rocha,
                = succeed "," do
                  %em An Introduction to Clifford algebras and Spinors
                = succeed "." do
                  %a{:href => "https://doi.org/10.1093/acprof:oso/9780198782926.001.0001"} DOI
            %li
              %p
                D. J. H. Garling,
                = succeed "," do
                  %em Clifford Algebras: an Introduction
                = succeed "." do
                  %a{:href => "https://doi.org/10.1017/CBO9780511972997"} DOI
            %li
              %p
                Jacques Helmstetter, Artibano Micali,
                = succeed "," do
                  %em Quadratic Mappings and Clifford Algebras
                = succeed "." do
                  %a{:href => "https://doi.org/10.1007/978-3-7643-8606-1"} DOI
          %p See also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eckhard+Meinrenken"}> Eckhard Meinrenken
              \:
              = succeed "," do
                %em Clifford algebras and Lie groups
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-3-642-36216-3"} doi:10.1007/978-3-642-36216-3
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/Bott+periodicity"} Bott periodicity
            for Clifford algebras:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dexter+Chua"}> Dexter Chua
                \:
                %em Clifford Algebras and Bott Periodicity
                \&amp;lbrack;
                %a{:href => "https://dec41.user.srcf.net/exp/clifford/clifford.pdf"}> pdf
                \&amp;rbrack;
            %li
              %p
                Ben Slater:
                = succeed "," do
                  %em Clifford Algebras and Bott Periodicity
                = succeed "," do
                  %em
                    %a{:href => "https://math.uchicago.edu/~may/REU2023/REUPapers/Slater.pdf"} REU 2023
                = succeed "&rbrack;" do
                  %a{:href => "https://math.uchicago.edu/~may/REU2023/REUPapers/Slater.pdf"} pdf
          %p
            For a program that promotes the use of Clifford algebra as a good expositional tool in introductory
            %a.existingWikiWord{:href => "/nlab/show/mechanics"} mechanics
            see
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Geometric+Algebra"} Geometric Algebra
          %p
            See also the discussion of
            %a.existingWikiWord{:href => "/nlab/show/Majorana+spinors"} Majorana spinors
          %ul
            %li#FigueroaOFarrill
              %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+Figueroa-O%27Farrill"}> José Figueroa-O'Farrill
              ,
              %em Majorana spinors
              (
              %a{:href => "http://www.maths.ed.ac.uk/~jmf/Teaching/Lectures/Majorana.pdf"}> pdf
              )
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            of Clifford algebras reminiscent of
            %a.existingWikiWord{:href => "/nlab/show/gauge+groups"} gauge groups
            of relevance in the
            %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
            and
            %a.existingWikiWord{:href => "/nlab/show/grand+unified+theories"} grand unified theories
            thereof:
          %ul
            %li#Wilson20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+A.+Wilson"}> Robert A. Wilson
                ,
                %em A group-theorist’s perspective on symmetry groups in physics
                (
                %a{:href => "https://arxiv.org/abs/2009.14613"}> arXiv:2009.14613
                )
            %li#Wilson21
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+A.+Wilson"}> Robert A. Wilson
                ,
                = succeed "," do
                  %em On the Problem of Choosing Subgroups of Clifford Algebras for Applications in Fundamental Physics
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s00006-021-01160-5"} doi:10.1007/s00006-021-01160-5
          %p
            (For similar investigations, see also
            %a{:href => "Albert+algebra#ReferencesRelationStandardModel"} here
            at
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Albert+algebra"} Albert algebra
