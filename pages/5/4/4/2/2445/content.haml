                                        %mn 1
                                      %mo ≠
                                      %msub
                                        %mi a
                                        %mn 2
                                  %mtr
                                    %mtd
                                      %mn 0
                                    %mtd
                                      %mo{:stretchy => "false"} |
                                    %mtd
                                      %mi otherwise
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    r_{a_1 a_2}
                    \&amp; \coloneqq\;
                    \\tfrac{1}{4}
                    \\big[
                    \\Gamma_{a_1},
