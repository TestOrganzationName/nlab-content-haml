            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            is nondegenerate, the even part of the Clifford algebra is also flat-locally isomorphic to a matrix ring or a sum of two matrix rings.
          %p
            One can view the Clifford algebra multiplication as a quantization of the commutative
            %a.existingWikiWord{:href => "/nlab/show/super+algebra"} super algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %mi R
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \bigwedge_R M
          %p
            %br/
          %h3#RelationToOrthogonalLieAlgebras Relation to orthogonal Lie algebras
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi Γ
                    %mi a
                  %msubsup
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi a
                      %mo =
                      %mn 1
                    %mi n
                %annotation{:encoding => "application/x-tex"} \{\Gamma_{a}\}_{a = 1}^n
            be the generators of an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
            over the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            corresponding to an
            = succeed "/metric" do
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/anti-commutator"} anti-commutator
          #eq:CliffordGeneratorsAnticommutator.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %msub
                    %mi Γ
                    %mi a
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Γ
                    %mi b
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 2
                  %msub
                    %mi g
                    %mrow
                      %mi a
                      %mi b
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\big\{
                  \\Gamma_{a}
                  ,\;
                  \\Gamma_b
                  \\big\}
                  \\;=\;
                  2 g_{a b}
                  \\,.
          %p Then:
          .num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+Lie+algebra"} special orthogonal Lie algebra
                via
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
            %p
              The elements of the Clifford algera
              %a.maruku-eqref{:href => "#eq:CliffordGeneratorsAnticommutator"} (1)
              given by
            #eq:CliffordLieAlgebra.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi r
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                                %msub
                                  %mi a
                                  %mn 2
                          %mtd
                            %mo ≔
                            %mspace{:width => "thickmathspace"}
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 4
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                            %msub
                              %mi Γ
                              %mrow
