            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/module"} module
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              \-
              %a.existingWikiWord{:href => "/nlab/show/quadratic+function"} quadratic function
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            with values in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo :
                  %mi M
                  %mo →
                  %mi N
                %annotation{:encoding => "application/x-tex"} q: M \to N
            such that the following properties hold:
          %ul
            %li
              %p
                (cube relation) For any
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi z
                        %mo ∈
                        %mi M
                      %annotation{:encoding => "application/x-tex"} x,y,z \in M
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %mo +
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo +
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mo .
                    %annotation{:encoding => "application/x-tex"} q(x+y+z) - q(x+y) - q(x+z) - q(y+z) + q(x) + q(y) + q(z) = 0.
            %li
              %p
                (homogeneous of degree 2) For any
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi M
                    %annotation{:encoding => "application/x-tex"} x \in M
                and any
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} r \in R
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi r
                        %mn 2
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} q(r x) = r^2q(x).
          %p
            A
            %strong
              quadratic
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            is an
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            equipped with a
            = succeed ":" do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
            = succeed "-quadratic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            with values in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
            The
            %strong Clifford algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cl(M,q)
            of a quadratic
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M,q)
            can be defined as the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of the
            %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi R
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T_R(M)
            by the
            %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
            generated by the relations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⊗
                  %mi x
                  %mo −
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \otimes x - q(x)
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} x \in M
          %p
            Equivalently, it is the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            in the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\phi)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an associative unital
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi M
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \phi: M \to A
            is an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            satisfying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo =
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mn 1
                    %mi A
                %annotation{:encoding => "application/x-tex"} \phi(x)^2 = q(x) 1_A
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} x \in M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ′
                  %mo ,
                  %mi ϕ
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\phi)\to (A',\phi')
            are the associative
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \chi: A\to A'
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo ∘
                    %mi ϕ
                    %mo =
                    %mi ϕ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \chi\circ\phi=\phi'
          %h2#examples Examples
          %p
            Examples in low
            %a.existingWikiWord{:href => "/nlab/show/rank"} rank
            can be calculated easily. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is freely generated by a single element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} q(e) = 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi e
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mn 2
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(M,q) = R[e]/(e^2-1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo{:stretchy => "false"} [
                    %mi e
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mn 2
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}[e]/(e^2+1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M_2(\mathbb{R})
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo =
                  %mi L
                  %mo ⊕
                  %msup
                    %mi L
                    %mo ∨
                %annotation{:encoding => "application/x-tex"} M = L \oplus L^\vee
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            projective of rank
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mo ∨
                  %mo =
                  %msub
                    %mi Hom
                    %mi R
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L^\vee = Hom_R(L,R)
            the dual module. One can define the canonical quadratic form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo +
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} q(f+x) = f(x)
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msup
                    %mi L
                    %mo ∨
                %annotation{:encoding => "application/x-tex"} f \in L^\vee
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi L
                  %annotation{:encoding => "application/x-tex"} x \in L
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi M
                      %mrow
                        %msup
                          %mn 2
                          %mi d
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(M,q) \cong M_{2^d}(R)
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Spec
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \operatorname{Spec} R
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a projective
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cl(M,q)
            is projective of rank
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 2
                      %mi d
                  %annotation{:encoding => "application/x-tex"} 2^d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %mi M
                %annotation{:encoding => "application/x-tex"} \bigwedge M
            as an
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q = 0
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is the ring of smooth functions on a pseudo-Riemannian manifold
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is the
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            with a quadratic structure, and one can form the Clifford algebra of the tangent bundle.
          %h2#properties Properties
          %h3#Classification Classification and Relation to matrix algebras
          %h4#ClassificationOverTheComplexNumbers Over the complex numbers
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be the
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              over the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              of complex
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cl
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cl_{d}(\mathbb{C}) \coloneqq Cl(V)
            %p
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              to a
              %a.existingWikiWord{:href => "/nlab/show/matrix+algebra"} matrix algebra
              as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cl
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Mat
                                %mrow
                                  %msup
                                    %mn 2
                                    %mstyle{:displaystyle => "false"}
                                      %mfrac
                                        %mi d
                                        %mn 2
                              %mo{:stretchy => "false"} (
                              %mi ℂ
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mi for
                              %mspace{:width => "thinmathspace"}
                              %mi d
                              %mspace{:width => "thinmathspace"}
                              %mi even
                          %mtr
                            %mtd
                              %msub
                                %mi Mat
                                %mrow
                                  %msup
                                    %mn 2
                                    %mstyle{:displaystyle => "false"}
                                      %mfrac
                                        %mrow
                                          %mi d
                                          %mo −
                                          %mn 1
                                        %mn 2
                              %mo{:stretchy => "false"} (
                              %mi ℂ
                              %mo{:stretchy => "false"} )
                              %mo ⊕
                              %msub
                                %mi Mat
                                %mrow
                                  %msup
                                    %mn 2
                                    %mstyle{:displaystyle => "false"}
                                      %mfrac
                                        %mrow
                                          %mi d
                                          %mo −
                                          %mn 1
                                        %mn 2
                              %mo{:stretchy => "false"} (
                              %mi ℂ
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mi for
                              %mspace{:width => "thinmathspace"}
                              %mi d
                              %mspace{:width => "thinmathspace"}
                              %mi odd
                  %annotation{:encoding => "application/x-tex"}
                    Cl_d(\mathbb{C})
                    \\simeq
                    \\left\{
                    \\array{
                    Mat_{2^{\tfrac{d}{2}}}(\mathbb{C}) &amp; for \, d \, even
                    \\\
                    Mat_{2^{\tfrac{d-1}{2}}}(\mathbb{C}) \oplus Mat_{2^{\tfrac{d-1}{2}}}(\mathbb{C})
                    \&amp; for \, d \,  odd
                    }
                    \\right.
          .num_remark
            %h6#remark Remark
            %p
              This is one of the incarnations of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Bott+periodicity"} Bott periodicity
          %h4#ClassificationOverTheRealNumbers Over the real numbers
          %p
            We discuss the classification of Clifford algebras over the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            and their relation to
            %a.existingWikiWord{:href => "/nlab/show/matrix+algebras"} matrix algebras
            over the real numbers. A key statement is that of the mod-8
            %a.existingWikiWord{:href => "/nlab/show/Bott+periodicity"} Bott periodicity
            of this classification (prop.
            %a.maruku-ref{:href => "#RealBottPeriodicity"}
            below).
          %p In the following we write
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Cl
                        %mrow
                          %mi s
                          %mo ,
                          %mi t
                    %annotation{:encoding => "application/x-tex"} \Cl_{s,t}
                for the Clifford algebra of a vector space over the real numbers with
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi s
                        %annotation{:encoding => "application/x-tex"} s
                    generators squaring to -1
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi t
                        %annotation{:encoding => "application/x-tex"} t
                    generators squaring to +1
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
                for the
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                regarded as an
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
                over
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                    %annotation{:encoding => "application/x-tex"} \mathbb{H}
                for the
                %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
                regarded as an
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
                over
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ≔
                      %msub
                        %mi Mat
                        %mrow
                          %mi n
                          %mo ×
                          %mi n
                      %mo{:stretchy => "false"} (
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}[n] \coloneqq Mat_{n \times n}(\mathbb{K})
                for the
                %a.existingWikiWord{:href => "/nlab/show/matrix+algebra"} matrix algebra
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ×
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n \times n
                matrices with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕂
                      %annotation{:encoding => "application/x-tex"} \mathbb{K}
          .num_prop
            %h6#proposition Proposition
            %p
              For low dimensions of real Clifford algebras, there are the following isomorphisms of
              %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cl
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                    %mo ≃
                    %mi ℝ
                    %mo ⊕
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    Cl_{0,1}
                    \\simeq
                    \\mathbb{R} \oplus \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cl
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo ≃
                    %mi ℝ
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    Cl_{1,1}
                    \\simeq
                    \\mathbb{R}[2]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cl
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo ≃
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    Cl_{1,0}
                    \\simeq
                    \\mathbb{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cl
                      %mrow
                        %mn 2
                        %mo ,
                        %mn 0
                    %mo ≃
                    %mi ℍ
                  %annotation{:encoding => "application/x-tex"}
                    Cl_{2,0} \simeq \mathbb{H}
          %p
            (e. g.
            = succeed ")" do
              %a{:href => "#FigueroaOFarrill"} Figueroa-O’Farrill, lemma32
          #Smooth0TypeIsSheavesOnSmoothMfd.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} p,q \in \mathbb{N}
              then there are the following
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              of
              %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
              over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cl
                      %mrow
                        %mi q
                        %mo +
                        %mn 2
                        %mo ,
                        %mi p
                    %mo ≃
                    %msub
                      %mi Cl
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msub
                      %mi Cl
                      %mrow
                        %mn 2
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    Cl_{q+2,p} \simeq Cl_{p,q} \otimes_{\mathbb{R}} Cl_{2,0}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cl
                      %mrow
                        %mi q
                        %mo ,
                        %mi p
                        %mo +
                        %mn 2
                    %mo ≃
                    %msub
                      %mi Cl
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msub
                      %mi Cl
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    Cl_{q,p+2} \simeq Cl_{p,q} \otimes_{\mathbb{R}} Cl_{0,2}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cl
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mi q
                        %mo +
                        %mn 1
                    %mo ≃
                    %msub
                      %mi Cl
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msub
                      %mi Cl
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    Cl_{p+1,q+1} \simeq Cl_{p,q} \otimes_{\mathbb{R}} Cl_{1,1}
          %p
            (e.g.
            %a{:href => "#LawsonMichelsohn89"} Lawson &amp; Michelsohn 1989, Theorem 4.1
            and
            %a{:href => "#FigueroaOFarrill"} Figueroa-O’Farrill, Lemma 2
            for special cases where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            is zero, and
            %a{:href => "#BudinichTrautman"} Budinich &amp; Trautman 1988 19, Eqs. 7.8b and 7.9
            for the general case)
          #Smooth0TypeIsSheavesOnSmoothMfd.num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ,
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n,n_1, n_2 \in \mathbb{N}
              there are the following
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              of
              %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
              over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℝ
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi n
                          %mn 1
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo ⊗
                          %mi ℝ
                        %mi ℝ
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi n
                          %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo ≃
                        %mi ℝ
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi n
                          %mn 1
                        %msub
                          %mi n
                          %mn 2
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}[n_1] \otimes_{\mathbb{R}} \mathbb{R}[n_2] \simeq \mathbb{R}[n_1 n_2]
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℝ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo ⊗
                          %mi ℝ
                        %mi 𝕂
                        %mo ≃
                        %mi 𝕂
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}[n] \otimes_{\mathbb{R}} \mathbb{K} \simeq \mathbb{K}[n]
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℂ
                        %msub
                          %mo ⊗
                          %mi ℝ
                        %mi ℂ
                        %mo ≃
                        %mi ℂ
                        %mo ⊕
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C} \otimes_{\mathbb{R}} \mathbb{C} \simeq \mathbb{C} \oplus \mathbb{C}
                  \.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℂ
                        %msub
                          %mo ⊗
                          %mi ℝ
                        %mi ℍ
                        %mo ≃
                        %mi ℂ
                        %mo{:stretchy => "false"} [
                        %mn 2
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{C} \otimes_{\mathbb{R}} \mathbb{H} \simeq \mathbb{C}[2]
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℍ
                        %msub
                          %mo ⊗
                          %mi ℝ
                        %mi ℍ
                        %mo ≃
                        %mi ℝ
                        %mo{:stretchy => "false"} [
                        %mn 4
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{H} \otimes_{\mathbb{R}} \mathbb{H} \simeq \mathbb{R}[4]
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#LawsonMichelsohn89"} Lawson-Michelsohn 89, proposition 4.2
          %p
            Now the incarnation in Clifford algebras of
            %a.existingWikiWord{:href => "/nlab/show/Bott+periodicity"} Bott periodicity
            over the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            is the following:
          #RealBottPeriodicity.num_prop
            %h6#proposition_4 Proposition
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              there are
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              of
              %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              as follows:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi Cl
                          %mrow
                            %mi n
                            %mo +
                            %mn 8
                            %mo ,
                            %mn 0
                        %mo ≃
                        %msub
                          %mi Cl
                          %mrow
                            %mi n
                            %mo ,
                            %mn 0
                        %msub
                          %mo ⊗
                          %mi ℝ
                        %msub
                          %mi Cl
                          %mrow
                            %mn 8
                            %mo ,
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} Cl_{n+8,0} \simeq Cl_{n,0} \otimes_{\mathbb{R}} Cl_{8,0}
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi Cl
                          %mrow
                            %mn 0
                            %mo ,
                            %mi n
                            %mo +
                            %mn 8
                        %mo ≃
                        %msub
                          %mi Cl
                          %mrow
                            %mn 0
                            %mo ,
                            %mi n
                        %msub
                          %mo ⊗
                          %mi ℝ
                        %msub
                          %mi Cl
                          %mrow
                            %mn 0
                            %mo ,
                            %mn 8
                      %annotation{:encoding => "application/x-tex"} Cl_{0,n+8} \simeq Cl_{0,n} \otimes_{\mathbb{R}} Cl_{0,8}
                  \.
            %p where
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi Cl
                        %mrow
                          %mn 8
                          %mo ,
                          %mn 0
                      %mo ≃
                      %msub
                        %mi Cl
                        %mrow
                          %mn 0
                          %mo ,
                          %mn 8
                      %mo ≃
                      %mi ℝ
                      %mo{:stretchy => "false"} [
                      %mn 16
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} Cl_{8,0} \simeq Cl_{0,8} \simeq \mathbb{R}[16]
                \.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#LawsonMichelsohn89"} Lawson-Michelsohn 89, theorem 4.3
          %h3#as_a_superalgebra As a superalgebra
          %p
            While the
            %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
            of an
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            has a natural
            %a.existingWikiWord{:href => "/nlab/show/integer"} integer
            grading, the quadratic relation collapses this to a natural
            = succeed "-grading" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2\mathbb{Z}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(M,q)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
