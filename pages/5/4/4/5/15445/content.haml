          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and a collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi K
                    %mi s
                  %mover
                    %mo ↪
                    %mrow
                      %msub
                        %mi ι
                        %mi s
                  %msub
                    %mi X
                    %mi s
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi s
                      %mo ∈
                      %mi S
                %annotation{:encoding => "application/x-tex"} \{K_s \stackrel{\iota_s}{\hookrightarrow} X_s\}_{s \in S}
            of
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            in some
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            (typically
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
            %em restricted product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %msub
                    %mi X
                    %mi s
                %annotation{:encoding => "application/x-tex"} \underset{s\in S}{\prod}^\prime X_s
            is vaguely the like the actual
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi s
                      %mo ∈
                      %mi S
                  %msub
                    %mi X
                    %mi s
                %annotation{:encoding => "application/x-tex"} \underset{s\in S}{\prod} X_s
            of all the
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi s
                  %annotation{:encoding => "application/x-tex"} X_s
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi s
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi s
                      %mo ∈
                      %mi S
                %annotation{:encoding => "application/x-tex"} (x_s)_{s \in S}
            all but a
            %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
            of components
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi s
                %annotation{:encoding => "application/x-tex"} x_s
            are in the
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi s
                  %annotation{:encoding => "application/x-tex"} \iota_s
          %h2#definition Definition
          %p
            Assume that the ambient
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            has ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/products"} products
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒫
                    %mi fin
                  %mi S
                %annotation{:encoding => "application/x-tex"} \mathcal{P}_{fin} S
            for the
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            of
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
            %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and consider the
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi K
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi 𝒫
                    %mi fin
                  %mo ⟶
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  X^K \colon \mathcal{P}_{fin}\longrightarrow \mathcal{C}
          %p
            which is given on a
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊂
                  %mi S
                %annotation{:encoding => "application/x-tex"} U \subset S
            by the
            %a.existingWikiWord{:href => "/nlab/show/products"} products
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ↦
                  %msubsup
                    %mi X
                    %mi U
                    %mi K
                  %mo ≔
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi u
                        %mo ∈
                        %mi U
                    %msub
                      %mi X
                      %mi u
                    %mo )
                  %mo ×
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                        %mo −
                        %mi U
                    %msub
                      %mi K
                      %mi s
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  U \mapsto X^K_U \coloneqq \left(\underset{u \in U}{\prod} X_u\right)
                  \\times
                  \\left(
                  \\underset{s \in S-U}{\prod} K_s
                  \\right)
          %p
            and which sends an inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mn 1
                  %mo ↪
                  %msub
                    %mi U
                    %mn 2
                %annotation{:encoding => "application/x-tex"} U_1 \hookrightarrow U_2
            of subsets to the evident
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            between these products whose components
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi s
                %annotation{:encoding => "application/x-tex"} f_s
            are the
            %a.existingWikiWord{:href => "/nlab/show/identity"} identity
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∈
                  %mi S
                  %mo −
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mn 2
                  %mo −
                  %msub
                    %mi U
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s \in S-(U_2-U_1)
            and are
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi s
                %annotation{:encoding => "application/x-tex"} \iota_s
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %msub
                      %mi U
                      %mn 2
                    %mo −
                    %msub
                      %mi U
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} s \in U_2-U_1
          %p
            Then the restricted product is the (
            %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"}> filtered
            )
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            over this functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %msub
                    %mi X
                    %mi s
                  %mo ≔
                  %munder
                    %mi lim
                    %munder
                      %mo ⟶
                      %mrow
                        %mi U
                        %mo ∈
                        %msub
                          %mi 𝒫
                          %mi fin
                        %mi S
                  %msubsup
                    %mi X
                    %mi U
                    %mi K
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\underset{s\in S}{\prod}^\prime X_s
                  \\coloneqq
                  \\underset{\underset{U \in \mathcal{P}_{fin}S}{\longrightarrow}}{\lim}
                  X^K_U
                  \\,.
          %h2#examples Examples
          %ul
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/weak+direct+product"} weak direct product
                is a restricted product whose trivial subobjects are specified
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/global+elements"} global elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi s
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} K_s = \ast
                are
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/terminal+objects"} terminal objects
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} ring of adeles
                of a
                %a.existingWikiWord{:href => "/nlab/show/global+field"} global field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                is the restricted product of the
                %a.existingWikiWord{:href => "/nlab/show/formal+completions"} formal completions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mi v
                    %annotation{:encoding => "application/x-tex"} k_v
                at all its
                %a.existingWikiWord{:href => "/nlab/show/places"} places
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                      %annotation{:encoding => "application/x-tex"} v
                %a.existingWikiWord{:href => "/nlab/show/norm"} norm
                greater than unity.
              %p
                Equivalently this is the restricted product for the inclusions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi v
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi 𝒪
                        %mi v
                      %mo ↪
                      %msub
                        %mi k
                        %mi v
                    %annotation{:encoding => "application/x-tex"} \iota_v \colon \mathcal{O}_v \hookrightarrow k_v
                of the
                %a.existingWikiWord{:href => "/nlab/show/ring+of+integers"} ring of integers
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mi v
                    %annotation{:encoding => "application/x-tex"} k_v
                into
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi k
                          %mi v
                      %annotation{:encoding => "application/x-tex"} k_v
            %li
              %p
                Under the
                %a.existingWikiWord{:href => "/nlab/show/function+field+analogy"} function field analogy
                the above example is a special case of the following more general example: for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                an
                %a.existingWikiWord{:href => "/nlab/show/arithmetic+curve"} arithmetic curve
                then the restricted product of all the algebras of functions on all its punctured
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/formal+disks"} formal disks
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cocycles
                with respect to
                %a.existingWikiWord{:href => "/nlab/show/covers"} covers
                of the curve by the complement of any finite points and the formal disks around these points (e.g
                = succeed ")." do
                  %a{:href => "#Frenkel05"} Frenkel 05, section 3.2
                = succeed "." do
                  %em
                    %a{:href => "moduli+space+of+bundles#OverCurvesAndTheLanglandsCorrespondence"} moduli stack of bundles – over curves
