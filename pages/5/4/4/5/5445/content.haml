          %h2#selected_writings Selected writings
          %p
            On the characterization of
            %a.existingWikiWord{:href => "/nlab/show/monadic+functors"} monadic functors
            over
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %ul
            %li#Vitale94
              %a.existingWikiWord{:href => "/nlab/show/Enrico+Vitale"}> Enrico Vitale
              ,
              = succeed "," do
                %em
                  On the characterization of monadic categories over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SET
                      %annotation{:encoding => "application/x-tex"} SET
              %strong 35
              4 (1994) 351-358. &amp;lbrack;
              %a{:href => "http://www.numdam.org/item/?id=CTGDC_1994__35_4_351_0"}> numdam:CTGDC_1994__35_4_351_0
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.numdam.org/article/CTGDC_1994__35_4_351_0.pdf"} pdf
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of (
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"}> Hausdorff
            )
            %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
            being a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
          %ul
            %li#CagliariMatovaniVitale95
              F. Cagliari, S. Mantovani,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Enrico+Vitale"} Enrico Vitale
              = succeed "," do
                %em Regularity of the category of Kelley spaces
              = succeed "," do
                %a{:href => "https://link.springer.com/article/10.1007/BF00872904"} doi:10.1007/BF00872904
              = succeed ")" do
                %a{:href => "http://www.dm.unibo.it/~cagliari/articoli/Regularkelley.pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/regular+and+exact+completions"} regular and exact completions
            (and on
            %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completions"} free coproduct completions
            etc.):
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Aurelio+Carboni"}> Aurelio Carboni
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Enrico+Vitale"} Enrico Vitale
              = succeed "," do
                %em Regular and exact completions
              %strong 125
              1–3 (1998) 79-116 (
              %a{:href => "https://doi.org/10.1016/S0022-4049(96)00115-6"}> doi:10.1016/S0022-4049(96)00115-6
              )
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/exact+completion"} exact completion
            of the
            %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Top
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ho(Top)
            being a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marino+Gran"}> Marino Gran
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Enrico+Vitale"} Enrico Vitale
              = succeed "," do
                %em On the exact completion of the homotopy category
              %strong 39
              4 (1998) 287-297 &amp;lbrack;
              %a{:href => "http://www.numdam.org/item/CTGDC_1998__39_4_287_0"}> numdam:CTGDC_1998__39_4_287_0
              \&amp;rbrack;
          %p
            For the characterisation of
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            which are
            %a.existingWikiWord{:href => "/nlab/show/localizations"} localizations
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Maltsev+varieties"} Maltsev varieties
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marino+Gran"} Marino Gran
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Enrico+Vitale"} Enrico Vitale
              = succeed "," do
                %em Localizations of Maltsev varieties
              %strong 5
              12 (1999) 281-291 &amp;lbrack;
              %a{:href => "http://www.tac.mta.ca/tac/volumes/1999/n12/5-12abs.html"}> TAC
              \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/Beck%27s+theorem"} Beck's theorem
            for
            %a.existingWikiWord{:href => "/nlab/show/pseudomonads"} pseudomonads
            (
            %a.existingWikiWord{:href => "/nlab/show/higher+monadic+descent"}> higher monadic descent
            ):
          %ul
            %li
              I. J. Le Creurer,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Francisco+Marmolejo"} Francisco Marmolejo
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Enrico+M.+Vitale"} Enrico M. Vitale
              = succeed "," do
                %em Beck’s theorem for pseudo-monads
              %strong 173
              3 (2002) 293-313 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/S0022-4049(02)00038-5"}> doi:10.1016/S0022-4049(02)00038-5
              \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/Gabriel-Ulmer+duality"} Gabriel-Ulmer duality
            for general
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/doctrines"} doctrines
          %ul
            %li
              C. Centazzo,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Enrico+M.+Vitale"} Enrico M. Vitale
              = succeed "," do
                %em A duality relative to a limit doctrine
              %strong 10
              20 (2002) 486-497 lbrack;
              %a{:href => "http://www.tac.mta.ca/tac/volumes/10/20/10-20abs.html"}> tac:10-20
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/10/20/10-20.pdf"} pdf
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+categories"} locally presentable categories
          %ul
            %li
              Claudia Centazzo,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ji%C5%99%C3%AD+Rosick%C3%BD"} Jiří Rosický
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Enrico+M.+Vitale"} Enrico M. Vitale
              = succeed "," do
                %em
                  A characterization of locally
                  = succeed "-presentable" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                        %annotation{:encoding => "application/x-tex"} D
              %a.existingWikiWord{:href => "/nlab/show/Cahiers"} Cahiers
              de topologie et géométrie différentielle catégoriques
              %strong 45
              2 (2004) 141-146 &amp;lbrack;
              %a{:href => "https://www.numdam.org/item/CTGDC_2004__45_2_141_0"}> numdam:CTGDC_2004__45_2_141_0
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://perso.uclouvain.be/enrico.vitale/ClaudiaJiri.pdf"} pdf
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+theories"} algebraic theories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ji%C5%99%C3%AD+Ad%C3%A1mek"}> Jiří Adámek
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ji%C5%99%C3%AD+Rosick%C3%BD"} Jiří Rosický
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Enrico+Vitale"} Enrico Vitale
              = succeed "," do
                %em Algebraic theories
              = succeed "," do
                %a{:href => "https://doi.org/10.1017/CBO9780511760754"} doi:10.1017/CBO9780511760754
              = succeed "&rbrack;" do
                %a{:href => "https://perso.uclouvain.be/enrico.vitale/gab_CUP2.pdf"} pdf
