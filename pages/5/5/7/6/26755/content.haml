          %p
          .num_defn
            %h6 Definition
            %p
              An enhanced measurable space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi M
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,M,N)
              is
              %strong compact
              if there is a compact class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mi M
                  %annotation{:encoding => "application/x-tex"} K\subset M
              such that for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∈
                    %mi M
                    %mo ∖
                    %mi N
                  %annotation{:encoding => "application/x-tex"} m\in M\setminus N
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi K
                    %mo ∖
                    %mi N
                  %annotation{:encoding => "application/x-tex"} k\in K\setminus N
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ⊂
                      %mi m
                    %annotation{:encoding => "application/x-tex"} k\subset m
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %msup
                      %mn 2
                      %mi X
                  %annotation{:encoding => "application/x-tex"} K\subset 2^X
              of subsets of a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %strong compact class
              if for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ′
                    %mo ⊂
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K'\subset K
              the following
              %a.existingWikiWord{:href => "/nlab/show/finite+intersection+property"} finite intersection property
              holds: if for any finite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ″
                    %mo ⊂
                    %mi K
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} K''\subset K'
              we have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mi K
                      %mo ″
                      %mo ≠
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \bigcap K''\ne\emptyset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mi K
                      %mo ′
                      %mo ≠
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \bigcap K'\ne\emptyset
          %p
            To connect to the notion of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
            = succeed "," do
              %a{:href => "#Fremlin"} Fremlin
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ⊂
                  %msup
                    %mn 2
                    %mi X
                %annotation{:encoding => "application/x-tex"} K\subset 2^X
            is a compact class if and only if there is a compact topology on the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that every element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is a closed (and hence compact) subset of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %a{:href => "#Fremlin"} Fremlin
          %p
            A
            %strong Radon enhanced measurable space
            is an enhanced measurable space equipped with a structure of a Hausdorff topological space such that the
            %a.existingWikiWord{:href => "/nlab/show/%CF%83-algebra"} σ-algebra
            of measurable sets contains open sets and there is a faithful measure that is locally finite (every point has a neighborhood of finite measure) and inner regular with respect to compact subsets (the measure of any measurable subset is the supremum of measures of its compact subsets). (See
            %a{:href => "#Fremlin"} Fremlin
            Definition 411H(b).) Every Radon enhanced measurable space is compact and strictly localizable by
            %a{:href => "#Fremlin"} Fremlin
            (Proposition 416W(a), Theorem 414J).
          %p
            The following theorem answers the question of existence of the essential image in the affirmative in the case when the domain of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a
            %strong compact
            enhanced measurable space. The crucial ingredient is a deep result of
            %a{:href => "#Fremlin"} Fremlin
            (§451Q) that shows that a compact enhanced measurable space whose σ-ideal of negligible sets is induced by a faithful semifinite measure cannot be partitioned into an uncountable family of negligible sets whose arbitrary unions are measurable subsets.
          %p
          .num_theorem
            %h6 Theorem
            %p
              (
              %a{:href => "#Pavlov"}> Pavlov
              , Proposition 4.65.) Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi M
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, M, N)
              is a compact enhanced measurable space that admits a faithful semifinite measure,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ′
                    %mo ,
                    %mi M
                    %mo ′
                    %mo ,
                    %mi N
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X',M',N')
              is a strictly localizable enhanced measurable space, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi M
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ′
                    %mo ,
                    %mi M
                    %mo ′
                    %mo ,
                    %mi N
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f\colon (X, M, N) \to (X', M', N')
              is a morphism of enhanced measurable spaces. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              admits an essential image.
          %p
            It is easy to see that the essential image of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            (if it exists) must be the complement of the essential supremum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            of all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo ′
                  %mo ∈
                  %mi M
                  %mo ′
                %annotation{:encoding => "application/x-tex"} m'\in M'
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi m
                    %mo ′
                    %mo ∈
                    %mi N
                  %annotation{:encoding => "application/x-tex"} f^{-1}m'\in N
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi p
                    %mo ∈
                    %mi N
                  %annotation{:encoding => "application/x-tex"} f^{-1}p\in N
          %p As an added bonus, we obtain the following counterpart to the von Neumann–Maharam co-lifting theorem for strictly localizable spaces.
          %p
          .num_theorem
            %h6 Theorem
            %p
              (von Neumann 1932; C. Ionescu Tulcea 1965; Vesterstrøm–Wils 1969; Edgar 1976; Graf 1980; see also
              = succeed "," do
                %a{:href => "#Fremlin"} Fremlin
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi M
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,M,N)
              is an enhanced measurable space that admits a faithful semifinite measure. Assume
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∉
                      %mi N
                    %annotation{:encoding => "application/x-tex"} X\notin N
            %ul
              %li
                %p
                  For every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                        %mo ∈
                        %mi M
                        %mo ∖
                        %mi N
                      %annotation{:encoding => "application/x-tex"} m\in M\setminus N
                  there is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi M
                        %mo ∖
                        %mi N
                      %annotation{:encoding => "application/x-tex"} a\in M\setminus N
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ⊂
                        %mi m
                      %annotation{:encoding => "application/x-tex"} a\subset m
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  is compact. (If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi M
                        %mo ,
                        %mi N
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,M,N)
                  is strictly localizable, this condition implies compactness of
                  = succeed ".)" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  For every strictly localizable enhanced measurable space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ′
                        %mo ,
                        %mi M
                        %mo ′
                        %mo ,
                        %mi N
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X',M',N')
                  and complete homomorphism of localizable Boolean algebras
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:lspace => "verythinmathspace"} :
                        %mi M
                        %mo{:stretchy => "false"} /
                        %mi N
                        %mo →
                        %mi M
                        %mo ′
                        %mo{:stretchy => "false"} /
                        %mi N
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} \phi\colon M/N\to M'/N'
                  there is a morphism of enhanced measurable spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ′
                        %mo ,
                        %mi M
                        %mo ′
                        %mo ,
                        %mi N
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi M
                        %mo ,
                        %mi N
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X',M',N')\to(X,M,N)
                  that induces
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                        %annotation{:encoding => "application/x-tex"} \phi
            %p
          %h3#equivalence_to_the_four_other_categories Equivalence to the four other categories
          %p Previously, we constructed a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LBAlg
                  %mo →
                  %mi CSLEMS
                %annotation{:encoding => "application/x-tex"} LBAlg \to CSLEMS
          %p
            from localizable Boolean algebras and complete homomorphisms to enhanced measurable spaces. The Loomis–Sikorski construction applied to
            %a.existingWikiWord{:href => "/nlab/show/hyperstonean+spaces"} hyperstonean spaces
            produces compact and strictly localizable spaces, thus landing in the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CSLEMS
                %annotation{:encoding => "application/x-tex"} CSLEMS
            of compact strictly localizable enhanced measurable spaces.
          %p We also constructed a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LEMS
                  %mo →
                  %mi LBAlg
                  %mo ,
                  %mspace{:width => "2em"}
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi M
                  %mo ,
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi M
                  %mo{:stretchy => "false"} /
                  %mi N
                  %mo ,
                %annotation{:encoding => "application/x-tex"} LEMS \to LBAlg, \qquad (X,M,N)\mapsto M/N,
          %p which we can now restrict to a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CSLEMS
                  %mo →
                  %mi LBAlg
                  %mo .
                %annotation{:encoding => "application/x-tex"} CSLEMS \to LBAlg.
          %p Previously, we saw that the compustion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LBAlg
                  %mo →
                  %mi CSLEMS
                  %mo →
                  %mi LBAlg
                %annotation{:encoding => "application/x-tex"} LBAlg \to CSLEMS \to LBAlg
          %p is isomorphic to the identity functor.
          %p Showing that the composition
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CSLEMS
                  %mo →
                  %mi LBAlg
                  %mo →
                  %mi CSLEMS
                %annotation{:encoding => "application/x-tex"} CSLEMS \to LBAlg \to CSLEMS
          %p is isomorphic to the identity functor is much more difficult. Indeed, the construction of the isomorphism and its inverse requires the properties of compactness and strict localizability and uses deep theorems due to von Neumann–Maharam and Ionescu Tulcea.
          %p
          .num_theorem
            %h6 Theorem
            %p
              (
              %a{:href => "#Pavlov"}> Pavlov
              , Theorem 5.19.) The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CSLEMS
                  %annotation{:encoding => "application/x-tex"} CSLEMS
              is equivalent to the following four categories:
            %ul
              %li
                %p
                  opposite category of
                  %a.existingWikiWord{:href => "/nlab/show/commutative+von+Neumann+algebras"} commutative von Neumann algebras
              %li
                %p
                  opposite category of localizable Boolean algebras (i.e.,
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/measurable+locales"} measurable locales
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/hyperstonean+locales"} hyperstonean locales
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/hyperstonean+spaces"} hyperstonean spaces
            %p
          %h2#summary_2 Summary
          %p
            The following category is suitable for
            %a.existingWikiWord{:href => "/nlab/show/measure+theory"} measure theory
            in the sense that it matches the existing practice of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/real+analysis"} real analysis
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stochastic+processes"} stochastic processes
          %ul
            %li
              %p
                Objects are (complete) compact strictly localizable enhanced measurable spaces
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi M
                        %mo ,
                        %mi N
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,M,N)
            %li
              %p
                Morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi M
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ′
                      %mo ,
                      %mi M
                      %mo ′
                      %mo ,
                      %mi N
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,M,N)\to(X',M',N')
                are equivalence classes of maps of sets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi X
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} X\to X'
                that reflect measurable and negligible sets.
            %li
              %p
                Two morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                are equivalent if they are weakly equivalent almost everywhere for every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ′
                      %mo ∈
                      %mi M
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} m'\in M'
                we have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mi m
                        %mo ′
                        %mo ⊕
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mi m
                        %mo ′
                        %mo ∈
                        %mi N
                      %annotation{:encoding => "application/x-tex"} f^{-1}m'\oplus g^{-1}m'\in N
          %p The following remarks are in order.
          %ul
            %li
              %p
                Enhanced measurable spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi M
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,M,N)
                have just the right amount of information: enough to define (weak) equality almost everywhere, not too much to require constructions of noncanonical measures.
            %li
              %p
                However, one could use conventional
                %a.existingWikiWord{:href => "/nlab/show/measure+spaces"} measure spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi M
                      %mo ,
                      %mi μ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,M,\mu)
                instead, using
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mi μ
                    %annotation{:encoding => "application/x-tex"} N_\mu
                as the
                %a.existingWikiWord{:href => "/nlab/show/%CF%83-ideal"} σ-ideal
                of negligible sets.
            %li
              %p To ensure that composition descends to the quotient category, measurable maps must reflect negligible sets.
            %li
              %p The equivalence relation of equality almost everywhere must be coarsened to weak equality almost everywhere to ensure morphisms are fully determined by their preimages up to subnegligible sets.
            %li
              %p Completeness is optional, but simplifies some aspects of the presentation. Local determinacy is implied by strict localizability.
            %li
              %p The property of strict localizability is a straightforward generalization of the notion of a σ-finite space.
            %li
              %p
                The property of compactness is an abstraction of the definition of a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Radon+measure"} Radon measure
          %p These properties eliminate pathologies and ensure the following desirable properties of objects and morphisms.
          %ul
            %li
              %p
                The resulting category is equivalent to four other categories: opposite of commutative von Neumann algebras, opposite of localizable Boolean algebras (i.e.,
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/measurable+locales"} measurable locales
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/hyperstonean+locales"} hyperstonean locales
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/hyperstonean+spaces"} hyperstonean spaces
            %li
              %p
                Compact strictly localizable spaces are localizable and hence satisfy the traditional theorems of elementary measure theory: the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Radon%E2%80%93Nikodym+theorem"} Radon–Nikodym theorem
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Riesz+representation+theorem"} Riesz representation theorem
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"} von Neumann algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo{:stretchy => "false"} /
                      %mi N
                    %annotation{:encoding => "application/x-tex"} M/N
                of equivalence classes of measurable sets is complete.
            %li
              %p
                Morphisms of compact strictly localizable enhanced measurable spaces induce
                %em complete
                homomorphisms of localizable Boolean algebras.
            %li
              %p Morphisms of enhanced measurable spaces admit essential images.
          %h2#categorical_properties Categorical properties
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CSLEMS
                %annotation{:encoding => "application/x-tex"} CSLEMS
            has excellent categorical properties: it is complete and cocomplete, admits a
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure"} closed monoidal structure
            whose product is the measure-theoretic product, is comonadic over sets and over
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
            %a.existingWikiWord{:href => "/nlab/show/probability+monad"} probability monad
            (
            %a{:href => "#Furber"}> Furber
            ).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stone+duality"}> Stone duality
                ,
                %a.existingWikiWord{:href => "/nlab/show/Gelfand+duality"} Gelfand duality
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/commutative+von+Neumann+algebra"} commutative von Neumann algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/hyperstonean+locale"}> hyperstonean locale
                ,
                %a.existingWikiWord{:href => "/nlab/show/hyperstonean+space"} hyperstonean space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enhanced+measurable+spaces"}> enhanced measurable spaces
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/measurable+space"} measurable space
