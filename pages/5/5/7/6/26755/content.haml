                  %mo ,
                  %mi N
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f\colon(X,M,N)\to(X',M',N')
          %p is a morphism of enhanced measurable spaces.
          %p
