            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and often denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi X
                  %annotation{:encoding => "application/x-tex"} S_X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma_X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sym(X)
            or similar.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            of symmetric groups are the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/permutation+groups"} permutation groups
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %a.existingWikiWord{:href => "/nlab/show/the"} the
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} (n) = \{1,\dots,n\}
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            of
            %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo !
                %annotation{:encoding => "application/x-tex"} n!
            \= “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/factorial"} factorial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S_n
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Sigma_n
          %p
            (We will make frequent use of the entry
            %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
            for some key notation and concepts.)
          %p
            In general, an element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S_n
            can be represented by a two row array
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mn 2
                          %mtd
                            %mi …
                          %mtd
                            %mi n
                        %mtr
                          %mtd
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi …
                          %mtd
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                    %mo )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \sigma= \left(\array{1&amp;2&amp;\ldots &amp;n\\\sigma(1)&amp;\sigma(2)&amp;\ldots&amp;\sigma(n)}\right).
          %p
            It can also be given in cycle notation. We repeat the example from the entry on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} S_6
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            be the permutation on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 6
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (6)
            defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mn 1
                          %mo ↦
                          %mn 1
                        %mtd
                          %mn 2
                          %mo ↦
                          %mn 4
                        %mtd
                          %mn 3
                          %mo ↦
                          %mn 5
                        %mtd
                          %mn 4
                          %mo ↦
                          %mn 6
                        %mtd
                          %mn 5
                          %mo ↦
                          %mn 3
                        %mtd
                          %mn 6
                          %mo ↦
                          %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mn 2
                          %mtd
                            %mn 3
                          %mtd
                            %mn 4
                          %mtd
                            %mn 5
                          %mtd
                            %mn 6
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mn 4
                          %mtd
                            %mn 5
                          %mtd
                            %mn 6
                          %mtd
                            %mn 3
                          %mtd
                            %mn 2
                    %mo )
                %annotation{:encoding => "application/x-tex"} \sigma = (\array{1 \mapsto 1 &amp; 2\mapsto 4 &amp; 3 \mapsto 5 &amp; 4 \mapsto 6 &amp; 5 \mapsto 3 &amp; 6 \mapsto 2})= \left(\array{1&amp;2&amp;3&amp;4&amp;5&amp;6\\1&amp;4&amp;5&amp;6&amp;3&amp;2}\right)
          %p
            The domain of the permutation is partitioned into three
            = succeed "-orbits" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi σ
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle\sigma\rangle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 6
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %mn 2
                  %mo ,
                  %mn 4
                  %mo ,
                  %mn 6
                  %mo{:stretchy => "false"} }
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %mn 3
                  %mo ,
                  %mn 5
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} (6) = \{1\} \cup \{2,4,6\} \cup \{3,5\}
          %p corresponding to the three cycles
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %munder
                    %mo →
                    %mi σ
                  %mn 1
                  %mspace{:width => "2em"}
                  %mn 2
                  %munder
                    %mo →
                    %mi σ
                  %mn 4
                  %munder
                    %mo →
                    %mi σ
                  %mn 6
                  %munder
                    %mo →
                    %mi σ
                  %mn 2
                  %mspace{:width => "2em"}
                  %mn 3
                  %munder
                    %mo →
                    %mi σ
                  %mn 5
                  %munder
                    %mo →
                    %mi σ
                  %mn 3
                %annotation{:encoding => "application/x-tex"}
                  1 \underset{\sigma}{\to} 1 \qquad
                  2 \underset{\sigma}{\to} 4 \underset{\sigma}{\to} 6 \underset{\sigma}{\to} 2 \qquad
                  3 \underset{\sigma}{\to} 5 \underset{\sigma}{\to} 3
          %p
            We express this more compactly by writing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            as the composition
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mn 4
                    %mspace{:width => "thinmathspace"}
                    %mn 6
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mspace{:width => "thinmathspace"}
                    %mn 5
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma = (1)(2\,4\,6)(3\,5)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mn 4
                  %mspace{:width => "thinmathspace"}
                  %mn 6
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mspace{:width => "thinmathspace"}
                  %mn 5
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sigma = (2\,4\,6)(3\,5)
            leaving implicit the action of the identity (1).
          %p
            We can also write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            as a product of transpositions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mn 4
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mn 6
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mspace{:width => "thinmathspace"}
                  %mn 5
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (2\,4)(2\,6)(3\,5)
          %h2#examples Examples
          %h3#the_symmetric_group_
            The symmetric group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 3
                %annotation{:encoding => "application/x-tex"} S_3
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 3
                %annotation{:encoding => "application/x-tex"} S_3
            is the group of permutations of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mn 3
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} (3)=\{1,2,3\}
          %p
            One simple way to represent an element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 3
                %annotation{:encoding => "application/x-tex"} S_3
            is by listing the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (3)
            on the top row of an array with a second row denoting the image of each element under the permutation. For instance, the element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sigma
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ↦
                  %mn 2
                  %mo ,
                  %mn 2
                  %mo ↦
                  %mn 1
                  %mo ,
                  %mn 3
                  %mo ↦
                  %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} sigma= (1\mapsto 2, 2\mapsto 1, 3\mapsto 3)
            can be written more compactly as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mn 2
                          %mtd
                            %mn 3
                        %mtr
                          %mtd
                            %mn 2
                          %mtd
                            %mn 1
                          %mtd
                            %mn 3
                    %mo )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \sigma= \left(\array{1&amp;2&amp;3\\2&amp;1&amp;3}\right).
          %p
            We can also use, even more compactly, ‘cycle notation’, as explained in more detail at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sigma = (1\,2)
          %p
            the
            %em transposition
            exchanging the elements 1 and 2 and leaving 3 ‘unmoved’. Whilst the 3-cycle,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1\,2\,3)
          %p
          #CayleyGraphOfSym3.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cayley+graph+of+Sym%283%29"}> Cayley graph of Sym(3)
                )
              The following shows the
              %a.existingWikiWord{:href => "/nlab/show/Cayley+graph"} Cayley graph
              of the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+groups"} symmetric groups
              on 3 elements,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sym(3)
              %a.existingWikiWord{:href => "/nlab/show/edges"} edges
              corresponding to any
              %a.existingWikiWord{:href => "/nlab/show/transposition"} transposition
              (not necessarily adjacent), hence whose
              %a.existingWikiWord{:href => "/nlab/show/graph+distance"} graph distance
              is the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Cayley+distance"} Cayley distance
            %svg{:height => "126.35", :viewbox => "0 0 169.516 126.35", :width => "169.516", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
              %defs
                %g
                  %g{:id => "o75ImgmCVpJx9AZxwf167sZKHEU=-glyph-0-0"}
