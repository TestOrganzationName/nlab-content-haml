              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mi f
                    %mi h
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} g f h = 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi h
                    %mi g
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f h g = 1
