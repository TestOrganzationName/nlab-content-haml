          %h2#selected_writings Selected writings
          %p
            Introducing the
            = succeed "-type" do
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+sigma-model"} Green-Schwarz sigma-model
            %a.existingWikiWord{:href => "/nlab/show/super-membrane"} super-membrane
            in 11D (the
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
          %ul
            %li#BergshoeffSezginTownsend87
              %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
              = succeed "," do
                %em Supermembranes and eleven-dimensional supergravity
              %strong 189
              (1987) 75-78 [
              %a{:href => "https://doi.org/10.1016/0370-2693(87)91272-X"}> doi:10.1016/0370-2693(87)91272-X
              ,
              = succeed "]" do
                %a{:href => "http://inspirehep.net/record/248230/"} spire:248230
          %p and on the early history of the development:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eric+A.+Bergshoeff"}> Eric A. Bergshoeff
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Paul+K.+Townsend"} Paul K. Townsend
              %em A brief history of supermembranes
              [
              %a{:href => "https://arxiv.org/abs/2503.06234"}> arXiv:2503.06234
              ]
          %p
            On the emergence of
            %a.existingWikiWord{:href => "/nlab/show/superconformal+field+theory"} superconformal field theory
            in the perturbations of the
            %a.existingWikiWord{:href => "/nlab/show/super-membrane"} super-membrane
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+sigma+model"} Green-Schwarz sigma model
            around a classical solution stretched along the
            %a.existingWikiWord{:href => "/nlab/show/asymptotic+boundary"} asymptotic boundary
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/anti+de+Sitter+spacetime"} anti de Sitter spacetime
          %ul
            %li#BDPS87
              %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Duff"} Michael Duff
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Christopher+Pope"} Christopher Pope
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Ergin+Sezgin"} Ergin Sezgin
              = succeed "," do
                %em Supersymmetric Supermembrane Vacua and Singletons
              %strong 199
              (1987) 69-74 [
              %a{:href => "https://doi.org/10.1016/0370-2693(87)91465-1"}> doi:10.1016/0370-2693(87)91465-1
              ,
              = succeed "]" do
                %a{:href => "https://inspirehep.net/literature/250244"} InSpire:250244
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
            of the
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            to the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D4-brane"} D4-brane
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mees+de+Roo"} Mees de Roo
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Tomas+Ortin"} Tomas Ortin
              = succeed "," do
                %em The Eleven-dimensional Five-brane
              %strong 386
              (1996) 85-90 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/9606118"}> arXiv:hep-th/9606118
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/0370-2693(96)00913-6"} doi:10.1016/0370-2693(96)00913-6
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/brane+intersection"} brane intersection
            laws of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/M-branes"} M-branes
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mees+de+Roo"} Mees de Roo
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eduardo+Eyras"} Eduardo Eyras
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bert+Janssen"} Bert Janssen
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jan+Pieter+van+der+Schaar"} Jan Pieter van der Schaar
                = succeed "," do
                  %em Intersections involving waves and monopoles in eleven dimensions
                %strong 14
                (1997) 2757 &amp;lbrack;
                %a{:href => "http://iopscience.iop.org/0264-9381/14/10/005"}> doi:0264-9381/14/10/005
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joaquim+Gomis"} Joaquim Gomis
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
                = succeed "," do
                  %em M-brane intersections from worldvolume superalgebras
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9711043"} arXiv:hep-th/9711043
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/black+brane"} black
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
            = succeed "-solutions" do
              %a.existingWikiWord{:href => "/nlab/show/D8-brane"} D8-brane
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/massive+type+IIA+supergravity"} massive type IIA supergravity
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/massive+type+IIA+string+theory"} massive type IIA string theory
          %ul
            %li#BergshoessdeRooGreenPapadopoulosTownsend96
              %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mees+de+Roo"} Mees de Roo
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Green"} Michael Green
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/George+Papadopoulos"} George Papadopoulos
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Townsend"} Paul Townsend
              = succeed "," do
                %em Duality of Type II 7-branes and 8-branes
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9601150"} arXiv:hep-th/9601150
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/massive+type+IIA+string+theory"} massive type IIA string theory
            and its embedding in
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/M9-branes"} M9-branes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eric+Bergshoeff"}> Eric Bergshoeff
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yolanda+Lozano"} Yolanda Lozano
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Tomas+Ortin"} Tomas Ortin
              = succeed "," do
                %em Massive Branes
              %strong 518
              (1998) 363-423 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/9712115"}> arXiv:hep-th/9712115
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/S0550-3213(98)00045-5"} doi:10.1016/S0550-3213(98)00045-5
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/KK-monopole"} KK-monopole
            in massive
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
