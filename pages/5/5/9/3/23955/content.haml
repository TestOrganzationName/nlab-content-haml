            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            (over some
            %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
          %ol
            %li
              %p
                a
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕂
                      %annotation{:encoding => "application/x-tex"} \mathbb{K}
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi v
                    %annotation{:encoding => "application/x-tex"} V_v
                for each
                %a.existingWikiWord{:href => "/nlab/show/vertex"} vertex
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo ∈
                        %msub
                          %mi Q
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} v \in Q_0
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi v
                      %mover
                        %mo →
                        %mrow
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi e
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi V
                        %mrow
                          %mi v
                          %mo ′
                    %annotation{:encoding => "application/x-tex"} V_v \xrightarrow{\rho(e)} V_{v'}
                for each
                %a.existingWikiWord{:href => "/nlab/show/edge"} edge
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo ∈
                        %msub
                          %mi Q
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} e \in Q_1
          %p
            Notice that there is
            %em no
            further compatibility condition, in particular if there are edges forming a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/triangle"} triangle
            %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
            are
            %em not required
            to be related under
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            between two quiver representations is a
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi v
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi ϕ
                        %mi v
                  %mi V
                  %msub
                    %mo ′
                    %mi v
                %annotation{:encoding => "application/x-tex"} V_v \xrightarrow{\phi_v} V'_v
            for each
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vertex"} vertex
            %a.existingWikiWord{:href => "/nlab/show/edge"} edge
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mover
                    %mo →
                    %mi e
                  %mi v
                  %mo ′
                %annotation{:encoding => "application/x-tex"} v \xrightarrow{e} v'
            the following
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            in
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
