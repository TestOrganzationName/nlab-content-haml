              %a{:href => "https://doi.org/10.1007/978-3-319-09204-1"} doi:10.1007/978-3-319-09204-1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p
            Discussion for A-type quivers in the context of (
            %a.existingWikiWord{:href => "/nlab/show/zigzag+persistence"}> zigzag
            )
            %a.existingWikiWord{:href => "/nlab/show/persistent+homology"} persistent homology
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+data+analysis"} topological data analysis
          %ul
            %li#CarlssonDeSilva10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gunnar+Carlsson"}> Gunnar Carlsson
                ,
                = succeed "," do
