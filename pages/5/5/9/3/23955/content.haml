              %a{:href => "https://www.ams.org/notices/200502/fea-weyman.pdf"} pdf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p Textbook accounts:
          %ul
            %li
