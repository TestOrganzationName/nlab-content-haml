                %use{:x => "63.0815", "xlink:href" => "#oMOpFHPS5xA0pKlruHelcc3aoJ4=-glyph4-2", :y => "76.969"}
          %p
            This makes a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of quiver representations of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Rep
                      %mi 𝕂
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Rep_{\mathbb{K}}(Q)
          %p
            In other words, if one regards
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            as the
            %a.existingWikiWord{:href => "/nlab/show/directed+graph"} directed graph
            that it is, and considers its
            %a.existingWikiWord{:href => "/nlab/show/free+category"} free category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FrCat
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} FrCat(Q)
          %ol
            %li
              %p
                a quiver representation is a
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FrCat
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mi ρ
                      %msub
                        %mi Vect
                        %mi 𝕂
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      FrCat(Q) \xrightarrow{\rho} Vect_{\mathbb{K}}
                      \\,,
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                of quiver representations is a
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi ρ
                      %mo ⇒
                      %mi ρ
                      %mo ′
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\phi \;\colon\; \rho \Rightarrow \rho'
                      \\,,
            %li
              %p
                and the
                %a.existingWikiWord{:href => "/nlab/show/category+of+quiver+representations"} category of quiver representations
                is
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalently
                the
                %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
                from the
                %a.existingWikiWord{:href => "/nlab/show/free+category"} free category
                of the quiver to the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/category+of+vector+spaces"} category of vector spaces
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Rep
                        %mi 𝕂
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mi Func
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi FrCat
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi Vect
                        %mi 𝕂
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Rep_{\mathbb{K}}(Q)
                      \\;\simeq\;
                      Func
                      \\big(
                      FrCat(Q)
                      ,\,
                      Vect_{\mathbb{K}}
                      \\big)
                      \\,.
