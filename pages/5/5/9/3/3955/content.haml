                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi W
                      %mrow
                        %mn 1
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} f(x) \in W_{1 2}
              for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi N
                    %annotation{:encoding => "application/x-tex"} x \in N
            %p
              The transition function,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ψ
                        %mrow
                          %mn 2
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \Psi_{2 1}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ψ
                        %mrow
                          %mn 2
                          %mn 1
                      %mo =
                      %msubsup
                        %mi Φ
                        %mn 2
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msub
                        %mi Φ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Psi_{2 1} = \Phi_2^{-1} \Phi_1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mn 2
                      %msub
                        %mi Ψ
                        %mrow
                          %mn 2
                          %mn 1
                      %mo =
                      %msub
                        %mi Φ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Phi_2 \Psi_{2 1} = \Phi_1
            %p
              Let us consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Phi_2
              applied to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mrow
                        %mn 2
                        %mn 1
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \psi_{2 1} \circ f
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f \in E_1
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              takes values in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mrow
                          %mn 1
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} W_{1 2}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ψ
                              %mrow
                                %mn 2
                                %mn 1
                            %mo ∘
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi ψ
                              %mrow
                                %mn 2
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %msub
                              %mi θ
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi π
                            %mo ×
                            %msub
                              %mi η
                              %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi η
                              %mn 1
                            %mover
                              %mi f
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\psi_{2 1} \circ f)(x) &amp;= \psi_{2 1}(f(x)) \\
                    \&amp;= (x, \theta_1(x, \hat{f}(x))) \\
                    \&amp;= (x, (\pi \times \eta_2)^{-1}(g_2(x), \eta_1\hat{f}(x)))
                    \\end{aligned}
            %p
              Now the result applying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Phi_2
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 2
                    %mo ∘
                    %mi h
                  %annotation{:encoding => "application/x-tex"} \eta_2 \circ h
              where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mover
                        %mi h
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h(x) = (x, \hat{h}(x))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Phi_2
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mrow
                        %mn 2
                        %mn 1
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \psi_{2 1} \circ f
              is the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %msub
                      %mi η
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %msub
                      %mi η
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
