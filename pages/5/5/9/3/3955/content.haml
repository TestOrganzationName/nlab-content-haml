                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi η
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi V
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} (g_2(x), \eta_1(v)) \in V_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
