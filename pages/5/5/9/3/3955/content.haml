              is a convenient vector space. I need to expand on this and check that all is as I think it is.
          %p
            We define a map for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi E
                    %mi g
                  %mo →
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo ,
                  %mi M
                  %mo ;
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi Q
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi P
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi \colon E_g \to C^\infty(N,M;\{Q_i\},\{P_i\})
            as follows. Let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msub
                      %mi E
                      %mi p
                  %annotation{:encoding => "application/x-tex"} f \in E_p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a section of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi g
                    %mo *
                  %mi T
                  %mi M
                %annotation{:encoding => "application/x-tex"} g^* T M
            and so is a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo →
                    %msup
                      %mi g
                      %mo *
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} N \to g^* T M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mo *
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} g^* T M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            as a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo →
                  %mi N
                  %mo ×
                  %mi T
                  %mi M
                %annotation{:encoding => "application/x-tex"} N \to N \times T M
            which projects to the identity on the first factor. By applying the projection to the second factor, we obtain a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mi N
                    %mo →
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \hat{f} \colon N \to T M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            produces a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo ∘
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mi N
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \eta \circ \hat{f} \colon N \to M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msub
                      %mi E
                      %mi g
                  %annotation{:encoding => "application/x-tex"} f \in E_g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat{f}
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mi i
                %annotation{:encoding => "application/x-tex"} Q_i
            lands in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mi P
                      %mi i
                  %annotation{:encoding => "application/x-tex"} T P_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo ∘
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \eta \circ \hat{f}
            takes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mi i
                %annotation{:encoding => "application/x-tex"} Q_i
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi i
                  %annotation{:encoding => "application/x-tex"} P_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ↦
                  %mi η
                  %mo ∘
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} f \mapsto \eta \circ \hat{f}
            is what we call
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
          %p
            Let us identify its image. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ⊆
                  %mi M
                  %mo ×
                  %mi M
                %annotation{:encoding => "application/x-tex"} V \subseteq M \times M
            be the image of the local addition. Define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi g
                  %mo ⊆
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo ,
                  %mi M
                  %mo ;
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi Q
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi P
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U_g \subseteq C^\infty(N,M;\{Q_i\},\{P_i\})
            to be the set of those functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi N
                  %mo →
                  %mi M
                  %mo ×
                  %mi M
                %annotation{:encoding => "application/x-tex"} (g,h) \colon N \to M \times M
            takes values in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi g
                %annotation{:encoding => "application/x-tex"} U_g
            and that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            is a bijection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi g
                    %mo →
                    %msub
                      %mi U
                      %mi g
                  %annotation{:encoding => "application/x-tex"} E_g \to U_g
          %p
            Let us start with the image. Let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∈
                    %msub
                      %mi U
                      %mi g
                  %annotation{:encoding => "application/x-tex"} h \in U_g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi N
                  %mo →
                  %mi M
                  %mo ×
                  %mi M
                %annotation{:encoding => "application/x-tex"} (g,h) \colon N \to M \times M
            takes values in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi π
                  %mo ×
                  %mi η
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} (\pi \times \eta)^{-1}
            to get a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi h
                      %mo{:stretchy => "false"} ˇ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi N
                    %mo →
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \check{h} \colon N \to T M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo →
                    %mi N
                    %mo ×
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} N \to N \times T M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mover
                    %mi h
                    %mo{:stretchy => "false"} ˇ
                  %mo =
                  %mi g
                %annotation{:encoding => "application/x-tex"} \pi \check{h} = g
            and so this map ends up in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi g
                    %mo *
                  %mi T
                  %mi M
                %annotation{:encoding => "application/x-tex"} g^* T M
            (which has the subspace structure). Again by construction, the projection of this map to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is the identity and so it is a section of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mo *
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} g^* T M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi P
                %annotation{:encoding => "application/x-tex"} T P
            follows from the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            restricts to a local addition on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi P
                  %annotation{:encoding => "application/x-tex"} h(Q) \subseteq P
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi h
                      %mo{:stretchy => "false"} ˇ
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi T
                    %mi P
                  %annotation{:encoding => "application/x-tex"} \check{h}(Q) \subseteq T P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            is onto. Moreover, this construction yields the inverse of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            and so it is a bijection.
          %p
            Thus we have charts for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mi M
                    %mo ;
                    %mi Q
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(N,M;Q,P)
          %h3#transition_functions Transition functions
          %p
            The next step is the transition functions. To prove this in full generality, we assume not just two different functions at which to base our charts, but also two different local additions to define them. This will show that our resulting manifold structure is independent of this choice. We could go further than we do, and allow our local additions to be in the most general form given at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/local+addition"} local addition
          %p
            Thus we start with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msub
                    %mi g
                    %mn 2
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo ,
                  %mi M
                  %mo ;
                  %mi Q
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g_1, g_2 \in C^\infty(N,M;Q,P)
            and two local additions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 1
                    %mo ,
                    %msub
                      %mi η
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mi M
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \eta_1, \eta_2 \colon T M \to M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 1
                %annotation{:encoding => "application/x-tex"} V_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 2
                %annotation{:encoding => "application/x-tex"} V_2
            for the images of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi π
                  %mo ×
                  %msub
                    %mi η
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\pi \times \eta_1)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %msub
                      %mi η
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\pi \times \eta_2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 1
                  %mo =
                  %msub
                    %mi E
                    %mrow
                      %msub
                        %mi g
                        %mn 1
                %annotation{:encoding => "application/x-tex"} E_1 = E_{g_1}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                    %mo =
                    %msub
                      %mi E
                      %mrow
                        %msub
                          %mi g
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} E_2 = E_{g_2}
          %p
            We define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mrow
                      %mn 1
                      %mn 2
                  %mo ∈
                  %msubsup
                    %mi g
                    %mn 1
                    %mo *
                  %mi T
                  %mi M
                %annotation{:encoding => "application/x-tex"} W_{1 2} \in g_1^* T M
            as follows. We describe a point in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi g
                    %mn 1
                    %mo *
                  %mi T
                  %mi M
                %annotation{:encoding => "application/x-tex"} g_1^* T M
            by specifying its point in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ×
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} N \times T M
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mrow
                      %mn 1
                      %mn 2
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msubsup
                    %mi g
                    %mn 1
                    %mo *
                  %mi T
                  %mi M
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi η
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi V
                    %mn 2
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  W_{1 2} \coloneqq \{(x,v) \in g_1^* T M : (g_2(x),\eta_1(v)) \in V_2\}
          %p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mrow
                      %mn 2
                      %mn 1
                  %mo ⊆
                  %msubsup
                    %mi g
                    %mn 2
                    %mo *
                  %mi T
                  %mi M
                %annotation{:encoding => "application/x-tex"} W_{2 1} \subseteq g_2^* T M
            similarly.
          #diff.num_lemma
            %h6#lemma Lemma
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mrow
                        %mn 1
                        %mn 2
                    %mo ≅
                    %msub
                      %mi W
                      %mrow
                        %mn 2
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} W_{1 2} \cong W_{2 1}
          .proof
            %h6#proof Proof
            %p
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 2
                    %mo ×
                    %msub
                      %mi η
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mi N
                    %mo ×
                    %mi T
                    %mi M
                    %mo →
                    %mi M
                    %mo ×
                    %mi M
                  %annotation{:encoding => "application/x-tex"} g_2 \times \eta_1 \colon N \times T M \to M \times M
              is smooth and so the preimage of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V_2
              under this map is open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ×
                      %mi T
                      %mi M
                    %annotation{:encoding => "application/x-tex"} N \times T M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mrow
                        %mn 1
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} W_{1 2}
              is open in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mo *
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} g^* T M
              and the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, v) \mapsto (g_2(x), \eta_1(v))
              is a smooth map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mrow
                          %mn 1
                          %mn 2
                      %mo →
                      %msub
                        %mi V
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} W_{1 2} \to V_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %msub
                      %mi η
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mi M
                    %mo →
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} (\pi \times \eta_2) \colon T M \to V_2
              is a diffeomorphism, we can define a smooth map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi θ
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi W
                      %mrow
                        %mn 1
                        %mn 2
                    %mo →
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \theta_1 \colon W_{1 2} \to T M
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi θ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %msub
                      %mi η
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\theta_1(x,v) = (\pi \times \eta_2)^{-1}(g_2(x), \eta_1(v))
            %p Now
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %msub
                      %mi θ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %msub
                      %mi η
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi \theta_1(x,v) = \pi(\pi \times \eta_2)^{-1}(g_2(x),\eta_1(v)) = g_2(x)
            %p
              so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi θ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi T
                      %mrow
                        %msub
                          %mi g
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \theta_1(x,v) \in T_{g_2(x)} M
              and thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi θ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi g
                      %mn 2
                      %mo *
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} (x,\theta_1(x,v)) \in g_2^* T M
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi W
                        %mrow
                          %mn 1
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} (x,v) \in W_{1 2}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 2
                    %msub
                      %mi θ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi η
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo ×
                    %msub
                      %mi η
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_2 \theta_1(x,v) = \eta_2(\pi \times \eta_2)^{-1}(g_2(x),\eta_1(v)) = \eta_1(v)
            %p
              so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi η
                      %mn 2
                    %msub
                      %mi θ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g_1(x),\eta_2\theta_1(x,v)) = (g_1(x),\eta_1(v))
              which is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} V_1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %msub
                        %mi θ
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi W
                        %mrow
                          %mn 2
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} (x,\theta_1(x,v)) \in W_{2 1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mn 2
                        %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi W
                      %mrow
                        %mn 1
                        %mn 2
                    %mo →
                    %msub
                      %mi W
                      %mrow
                        %mn 2
                        %mn 1
                    %mo ,
                    %mspace{:width => "2em"}
                    %msub
                      %mi ϕ
                      %mrow
                        %mn 1
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi θ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_{2 1} \colon W_{1 2} \to W_{2 1}, \qquad \phi_{1 2}(x,v) = (x, \theta_1(x,v))
            %p
              Similarly, we have a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mn 1
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi_{1 2}
              in the other direction. Both of these maps are smooth since they are smooth into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ×
                      %mi T
                      %mi M
                    %annotation{:encoding => "application/x-tex"} N \times T M
            %p
              Let us consider
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mrow
                          %mn 1
                          %mn 2
                      %msub
                        %mi ϕ
                        %mrow
                          %mn 2
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi_{1 2}\phi_{2 1}(x,v)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ϕ
                              %mrow
                                %mn 1
                                %mn 2
                            %msub
                              %mi ϕ
                              %mrow
                                %mn 2
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi ϕ
                              %mrow
                                %mn 1
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %msub
                              %mi θ
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %msub
                              %mi θ
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %msub
                              %mi θ
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi π
                            %mo ×
                            %msub
                              %mi η
                              %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi η
                              %mn 2
                            %msub
                              %mi θ
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi π
                            %mo ×
                            %msub
                              %mi η
                              %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi η
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi π
                            %mo ×
                            %msub
                              %mi η
                              %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi π
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi η
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\phi_{1 2}\phi_{2 1}(x,v) &amp;= \phi_{1 2}(x, \theta_1(x,v)) \\
                    \&amp;=(x, \theta_2(x, \theta_1(x,v))) \\
                    \&amp;=(x, (\pi \times \eta_1)^{-1}(g_1(x), \eta_2\theta_1(x,v))) \\
                    \&amp;=(x, (\pi \times \eta_1)^{-1}(g_1(x), \eta_1(v))) \\
                    \&amp;=(x, (\pi \times \eta_1)^{-1}(\pi(v),\eta_1(v))) \\
                    \&amp;=(x,v)
                    \\end{aligned}
            %p
              where we have used the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi g
                      %mn 1
                      %mo *
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} (x,v) \in g_1^*T M
              so
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi g
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi(v) = g_1(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mn 2
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi_{2 1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mn 1
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi_{1 2}
              are inverses, whence they are diffeomorphisms.
          #trans.num_lemma
            %h6#lemma_2 Lemma
            %p
              The transition function is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ↦
                      %msub
                        %mi ϕ
                        %mrow
                          %mn 2
                          %mn 1
                      %mo ∘
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f \mapsto \phi_{2 1} \circ f
          .proof
            %h6#proof_2 Proof
            %p
              Let us start with the domain and codomain of the transition function. The domain is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi f
                      %mo ∈
                      %msub
                        %mi E
                        %mn 1
                      %mo :
                      %msub
                        %mi Φ
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi U
                        %mn 2
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{f \in E_1 : \Phi_1(f) \in U_2\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} U_2
              consists of those functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:lspace => "verythinmathspace"} :
                    %mi N
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} h \colon N \to M
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g_2, h)
              takes values in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} V_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi U
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Phi_1(f) \in U_2
              if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 2
                      %mo ,
                      %msub
                        %mi Φ
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi V
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} (g_2, \Phi_1(f)) \in V_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi η
                        %mn 1
                      %mo ∘
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \Phi_1(f) = \eta_1 \circ \hat{f}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi N
                    %annotation{:encoding => "application/x-tex"} x \in N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ≔
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} v \coloneqq \hat{f}(x) \in T M
              must be such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
