                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
