                      %msub
                        %mi P
                        %mi i
                      %mo ,
                      %msub
                        %mi F
                        %mi i
                      %mo ,
                      %msub
                        %mi c
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X_i = (P_i,F_i,c_i)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                      %mo ,
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} i = 1,2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} (
                      %mi 𝒯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E(\mathcal{T})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo ,
                    %mi β
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\alpha,\beta)
              be a morphism from the first to the second. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              is a natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
