              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ∘
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \gamma \circ \psi
              is a constant element in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi T
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P(T_0)
          %p The result that the natural transformations depend only on the existence of a morphism does not carry over to this extended setting.
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Andrew+Stacey"}> Andrew
              \: Useful to have an example here, of course.
          %p
            Let us fix a
            = succeed "\u2013object" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} T_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒯
                  %mo ×
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi 𝒯
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \mathcal{T} \times E(\mathcal{T}) \to Set
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msub
                    %mi P
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (T,X) \mapsto P_X(T)
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi Set
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} |
                  %mi T
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                  %mo ,
                  %mo{:stretchy => "false"} |
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (T,X) \mapsto Set(|T|_{T_0},|X|_{T_0})
          %p
            Let us, to simplify notation, identify
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            with its image in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi 𝒯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E(\mathcal{T})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_X(T)
            is naturally isomorphic to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi 𝒯
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(\mathcal{T})(T,X)
            so the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↦
                  %mo{:stretchy => "false"} |
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                %annotation{:encoding => "application/x-tex"} X \mapsto |X|_{T_0}
            is a functor defines a natural transformation from the first to the second via
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi 𝒯
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Set
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} |
                  %mi T
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                  %mo ,
                  %mo{:stretchy => "false"} |
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  P_X(T) \cong E(\mathcal{T})(T,X) \to Set(|T|_{T_0}, |X|_{T_0})
          %p In a similar fashion, we obtain a natural transformation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
