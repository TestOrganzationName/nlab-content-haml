                    %mo ,
                    %mi T
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}(T_1,T')
              so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ∘
                    %mi ψ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi \circ (\gamma \circ \psi)
              is a constant morphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi T
                        %mn 0
                      %mo ,
                      %mi T
                      %mo ′
                      %mo{:stretchy => "false"} )
