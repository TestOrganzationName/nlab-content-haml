              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ∈
                    %msub
                      %mi P
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mn 0
                    %mo{:stretchy => "false"} )
