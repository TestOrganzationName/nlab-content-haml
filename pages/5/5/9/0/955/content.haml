                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi S
                    %annotation{:encoding => "application/x-tex"} |-|_S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              be an object of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                    %annotation{:encoding => "application/x-tex"} \mathcal{T}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ≠
                      %mi β
                      %mo ∈
                      %msub
                        %mi P
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha \ne \beta \in P_X(T)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi NatTrans
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mi X
                      %mo ,
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P_X(T) = NatTrans(F_X,F_T)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} T'
              for which
