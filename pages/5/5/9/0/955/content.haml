                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Set
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} |
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                  %mo ,
