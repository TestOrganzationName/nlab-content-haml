              is constant. That the morphisms correspond is obvious.
            %p
              A
              = succeed "\u2013morphism" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                    %annotation{:encoding => "application/x-tex"} \mathcal{T}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
