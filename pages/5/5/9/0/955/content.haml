                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_0 \to T_1
              defines a natural transformation of functors.
          .proof
            %h6#proof Proof
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi i
