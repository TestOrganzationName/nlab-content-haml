              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ∘
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \phi \circ \gamma
              is a constant morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                    %mo{:stretchy => "false"} (
                    %msub
