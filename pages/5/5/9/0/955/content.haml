                    %mo →
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \psi : T_0 \to T_1
              defines a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
