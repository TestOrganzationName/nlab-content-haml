          %h2#pregroup_semantics_as_strong_monoidal_functors Pregroup semantics as strong monoidal functors
          %p
            One may give a
            %a.existingWikiWord{:href => "/nlab/show/semantics"} semantics
            to a pregroup grammar
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi Σ
                  %mo ,
                  %mi Δ
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = (B, \Sigma, \Delta, s)
            by defining a strong
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msub
                      %mi C
                      %mi G
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} F : C_G \to S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi G
                %annotation{:encoding => "application/x-tex"} C_G
            is the free
            %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
            described in
            = succeed "." do
              %a{:href => "#PregroupGrammar"} section 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a suitable
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtext FdVect
                %annotation{:encoding => "application/x-tex"} \text{FdVect}
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext Rel
                  %annotation{:encoding => "application/x-tex"} \text{Rel}
            %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            as a monoidal functor from a syntactic category to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext Set
                  %annotation{:encoding => "application/x-tex"} \text{Set}
          %p
            We require the image for all words
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo ∈
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} w \in \Sigma
            to be the monoidal unit
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi I
                  %annotation{:encoding => "application/x-tex"} F(w) = I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} (w, t) \in \Delta
            is given by a state
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi I
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(w, t) : I \to F(t)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi I
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(r) : I \to F(s)
            for a sentence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi w
                    %mn 1
                  %mi …
                  %msub
                    %mi w
                    %mi n
                  %mo ∈
                  %msup
                    %mi Σ
                    %mi n
                %annotation{:encoding => "application/x-tex"} w_1 \dots w_n \in \Sigma^n
            with grammatical reduction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo :
                  %msub
                    %mi w
                    %mn 1
                  %mi …
                  %msub
                    %mi w
                    %mi n
                  %mo →
                  %mi s
                %annotation{:encoding => "application/x-tex"} r : w_1 \dots w_n \to s
            may then be computed from the individual meanings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi w
                    %mi i
                  %mo ,
                  %msub
                    %mi t
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi I
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(w_i, t_i) : I \to F(t_i)
            of the words, following
            %a.existingWikiWord{:href => "/nlab/show/Gottlob+Frege"} Frege's
            principle of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/compositionality"} compositionality
            %a{:href => "#Preller05"} Preller 2005
            as well as in a series of papers by
            %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"} Bob Coecke
            and others, see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/categorical+compositional+distributional+semantics"} categorical compositional distributional semantics
          %h2#expressive_power_and_extensions Expressive power and extensions
          %p
            %strong
              Theorem (
              %a{:href => "#BuszkowskiMoroz08"}> Buszkowski, Moroz 2008
              ):
            For each pregroup grammar
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/context-free+grammar"} context-free grammar
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ′
                %annotation{:encoding => "application/x-tex"} G'
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(G) = L(G')
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ′
                %annotation{:encoding => "application/x-tex"} G'
            may be computed in time polynomial in the size of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            The opposite direction also holds, hence pregroup grammar and
            %a.existingWikiWord{:href => "/nlab/show/context-free+grammar"} context-free grammar
            are said to be
            = succeed ":" do
              %strong weakly equivalent
          %p Since it is generally accepted that natural languages go beyond context-free languages this result illustrates the lack of expressive power of pregroup grammars whence it becomes necessary to enhance the original grammar model:
          %p
            One way (
            %a{:href => "#Kobele05"}> Kobele 2005
            ) is to consider
            %strong product pregroup grammars
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 1
                    %mo ×
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_1\times G_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                %annotation{:encoding => "application/x-tex"} w
            a tuple
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mn 1
                  %mo ,
                  %msub
                    %mi t
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (t_1,t_2)
            of syntactic types with grammaticality of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mn 1
                  %mo ,
                  %msub
                    %mi t
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (w,(t_1,t_2))
            checked by parallel computation of the grammaticality of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo ,
                  %msub
                    %mi t
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (w,t_1)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 1
                %annotation{:encoding => "application/x-tex"} G_1
            and of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo ,
                  %msub
                    %mi t
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (w,t_2)
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mn 1
                  %mo ,
                  %msub
                    %mi t
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (w,(t_1,t_2))
            is then grammatical iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo ,
                  %msub
                    %mi t
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (w,t_1)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo ,
                  %msub
                    %mi t
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (w,t_2)
            are i.e.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi G
                    %mn 1
                  %mo ×
                  %msub
                    %mi G
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi L
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi G
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∩
                  %mi L
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi G
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L(G_1\times G_2)= L(G_1)\cap L(G_2)
            (cf.
            = succeed "," do
              %a{:href => "#KobeleKracht05"} Kobele&amp;Kracht (2005)
            = succeed ")." do
              %a{:href => "#Lambek08"} Lambek (2008)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn 1
                    %mo ×
                    %msub
                      %mi P
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} P_1\times P_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mn 1
                  %mo ×
                  %msub
                    %mi P
                    %mn 2
                %annotation{:encoding => "application/x-tex"} P_1\times P_2
            is not free!
          %p
            Kobele and Kracht (
            %a{:href => "KobeleKracht05"}> 2005
            ) use this together with the above result by Buszkowski and the classical result in formal language theory that any type 0 language
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is the homomorphic image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi L
                    %mn 1
                  %mo ∩
                  %msub
                    %mi L
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} h(L_1\cap L_2)
            of the intersection of two (deterministic) context-free languages
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mn 1
                  %mo ,
                  %msub
                    %mi L
                    %mn 2
                %annotation{:encoding => "application/x-tex"} L_1,L_2
            in order to show that
            %em pregroup grammars generate every type 0 language
            when type checking is done in
            %em arbitrary
            pregroups.
          %p
            Since it is usually assumed that natural languages do not go beyond
            %a.existingWikiWord{:href => "/nlab/show/mildly+context-sensitive+grammar"} mildly context-sensitive languages
            one sees that (homomorphic images) of products of arbitrary pregroup grammars have excessive power and it becomes necessary to cut back this power. One way to do this is by restricting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 1
                %annotation{:encoding => "application/x-tex"} G_1
            to be of a type simpler than context-free e.g. a
            %span.newWikiWord
              Dyck language
              %a{:href => "/nlab/new/Dyck+language"} ?
            thought of now as a control language supervising the “context-free” computations in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_2
            = succeed ")." do
              %a{:href => "Kobele05"} 2005
          %p
            Another approach to adapt the pregroup grammar formalism to mildly context-sensitive languages was proposed by
            %a{:href => "#GenkinEtAl"} Genkin et al. (2010)
            which augment pregroup grammars with buffers.
          %h2#references References
          %ul
            %li#Lambek99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joachim+Lambek"}> Joachim Lambek
                ,
                = succeed "," do
                  %em Type Grammar Revisited
            %li#Preller05
              %p
                %span.newWikiWord>
                  Anne Preller
                  %a{:href => "/nlab/new/Anne+Preller"} ?
                ,
                = succeed "," do
                  %em Category Theoretical Semantics for Pregroup Grammars
                = succeed ")" do
                  %a{:href => "https://www.researchgate.net/publication/220718685_Category_Theoretical_Semantics_for_Pregroup_Grammars"} pdf
            %li#PrellerLambek07
              %p
                %span.newWikiWord>
                  Anne Preller
                  %a{:href => "/nlab/new/Anne+Preller"} ?
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Joachim+Lambek"} Joachim Lambek
                = succeed "," do
                  %em Free Compact 2-Categories
                = succeed ")" do
                  %a{:href => "https://hal-lirmm.ccsd.cnrs.fr/lirmm-00137681v2/document"} pdf
            %li#Lambek08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joachim+Lambek"}> Joachim Lambek
                ,
                = succeed "," do
                  %em From Word to Sentence: A Computational Algebraic Approach to Grammar
                = succeed ")" do
                  %a{:href => "http://www.math.mcgill.ca/barr/lambek/pdffiles/2008lambek.pdf"} pdf
            %li#BuszkowskiMoroz08
              %p
                %span.newWikiWord>
                  Wojciech Buszkowski
                  %a{:href => "/nlab/new/Wojciech+Buszkowski"} ?
                ,
                = succeed "," do
                  %span.newWikiWord
                    Katarzyna Moroz
                    %a{:href => "/nlab/new/Katarzyna+Moroz"} ?
                = succeed "," do
                  %em Pregroup Grammars and Context-free Grammars
                = succeed ")" do
                  %a{:href => "https://pdfs.semanticscholar.org/1924/30f2252b6e0a7f982a3ae69a3ccf9c2981c0.pdf"} pdf
            %li#Buszkowski01
              %p
                %span.newWikiWord>
                  Wojciech Buszkowski
                  %a{:href => "/nlab/new/Wojciech+Buszkowski"} ?
                \.
                %em Lambek grammars based on pregroups.
                Logical Aspects of Computational Linguistics, LNAI 2099: 95–109, 2001.
            %li#Coecke13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"}> Bob Coecke
                ,
                = succeed "," do
                  %em An alternative Gospel of structure: order, composition, processes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1307.4038"} arxiv:1307.4038
            %li#Kobele05
              %p
                %span.newWikiWord>
                  Gregory M. Kobele
                  %a{:href => "/nlab/new/Gregory+M.+Kobele"} ?
                ,
                %em Pregroups, Products, and Generative Power
                , handout Chieti workshop on pregroups May 2005.
            %li#KobeleKracht05
              %p
                %span.newWikiWord>
                  Gregory M. Kobele
                  %a{:href => "/nlab/new/Gregory+M.+Kobele"} ?
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Marcus+Kracht"} Marcus Kracht
                %em On Pregroups, Freedom, and (Virtual) Conceptual Necessity
                , U. Penn Working Papers in Linguistics
                %strong 10
                no.1 (2005).
            %li#GenkinEtAl10
              %p
                %span.newWikiWord>
                  Daniel Genkin
                  %a{:href => "/nlab/new/Daniel+Genkin"} ?
                ,
                = succeed "," do
                  %span.newWikiWord
                    Nissim Francez
                    %a{:href => "/nlab/new/Nissim+Francez"} ?
                = succeed "." do
                  %span.newWikiWord
                    Michael Kaminski
                    %a{:href => "/nlab/new/Michael+Kaminski"} ?
                = succeed "," do
                  %em Mildly Context-Sensitive Languages via Buffer Augmented Pregroup Grammars
