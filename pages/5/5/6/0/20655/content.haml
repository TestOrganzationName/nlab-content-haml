            %a.existingWikiWord{:href => "/nlab/show/categorial+grammar"} categorial grammar
            tradition.
          %h2#pregroups Pregroups
          %h3#definition Definition
          %p
            A
            %strong preordered monoid
            is a tuple
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mo ≤
                  %mo ,
                  %mo ⋅
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (P, \leq, \cdot, 1)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mo ≤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (P, \leq)
            is a
            %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mo ⋅
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (P, \cdot, 1)
            is a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            such that the multiplication is monotone, i.e.
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≤
                    %mi c
                    %mo ∧
                    %mi b
                    %mo ≤
                    %mi d
                    %mo ⇒
                    %mi a
                    %mo ⋅
                    %mi b
                    %mo ≤
                    %mi c
                    %mo ⋅
                    %mi d
                    %mspace{:width => "1em"}
                  %annotation{:encoding => "application/x-tex"} a \leq c \wedge b \leq d \implies a \cdot b \leq c \cdot d \quad
              (monotony)
          %p or equivalently:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ≤
                    %mi d
                    %mo ⇒
                    %mi a
                    %mo ⋅
                    %mi b
                    %mo ⋅
                    %mi c
                    %mo ≤
                    %mi a
                    %mo ⋅
                    %mi d
                    %mo ⋅
                    %mi c
                    %mspace{:width => "1em"}
                  %annotation{:encoding => "application/x-tex"} b \leq d \implies a \cdot b \cdot c \leq a \cdot d \cdot c \quad
              (substitution)
          %p
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo ,
                    %mi d
                    %mo ∈
                    %mi P
                  %annotation{:encoding => "application/x-tex"} a, b, c, d \in P
            %strong pomonoid
            is a preordered monoid that is furthermore a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≤
                    %mi b
                    %mo ≤
                    %mi a
                    %mo ⇒
                    %mi a
                    %mo =
                    %mi b
                    %mspace{:width => "1em"}
                  %annotation{:encoding => "application/x-tex"} a \leq b \leq a \implies a = b \quad
              (antisymmetry)
          %p
            A
            %strong pregroup
            is a pomonoid such that every object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi P
                %annotation{:encoding => "application/x-tex"} t \in P
            has
            %a.existingWikiWord{:href => "/nlab/show/category+with+duals"} left and right adjoints
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi t
                      %mi l
                    %mo ,
                    %msup
                      %mi t
                      %mi r
                    %mo ∈
                    %mi P
                  %annotation{:encoding => "application/x-tex"} t^l, t^r \in P
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi t
                      %mi l
                    %mo ⋅
                    %mi t
                    %mo ≤
                    %mn 1
                    %mo ,
                    %mspace{:width => "1em"}
                    %mi t
                    %mo ⋅
                    %msup
                      %mi t
                      %mi r
                    %mo ≤
                    %mn 1
                    %mspace{:width => "1em"}
                  %annotation{:encoding => "application/x-tex"} t^l \cdot t \leq 1, \quad t \cdot t^r \leq 1 \quad
              (contraction)
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi t
                    %mo ⋅
                    %msup
                      %mi t
                      %mi l
                    %mo ,
                    %mspace{:width => "1em"}
                    %mn 1
                    %mo ≤
                    %msup
                      %mi t
                      %mi r
                    %mo ⋅
                    %mi t
                    %mspace{:width => "1em"}
                  %annotation{:encoding => "application/x-tex"} 1 \leq t \cdot t^l, \quad 1 \leq t^r \cdot t \quad
              (expansion)
          %p
            In other words, a pregroup is a
            %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
            which is
            %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/skeletal+category"} skeletal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordered+group"} ordered group
            = succeed ":" do
              %a{:href => "#Coecke13"} Coecke 2013
          %ul
            %li
              If we drop the anti-symmetry axiom for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/posets"} posets
              = succeed "." do
                %strong quasi-pregroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≤
                    %mi a
                    %mo ⋅
                    %msup
                      %mi a
                      %mi l
                    %mo ⋅
                    %mi a
                    %mo ≤
                    %mi a
                    %mo ⇒
                    %mi a
                    %mo =
                    %mi a
                    %mo ⋅
                    %msup
                      %mi a
                      %mi l
                    %mo ⋅
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a \leq a \cdot a^l \cdot a \leq a \implies a = a \cdot a^l \cdot a
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi P
                    %annotation{:encoding => "application/x-tex"} a \in P
            %li
              If we drop the two expansion axioms, we get a
              = succeed "." do
                %strong protogroup
            %li
              If we drop the axioms for the right adjoints, we get a
              = succeed "." do
                %strong left pregroup
              = succeed "." do
                %strong right pregroup
          %h3#monotone_unbounded_functions Monotone unbounded functions
          %p
            Take the natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            and define the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            of
            %a.existingWikiWord{:href => "/nlab/show/monotone+function"} monotone functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi ℕ
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} f : \mathbb{N} \to \mathbb{N}
            that are furthermore unbounded, i.e. for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            there is an
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} m \in \mathbb{N}
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≤
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n \leq f(m)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is a pomonoid with composition as product, identity as unit and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ≤
                  %mi g
                %annotation{:encoding => "application/x-tex"} f \leq g
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(n) \leq g(n)
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is a left pregroup, define:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mtext min
                  %mo{:stretchy => "false"} {
                  %mi n
                  %mo ∈
                  %mi ℕ
                  %mo{:stretchy => "false"} |
                  %mi m
                  %mo ≤
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} f^l(m) = \text{min} \{n \in \mathbb{N} \vert m \leq f(n)\}
          %p we get:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi f
                    %mi l
                  %mo ⋅
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi f
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mtext min
                  %mo{:stretchy => "false"} {
                  %mi n
                  %mo ∈
                  %mi ℕ
                  %mo{:stretchy => "false"} |
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo ≤
                  %mi m
                  %mo =
                  %mn 1
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f^l \cdot f)(m) = f^l(f(m)) = \text{min}\{n \in \mathbb{N} \vert f(m) \leq f(n)\} \leq m = 1(m)
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi m
                  %mo ≤
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mtext min
                  %mo{:stretchy => "false"} {
                  %mi n
                  %mo ∈
                  %mi ℕ
                  %mo{:stretchy => "false"} |
                  %mi m
                  %mo ≤
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi f
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ⋅
                  %msup
                    %mi f
                    %mi l
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 1(m) = m \leq f(\text{min} \{ n \in \mathbb{N} \vert m \leq f(n)\}) = f(f^l(m)) = (f \cdot f^l) (m)
          %p
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} m \in \mathbb{N}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mi l
                    %mo ⋅
                    %mi f
                    %mo ≤
                    %mn 1
                    %mo ≤
                    %mi f
                    %mo ⋅
                    %msup
                      %mi f
                      %mi l
                  %annotation{:encoding => "application/x-tex"} f^l \cdot f \leq 1 \leq f \cdot f^l
          %p
            If we replace the natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            by the integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            then the set of unbounded monotone functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi ℤ
                  %mo →
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} f : \mathbb{Z} \to \mathbb{Z}
            is both a left and a right pregroup where:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mi r
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mtext max
                  %mo{:stretchy => "false"} {
                  %mi n
                  %mo ∈
                  %mi ℕ
                  %mo{:stretchy => "false"} |
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi m
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} f^r(m) = \text{max} \{n \in \mathbb{N} \vert f(n) \leq m\}
          %p
            For example, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 2
                  %mi n
                %annotation{:encoding => "application/x-tex"} f(n) = 2 n
            then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mi l
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} ⌈
                    %mfrac
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mn 2
                    %mo{:stretchy => "false"} ⌉
                    %mo ≠
                    %mo{:stretchy => "false"} ⌈
                    %mfrac
                      %mi n
                      %mn 2
                    %mo{:stretchy => "false"} ⌉
                    %mo =
                    %msup
                      %mi f
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^l(n) = \lceil \frac{n + 1}{2} \rceil \neq \lceil \frac{n}{2} \rceil = f^r(n)
          %p
            %strong
              Proposition (
              %a{:href => "#Buszkowski01"}> Buszkowski 2001
              ):
            Every pregroup is a pregroup of functions, i.e. a sub-pomonoid of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} X \to X
            for some poset
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h3#free_pregroups_and_the_switching_lemma Free pregroups and the switching lemma
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/linguistics"} linguistic
            applications, one starts with a
            %a.existingWikiWord{:href => "/nlab/show/partial+order"} poset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi s
                  %mo ,
                  %mi n
                  %mo ,
                  %mi …
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} B = \{ s, n, \dots \}
            of
            %strong basic types
            (e.g. sentence and noun) and then takes the free pregroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi B
                %annotation{:encoding => "application/x-tex"} P_B
            generated by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b \in B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi …
                  %mo ,
                  %msup
                    %mi b
                    %mi ll
                  %mo ,
                  %msup
                    %mi b
                    %mi l
                  %mo ,
                  %mi b
                  %mo ,
                  %msup
                    %mi b
                    %mi r
                  %mo ,
                  %msup
                    %mi b
                    %mi rr
                  %mo ,
                  %mi …
                  %mo ∈
                  %msub
                    %mi P
                    %mi B
                %annotation{:encoding => "application/x-tex"} \dots, b^{ll}, b^l, b, b^r, b^{rr}, \dots \in P_B
            are called
            = succeed ";" do
              %strong simple types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %msub
                    %mi P
                    %mi B
                %annotation{:encoding => "application/x-tex"} t \in P_B
            may then be given as a sequence of simple types. The following lemma makes the parsing problem for free pregroups decidable — i.e. given a sentence type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∈
                  %msub
                    %mi P
                    %mi B
                %annotation{:encoding => "application/x-tex"} s \in P_B
            and the types for a sequence of words
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi t
                      %mi n
                    %mo ∈
                    %msub
                      %mi P
                      %mi B
                  %annotation{:encoding => "application/x-tex"} t_1, \dots, t_n \in P_B
            = succeed "?" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mn 1
                    %mi …
                    %msub
                      %mi t
                      %mi n
                    %mo ≤
                    %mi s
                  %annotation{:encoding => "application/x-tex"} t_1 \dots  t_n \leq s
          %p
            %strong
              Switching lemma (
              %a{:href => "#Lambek99"}> Lambek 1999
              ):
            For any pair of types
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ,
                    %mi t
                    %mo ′
                    %mo ∈
                    %msub
                      %mi P
                      %mi B
                  %annotation{:encoding => "application/x-tex"} t, t' \in P_B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ≤
                  %mi t
                  %mo ′
                %annotation{:encoding => "application/x-tex"} t \leq t'
            then there is a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ″
                  %mo ∈
                  %msub
                    %mi P
                    %mi B
                %annotation{:encoding => "application/x-tex"} t'' \in P_B
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ≤
                  %mi t
                  %mo ″
                %annotation{:encoding => "application/x-tex"} t \leq t''
            without expansions and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ″
                  %mo ≤
                  %mi t
                  %mo ′
                %annotation{:encoding => "application/x-tex"} t'' \leq t'
            without contractions, i.e. free protogroups recognise the same language as free pregroups.
          %h3#from_pregroups_to_compact_2categories From pregroups to compact 2-categories
          %p
            In
            = succeed "," do
              %a{:href => "#PrellerLambek07"} Preller, Lambek 2007
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proof+relevance"} proof relevance
          %p
            Note that the compact 2-categories of Lambek and Preller differ from
            %a.existingWikiWord{:href => "/nlab/show/compact+closed+2-category"} compact closed 2-category
            in that they are not required to be symmetric. A non-symmetric compact closed 2-category with one object is simply a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
          %p
            Given a poset of basic types
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi B
                %annotation{:encoding => "application/x-tex"} C_B
            are the same as that of the free (quasi-)pregroup, the arrows may be described as planar
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagrams
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ,
                    %mi t
                    %mo ′
                    %mo ∈
                    %msub
                      %mi P
                      %mi B
                  %annotation{:encoding => "application/x-tex"} t, t' \in P_B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ≤
                  %mi t
                  %mo ′
                %annotation{:encoding => "application/x-tex"} t \leq t'
            if and only if there is an arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo :
                  %mi t
                  %mo →
                  %mi t
                  %mo ′
                %annotation{:encoding => "application/x-tex"} r : t \to t'
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi B
                  %annotation{:encoding => "application/x-tex"} C_B
          %h2#PregroupGrammar Pregroup grammars as free rigid monoidal categories
          %p
            A
            %strong pregroup grammar
            is a tuple
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi Σ
                  %mo ,
                  %mi Δ
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = (B, \Sigma, \Delta, s)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            are finite sets called the
            %em basic types
            and the
            %em vocabulary
            respectively,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo ⊆
                  %mi Σ
                  %mo ×
                  %msub
                    %mi P
                    %mi B
                %annotation{:encoding => "application/x-tex"} \Delta \subseteq \Sigma \times P_B
            is a relation called the
            %em dictionary
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∈
                  %msub
                    %mi P
                    %mi B
                %annotation{:encoding => "application/x-tex"} s \in P_B
            is a designated
            = succeed "." do
              %em sentence type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            is finite, i.e. the set of possible types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %msub
                    %mi P
                    %mi B
                %annotation{:encoding => "application/x-tex"} \Delta(w) \subseteq P_B
            is finite for each word
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ∈
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} w \in \Sigma
            %em language
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is then given by:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %msub
                    %mi w
                    %mn 1
                  %mi …
                  %msub
                    %mi w
                    %mi n
                  %mo ∈
                  %msup
                    %mi Σ
                    %mi n
                  %mo{:stretchy => "false"} |
                  %mi n
                  %mo ∈
                  %mi ℕ
                  %mo ,
                  %mspace{:width => "1em"}
                  %mo ∃
                  %mi t
                  %mo ∈
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ≤
                      %mi n
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi w
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mi t
                  %mo ≤
                  %mi s
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                %annotation{:encoding => "application/x-tex"} L(G) = \big\{ w_1 \dots w_n \in \Sigma^n \vert n \in \mathbb{N}, \quad \exists t \in \prod_{i \leq n} \Delta(w_i) \quad t \leq s \big\}
          %p
            i.e. a sequence of words
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi w
                    %mn 1
                  %mi …
                  %msub
                    %mi w
                    %mi n
                  %mo ∈
                  %msup
                    %mi Σ
                    %mi n
                %annotation{:encoding => "application/x-tex"} w_1 \dots w_n \in \Sigma^n
            is said to be grammatical whenever there is a dictionary entry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi w
                    %mi i
                  %mo ,
                  %msub
                    %mi t
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} (w_i, t_i) \in \Delta
            for each word
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi w
                    %mi i
                %annotation{:encoding => "application/x-tex"} w_i
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mn 1
                    %mi …
                    %msub
                      %mi t
                      %mi n
                    %mo ≤
                    %mi s
                  %annotation{:encoding => "application/x-tex"} t_1 \dots t_n \leq s
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %msub
                    %mi w
                    %mn 1
                  %mi …
                  %msub
                    %mi w
                    %mi n
                  %mo ∈
                  %msup
                    %mi Σ
                    %mi n
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi C
                    %mi G
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi w
                    %mn 1
                  %mi …
                  %msub
                    %mi w
                    %mi n
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo ≠
                  %mi ∅
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                %annotation{:encoding => "application/x-tex"} L(G) = \big\{ w_1 \dots w_n \in \Sigma^n \vert C_G(w_1 \dots w_n, s) \neq \emptyset \big\}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi G
                %annotation{:encoding => "application/x-tex"} C_G
            is the free
            %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
            with:
          %ul
            %li
              generating objects the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo +
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} B + \Sigma
            %li
              generating arrows the dictionary entries
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} (w, t) \in \Delta
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dom
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi w
                  %annotation{:encoding => "application/x-tex"} dom(w, t) = w
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cod
                      %mo{:stretchy => "false"} (
                      %mi w
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi t
                    %annotation{:encoding => "application/x-tex"} cod(w, t) = t
          %p
            That is, a sequence of words is grammatical whenever there exists a string diagram going from the sequence of words to the sentence type. Note that traditionally the identity wires for words
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo ∈
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} w \in \Sigma
            are omitted, hence dictionary entries are depicted as triangles with no input. Contractions are depicted as cups, e.g. from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Alice
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi loves
                  %mo ,
                  %msup
                    %mi n
                    %mi r
                  %mi s
                  %msup
                    %mi n
                    %mi l
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi Bob
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} (Alice, n), (loves, n^r s n^l), (Bob, n) \in \Delta
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %msup
                    %mi n
                    %mi r
                  %mi s
                  %msup
                    %mi n
                    %mi l
                  %mi n
                  %mo ≤
                  %mi s
                %annotation{:encoding => "application/x-tex"} n n^r s n^l n \leq s
