          %h3#1trusses 1-Trusses
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %em 1-truss
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ≡
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ,
                    %mo ≤
                    %mo ,
                    %mo ⪯
                    %mo ,
                    %mi{:mathvariant => "normal"} dim
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T \equiv (T,\leq, \preceq, \mathrm{dim})
              is a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              with two
              %a.existingWikiWord{:href => "/nlab/show/partial+orders"} partial orders
              (the ‘face’ order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                  %annotation{:encoding => "application/x-tex"} \leq
              and the ‘frame’ order
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⪯
                    %annotation{:encoding => "application/x-tex"} \preceq
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ,
                    %mo ≤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi{:mathvariant => "normal"} op
                  %annotation{:encoding => "application/x-tex"} \dim : (T,\leq) \to [1]^{\mathrm{op}}
              such that
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo ,
                      %mo ⪯
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mn 1
                      %mo →
                      %mo .
                      %mo .
                      %mo .
                      %mo →
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (T,\preceq) \cong [n] = (0 \to 1 \to ... \to n)
              %li
                either
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo &lt;
                      %mi i
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} i \lt i+1
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                      %mo &lt;
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i + 1 \lt i
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≺
                      %mi n
                    %annotation{:encoding => "application/x-tex"} i \prec n
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dim
                    %annotation{:encoding => "application/x-tex"} \dim
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/conservative"} conservative
            %p
          %p
          #defn_1-truss_maps.num_defn
            %h6 Definition
            %p
              A
              %em 1-truss map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi T
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} F : T \to S
              is a function of sets that preserves both face and frame order. Further,
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is called
                %em regular
                if
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi dim
                        %mo ∘
                        %mi F
                        %mo ⇒
                        %mi dim
                      %annotation{:encoding => "application/x-tex"} \dim \circ F \Rightarrow \dim
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is called
                %em singular
                if
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi dim
                        %mo ∘
                        %mi F
                        %mo ⇐
                        %mi dim
                      %annotation{:encoding => "application/x-tex"} \dim \circ F \Leftarrow \dim
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is called
                %em dimension-preserving
                if
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi dim
                        %mo ∘
                        %mi F
                        %mo =
                        %mi dim
                      %annotation{:encoding => "application/x-tex"} \dim \circ F = \dim
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇐
                  %annotation{:encoding => "application/x-tex"} \Leftarrow
              denote
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              of functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo ,
                      %mo ≤
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi{:mathvariant => "normal"} op
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ←
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (T,\leq) \to [1]^{\mathrm{op}} = (0 \leftarrow 1)
          %p
          .num_defn
            %h6 Notation
            %p
              Given a truss
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T_{(i)}
              the subset of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi i
                    %annotation{:encoding => "application/x-tex"} \dim(x) = i
          %h3#1truss_bundles 1-Truss bundles
          %p To define bundles of 1-trusses, we first define what are the valid fiber transitions. We dub these ‘1-truss bordisms’.
          %p
          .num_remark
            %h6 Remark
            %p
              Below, a
              %em Boolean profunctor
              is an ordinary
              %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} H : C
              ⇸
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              whose values are either the initial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ≡
                    %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \emptyset \equiv \bot
              or the terminal set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo ≡
                      %mo ⊤
                    %annotation{:encoding => "application/x-tex"} \ast \equiv \top
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is simply a relation of sets. In this case, we call the profunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              a
              %em function
              if it is a functional relation or a
              %em cofunction
              if the dual profunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi{:mathvariant => "normal"} op
                  %annotation{:encoding => "application/x-tex"} H^{\mathrm{op}}
              is a function.
          %p
          #rmk_poset_maps_yield_profunctors.num_remark
            %h6 Remark
            %p
              For any map of
              %a.existingWikiWord{:href => "/nlab/show/posets"} posets
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi P
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} F : P \to Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo →
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^{-1}(x \to y)
              over an arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \to y
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              defines a Boolean profunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^{-1}(x)
              ⇸
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^{-1}(y)
              by mapping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"} \top
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \to b
              is an arrow in
