                  %annotation{:encoding => "application/x-tex"} C = \ast
              is the terminal category in the previous definition, then we recover ordinary
              = succeed "-truss" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %em
                labeled
                = succeed "-truss" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mo{:stretchy => "false"} (
                    %munder
