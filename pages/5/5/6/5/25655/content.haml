          %p Labeled truss bundles are a central ingredient in truss theory as the next section will demonstrate.
          %h3#truss_bundle_classifications Truss bundle classifications
          %p Since fiber transitions in 1-truss bundles are 1-truss bordisms, it comes as no surprise that the category of 1-truss bordisms classifies 1-truss bundles.
          %p
          .num_defn
            %h6 Definition
            %p
              Given 1-truss bordisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %mi T
                  %annotation{:encoding => "application/x-tex"} R : T
              ⇸
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo :
                    %mi S
                  %annotation{:encoding => "application/x-tex"} Q : S
              ⇸
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∘
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} R \circ Q
              (composed as ordinary profunctors) is again a 1-truss bordism. (In contrast, composites of general Boolean profunctors (composed as ordinary profunctors) in general need not themselves be Boolean.) This defines the
              = succeed "." do
                %em
                  category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔗
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathfrak{T}^1
                  of 1-trusses and their bordisms
          %p
          .num_theorem
            %h6 Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              \-truss bundles over a base poset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              up to dimension-preserving base-preserving isomorphism bijectively correspond to functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %msup
                      %mi 𝔗
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} P \to \mathfrak{T}^1
              up to natural isomorphism.
          %p
          .proof
            %h6 Proof
            %p Follows from the definition of 1-truss bundles.
          %p
            (There are also more categorical phrasings of this theorem, as well as the subsequent theorems below, which replace
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            with categorical
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            = succeed ".)" do
              %a{:href => "#DornDouglas21"} Dorn-Douglas 2021, Ch. 2
          %p The theorem now generalizes to labelled 1-truss bundles as follows.
          %p
          .num_defn
            %h6 Definition
            %p
              Given a category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %em
                category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔗
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{T}^1(C)
                of
                = succeed "-labeled" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
              is defined as follows: objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔗
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{T}^1(C)
              are
              = succeed "-labeled" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0]
              = succeed "-labeled" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [1]
              (with domain and codomain given by restricting to fibers over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              resp.
              = succeed ");" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
