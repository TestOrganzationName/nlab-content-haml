                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
              = succeed "-labeled" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [2]
              that restricts over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0 \to 1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo →
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1 \to 2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo →
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0 \to 2)
              to the first, second, resp. third morphism. The fact that this defines a category is shown in
              = succeed "." do
                %a{:href => "#DornDouglas21"} Dorn-Douglas 2021, Sec. 2.3.1
          %p
          .num_theorem
            %h6 Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              \-labelled
              = succeed "-truss" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              up to dimension-preserving base-preserving label-preserving isomorphism bijectively correspond to functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %msup
                      %mi 𝔗
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \to \mathfrak{T}^1(C)
              up to natural isomorphism.
          %p
          .proof
            %h6 Proof
            %p
              Follows from the definition of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔗
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{T}^1(C)
          %p
          .num_remark
            %h6 Remark
            %p
              %em> (Recovering the unlabeled case)
              \. In particular, the preceding two definitions coincide
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔗
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msup
                      %mi 𝔗
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathfrak{T}^1(\ast) \cong \mathfrak{T}^1
              up to (essentially unique!) isomorphism of categories when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} C = \ast
              is terminal.
          %p
          .num_remark
            %h6 Remark
            %p
              %em> (Functoriality of labeled bordism)
              \. Importantly, the construction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔗
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{T}(C)
              is functorial in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi C
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} F : C \to D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔗
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi 𝔗
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi 𝔗
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{T}^1(F) : \mathfrak{T}^1(C) \to \mathfrak{T}^1(D)
              acts on objects and morphisms of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔗
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{T}^1(C)
              by post-composing their labelings with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %em labeled bordism
              functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔗
                      %mn 1
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi Cat
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{T}^1 : \mathbf{Cat} \to \mathbf{Cat}
            %p
          %p
            For a given category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi Cat
                %annotation{:encoding => "application/x-tex"} C \in \mathbf{Cat}
            we can thus apply the labeled bordism functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            times to it: the resulting category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔗
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{T}^n(C)
            classifies
            = succeed "-labeled" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "-truss" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
          .num_theorem
            %h6 Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              \-labelled
              = succeed "-truss" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              up to dimension-preserving base-preserving label-preserving isomorphism bijectively correspond to functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %msup
                      %mi 𝔗
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \to \mathfrak{T}^n(C)
              up to natural isomorphism.
          %p
          .proof
            %h6 Proof
            %p Inductively apply the previous theorem, starting with the highest 1-truss bundle and working your way downwards.
          %p
          .num_remark
            %h6 Remark
            %p
              %em>
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-Truss bundles over categories)
              \. The theorem makes it evident that nothing would have stopped us from defining
              = succeed "-truss" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %em categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              (in place of just posets): indeed, such bundles may be thought of as functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %msup
                      %mi 𝔗
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B \to \mathfrak{T}^n(\ast)
              (or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %msup
                      %mi 𝔗
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B \to \mathfrak{T}^n(C)
              in the labeled case).
          %p
            %a.existingWikiWord{:href => "/nlab/show/Lukas+Heidemann"} Lukas Heidemann
            points out the following nice perspective on the labeled bordism functor.
          %p
          .num_remark
            %h6 Remark
            %p
              %em (Universal construction of the labeled bordism functor)
              Applying the
              %a.existingWikiWord{:href => "/nlab/show/Conduch%C3%A9+functor#conduch_functors_and_2functors_to_prof"} profunctorial Grothendieck construction
              to the (frame-order-forgetting) functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔗
                        %mn 1
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi Prof
                    %annotation{:encoding => "application/x-tex"} \mathfrak{T}^1 \to \mathbf{Prof}
              %a.existingWikiWord{:href => "/nlab/show/Conduch%C3%A9+functor"} exponentiable fibration
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %msup
                        %mi 𝔗
                        %mn 1
                      %mo →
                      %msup
                        %mi 𝔗
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} E\mathfrak{T}^1 \to \mathfrak{T}^1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi 𝔗
                          %mn 1
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi E
                        %msup
                          %mi 𝔗
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{Cat}_{/ \mathfrak{T}^1} \to \mathbf{Cat}_{/ E\mathfrak{T}^1}
              and forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi E
                        %msup
                          %mi 𝔗
                          %mn 1
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Cat
                  %annotation{:encoding => "application/x-tex"} \mathbf{Cat}_{/ E\mathfrak{T}^1} \to \mathbf{Cat}
              has a right adjoint
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Cat
                      %mo →
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Cat
                        %mrow
                          %mo{:stretchy => "false"} /
                          %msup
                            %mi 𝔗
                            %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbf{Cat} \to \mathbf{Cat}_{/ \mathfrak{T}^1}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ↦
                      %msup
                        %mi 𝔗
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo →
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C \mapsto \mathfrak{T}^1(C \to \ast)
              %a.existingWikiWord{:href => "/nlab/show/normal"} normal
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctors"} pseudofunctors
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo :
                      %mi D
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi Prof
                    %annotation{:encoding => "application/x-tex"} H : D \to \mathbf{Prof}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} /
                        %mi C
                  %annotation{:encoding => "application/x-tex"} H_{/\!/ C}
              for such functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              (see
              = succeed ")" do
                %a{:href => "#DornDouglas21"} Dorn-Douglas 20, Term. 2.3.18
          %p
          .num_remark
            %h6 Remark
            %p
              %em
                (Labels in
                = succeed "-categories)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              The construction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔗
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{T}^1(-)
              generalizes to an endofunctor on
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Cat
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathbf{Cat}_\infty
              = succeed "-categories." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          %p
            Thus there is a ‘spectrum’ of base/label structures on which we can reasonably consider truss bundles, ranging from posets over to categories to
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %h3#normalization_theorem Normalization theorem
          %p Another important part of truss theory is normalization.
          %p#reduction
          .num_defn
            %h6 Definition
            %p
              Given
              = succeed "-labeled" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "-truss" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} T'
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              %em reduction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi T
                    %mo →
                    %mi T
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} F : T \to T'
              is a labeled
              = succeed "-truss" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %ol
              %li regular;
              %li
                endpoint-dimension-preserving, meaning it is dimension-preserving on the
                %em endpoints
                of all 1-truss fibers;
              %li base-preserving;
              %li
                label-preserving-on-the-nose, meaning that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi lbl
                        %mi F
                      %mo =
                      %mi{:mathvariant => "normal"} id
                    %annotation{:encoding => "application/x-tex"} \mathsf{lbl}_F = \mathrm{id}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi lbl
                        %mrow
                          %mi T
                          %mo ′
                      %mo ∘
                      %mi F
                      %mo =
                      %msub
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi lbl
                        %mi T
                    %annotation{:encoding => "application/x-tex"} \mathsf{lbl}_{T'} \circ F = \mathsf{lbl}_{T}
                commutes strictly.
            %p
          %p
            (There’s a dual version of the definition that replaces ‘regular’ by ‘singular’; cf. the section on ‘duality’
            = succeed ".)" do
              %a{:href => "#duality"} below
          %p
          .num_defn
            %h6 Terminology
            %p
              We sometimes write reductions as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi T
                      %munder
                        %mo ⟶
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi red
                      %mi T
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} F : T \underset{\mathsf{red}}{\longrightarrow} T'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} T'
              is a
              %em reduct
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
          %p
          .num_defn
            %h6 Terminology
            %p
              A labeled truss whose only reduct is itself is called
              %em normalized
              (or, said to be
              = succeed ")." do
                %em in normal form
          %p
          .num_theorem
            %h6 Theorem
            %p
              (Reduction ends in normal forms). The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Norm
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf{Norm}(T)
              of reducts of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              and reduction between them has a unique terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [[T]]
              (called the normal form of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
          %p
            Various proofs have been given, the first in
            %a{:href => "#Dorn18"} Dorn 2018, 5.2.2
            (in the case of open trusses, see Def.
            = succeed "," do
              %a.maruku-ref{:href => "#defn_open_trusses"}
            %a{:href => "#HRV22"} Heidemann-Reutter-Vicary 2022
            (also for open trusses).
          %p
            A geometric derivation and interpretation of the normalization theorem can be given in terms of ‘the existence of coarsest subdividing framed regular cell complexes of stratification in framed
            = succeed "\u2019," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            = succeed "." do
              %a{:href => "#DornDouglas21"} Dorn-Douglas 2021, Ch. 5
          %h2#combinatorialization_theorems Combinatorialization theorems
          %p
            Trusses are the combinatorial analogues (namely, the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+category"} fundamental categorical structures
          %h3#combinatorial_meshes Combinatorial meshes
          %p
            Bare (unlabeled) trusses are combinatorial analogues of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/meshes"} meshes
          %p
          .num_theorem
            %h6 Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-Meshes up to framed stratified homeomorphism bijectively correspond to
              = succeed "-trusses." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %p
            %strong> Proof sketch
            \. Given an
            %a.existingWikiWord{:href => "/nlab/show/n-mesh"}
