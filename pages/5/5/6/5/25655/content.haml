                    %munder
                      %mi F
                      %mo ̲
                    %mo :
                    %munder
                      %mi T
                      %mo ̲
                    %mo →
                    %munder
                      %mi T
                      %mo ̲
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \underline F : \underline T \to \underline T'
              and a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi lbl
