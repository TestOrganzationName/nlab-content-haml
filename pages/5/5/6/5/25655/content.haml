              is said to be a
              %em combinatorial cone type
              if the underlying truss of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is atomic with cone point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi lbl
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi lbl
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{x\} = \mathsf{lbl}^{-1}\circ \mathsf{lbl}(x)
              (in words: ‘
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is its own stratum’).
          %p#cylinder
          .num_defn
            %h6 Definition
            %p
              (Cylinders). Given a labeled
              = succeed "-truss" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              defined the
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-cylinder
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝕀
                      %mi k
                    %mo ×
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \mathbb{I}^k \times T
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              to be the labeled
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo +
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (m+k)
              obtained from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              be adding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              trivial truss bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast \to \ast
              to its underlying truss.
          %p
          .num_remark
            %h6 Remark
            %p
              (Products). More generally, one can similarly define labeled
              = succeed "-trusses" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mi m
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k+m)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mi T
                  %annotation{:encoding => "application/x-tex"} U \times T
              as
              %em products
              between unlabeled
              = succeed "-trusses" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              and labeled
              = succeed "-trusses" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
          %p
            Recall the definition of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/manifold+diagrams"} manifold diagrams
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %em
                combinatorial manifold
                = succeed "-diagram" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is a stratifed open
              = succeed "-truss" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi T
                  %annotation{:encoding => "application/x-tex"} x \in T
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi T
                      %mrow
                        %mo ≤
                        %mi x
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msup
                      %mi 𝕀
                      %mi k
                    %mo ×
                    %msub
                      %mi C
                      %mi x
                  %annotation{:encoding => "application/x-tex"}
                    [[T^{\leq x}]] = \mathbb{I}^k \times C_x
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi x
                  %annotation{:encoding => "application/x-tex"} C_x
              is a combinatorial cone type.
          %p#manifold_diagram_classification
          .num_theorem
            %h6 Theorem
            %p
              Manifold diagrams, up to framed stratified homeomorphism, bijectively correspond to normalized combinatorial manifold
              = succeed "-diagrams." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %p
            %strong> Proof sketch
            \. Given a manifold
            = succeed "-diagram" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{R}^n,f)
            its corresponding normalized combinatorial manifold
            = succeed "-diagram" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            by the unique coarsest
            = succeed "-mesh" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "-truss" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Entr
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{Entr}(M)
            with the labeling
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Entr
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo →
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf{Entr}(M \to f)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo □
                %annotation{:encoding => "application/x-tex"} \square
          %p
            (See
            %a{:href => "#DornDouglas22"} Dorn-Douglas 2022, Sec. 2
            for details.)
          %h2#duality Duality
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/covariant+functor"} covariant
            %em dualization functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo †
                  %mo :
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Truss
                    %mi n
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Truss
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\dagger : \mathsf{Truss}_n \to \mathsf{Truss}_n
          %p
            from the category of
            = succeed "-trusses" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-truss" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                  %mo ↦
                  %msup
                    %mo ≤
                    %mi{:mathvariant => "normal"} op
                %annotation{:encoding => "application/x-tex"} \leq \mapsto \leq^{\mathrm{op}}
            and fiberwise replacing dimension maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mo ↦
                  %msup
                    %mi dim
                    %mi{:mathvariant => "normal"} op
                %annotation{:encoding => "application/x-tex"} \dim \mapsto \dim^{\mathrm{op}}
            (using that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi{:mathvariant => "normal"} opop
                  %mo ≅
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi{:mathvariant => "normal"} op
                %annotation{:encoding => "application/x-tex"} [1]^{\mathrm{op op}} \cong [1]^{\mathrm{op}}
            uniquely).
          %p
            Dualization of
            = succeed "-trusses" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/involution"} involution
          %ol
            %li Singular maps to regular maps and vice-versa
            %li
              Open trusses to
              %em closed
              trusses and vice-versa
          %p
            Geometrically, dualization dualizes stratifications in the sense of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Poincare+duality"} Poincare duality
            %a.existingWikiWord{:href => "/nlab/show/manifold+diagrams"} manifold diagrams
            and cellular
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pasting+diagrams"} pasting diagrams
            = succeed "." do
              %a{:href => "#DornDouglas22"} Dorn-Douglas 2022
          %p
            Dualization can also be applied to truss bordisms, where it yields a
            %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant
            %em dualization
            functor:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo †
                  %mo :
                  %msup
                    %mi 𝔗
                    %mi n
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔗
                    %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} op
                %annotation{:encoding => "application/x-tex"}
                  \\dagger : \mathfrak{T}^n \to (\mathfrak{T}^n)^{\mathrm{op}}
          %p
            (or, in the labeled case:
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                    %mo :
                    %msup
                      %mi 𝔗
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔗
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi{:mathvariant => "normal"} op
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi{:mathvariant => "normal"} op
                  %annotation{:encoding => "application/x-tex"} \dagger : \mathfrak{T}^n(C) \to (\mathfrak{T}^n(C^{\mathrm{op}}))^{\mathrm{op}}
          %h2#remarks Remarks
          %ul
            %li
              Open trusses have also been called ‘singular cubes’ (e.g. in
              = succeed ")" do
                %a{:href => "#Dorn18"} Dorn 2018
              = succeed "\u2019" do
                %a.existingWikiWord{:href => "/nlab/show/zig-zags"} zig-zags
              %a{:href => "#RV19"} Reutter-Vicary 2019
              and
              = succeed ")." do
                %a{:href => "#HRV22"} Heidemann-Reutter-Vicary 2022
            %li
              There is an unrelated notion of
              %a.existingWikiWord{:href => "/nlab/show/truss"} truss
              used in context of
              %a.existingWikiWord{:href => "/nlab/show/ring+theory"} ring theory
              and
              = succeed "." do
                %a{:href => "https://en.wikipedia.org/wiki/Quantum_algebra"} quantum algebra
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/n-mesh"} n-mesh
            %li
              %a.existingWikiWord{:href => "/nlab/show/manifold+diagram"} manifold diagram
            %li
              %a.existingWikiWord{:href => "/nlab/show/manifold-diagrammatic+n-category"} manifold-diagrammatic n-category
            %li
              %a.existingWikiWord{:href => "/nlab/show/framed+combinatorial+topology"} framed combinatorial topology
          %h2#references References
          %ul
            %li#Dorn18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Dorn"}> Christoph Dorn
                ,
                = succeed "," do
                  %em
                    Associative
                    = succeed "-categories" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                = succeed ")." do
                  %a{:href => "https://arxiv.org/abs/1812.10586"} arXiv:1812.10586
            %li#RV19
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Reutter"}> David Reutter
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jamie+Vicary"} Jamie Vicary
                = succeed "," do
                  %em
                    High-level methods for homotopy construction in associative
                    = succeed "-categories" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                %strong 62
                (2019) 1–13 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1902.03831"}> arXiv:1902.03831
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1109/LICS52264.2021.9470575"} doi:10.1109/LICS52264.2021.9470575
            %li#DornDouglas21
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Dorn"} Christoph Dorn
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christopher+Douglas"} Christopher Douglas
                = succeed "," do
                  %em Framed combinatorial topology
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/2112.14700"} arXiv
                = succeed ")" do
                  %a{:href => "https://cxdorn.github.io/fct-book/"} latest
            %li#HRV22
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lukas+Heidemann"}> Lukas Heidemann
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Reutter"} David Reutter
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jamie+Vicary"} Jamie Vicary
                = succeed "," do
                  %em
                    Zigzag normalisation for associative
                    = succeed "-categories" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/2205.08952"} arXiv:2205.08952
                = succeed "&rbrack;" do
                  %a{:href => "https://dl.acm.org/doi/10.1145/3531130.3533352"} doi:10.1145/3531130.3533352
            %li#DornDouglas22
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Dorn"} Christoph Dorn
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christopher+Douglas"} Christopher Douglas
                = succeed "," do
                  %em Manifold diagrams and tame tangles
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/2208.13758"} arXiv
                = succeed ")" do
                  %a{:href => "https://cxdorn.github.io/manifold-diagram-paper/"} latest
