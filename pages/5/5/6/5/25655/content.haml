                ⇸
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S_{(0)}
                and a cofunction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi T
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R_{(1)} : T_{(1)}
                ⇸
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S_{(1)}
              %li
                Whenever
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo ,
                        %mi s
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo ⊤
                        %mo =
                        %mi R
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo ′
                        %mo ,
                        %mi s
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} R(t,s) = \top = R(t',s')
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ≺
                      %mi t
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} t \prec t'
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ′
                      %mo ≺
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s' \prec s
                but not both.
            %p
          %p
            Importantly, 1-truss bordisms are morphisms of a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔗
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathfrak{T}^1
            that embeds into the category of
            %a.existingWikiWord{:href => "/nlab/show/Prof"} profunctors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Prof
                %annotation{:encoding => "application/x-tex"} \mathbf{Prof}
            (unlike general Boolean profunctors). See the discussion of ‘labels’
            %a{:href => "#labels"} below
            for details.
          %p
          #defn_1-truss_bundle.num_defn
            %h6 Definition
            %p
              A
              %em 1-truss bundle
              over a ‘base’ poset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mo ≤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (P,\leq)
              is a poset map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ,
                    %mo ≤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mo ≤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q : (T,\leq) \to (P,\leq)
              in which, for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi P
                    %annotation{:encoding => "application/x-tex"} x \in P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mi x
                    %mo ,
                    %mo ≤
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi q
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (T^x,\leq) = q^{-1}(x)
              is equipped with the additional structures
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⪯
                    %mo ,
                    %mi dim
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\preceq,\dim)
              of a 1-truss, and, for each arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \to y
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo →
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q^{-1}(x \to y)
              is a 1-truss bordisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mi x
                  %annotation{:encoding => "application/x-tex"} T^x
              ⇸
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mi y
                  %annotation{:encoding => "application/x-tex"} T^y
              (cf. Rmk.
              = succeed ")." do
                %a.maruku-ref{:href => "#rmk_poset_maps_yield_profunctors"}
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %em 1-truss bundle map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msub
                      %mi q
                      %mn 1
                    %mo →
                    %msub
                      %mi q
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F : q_1 \to q_2
              of 1-truss bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi q
                      %mi i
                    %mo :
                    %msub
                      %mi T
                      %mi i
                    %mo →
                    %msub
                      %mi P
                      %mi i
                  %annotation{:encoding => "application/x-tex"} q_i : T_i \to P_i
              is a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msub
                      %mi T
                      %mn 1
                    %mo →
                    %msub
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F : T_1 \to T_2
              that factors through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi q
                      %mi i
                  %annotation{:encoding => "application/x-tex"} q_i
              by a ‘base’ map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 0
                      %mo :
                      %msub
                        %mi P
                        %mn 1
                      %mo →
                      %msub
                        %mi P
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} F_0 : P_1 \to P_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is fiberwise a 1-truss map (cf. Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#defn_1-truss_maps"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is regular resp. singular resp. dimension-preserving if it is fiberwise so.
