                    %mrow
                      %mfrac
                        %mrow
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi a
                          %mo ≡
                          %mi b
                          %mo :
                          %mi A
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ,
                          %mi x
                          %mo :
                          %mi A
                          %mo ,
                          %mi Δ
                          %mo ⊢
                          %mi B
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                        %mrow
                          %mi Γ
                          %mo ,
                          %mi Δ
                          %mo{:stretchy => "false"} [
