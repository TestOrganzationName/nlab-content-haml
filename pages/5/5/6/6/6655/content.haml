                          %mi{:mathvariant => "normal"} type
                    %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \equiv B \; \mathrm{type} \quad \Gamma \vdash B \equiv C \; \mathrm{type} }{\Gamma \vdash A \equiv C \; \mathrm{type}}
              .maruku-equation
