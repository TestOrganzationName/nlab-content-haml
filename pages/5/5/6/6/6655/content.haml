          %h3#rules_for_types Rules for types
          %p
            Each type in Martin-Löf dependent type theory comes with a type
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/formation+rule"} formation rule
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/introduction+rule"} introduction rule
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/elimination+rule"} elimination rule
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/computation+rule"} computation rule
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/uniqueness+rule"} uniqueness rule
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/contextual+elimination+rules"} contextual elimination rules
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/contextual+conversion+rules"} contextual conversion rules
          %h4#function_types Function types
          %ul
            %li Formation rules for function types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo →
                      %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash B \; \mathrm{type}}{\Gamma \vdash A \to B \; \mathrm{type}}
          %ul
