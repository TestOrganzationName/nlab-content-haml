                        %mi qRel
                      %annotation{:encoding => "application/x-tex"} qRel
              %li
                %a{:href => "#the_category__2"}
                  The category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi qSet
                      %annotation{:encoding => "application/x-tex"} qSet
              %li
                %a{:href => "#internalization"} Internalization
              %li
                %a{:href => "#duality"} Duality
              %li
                %a{:href => "#quantum_sets_as_bundles"} Quantum sets as bundles
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            Quantum sets are a generalization of
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            to the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
          %ul
            %li
              %p
                A quantum set is a
                %a.existingWikiWord{:href => "/nlab/show/C-star+algebra"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
                  \-algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
                that is the
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} c_0
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                of full
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/matrix+algebras"} matrix algebras
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                      %mo ≅
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                        %mrow
                          %msub
                            %mi c
                            %mn 0
                      %msub
                        %mi M
                        %mrow
                          %msub
                            %mi n
                            %mi i
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{A}
                      \\cong
                      \\bigoplus_{i \in I}^{c_0}
                      M_{n_i}(\mathbb{C})
                      \\,.
            %li
              %p
                A quantum set is a
                %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"} von Neumann algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℳ
                    %annotation{:encoding => "application/x-tex"} \mathcal{M}
                that is an
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi l
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} l^\infty
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                of full
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/matrix+algebras"} matrix algebras
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℳ
                      %mo ≅
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                        %mrow
                          %msup
                            %mi l
                            %mn ∞
                      %msub
                        %mi M
                        %mrow
                          %msub
                            %mi n
                            %mi i
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{M}
                      \\cong
                      \\bigoplus_{i \in I}^{l^\infty}
                      M_{n_i}(\mathbb{C})
                      \\,.
            %li
              %p
                A quantum set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is an
                %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed family
                of nonzero
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+Hilbert+spaces"} finite-dimensional Hilbert spaces
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi ℋ
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      X
                      \=
                      \\{\mathcal{H}_i\}_{i \in I}
                      \\,.
          %p
            These definitions do not define equal classes of objects, but they can be extended to define
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent categories
            in two natural ways. Using the second definition of quantum sets, we can take the
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            to be
            %a.existingWikiWord{:href => "/nlab/show/quantum+relations"} quantum relations
            or, inequivalently, to be unital normal
            = succeed "-homomorphisms." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} qRel
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
            of the category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qSet
                  %annotation{:encoding => "application/x-tex"} qSet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qRel
                %annotation{:encoding => "application/x-tex"} qRel
            is equivalent to its own opposite. Quantum sets can be further generalized to “nontracial” quantum sets. This article will use the third definition of quantum sets because this definition avoids operator topologies, making it more accessible to a wider audience.
          %h2#basic_definitions Basic definitions
          %p
          #QuantumSet.num_defn
            %h6 Definition
            %p
              A quantum set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a family of nonzero
              %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+Hilbert+spaces"} finite-dimensional Hilbert spaces
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              that is
              %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed
              by a set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} At
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{At}(X)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi α
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi α
                        %mo ∈
                        %mi{:mathvariant => "normal"} At
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X = \{X_\alpha\}_{\alpha \in \mathrm{At}(X)}
                    \\,.
            %p
          %p
            Very little changes if we allow zero-dimensional Hilbert spaces in this definition; doing so is mathematically more natural but less intuitive. The elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} At
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{At}(X)
            are called the atoms of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Quantum sets are viewed as a generalization of sets by identifying each set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with the quantum set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Inc}(A)
          %p
          #Identification.num_defn
            %h6 Definition
            %p
              For each set A, we define the quantum set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Inc}(A)
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} At
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{At}(\mathrm{Inc}(A)) = A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi α
                    %mo =
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathrm{Inc}(A)_\alpha = \mathbb{C}
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \alpha \in A
          %p The following basic operations generalize the familiar basic operations on sets.
          %p
          #BasicOperations.num_defn
            %h6 Definition
            %p
              Consider quantum sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              according to Def.
              = succeed "." do
                %a.maruku-ref{:href => "#QuantumSet"}
            %ul
              %li
                %p
                  The
                  %em disjoint union
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo +
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X + Y
                  is defined by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} At
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo +
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi{:mathvariant => "normal"} At
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi{:mathvariant => "normal"} At
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{At}(X + Y) \coloneqq \mathrm{At}(X) + \mathrm{At}(Y)
                  and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo +
                        %mi Y
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi α
                        %mo ≔
                        %mrow
                          %mo {
                          %mrow
                            %mtable{:columnalign => "left left", :displaystyle => "false"}
                              %mtr
                                %mtd
                                  %msub
                                    %mi X
                                    %mi α
                                %mtd
                                  %mtext if
                                  %mspace{:width => "thickmathspace"}
                                  %mi α
                                  %mo ∈
                                  %mi{:mathvariant => "normal"} At
                                  %mo{:stretchy => "false"} (
                                  %mi X
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                              %mtr
                                %mtd
                                  %msub
                                    %mi Y
                                    %mi α
                                %mtd
                                  %mtext if
                                  %mspace{:width => "thickmathspace"}
                                  %mi α
                                  %mo ∈
                                  %mi{:mathvariant => "normal"} At
                                  %mo{:stretchy => "false"} (
                                  %mi Y
                                  %mo{:stretchy => "false"} )
                                  %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (X + Y)_\alpha \coloneqq \begin{cases}
                        X_\alpha &amp; \text{if }\;\alpha \in \mathrm{At}(X),
                        \\\
                        Y_\alpha &amp; \text{if }\;\alpha \in \mathrm{At}(Y).
                        \\end{cases}
              %li
                %p
                  The
                  %em Cartesian product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ×
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X \times Y
                  is defined by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} At
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ×
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi{:mathvariant => "normal"} At
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi{:mathvariant => "normal"} At
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{At}(X \times Y) \coloneqq \mathrm{At}(X) \times \mathrm{At}(Y)
                  and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ×
                        %mi Y
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi α
                            %mo ,
                            %mi β
                            %mo{:stretchy => "false"} )
                        %mo ≔
                        %msub
                          %mi X
                          %mi α
                        %mo ⊗
                        %msub
                          %mi Y
                          %mi β
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        (X \times Y)_{(\alpha, \beta)} \coloneqq X_\alpha \otimes Y_\beta,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℋ
                        %mo ⊗
                        %mi 𝒦
                      %annotation{:encoding => "application/x-tex"} \mathcal{H} \otimes \mathcal{K}
                  denotes the Hilbert-space
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            %p
          %p
            We have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Inc
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo +
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi{:mathvariant => "normal"} Inc
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi{:mathvariant => "normal"} Inc
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Inc}(A + B) = \mathrm{Inc}(A) + \mathrm{Inc}(B)
            and that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ×
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Inc}(A \times B) = \mathrm{Inc}(A) \times \mathrm{Inc}(B)
          %p
            The Cartesian product of quantum sets is so named because it generalizes the Cartesian product of sets. However, in contrast to how the Cartesian product of ordinary sets is their
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} categorical product
            in
            %a.existingWikiWord{:href => "/nlab/show/Set"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            in the usual sense of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/universal+properties"} universal properties
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qSet
                %annotation{:encoding => "application/x-tex"} qSet
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qRel
                %annotation{:encoding => "application/x-tex"} qRel
            defined below.
          %p
          .num_remark
            %h6 Remark
            %p
              A similar nomenclatural clash occurs for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Rel"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Rel
                      %annotation{:encoding => "application/x-tex"} Rel
          %p
            In both of the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qRel
                %annotation{:encoding => "application/x-tex"} qRel
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qSet
                  %annotation{:encoding => "application/x-tex"} qSet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo +
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X + Y
            is the
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \times Y
            is the designated
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} qRel
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo +
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X+Y
            is also the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} product
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qSet
                  %annotation{:encoding => "application/x-tex"} qSet
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} product
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is not easily definable and may be notated
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo *
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \ast Y
          %h2#the_category_
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qRel
                %annotation{:encoding => "application/x-tex"} qRel
          %p
          #qRel.num_defn
            %h6 Definition
            %p
              We define the
              %a.existingWikiWord{:href => "/nlab/show/dagger-compact+category"} dagger-compact category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi qRel
                    %annotation{:encoding => "application/x-tex"} qRel
            %ol
              %li
                %p
                  An object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is a quantum set (see Def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#QuantumSet"}
              %li
                %p
                  A morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} R \colon X \to Y
                  is a choice of subspaces
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi R
                          %mrow
                            %mi α
                            %mo ,
                            %mi β
                        %mo ⊆
                        %mi L
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mi α
                        %mo ,
                        %msub
                          %mi Y
                          %mi β
                        %mo{:stretchy => "false"} )
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        R_{\alpha,\beta} \subseteq L(X_\alpha, Y_\beta),
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi ℋ
                        %mo ,
                        %mi 𝒦
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} L(\mathcal{H},\mathcal{K})
                  is the space of all linear maps from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℋ
                      %annotation{:encoding => "application/x-tex"} \mathcal{H}
                  to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒦
                        %annotation{:encoding => "application/x-tex"} \mathcal{K}
              %li
                %p
                  The composition
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ∘
                        %mi R
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} S \circ R \colon X \to Z
                  of morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} R \colon X \to Y
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo{:lspace => "verythinmathspace"} :
                        %mi Y
                        %mo →
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} S \colon Y \to Z
                  is given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo ∘
                        %mi R
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi α
                            %mo ,
                            %mi γ
                        %mo ≔
                        %mi{:mathvariant => "normal"} span
                        %mo{:stretchy => "false"} {
                        %mi s
                        %mi r
                        %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                        %mi r
                        %mo ∈
                        %msub
                          %mi R
                          %mrow
                            %mi α
                            %mo ,
                            %mi β
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %mi s
                        %mo ∈
                        %msub
                          %mi S
                          %mrow
                            %mi β
                            %mo ,
                            %mi γ
                        %mspace{:width => "thickmathspace"}
                        %mtext for some
                        %mspace{:width => "thickmathspace"}
                        %mi β
                        %mo ∈
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} At
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (S \circ R)_{\alpha,\gamma} \coloneqq \mathrm{span}
                        \\{s r \mid r \in R_{\alpha, \beta},\; s \in S_{\beta, \gamma}\;\text{for some}\; \beta \in \At(Y)\}.
              %li
                %p
                  The identity morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} id
                          %mi X
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \mathrm{id}_X\colon X \to X
                  is defined by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi{:mathvariant => "normal"} id
                          %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi α
                            %mo ,
                            %mi β
                        %mo ≔
                        %mrow
                          %mo {
                          %mrow
                            %mtable{:columnalign => "left left", :displaystyle => "false"}
                              %mtr
                                %mtd
                                  %mi{:mathvariant => "normal"} span
                                  %mo{:stretchy => "false"} {
                                  %mn 1
                                  %mo{:stretchy => "false"} }
                                %mtd
                                  %mtext if
                                  %mspace{:width => "thickmathspace"}
                                  %mi α
                                  %mo =
                                  %mi β
                                  %mo ,
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} {
                                  %mn 0
                                  %mo{:stretchy => "false"} }
                                %mtd
                                  %mtext if
                                  %mspace{:width => "thickmathspace"}
                                  %mi α
                                  %mo ≠
                                  %mi β
                                  %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (\mathrm{id}_{X})_{\alpha, \beta} \coloneqq \begin{cases} \mathrm{span}\{1\} &amp; \text{if}\;\alpha = \beta,\\
                        \\{0\} &amp; \text{if}\; \alpha \neq \beta.\end{cases}
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/dagger+category"} dagger
                  of a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} R\colon X \to Y
                  is defined by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi R
                          %mo †
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi β
                            %mo ,
                            %mi α
                        %mo ≔
                        %mo{:stretchy => "false"} {
                        %msup
                          %mi r
                          %mo †
                        %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                        %mi r
                        %mo ∈
                        %msub
                          %mi R
                          %mrow
                            %mi α
                            %mo ,
                            %mi β
                        %mo{:stretchy => "false"} }
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        (R^\dagger)_{\beta, \alpha} \coloneqq \{r^\dagger \mid r \in R_{\alpha, \beta}\},
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi r
                          %mo †
                      %annotation{:encoding => "application/x-tex"} r^\dagger
                  is the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/hermitian+matrix"} Hermitian adjoint
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal product
                  of objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} X'
                  is the Cartesian product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ×
                        %mi X
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} X \times X'
                  (see Def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#BasicOperations"}
              %li
                %p
                  The monoidal product of morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} R\colon X \to Y
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo ′
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo ′
                        %mo →
                        %mi Y
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} R'\colon X' \to Y'
                  is defined by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo ×
                        %mi R
                        %mo ′
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi α
                            %mo ,
                            %mi α
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi β
                            %mo ,
                            %mi β
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi{:mathvariant => "normal"} span
                        %mo{:stretchy => "false"} {
                        %mi r
                        %mo ⊗
                        %mi r
                        %mo ′
                        %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                        %mi r
                        %mo ∈
                        %msub
                          %mi R
                          %mrow
                            %mi α
                            %mo ,
                            %mi β
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %mi r
                        %mo ′
                        %mo ∈
                        %mi R
                        %msub
                          %mo ′
                          %mrow
                            %mi α
                            %mo ′
                            %mo ,
                            %mi β
                            %mo ′
                        %mo{:stretchy => "false"} }
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (R \times R')_{(\alpha, \alpha'),(\beta, \beta')} \coloneqq \mathrm{span}\{r \otimes r' \mid r \in R_{\alpha, \beta},\; r' \in R'_{\alpha', \beta'}\}.
              %li
                %p
                  The monoidal unit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                  is defined by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} At
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mo{:stretchy => "false"} {
                        %mo •
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \mathrm{At}(1) \coloneqq \{\bullet\}
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mn 1
                            %mo •
                          %mo ≔
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} 1_\bullet \coloneqq \mathbb{C}
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} braiding
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mrow
                            %mi X
                            %mo ,
                            %mi Y
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo ×
                        %mi Y
                        %mo →
                        %mi Y
                        %mo ×
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \sigma_{X,Y}\colon X \times Y \to Y \times X
                  is defined by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi σ
                          %mrow
                            %mi X
                            %mo ,
                            %mi Y
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi α
                            %mo ,
                            %mi β
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi β
                            %mo ′
                            %mo ,
                            %mi α
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mo ≔
                        %mrow
                          %mo {
                          %mrow
                            %mtable{:columnalign => "left left", :displaystyle => "false"}
                              %mtr
                                %mtd
                                  %mi{:mathvariant => "normal"} span
                                  %mo{:stretchy => "false"} {
                                  %msub
                                    %mi σ
                                    %mrow
                                      %msub
                                        %mi X
                                        %mi α
                                      %mo ,
                                      %msub
                                        %mi Y
                                        %mi β
                                  %mo{:stretchy => "false"} }
                                %mtd
                                  %mtext if
                                  %mspace{:width => "thickmathspace"}
                                  %mo{:stretchy => "false"} (
                                  %mi α
                                  %mo ,
                                  %mi β
                                  %mo{:stretchy => "false"} )
                                  %mo =
                                  %mo{:stretchy => "false"} (
                                  %mi α
                                  %mo ′
                                  %mo ,
                                  %mi β
                                  %mo ′
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} {
                                  %mn 0
                                  %mo{:stretchy => "false"} }
                                %mtd
                                  %mtext if
                                  %mspace{:width => "thickmathspace"}
                                  %mo{:stretchy => "false"} (
                                  %mi α
                                  %mo ,
                                  %mi β
                                  %mo{:stretchy => "false"} )
                                  %mo ≠
                                  %mo{:stretchy => "false"} (
                                  %mi α
                                  %mo ′
                                  %mo ,
                                  %mi β
                                  %mo ′
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        (\sigma_{X,Y})_{(\alpha,\beta),(\beta', \alpha')} \coloneqq \begin{cases} \mathrm{span}\{\sigma_{X_\alpha, Y_\beta}\} &amp; \text{if}\; (\alpha, \beta) = (\alpha', \beta'),\\
                        \\{0\} &amp; \text{if}\;(\alpha, \beta) \neq (\alpha', \beta'),
                        \\end{cases}
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mrow
                            %msub
                              %mi X
                              %mi α
                            %mo ,
                            %msub
                              %mi Y
                              %mi β
                      %annotation{:encoding => "application/x-tex"} \sigma_{X_\alpha, Y_\beta}
                  denotes the braiding in
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Hilb"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Hilb
                          %annotation{:encoding => "application/x-tex"} Hilb
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} dual
                  of an object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is the dual quantum set
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi X
                            %mo *
                        %annotation{:encoding => "application/x-tex"} X^*
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} At
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi X
                          %mo *
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi{:mathvariant => "normal"} At
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{At}(X^*) \coloneqq \mathrm{At}(X)
                  and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi X
                          %mo *
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi α
                        %mo ≔
                        %msubsup
                          %mi X
                          %mi α
                          %mo *
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        (X^*)_\alpha \coloneqq X_\alpha^*,
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℋ
                          %mo *
                      %annotation{:encoding => "application/x-tex"} \mathcal{H}^*
                  is the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual Hilbert space
            %p
          %p
            Furthermore,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qRel
                %annotation{:encoding => "application/x-tex"} qRel
            has all
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproducts
            %a.existingWikiWord{:href => "/nlab/show/semiadditive+dagger+category"} semiadditive dagger category
            with infinitary dagger biproducts and an infinitary
            %a.existingWikiWord{:href => "/nlab/show/distributive+monoidal+category"} distributive monoidal category
            with a
            %a.existingWikiWord{:href => "/nlab/show/unitary"} unitary
            distributor. The dagger biproduct of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is their disjoint union
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo +
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X + Y
            (see Def.
            = succeed ")." do
              %a.maruku-ref{:href => "#BasicOperations"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is defined by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} At
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \mathrm{At}(0) = \emptyset
          %p
          .num_prop
            %h6 Proposition
            %p
              The dagger-compact category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} qRel
              is
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
              over
              %a.existingWikiWord{:href => "/nlab/show/suplattice"} suplattices
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ≤
                    %mi S
                    %mspace{:width => "2em"}
                    %mo ⇔
                    %mspace{:width => "2em"}
                    %msub
                      %mi R
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                    %mo ⊆
                    %msub
                      %mi S
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                  %annotation{:encoding => "application/x-tex"}
                    R \leq S \qquad \Longleftrightarrow \qquad R_{\alpha, \beta} \subseteq S_{\alpha, \beta}
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %mi{:mathvariant => "normal"} At
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in \mathrm{At}(X)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo ∈
                      %mi{:mathvariant => "normal"} At
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \beta \in \mathrm{At}(Y)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo ,
                      %mi S
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} R, S \colon X \to Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} qRel
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quantaloid"} quantaloid
          %p
            The dagger-compact category
            %a.existingWikiWord{:href => "/nlab/show/Rel"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
            is enriched over suplattices too. It is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/allegory"} allegory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qRel
                %annotation{:encoding => "application/x-tex"} qRel
            fails to be an allegory because the relevant modular law fails. Nevertheless,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qRel
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} qRel(X,Y)
            is always a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/modular+lattice"} modular lattice
          %p
            In effect,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            is an enriched dagger-compact subcategory of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} qRel
          %p
          .num_defn
            %h6 Definition
            %p
              We define the “inclusion”
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Inc
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Rel
                      %mo →
                      %mi qRel
                    %annotation{:encoding => "application/x-tex"} \mathrm{Inc}\colon Rel \to qRel
            %ul
              %li
                %p
                  For each set
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} Inc
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{Inc}(A)
                  as in Def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#Identification"}
              %li
                %p
                  For each relation
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                          %mo{:lspace => "verythinmathspace"} :
                          %mi A
                          %mo →
                          %mi B
                        %annotation{:encoding => "application/x-tex"} R\colon A \to B
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} Inc
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mrow
                          %mo {
                          %mrow
                            %mtable{:columnalign => "left left", :displaystyle => "false"}
                              %mtr
                                %mtd
                                  %mi ℂ
                                %mtd
                                  %mtext if
                                  %mspace{:width => "thickmathspace"}
                                  %mo{:stretchy => "false"} (
                                  %mi α
                                  %mo ,
                                  %mi β
                                  %mo{:stretchy => "false"} )
                                  %mo ∈
                                  %mi R
                                  %mo ,
                              %mtr
                                %mtd
                                  %mn 0
                                %mtd
                                  %mtext if
                                  %mspace{:width => "thickmathspace"}
                                  %mo{:stretchy => "false"} (
                                  %mi α
                                  %mo ,
                                  %mi β
                                  %mo{:stretchy => "false"} )
                                  %mo ∉
                                  %mi R
                                  %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\mathrm{Inc}(R) =
                        \\begin{cases}
                        \\mathbb{C}  &amp; \text{if}\;(\alpha, \beta) \in R, \\
                        0 &amp; \text{if}\;(\alpha, \beta) \notin R,
                        \\end{cases}
                %p
                  where we identify
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi ℂ
                        %mo ,
                        %mi ℂ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} L(\mathbb{C}, \mathbb{C})
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                  in the obvious way.
            %p
          %p
          .num_prop
            %h6 Proposition
            %p
              The “inclusion” functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Rel
                    %mo →
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} \mathrm{Inc}\colon Rel \to qRel
              is an
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched
              %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} strong monoidal
              %a.existingWikiWord{:href => "/nlab/show/dagger+functor"} dagger functor
              that is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful
          %p
            The material in this section is mostly from
            = succeed "." do
              %a{:href => "#Kornell20"} Kornell 2020
            %a{:href => "#KuperbergWeaver12"} Kuperberg &amp; Weaver 2012
            and investigated in
            = succeed ";" do
              %a{:href => "#Weaver12"} Weaver 2012
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantum+relations"} quantum relations
          %h2#the_category__2
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qSet
                %annotation{:encoding => "application/x-tex"} qSet
          %p
          .num_defn
            %h6 Definition
            %p
              We define the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qSet
                  %annotation{:encoding => "application/x-tex"} qSet
              to be the
              %a.existingWikiWord{:href => "/nlab/show/wide+subcategory"} wide subcategory
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} qRel
              whose morphisms are maps. A
              %a.existingWikiWord{:href => "/nlab/show/allegory"} map
              is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X \to Y
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo †
                    %mo ∘
                    %mi f
                    %mo ≥
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f^\dagger \circ f \geq \mathrm{id}_X
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %msup
                        %mi f
                        %mo †
                      %mo ≤
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} f \circ f^\dagger \leq \mathrm{id}_Y
          %p
            In the terminology of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/allegory"} allegories
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} qSet
                    %mo ≔
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi qRel
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \qSet \coloneqq Map(qRel)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} qRel
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qSet
                  %annotation{:encoding => "application/x-tex"} qSet
          %p
          #Cosmos.num_theorem
            %h6 Theorem
            %p
              The symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qSet
                  %annotation{:encoding => "application/x-tex"} qSet
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/B%C3%A9nabou+cosmos"} Bénabou cosmos
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28epi%2C+mono%29+factorization+system"} epi-mono factorization system
          %p
            The closure of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qSet
                %annotation{:encoding => "application/x-tex"} qSet
            can be deduced from general principles (see Theorem 6.16 of
            = succeed ")." do
              %a{:href => "#JencaLindenhovius25"} Jenča &amp; Lindenhovius 2025
          %p
          .num_prop
            %h6 Proposition
            %p
              The “inclusion” functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Rel
                    %mo →
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} \mathrm{Inc}\colon Rel \to qRel
              restricts to a functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Inc
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Set
                      %mo →
                      %mi qSet
                    %annotation{:encoding => "application/x-tex"} \mathrm{Inc}\colon Set \to qSet
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Elm
                      %mo{:lspace => "verythinmathspace"} :
                      %mi qSet
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} \mathrm{Elm}\colon qSet \to Set
          %p
          .num_defn
            %h6 Definition
            %p
              We define the “elements” functor
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Elm
                      %mo{:lspace => "verythinmathspace"} :
                      %mi qSet
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} \mathrm{Elm}\colon qSet \to Set
            %ul
              %li
                %p
                  For each quantum set
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi{:mathvariant => "normal"} Elm
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} {
                          %mi α
                          %mo ∈
                          %mi{:mathvariant => "normal"} At
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi{:mathvariant => "normal"} dim
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi X
                            %mi α
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 1
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} \mathrm{Elm}(X) = \{\alpha \in \mathrm{At}(X) \mid \mathrm{dim} (X_\alpha) = 1\}
              %li
                %p
                  For each morphism
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:lspace => "verythinmathspace"} :
                          %mi X
                          %mo →
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} f \colon X \to Y
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi{:mathvariant => "normal"} Elm
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} {
                          %mo{:stretchy => "false"} (
                          %mi α
                          %mo ,
                          %mi β
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi{:mathvariant => "normal"} Elm
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi{:mathvariant => "normal"} Elm
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi{:mathvariant => "normal"} dim
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi f
                            %mrow
                              %mi α
                              %mo ,
                              %mi β
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 1
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} \mathrm{Elm}(f) = \{(\alpha, \beta) \in \mathrm{Elm}(X) \times \mathrm{Elm}(Y) \mid \mathrm{dim} (f_{\alpha, \beta}) = 1\}
            %p
          %p
            We have that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Elm
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo +
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi{:mathvariant => "normal"} Elm
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi{:mathvariant => "normal"} Elm
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Elm}(X + Y) = \mathrm{Elm}(X) + \mathrm{Elm}(Y)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Elm
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi{:mathvariant => "normal"} Elm
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi{:mathvariant => "normal"} Elm
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Elm}(X \times Y) = \mathrm{Elm}(X) \times \mathrm{Elm}(Y)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Elm
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{Elm}(\mathrm{Inc}(A)) = A
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Elm
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi qSet
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Elm}(X) \cong qSet(1,X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qSet
                  %annotation{:encoding => "application/x-tex"} qSet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Elm
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Elm}(X)
            is essentially the set of
            %a.existingWikiWord{:href => "/nlab/show/global+element"} global elements
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
          #qPow.num_theorem
            %h6 Theorem
            %p
              The inclusion functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qSet
                    %mo ↪
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} qSet \hookrightarrow qRel
              has a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} qPow
                    %mo{:lspace => "verythinmathspace"} :
                    %mi qRel
                    %mo →
                    %mi qSet
                  %annotation{:encoding => "application/x-tex"} \mathrm{qPow}\colon qRel \to qSet
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} qPow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi X
                      %mo *
                    %mo ,
                    %mn 1
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathrm{qPow}(X) = [X^*, 1 + 1]
              for each quantum set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            The notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo *
                %annotation{:encoding => "application/x-tex"} X^*
            refers to the dual of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %a.maruku-ref{:href => "#qRel"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X,Y]
            refers to the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "." do
              %a.maruku-ref{:href => "#Cosmos"}
            %a.maruku-ref{:href => "#qPow"}
            expresses that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qRel
                %annotation{:encoding => "application/x-tex"} qRel
            behaves somewhat like a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/allegory"} power allegory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qPow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} qPow(X)
            is canonically a quantum poset in the sense of Example
            = succeed "." do
              %a.maruku-ref{:href => "#QuantumPoset"}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} qPow
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≇
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} Pow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{qPow}(\mathrm{Inc}(A)) \ncong \mathrm{Inc}(\mathrm{Pow}(A))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Pow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Pow}(A)
            is the
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Elm
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} qPow
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi{:mathvariant => "normal"} Pow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Elm}(\mathrm{qPow}(\mathrm{Inc}(A)) \cong \mathrm{Pow}(A)
          %p
            Overall,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qSet
                %annotation{:encoding => "application/x-tex"} qSet
            is unlike an
            %a.existingWikiWord{:href => "/nlab/show/topos"} elementary topos
            in two respects. First, its monoidal product is not its categorical product, so it is not a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is terminal, so it is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/semicartesian+monoidal+category"} semicartesian monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \times Y
            satisfies the uniqueness condition of the universal property that defines the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} categorical product
          %p
            Second,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qSet
                %annotation{:encoding => "application/x-tex"} qSet
            does not have a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has a unique
            %a.existingWikiWord{:href => "/nlab/show/characteristic+function"} characteristic morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mn 1
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \chi\colon X \to 1 + 1
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo !
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo !
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi f
                %annotation{:encoding => "application/x-tex"} \chi = (! + !) \circ f
            for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi X
                  %mo +
                  %mi X
                %annotation{:encoding => "application/x-tex"} f \colon X \to X + X
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo ∘
                    %mi f
                    %mo =
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \nabla \circ f = \mathrm{id}_X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} !\colon X \to 1
            is the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} unique
            morphism from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi X
                  %mo +
                  %mi X
                %annotation{:encoding => "application/x-tex"} \nabla \colon X \to X + X
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/codiagonal+morphism"} codiagonal
          %p
          .num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a quantum set. There is a
              %a.existingWikiWord{:href => "/nlab/show/one-to-one+correspondence"} one-to-one correspondence
              between the subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi At
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} At(X)
              and the
              %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi qSet
                    %annotation{:encoding => "application/x-tex"} qSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \subseteq X
              corresponds to a subobject
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %mi W
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} j \colon W \to X
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi At
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                  %annotation{:encoding => "application/x-tex"} At(W) = A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mi α
                      %mo =
                      %msub
                        %mi X
                        %mi α
                    %annotation{:encoding => "application/x-tex"} W_\alpha = X_\alpha
          %p
            The material in this section is mostly from
            = succeed "," do
              %a{:href => "#Kornell20"} Kornell 2020
            = succeed "," do
              %a{:href => "#KornellLindenhoviusMislove22"} Kornell, Lindenhovius &amp; Mislove 2022
            = succeed "." do
              %a{:href => "#JencaLindenhovius25"} Jenča &amp; Lindenhovius 2025
          %h2#internalization Internalization
          %p
            Many classes of discrete quantum structures can be defined via
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internalization
            in the
            %a.existingWikiWord{:href => "/nlab/show/dagger-compact+category"} dagger-compact
            %a.existingWikiWord{:href => "/nlab/show/quantaloid"} quantaloid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} qRel
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "-direct" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} c_0
          %p
            We highlight two aspects of this internalization. First, for many classes of discrete quantum structures, the original definition in noncommutative geometry is motivated by sophisticated considerations that are specific to that class. In contrast, the definition via internalization in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qRel
                %annotation{:encoding => "application/x-tex"} qRel
            is simply a reinterpretation of a straightforward definition in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
          %p
            Second, in many cases, a comparable definition via internalization in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qSet
                %annotation{:encoding => "application/x-tex"} qSet
            is not available because the
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal product
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qSet
                %annotation{:encoding => "application/x-tex"} qSet
            is not its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} categorical product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} qRel
            %a.existingWikiWord{:href => "/nlab/show/Rel"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
            and other
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/allegory"} allegories
          %p
          #QuantumPoset.num_remark
            %h6 Example
            %p
              A discrete quantum
              %a.existingWikiWord{:href => "/nlab/show/partial+order"} poset
              is a quantum set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              together with a relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} R\colon X \to X
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo ≤
                        %mi R
                      %annotation{:encoding => "application/x-tex"} \id_X \leq R
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi R
                        %mo ∘
                        %mi R
                        %mo ≤
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R \circ R \leq R
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi R
                          %mo †
                        %mo ∧
                        %mi R
                        %mo =
                        %msub
                          %mi id
                          %mi X
                      %annotation{:encoding => "application/x-tex"} R^\dagger \wedge R = id_X
                  ,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∧
                    %mi S
                  %annotation{:encoding => "application/x-tex"} R \wedge S
              is the
              %a.existingWikiWord{:href => "/nlab/show/meet"} meet
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          %p
          .num_remark
            %h6 Example
            %p
              A discrete quantum
              %a.existingWikiWord{:href => "/nlab/show/graph"} graph
              is a quantum set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              together with a relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} R\colon X \to X
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi R
                          %mo †
                        %mo =
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R^\dagger = R
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo ≤
                        %mi R
                      %annotation{:encoding => "application/x-tex"} \id_X \leq R
                  \.
            %p
              These axioms internalize simple graphs with the convention that every vertex is adjacent to itself. This convention is standard in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quantum+information"} quantum information theory
          %p
          .num_remark
            %h6 Example
            %p
              A discrete quantum
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              is a quantum set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              together with a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ×
                    %msup
                      %mi X
                      %mo *
                    %mo →
                    %mi{:mathvariant => "normal"} Inc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d\colon X \times X^* \to \mathrm{Inc}([0, \infty))
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} Inc
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo †
                        %mo ∘
                        %mi d
                        %mo =
                        %msub
                          %mi ε
                          %mi X
                      %annotation{:encoding => "application/x-tex"} \mathrm{Inc}(0)^\dagger \circ d = \varepsilon_X
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} Inc
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ×
                        %mi d
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo ×
                        %msub
                          %mi ε
                          %mi X
                        %mo ×
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %mi{:mathvariant => "normal"} Inc
                        %mo{:stretchy => "false"} (
                        %mo ≤
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mi d
                      %annotation{:encoding => "application/x-tex"} \mathrm{Inc}(+) \circ (d \times d) \circ (\id_X \times \varepsilon_X \times \id_X) \leq \mathrm{Inc}(\leq) \circ d
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi d
                        %mo ∘
                        %msub
                          %mi σ
                          %mrow
                            %msup
                              %mi X
                              %mo *
                            %mo ,
                            %mi X
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi d
                          %mo *
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo †
                      %annotation{:encoding => "application/x-tex"} d \circ \sigma_{X^*,X} = (d^*)^\dagger
                  ,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ε
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \varepsilon_X
              is the
              %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} counit
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                  %annotation{:encoding => "application/x-tex"} \sigma_{X,Y}
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} braiding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo :
                    %mo{:stretchy => "false"} {
                    %mo •
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 0: \{\bullet\} \to [0, \infty)
              has the value
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 0 \in [0, \infty)
          %p
          .num_remark
            %h6 Example
            %p
              A discrete quantum
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              is a quantum set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              together with maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ×
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} m\colon X \times X \to X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo{:lspace => "verythinmathspace"} :
                    %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} e\colon 1 \to X
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi m
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mi m
                        %mo ×
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi m
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo ∘
                        %mi m
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} m \circ (m \times \id_X)= m \circ (\id_X \circ m)
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi m
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo ×
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo =
                        %mi m
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo ×
                        %mi e
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} m \circ (e \times \id_X) = \id_X = m \circ (\id_X \times e)
                  \.
            %p
          %p
          .num_remark
            %h6 Example
            %p
              A discrete quantum
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              is a quantum monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi m
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,m,e)
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi e
                          %mo †
                        %mo ∘
                        %mi m
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mspace{:width => "negativethinmathspace"}
                        %msub
                          %mo ⊤
                          %mi X
                        %mspace{:width => "negativethinmathspace"}
                        %mo ×
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mspace{:width => "negativethinmathspace"}
                        %msubsup
                          %mo ⊤
                          %mi X
                          %mo †
                      %annotation{:encoding => "application/x-tex"} e^\dagger \circ m \circ (\!\top_X\! \times \id_X) = \!\top_X^\dagger
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi e
                          %mo †
                        %mo ∘
                        %mi m
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo ×
                        %mspace{:width => "negativethinmathspace"}
                        %msub
                          %mo ⊤
                          %mi X
                        %mspace{:width => "negativethinmathspace"}
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mspace{:width => "negativethinmathspace"}
                        %msubsup
                          %mo ⊤
                          %mi X
                          %mo †
                      %annotation{:encoding => "application/x-tex"} e^\dagger \circ m \circ (\id_X \times \!\top_X\!) = \!\top_X^\dagger
                  ,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊤
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \top_X
              is the
              %a.existingWikiWord{:href => "/nlab/show/top"} maximum
              relation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} 1 \to X
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi qSet
                    %annotation{:encoding => "application/x-tex"} qSet
          %p
          .num_remark
            %h6 Example
            %p
              A Kac-type discrete quantum group is a quantum monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi m
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,m,e)
              together with a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi X
                      %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i \colon X^* \to X
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi m
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo ×
                        %mi i
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %msub
                          %mi ε
                          %mi X
                        %mo =
                        %mi e
                      %annotation{:encoding => "application/x-tex"} m \circ (\id_X \times i) \circ \varepsilon_{X} = e
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi m
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ×
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %msub
                          %mi ε
                          %mrow
                            %msup
                              %mi X
                              %mo *
                        %mo =
                        %mi e
                      %annotation{:encoding => "application/x-tex"} m \circ (i \times \id_X) \circ \varepsilon_{X^*} = e
                  \.
            %p
          %p
            These examples are all discrete in the sense that the underlying quantum space is discrete and not in the sense that the structure on that quantum space is discrete. This qualification is necessary because the underlying space of a quantum structure is often assumed to be from a larger class. For example, the underlying quantum space of a quantum graph may be a quantum
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/localizable+measurable+space"} measurable space
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} topological space
          %p
            The material in this section is mostly from
            = succeed "," do
              %a{:href => "#KuperbergWeaver12"} Kuperberg &amp; Weaver 2012
            = succeed "," do
              %a{:href => "#Weaver12"} Weaver 2012
            = succeed "," do
              %a{:href => "#Kornell24"} Kornell 2024
            = succeed "." do
              %a{:href => "#ChirvasituKornell25"} Chirvasitu &amp; Kornell 2025
          %h2#duality Duality
          %p
            Quantum sets first appeared implicitly as a class of
            %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
              \-algebras
            in
            = succeed "." do
              %a{:href => "#PodlesWoronowicz90"} Podleś &amp; Woronowicz 1990
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+element"} unital
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"} von Neumann algebras
            %a.existingWikiWord{:href => "/nlab/show/duality"} dual
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qSet
                  %annotation{:encoding => "application/x-tex"} qSet
          %p
          #l-infinity.num_defn
            %h6 Definition
            %p
              For each quantum set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi l
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                      %mrow
                        %msup
                          %mi l
                          %mn ∞
                    %mi L
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    l^\infty(X) \coloneqq \bigoplus_{i \in I}^{l^\infty} L(X_\alpha),
            %p
              where the notation refers to the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi l
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} l^\infty
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of von Neumann algebras.
          %p
            This definition generalizes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi l
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} l^\infty
            %a.existingWikiWord{:href => "/nlab/show/sequence+space"} sequence spaces
            in the sense that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi l
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Inc
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi l
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} l^\infty(\mathrm{Inc}(A)) = l^\infty(A, \mathbb{C})
            for every set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
          .num_prop
            %h6 Proposition
            %p
              For each quantum set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/one-to-one+correspondence"} one-to-one correspondence
              between projection operators in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi l
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} l^\infty(X)
              and relations
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} 1 \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              corresponds to the relation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Supp
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Supp(p)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Supp
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo •
                        %mo ,
                        %mi α
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi r
                    %mo ∈
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo ,
                    %msub
                      %mi X
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %msub
                      %mi p
                      %mi α
                    %mi r
                    %mo =
                    %mi r
                    %mo{:stretchy => "false"} }
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Supp(p)_{\bullet, \alpha} \coloneqq \{r \in L(\mathbb{C}, X_\alpha) \mid p_\alpha r = r\}.
            %p
          %p
            In this context, a
            %a.existingWikiWord{:href => "/nlab/show/projector"} projection operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %msup
                    %mi l
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p \in l^\infty(X)
            is an element that satisfies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mn 2
                  %mo =
                  %mi p
                %annotation{:encoding => "application/x-tex"} p^2 = p
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo †
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p^\dagger = p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi a
                    %mo †
                %annotation{:encoding => "application/x-tex"} a^\dagger
            denotes the canonical
            %a.existingWikiWord{:href => "/nlab/show/star-algebra"} anti-involution
            of the von Neumann algebra. For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %msup
                      %mi l
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \in l^\infty(X)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi a
                      %mo †
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi α
                    %mo =
                    %msubsup
                      %mi a
                      %mi α
                      %mo †
                  %annotation{:encoding => "application/x-tex"} (a^\dagger)_\alpha = a_\alpha^\dagger
          %p
          .num_defn
            %h6 Definition
            %p
              We define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathrm{W}^\ast
              to be the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              of
              %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"} von Neumann algebras
              and unital ultraweakly continuous
              = succeed "-homomorphisms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo †
                    %annotation{:encoding => "application/x-tex"} \dagger
          %p
          .num_theorem
            %h6 Theorem
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful"} full and faithful
              %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} strong monoidal
              %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi l
                      %mn ∞
                    %mo{:lspace => "verythinmathspace"} :
                    %mi qSet
                    %mo →
                    %msup
                      %mi{:mathvariant => "normal"} W
                      %mo *
                    %mo :
                  %annotation{:encoding => "application/x-tex"} l^\infty \colon qSet \to \mathrm{W}^\ast :
            %ul
              %li
                %p
                  For each quantum set
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi l
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} l^\infty(X)
                  as in Def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#l-infinity"}
              %li
                %p
                  For each morphism
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:lspace => "verythinmathspace"} :
                          %mi X
                          %mo →
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} f\colon X \to Y
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi l
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi l
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msup
                          %mi l
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} l^\infty(f)\colon l^\infty(Y) \to l^\infty(X)
                  by
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Supp
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi l
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msup
                            %mi f
                            %mo †
                          %mo ∘
                          %mi Supp
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Supp(l^\infty(f)(p)) = f^\dagger \circ Supp(p)
            %p
          (Any ultraweakly continuous
          = succeed "-homomorphism" do
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo †
                %annotation{:encoding => "application/x-tex"} \dagger
          %p
            This functor also maps coproducts in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qSet
                %annotation{:encoding => "application/x-tex"} qSet
            to products in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathrm{W}^*
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi l
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo +
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi l
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊕
                  %msup
                    %mi l
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "2em"}
                  %mspace{:width => "2em"}
                  %msup
                    %mi l
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi l
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi l
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  l^\infty(X + Y) \cong l^\infty(X) \oplus l^\infty(Y), \qquad \qquad l^\infty(X \times Y) \cong l^\infty(X) \otimes l^\infty(Y).
          %p
            We also have a one-to-one correspondence between maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi{:mathvariant => "normal"} Inc
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \to \mathrm{Inc}(\mathbb{R})
            and
            %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operator"} self-adjoint operators
            %a.existingWikiWord{:href => "/nlab/show/affiliated+operator"} affiliated
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi l
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} l^\infty(X)
          %p
          .num_theorem
            %h6 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                    %mo ⊆
                    %mi ℬ
                    %mo{:stretchy => "false"} (
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{M} \subseteq \mathcal{B}(\mathcal{H})
              be a von Neumann algebra. The following are equivalent:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℳ
                      %annotation{:encoding => "application/x-tex"} \mathcal{M}
                  is in the
                  %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
                  of the contravariant functor
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi l
                            %mn ∞
                          %mo{:lspace => "verythinmathspace"} :
                          %mi qSet
                          %mo →
                          %msup
                            %mi{:mathvariant => "normal"} W
                            %mo *
                        %annotation{:encoding => "application/x-tex"} l^\infty\colon qSet \to \mathrm{W}^*
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℳ
                        %mo ≅
                        %msubsup
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                          %mrow
                            %msup
                              %mi l
                              %mn ∞
                        %msub
                          %mi M
                          %mrow
                            %msub
                              %mi n
                              %mi i
                        %mo{:stretchy => "false"} (
                        %mi ℂ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{M} \cong \bigoplus^{l^\infty}_{i \in I} M_{n_i}(\mathbb{C})
                  for some
                  %a.existingWikiWord{:href => "/nlab/show/indexed+family"} indexed family
                  of positive integers
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi n
                            %mi i
                          %msub
                            %mo{:stretchy => "false"} }
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                        %annotation{:encoding => "application/x-tex"} \{n_i\}_{i \in I}
              %li
                %p
                  every von Neumann subalgebra of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℳ
                      %annotation{:encoding => "application/x-tex"} \mathcal{M}
                  is atomic,
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operator"} self-adjoint operator
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℳ
                      %annotation{:encoding => "application/x-tex"} \mathcal{M}
                  has an
                  %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} orthonormal basis
                  of
                  %a.existingWikiWord{:href => "/nlab/show/eigenvector"} eigenvectors
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℋ
                        %annotation{:encoding => "application/x-tex"} \mathcal{H}
              %li
                %p
                  the group of
                  %a.existingWikiWord{:href => "/nlab/show/unitary+operator"} unitaries
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℳ
                      %annotation{:encoding => "application/x-tex"} \mathcal{M}
                  is compact in the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"} ultraweak topology
            %p
          %p Von Neumann algebras of this kind are sometimes called hereditarily atomic, referring to condition 3.
          %p
            Overall, we have an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
            of
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal categories
            between the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi qSet
                    %mi op
                %annotation{:encoding => "application/x-tex"} qSet^{op}
            and the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of hereditarily atomic von Neumann algebras. In effect, this generalizes the familiar equivalence between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mi op
                %annotation{:encoding => "application/x-tex"} Set^{op}
            and the category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complete+Boolean+algebra"} complete atomic Boolean algebras
            %a.existingWikiWord{:href => "/nlab/show/complete+lattice"} complete
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orthomodular+lattice"} orthomodular lattice
          %p
            The material in this section is mostly from
            %a{:href => "#Kornell20"} Kornell 2020
            and
            = succeed "." do
              %a{:href => "#Chirvasitu25"} Chirvasitu 2025
          %h2#quantum_sets_as_bundles Quantum sets as bundles
          %p
            In mild paraphrase (following the discussion at
            %em
              %a.existingWikiWord{:href => "/nlab/show/dependent+linear+type"} dependent linear type
            and
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+circuits+via+dependent+linear+types"} quantum circuits via dependent linear types
          %ul
            %li
              %p
                %strong quantum sets
                are
                %a.existingWikiWord{:href => "/nlab/show/indexed+sets"} indexed sets
                of
                %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+Hilbert+spaces"} finite-dimensional Hilbert spaces
                — hence finite-
                %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Hilbert+bundle"} Hilbert
                %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
                over
                %a.existingWikiWord{:href => "/nlab/show/discrete+topological+spaces"} discrete topological spaces
                regarded as a
                %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                — and regarded as equipped with the
                %a.existingWikiWord{:href => "/nlab/show/external+tensor+product"} external tensor product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊠
                    %annotation{:encoding => "application/x-tex"} \boxtimes
                = succeed ";" do
                  %a{:href => "VectBund#TensorMonoidalStructure"} of vector bundles
            %li
              %p
                a
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/quantum+relation"} quantum relation
                between quantum sets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msub
                        %mi.mathscript ℋ
                        %mi x
                    %annotation{:encoding => "application/x-tex"} (x \colon X) \times \mathscr{H}_x
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ′
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi.mathscript ℋ
                      %msub
                        %mo ′
                        %mi x
                    %annotation{:encoding => "application/x-tex"} (x' \colon X') \times \mathscr{H}'_x
                is a
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                from a quantum set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ×
                      %mi X
                      %mo ′
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo ×
                      %msub
                        %mi.mathscript ℛ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi x
                          %mo ′
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \big((x,x') \colon X \times X'\big) \times \mathscr{R}_{(x,x')}
                to
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi.mathscript ℋ
                          %mo •
                          %mo *
                        %mo ⊠
                        %mi.mathscript ℋ
                        %msub
                          %mo ′
                          %mo •
                      %annotation{:encoding => "application/x-tex"} \mathscr{H}^\ast_\bullet \boxtimes \mathscr{H}'_\bullet
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ×
                      %mi X
                      %mo ′
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊢
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi.mathscript ℛ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                      %mo ↪
                      %msubsup
                        %mi.mathscript ℋ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                        %mo *
                      %mo ⊗
                      %msubsup
                        %mi.mathscript ℋ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                        %mo ′
                    %annotation{:encoding => "application/x-tex"}
                      (x,x') \colon X \times X'
                      \\;\;\;
                      \\vdash
                      \\;\;\;
                      \\mathscr{R}_{(x,y)}
                      \\hookrightarrow
                      \\mathscr{H}^\ast_{(x,y)}
                      \\otimes
                      \\mathscr{H}^'_{(x,y)}
          %p
            With
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            the evident
            %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
            (
            %a{:href => "#Kornell20"}> Kornell 2020 (5)
            ), quantum relations between quantum sets form a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qRel
                  %annotation{:encoding => "application/x-tex"} qRel
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dagger-compact+category"} dagger-compact category
          %p
            As such, this serves as
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            for
            %a.existingWikiWord{:href => "/nlab/show/quantum+programming+languages"} quantum programming languages
            like
            %a.existingWikiWord{:href => "/nlab/show/Quipper"} Quipper
            equipped with term recursion, via
            %a.existingWikiWord{:href => "/nlab/show/quantum+CPOs"} quantum CPOs
            (
            %a{:href => "#KornellLindenhoviusMislove21"}> Kornell, Lindenhovius &amp; Mislove 2021
            ).
          %h2#related_concepts Related concepts
