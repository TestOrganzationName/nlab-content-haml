                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\circ_{a,b,c} \;\colon\; \mathcal{C}(a,b)\times \mathcal{C}(b,c) \longrightarrow \mathcal{C}(a,c)
                %p
                  out of the cartesian product, called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  operation
              %li
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a \in Obj(\mathcal{C})
                  a point
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi id
                            %mi a
                          %mo ∈
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi a
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} id_a\in \mathcal{C}(a,a)
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/identity"} identity
                  morphism on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
            %p
              such that the composition is
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
          #UnderlyingCategoryOfTopEnrichedCategory.num_remark
            %h6#remark Remark
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#TopEnrichedCategory"}
              %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
              (along the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi Top
                        %mi k
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} U \colon Top_k \to Set
              %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small category
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(a,b) = U(\mathcal{C}(a,b))
                    \\,.
            %p
              It is in this sense that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a category with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/extra+structure"} extra structure
              = succeed "\u201D." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
          %p The archetypical example is the following:
          #TopkAsATopologicallyEnrichedCategory.num_example
            %h6#example Example
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"} Top_{cg}
              from def.
              %a.maruku-ref{:href => "#kTop"}
              itself, being a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
              = succeed "," do
                %a.maruku-ref{:href => "#TopEnrichedCategory"}
              %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
              given by compactly generated
              %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi Y
                      %mi X
                  %annotation{:encoding => "application/x-tex"}
                    Top_{cg}(X,Y)
                    \\coloneqq
                    Y^X
            %p
              and with
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi X
                    %mo ×
                    %msup
                      %mi Z
                      %mi Y
                    %mo ⟶
                    %msup
                      %mi Z
                      %mi X
                  %annotation{:encoding => "application/x-tex"}
                    Y^X \times Z^Y
                    \\longrightarrow
                    Z^X
            %p
              given by the (product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊣
                  %annotation{:encoding => "application/x-tex"} \dashv
              mapping-space)-
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of the
              %a.existingWikiWord{:href => "/nlab/show/evaluation+morphism"} evaluation morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %msup
                      %mi Y
                      %mi X
                    %mo ×
                    %msup
                      %mi Z
                      %mi Y
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi ev
                        %mo ,
                        %mi id
                        %mo{:stretchy => "false"} )
                    %mi Y
                    %mo ×
                    %msup
                      %mi Z
                      %mi Y
                    %mover
                      %mo ⟶
                      %mi ev
                    %mi Z
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \times Y^X \times Z^Y
                    \\overset{(ev, id)}{\longrightarrow}
                    Y \times Z^Y
                    \\overset{ev}{\longrightarrow}
                    Z
                    \\,.
          #TopologicallyEnrichedFunctor.num_defn
            %h6#definition_4 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functor"} topologically enriched functor
              between two
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+categories"} topologically enriched categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    F \;\colon\;  \mathcal{C}  \longrightarrow \mathcal{D}
            %p
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 0
                        %mo{:lspace => "verythinmathspace"} :
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒟
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        F_0 \colon Obj(\mathcal{C}) \longrightarrow Obj(\mathcal{D})
                %p
                  of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %li
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a,b \in Obj(\mathcal{C})
                  a
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi a
                            %mo ,
                            %mi b
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi 𝒟
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi F
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        F_{a,b} \;\colon\; \mathcal{C}(a,b) \longrightarrow \mathcal{D}(F_0(a), F_0(b))
                %p
                  of
                  %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
            %p
              such that this preserves
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              and
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              morphisms in the evident sense.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of topologically enriched functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo ⇒
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; F \Rightarrow G
            %p
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/enriched+natural+transformation"} enriched natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \in Obj(\mathcal{C})
              a choice of morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi c
                    %mo ∈
                    %mi 𝒟
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_c \in \mathcal{D}(F(c),G(c))
              such that for each pair of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ,
                    %mi d
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c,d \in \mathcal{C}
              the two continuous functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mo ∘
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi 𝒟
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d \circ F(-) \;\colon\; \mathcal{C}(c,d) \longrightarrow \mathcal{D}(F(c), G(d))
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi η
                      %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi 𝒟
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G(-) \circ \eta_c \;\colon\; \mathcal{C}(c,d) \longrightarrow \mathcal{D}(F(c), G(d))
            %p agree.
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}, \mathcal{D}]
              for the resulting category of topologically enriched functors. This itself naturally obtains the structure of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
          %h2#topologically_enriched_presheaves Topologically enriched presheaves
          #TopologicallyEnrichedFunctorsToTopk.num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              any topologically enriched category, def.
              %a.maruku-ref{:href => "#TopEnrichedCategory"}
              then a topologically enriched functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ⟶
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"}
                    F \;\colon\; \mathcal{C} \longrightarrow Top_{cg}
            %p
              to the archetypical topologically enriched category from example
              %a.maruku-ref{:href => "#TopkAsATopologicallyEnrichedCategory"}
              may be thought of as a topologically
              %a.existingWikiWord{:href => "/nlab/show/enriched+presheaf"} enriched
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/copresheaf"} copresheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              (in that its
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of objects is a proper
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/set"} set
            %p Hence the category of topologically enriched functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}, Top_{cg}]
            %p
              according to def.
              %a.maruku-ref{:href => "#TopologicallyEnrichedFunctor"}
              may be thought of as the (
              %a.existingWikiWord{:href => "/nlab/show/copresheaf"}> co-
              )
              %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              in the realm of topologically enriched categories.
            %p
              A functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F \in [\mathcal{C}, Top_{cg}]
              is equivalently
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+space"} compactly generated topological space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mi a
                        %mo ∈
                        %msub
                          %mi Top
                          %mi cg
                      %annotation{:encoding => "application/x-tex"} F_a\in Top_{cg}
                  for each object
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo ∈
                          %mi Obj
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} a \in Obj(\mathcal{C})
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mi a
                        %mo ×
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi F
                          %mi b
                      %annotation{:encoding => "application/x-tex"}
                        F_a \times \mathcal{C}(a,b) \longrightarrow F_b
                %p
                  for all pairs of objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a,b \in Obj(\mathcal{C})
            %p such that composition is respected, in the evident sense.
            %p
              For every object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y(c)
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(c,-)
              which sends objects to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"}
                    y(c)(d) = \mathcal{C}(c,d) \in Top_{cg}
            %p
              and whose action on morphisms is, under the above identification, just the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              operation in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            There is a full blown
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"} Top_{cg}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+Yoneda+lemma"} enriched Yoneda lemma
          #TopologicallyEnrichedYonedaLemma.num_prop
            %h6#proposition Proposition
            %p
              %strong (topologically enriched Yoneda-lemma)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
              = succeed "," do
                %a.maruku-ref{:href => "#TopEnrichedCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top_{cg}]
              for its category of topologically enriched (co-)presheaves, and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c\in Obj(\mathcal{C})
              write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi Top
                      %mi k
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} y(c) = \mathcal{C}(c,-) \in [\mathcal{C}, Top_k]
              for the topologically enriched functor that it represents, all according to example
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicallyEnrichedFunctorsToTopk"}
              = succeed "-tensored" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⋅
                    %mi X
                  %annotation{:encoding => "application/x-tex"} F \cdot X
              from that example.
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c\in Obj(\mathcal{C})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"} X \in Top_{cg}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi Top
                        %mi cg
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} F \in [\mathcal{C}, Top_{cg}]
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              between
            %ol
              %li
                %p
                  morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi X
                        %mo ⟶
                        %mi F
                      %annotation{:encoding => "application/x-tex"} y(c) \cdot X \longrightarrow F
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi 𝒞
                          %mo ,
                          %msub
                            %mi Top
                            %mi cg
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top_{cg}]
              %li
                %p
                  morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ⟶
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \longrightarrow F(c)
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Top
                            %mi cg
                        %annotation{:encoding => "application/x-tex"} Top_{cg}
          .proof
            %h6#proof Proof
            %p
              Given a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi X
                    %mo ⟶
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \eta \colon y(c) \cdot X \longrightarrow F
              consider its component
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi X
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_c \;\colon\; \mathcal{C}(c,c)\times X \longrightarrow F(c)
            %p
              and restrict that to the identity morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi c
                    %mo ∈
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} id_c \in \mathcal{C}(c,c)
              in the first argument
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_c(id_c,-) \;\colon\; X \longrightarrow F(c)
                    \\,.
            %p
              We claim that just this
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_c(id_c,-)
              already uniquely determines all components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi X
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d \;\colon\; \mathcal{C}(c,d)\times X \longrightarrow F(d)
            %p
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d \in Obj(\mathcal{C})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TopologicallyEnrichedFunctor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi η
                      %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    F(-) \circ \eta_c
                    \\;\colon\;
                    \\mathcal{C}(c,d)
                    \\longrightarrow
                    F(d)^{\mathcal{C}(c,c) \times X}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mo ∘
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d  \circ \mathcal{C}(c,-) \times X
                    \\;\colon\;
                    \\mathcal{C}(c,d)
                    \\longrightarrow
                    F(d)^{\mathcal{C}(c,c) \times X}
            %p
              agree. This means that they may be thought of jointly as a function with values in commuting squares in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              of this form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi c
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi c
                                  %mo ,
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi d
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\;\;\;
                    \\mapsto
                    \\;\;\;\;
                    \\array{
                    \\mathcal{C}(c,c) \times X &amp;\overset{\eta_c}{\longrightarrow}&amp; F(c)
                    \\\
                    {}^{\mathllap{\mathcal{C}(c,f)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{F(f)}}
                    \\\
                    \\mathcal{C}(c,d) \times X &amp;\underset{\eta_d}{\longrightarrow}&amp; F(d)
                    }
            %p
              For any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in \mathcal{C}(c,d)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mo ∘
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d \circ \mathcal{C}(c,f) \in F(d)^{\mathcal{C}(c,c) \times X}
            %p
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi id
                        %mi c
                      %mo ∈
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} id_c \in \mathcal{C}(c,c)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi id
                              %mi c
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi c
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi c
                                  %mo ,
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %mpadded{:width => "0"}
                                  %mi F
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mi f
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi d
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\;\;\;
                    \\mapsto
                    \\;\;\;\;
                    \\array{
                    \\{id_c\} \times X &amp;\overset{\eta_c}{\longrightarrow}&amp; F(c)
                    \\\
                    {}^{\mathllap{\mathcal{C}(c,f)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{F}(f)}
                    \\\
                    \\{f\} \times X &amp;\underset{\eta_d}{\longrightarrow}&amp; F(d)
                    }
            %p
              This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \eta_d
              is fixed to be the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi η
                      %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi c
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d(f,x) = F(f)\circ \eta_c(id_c,x)
            %p and this is a continuous function since all the operations it is built from are continuous.
            %p
              Conversely, given a continuous function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha \colon X \longrightarrow F(c)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi α
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d \colon (f,x) \mapsto F(f) \circ \alpha
                    \\,.
            %p
              Running the above analysis backwards shows that this determines a transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mi y
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi X
                      %mo →
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \eta \colon y(c)\times X \to F
          .num_remark
            %h6#remark_2 Remark
            %p
              With
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"} Top_{cg}
              equipped with the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} presentation
              for the archetypical
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C},Top_{cg}]
            %p
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicallyEnrichedFunctor"}
              = succeed ")" do
                %a.maruku-ref{:href => "#TopkAsATopologicallyEnrichedCategory"}
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mi op
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+enriched+functors"} model structure on enriched functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi Top
                        %mi Quillen
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C},Top_{Quillen}]_{proj}
              %em
                %a{:href => "classical+model+structure+on+topological+spaces#ModelStructureOnTopEnrichedFunctors"} classical model structure on topological spaces – Model structure on functors
              for details.
