            etc. for what often is referred to as “
            %a.existingWikiWord{:href => "/nlab/show/topological+category"}> topological category
            ” and “
            %a.existingWikiWord{:href => "/nlab/show/topological+functor"}> topological functor
            ” etc. As discussed there, these latter terms are ambiguous.
          #kTop.num_defn
            %h6#definition_2 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                    %mo ↪
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    Top_{cg} \hookrightarrow Top
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Top
                      %mi cg
                    %mo ×
                    %msub
                      %mi Top
                      %mi cg
                    %mo ⟶
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"}
                    (-)\times (-)
                    \\;\colon\;
                    Top_{cg} \times Top_{cg} \longrightarrow Top_{cg}
            %p
              and compactly generated
              %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Top
                      %mi cg
                      %mi op
                    %mo ×
                    %msub
                      %mi Top
                      %mi cg
                    %mo ⟶
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"}
                    (-)^{(-)}
                    \\;\colon\;
                    Top_{cg}^{op}\times Top_{cg}
                    \\longrightarrow
                    Top_{cg}
            %p
              this is a
