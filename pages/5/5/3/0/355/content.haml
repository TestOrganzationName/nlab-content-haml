                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-
                %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
                (a
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} homotopy n-type
          %h2#definitions Definitions
          %p
            In terms of a known notion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-category"} (n,r)-category
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-groupoid
            explicitly as an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              every
              = succeed "-morphism" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            %li
              every parallel pair of
              = succeed "-morphisms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo &gt;
                      %mi n
                    %annotation{:encoding => "application/x-tex"} j\gt n
          %p
            Or we define an
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-groupoid
            abstractly as an
            %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+of+an+%28infinity%2C1%29-category"} n-truncated object in
            the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          %p
            The
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28n%2C1%29-category"} (n+1,1)-category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nGrpd"} nGrpd
          %h2#models Models
          %h3#AsKanComplexes As Kan complexes
          %p
            A general model for
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            is provided by
            %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
            (the
            %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
            in the
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
            which
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presents
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          %p
            In this context an
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            vanish in degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &gt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \gt n
            %em
              %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"}
                homotopy
                = succeed "-type" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            or an
            %em
              %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+of+an+%28infinity%2C1%29-category"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-truncated object
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          %p
            Every such
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalent
            to a “small” model, an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            %a.existingWikiWord{:href => "/nlab/show/coskeletal"} coskeletal
            Kan complex (see
            = succeed "):" do
              %a{:href => "simplicial+skeleton#Truncation"} there
            = succeed "-sphere" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %msup
                    %mi Δ
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \partial \Delta^{k+1}
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ≥
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k \geq n+1
            has a
            %em unique
            filler.
          %p
            Yet a bit smaller than this are Kan complexes that is an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/hypergroupoid"} hypergroupoid
            %a.existingWikiWord{:href => "/nlab/show/horn"} horn
            fillers in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n+1
            are unique.
          %p
            (For
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/1-groupoids"} 1-groupoids
            %a{:href => "hypergroupoid#OneHypergroupoids"} 1-hypergroupoids
            this situation is further spelled out
