                    %mi X
                    %mo{:stretchy => "false"} ↓
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X \downarrow G)
              has an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/initial+object+in+an+%28infinity%2C1%29-category"} initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X\in C
              admits a
              %a.existingWikiWord{:href => "/nlab/show/universal+arrow"} universal arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi G
                    %mi F
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X\to G F X
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
            This is stated explicitly as
            = succeed "," do
              %a{:href => "#RVElements"} Riehl-Verity, Corollary 16.2.7
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, Proposition 5.2.4.2
          %h3#preservation_by_exponentiation Preservation by exponentiation
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f : C \to D
              be left adjoint to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi D
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} g : D \to C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mi A
                  %annotation{:encoding => "application/x-tex"} f^A
              is left adjoint to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mi A
                  %annotation{:encoding => "application/x-tex"} g^A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi g
                  %annotation{:encoding => "application/x-tex"} A^g
              is left adjoint to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mi f
                    %annotation{:encoding => "application/x-tex"} A^f
          .proof
            %h6#proof_4 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %msub
                      %mi id
                      %mi C
                    %mo ⇒
                    %mi gf
                  %annotation{:encoding => "application/x-tex"} \eta : id_C \Rightarrow gf
              be a unit transformation. The property of being a unit transformation can be detected at the level of enriched homotopy categories, so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi η
                    %mo :
                    %msub
                      %mi id
                      %mrow
                        %msup
                          %mi A
                          %mi C
                    %mo ⇒
                    %msup
                      %mi A
                      %mi f
                    %msup
                      %mi A
                      %mi g
                  %annotation{:encoding => "application/x-tex"} A^\eta: id_{A^C} \Rightarrow A^f A^g
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mi A
                    %mo :
                    %msub
                      %mi id
                      %mrow
                        %msup
                          %mi C
                          %mi A
                    %mo ⇒
                    %msup
                      %mi g
                      %mi A
                    %msup
                      %mi f
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \eta^A : id_{C^A} \Rightarrow g^A f^A
              are also unit transformations.
          %h2#category_of_adjunctions Category of adjunctions
          %p
            The functorality of adjunctions can be organized into the existence of two wide subcategories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LAdj
                  %mo ⊆
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} LAdj \subseteq (\infty,1)Cat
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi RAdj
                  %mo ⊆
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} RAdj \subseteq (\infty,1)Cat
            whose functors are the left adjoints and the right adjoints respectively.
          %p We can then define the functor categories
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Func
                        %mi L
                      %mo :
                      %msup
                        %mi LAdj
                        %mi op
                      %mo ×
                      %mi LAdj
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Func^L : LAdj^{op} \times LAdj \to (\infty,1)Cat
                is defined by taking
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Func
                        %mi L
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mi D
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %mi Func
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Func^L(C,D) \subseteq Func(C, D)
                to be the full subcategory spanned by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi LAdj
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} LAdj(C, D)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Func
                        %mi R
                      %mo :
                      %msup
                        %mi RAdj
                        %mi op
                      %mo ×
                      %mi RAdj
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Func^R : RAdj^{op} \times RAdj \to (\infty,1)Cat
                is defined by taking
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Func
                        %mi R
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mi D
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %mi Func
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Func^R(C,D) \subseteq Func(C, D)
                to be the full subcategory spanned by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi RAdj
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} RAdj(C, D)
          %p
            Lurie defines an adjunction to be a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} X \to [1]
            that is both a cartesian and a cocartesian fibration. We can generalize this to
          #AdjunctFibration.num_defn
            %h6#definition_5 Definition
            %p
              A functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p : X \to S
              is an
              %em adjunct fibration
              iff it is both a cartesian fibration and a cocartesian fibration
          %p
            By the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
            construction, adjunct fibrations over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            correspond to category-valued functors on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            that send arrows of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to adjoint pairs of categories.
          .num_lemma
            %h6#lemma Lemma
            %p
              For a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p : X \to S
              of (∞,1)-categories with small fibers.
            %ul
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is a cartesian fibration classified by
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi χ
                          %mo :
                          %msup
                            %mi S
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                          %mo →
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mi Cat
                        %annotation{:encoding => "application/x-tex"} \chi : S^\op \to (\infty,1)Cat
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                      %annotation{:encoding => "application/x-tex"} \chi
                  factors through
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi RAdj
                      %annotation{:encoding => "application/x-tex"} RAdj
                  iff
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is an adjunct fibration
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is a cocartesian fibration classified by
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi χ
                          %mo :
                          %mi S
                          %mo →
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mi Cat
                        %annotation{:encoding => "application/x-tex"} \chi : S \to (\infty,1)Cat
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                      %annotation{:encoding => "application/x-tex"} \chi
                  factors through
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi LAdj
                      %annotation{:encoding => "application/x-tex"} LAdj
                  iff
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is an adjunct fibration
          .proof
            %h6#proof_5 Proof
            %p
              This is a restatement of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, corr. 5.2.2.5
          %p
          #LadjAndRadj.num_lemma
            %h6 Lemma
            %p
              There are anti-equivalences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ladj
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi RAdj
                      %mi op
                    %mo →
                    %mi LAdj
                  %annotation{:encoding => "application/x-tex"} ladj \,\colon\, RAdj^{op} \to LAdj
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi radj
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi LAdj
                      %mi op
                    %mo →
                    %mi RAdj
                  %annotation{:encoding => "application/x-tex"} radj \,\colon\, LAdj^{op} \to RAdj
              that are the identity on objects and the action on homspaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LAdj
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi RAdj
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} LAdj(C, D) \simeq RAdj(D,C)
              is the equivalence sending a functor to its adjoint.
          .proof
            %h6#proof_6 Proof
            %p
              By the covariant Grothendieck construction, for any (∞,1)-category C,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi LAdj
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Map(C, LAdj)
              can be identified with the ∞-groupoid of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mover
                        %mi Cat
                        %mo ^
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi C
                  %annotation{:encoding => "application/x-tex"} (\infty,1)\widehat{Cat}_{/C}
              spanned by adjunct fibrations over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with small fibers and all equivalences between them. The same is true of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Map
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                      %mo ,
                      %mi RAdj
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Map(C^{\op}, RAdj)
            %p
              Since the Grothendieck construction is natural in the base category, we obtain the asserted equivalence between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LAdj
                  %annotation{:encoding => "application/x-tex"} LAdj
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi RAdj
                        %mi op
                    %annotation{:encoding => "application/x-tex"} RAdj^{op}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} C = [1]
          %p
            As discussed at
            = succeed "," do
              %a{:href => "#UniquenessOfAdjoints"} Uniqueness of Adjoints
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi radj
                  %mo :
                  %msup
                    %mi Func
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi D
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %msup
                    %mi Func
                    %mi R
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} radj : Func^L(C, D)^{op} \to Func^R(D, C)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ladj
                    %mo :
                    %msup
                      %mi Func
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %msup
                      %mi Func
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ladj : Func^R(C, D)^{op} \to Func^L(D, C)
          %p The preservation of adjunctions by products and exponentials implies
          .num_lemma
            %h6#lemma_2 Lemma
            %p
              The product and exponential on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} (\infty,1)Cat
              restrict to functors
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ×
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo :
                      %mi LAdj
                      %mo ×
                      %mi LAdj
                      %mo →
                      %mi LAdj
                    %annotation{:encoding => "application/x-tex"} - \times - : LAdj \times LAdj \to LAdj
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ×
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo :
                      %mi RAdj
                      %mo ×
                      %mi RAdj
                      %mo →
                      %mi RAdj
                    %annotation{:encoding => "application/x-tex"} - \times - : RAdj \times RAdj \to RAdj
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Func
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msup
                        %mi RAdj
                        %mi op
                      %mo ×
                      %mi LAdj
                      %mo →
                      %mi LAdj
                    %annotation{:encoding => "application/x-tex"} Func(-,-) : RAdj^{op} \times LAdj \to LAdj
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Func
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msup
                        %mi LAdj
                        %mi op
                      %mo ×
                      %mi RAdj
                      %mo →
                      %mi RAdj
                    %annotation{:encoding => "application/x-tex"} Func(-,-) : LAdj^{op} \times RAdj \to RAdj
          %h2#examples Examples
          %p
            A large class of examples of
            = succeed "-adjunctions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunctions"} Quillen adjunctions
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
          %h3#quillen_adjunctions Quillen adjunctions
          %p
            Any
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            induces an adjunction of
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-categories"} (infinity,1)-categories
            on the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localizations"} simplicial localizations
            %a{:href => "#Hinich14"} Hinich 14
            or
            = succeed "." do
              %a{:href => "#MazelGee15"} Mazel-Gee 15
          %h3#SimplicialAndDerived Simplicial and derived adjunctions
          %p
            We want to produce Cartesian/coCartesian fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo →
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} K \to \Delta[1]
            from a given
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched
            adjunction. For that first consider the following characterization
          .num_lemma
            %h6#lemma_3 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              be a
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicially enriched category
              whose
              %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
              are all
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \Delta[1] := \{0 \to 1\}
              as an
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi const
                    %mo :
                    %mi Set
                    %mo ↪
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} const : Set \hookrightarrow sSet
              and consider an
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo →
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} K \to \Delta[1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo :
                    %mo =
                    %msub
                      %mi K
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C := K_0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo :
                    %mo =
                    %msub
                      %mi K
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} D := K_1
              be the
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo :
                    %mi sSet
                    %mi Cat
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} N : sSet Cat \to sSet
              the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    N(p) : N(K) \to \Delta[1]
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              precisely if for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} d \in D
              there exists a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} f : c \to d
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              such that postcomposition with this morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C(c',f ) :  C(c',c) = K(c',c) \to K(c',d)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              of
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ′
                      %mo ∈
                      %mi C
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} c' \in C'
          %p
            This appears as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 5.2.2.4
          .proof
            %h6#proof_7 Proof
            %p
              The statement follows from the characterization of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 2.4.1.10
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} p : C \to D
              between Kan-complex enriched categories that is
              = succeed "-wise" do
                %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi c
                    %mo ′
                    %mo →
                    %mi c
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} f : c' \to c''
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(p)
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
              if for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi c
                            %mo ′
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi c
                                %mo ,
                                %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi c
                            %mo ″
