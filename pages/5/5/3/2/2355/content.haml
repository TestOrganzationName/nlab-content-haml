                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
