                    %annotation{:encoding => "application/x-tex"} \leftrightarrow
                (2) consitute a
                %a{:href => "adjoint+functor#InTermsOfHomIsomorphism"} hom-isomorphism
                that witnesses an adjunction of the second claimed form
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:SlicedAdjointFunctorsOverRb"} (2)
            %p
            #LeftAdjointOfSlicedAdjunctionFormsAdjuncts.num_remark
              %h6 Remark
              %p
                %strong (left adjoint of sliced adjunction forms adjuncts)
                %br/
                The sliced adjunction (Prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SliceAdjoints"}
                %a.maruku-eqref{:href => "#eq:SlicedAdjointFunctorsOverRb"} (2)
                is such that the sliced
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                sends slicing morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
                to their
                %a.existingWikiWord{:href => "/nlab/show/adjuncts"} adjuncts
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi τ
                          %mo ˜
                      %annotation{:encoding => "application/x-tex"} \widetilde{\tau}
                = succeed "):" do
                  %a{:href => "adjoint+functor#GeneralAdjunctsInTermsOfAdjunctionUnitCounit"} this Prop.
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
