                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q(R(d))
              is cofibrant and there is an acyclic fibration
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
