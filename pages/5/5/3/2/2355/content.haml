              whose components may be regarded as forming a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
