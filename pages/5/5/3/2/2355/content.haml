                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi D
                    %annotation{:encoding => "application/x-tex"} d \in D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Id
