                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C(c', Q(R(d))) \to C(c',R(d)) = K(c',d)
            %p
              because in an
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              the enriched hom out of a cofibrant object preserves weak equivalences between fibrant objects.
          %h3#localizations Localizations
          %p
            A pair of adjoint
            = succeed "-functors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊣
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi C
                  %mover
                    %mo ↪
                    %mo ←
                  %mi D
                %annotation{:encoding => "application/x-tex"} (L \dashv R) : C \stackrel{\leftarrow}{\hookrightarrow} D
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
            exhibits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as a
            %a.existingWikiWord{:href => "/nlab/show/reflective+%28%E2%88%9E%2C1%29-subcategory"} reflective (∞,1)-subcategory
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ∘
                  %mi L
                  %mo :
                  %mi D
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} R \circ L : D \to D
            are a
            %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"}> adjoint functor
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
                %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/proadjoint"}> proadjoint
                ,
                %a.existingWikiWord{:href => "/nlab/show/Hopf+adjunction"} Hopf adjunction
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-adjunction"} 2-adjunction
              %p
                %a.existingWikiWord{:href => "/nlab/show/biadjunction"}> biadjunction
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/lax+2-adjunction"} lax 2-adjunction
                %a.existingWikiWord{:href => "/nlab/show/pseudoadjunction"} pseudoadjunction
            %li
              %p
                %strong
                  adjoint
                  = succeed "-functor" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h2#references References
          %p
            The suggestion that a pair of adjoint
            = succeed "-functors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            in the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+2-category+of+%28infinity%2C1%29-categories"}
              homotopy 2-category of
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            was originally stated, briefly, in:
          %ul
            %li#Joyal08
              %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
              , p. 159 (11 of 348) in:
              = succeed "," do
                %em The theory of quasicategories and its applications
              = succeed "," do
                %em
                  %a{:href => "https://lists.lehigh.edu/pipermail/algtop-l/2007q4/000017.html"} Advanced Course on Simplicial Methods in Higher Categories
              %strong 45
              2, Centre de Recerca Matemàtica, Barcelona 2008 (
              %a.existingWikiWord{:href => "/nlab/files/JoyalTheoryOfQuasiCategories.pdf", :title => "pdf"}> pdf
              )
          %p
            The definition as an isofibration of
            %a.existingWikiWord{:href => "/nlab/show/quasicategories"} quasicategories
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[1]
            is due to:
          %ul
            %li#Lurie
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              , Section 5.2 in:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
              = succeed "," do
                %a{:href => "https://press.princeton.edu/titles/8957.html"} pup:8957
              = succeed ")" do
                %a{:href => "https://www.math.ias.edu/~lurie/papers/HTT.pdf"} pdf
          %p
            The original suggestion of
            %a{:href => "#Joyal08"} Joyal 2008
            was then much expanded on (and generalized to
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cosmoi"} ∞-cosmoi
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/formal+%28infinity%2C1%29-category+theory"}
                formal
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
                , §18.6 in:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Categorical+Homotopy+Theory"} Categorical Homotopy Theory
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/CBO9781107261457"} doi:10.1017/CBO9781107261457
                = succeed "&rbrack;" do
                  %a{:href => "http://www.math.jhu.edu/~eriehl/cathtpy.pdf"} pdf
            %li#RiehlVerity15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dominic+Verity"} Dominic Verity
                = succeed "," do
                  %em The 2-category theory of quasi-categories
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/1306.5144"} arXiv:1306.5144
                = succeed ")," do
                  %a{:href => "https://doi.org/10.1016/j.aim.2015.04.021"} doi:10.1016/j.aim.2015.04.021
            %li#RiehlVerity16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dominic+Verity"} Dominic Verity
                = succeed "," do
                  %em Homotopy coherent adjunctions and the formal theory of monads
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/1310.8279"} arXiv:1310.8279
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/j.aim.2015.09.011"} doi:10.1016/j.aim.2015.09.011
            %li#RiehlVerity20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dominic+Verity"} Dominic Verity
                = succeed "," do
                  %em Infinity category theory from scratch
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1608.05314"} arXiv:1608.05314
                = succeed ")" do
                  %a{:href => "http://www.math.jhu.edu/~eriehl/scratch.pdf"} pdf
          %p
            That the two definitions (of
            %a{:href => "#Joyal08"} Joyal 2008
            and
            = succeed ")" do
              %a{:href => "#Lurie"} Lurie 2009
            %a{:href => "#RiehlVerity15"} Riehl-Verity 15, Rem. 4.4.5
            and then made fully explicit in:
          %ul
            %li#RVElements
              %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dominic+Verity"} Dominic Verity
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Elements+of+%E2%88%9E-Category+Theory"} Elements of ∞-Category Theory
              = succeed "," do
                %strong 194
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              = succeed "," do
                %a{:href => "https://doi.org/10.1017/9781108936880"} doi:10.1017/9781108936880
              %a{:href => "https://emilyriehl.github.io/files/elements.pdf"} pdf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p
            A proof that a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            of
            %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            induces an adjunction between
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
            (in the sense of
            = succeed ")" do
              %a{:href => "#Lurie"} Lurie 2009
          %ul
            %li#Hinich14
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Hinich"}> Vladimir Hinich
              ,
              = succeed "," do
                %em Dwyer-Kan Localization Revisited
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1311.4128"} arXiv:1311.4128
              = succeed ")" do
                %a{:href => "https://dx.doi.org/10.4310/HHA.2016.v18.n1.a3"} doi:10.4310/HHA.2016.v18.n1.a3
          %p and also in
          %ul
            %li#MazelGee15
              %a.existingWikiWord{:href => "/nlab/show/Aaron+Mazel-Gee"}> Aaron Mazel-Gee
              ,
              = succeed "," do
                %em Quillen adjunctions induce adjunctions of quasicategories
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1501.03146"} arXiv:1501.03146
              = succeed ")" do
                %a{:href => "http://nyjm.albany.edu/j/2016/22-4.html"} publisher
