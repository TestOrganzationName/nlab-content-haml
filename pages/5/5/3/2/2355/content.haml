            %p
            #SliceAdjointsGeneralized.num_prop
              %h6 Proposition
              %p
                %strong (sliced adjoints)
                %br/
                Let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
