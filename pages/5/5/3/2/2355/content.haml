              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              forms a
              %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Func
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi Func
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func^L(C,D), Func^R(C,D) \subset Func(C,D)
              be the full sub-quasi-categories on the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              on those functors that are left adjoint and those that are right adjoints, respectively. Then there is a canonical
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+quasi-categories"} equivalence of quasi-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Func
