                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi Hom
                            %mi C
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mo{:stretchy => "false"} (
                          %munder
                            %mi lim
                            %mo →
                          %msub
                            %mi d
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi c
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≃
                          %msub
                            %mi Hom
                            %mi D
                          %mo{:stretchy => "false"} (
                          %munder
                            %mi lim
                            %mo →
                          %msub
                            %mi d
                            %mi i
                          %mo ,
                          %mi R
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %munder
                            %mi lim
                            %mo ←
                          %msub
                            %mi Hom
                            %mi D
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi d
                            %mi i
                          %mo ,
                          %mi R
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %munder
                            %mi lim
                            %mo ←
                          %msub
                            %mi Hom
                            %mi C
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi d
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi c
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %msub
                            %mi Hom
                            %mi C
                          %mo{:stretchy => "false"} (
                          %munder
                            %mi lim
                            %mo →
                          %mi L
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi d
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi c
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  Hom_C(L(\lim_{\to} d_i), c) &amp; \simeq
                  Hom_D(\lim_\to d_i, R(c))
                  \\\
                  \&amp; \simeq
                  \\lim_{\leftarrow} Hom_D(d_i, R(c))
                  \\\
                  \&amp; \simeq \lim_{\leftarrow} Hom_C(L(d_i), c)
                  \\\
                  \&amp; \simeq Hom_C(\lim_{\to} L(d_i), c)
                  \\,,
                  \\end{aligned}
          %p
            which implies that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi lim
                      %mo →
                    %msub
                      %mi d
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi lim
                      %mo →
                    %mi L
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(\lim_\to d_i) \simeq \lim_\to L(d_i)
          %p
            Now to see this in
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h3#OnHomotopyCat Adjunctions on homotopy categories
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mover
                      %mo →
                      %mo ←
                    %mi D
                  %annotation{:encoding => "application/x-tex"} (L \dashv R) : C \stackrel{\leftarrow}{\to} D
              an
              = succeed "-adjunction," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28infinity%2C1%29-category"} homotopy categories
              is a pair of ordinary
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo ⊣
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ←
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Ho(L) \dashv Ho(R)) : Ho(C) \stackrel{\leftarrow}{\to} Ho(D)
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop 5.2.2.9
            %p
              This follows from that fact that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %msub
                      %mi Id
                      %mi C
                    %mo →
                    %mi R
                    %mo ∘
                    %mi L
                  %annotation{:encoding => "application/x-tex"} \epsilon : Id_C \to R \circ L
              a unit of the
              = succeed "-adjunction," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(\epsilon)
              is a unit for an ordinary adjunction.
          .num_remark
            %h6#remark Remark
            %p
              The converse statement is in general false. A near converse is given by
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop 5.2.2.12
              if one instead considers
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                    %annotation{:encoding => "application/x-tex"} Ho
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(L)
              has a right adjoint, then so does
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
            %p
              It is important to consider the
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                    %annotation{:encoding => "application/x-tex"} Ho
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                  %annotation{:encoding => "application/x-tex"} Ho
              is considered as an ordinary category,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo :
                    %mi Ho
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \pi_0 : Ho \to Set
              is both left and right adjoint to the inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mo ⊆
                      %mi Ho
                    %annotation{:encoding => "application/x-tex"} Set \subseteq Ho
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo :
                    %mn ∞
                    %mi Gpd
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \pi_0 : \infty Gpd \to Set
              does not have a left adjoint.
            %p
              One way to find that an ordinary adjunction of homotopy categories lifts to an
              = succeed "-adjunction" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              between
              = succeed "-structures." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              %a{:href => "#SimplicialAndDerived"} Simplicial and derived adjunction
              below.
          %h3#FullAndFaithfulAdjoints Full and faithful adjoints
          %p
            As for ordinary
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            we have the following relations between full and faithful adjoints and idempotent monads.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Given an
              = succeed "-adjunction" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} (L \dashv R) : C \to  D
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
                  precisely is the counit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mi R
                        %mover
                          %mo →
                          %mrow
                        %mi Id
                      %annotation{:encoding => "application/x-tex"} L R \stackrel{}{\to} Id
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+quasi-categories"} equivalence
                  of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functors"} (∞,1)-functors
                %p
                  In this case
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/reflective+%28%E2%88%9E%2C1%29-subcategory"} reflective (∞,1)-subcategory
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                        %annotation{:encoding => "application/x-tex"} D
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
                  precisely is the unit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Id
                        %mo →
                        %mi R
                        %mi L
                      %annotation{:encoding => "application/x-tex"} Id \to R L
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+quasi-categories"} equivalence
                  of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functors"} (∞,1)-functors
          %p
            %a{:href => "#Lurie"}> Lurie, prop. 5.2.7.4
            , See also top of p. 308.
          %div
            %h3#OnSlices Slicing of adjoint functors
            %p
            #SliceAdjoints.num_prop
              %h6 Proposition
              %p
                %strong (sliced adjoints)
                %br/
                Let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                      %munderover
                        %mo ⊥
                        %munder
                          %mo ⟶
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi R
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                        %mover
                          %mo ⟵
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi L
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{D}
                      \\underoverset
                      {\underset{\;\;\;\;R\;\;\;\;}{\longrightarrow}}
                      {\overset{\;\;\;\;L\;\;\;\;}{\longleftarrow}}
                      {\bot}
                      \\mathcal{C}
              %p
                be a pair of
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                (
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functors"}> adjoint ∞-functors
                ), where the
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                (
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"}> ∞-category
                )
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                has all
                %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
                (
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"}> homotopy pullbacks
                ).
              %p Then:
              %ol
                %li
                  %p
                    For every
                    %a.existingWikiWord{:href => "/nlab/show/object"} object
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi b
                          %mo ∈
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} b \in \mathcal{C}
                    there is induced a pair of
                    %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                    between the
                    %a.existingWikiWord{:href => "/nlab/show/slice+categories"} slice categories
                    (
                    %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-categories"}> slice ∞-categories
                    ) of the form
                  #eq:SlicedAdjointFunctorsOverLb.maruku-equation
                    %span.maruku-eq-number (1)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒟
                            %mrow
                              %mo{:stretchy => "false"} /
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi b
                              %mo{:stretchy => "false"} )
                          %munderover
                            %mo ⊥
                            %munder
                              %mo ⟶
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %msub
                                  %mi R
                                  %mrow
                                    %mo{:stretchy => "false"} /
                                    %mi b
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                            %mover
                              %mo ⟵
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %msub
                                  %mi L
                                  %mrow
                                    %mo{:stretchy => "false"} /
                                    %mi b
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %msub
                            %mi 𝒞
                            %mrow
                              %mo{:stretchy => "false"} /
                              %mi b
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          \\mathcal{D}_{/L(b)}
                          \\underoverset
                          {\underset{\;\;\;\;R_{/b}\;\;\;\;}{\longrightarrow}}
                          {\overset{\;\;\;\;L_{/b}\;\;\;\;}{\longleftarrow}}
                          {\bot}
                          \\mathcal{C}_{/b}
                          \\mathrlap{\,,}
                  %p where:
                  %ul
                    %li
                      %p
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi L
                                %mrow
                                  %mo{:stretchy => "false"} /
                                  %mi b
                            %annotation{:encoding => "application/x-tex"} L_{/b}
                        is the evident induced functor (applying
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi L
                            %annotation{:encoding => "application/x-tex"} L
                        to the entire triangle
                        %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
                        in
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi 𝒞
                            %annotation{:encoding => "application/x-tex"} \mathcal{C}
                        which represent the morphisms in
                        = succeed ");" do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %msub
                                  %mi 𝒞
                                  %mrow
                                    %mo{:stretchy => "false"} /
                                    %mi b
                              %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/b}
                    %li
                      %p
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi R
                                %mrow
                                  %mo{:stretchy => "false"} /
                                  %mi b
                            %annotation{:encoding => "application/x-tex"} R_{/b}
                        is the
                        %a.existingWikiWord{:href => "/nlab/show/composition"} composite
                      .maruku-equation
                        %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi R
                                %mrow
                                  %mo{:stretchy => "false"} /
                                  %mi b
                              %mspace{:width => "thickmathspace"}
                              %mo{:lspace => "verythinmathspace"} :
                              %mspace{:width => "thickmathspace"}
                              %msub
                                %mi 𝒟
                                %mrow
                                  %mo{:stretchy => "false"} /
                                  %mrow
                                    %mi L
                                    %mo{:stretchy => "false"} (
                                    %mi b
                                    %mo{:stretchy => "false"} )
                              %mover
                                %mo ⟶
