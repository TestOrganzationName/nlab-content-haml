          %h3#UniquenessOfAdjoints Uniqueness of adjoints
          %p The adjoint of a functor is, if it exists, essentially unique:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              If the
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi D
                    %mo →
                    %mi C
