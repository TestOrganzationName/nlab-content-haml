              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
