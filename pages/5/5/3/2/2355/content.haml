                  that exhibits
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  as associated to
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Id
                          %mi C
                      %annotation{:encoding => "application/x-tex"} Id_C
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo ×
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} C \times \{0\}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo ×
                          %mo{:stretchy => "false"} {
                          %mn 2
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} C \times \{2\}
              %li
                %p
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{1,2\}
                  it is the morphism
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
