                  %mi X
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \phi \colon X \to \mathbb{R}
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %msub
