            = succeed "," do
              %a{:href => "#Radzikowski96"} Radzikowski 96
            %em distinguished parametrices
            introduced in
            = succeed "." do
              %a{:href => "#DuistermaatHoermander72"} DuistermaatHörmander 72
          %p
            According to
            = succeed "," do
              %a{:href => "#Radzikowski96"} Radzikowski 96
            %a.existingWikiWord{:href => "/nlab/show/wavefront+set"} wavefront set
            of a distribution on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ×
                  %mi M
                %annotation{:encoding => "application/x-tex"} M\times M
            is defined as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mo ′
