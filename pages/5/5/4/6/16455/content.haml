          %h2#properties Properties
          %h3#formal_selfadjointness Formal self-adjointness
          #FormallySelfAdjointKleinGordonOperator.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/formal+adjoint+differential+operator"} formally self-adjoint
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma = \mathbb{R}^{p,1}
              be
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              with
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≔
                    %mi Σ
                    %mo ×
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} E \coloneqq \Sigma \times \mathbb{R}
              be the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/trivial+line+bundle"} trivial line bundle
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} dvol_\Sigma
              induces an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mover
                          %mi E
                          %mo{:stretchy => "false"} ˜
                        %mo *
                      %mo ≃
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \tilde E^\ast \simeq E
            %p
              Consider then the
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+operator"} Klein-Gordon operator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo □
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mi m
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ×
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ×
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
