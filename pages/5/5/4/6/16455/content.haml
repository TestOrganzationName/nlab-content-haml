          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo □
                    %mi g
                %annotation{:encoding => "application/x-tex"} \Box_g
            denotes the
            %em
              %a.existingWikiWord{:href => "/nlab/show/wave+operator"} wave operator
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
