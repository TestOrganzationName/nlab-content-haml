                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\eta^{\mu \nu} \frac{\partial}{\partial x^\mu} \frac{\partial}{\partial x^\nu}
                  \-
                  \\left(
                  \\tfrac{m c}{\hbar}
