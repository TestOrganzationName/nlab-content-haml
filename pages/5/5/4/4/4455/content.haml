                      %annotation{:encoding => "application/x-tex"} x \lt y
          .num_defn
            %h6#definition_2 Definition
            %p
              The linearly ordered set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is
              %strong Dedekind complete
              if every cut
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,U)
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo &lt;
                    %mi a
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo &gt;
                    %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} L = \{x \;| \;x \lt a\},\; U = \{x \;|\; x \gt a\}
            %p
              for some unique
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} a \in S
          .num_defn
            %h6#definition_3 Definition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is also an unbounded dense strict linear order,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is Dedekind complete, and we have a
              %a.existingWikiWord{:href => "/nlab/show/universal+arrow"} universal arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo{:lspace => "verythinmathspace"} :
                    %mi T
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} u\colon T \to S
              in the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of strict linear orders, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              (equipped with
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
              %a.existingWikiWord{:href => "/nlab/show/the"} the
              %strong Dedekind completion
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
          %p
            The set of Dedekind cuts of
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            –the set of
            = succeed "\u2013" do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/countably+infinite+set"} countably infinite set
          %p
            The operation of forming the set of Dedekind cuts is idempotent, so the Dedekind completion can be constructed as the set of Dedekind cuts. More precisely, the Dedekind-complete strict linear orders form a
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            of the category of dense unbounded strict linear orders, so that Dedekind completion is a kind of
            %a.existingWikiWord{:href => "/nlab/show/completion"} completion
            in the abstract categorial sense.
          %h3#using_open_intervals Using open intervals
          %p
            A set
