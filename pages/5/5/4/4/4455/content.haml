          %h3#strict_preorders Strict preorders
          .standout
            %p
              Any paragraph containing the string ‘duisp’ is original research (although lower duisps at least are known in
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/domain+theory"} domain theory
          %p
            One can generalise Dedekind completion from
            %a.existingWikiWord{:href => "/nlab/show/strict+linear+orders"} strict linear orders
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strict+preorders"} strict preorders
          .num_defn
            %h6#definition_6 Definition
            %p
              A
              %strong duisp
              (
              %strong> d
              ense
              = succeed "nbounded" do
                %strong u
              = succeed "nhabited" do
                %strong i
              = succeed "trict" do
                %strong s
              = succeed "reorder)" do
