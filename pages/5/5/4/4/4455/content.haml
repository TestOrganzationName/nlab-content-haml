              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              such that, given finite (here always meaning
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Kuratowski-finite"} Kuratowski-finite
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
