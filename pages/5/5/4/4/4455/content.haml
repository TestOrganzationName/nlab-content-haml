              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            with a
            %a.existingWikiWord{:href => "/nlab/show/strict+linear+order"} strict linear order
            is
            %strong Dedekind complete
            if
          %ul
            %li
              %p
                For all elements
