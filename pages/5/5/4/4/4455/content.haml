                      %mi x
                      %mo &lt;
                      %mi U
                    %annotation{:encoding => "application/x-tex"} L \lt x \lt U
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo &lt;
                        %mi y
                        %mo &lt;
                        %mi U
                      %annotation{:encoding => "application/x-tex"} L \lt y \lt U
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo =
                        %mi y
                      %annotation{:encoding => "application/x-tex"} x = y
              %li
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi L
                    %annotation{:encoding => "application/x-tex"} x \in L
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi U
                      %annotation{:encoding => "application/x-tex"} y \in U
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo &lt;
                        %mi y
                      %annotation{:encoding => "application/x-tex"} x \lt y
          %p
            We then define
            %strong Dedekind-complete
            duisps and
            %strong Dedekind completions
            of duisps the same as for dense linear orders, using this notion of cut.
          %p
            A good example of a duisp is the set of
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            on any
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Sections 4.31–39 of
            %em
              %a.existingWikiWord{:href => "/nlab/show/HAF"} HAF
            do things in even more generality, but I don't really understand it yet.
          %h2#onesided_dedekind_completions One-sided Dedekind completions
          %p
            At least in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            (for a
            = succeed ")" do
              %strong lower cut
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            (for an
            = succeed ")" do
              %strong upper cut
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi ∅
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \infty \coloneqq (S,\empty)
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn ∞
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi ∅
                  %mo ,
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} -\infty \coloneqq (\empty,S)
            is a cut (depending on the side), and we can rule even these out by simply requiring that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            have an upper bound or that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            have a lower bound.
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %a.existingWikiWord{:href => "/nlab/show/one-sided+real+number"} one-sided real number
            for a discussion of the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is the strict linear order of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
          %p
            Even in classical mathematics, one-sided cuts do give us something new for strict preorders. Here, we have first more general one-sided notions of duisps: a
            %strong lower duisp
            need only satisfy the condition of a duisp for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
            %strong upper duisp
            need only satisfy the condition for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            a singleton. Then the
            %strong lower Dedekind completion
            of a lower duisp is its set of lower cuts, and the
            %strong upper Dedekind completion
            of an upper duisp is its set of upper cuts.
          %p
            For example, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be the strictly preordered set of
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
            real-valued functions on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a duisp, hence both a lower and upper duisp. Its lower Dedekind completion is the set of lower
            %a.existingWikiWord{:href => "/nlab/show/semicontinuous+map"} semicontinuous
            functions on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            taking values in the
            %a.existingWikiWord{:href => "/nlab/show/lower+reals"} lower reals
            (which classically are all either real or
            = succeed ");" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Taylor"}> Paul Taylor
                's
                %a{:href => "http://www.paultaylor.eu/ASD/dedras/classical"} page on Dedekind cuts
            %li
              %p
                Page 249&amp;250 of
                %em Continuous Lattices and Domains
                (
                %a{:href => "http://books.google.com/books?id=xPF9Hb7DPLgC"}> Google book
                ) covers lower Dedekind completions of duisps (although not under that name) in the context of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/domain+theory"} domain theory
            %li
              %p
                Univalent Foundations Project,
                %a.existingWikiWord{:href => "/nlab/show/HoTT+book"} Homotopy Type Theory – Univalent Foundations of Mathematics
                (2013)
            %li
              %p
                Auke B. Booij, Extensional constructive real analysis via locators, (
                %a{:href => "https://arxiv.org/abs/1805.06781"}> arxiv:1805.06781
                )
            %li
              %p
                Steve Vickers, “Localic Completion Of Generalized Metric Spaces I”,
                %a{:href => "http://www.tac.mta.ca/tac/volumes/14/15/14-15abs.html"} TAC
            %li
              %p
                Davorin Lešnik, Synthetic Topology and Constructive Metric Spaces, (
                %a{:href => "https://arxiv.org/abs/2104.10399"}> arxiv:2104.10399
                )
