                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  d &amp;\to&amp; c_1 \times_{c_2} \hat c_2 &amp;\to&amp; \hat c_2
                  \\\
                  \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                  \\\
                  c_3 &amp;\to&amp; c_1 &amp;\to&amp; c_2
                  }
                  \\,.
          %h3#direct_image_operation Direct image operation
          %p
            Recall that in an
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} opfibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} p : E\to B
            , the
            %em direct image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                %annotation{:encoding => "application/x-tex"} f_!
            of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∈
                  %mi E
                %annotation{:encoding => "application/x-tex"} e \in E
            along a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} p(e) \to d
            is the codomain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_!(e)
            of
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            opcartesian lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %mi e
                  %mo →
                  %msub
                    %mi f
                    %mo !
                  %mi e
                %annotation{:encoding => "application/x-tex"} \hat f : e \to f_! e
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %p
            By the above discussion this means that in the codomain opfibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} cod : [I,C] \to C
            the direct image of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo →
                  %msub
                    %mi c
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \hat c_1 \to c_1
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [I,C]
            along some morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mi c
                    %mn 1
                  %mo →
                  %msub
                    %mi c
                    %mn 2
                %annotation{:encoding => "application/x-tex"} f : c_1 \to c_2
            is the composite morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo →
                  %msub
                    %mi c
                    %mn 1
                  %mo →
                  %msub
                    %mi c
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \hat c_1 \to c_1 \to c_2
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [I,C]
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mrow
                    %msub
                      %mi c
                      %mn 2
                %annotation{:encoding => "application/x-tex"}
                  f_! : C/{c_1} \to C/{c_2}
          %p
            of
            %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategories
            obained by postcomposition with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %h3#inverse_image_operation Inverse image operation
          %p
            Recall that in an
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} p : E\to B
            , the
            %em inverse image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∈
                  %mi E
                %annotation{:encoding => "application/x-tex"} e \in E
            along a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo →
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d \to p(e)
            is the domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^*(e)
            of
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            cartesian lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %msup
                    %mi f
                    %mo *
                  %mi e
                  %mo →
                  %mi e
                %annotation{:encoding => "application/x-tex"} \hat f : f^* e \to e
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %p
            By the above discussion this means that in the codomain fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} cod : [I,C] \to C
            the inverse image of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 2
                  %mo →
                  %msub
                    %mi c
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \hat c_2 \to c_2
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [I,C]
            along some morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mi c
                    %mn 1
                  %mo →
                  %msub
                    %mi c
                    %mn 2
                %annotation{:encoding => "application/x-tex"} f : c_1 \to c_2
            is the morphism out of the
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %msub
                    %mi c
                    %mn 2
                  %mo =
                  %msub
                    %mi c
                    %mn 1
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi c
                        %mn 2
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 2
                  %mo →
                  %msub
                    %mi c
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f^* c_2 = c_1 \times_{c_2} \hat c_2 \to c_1
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [I,C]
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %mo ←
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mrow
                    %msub
                      %mi c
                      %mn 2
                  %mo :
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  C/{c_1} \leftarrow C/{c_2} : f^*
          %p
            of
            %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategories
            obained by pullback.
          %h3#adjointness_of_direct_and_inverse_image Adjointness of direct and inverse image
          %p
            For every morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mi c
                    %mn 1
                  %mo →
                  %msub
                    %mi c
                    %mn 2
                %annotation{:encoding => "application/x-tex"} f : c_1 \to c_2
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mrow
                    %msub
                      %mi c
                      %mn 2
                  %mo :
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  f_! : C/{c_1} \to C/{c_2} : f^*
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                %annotation{:encoding => "application/x-tex"} f_!
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_! \dashv f^*
          %p By the above discussion, the adjunction isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mrow
                      %msub
                        %mi C
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mo !
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo ,
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Hom
                    %mrow
                      %msub
                        %mi C
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo ,
                  %msup
                    %mi f
                    %mo *
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Hom_{C_2}(f_! \hat c_1, \hat c_2)
                  \\simeq
                  Hom_{C_1}(\hat c_1, f^*\hat c_2)
          %p
            is given by the universal property of the
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            operation, which says that morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mo !
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo →
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi c
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi c
                              %mn 2
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  (f_! \hat c_1 \to \hat c_2)
                  \=
                  \\left(
                  \\array{
                  \\hat c_1 &amp;\to&amp; \hat c_2
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  c_1 &amp;\to&amp; c_2
                  }
                  \\right)
          %p
            factor uniquely through the
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo ×
                              %mrow
                                %msub
                                  %mi c
                                  %mn 2
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi c
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi c
                              %mn 2
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\array{
                  \\hat c_1 &amp;\to&amp; c_1 \times_{c_2} \hat c_2 &amp;\to&amp; \hat c_2
                  \\\
                  \&amp;\searrow &amp; \downarrow &amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; c_1 &amp;\to&amp; c_2
                  }
                  \\right)
          %p and hence uniquely correspond to morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo →
                  %msup
                    %mi f
                    %mo *
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo ×
                              %mrow
                                %msub
                                  %mi c
                                  %mn 2
                            %msub
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                              %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi c
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi c
                              %mn 2
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\hat c_1 \to f^* \hat c_2)
                  \=
                  \\left(
                  \\array{
                  \\hat c_1 &amp;\to&amp; c_1 \times_{c_2} \hat c_2
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  c_1 &amp;\to&amp; c_2
                  }
                  \\right)
                  \\,.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo :
                  %mi c
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} u:c\to d
            a morphism in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                  %annotation{:encoding => "application/x-tex"} C/c
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi d
                  %annotation{:encoding => "application/x-tex"} C/d
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo !
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi c
                  %mo ⇆
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi d
                  %mo :
                  %msup
                    %mi u
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  u_! : C/c \leftrightarrows  C/d : u^*
          %p is then a Quillen pair.
          %h2#monadic_descent Monadic descent
          %p
            Since the codomain fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} cod : [I,C] \to C
            is a
            %a.existingWikiWord{:href => "/nlab/show/bifibration"} bifibration
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has all
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            %a.existingWikiWord{:href => "/nlab/show/monadic+descent"} monadic descent
            in this case. Details on this are at
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/monadic+descent#ForCodomainFibs"} monadic descent for codomain fibrations
          %h2#TheSubobjectFibration The Subobject Fibration
          %p
            By restricting our attention to a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            in the codomain fibration and using the notion of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/skeleton+of+a+fibration"} skeleton of a fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            with pullbacks called the
            %em subobject fibration
            whose fibers are categories of
            %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
            for objects of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            Beginning with the codomain fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi 𝒞
                    %mo →
                  %mo ⟶
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} cod \colon \mathcal{C}^\to \longrightarrow \mathcal{C}
            on a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            with
            %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
            (now writing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mo →
                %annotation{:encoding => "application/x-tex"} C^\to
            for the
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mono
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %msup
                    %mi 𝒞
                    %mo →
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Mono(\mathcal{C})\subseteq\mathcal{C}^\to,
          %p
            the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒞
                    %mo →
                %annotation{:encoding => "application/x-tex"} \mathcal{C}^\to
            whose objects are monomorphisms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed "." do
              %strong
                monomorphism category of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo :
                  %mi Mono
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  cod:Mono(\mathcal{C})\to\mathcal{C}
          %p
            is again a fibration since monomorphisms are stable under pullback; we will call this the
            = succeed "." do
              %strong
                monomorphism fibration of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mono
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi X
                %annotation{:encoding => "application/x-tex"} Mono(\mathcal{C})_X
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} X\in\mathcal{C}
            are
            %a.existingWikiWord{:href => "/nlab/show/thin+categories"} thin categories
            since parallel monos in a slice category are equal, but they aren’t subobject categories since antisymmetry is only weakly satisfied – objects with antiparallel arrows between them are necessarily isomorphic, but not necessarily equal. To remedy this, we take the
            %a.existingWikiWord{:href => "/nlab/show/fibered+skeleton"} fibered skeleton
            of the monomorphism fibration; briefly, we convert it into an
            %a.existingWikiWord{:href => "/nlab/show/indexed+category"} indexed category
            using the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
            of each index category, then turn it back into a fibration using the Grothendieck construction in the other direction. The resulting fibration is denoted
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo :
                  %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  cod:Sub(\mathcal{C})\to\mathcal{C}
          %p
            and called the
            = succeed "," do
              %strong
                subobject fibration of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi X
                %annotation{:encoding => "application/x-tex"} Sub(\mathcal{C})_X
            are skeletal thin categories, also known as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/poset+categories"} poset categories
          %p
            If we take
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo =
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \mathcal{C}=Set
            then the fibers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mono
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi X
                %annotation{:encoding => "application/x-tex"} Mono(Set)_X
            of the monomorphism fibration are proper classes consisting of all sets isomorphic to subsets of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi X
                %annotation{:encoding => "application/x-tex"} Sub(Set)_X
            consist of one representative from each isomorphism class of sets isomorphic to subsets of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            viewed as a poset. That is,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi X
                  %mo ≅
                  %mi 𝒫
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sub(Set)_X\cong\mathcal{P}(X)
            as posets, with equality holding if we choose the right representatives.
          %h2#in_higher_category_theory In higher category theory
          %p
            We discuss the codomain fibration in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
          %h3#in_2category_theory In 2-category theory
          %p
            A categorification in dimension 2 (see
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/2-category+theory"} 2-category theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Cat
                    %mn 2
                %annotation{:encoding => "application/x-tex"} Cat^2
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
              \: I still don’t believe that that is a 2-fibration. How do you lift the 2-cells?
            %p
              %a.existingWikiWord{:href => "/nlab/show/David+Roberts"}> David Roberts
              \: How does one lift the 2-cells in a 2-fibration anyway? The case of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Cat
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat^\mathbf{2}\to Cat
              (using weak 2-functors in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Cat
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} Cat^\mathbf{2}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Gpd
                    %annotation{:encoding => "application/x-tex"} Gpd
            %p
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
              \: I think the guiding example of a 2-fibration should actually be
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Fib
                      %mo →
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Fib \to Cat
              = succeed "." do
                %a{:href => "http://www.cs.math.ist.utl.pt/s84.www/cs/claudio/articles/2-fib.ps"} Hermida’s paper
          %h3#InInfinityCategoryTheory
            In
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{X}
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
          .num_prop
            %h6#proposition Proposition
            %p The codomain fibration
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cod
                    %mo :
                    %msup
                      %mi 𝒳
                      %mi I
                    %mo →
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"}
                    Cod : \mathcal{X}^I \to \mathcal{X}
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coCartesian+fibration"} coCartesian fibration
            %p
              It is classified under the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %msub
                      %mi 𝒳
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A \mapsto \mathcal{X}_{/A}
                    \\,,
            %p
              where on the right we have the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-category"} over-(∞,1)-category
          %p
            This is a special case of (
            %a{:href => "#Lurie"}> Lurie, corollary 2.4.7.12
            ).
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{X}
            an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C2%29-sheaf"} (infinity,2)-sheaf
          %h2#as_a_universe As a universe
          %p (…)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            the codomain fibration is the
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi Type
                  %mo :
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi Type
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mo *
                  %mo ≃
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\sum_{Type} : \mathbf{H}_{/Type} \to \mathbf{H}_{/*} \simeq \mathbf{H}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Type
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} Type \in \mathbf{H}
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/object+classifier"} object classifier
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universe"} universe
            %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/X}
            is the
            %a.existingWikiWord{:href => "/nlab/show/context"} context
            given by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi Type
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/Type}
            is the “context of the universe”. And so this says that the codomain fibration is the “context of the universe” regarded over the base
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p (…)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fibration+of+points"} fibration of points
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tangent+category"} tangent category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tangent+%28infinity%2C1%29-category"} tangent (infinity,1)-category
          %h2#references References
          %ul
            %li#Lurie
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              , Section 2.4.7 of:
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
        .revisedby
