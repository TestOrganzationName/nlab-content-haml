                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mover
                              %mi c
                              %mo{:stretchy => "false"} ^
                            %mn 2
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi c
                            %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi c
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  c_1 \times_{c_2} \hat c_2 &amp;\to&amp; \hat c_2
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
