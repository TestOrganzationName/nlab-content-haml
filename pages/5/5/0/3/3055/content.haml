                        %mn 2
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 2
                %annotation{:encoding => "application/x-tex"} d\to c_1 \times_{c_2} \hat c_2
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            such that this factors as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi d
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi c
                            %mn 1
                          %msub
                            %mo ×
                            %mrow
                              %msub
                                %mi c
                                %mn 2
                          %msub
                            %mover
                              %mi c
                              %mo{:stretchy => "false"} ^
                            %mn 2
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mover
                              %mi c
                              %mo{:stretchy => "false"} ^
                            %mn 2
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
