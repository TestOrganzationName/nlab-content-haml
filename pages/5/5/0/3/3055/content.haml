                            %mi c
                            %mn 3
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi c
                            %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi c
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  d &amp;\to&amp; &amp;\to&amp; \hat c_2
                  \\\
                  \\downarrow &amp;&amp; &amp;&amp; \downarrow
                  \\\
