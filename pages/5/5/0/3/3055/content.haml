            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi d
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mover
                              %mi c
                              %mo{:stretchy => "false"} ^
                            %mn 2
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi c
                            %mn 3
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi c
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  d &amp;\to&amp; \hat c_2
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  c_3 &amp;\to&amp; c_2
                  }
          %p
            any lift of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 3
                  %mo →
                  %msub
                    %mi c
                    %mn 2
                %annotation{:encoding => "application/x-tex"} c_3 \to c_2
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [I,C]
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
