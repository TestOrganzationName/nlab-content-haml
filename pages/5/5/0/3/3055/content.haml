          %h2#definition Definition
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo ⟶
                  %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  t \;\colon\; [I,C] \longrightarrow C
                  \\,,
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi Arr
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} [I,C] = Arr(C)
            that sends each
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mover
                    %mo →
                    %mi f
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} (c_1 \stackrel{f}{\to} c_2) \in [I,C]
            to its
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} c_2
          %p
            This functor is always an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+opfibration"} Grothendieck opfibration
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            it corresponds to the
            %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi C
                  %mo ⟶
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  C_{(-)} \,\colon\, C \longrightarrow Cat
          %p
            that sends each object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            to the
            %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi c
                  %annotation{:encoding => "application/x-tex"} C_{/c}
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has all
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bifibration"} bifibration
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibrations"} Cartesian fibrations
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo *
                %annotation{:encoding => "application/x-tex"} u_*
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mo *
                %annotation{:encoding => "application/x-tex"} u^*
            exists for every morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            iff C is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
          %p
            In any case, this functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} cod \colon [I,C] \to C
            is called the
            %strong codomain fibration
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            Some say
            %strong basic fibration
            or
            %strong
              %a.existingWikiWord{:href => "/nlab/show/indexed+category"} self-indexing
            or the
            %strong fundamental fibration
            — anything with so many names must be important!
          %p
            If instead of the codomain the domain is used, one obtains the dual notion:
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/domain+opfibration"} domain opfibration
          %h2#details Details
          %p We spell out the details of the functor, of its cartesian and opcartesian morphisms and their properties.
          %h3#the_arrow_category The arrow category
          %p
            Recall from the discussion at
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            that the objects in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Arr
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Arr(C)
            are morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and the morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo :
                  %msub
                    %mi x
                    %mn 1
                  %mo →
                  %msub
                    %mi x
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo :
                  %msub
                    %mi y
                    %mn 1
                  %mo →
                  %msub
                    %mi y
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f:x_1\to x_2)\to (g: y_1\to y_2)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Arr
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Arr(C)
            are the commutative squares in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 1
                        %mtd
                          %mover
                            %mo ⟶
                            %mi v
                        %mtd
                          %msub
                            %mi y
                            %mn 1
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mpadded{:width => "0"}
                            %mi f
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mpadded{:width => "0"}
                            %mi g
                      %mtr
                        %mtd
                          %msub
                            %mi x
                            %mn 2
                        %mtd
                          %mover
                            %mo ⟶
                            %mi u
                        %mtd
                          %msub
                            %mi y
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  x_1 &amp;\stackrel{v}\longrightarrow&amp; y_1
                  \\\
                  \\big\downarrow\mathrlap{f}
                  \&amp;&amp;
                  \\big\downarrow\mathrlap{g}
                  \\\
                  x_2 &amp;\stackrel{u}\longrightarrow&amp; y_2
                  }
          %p with the obvious composition.
          %h3#the_functor The functor
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo :
                  %mi Arr
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} cod : Arr(C)\to C
            is given on objects by the codomain (= target) map, and on morphisms it gives the lower arrow of the commutative square.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi x
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mi v
                          %mtd
                            %msub
                              %mi y
                              %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi f
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi g
                        %mtr
                          %mtd
                            %msub
                              %mi x
                              %mn 2
                          %mtd
                            %mover
                              %mo →
                              %mi u
                          %mtd
                            %msub
                              %mi y
                              %mn 2
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 2
                  %mover
                    %mo →
                    %mi u
                  %msub
                    %mi y
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  cod :
                  \\;\;
                  \\left(
                  \\array{
                  x_1 &amp;\stackrel{v}\to&amp; y_1
                  \\\
                  \\downarrow\mathrlap{f}
                  \&amp;&amp;
                  \\downarrow\mathrlap{g}
                  \\\
                  x_2 &amp;\stackrel{u}\to&amp; y_2
                  }
                  \\right)
                  \\;\;
                  \\mapsto
                  \\;\;
                  (x_2 \stackrel{u}\to y_2)
                  \\,.
          %p
            If we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [I,C]
            for the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the
            %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo →
                    %mi b
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I = \{a \to b\}
            %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
            applied to the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mn 1
                  %mo :
                  %mi b
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo →
                  %mi b
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \iota_1 : {b} \to \{a \to b\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo =
                  %msub
                    %mi Hom
                    %mtext Cat
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ι
                    %mn 1
                  %mo ,
                  %msub
                    %mn 1
                    %mi C
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mo *
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  cod = Hom_\text{Cat}(\iota_1, 1_C) : [I,C] \to [{*}, C] = C
                  \\,.
          %h3#the_opcartesian_lifts The op-cartesian lifts
          %p
            That the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} cod : [I,C] \to C
            is an
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} opfibration
            means that for each object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo →
                  %msub
                    %mi c
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \hat c_1 \to c_1
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi I
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [I,C]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 1
                  %mover
                    %mo →
                    %mi f
                  %msub
                    %mi c
                    %mn 2
                %annotation{:encoding => "application/x-tex"} c_1 \stackrel{f}{\to} c_2
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has a lift to a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mover
                              %mi c
                              %mo{:stretchy => "false"} ^
                            %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %mo ?
                          %mo ?
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi c
                            %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi c
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\hat c_1 &amp;\to&amp; ??
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  c_1 &amp;\to&amp; c_2
                  }
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [I,C]
            that is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+morphism"} opcartesian morphism
          %p Such a lift is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mover
                              %mi c
                              %mo{:stretchy => "false"} ^
                            %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mi Id
                        %mtd
                          %msub
                            %mover
                              %mi c
                              %mo{:stretchy => "false"} ^
                            %mn 1
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi c
                            %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi c
                            %mn 2
