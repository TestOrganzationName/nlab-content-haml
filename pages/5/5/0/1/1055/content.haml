              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi F
                  %annotation{:encoding => "application/x-tex"} Sh(C,J)/F
              has a canonical étale projection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
