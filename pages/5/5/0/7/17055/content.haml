          %h2#idea Idea
          %p
            In the context of
            %a.existingWikiWord{:href => "/nlab/show/Goodwillie+calculus"} Goodwillie calculus
            an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            is called
            %em analytic
            if it behaves in
            %a.existingWikiWord{:href => "/nlab/show/analogy"} analogy
            with an
            %a.existingWikiWord{:href => "/nlab/show/analytic+function"} analytic function
            in that it its
            %a.existingWikiWord{:href => "/nlab/show/Goodwillie-Taylor+tower"} Goodwillie-Taylor tower
            converges to it.
          %h2#definition Definition
          %h3#cocartesian_cubical_diagrams (Co-)Cartesian cubical diagrams
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-colimits"} finite (∞,1)-colimits
          #StronglyCoCartesian.num_defn
            %h6#definition_2 Definition
            %p
              An
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/cube"} cube
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo □
                        %mi n
                      %mo ⟶
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \Box^n \longrightarrow \mathcal{C}
              %em strongly homotopy co-cartesian
              or just
              = succeed "," do
                %em strongly co-cartesian
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
              %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          #Cartesian.num_defn
            %h6#definition_3 Definition
            %p
              An
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/cube"} cube
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo □
                        %mi n
                      %mo ⟶
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \Box^n \longrightarrow \mathcal{D}
              %em homotopy cartesian
              or just
              = succeed "," do
                %em cartesian
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
