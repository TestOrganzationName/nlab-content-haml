              over the remaining objects.
          %h3#analytic_functors Analytic functors
          #rhoAnalyticFunctor.num_defn
            %h6#definition_4 Definition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C} \to \mathcal{D}
              is
              %em
                stably
                = succeed "-excisive" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              with constants
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              and
              = succeed "_" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %em
                satisfies “condition
                = succeed "\u201D" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi κ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E_n(c,\kappa)
              – if for every strongly co-Cartesian
              = succeed "-cube" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} (n)+1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "," do
                %a.maruku-ref{:href => "#StronglyCoCartesian"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X(\emptyset) \to X(s)
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mi s
                    %annotation{:encoding => "application/x-tex"} k_s
              %a.existingWikiWord{:href => "/nlab/show/n-connected+object+of+an+%28infinity%2C1%29-topos"} connective
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi s
                    %mo ≥
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} k_s \geq \kappa
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} s\in \{1,\cdots, n+1\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(X)
              is an
              = succeed "-cube" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              such that the comparison map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %munder
                      %mi lim
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi K
                            %mspace{:width => "thinmathspace"}
                            %mi subcube
                            %mspace{:width => "thinmathspace"}
                            %mi of
                            %mspace{:width => "thinmathspace"}
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mrow
                          %mrow
                            %mi K
                            %mo ≠
                            %mi ∅
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F(\emptyset) \longrightarrow \underset{{K\,subcube\,of\,F(X)}\atop {K \neq \emptyset}}{\lim} F(K)
            %p
              (to the indicated
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi c
                      %mo +
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi s
                      %msub
                        %mi k
                        %mi s
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-c + \sum_s k_s)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-connected+object+of+an+%28infinity%2C1%29-topos"} connective
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is called
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
                \-analytic
              if there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              such that it satisfies the condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mi ρ
                    %mo −
                    %mi q
                    %mo ,
                    %mi ρ
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_n(n\rho - q,\rho + 1)
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Johnson95"} Johnson 95, def. 1.1, def. 1.3
          %h2#properties Properties
          %h3#convergence_of_the_goodwillietaylor_tower Convergence of the Goodwillie-Taylor tower
          %p
            For
            = succeed "-analytic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
            %a.existingWikiWord{:href => "/nlab/show/Goodwillie-Taylor+tower"} Goodwillie-Taylor tower
            converges to them on
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/n-connected+object+of+an+%28infinity%2C1%29-topos"} connective objects
          %h2#examples Examples
          %h3#the_identity_functor_on_homotopy_types The identity functor on homotopy types
          %p
            The identity
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            is 1-analytic, def.
            = succeed "." do
              %a.maruku-ref{:href => "#rhoAnalyticFunctor"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            this is the statement of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Blakers-Massey+theorem"} Blakers-Massey theorem
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo &gt;
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \gt 2
            this is the statment of the
            = succeed "." do
              %a{:href => "Blakers-Massey+theorem#HigherCubical"} higher cubical BM-theorems
          %p
            (see e.g.
            = succeed ")" do
              %a{:href => "#MunsonVolic15"} Munson-Volic 15, example 10.1.18
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/excisive+%28%E2%88%9E%2C1%29-functor"} excisive (∞,1)-functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/polynomial+%28%E2%88%9E%2C1%29-functor"} polynomial (∞,1)-functor
          %h2#references References
          %p The concept is due to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tom+Goodwillie"}> Tom Goodwillie
              ,
              = succeed "," do
                %em Calculus II: Analytic functors
          %p Review includes
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tom+Goodwillie"}> Tom Goodwillie
                , section 3 of
                = succeed "," do
                  %em The differential calculus of homotopy functors
                = succeed "," do
                  %a{:href => "https://math.mit.edu/juvitop/old/notes/2009_Fall/goodwillie-icm.pdf"} article pdf
                = succeed "," do
                  %a{:href => "https://www.mathunion.org/fileadmin/ICM/Proceedings/ICM1990.2/ICM1990.2.ocr.pdf"} full proceedings Vol I pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/GoodwillieICM1990.pdf", :title => "pdf"} pdf
            %li#Johnson95
              %p
                Brenda Johnson,
                = succeed "," do
                  %em The derivatives of homotopy theory
                = succeed ")" do
                  %a{:href => "http://www.ams.org/journals/tran/1995-347-04/S0002-9947-1995-1297532-6/S0002-9947-1995-1297532-6.pdf"} pdf
          %p A textbook account is in
          %ul
            %li#MunsonVolic15
              %a.existingWikiWord{:href => "/nlab/show/Brian+Munson"}> Brian Munson
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ismar+Volic"} Ismar Volic
              = succeed "," do
                %em Cubical homotopy theory
              %a{:href => "http://palmer.wellesley.edu/~ivolic/pdf/Papers/CubicalHomotopyTheory.pdf"} pdf
