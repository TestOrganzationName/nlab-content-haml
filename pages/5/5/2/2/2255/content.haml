            in the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/modal+logics"} modal logics
            = succeed "," do
              %em nodes
            %em vertices
            or whatever your preferred terminology is, and a binary relation,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
