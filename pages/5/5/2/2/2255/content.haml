          %h3#as_polynomial_endofunctors_after_kock As polynomial endofunctors (after Kock)
          %p
            A new way of thinking about (rooted, usually assumed finite) trees has been introduced by
            = succeed "." do
              %a{:href => "#Kock"} Joachim Kock
          .num_defn
            %h6#definition Definition
            %p
              A
              %em tree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              consists of a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} T_0
              of edges, a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
              of nodes, and a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} T_2
              of
              = succeed "," do
                %em input flags
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 0
                    %mover
                      %mo ←
                      %mi s
                    %msub
                      %mi T
                      %mn 2
                    %mover
                      %mo →
                      %mi p
                    %msub
                      %mi T
                      %mn 1
                    %mover
                      %mo →
                      %mi t
                    %msub
                      %mi T
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} T_0 \stackrel{s}{\leftarrow} T_2 \stackrel{p}{\to} T_1 \stackrel{t}{\to} T_0
            %p such that
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
                is injective,
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
                is injective and its image is complementary to a singleton
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi r
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{r\}
                (called the
                = succeed ")," do
                  %em root
              %li
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo ∈
                      %msub
                        %mi T
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} e \in T_0
                there exists a natural number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                such that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi σ
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi r
                      %annotation{:encoding => "application/x-tex"} \sigma^k(e) = r
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo :
                      %msub
                        %mi T
                        %mn 0
                      %mo →
                      %msub
                        %mi T
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \sigma : T_0 \to T_0
                is the “walk-to-root” function defined by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo ↦
                      %mi t
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} e \mapsto t(p(s^{-1}(e)))
                if
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo ≠
                        %mi r
                      %annotation{:encoding => "application/x-tex"} e \neq r
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ↦
                        %mi r
                      %annotation{:encoding => "application/x-tex"} r \mapsto r
          %p
            Some commentary is in order. The subscript
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            for edges and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            for nodes is consonant with standard usage in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string+diagrams"} string diagrams
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "-cells." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %msub
                    %mi T
                    %mn 1
                  %mo →
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} t: T_1 \to T_0
            maps a node to its outgoing edge. Only the root edge is not an input edge of any node, i.e., the unique inhabitant of the complement of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi im
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} im(s)
            is what we call the root
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                  %mo →
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} T_1 \to T_0
            is actually a multivalued function, taking a node to the set of its input edges, and is therefore represented as a
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            or
            %a.existingWikiWord{:href => "/nlab/show/span"} span
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} T_0
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_2
            is the set of ordered pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (e, v)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∈
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} e \in T_0
            is an input edge of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} v \in T_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            input-incident to
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
          %p
            To each tree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            described in this form, there is an associated
            %a.existingWikiWord{:href => "/nlab/show/polynomial+endofunctor"} polynomial endofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi T
                  %mo :
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi T
                    %mn 0
                  %mo →
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} p_T: Set/T_0 \to Set/T_0
            controlled by the data
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 0
                  %mover
                    %mo ←
                    %mi s
                  %msub
                    %mi T
                    %mn 2
                  %mover
                    %mo →
                    %mi p
                  %msub
                    %mi T
                    %mn 1
                  %mover
                    %mo →
                    %mi t
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} T_0 \stackrel{s}{\leftarrow} T_2 \stackrel{p}{\to} T_1 \stackrel{t}{\to} T_0
          %p and defined by the composition
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi T
                    %mn 0
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi s
                        %mo *
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi T
                    %mn 2
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi Π
                        %mi p
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi T
                    %mn 1
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi Σ
                        %mi t
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi T
                    %mn 0
                %annotation{:encoding => "application/x-tex"} Set/T_0 \stackrel{s^\ast}{\to} Set/T_2 \stackrel{\Pi_p}{\to} Set/T_1 \stackrel{\Sigma_t}{\to} Set/T_0
          %p
            where as usual
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi f
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi Π
                      %mi f
                  %annotation{:encoding => "application/x-tex"} \Sigma_f \dashv f^\ast \dashv \Pi_f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi T
                %annotation{:encoding => "application/x-tex"} p_T
            preserves pullbacks.
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/double+category"} double category
            whose
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mo →
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi J
                  %annotation{:encoding => "application/x-tex"} p: Set/I \to Set/J
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo :
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %mi I
                  %mo →
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %mi I
                  %mo ′
                %annotation{:encoding => "application/x-tex"} f^\ast: Set/I \to Set/I'
            induced by functions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi I
                    %mo ′
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} f: I' \to I
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %a.existingWikiWord{:href => "/nlab/show/cartesian+natural+transformations"} cartesian natural transformations
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Set
                          %mo{:stretchy => "false"} /
                          %mi I
                        %mtd
                          %mover
                            %mo →
                            %mi p
                        %mtd
                          %mi Set
                          %mo{:stretchy => "false"} /
                          %mi J
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mrow
                              %msup
                                %mi f
                                %mo *
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %msup
                                %mi g
                                %mo *
                      %mtr
                        %mtd
                          %mi Set
                          %mo{:stretchy => "false"} /
                          %mi I
                          %mo ′
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mi p
                              %mo ′
                        %mtd
                          %mi Set
                          %mo{:stretchy => "false"} /
                          %mi J
                          %mo ′
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Set/I &amp; \stackrel{p}{\to} &amp; Set/J \\
                  \\mathllap{f^\ast} \downarrow &amp; \swArrow &amp; \downarrow \mathrlap{g^\ast} \\
                  Set/I' &amp; \underset{p'}{\to} &amp; Set/J'
                  }
          %p
            The category consisting of horizontal arrows and 2-cells between them is called the
            = succeed "," do
              %em category of polynomial endofunctors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PolyEnd
                  %annotation{:encoding => "application/x-tex"} PolyEnd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            and whose morphisms are morphisms between the corresponding endofunctors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi T
                %annotation{:encoding => "application/x-tex"} p_T
            as objects in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PolyEnd
                  %annotation{:encoding => "application/x-tex"} PolyEnd
          %p
            As Kock shows, this description of trees is well-adapted to the usual sorts of combinatorics that emerge in the study of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/operads"} operads
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/category+of+trees"} category of trees
            %li
              %p
                in
                %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
                %a.existingWikiWord{:href => "/nlab/show/Feynman+graphs"} Feynman graphs
                of vanishing “
                %a.existingWikiWord{:href => "/nlab/show/loop+order"}> loop order
                ” are trees, and their contribution to the
                %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
                is hence called the
                %em tree level
                contribution
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/shuffle+of+trees"} shuffle of trees
            %li
