                            %mo :
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
