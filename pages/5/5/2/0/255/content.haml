            = succeed "," do
              %a{:href => "#Street72"} Street 1972 p. 150-151
            = succeed "&rbrack;:" do
              %a{:href => "#Leinster04"} Leinster 2004 pp. 148
          %p
          #TwoCategoryOfMonads.num_defn
            %h6 Definition
            %p
              %strong (2-category of monads)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
