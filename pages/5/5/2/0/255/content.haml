                    \\,,
            %p a morphism between them is
            %ul
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
