                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Mnd(K)
                  (“monad functor” or “
                  %a.existingWikiWord{:href => "/nlab/show/monad+transformation"}> monad transformation
                  ”)
                %p is given by
                %ol
                  %li
                    %p
                      a
                      %a.existingWikiWord{:href => "/nlab/show/1-morphism"} 1-morphism
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi x
