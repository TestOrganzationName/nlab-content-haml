                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mnd(K)
            of monads in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            to be the
            %a.existingWikiWord{:href => "/nlab/show/lax+functor"} lax
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
