                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 4
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi χ
                    %mn 8
                %annotation{:encoding => "application/x-tex"}
                  \\tfrac{1}{2}\big( p_2 - \tfrac{1}{4}(p_1)^2  \big)
                  \\;=\;
                  \\chi_8
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
            (see
            %a{:href => "Spin7-manifold#CharacteristicClassesForSpinStructure"} this Prop.
            and
            = succeed "," do
              %a{:href => "quaternion-Kähler+manifold#CharacteristicClassesForSpin5Spin3Structure"} this Prop.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mn 8
                  %mo =
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 24
                  %msub
                    %mi χ
                    %mn 8
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  I_8 = \tfrac{1}{24} \chi_8
                  \\,.
          %h3#AsHigherCurvatureCorrectionTo11dSugra As a higher curvature correction to 11d Supergravity
          %p
            A systematic analysis of the possible
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetric
            %a.existingWikiWord{:href => "/nlab/show/higher+curvature+corrections"} higher curvature corrections
            of
            %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
            makes the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mn 8
                %annotation{:encoding => "application/x-tex"} I_8
            appear as the higher curvature correction at order
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℓ
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} \ell^6
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                %annotation{:encoding => "application/x-tex"} \ell
            is the
            %a.existingWikiWord{:href => "/nlab/show/Planck+length"} Planck length
            in 11d (
            %a{:href => "#SoueresTsimpis17"}> Souères-Tsimpis 17, Section 4
            ).
          %p
            At this order, the
            %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
            for the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            %a.existingWikiWord{:href => "/nlab/show/flux"} flux
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 4
                %annotation{:encoding => "application/x-tex"} G_4
            and its dual
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 7
                %annotation{:encoding => "application/x-tex"} G_7
            is (
            %a{:href => "#SoueresTsimpis17"}> Souères-Tsimpis 17, (4.3)
            )
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi G
                    %mn 7
                  %mo{:stretchy => "false"} (
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msub
                    %mi G
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %msub
                    %mi G
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msup
                    %mi ℓ
                    %mn 6
                  %msub
                    %mi I
                    %mn 8
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  d G_7(\ell)
                  \\;=\;
                  \-\tfrac{1}{2}
                  G_4(\ell) \wedge G_4(\ell)
                  +
                  \\ell^6 I_8(R)
                  \\,,
          %p
            where the flux forms themselves appear in their higher order corrected form as
            %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
            in the
            %a.existingWikiWord{:href => "/nlab/show/Planck+length"} Planck length
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi G
                    %mn 4
                  %mo +
                  %msup
                    %mi ℓ
                    %mn 6
                  %msubsup
                    %mi G
                    %mn 4
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo +
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  G_4(\ell)
                  \\;=\;
                  G_4 + \ell^6 G_4^{(1)} + \cdots
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 7
                  %mo{:stretchy => "false"} (
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi G
                    %mn 7
                  %mo +
                  %msup
                    %mi ℓ
                    %mn 6
                  %msubsup
                    %mi G
                    %mn 7
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo +
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  G_7(\ell)
                  \\;=\;
                  G_7 + \ell^6 G_7^{(1)} + \cdots
          %p
            (
            %a{:href => "#SoueresTsimpis17"}> Souères-Tsimpis 17, (4.4)
            )
          %p
            Beware that this is not the lowest order
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/higher+curvature+correction"} higher curvature correction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℓ
                      %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(\ell^3)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℓ
                    %mn 3
                  %msub
                    %mi G
                    %mn 4
                  %mo ∧
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \ell^3 G_4 \wedge \tfrac{1}{2}p_1(R)
            (
            %a{:href => "#SoueresTsimpis17"}> Souères-Tsimpis 17, Section 3.2
            ). Hence the full correction at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℓ
                    %mn 6
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{O}(\ell^6)
            should be the further modification of
            %a.maruku-eqref{:href => "#eq:11dSugraBIAtOrder6"} (2)
            to (cf.
            = succeed "):" do
              %a{:href => "D=11+supergravity#Tsimpis04"} Tsimpis 2004, p. 8
          #eq:11dSugraBIAtOrder6.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi G
                    %mn 7
                  %mo{:stretchy => "false"} (
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msub
                    %mi G
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi G
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi ℓ
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mn 2
                  %msup
                    %mi ℓ
                    %mn 3
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo +
                  %msup
                    %mi ℓ
                    %mn 6
                  %msub
                    %mi I
                    %mn 8
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d G_7(\ell)
                  \\;=\;
                  \-\tfrac{1}{2}
                  G_4(\ell) \wedge
                  \\big(
                  G_4(\ell)
                  \-
                  2\ell^3 \tfrac{1}{2} p_1(R)
                  \\big)
                  +
                  \\ell^6 I_8(R)
                  \\,.
          %h3#InflowToM5BraneAnomaly Inflow to M5-brane anomalies
          %p
            Consider an 11-dimensional
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 11
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X^{(11)}
            and a 2-parameter family of 6-dimensional
            %a.existingWikiWord{:href => "/nlab/show/submanifolds"} submanifolds
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mrow
                        %mi M
                        %mn 5
                    %mo ↪
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 11
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q_{M5} \hookrightarrow X^{(11)}
            %a.existingWikiWord{:href => "/nlab/show/worldvolumes"} worldvolumes
            of an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            %a.existingWikiWord{:href => "/nlab/show/normal+bundles"} normal bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mi X
                  %msub
                    %mi Q
                    %mrow
                      %mi M
                      %mn 5
                %annotation{:encoding => "application/x-tex"} N_X Q_{M5}
            of this inclusion carries a
            %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
          #eq:IM5.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi I
                    %mrow
                      %mi M
                      %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi I
                    %mi ψ
                    %mrow
                      %mi M
                      %mn 5
                  %mo +
                  %msub
                    %mi I
                    %mi C
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi H
                    %mn 8
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ×
                  %msub
                    %mi Q
                    %mrow
                      %mi M
                      %mn 5
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  I^{M5}
                  \\;\coloneqq\;
                  I^{M5}_{\psi}
                  +
                  I_{C}
                  \\;\in\;
                  H^8(F \times Q_{M5},\mathbb{Z})
          %p where
          %ol
            %li
              %p
                the first summand is the class of the
                %a.existingWikiWord{:href => "/nlab/show/chiral+anomaly"} chiral anomaly
                of
                %a.existingWikiWord{:href => "/nlab/show/chiral+fermions"} chiral fermions
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Q
                        %mrow
                          %mi M
                          %mn 5
                    %annotation{:encoding => "application/x-tex"} Q_{M5}
                (
                %a{:href => "#Witten96"}> Witten 96, (5.1)
                ),
            %li
              %p
                the second term the class of the
                %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} quantum anomaly
                of a
                %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+field"} self-dual higher gauge field
                (
                %a{:href => "#Witten96"}> Witten 96, (5.4)
                )
          %p
            Moreover, there is the restriction of the
            = succeed "-term" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mn 8
                  %annotation{:encoding => "application/x-tex"} I_8
            %a.maruku-eqref{:href => "#eq:TheTerm"} (1)
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mrow
                        %mi M
                        %mn 5
                  %annotation{:encoding => "application/x-tex"} Q_{M5}
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mn 11
                %annotation{:encoding => "application/x-tex"} X^{11}
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mrow
                      %mi M
                      %mn 5
                %annotation{:encoding => "application/x-tex"} Q_{M5}
            (the “anomaly inflow” from the
            %a.existingWikiWord{:href => "/nlab/show/bulk+spacetime"} bulk spacetime
            to the M5-brane)
          #eq:I8AnomalyInflow.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mn 8
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %mi M
                      %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi I
                    %mn 8
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi T
                    %mrow
                      %msub
                        %mi Q
                        %mrow
                          %mi M
                          %mn 5
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi H
                    %mn 8
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ×
                  %msub
                    %mi Q
                    %mrow
                      %mi M
                      %mn 5
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  I_8\vert_{M5}
                  \\;\coloneqq\;
                  I_8
                  \\big(
                  T_{Q_{M5}} X
                  \\big)
                  \\;\in\;
                  H^8(F \times Q_{M5},\mathbb{Z})
                  \\,.
          %p
            The sum of these cohomology classes, evaluated on the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mrow
                      %mi M
                      %mn 5
                %annotation{:encoding => "application/x-tex"} Q_{M5}
            is proportional to the
            %a.existingWikiWord{:href => "/nlab/show/second+Pontryagin+class"} second Pontryagin class
            of the
            %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
          #eq:SumOfM5AndInflowAnomalyIsp2.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi I
                    %mrow
                      %mi M
                      %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo +
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi I
                    %mn 8
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %mi M
                      %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 24
                  %msub
                    %mi p
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi N
                    %mrow
                      %msub
                        %mi Q
                        %mrow
                          %mi M
                          %mn 5
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  I^{M5}
                  \\;+\;
                  I_8\vert_{M5}
                  \\;=\;
                  \\tfrac{1}{24} p_2(N_{Q_{M5}})
          %p
            (
            %a{:href => "#Witten96"}> Witten 96 (5.7)
            )
          %p
            This result used to be “somewhat puzzling” (
            %a{:href => "#Witten96"}> Witten 96, p. 35
            ) since consisteny of the
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            in
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            should require its total
            %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} quantum anomaly
            to vanish. But
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi N
                    %mrow
                      %msub
                        %mi Q
                        %mrow
                          %mi M
                          %mn 5
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p_2(N_{Q_{M5}})
            does not in general vanish, and the right conditions to require under which it does vanish were “not clear” (
            %a{:href => "#Witten96"}> Witten 96, p. 37
            ).
          %p
            (For more details on computations involved this and the following arguments, see also
            = succeed ")." do
              %a{:href => "#BilalMetzger03"} Bilal-Metzger 03
          %p
            A resolution was proposed in
            = succeed "," do
              %a{:href => "#FreedHarveyMinasianMoore98"} Freed-Harvey-Minasian-Moore 98
            = succeed "," do
              %a{:href => "#BahBonettiMinasianNardoni18"} Bah-Bonetti-Minasian-Nardoni 18 (5)
            = succeed "." do
              %a{:href => "#BBMN19"} BBMN 19 (2.9) and appendix A.4, A.5
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mn 8
                  %annotation{:encoding => "application/x-tex"} I_8
            %a.maruku-eqref{:href => "#eq:I8AnomalyInflow"} (4)
            but would be all of the following
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
          #eq:FiberIntegration.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mo *
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 6
                          %msub
                            %mi G
                            %mn 4
                          %msub
                            %mi G
                            %mn 4
                          %msub
                            %mi G
                            %mn 4
                          %mo +
                          %msub
                            %mi G
                            %mn 4
                          %msub
                            %mi I
                            %mn 8
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mtd
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 24
                          %msub
                            %mi p
                            %mn 2
                          %mo +
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi G
                            %mn 4
                            %mrow
                              %mi M
                              %mn 5
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                          %mo +
                          %msub
                            %mi I
                            %mn 8
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\pi_\ast
                  \\Big(
                  \-
                  \\tfrac{1}{6}
                  G_4  G_4  G_4
                  +
                  G_4  I_8
                  \\Big)
                  \&amp; =
                  \- \tfrac{1}{24} p_2 + \tfrac{1}{2}(G^{M5}_4)^2 + I_8
                  }
          %p
            Here we used
            %a{:href => "Spin5#FiberIntegrationOfCupPowersOfChiOver4Sphere"} this Prop
            to find that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo *
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi χ
                    %mn 3
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 2
                  %msub
                    %mi p
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\pi_\ast\big(
                  \\chi^3
                  \\big)
                  \\;=\;
                  2 p_2
          %p
            which would cancel against the first term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 24
                  %msub
                    %mi p
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \tfrac{1}{24} p_2
            in
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:FiberIntegration"} (6)
            %a.maruku-eqref{:href => "#eq:SumOfM5AndInflowAnomalyIsp2"} (5)
            would be canceled – except for a remaining term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi G
                    %mn 4
                    %mrow
                      %mi M
                      %mn 5
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \tfrac{1}{2}(G^{M5}_4)^2
            which is ignored by fiat.
          %p
            %br/
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pontryagin+classes"}> Pontryagin classes
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+classes"} Stiefel-Whitney classes
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Wu+classes"} Wu classes
                %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/C-field+tadpole+cancellation"} C-field tadpole cancellation
          %h2#references References
          %h3#general General
          %p
            The term showed in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            %a.existingWikiWord{:href => "/nlab/show/anomaly+cancellation"} anomaly cancellation
            in
          %ul
            %li#VafaWitten95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"}> Cumrun Vafa
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
                = succeed "," do
                  %em A One-Loop Test Of String Duality
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9505053"} arXiv:hep-th/9505053
            %li#DuffLiuMinasian95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mike+Duff"}> Mike Duff
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/James+Liu"} James Liu
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ruben+Minasian"} Ruben Minasian
                = succeed "," do
                  %em Eleven Dimensional Origin of String/String Duality: A One Loop Test
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9506126"} arXiv:hep-th/9506126
            %li#Witten96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                = succeed "," do
                  %em Five-Brane Effective Action In M-Theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9610234"} arXiv:hep-th/9610234
          %p For further discussion see
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Geometric+and+topological+structures+related+to+M-branes"} Geometric and topological structures related to M-branes
                ,
              %p
                part I, Proc. Symp. Pure Math. 81 (2010), 181-236 (
                %a{:href => "http://arXiv.org/abs/1001.5020"}> arXiv:1001.5020
                ),
              %p
                part
                = succeed "," do
                  %em
                    II: Twisted
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi String
                        %annotation{:encoding => "application/x-tex"} String
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi String
                            %mi c
                        %annotation{:encoding => "application/x-tex"} String^c
                    structures
                = succeed ");" do
                  %a{:href => "http://arxiv.org/abs/1007.5419"} arXiv:1007.5419
              %p
                part
                = succeed "," do
                  %em III: Twisted higher structures
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1008.1755"} arXiv:1008.1755
          %h3#from_higher_curvature_corrections_to_11d_supergravity From higher curvature corrections to 11d Supergravity
          %p
            Derivation from classification of
            %a.existingWikiWord{:href => "/nlab/show/higher+curvature+corrections"} higher curvature corrections
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dimitrios+Tsimpis"} Dimitrios Tsimpis
                = succeed "," do
                  %em On higher-order corrections in M theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0305129"} arXiv:hep-th/0305129
            %li#SoueresTsimpis17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bertrand+Sou%C3%A8res"}> Bertrand Souères
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dimitrios+Tsimpis"} Dimitrios Tsimpis
                = succeed "," do
                  %em The action principle and the supersymmetrisation of Chern-Simons terms in eleven-dimensional supergravity
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1612.02021"} arXiv:1612.02021
          %h3#in_relation_to_the_quantum_anomaly_of_the_m5brane In relation to the quantum anomaly of the M5-brane
          %p
            In relation to the
            %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} quantum anomaly
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
          %p The original computation of the total M5-brane anomaly due to
          %ul
            %li
              %a{:href => "#Witten96"} Witten 96
          %p
            left a remnant term of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 24
                    %msub
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \tfrac{1}{24} p_2
          %ul
            %li#FreedHarveyMinasianMoore98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dan+Freed"}> Dan Freed
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jeff+Harvey"} Jeff Harvey
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ruben+Minasian"} Ruben Minasian
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"} Greg Moore
                = succeed "," do
                  %em Gravitational Anomaly Cancellation for M-Theory Fivebranes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9803205"} arXiv:hep-th/9803205
            %li#HarveyMinasianMoore98b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jeff+Harvey"}> Jeff Harvey
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ruben+Minasian"} Ruben Minasian
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"} Greg Moore
                = succeed "," do
                  %em Non-abelian Tensor-multiplet Anomalies
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9808060"} arXiv:hep-th/9808060
            %li#BilalMetzger03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Adel+Bilal"}> Adel Bilal
                , Steffen Metzger,
                = succeed "," do
                  %em Anomaly cancellation in M-theory: a critical review
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0307152"} arXiv:hep-th/0307152
          %p
            that this term disappears (cancels) when properly taking into account the singularity of the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            at the locus of the
            %a.existingWikiWord{:href => "/nlab/show/black+brane"} black
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
          %p This formulation via an anomaly 12-form is (re-)derived also in
          %ul
            %li#BahBonettiMinasianNardoni18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ibrahima+Bah"}> Ibrahima Bah
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Federico+Bonetti"} Federico Bonetti
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ruben+Minasian"} Ruben Minasian
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Emily+Nardoni"} Emily Nardoni
                = succeed "," do
                  %em
                    Class
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒮
                        %annotation{:encoding => "application/x-tex"} \mathcal{S}
                    Anomalies from M-theory Inflow
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1812.04016"} arXiv:1812.04016
            %li#BBMN19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ibrahima+Bah"}> Ibrahima Bah
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Federico+Bonetti"} Federico Bonetti
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ruben+Minasian"} Ruben Minasian
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Emily+Nardoni"} Emily Nardoni
