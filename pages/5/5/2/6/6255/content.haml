                %annotation{:encoding => "application/x-tex"} \alpha \colon S \to M
            with the property that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi τ
                  %mi α
                  %mo ,
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ∈
