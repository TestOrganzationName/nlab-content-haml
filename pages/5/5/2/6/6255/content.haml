                    %mi U
                  %annotation{:encoding => "application/x-tex"} S \to U
          %p
            The construction is set up so that the resulting map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} S \to U
            lies in a single fibre and has the property that it averages to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            (viewed in
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi p
                    %mi M
                  %annotation{:encoding => "application/x-tex"} T_{p} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} S \to U
            with those properties and an open subset of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
