          %h3#introduction Introduction
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a finite dimensional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+loop+space"} smooth loop space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi M
                    %mo ≔
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L M \coloneqq C^{\infty}(S^{1},M)
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            and is one of the simplest and most commonly encountered mapping spaces. It has many interesting submanifolds: some are defined by
            = succeed "," do
              %em coincidences
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/based+loop+space"} based loop space
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tubular+neighbourhood"} tubular neighbourhood
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tubular+neighbourhood+of+a+mapping+space"} tubular neighbourhood of a mapping space
          %p Although in the above we concentrated on the loop space, these results generalise to more general mapping spaces.
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} E \to B
              be a fibre bundle with typical fibre
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is compact, and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              has a measure such that the transition functions are measure-preserving. Consider the submanifold of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^{\infty}(E,M)
              of maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} E \to M
              which are constant on the fibres of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} E \to B
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} E \to B
          %p
            As a corollary of this,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ⊆
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} G \subseteq S^{1}
            is a compact subgroup then the fixed point set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %msup
                    %mi M
                    %mi G
                %annotation{:encoding => "application/x-tex"} L M^{G}
            is a submanifold of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mi M
                %annotation{:encoding => "application/x-tex"} L M
            with an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+tubular+neighbourhood"} equivariant tubular neighbourhood
          %p
            This theorem is itself a corollary of a more specific situation where the base consists of a single point. In this case, we consider maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} S \to M
            and look at the submanifold of constant maps. We construct a tubular neighbourhood for this that is invariant as described, and the invariance allows us to extend the result to the more general situation.
          %p
            The construction of the tubular neighbourhood depends on the existence of a
            %em local averaging
            function. This should be compared with the
            %a.existingWikiWord{:href => "/nlab/show/local+addition"} local addition
            which was needed to construct the
            %a.existingWikiWord{:href => "/nlab/show/manifold+structure+of+mapping+spaces"} manifold structure
            on the mapping space in the first place. A
            %em local addition
            is a way of saying: if two points are close, we can move one of them to the other. A
            %em local averaging
            function generalises this to a family of points indexed by some group and says that if such a family is close then we can move all of them towards each other in an equivariant fashion.
          %p
            The reason that this is needed is because we want to define what it means for a map to be close to one in the fixed point set. The simplest case is where the source is a two point set, say
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1,-1\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"}
                  \\{1,-1\} \to
                  M
            to be “close” to a constant map, but we want to say this in such a way that if we swap the labels, nothing changes.
          %h3#a_local_averaging_function A Local Averaging Function
          %p
            The crucial ingredient in this is what we call a
            = succeed "." do
              %em local averaging function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:lspace => "verythinmathspace"} :
                  %mi S
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \alpha \colon S \to M
            which is “small” in some sense, and define a single point in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            which is the “average” of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
          %p
            Let us illustrate this with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S = \{1,-1\}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha
                    \\colon \{1,-1\} \to M
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"}
                    a_{1}, a_{-1} \in
                    M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 0
                  %mo ∈
                  %mi M
                %annotation{:encoding => "application/x-tex"} a_{0} \in M
            with the property that if we swap
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a_{1}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} a_{-1}
            then we produce the same point. Once we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 0
                %annotation{:encoding => "application/x-tex"} a_{0}
            we can use a local addition (based at
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} a_{0}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a_{1}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} a_{-1}
            towards it. This will be invariant under the group action because it only depends on the points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a_{1}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} a_{-1}
            and not on the labels. Thus the key is to find
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} a_{0}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a_{1}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} a_{-1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo =
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} M = \mathbb{R}^{n}
            then there is an obvious such point:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mi a
                      %mn 1
                    %mo +
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \frac{1}{2}a_{1} + \frac{1}{2}a_{-1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            because the sum does not make sense. A local addition could solve this, except that a local addition requires a choice of point and that is precisely what we are trying to avoid.
          %p
            Our solution is to put
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            inside
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 0
                    %mo ≔
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mi a
                      %mn 1
                    %mo +
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    a_{0} \coloneqq \frac{1}{2}a_{1} +
                    \\frac{1}{2}a_{-1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 0
                %annotation{:encoding => "application/x-tex"} a_{0}
            may not lie on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 0
                %annotation{:encoding => "application/x-tex"} a_{0}
            is in a tubular neighbourhood of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} a_{0}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 0
                %annotation{:encoding => "application/x-tex"} a_{0}
            to move
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a_{1}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} a_{-1}
            together.
          %p
            There is one more subtlety. As we move
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a_{1}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} a_{-1}
            together, we want to ensure that their “average” point stays at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} a_{0}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            whilst the tubular neighbourhood uses the normal bundle of the embedding. Thus their effects should be separable. To make this concrete, we use the orthogonal structure on the ambient Euclidean space.
          %p
            Thus we start with an embedding of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            in some Euclidean space, say
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \iota \colon M \to \mathbb{R}^{n}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi p
                  %mi ι
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi T
                    %mi p
                  %mi M
                  %mo →
                  %msub
                    %mi T
                    %mrow
                      %mi ι
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  d_{p} \iota \colon
                  T_{p} M \to T_{\iota(p)} \mathbb{R}^{n}
            embeds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi p
                  %mi M
                %annotation{:encoding => "application/x-tex"} T_{p} M
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi ι
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_{\iota(p)} \mathbb{R}^{n}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n}
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+complement"} orthogonal complement
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi p
                  %mi M
                %annotation{:encoding => "application/x-tex"}
                  T_{p}
                  M
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi ι
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_{\iota(p)} \mathbb{R}^{n}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi p
                  %annotation{:encoding => "application/x-tex"} N_{p}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mi p
                %annotation{:encoding => "application/x-tex"} N_{p}
            is the fibre of the normal bundle of the embedding at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            Let us identify
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            with its image. Let us also identify
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi x
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  T_{x}
                  \\mathbb{R}^{n}
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n}
            except that we translate it so that the origin lies at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            with its image also allows us to identify
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi p
                  %mi M
                %annotation{:encoding => "application/x-tex"} T_{p} M
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mi p
                %annotation{:encoding => "application/x-tex"} N_{p}
            with their images in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi p
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_{p} \mathbb{R}^{n}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and are orthogonal (once the translation is taken into account).
          %p
            Our first task is to construct a tubular neighbourhood. From the above, we have a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                  %mo{:lspace => "verythinmathspace"} :
                  %mi N
                  %mo →
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \nu \colon N \to \mathbb{R}^{n}
            which restricts on the zero section to the inclusion of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi p
                  %mi M
                  %mo ⊕
                  %msub
                    %mi N
                    %mi p
                %annotation{:encoding => "application/x-tex"} T_{p} M \oplus N_{p}
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi p
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T_{p} \mathbb{R}^{n}
            %a.existingWikiWord{:href => "/nlab/show/inverse+function+theorem"} inverse function theorem
            comes in to play and says that there is a neighbourhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            of the zero section in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            and a neighbourhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n}
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                %annotation{:encoding => "application/x-tex"} \nu
            restricts to a diffeomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} W \to X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi W
                  %mo ⊆
                  %mi N
                %annotation{:encoding => "application/x-tex"}
                  X \to W
                  \\subseteq N
            which we can combine with the projection to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \mu \colon X \to M
            for this composition.
          %p
            This map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            is the
            %strong local averaging function
            that we need. Well, technically the local averaging function is a bit more complicated but to define it in full one needs more data. However, that data will depend on the source of our maps so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            is the data that is solely dependent on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            that goes in to the mix that defines the local averaging function and so deserves that name.
          %h3#a_compatible_local_addition A Compatible Local Addition
          %p
            The local averaging function is only half of what we need to construct a suitable tubular neighbourhood. The other half is provided by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+addition"} local addition
          %p
            Turning to the tangent spaces, for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} p \in M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi p
                  %mi M
                %annotation{:encoding => "application/x-tex"} T_{p} M
            sits as an affine subspace in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n}
            with complement
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi p
                  %annotation{:encoding => "application/x-tex"} N_{p}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %msub
                      %mi T
                      %mi p
                    %mi M
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{n}
                    \\to T_{p} M
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi p
                  %annotation{:encoding => "application/x-tex"} N_{p}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo →
                    %msub
                      %mi T
                      %mi p
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \lambda_{p} \colon M \to T_{p} M
          %p
            Note that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \lambda_{p}(p) = p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi p
                    %mi M
                  %annotation{:encoding => "application/x-tex"} T_{p} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi λ
                    %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi T
                    %mi p
                  %mi M
                  %mo →
                  %msub
                    %mi T
                    %mi p
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mi p
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi T
                    %mi p
                  %mi M
                %annotation{:encoding => "application/x-tex"}
                  d \lambda_{p} \colon T_{p} M \to T_{p}(T_{p} M) = T_{p}
                  M
            is the identity. Allowing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            to vary, we obtain a smooth map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi M
                    %mo ×
                    %mi M
                    %mo →
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \lambda \colon M \times M \to T M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ×
                  %mi M
                %annotation{:encoding => "application/x-tex"} M \times M
            as a bundle over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            (via the projection on to the first factor) then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi M
                  %mo ×
                  %mi M
                  %mo →
                  %mi T
                  %mi M
                %annotation{:encoding => "application/x-tex"} \lambda \colon M \times M \to T M
            is a bundle map.
          %p
            Now we don’t actually need this to be defined on the whole of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n}
            coming from the orthogonal structure, we choose a continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi M
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \epsilon \colon M \to (0,\infty)
            with the property that the closed ball of radius
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \epsilon(p)
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is contained in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi p
                %annotation{:encoding => "application/x-tex"} X_{p}
            for the corresponding
            %em open
            ball. Then we restrict
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \lambda_{p}
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi p
                  %mo ∩
                  %mi M
                %annotation{:encoding => "application/x-tex"} X_{p} \cap M
            and thus restrict
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            to the set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi M
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi M
                  %mo ×
                  %mi M
                  %mo :
                  %mi q
                  %mo ∈
                  %msub
                    %mi X
                    %mi p
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi M
                  %mo ×
                  %mi M
                  %mo :
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo &lt;
                  %mi ϵ
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  X_{M} \coloneqq \{(p,q) \in M \times M : q \in X_{p}\} = \{(p,q) \in M \times M : d(p,q) \lt \epsilon(p)\}
          %p which is an open neighbourhood of the diagonal.
          %p
            From the above, we see that (again by the inverse function theorem), there is a neighbourhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            of the diagonal and a neighbourhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            of the zero section such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            restricts to a diffeomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi V
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \lambda \colon V \to U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi M
                  %annotation{:encoding => "application/x-tex"} X_{M}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a subset of it.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo{:lspace => "verythinmathspace"} :
                  %mi U
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \eta \colon U \to M
            be the composition:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi M
                  %mo ⊇
                  %mi U
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi λ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                  %mi V
                  %mo ⊆
                  %mi M
                  %mo ×
                  %mi M
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"}
                  T M \supseteq
                  U \xrightarrow{\lambda^{-1}}V \subseteq M \times M \to M
          %p
            where the projection is on to the second factor. As
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            is a bundle map,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi λ
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo =
                  %mi π
                  %mo ×
                  %mi η
                %annotation{:encoding => "application/x-tex"} \lambda^{-1} = \pi \times \eta
            and thus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+addition"} local addition
          %p
            Let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi p
                    %mo =
                    %mi U
                    %mo ∩
                    %msub
                      %mi T
                      %mi p
                    %mi M
                  %annotation{:encoding => "application/x-tex"} U_{p} = U \cap T_{p} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \eta(U_{p})
            is a subset of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \{p\} \times M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi U
                    %mi p
                  %mo →
                  %msub
                    %mi V
                    %mi p
                  %mo ⊆
                  %mi M
                %annotation{:encoding => "application/x-tex"}
                  \\eta_{p} \colon U_{p} \to V_{p} \subseteq
                  M
            be the obvious restriction. Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi λ
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo =
                  %mi π
                  %mo ×
                  %mi η
                %annotation{:encoding => "application/x-tex"}
                  \\lambda^{-1} = \pi \times
                  \\eta
            and the domain of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            is a subset of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi M
                  %annotation{:encoding => "application/x-tex"} X_{M}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \eta(U_{p})
            is a subset of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi M
                    %mo ∩
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %mi M
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %msub
                      %mi X
                      %mi p
                  %annotation{:encoding => "application/x-tex"}
                    X_{M} \cap \{p\} \times M = \{p\}
                    \\times X_{p}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi p
                    %mo{:stretchy => "false"} (
                    %msub
