                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Cvx
                  %mo{:stretchy => "false"} (
                  %mi S
