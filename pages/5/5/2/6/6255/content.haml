                    %mi S
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^{\infty}(S,M)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi C
