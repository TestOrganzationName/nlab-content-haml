                  %mi α
                  %mspace{:width => "thickmathspace"}
                  %mtext is constant
                  %mo ,
                  %msub
                    %mo ∫
                    %mi S
                  %mi α
                  %mo =
                  %msub
                    %mn 0
                    %mrow
                      %mi π
                      %mi α
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^{\infty}_{0}(S,U) \coloneqq \{ \alpha \colon S \to U : \pi
                  \\alpha\; \text{is constant}, \int_{S} \alpha = 0_{\pi \alpha}\}.
          %p
            The reverse map is straightforward to describe: given a map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msubsup
                      %mi C
                      %mn 0
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in C^{\infty}_{0}(S,U)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mrow
                      %mi π
                      %mi α
                %annotation{:encoding => "application/x-tex"}
                  \\eta_{\pi
                  \\alpha}
            to produce a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} S \to M
          .num_lemma
            %h6#lemma Lemma
            %p
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mn 0
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^{\infty}_{0}(S,U) \to C^{\infty}(S,M)
              defined by composition with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is a diffeomorphism on to its image which is open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ,
                      %mi M
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^{\infty}(S,M)
          .proof
            %p
              To see that its image is open, let us first note that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Cvx
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Cvx(S,M)
              is open since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is open in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is compact. Then within that, the condition on a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \alpha \colon S \to M
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mi α
                    %mo ,
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} (\tau \alpha, \alpha(s)) \in V
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} s \in S
              is also an open condition, again because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is compact. Hence the set of smooth maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \alpha \colon S \to M
              with the property that the closed convex hull of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha(S)
              lies in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (whence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mi α
                  %annotation{:encoding => "application/x-tex"}
                    \\tau
                    \\alpha
              is defined) and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mi α
                    %mo ,
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} (\tau \alpha, \alpha(s)) \in V
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} s \in S
              is an open subset of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ,
                      %mi M
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^{\infty}(S,M)
            %p
              Let us write this as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mn 0
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    C^{\infty}_{0}(S,U) \to
                    Y
              given by composition:
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ↦
                      %msub
                        %mi η
                        %mrow
                          %mi π
                          %mi α
                      %mo ∘
                      %mi α
                    %annotation{:encoding => "application/x-tex"}
                      \\alpha \mapsto \eta_{\pi \alpha} \circ
                      \\alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %msubsup
                      %mi C
                      %mn 0
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y \to C^{\infty}_{0}(S,U)
              given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi η
                        %mrow
                          %mi τ
                          %mi β
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ∘
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \eta_{\tau \beta}^{-1} \circ \beta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi η
                      %mrow
                        %mi τ
                        %mi β
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %mi β
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_{\tau
                    \\beta}^{-1} \circ \beta
              lies in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi τ
                        %mi β
                  %annotation{:encoding => "application/x-tex"} U_{\tau \beta}
              by construction, we also have to show that its average is the zero in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mrow
                          %mi τ
                          %mi β
                      %mi M
                    %annotation{:encoding => "application/x-tex"} T_{\tau \beta} M
            %p
              This follows from the way that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mrow
                        %mi τ
                        %mi β
                  %annotation{:encoding => "application/x-tex"} \eta_{\tau \beta}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
              were constructed. Since averaging is a linear map, the average of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              splits as the sum of a point in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi τ
                        %mi β
                    %mi M
                  %annotation{:encoding => "application/x-tex"} T_{\tau \beta} M
              and a point in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mrow
                          %mi τ
                          %mi β
                      %mi M
                    %annotation{:encoding => "application/x-tex"} N_{\tau \beta} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \tau \beta
              lies in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mrow
                        %mi τ
                        %mi β
                  %annotation{:encoding => "application/x-tex"} N_{\tau \beta}
              and thus the contribution from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi τ
                        %mi β
                    %mi M
                  %annotation{:encoding => "application/x-tex"}
                    T_{\tau
                    \\beta} M
              must be the zero vector.
            %p
              To show that these are inverse, it is enough to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi η
                      %mrow
                        %mi π
                        %mi α
                    %mo ∘
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi π
                    %mi α
                  %annotation{:encoding => "application/x-tex"}
                    \\tau
                    (\eta_{\pi \alpha} \circ \alpha) = \pi \alpha
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi η
                        %mrow
                          %mi τ
                          %mi β
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ∘
                      %mi β
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi τ
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \pi(\eta_{\tau \beta}^{-1} \circ \beta) = \tau \beta
            %p
              The second is by construction:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mrow
                        %mi τ
                        %mi β
                  %annotation{:encoding => "application/x-tex"} \eta_{\tau \beta}
              has image in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %mi τ
                          %mi β
                    %annotation{:encoding => "application/x-tex"} U_{\tau \beta}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mrow
                        %mi π
                        %mi α
                    %mo ∘
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \eta_{\pi \alpha} \circ \alpha
              splits as the average of its projection to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi π
                        %mi α
                    %mi M
                  %annotation{:encoding => "application/x-tex"} T_{\pi \alpha} M
              plus the average of its projection to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mrow
                          %mi π
                          %mi α
                    %annotation{:encoding => "application/x-tex"} N_{\pi \alpha}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 0
                        %mrow
                          %mi π
                          %mi α
                    %annotation{:encoding => "application/x-tex"} 0_{\pi \alpha}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mrow
                        %mi π
                        %mi α
                    %mo ∘
                    %mi α
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_{\pi \alpha}
                    \\circ \alpha
              lies in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mrow
                        %mi π
                        %mi α
                  %annotation{:encoding => "application/x-tex"} N_{\pi \alpha}
              and hence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %msub
                        %mi η
                        %mrow
                          %mi π
                          %mi α
                      %mo ∘
                      %mi α
                      %mo =
                      %mi π
                      %mi α
                    %annotation{:encoding => "application/x-tex"}
                      \\tau \eta_{\pi
                      \\alpha} \circ \alpha = \pi \alpha
          %p
            The last step in constructing the tubular neighbourhood is to construct a diffeomorphism between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi C
                    %mn 0
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^{\infty}_{0}(S,U)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mn 0
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi T
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^{\infty}_{0}(S,T M)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            (if necessary) so that it is diffeomorphic as a fibre bundle to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} T M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \rho \colon U \to T M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi C
                    %mn 0
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi C
                    %mn 0
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi T
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^{\infty}_{0}(S,U) \to C^{\infty}_{0}(S, T M)
            via:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ↦
                  %mi ρ
                  %mo ∘
                  %mi α
                  %mo −
                  %msub
                    %mo ∫
                    %mi S
                  %mi ρ
                  %mo ∘
                  %mi α
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\alpha \mapsto \rho \circ \alpha - \int_{S} \rho \circ \alpha.
          %h3#invariance Invariance
          %p
            The above construction produces a tubular neighbourhood of the space of constant maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} S \to M
            in the space of smooth maps
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"}
                    S
                    \\to M
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a group and the measure is invariant under the group action, the tubular neighbourhood is equivariant.
          %h3#fixed_point_submanifolds Fixed Point Submanifolds
          %p
            This construction extends to the case where the source is a fibre bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} E \to B
            with fibre
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
