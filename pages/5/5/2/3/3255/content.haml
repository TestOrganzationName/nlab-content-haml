          %p
            is universal for
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            over
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %a.existingWikiWord{:href => "/nlab/show/cell+complexes"} cell complexes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi d
                %annotation{:encoding => "application/x-tex"} X^d
            (in particular: over
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+triangulations"} smooth triangulations
            %a.existingWikiWord{:href => "/nlab/show/pullback+bundles"} pullback
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi d
                  %mi G
                %annotation{:encoding => "application/x-tex"} E_d G
            identifies
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi d
                  %mo →
                  %msub
                    %mi sk
                    %mrow
                      %mi d
                      %mo +
                      %mn 1
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X^d \to sk_{d+1} B G
            with
            %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
            of
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi d
                  %annotation{:encoding => "application/x-tex"} X^d
          %p
            Beware here the required skeletal degree: On the one hand, the cellular approximation theorem gives that every isomorphism class of a
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi d
                %annotation{:encoding => "application/x-tex"} X^d
            is hit already by pullback from just the
            = succeed "-skeleton" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sk
                      %mi d
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} sk_d B G
            = succeed "-skeleton:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d+1)
            %a.existingWikiWord{:href => "/nlab/show/cylinder"} cylinder
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi d
                  %mo ×
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} X^d \times [0,1]
            on which
            %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
            of maps is defined, is
            = succeed "-skeletal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} d+1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi d
                %annotation{:encoding => "application/x-tex"} X^d
            is
            = succeed "-skeletal." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
          %p
            Such finite-dimensional
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} structure
            (instead of just a
            = succeed "-structure)" do
              %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+space"} generalized smooth space
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
            %a.existingWikiWord{:href => "/nlab/show/universal+connection"} universal connection
            for bundles over fixed bounded-dimensional base spaces. In this way these finite-dimensional universal bundles serve as a foundation for
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
            (
            %a{:href => "Chern-Weil+theory#Chern51"}> Chern 51 – p. 45 and 67
            ,
            = succeed "," do
              %a{:href => "Chern-Weil+theory#NarasimhanRamanan61"} Narasimhan-Ramanan 61
            = succeed "," do
              %a{:href => "Chern-Weil+theory#NarasimhanRamanan63"} Narasimhan-Ramanan 63
            = succeed ")." do
              %a{:href => "Chern-Weil+theory#Schlafly80"} Sclafly 80
