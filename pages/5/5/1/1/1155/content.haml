          %h2#idea Idea
          %p
            %em Combinatorial spectra
            are to
            %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            of
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            as
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            are to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
          %p
            Combinatorial spectra are
            %a.existingWikiWord{:href => "/nlab/show/graded+sets"} graded sets
            that behave like a set of
            %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
            constituting a space, but such that the simplices are not just in
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} non-negative
            degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            but in all
            %a.existingWikiWord{:href => "/nlab/show/integer"} integral
            degrees
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
          %h2#definition Definition
          %p
            A
            %strong combinatorial spectrum
            is (
            %a{:href => "#Kan63"}> Kan 63, def. 4.1
            )
          %ul
            %li
              %p
                a sequence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo =
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi E
                        %mi n
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℤ
                    %annotation{:encoding => "application/x-tex"} E = \{E_n\}_{n \in \mathbb{Z}}
                of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/pointed+set"} pointed set
            %li
              %p
                equipped for each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} i \in \mathbb{N}
                with
              %ul
                %li
                  %p
                    morphisms of
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/pointed+set"} pointed set
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi d
                            %mi i
                          %mo :
                          %msub
                            %mi E
                            %mi n
                          %mo →
                          %msub
                            %mi E
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} d_i : E_n \to E_{n-1}
                    called
                    = succeed ";" do
                      %strong face maps
                %li
                  %p
                    morphisms of
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/pointed+set"} pointed set
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi s
                            %mi i
                          %mo :
                          %msub
                            %mi E
                            %mi n
                          %mo →
                          %msub
                            %mi E
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} s_i : E_n \to E_{n+1}
                    called
                    %strong degeneracy maps
            %li
              %p such that
              %ul
                %li
                  %p
                    the usual
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial identities
                    are satisfied;
                %li
                  %p
                    each simplex has only finitely many faces different from the point of
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi E
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %annotation{:encoding => "application/x-tex"} E_{n-1}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ∈
                          %msub
                            %mi E
                            %mi n
                        %annotation{:encoding => "application/x-tex"} x \in E_n
                    there are only finitely many
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} i \in \mathbb{N}
                    for which
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi d
                            %mi i
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} d_i(x)
                    is not the point.
          %h2#examples Examples
          %p
            The standard
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplices
            have their analogs for simplicial spectra. The difference is that regarded as a spectrum the
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            %strong
              The
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            For each integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            there is a spectrum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mi k
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\Delta^{k}[n-k]
          %p
            which is
            %em generated
            from a single element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msub
                    %mi E
                    %mi n
                %annotation{:encoding => "application/x-tex"} x \in E_n
            subject to the relation that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                  %mi x
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} d_i x = *
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo &gt;
                    %mi k
                  %annotation{:encoding => "application/x-tex"} i \gt k
            = succeed "-faces," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p The sub-spectrum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\partial (\Delta^{k}[n-k])
          %p
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mi k
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta^{k}[n-k]
            generated by the faces
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                    %mi x
                  %annotation{:encoding => "application/x-tex"} d_i x
            %strong boundary
            of the
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p The spectrum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  S^n
          %p
            generated by a single simplex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msub
                    %mi E
                    %mi n
                %annotation{:encoding => "application/x-tex"} x \in E_n
            subject to the relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                  %mi x
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} d_i x = 0
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-sphere
            as a spectrum.
          %p
            The sub-spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Λ
                    %mi j
                    %mi k
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mi k
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Lambda^{k}_j[n-k]
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ≤
                  %mi j
                  %mo ≤
                  %mi k
                %annotation{:encoding => "application/x-tex"} 0 \leq j \leq k
            is the sub-spectrum of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mi k
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta^{k}[n-k]
            generated from all the faces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                  %mi x
                %annotation{:encoding => "application/x-tex"} d_i x
            except
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi j
                    %mi x
                  %annotation{:encoding => "application/x-tex"} d_j x
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %strong horn
            of the
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/horn"} horn
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
          %p
            As for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplices
            %a.existingWikiWord{:href => "/nlab/show/horn"} horn
            inclusion morphisms of combinatorial spectra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Λ
                    %mi j
                    %mi k
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo ↪
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo −
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Lambda^k_j[n-k] \hookrightarrow \Delta^k[n-k]
                  \\,.
          %p
            A condition entirely analogous to the
            %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
            condition on
            %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan simplicial sets
            leads to the notion of
            = succeed "." do
              %strong Kan combinatorial spectrum
          %h2#properties Properties
          %h3#ModelCategoryStructure Model category structure
          %p
            The category of combinatorial spectra admits a
            %a.existingWikiWord{:href => "/nlab/show/model+structure"} model structure
            (
            %a{:href => "#Brown73"}> Brown 73
            ), whose cofibrations are monomorphisms and weak equivalences are maps that induce isomorphisms on homotopy groups.
          %p Generating (acyclic) cofibrations are given by inclusions of horns respectively boundaries into stable simplices, as defined in the previous section, in complete analogy with the usual Kan-Quillen model structure on simplicial sets. (Acyclic) fibrations are maps satisfying the corresponding lifting properties.
          %p
            This is indeed a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+spectra"} model structure for spectra
            %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
            of
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalences"} Quillen equivalences
            to the
            %a.existingWikiWord{:href => "/nlab/show/Bousfield-Friedlander+model+structure"} Bousfield-Friedlander model structure
            on
            %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
            (
            %a{:href => "#BousfieldFriedlander78"}> Bousfield-Friedlander 78, section 2.5
            ). See also
            = succeed "." do
              %a{:href => "#RelationshipToOtherSpectra"} below
          %h3#smash_product Smash product
          %p
            In (
            %a{:href => "#Brown73"}> Brown 73, Appendix A
            ) is defined a
            %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
            on the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of combinatorial spectra. The main idea is to define the smash product of a stable
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo +
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (m+n)
          %p
            Whether or not it is possible to introduce a symmetric monoidal smash product on the category of combinatorial spectra obtaining a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
            that is Quillen equivalent to the monoidal model category of (say) symmetric simplicial spectra is currently an open problem.
          %h3#RelationshipToOtherSpectra Relationship to other spectra
          %p
            From the perspective of a combinatorial spectrum, an “intuitive spectrum” is supposed to be some sort of space-like object having “cells in all integer dimensions,” while a “space” (or simplicial set) has cells only in nonnegative dimensions. The traditional definitions of spectra approximate this intuition by using a
            %em sequence
            of spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi E
                    %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{E_n\}
            with maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi n
                  %mo →
                  %mi Ω
                  %msub
                    %mi E
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} E_n \to \Omega E_{n+1}
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %msub
                      %mi E
                      %mi n
                    %mo →
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma E_n \to E_{n+1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi n
                %annotation{:encoding => "application/x-tex"} E_n
            as being “shifted down by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            dimensions.” Thus, for instance, the
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-2)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} E_3
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} E_4
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %msub
                    %mi E
                    %mi n
                  %mo →
                  %msub
                    %mi E
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma E_n \to E_{n+1}
            support this intuition, since the suspension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            shifts things up by one dimension; thus it maps the
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi n
                %annotation{:encoding => "application/x-tex"} E_n
            into the
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k+1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} E_{n+1}
          %p
            In fact, this can be made precise: starting from a spectrum of simplicial sets, in the sense of a sequence of spaces with maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %msub
                      %mi E
                      %mi n
                    %mo →
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma E_n \to E_{n+1}
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theories"} homotopy theories
            between combinatorial spectra and ordinary spectra built from simplicial sets. In (
            %a{:href => "#BousfieldFriedlander78"}> Bousfield-Friedlander 78, section 2.5
            ) this is lifted to a
            %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
            of
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            between the model structure for Kan’s combinatorial spectra and the
            %a.existingWikiWord{:href => "/nlab/show/Bousfield-Friedlander+model+structure"} Bousfield-Friedlander model structure
            on
            %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
            in
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            to
          %p
            %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} I
            don’t know whether anyone has gone back to treat combiantorial from a “modern” standpoint, such as by putting a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
            structure on combinatorial spectra. They do seem less interesting and useful from a modern standpoint, because no one has ever managed to give them a
            %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            which is associative and unital on the point-set level; thus they don’t provide a good framework for talking about (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            or
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/brave+new+algebra"} brave new algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+spectrum"} symmetric spectra
          %h3#stable_doldkan_correspondence Stable Dold-Kan correspondence
          %p
            Combinatorial spectra
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            to
            %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            (
            %a{:href => "#Kan63"}> Kan 63, def. 51
            ) are
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to
            %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            (
            %a{:href => "#Kan63"}> Kan 63, prop.5.8
            ). See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/stable+Dold-Kan+correspondence"} stable Dold-Kan correspondence
            for more on this.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2CZ%29-category"} (∞,Z)-category
          %h2#references References
          %p An early reference is
          %ul
            %li#Kan63
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"}> Daniel Kan
              ,
              = succeed "," do
                %em Semisimplicial spectra
              = succeed ")" do
                %a{:href => "http://projecteuclid.org/euclid.ijm/1255644953"} Euclid
          %p
