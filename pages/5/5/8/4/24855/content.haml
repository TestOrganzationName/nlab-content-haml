                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x) =_{B} f(y)
          %h3#function_extensionality Function extensionality
          %p
            The extensionality principle for
            %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
            (
            %a.existingWikiWord{:href => "/nlab/show/function+extensionality"}> function extensionality
            ) states that for all functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:A \to B
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} g:A \to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %msub
                    %mo =
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                  %mi g
                %annotation{:encoding => "application/x-tex"} f =_{A \to B} g
            if and only if for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a:A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} b:A
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %msub
                      %mo =
                      %mi A
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a =_A b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi B
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(a) =_{B} g(b)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                  %mo .
                  %mo ∀
                  %mi g
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                  %mo .
                  %mi f
                  %msub
                    %mo =
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                  %mi g
                  %mo ⇔
                  %mo ∀
                  %mi a
                  %mo :
                  %mi A
                  %mo .
                  %mo ∀
                  %mi b
                  %mo :
                  %mi A
                  %mo .
                  %mi a
                  %msub
                    %mo =
                    %mi A
                  %mi b
                  %mo ⇒
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi B
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall f:A \to B.\forall g:A \to B.f =_{A \to B} g \iff \forall a:A. \forall b:A.a =_A b \implies (f(a) =_{B} g(b))
          %h2#in_constructive_and_classical_mathematics In constructive and classical mathematics
          %p
            Constructive mathematics is mathematics in which the law of excluded middle does not necessarily hold for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/propositions"} propositions
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subsingletons"} subsingletons
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-propositions"} h-propositions
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/propositions"} propositions
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subsingletons"} subsingletons
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-propositions"} h-propositions
          %p
            In classical mathematics, propositional equality of sets is a
            %a.existingWikiWord{:href => "/nlab/show/stable+relation"} stable
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            %a.existingWikiWord{:href => "/nlab/show/denial+inequality"} denial inequality
            of sets is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} tight apartness relation
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inequality"} inequality
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relations"}> tight apartness relations
                \. However, not all sets have tight apartness relations.
            %li
              %p
                propositional equality, which is an
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relations"} tight apartness relations
                have
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/stable+equality"} stable equality
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/denial+inequality"}> denial inequality
                , which can only be proven to be a
                %a.existingWikiWord{:href => "/nlab/show/weakly+tight"} weakly tight
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/irreflexive+symmetric+relation"} irreflexive symmetric relation
                %a.existingWikiWord{:href => "/nlab/show/double+negation+translation"} double negation translation
                and the property that for any proposition
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo ¬
                      %mo ¬
                      %mi P
                    %annotation{:encoding => "application/x-tex"} \neg \neg \neg P
                if and only if
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ¬
                        %mi P
                      %annotation{:encoding => "application/x-tex"} \neg P
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/double+negation"} double negation
                of propositional equality, which can only be proven to be a
                %a.existingWikiWord{:href => "/nlab/show/stable+relation"} stable
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/reflexive+symmetric+relation"} reflexive symmetric relation
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/double+negation+translation"} double negation translation
          %p
            The sets in which propositional equality and inequality behaves as it does in
            %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            are the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+sets"} classical sets
            %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apartness relation
            such that every pair of elements are either equal or apart from each other.
          %p
            As a result, in constructive mathematics, sometimes one takes sets with
            %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relations"} tight apartness relations
            instead of general
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            to be the foundational primitive concept. In classical mathematics, this is unnecessary, because every
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            has a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} tight apartness relation
          %h2#InDependentTypeTheory In dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %em propositional equality
            is used to describe a notion of
            %a.existingWikiWord{:href => "/nlab/show/equality"} equality
            %a.existingWikiWord{:href => "/nlab/show/type"} type
            different from that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
          %p
            More specifically, there are two interpretations of
            %a.existingWikiWord{:href => "/nlab/show/propositions"} propositions
            and
            %a.existingWikiWord{:href => "/nlab/show/logic"} logic
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/propositions+as+types"} propositions as types
                interpretation, which says that all types are propositions. The term
                %strong propositional equality
                is used as a synonym of typal equality in referring to
                %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
                or
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/propositions+as+some+types"} propositions as some types
                interpretation, which says that only the
                %a.existingWikiWord{:href => "/nlab/show/subsingletons"} subsingletons
                or
                %a.existingWikiWord{:href => "/nlab/show/h-propositions"} h-propositions
                are propositions. The term
                %strong propositional equality
                in this interpretation is not a synonym of typal equality and only refers to the
                %a.existingWikiWord{:href => "/nlab/show/contractible+type"} unique
                %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
                or the
                %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
                valued
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
          %p
            However, in any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set-level+type+theory"} set-level type theory
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+set+truncation"} axiom of set truncation
            implies that all identity types are valued in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-propositions"} h-propositions
          %p
            Most homotopy type theorists use the
            %a.existingWikiWord{:href => "/nlab/show/propositions+as+types"} propositions as types
            interpretation of
            %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositional equality
            as a synonym of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/typal+equality"} typal equality
            %a.existingWikiWord{:href => "/nlab/show/propositions+as+some+types"} propositions as some types
            interpretation for everything else.
            %a.existingWikiWord{:href => "/nlab/show/Kevin+Buzzard"} Kevin Buzzard
            in
            %a{:href => "#Buzzard24"} Buzzard 2024
            has used this fact and how that contradicts the interpretation of
            %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositional equality
            elsewhere in mathematics as an argument for adopting a
            %a.existingWikiWord{:href => "/nlab/show/set-level+type+theory"} set-level type theory
            instead of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %p
            By Buzzard’s argument, homotopy type theorists should not be using the term “equality” to refer to arbitrary identifications or identity types, whether in its bare form or as “
            %a.existingWikiWord{:href => "/nlab/show/propositional+equality"}> propositional equality
            ” or “
            %a.existingWikiWord{:href => "/nlab/show/typal+equality"}> typal equality
            ”, instead restricting the use of equality /
            %a.existingWikiWord{:href => "/nlab/show/propositional+equality"} propositional equality
            for only the
            %a.existingWikiWord{:href => "/nlab/show/contractible+type"} unique
            %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
            and the
            %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
            valued
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/typal+equality"} typal equality
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/identification"} identification
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/identified"} identified
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
          %h3#relation_to_unique_identifications Relation to unique identifications
          %p
            Indeed, since a
            %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
            is equivalently a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pointed+proposition"} pointed proposition
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isContr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi{:mathvariant => "normal"} isProp
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isContr}(\mathrm{Id}_A(x, y)) \simeq \mathrm{Id}_A(x, y) \times \mathrm{isProp}(\mathrm{Id}_A(x, y))
          %p
            We say that two elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            are
          %ul
            %li
              %p
                %strong propositionally equal
                if the identity type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Id}_A(x, y)
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/pointed+proposition"} pointed proposition
            %li
              %p
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/uniquely"} uniquely
                  %a.existingWikiWord{:href => "/nlab/show/identified"} identified
                if the identity type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Id}_A(x, y)
                is a
                %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
                in the usual sense.
          %p Expanding out the definitions,
          %ul
            %li
              %p
                a witness of propositional equality consists of an
                %a.existingWikiWord{:href => "/nlab/show/identification"} identification
                and a family of
                %a.existingWikiWord{:href => "/nlab/show/contractions"} contractions
                showing that every identification is a
                %a.existingWikiWord{:href => "/nlab/show/center+of+contraction"} center of contraction
                of the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            %li
              %p
                a witness of unique identification consists of an
                %a.existingWikiWord{:href => "/nlab/show/identification"} identification
                and a
                %a.existingWikiWord{:href => "/nlab/show/contraction"} contraction
                showing that the identification is the
                %a.existingWikiWord{:href => "/nlab/show/center+of+contraction"} center of contraction
                of the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
          %p
            The type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isContr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isContr}(\mathrm{Id}_A(x, y))
            is always a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/binary+relation"} binary relation
            %a.existingWikiWord{:href => "/nlab/show/isContr"} isContr
            is always a
            %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            are unique (i.e. there is a function
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Id
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi{:mathvariant => "normal"} isContr
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} Id
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Id}_A(x, y) \to \mathrm{isContr}(\mathrm{Id}_A(x, y))
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi y
                %annotation{:encoding => "application/x-tex"} x = y
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} isContr
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} Id
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{isContr}(\mathrm{Id}_A(x, y))
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/h-set"} h-set
            is then precisely a type where all identifications are unique, and the
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            can then be represented by a propositional analogue of
            %a.existingWikiWord{:href => "/nlab/show/equality+reflection"} equality reflection
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/extensional+type+theory"} extensional type theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} UIP
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi x
                      %mo =
                      %mi y
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash p:\mathrm{Id}_A(x, y)}{\Gamma \vdash \mathrm{UIP}(p):x = y}
          %p making typal equality and propositional equality synonyms of each other again, because then all identity types are propositions and all identifications are unique.
          %p
            Propositional equality defined in this manner is similar to the
            %a.existingWikiWord{:href => "/nlab/show/preset"} preset
            and
            %a.existingWikiWord{:href => "/nlab/show/setoid"} setoid
            approaches to foundations of mathematics.
          %p
            Propositional equality satisfies the
            %a.existingWikiWord{:href => "/nlab/show/principle+of+substitution"} principle of substitution
            by
            %a.existingWikiWord{:href => "/nlab/show/transport"} transport
            of the unique identification across
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/predicates"} predicates
            %a.existingWikiWord{:href => "/nlab/show/identity+of+indiscernibles"} identity of indiscernibles
            because propositional equality is always a proposition, and so we have:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %mi{:mathvariant => "normal"} isContr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo →
                      %mi{:mathvariant => "normal"} Prop
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{x:A} \prod_{y:A} \mathrm{isContr}(\mathrm{Id}_A(x, y)) \simeq \prod_{x:A \to \mathrm{Prop}} P(x) \simeq P(y)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/identity+of+indiscernibles"} identity of indiscernibles
            doesn’t work for arbitrary identity types of a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            because the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo →
                      %mi{:mathvariant => "normal"} Prop
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{x:A \to \mathrm{Prop}} P(x) \simeq P(y)
            on the right hand side of the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            is always a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is an
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/h-set"} h-set
          %p
            However, propositional equality defined in this manner is not an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            because it is not a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexive relation
            %a.existingWikiWord{:href => "/nlab/show/loop+space+type"} loop space type
            which is not a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isContr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isContr}(\mathrm{Id}_A(x, x))
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/h-sets"} h-sets
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/presets"} presets
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of a type, given by the
            %a.existingWikiWord{:href => "/nlab/show/subtype"} subtype
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi{:mathvariant => "normal"} isContr
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} Id
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{x:A} \mathrm{isContr}(\mathrm{Id}_A(x, x))
          %p
            Furthermore, the type-theoretic functions are
            %a.existingWikiWord{:href => "/nlab/show/prefunctions"} prefunctions
            with respect to propositional equality. While functions do preserve identifications, they do not preserve propositional equality in the sense of the uniqueness of identifications.
            %em Any
            %a.existingWikiWord{:href => "/nlab/show/identification"} identification
            is given by a function out of the
            %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕀
                  %annotation{:encoding => "application/x-tex"} \mathbb{I}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} Id
                    %mi 𝕀
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p:\mathrm{Id}_\mathbb{I}(0, 1)
            in the interval type is unique in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Id
                      %mi 𝕀
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Id}_\mathbb{I}(0, 1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            %a.existingWikiWord{:href => "/nlab/show/extensional+function"} extensional function
            as one that does preserve the uniqueness of identifications, and prove that functions between
            %a.existingWikiWord{:href => "/nlab/show/h-sets"} h-sets
            preserve the uniqueness of identifications, and that h-sets are precisely the types between which all functions preserve uniqueness of identifications. To say that all functions are extensional along the lines of the
            %a.existingWikiWord{:href => "/nlab/show/preset"} preset
            approach to
            %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            is equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            that implies that all types are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-sets"} h-sets
          %h3#in_logic_over_dependent_type_theory In logic over dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/logic+over+dependent+type+theory"} logic over dependent type theory
            %em propositional equality
          %ul
            %li
              %p
                the usual internal notion of
                %em propositional equality
                of
                %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
                as an
                %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
                or a
                %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
                valued
                %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            %li
              %p
                the external notion of
                = succeed "," do
                  %em propositional equality
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %msub
                          %mo =
                          %mi A
                        %mi b
                        %mi{:mathvariant => "normal"} prop
                      %annotation{:encoding => "application/x-tex"} a =_A b \mathrm{prop}
          %p
            External propositional equality is used as an alternative of
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
            for
            %a.existingWikiWord{:href => "/nlab/show/definitional+equality"} definitional equality
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/logic+over+dependent+type+theory"} logic over dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/computation+rules"} computation rules
            and
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+rules"} uniqueness rules
            of types:
          %ul
            %li Computation rules for dependent product types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo :
                      %mi A
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi λ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo :
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo .
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma, x:A \vdash b(x):B(x) \quad \Gamma \vdash a:A}{\Gamma \vdash \lambda(x:A).b(x)(a) =_{B(a)} b(a) \; \mathrm{true}}
          %ul
            %li Uniqueness rules for dependent product types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi f
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi f
                      %msub
                        %mo =
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi x
                              %mo :
                              %mi A
                          %mi B
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mi λ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo .
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash f:\prod_{x:A} B(x)}{\Gamma \vdash f =_{\prod_{x:A} B(x)} \lambda(x).f(x) \; \mathrm{true}}
          %ul
            %li Computation rules for negative dependent sum types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo :
                      %mi A
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi A
                      %mi a
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
