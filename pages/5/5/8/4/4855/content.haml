                %annotation{:encoding => "application/x-tex"} (Paths X)(T) = Hom_C(I^{\vee n},X)
            to ….
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
