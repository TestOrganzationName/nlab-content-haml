          %p On the other hand the inner face map from
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 2
                  %mo =
                  %mrow
                    %mo [
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                        %mtr
