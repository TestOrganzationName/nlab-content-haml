                %annotation{:encoding => "application/x-tex"} h : [0,2] \to [0,3]
            that is multiplication by two on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
