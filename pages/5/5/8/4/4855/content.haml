          %p
            Now for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} X \in C
            any object, we obtain the planar
            %a.existingWikiWord{:href => "/nlab/show/dendroidal+set"} dendroidal set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Paths
                  %mi X
                  %mo :
                  %mi T
                  %mo ↦
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Ω
                    %mi C
                    %mi p
                  %mo{:stretchy => "false"} [
                  %mi T
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Paths X : T \mapsto Hom_C( \Omega^p_C[T], X )
                  \\,.
          %p
            It assigns to any tree with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            leaves the hom-set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi I
                      %mrow
                        %mo ∨
                        %mi n
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(I^{\vee n},X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
