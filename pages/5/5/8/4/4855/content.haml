          %h2#idea Idea
          %p
            In analogy to how a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            has a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            %a.existingWikiWord{:href => "/nlab/show/directed+space"} directed space
            has a fundamental
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
          %h2#definition Definition
          %h3#directed_topological_spaces Directed topological spaces
          .un_defn
            %h6#definition_2 Definition
            %p
              By a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/directed+space"} directed topological space
              we here mean specifically a pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,D)
              consisting of
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  a subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo ⊂
                        %msup
                          %mi X
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} D \subset X^{[0,1]}
                  of
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo :
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \gamma : [0,1] \to X
                  that are are labeled as being
                  %em directed
                  ,
              %li
                %p such that
                %ul
                  %li
                    %p
                      for every orientation preserving
                      %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi ϕ
                            %mo :
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo →
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %annotation{:encoding => "application/x-tex"} \phi : [0,1] \to [0,1]
                      and every directed map
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi γ
                          %annotation{:encoding => "application/x-tex"} \gamma
                      also
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi γ
                            %mo ∘
                            %mi ϕ
                          %annotation{:encoding => "application/x-tex"} \gamma \circ \phi
                      is directed;
                  %li
                    %p
                      for any two directed paths
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi γ
                              %mn 1
                            %mo ,
                            %msub
                              %mi γ
                              %mn 2
                          %annotation{:encoding => "application/x-tex"} \gamma_1, \gamma_2
                      with
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi γ
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo =
                            %msub
                              %mi γ
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \gamma_1(1) = \gamma_2(0)
                      also the concatenation
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mover
                              %mo →
                              %mrow
                                %mo ×
                                %mn 2
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 2
                            %mo{:stretchy => "false"} ]
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mo *
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi γ
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi γ
                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mi X
                          %annotation{:encoding => "application/x-tex"}
                            [0,1] \stackrel{\times 2}{\to} [0,2]
                            \\simeq [0,1] \coprod_{*} [0,1]
                            \\stackrel{(\gamma_1, \gamma_2)}{\to}
                            X
                    %p is a directed path.
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi D
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi D
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_1,D_1) \to (X_2, D_2)
              of directed spaces is a continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X_1 \to X_2
              that takes elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} D_1
              to elements in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} D_2
            %p
              This defines the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi DTop
                  %annotation{:encoding => "application/x-tex"} DTop
              of directed topological spaces.
          .un_example
            %h6#example Example
            %p
              %strong (topological poset)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a topological space equipped with the structure of a
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              on its underlying set, say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \gamma : [0,1] \to X
              is directed if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≤
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \leq y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma(x) \leq \gamma(y)
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .un_example
            %h6#example_2 Example
            %p#DirectedSimplex
              %strong (directed geometric simplex)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Delta^k_{Top}
              the standard topological
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              its
              %em standard directed paths
              are order-preserving maps into its 1-
              %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} skeleton
              (the union of the 1-faces equipped with the evident
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/poset"} poset
          .un_example
            %h6#example_3 Example
            %p
              %strong (directed geometric realization)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              its
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi C
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |C|
              becomes a directed topological space by taking the directed paths to be all maps that factor through its 1-
              %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"}> skeleton
              \:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msub
                          %mi Δ
                          %mrow
                            %mo ≤
                            %mn 1
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi k
                    %mo ×
                    %msub
                      %mi C
                      %mi k
                    %mo ↪
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi k
                    %mo ×
                    %msub
                      %mi C
                      %mi k
                    %mo =
                    %mo{:stretchy => "false"} |
                    %mi C
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"}
                    \\int^{[k] \in \Delta_{\leq 1}} \Delta^k_{Top} \times C_k
                    \\hookrightarrow
                    \\int^{[k] \in \Delta}
                    \\Delta^k_{Top} \times C_k
                    \=
                    |C|
            %p while preserving the canonical order and so that the endpoints land on vertices.
          %p
            The previous example of the directed topological simplex is the special case of this for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} C = \Delta[k]
          %h3#fundamental_category
            Fundamental
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .un_def
            %h6#definition_3 Definition
            %p
              The
              %strong
                fundamental
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
              of a directed topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,D)
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X,D)
              whose
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi k
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma : \Delta^k_{Top} \to X
            %p
              that are morphisms of directed spaces with respect to the
              %a{:href => "#DirectedSimplex"} standard directed paths
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \Delta^k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi D
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mo :
                    %mo =
                    %msub
                      %mi Hom
                      %mi DTop
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi k
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi(X,D)_k := Hom_{DTop}(\Delta^k_{Top}, (X,D))
                    \\,.
          .un_lemma
            %h6#lemma Lemma
            %p This does indeed define a quasi-category
          .proof
            %h6#proof Proof
            %p
              Use the standard
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi k
                    %mo →
                    %msubsup
                      %mi Λ
                      %mi i
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Delta^k_{Top} \to \Lambda^k_i
              of the topological
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Λ
                      %mi i
                      %mi k
                    %mo ↪
                    %msup
                      %mi Δ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Lambda^k_i \hookrightarrow \Delta^k
              to fill horns in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi(X,D)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} k \geq 3
              these retracts are the identity on 1-faces, hence trivially preserve the directed paths. For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} k = 2
              it is precisely the retract of the
              %em inner
              horn
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Λ
                      %mn 1
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \Lambda^2_1
              that preserves the directed paths. This is sufficient to satisfy the inner horn filler condition of quasi-categories.
          %h2#properties Properties
          .un_lemma
            %h6#observation Observation
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is undirected in that
              %em all
              paths are labeled as directed –
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} D = X^{[0,1]}
              – then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X,D)
              coincides with the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X)
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %h2#fundamental_categories_induced_from_intervals
            Fundamental
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            The interest in interval objects is that various further structures of interest may be built up from them. In particular, since picking an interval object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is like picking a notion of
            = succeed "," do
              %em path
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            an
            %a.existingWikiWord{:href => "/nlab/show/infinity-category"} infinity-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi I
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_I(X)
            – the fundamental
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            – whose
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-paths" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p There are different ways to make this precise and realize it in detail. The main distinction is whether one uses
          %ul
            %li
              an
              %a.existingWikiWord{:href => "/nlab/show/algebraic+definition+of+higher+category"} algebraic definition of higher category
          %p or
          %ul
            %li
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+definition+of+higher+category"} geometric definition of higher category
          %p
            We describe an algebraic version in terms of
            %a.existingWikiWord{:href => "/nlab/show/Trimble+n-category"} Trimble omega-categories
            and then a geometric version in terms of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/cubical+object"} cubical object
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
          %h3#fundamental_algebraic_categories
            Fundamental algebraic
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            The collection of objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mrow
                    %mi pt
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %msup
                    %mi I
                    %mrow
                      %mo ∨
                      %mi n
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi pt
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                %annotation{:encoding => "application/x-tex"} \{ {}_{pt}[I, I^{\vee n}]_{pt}\}_{n \in \mathbb{N}}
            in a category with interval object naturally comes equipped with the structure of an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/operad"} operad
            %a.existingWikiWord{:href => "/nlab/show/endomorphism+operad"} endomorphism operad
            on the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            in the symmetric closed monoidal category of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/bi-pointed+object"} bi-pointed object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pt
                %annotation{:encoding => "application/x-tex"} pt
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pt
                  %annotation{:encoding => "application/x-tex"} pt
          %p
            This induces in turn for all objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi V
                %annotation{:encoding => "application/x-tex"} X \in V
            on the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [I,X]
            the structure of an operad, which is naturally interpreted as an internal
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            %a.existingWikiWord{:href => "/nlab/show/A-infinity-category"} category
            structure on
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 0
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi pt
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ←
                    %mrow
                      %mi s
                      %mo :
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi σ
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %mi t
                      %mo :
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi τ
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 0
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi pt
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (X_0 := [pt,X])
                  \\stackrel{s := [\sigma,X]}{\leftarrow}
                  [I,X]
                  \\stackrel{t := [\tau, X]}{\to} (X_0 := [pt,X])
                  \\,.
          %p
            This internal
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Pi_1(X)
          %p
            and interpreted as the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            or rather, in general, the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+category"} fundamental category
            of the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            with respect to the interval object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            – all internal to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            Moreover, by iterating this process as described at
            %a.existingWikiWord{:href => "/nlab/show/Trimble+n-category"} Trimble n-category
            one should obtain, if everything goes through, on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            the structure of a
            %a.existingWikiWord{:href => "/nlab/show/Trimble+n-category"} Trimble
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %a.existingWikiWord{:href => "/nlab/show/infinity-category"} category
            and indeed a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi ω
                  %mo :
                  %msub
                    %mi V
                    %mn 0
                  %mo →
                  %mi Trimble
                  %mi ω
                  %mi Cat
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Pi_\omega : V_0 \to Trimble \omega Cat
                  \\,.
          %p (… to be continued …)
          .un_remark
            %h6#remarks Remarks
            %ul
              %li
                %p
                  The condition that all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                          %mi pt
                        %mo{:stretchy => "false"} [
                        %mi I
                        %mo ,
                        %msup
                          %mi I
                          %mrow
                            %mo ∨
                            %mi n
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi pt
                      %annotation{:encoding => "application/x-tex"} {}_{pt}[I, I^{\vee n}]_{pt}
                  are contractible is the
                  %em coherence condition
                  on all composition operations.
              %li
                %p
                  The above is
                  %em not
                  demanding that the interval object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  itself is is weakly equivalent to the point. If it is, then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Pi_1(X)
                  is indeed a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Pi_1(X)
                  may just be a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/fundamental+category"} fundamental category
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} X_0
                  has a notion of
                  %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
                  one may consider imposing the condition that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi I
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [I,X]
                  is a path object of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} V_0
                  has a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/cylinder+functor"} cylinder functor
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ⊗
                          %mi I
                        %annotation{:encoding => "application/x-tex"} -\otimes I
          %h3#FundGeomInftCat
            Fundamental geometric
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a category with finite
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mover
                      %mo →
                      %mn 0
                    %mi I
                    %mover
                      %mo ←
                      %mn 1
                    %mo *
                  %annotation{:encoding => "application/x-tex"} {*} \stackrel{0}{\to} I \stackrel{1}{\leftarrow} {*}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} {*}
            denotes the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          %p This may or may not come with further structures and properties as discussed in the definitions above. For the following however no more than that is neceesray.
          %p
            Recall that the
            %strong cube category
            is the initial strict
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mo ⊗
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M, \otimes, I)
            equipped with an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi int
                %annotation{:encoding => "application/x-tex"} int
            together with two maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mn 0
                  %mo ,
                  %msub
                    %mi i
                    %mn 1
                  %mo :
                  %mi I
                  %mo →
                  %mi int
                %annotation{:encoding => "application/x-tex"} i_0, i_1: I \to int
            and a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi int
                  %mo →
                  %mi I
                %annotation{:encoding => "application/x-tex"} p: int \to I
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %msub
                      %mi i
                      %mn 0
                    %mo =
                    %msub
                      %mn 1
                      %mi I
                    %mo =
                    %mi p
                    %msub
                      %mi i
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p i_0 = 1_I = p i_1
          %p
            In a tautological way,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            induces a
            %a.existingWikiWord{:href => "/nlab/show/cocubical+object"} cocubical object
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo □
                    %mi I
                  %mo :
                  %mo □
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\Box_I : \Box \to C
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/cube+category"} cube category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo □
                %annotation{:encoding => "application/x-tex"} \Box
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi int
                %annotation{:encoding => "application/x-tex"} int
            that the
            %a.existingWikiWord{:href => "/nlab/show/cube+category"} cube category
            is freely generated from to the given
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi int
                    %mrow
                      %mo ⊗
                      %mi n
                %annotation{:encoding => "application/x-tex"} int^{\otimes n}
            to the
            = succeed "-cuber" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo □
                      %mi I
                      %mi n
                    %mo :
                    %mo =
                    %msup
                      %mi I
                      %mrow
                        %mo ×
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \Box_I^n := I^{\times n}
          %p
            For every object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} X \in C
            homming cubes into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            thereby produces a
            %a.existingWikiWord{:href => "/nlab/show/cubical+set"} cubical set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %msubsup
                        %mo □
                        %mi I
                        %mo •
                  %mo :
                  %msup
                    %mi int
                    %mi n
                  %mo ↦
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mo □
                    %mi I
                    %mi n
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X^{\Box^\bullet_I} : int^n \mapsto C(\Box_I^n,X)
                  \\,.
          %p
            One tends to want to regard this as the cubical incarnation of the fundamental
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with respect to the notion of path given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          %p
            However, while cubes are nice for many purposes, it is a sad fact of life that the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            for cubical structures (while certainly it does exist in full beauty in principle) is much less well developed to date (maybe that will change in the future) than that of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial
            structures. For many purposes in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo □
                  %annotation{:encoding => "application/x-tex"} X^{\Box}
          %p
            In fact, there is also naturally the structure of a
            %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
            of the collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi I
                    %mo ×
                  %mo •
                %annotation{:encoding => "application/x-tex"} I^\times \bullet
            of
            = succeed "-cubes." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi I
                    %mrow
                      %mo ×
                      %mi n
                %annotation{:encoding => "application/x-tex"} I^{\times n}
          .un_defn
            %h6#definition_cosimplicial_object_induced_from_interval_object Definition (cosimplicial object induced from interval object)
            %p
              Given a cartesian interval object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} I \in C
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi I
                    %mo :
                    %mi Δ
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_I : \Delta \to C
            %p as follows:
            %ul
              %li
                %p
                  the object in degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  is the
                  = succeed "-fold" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  with itself:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi I
                          %mi n
                        %mo :
                        %mo =
                        %msup
                          %mi I
                          %mrow
                            %mo ×
                            %mi n
                      %annotation{:encoding => "application/x-tex"}
                        \\Delta_I^n := I^{\times n}
              %li
                %p
                  the degeneracy map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mi i
                        %mo :
                        %msubsup
                          %mi Δ
                          %mi I
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo →
                        %msubsup
                          %mi Δ
                          %mi I
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \sigma_i : \Delta_I^{n+1} \to \Delta_I^n
                  is given by projecting out the
                  = succeed "-factor:" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (i+1)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mi i
                        %mo :
                        %mo =
                        %msub
                          %mi p
                          %mn 1
                        %mo ×
                        %msub
                          %mi p
                          %mn 2
                        %mo ×
                        %mi ⋯
                        %mo ×
                        %msub
                          %mi p
                          %mi i
                        %mo ×
                        %msub
                          %mi p
                          %mrow
                            %mi i
                            %mo +
                            %mn 2
                        %mo ×
                        %msub
                          %mi p
                          %mrow
                            %mi i
                            %mo +
                            %mn 3
                        %mo ×
                        %mi ⋯
                        %mo ×
                        %msub
                          %mi p
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        \\sigma_i := p_1 \times p_2 \times \cdots \times p_i \times p_{i+2} \times p_{i+3}
                        \\times \cdots \times p_{n+1}
              %li
                %p
                  the face map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi δ
                          %mi i
                        %mo :
                        %msubsup
                          %mi Δ
                          %mi I
                          %mi n
                        %mo →
                        %msubsup
                          %mi Δ
                          %mi I
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \delta_i : \Delta_I^{n} \to \Delta_I^{n+1}
                  is given
                %ul
                  %li
                    %p
                      for
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi i
                            %mo =
                            %mi n
                            %mo +
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} i = n+1
                      by inserting
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 0
                          %annotation{:encoding => "application/x-tex"} 0
                      in the
                      = succeed "-factor:" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} (n+1)
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi δ
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo :
                            %mo =
                            %msub
                              %mi p
                              %mn 1
                            %mo ×
                            %mi ⋯
                            %mo ×
                            %msub
                              %mi p
                              %mi n
                            %mo ×
                            %mn 0
                          %annotation{:encoding => "application/x-tex"}
                            \\delta_{n+1} := p_1 \times \cdots \times p_{n} \times 0
                  %li
                    %p
                      for
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi i
                            %mo =
                            %mn 0
                          %annotation{:encoding => "application/x-tex"} i = 0
                      by inserting
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} 1
                      in the
                      = succeed "-factor:" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mn 0
                            %annotation{:encoding => "application/x-tex"} 0
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi δ
                              %mn 0
                            %mo =
                            %mn 1
                            %mo ×
                            %msub
                              %mi p
                              %mn 1
                            %mo ×
                            %mi ⋯
                            %mo ×
                            %msub
                              %mi p
                              %mn 2
                          %annotation{:encoding => "application/x-tex"}
                            \\delta_0 = 1 \times p_1 \times \cdots \times p_2
                  %li
                    %p
                      for
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 0
                            %mo &lt;
                            %mi i
                            %mo &lt;
                            %mi n
                            %mo +
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} 0 \lt i \lt n+1
                      by duplicating the
                      = succeed "-factor:" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi i
                            %annotation{:encoding => "application/x-tex"} i
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi δ
                              %mi i
                            %mo :
                            %mo =
                            %msub
                              %mi p
                              %mn 1
                            %mo ×
                            %mi ⋯
                            %msub
                              %mo ×
                              %mrow
                                %msub
                                  %mi p
                                  %mrow
                                    %mi i
                                    %mo −
                                    %mn 1
                            %mo ×
                            %msub
                              %mi p
                              %mi i
                            %mo ×
                            %msub
                              %mi p
                              %mi i
                            %mo ×
                            %msub
                              %mi p
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                            %mo ×
                            %mi ⋯
                            %mo ×
                            %msub
                              %mi p
                              %mi n
                          %annotation{:encoding => "application/x-tex"}
                            \\delta_i := p_1 \times \cdots \times_{p_{i-1}}
                            \\times p_i \times p_i \times p_{i+1} \times \cdots \times p_n
          .un_prop
            %h6#proposition Proposition
            %p
              The maps defined this way indeed satisfy the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
          .proof
            %h6#proof_2 Proof
            %p This is straightforward to check, if a little tedious due to the many case distinctions.
          .un_remark
            %h6#remark_unwrapping_the_definition Remark (unwrapping the definition)
            %p It may be helpful to unpack the above definition a bit.
            %ul
              %li
                %p
                  The two faces of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi I
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \Delta_I^1
                  are just the “boundary points” of the interval itself.
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi δ
                              %mn 0
                            %mo :
                            %mo *
                            %mo →
                            %mi I
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo :
                            %mo *
                            %mo →
                            %mi I
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\delta_0 : {*} \to I) = (1 : {*} \to I)
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi δ
                              %mn 1
                            %mo :
                            %mo *
                            %mo →
                            %mi I
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo :
                            %mo *
                            %mo →
                            %mi I
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\delta_1 : {*} \to I) = (0 : {*} \to I)
              %li
                %p
                  The face maps of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi I
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \Delta^2_I
                  may be depicted as follows:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi δ
                          %mn 2
                        %mo :
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi I
                              %mtd
                                %mo ×
                              %mtd
                                %mi I
                            %mtr
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↑
                                  %mi Id
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↑
                                  %mn 0
                            %mtr
                              %mtd
                                %mi I
                              %mtd
                                %mo ×
                              %mtd
                                %mo *
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi δ
                          %mn 1
                        %mo :
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi I
                              %mtd
                                %mo ×
                              %mtd
                                %mi I
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↑
                                  %mrow
                                    %mi Id
                                    %mo ×
                                    %mi Id
                            %mtr
                              %mtd
                              %mtd
                                %mi I
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi δ
                          %mn 0
                        %mo :
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi I
                              %mtd
                                %mo ×
                              %mtd
                                %mi I
                            %mtr
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↑
                                  %mn 1
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↑
                                  %mi Id
                            %mtr
                              %mtd
                                %mo *
                              %mtd
                                %mo ×
                              %mtd
                                %mi I
                      %annotation{:encoding => "application/x-tex"}
                        \\delta_2 :
                        \\array{
                        I &amp;\times&amp; I
                        \\\
                        \\uparrow^{Id} &amp;&amp; \uparrow^{0}
                        \\\
                        I &amp;\times&amp; {*}
                        }
                        \\,,
                        \\;\;\;\;\;
                        \\delta_1 :
                        \\array{
                        I &amp;\times&amp; I
                        \\\
                        \&amp; \uparrow^{Id \times Id}
                        \\\
                        \&amp; I
                        }
                        \\,,
                        \\;\;\;\;\;
                        \\delta_0 :
                        \\array{
                        I &amp;\times&amp; I
                        \\\
                        \\uparrow^{1} &amp;&amp; \uparrow^{Id}
                        \\\
                        {*} &amp;\times&amp; I
                        }
                %p
                  Therefore
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi δ
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \delta_1
                  %a.existingWikiWord{:href => "/nlab/show/pairing"} pairing
                  of an
                  %a.existingWikiWord{:href => "/nlab/show/identity"} identity
                  with itself), literally identifies the
                  %strong diagonal
                  in the “square”
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                        %mo ×
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I \times I
                  as the 1st 1-dimensional boundary.
          .un_remark
            %h6#remark Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/collars"}> collars
                )
            %p
              This construction gives “collared simplices” in much the same sense as in
              %a.existingWikiWord{:href => "/nlab/show/collar"} collared
              %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
              and in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/A1-homotopy"} A1-homotopy
            %p
              there is no condition that the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo :
                    %mo *
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} 0,1  : {*} \to I
              “hit a boundary point” – whatever that may mean in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              – of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %a.existingWikiWord{:href => "/nlab/show/lined+topos"} lined topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is canonically chosen to be the given line object and will hence typically “extended indefinitely” beyond these points.
            %p
              An example of this in practice is the
              %a.existingWikiWord{:href => "/nlab/show/A1-homotopy+theory"} A1-homotopy theory
              of schemes – there is no exact analogue of the interval (with boundary points) in an algebraic setting, but the
              %a.existingWikiWord{:href => "/nlab/show/affine+line"} affine line
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A^1
              together with the canonical points 0 and 1 is an interval object.
            %p
              So
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              need not “look” much like a 1-simplex, but the
              %em choice of boundary points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mn 1
                    %mo =
                    %mn 0
                    %mo :
                    %mo *
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \delta_1 = 0 : {*} \to I
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mn 0
                    %mo =
                    %mn 1
                    %mo :
                    %mo *
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \delta_0 = 1 : {*} \to I
              allows us to regard it as an interval for all practical purposes.
            %p
              Similarly and more generally what the above construction manifestly defines are
              %em cubes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mi n
                  %annotation{:encoding => "application/x-tex"} I^n
              built from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
            %p
              All these statement become precise for specific typical choices of the ambient category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p
              An important aspect is that once the cosimplicial object of
              %em collared simplices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \Delta_I
              is used to form
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi Δ
                      %mi I
                      %mo •
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Pi(X) := [\Delta^\bullet_I,X]
              (discussed below) and when these are interpreted as
              %a.existingWikiWord{:href => "/nlab/show/model+category"} models
              for
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              = succeed ":" do
                %strong the collars disappear
            %p
              For instance with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ⨿
                    %mo *
                    %mover
                      %mo →
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} {*}\amalg {*} \stackrel{0, 1}{\to}\mathbb{R}
              used as the interval in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %em path
              in a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an entire curve
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo :
                      %mi ℝ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \gamma : \mathbb{R} \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 1
                    %mo ,
                    %msub
                      %mi γ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \gamma_1,\gamma_2
              are composable already when
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi γ
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \gamma_1(1) = \gamma_2(0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \gamma_1
              extends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &gt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \gt 1
              and irrsepctive of how
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \gamma_2
              extends
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo &lt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \lt 0
            %p
              Moreover, the composite-up-to-homotopy of these two paths is an entire surface
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2 \to X
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 1
                    %mi and
                    %msub
                      %mi γ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \gamma_1 and \gamma_2
              is that its
              = succeed "-segment" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \delta_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo{:stretchy => "false"} |
                    %mn 0
                    %mo ≤
                    %mi x
                    %mo ≤
                    %mn 1
                    %mo ,
                    %mi y
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{(x,y) \in \mathbb{R}^2 | 0 \leq x \leq 1, y = 0\}
              and its
              = succeed "segment" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \delta_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo{:stretchy => "false"} |
                    %mn 0
                    %mo ≤
                    %mi y
                    %mo ≤
                    %mn 1
                    %mo ,
                    %mi x
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{(x,y) \in \mathbb{R}^2 | 0 \leq y \leq 1, x = 0\}
              coincide with the corresponding segments in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \gamma_1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \gamma_2
            %p More on this in the following example section.
          %h4#example_standard_intervals_cubes_and_simplices_in__and_
            Example: standard intervals, cubes and simplices in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Diff
                %annotation{:encoding => "application/x-tex"} Diff
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                %annotation{:encoding => "application/x-tex"} X =
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                %annotation{:encoding => "application/x-tex"} C =
            %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            be the category of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
          %p
            A standard choice of interval object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ⊂
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} I = [0,1] \subset \mathbb{R}
            with the obvious two boundary inclusions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo :
                    %mo *
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} 0,1 : {*} \to [0,1]
          %p
            But another possible choice is to let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} I = \mathbb{R}
            be the whole real line, but still equipped with the two maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo :
                    %mo *
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} 0,1 : {*} \to \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} 0 \in \mathbb{R}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} 1 \in \mathbb{R}
          %p
            Either of these two examples will do in the following discussion. The second choice is to be thought of as obtained from the first choice by adding “infinitely wide collars” at both boundaries of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mover
                    %mo →
                    %mn 0
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo ←
                    %mn 1
                  %mo *
                %annotation{:encoding => "application/x-tex"}
                  {*} \stackrel{0}{\to}[0,1]
                  \\stackrel{1}{\leftarrow} {*}
            may seem like a more natural choice for a representative of the idea of the “standard interval”, the choice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mover
                    %mo →
                    %mn 0
                  %mi ℝ
                  %mover
                    %mo ←
                    %mn 1
                  %mo *
                %annotation{:encoding => "application/x-tex"}
                  {*} \stackrel{0}{\to} \mathbb{R}
                  \\stackrel{1}{\leftarrow} {*}
            is actually more useful for many
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} abstract nonsense
            constructions.
          %p
            But since it is hard to draw the full real line, in the following we depict the situation for the choice
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} I = [0,1]
          %p
            Then for low
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            the above construction yields this
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n=0
                – here
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi I
                        %mn 0
                      %mo =
                      %msup
                        %mi I
                        %mrow
                          %mo ×
                          %mn 0
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \Delta_I^0 = I^{\times 0} = {*}
                is the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/point"} point
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n=1
                – here
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi I
                        %mn 1
                      %mo =
                      %msup
                        %mi I
                        %mrow
                          %mo ×
                          %mn 1
                      %mo =
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \Delta_I^1 = I^{\times 1} = I
                is just the interval itself
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                              %mo →
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      (0) \to (1)
                      
                      }
              %p
                The two face maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mn 1
                      %mo *
                      %mo →
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \delta_1 {*} \to I
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mn 0
                      %mo :
                      %mo *
                      %mo →
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \delta_0 : {*} \to I
                pick the boundary points in the obvious way. The unique degeneracy map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi σ
                        %mn 0
                      %mo :
                      %mi I
                      %mo →
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \sigma_0 : I \to {*}
                maps all points of the interval to the single point of the point.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n=2
                – here
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi i
                        %mn 2
                      %mo =
                      %msup
                        %mi I
                        %mrow
                          %mo ×
                          %mn 2
                      %mo =
                      %mi I
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \Delta_i^2 = I^{\times 2} = I \times I
                is the
                %strong standard square
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↑
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↑
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo ,
                              %mn 0
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo ,
                              %mn 0
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      (0,1) &amp;\to&amp; (1,1)
                      \\\
                      \\uparrow &amp;&amp; \uparrow
                      \\\
                      (0,0) &amp;\to&amp; (1,0)
                      }
              %p
                But the three face maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mi i
                      %mo :
                      %mi I
                      %mo →
                      %mi I
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \delta_i : I \to I\times I
                of the cosimplicial object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi I
                    %annotation{:encoding => "application/x-tex"} \Delta_I
                constructed above don’t regard the full square here, but just a triangle sitting inside it, in that pictorially they identify
                = succeed "-shaped" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi Δ
                          %mi I
                          %mn 1
                        %mo =
                        %mi I
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\Delta_I^1 = I)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I \times I
                as follows:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↑
                            %mtd
                              %msup
                                %mo
                                %mrow
                                  %mo =
                                  %msub
                                    %mi δ
                                    %mn 1
                                  %mo{:stretchy => "false"} (
                                  %mi I
                                  %mo{:stretchy => "false"} )
                              %mo ↗
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↑
                                %mrow
                                  %mo =
                                  %msub
                                    %mi δ
                                    %mn 0
                                  %mo{:stretchy => "false"} (
                                  %mi I
                                  %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo ,
                              %mn 0
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mo =
                                  %msub
                                    %mi δ
                                    %mn 2
                                  %mo{:stretchy => "false"} (
                                  %mi I
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo ,
                              %mn 0
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      (0,1) &amp;\to&amp; (1,1)
                      \\\
                      \\uparrow &amp;^{= \delta_1(I)}\nearrow&amp; \uparrow^{ = \delta_0(I)}
                      \\\
                      (0,0) &amp;\stackrel{= \delta_2(I)}{\to}&amp; (1,0)
                      }
              %p (here the arrows do not depict morphisms, but the standard topological interval, i don’t know how to typeset just lines without arrow heads in this fashion!)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} n=3
                – here
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi i
                        %mn 3
                      %mo =
                      %msup
                        %mi I
                        %mrow
                          %mo ×
                          %mn 3
                      %mo =
                      %mi I
                      %mo ×
                      %mi I
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \Delta_i^3 = I^{\times 3} = I \times I \times I
                is the
                %strong standard cube
              .un_example
                %h6#exercise Exercise
                %p
                  Insert the analog of the above discussion here and upload a nice graphics that shows the standard cube and how the cosimplicial object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mi I
                      %annotation{:encoding => "application/x-tex"} \Delta_I
                  picks a solid tetrahedron inside it.
          %p As a start, we can illustrate how there are 6 3-simplices sitting inside each 3-cube.
          %p
            %img{:src => "http://ncatlab.org/nlab/files/3simplex_in_3cube.jpg", :width => "550"}/
          %p Once you see how the 3-simplices sit inside the 3-cube, the facemaps can be illustrated as follows:
          %p
            %img{:src => "http://ncatlab.org/nlab/files/3simplex_facemaps.jpg", :width => "550"}/
          %p Note that these face maps are to be thought of as maps into 3-simplices sitting inside a 3-cube.
          %h3#Dendroidal Fundamental little 1-cubes space induced from an interval
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              \: something I am thinking about…
          %p
            The following is supposed to give an
            = succeed "ic" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-operad"} (∞,1)-operad
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %em geometric operadic
            version of the
            %em algebraic operadic
            version described further above.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi p
                %annotation{:encoding => "application/x-tex"} \Omega^p
            be the category of planar
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/tree"} tree
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi p
                %annotation{:encoding => "application/x-tex"} \Omega^p
            is a planar
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dendroidal+set"} dendroidal set
          %p
            Given an interval object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mover
                    %mo →
                    %mn 0
                  %mi I
                  %mover
                    %mo ←
                    %mn 1
                  %mo *
                %annotation{:encoding => "application/x-tex"} {*} \stackrel{0}{\to} I \stackrel{1}{\leftarrow} {*}
            in a category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi n
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %msup
                    %mi I
                    %mrow
                      %mo ∨
                      %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \phi_n \in [I,I^{\vee n}]
            for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            has been chosen.
          %p
            Then there is a planar co-dendroidal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mi C
                    %mi p
                  %mo :
                  %msup
                    %mi Ω
                    %mi p
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \Omega^p_C : \Omega^p \to C
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            given by:
          %ul
            %li
              %p
                a tree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                leaves is sent to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi I
                        %mrow
                          %mo ∨
                          %mi n
                    %annotation{:encoding => "application/x-tex"} I^{\vee n}
              %p
                (we think of the
                = succeed "-th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                here as being associated to the
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
            %li
              %p every degeneracy map is sent to the corresponding identity morphism
              %p
                (this corresponds to the fact that the co-dendroidal object encodes no nontrivial unary (co)operations, only the
                = succeed "-ary" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo &gt;
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n \gt 1)
            %li
              %p
                an
                %em outer face map
                on an
                = succeed "-ary" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                corresponding to the unaffected leaves and is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \phi_n
                on the affected leaf;
            %li
              %p
                an
                %em inner face map
                that contracts a
                = succeed "-ary" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} k_1
                = succeed "-ary" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} k_2
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi I
                        %mrow
                          %mo ∨
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi k
                            %mn 1
                          %mo +
                          %msub
                            %mi k
                            %mn 2
                          %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msubsup
                            %mi ϕ
                            %mrow
                              %msub
                                %mi k
                                %mn 1
                              %mo +
                              %msub
                                %mi k
                                %mn 2
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                      %mi I
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi ϕ
                            %mrow
                              %msub
                                %mi k
                                %mn 1
                      %msup
                        %mi I
                        %mrow
                          %mo ∨
                          %msub
                            %mi k
                            %mn 1
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi Id
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %mi Id
                          %mo ,
                          %msub
                            %mi ϕ
                            %mrow
                              %msub
                                %mi k
                                %mn 2
                          %mo ,
                          %mi Id
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %mi Id
                          %mo{:stretchy => "false"} )
                      %msup
                        %mi I
                        %mrow
                          %mo ∨
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi k
                            %mn 1
                          %mo +
                          %msub
                            %mi k
                            %mn 2
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      I^{\vee (k_1+k_2)}
                      \\stackrel{\phi_{k_1+k_2}^{-1}}{\to}
                      I
                      \\stackrel{\phi_{k_1}}{\to}
                      I^{\vee k_1}
                      \\stackrel{(Id, \cdots, Id,\phi_{k_2},Id, \cdots, Id )}{\to}
                      I^{\vee (k_1+k_2)}
                      \\,.
          %p
            %strong> Example
            \. In
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
