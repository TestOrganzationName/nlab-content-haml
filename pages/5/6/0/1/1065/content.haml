            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saunders+Mac+Lane"}> Saunders Mac Lane
                \:
                %em Homology
                (1975) reprinted as Classics in Mathematics. Springer (1995) &amp;lbrack;
                %a{:href => "https://link.springer.com/book/10.1007/978-3-642-62029-4"}> doi:10.1007/978-3-642-62029-4
                , ISBN:3-540-58662-8&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+Gelfand"}> Sergei Gelfand
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Yuri+Manin"} Yuri Manin
                = succeed "," do
