                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-662-12492-5"} doi:10.1007/978-3-662-12492-5
          %p A standard modern textbook introduction is
          %ul
            %li#Weibel94
              %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"}> Charles Weibel
              ,
              = succeed "," do
                %em
