                = succeed "," do
                  %a{:href => "http://www.math.uchicago.edu/~mitya/beilinson/hom-alg-2.pdf"} lec2
                = succeed "," do
                  %a{:href => "http://www.math.uchicago.edu/~mitya/beilinson/hom-alg-3.pdf"} lec3
                %a{:href => "http://www.math.uchicago.edu/~mitya/beilinson/hom-alg-4.pdf"} lec4
            %li#Collins06
              %p
                Julia Collins,
                %em Homological algebra
                (2006) &amp;lbrack;
                %a{:href => "http://www.maths.ed.ac.uk/~s0681349/HomologicalAlgebra.pdf"}> pdf
                \&amp;rbrack;
            %li
