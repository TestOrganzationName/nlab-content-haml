            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/type"} type
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi y
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo =
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    isContr(X) \coloneqq \sum_{x\colon X} \prod_{y\colon X} (y=x)
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
              in one
              %a.existingWikiWord{:href => "/nlab/show/variable"} variable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x : X
              over the
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
              on the other
              %a.existingWikiWord{:href => "/nlab/show/variable"} variable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                  %annotation{:encoding => "application/x-tex"} y \colon X
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x,y
              %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent
              %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo =
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x = y)
            %p
              We say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %strong contractible type
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} isContr(X)
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inhabited+type"} inhabited type
          %p
          .num_remark
            %h6 Remark
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/propositions+as+types"} propositions as types
              language, this can be pronounced as “there exists a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x\colon X
              such that every other point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                  %annotation{:encoding => "application/x-tex"} y\colon X
              is equal to
              = succeed ".\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %p
              Under the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy-theoretic
              interpretation, it should be thought of as the type of
              %em contractions
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              — since the dependent product describes
              %em continuous
              functions, the paths from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              depend continuously on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              and thus exhibit a contraction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %p
          .num_defn
            %h6 Definition
            %p
              A provably
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+homotopy+type+theory"} equivalent
              definition is the
              %a.existingWikiWord{:href => "/nlab/show/product+type"} product type
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the
              = succeed "-type" do
                %a.existingWikiWord{:href => "/nlab/show/isProp"} isProp
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo ×
                    %mspace{:width => "thickmathspace"}
                    %mi isProp
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    isContr(X) \coloneqq X \;\times\; isProp(X)
                    \\,.
            %p
          %p
            (Here of course we have to use a definition of
            %a.existingWikiWord{:href => "/nlab/show/isProp"} isProp
            which doesn’t refer to
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isContr
                  %annotation{:encoding => "application/x-tex"} isContr
          %p
          .num_remark
            %h6 Remark
            %p
              This now says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is contractible iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/pointed+type"} pointed
                  %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
          %p There is a third definition of a contractible type, provably equivalent to the others.
          %p
          #SingletonInduction.num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi a
                    %mo :
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A, a:A)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pointed+type"} pointed type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              satisfies
              %strong singleton induction
              if for every
              %a.existingWikiWord{:href => "/nlab/show/type+family"} type family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              the dependent function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} evpt
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{evpt}(a):\left(\prod_{x:A} B(x)\right) \to B(a)
            %p
              has a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/section"} section
              %strong contractible type
              is a pointed type which satisfies singleton induction.
