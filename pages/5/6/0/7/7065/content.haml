                    %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+in+an+%28infinity%2C1%29-category"} n-truncation
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos+theory"} higher topos theory
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
              %tbody
                %tr
                  %td{:style => "text-align: left;"} h-level 0
                  %td{:style => "text-align: left;"} (-2)-truncated
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible space
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/%28-2%29-groupoid"} (-2)-groupoid
                  %td{:style => "text-align: left;"}
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/true"}> true
                    \/​
                    %a.existingWikiWord{:href => "/nlab/show/unit+type"}> unit type
                    \/​
                    %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible type
                %tr
                  %td{:style => "text-align: left;"} h-level 1
                  %td{:style => "text-align: left;"} (-1)-truncated
                  %td{:style => "text-align: left;"}
                    contractible-if-
                    %a.existingWikiWord{:href => "/nlab/show/inhabited+space"} inhabited
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/%28-1%29-groupoid"}> (-1)-groupoid
                    \/​
                    %a.existingWikiWord{:href => "/nlab/show/truth+value"} truth value
                  %td{:style => "text-align: left;"}
