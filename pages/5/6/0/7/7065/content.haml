                          %mo{:stretchy => "false"} )
                      %mi p
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma, p:\mathrm{isContr}(A) \vdash \eta_{\mathrm{isContr}(A)}(p):w(\mathrm{pt}(p), \lambda x.c(p, x)) =_{\mathrm{isContr}(A)} p}
          %h2#properties Properties
          %p
          .num_prop
            %h6 Proposition
            %p
              For any type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} isContr(A)
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi isContr
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi isContr
                      %mo{:stretchy => "false"} (
                      %mi isContr
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} isContr(A) \to isContr(isContr(A))
          %p
          .num_prop
            %h6 Proposition
            %p
              A type is contractible if and only if it is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+homotopy+type+theory"} equivalent
              to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
          %h3#relation_to_dependent_sum_types_and_equivalences Relation to dependent sum types and equivalences
          %p
            A family of elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi B
                %annotation{:encoding => "application/x-tex"} x:A \vdash f(x):B
            is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            if its family of
            %a.existingWikiWord{:href => "/nlab/show/fiber+types"} fiber types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo :
                  %mi B
                  %mo ⊢
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi B
                  %mi y
                %annotation{:encoding => "application/x-tex"} y:B \vdash \sum_{x:A} f(x) =_B y
            is a family of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/contractible+types"} contractible types
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
            of a family of contractible types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            with witnesses
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi{:mathvariant => "normal"} isContr
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:A \vdash p(x):\mathrm{isContr}(B(x))
            is equivalent to the index type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            itself given by the first pair projection:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} z:\sum_{x:A} B(x) \vdash \pi_1(z):A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi{:mathvariant => "normal"} isContr
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi z
                        %mo :
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi x
                            %mo :
                            %mi A
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi A
                    %mi x
                    %mo )
                %annotation{:encoding => "application/x-tex"} x:A \vdash p(x):\mathrm{isContr}\left(\sum_{z:\sum_{x:A} B(x)} \pi_1(z) =_A x\right)
          %p
            This is due to the fact that for any family of types
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                  %mo ⊢
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi z
                        %mo :
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi x
                            %mo :
                            %mi A
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi A
                    %mi x
                    %mo )
                  %mo ≃
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:A \vdash q(x):\left(\sum_{z:\sum_{x:A} B(x)} \pi_1(z) =_A x\right) \simeq B(x)
          %p
            which means that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(x)
            is contractible, then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi z
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi A
                  %mi x
                %annotation{:encoding => "application/x-tex"} \sum_{z:\sum_{x:A} B(x)} \pi_1(z) =_A x
          %p is contractible.
          %h2#CategoricalSemantics Categorical semantics
          %p
            We discuss the
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            of contractible types.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be a
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
            with
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics+of+homotopy+type+theory"} sufficient structure
            to intepret all the above type theory. This means that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            has a
            %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+path+objects"} stable path objects
            %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibrations"} acyclic cofibrations
            are preserved by pullback along fibrations between fibrant objects. (We ignore questions of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coherence"} coherence
          %p
            In this
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊢
                  %mi A
                  %mo :
                  %mi Type
                %annotation{:encoding => "application/x-tex"} \vdash A : Type
            is a
            %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo ⊢
                    %mi A
                    %mo :
                    %mi Type
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\vdash A : Type]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ,
                  %mi y
                  %mo :
                  %mi A
                  %mo ⊢
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo =
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Type
                %annotation{:encoding => "application/x-tex"} x,y : A \vdash (x = y) : Type
            is as the
            %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi I
                    %mo →
                    %mi A
                    %mo ×
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A^I \to A \times A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi isContr
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} isContr(A)
            is the object obtained by taking the
            %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
            of the
            %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
            along one
            %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 2
                  %mo :
                  %mi A
                  %mo ×
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} p_2 : A\times A\to A
            and then forgetting the remaining morphism to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi isContr
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %msub
                                %mi p
                                %mn 2
                          %msup
                            %mi A
                            %mi I
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [isContr(A)]
                  \\;\;
                  \=
                  \\;\;
                  \\array{
                  \\prod_{p_2} A^I
                  \\\
                  \\downarrow
                  \\\
                  A
                  \\\
                  \\downarrow
                  \\\
                  *
                  }
                  \\,.
          %p
            The interpretation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %mi isContr
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\hat a : isContr(A)]
            of a
            %a.existingWikiWord{:href => "/nlab/show/term"} term
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi isContr
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} isContr(A)
            is precisely a morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi a
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mo *
                    %mo →
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %msub
                          %mi p
                          %mn 2
                    %msup
                      %mi A
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \hat a : * \to \prod_{p_2} A^I
          %p
          .num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/type-theoretic+model+category"} type-theoretic model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [isContr(A)]
              for the
              %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} interpretation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} isContr(A)
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              Global points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} * \to [isContr(A)]
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              are in bijection with
              %a.existingWikiWord{:href => "/nlab/show/contraction"} contraction
              %a.existingWikiWord{:href => "/nlab/show/right+homotopies"} right homotopies
              of the object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi η
                          %mtd
                            %msup
                              %mi A
                              %mi I
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi const
                                    %mi a
                                  %mo{:stretchy => "false"} )
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                            %mo ×
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\stackrel{\eta}{\to}&amp; A^I
                    \\\
                    \&amp; {}_{\mathllap{(id, const_a)}}\searrow &amp; \downarrow
                    \\\
                    \&amp;&amp; A \times A
                    }
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi const
                      %mi a
                  %annotation{:encoding => "application/x-tex"} const_a
              is a morphism of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mo *
                    %mover
                      %mo →
                      %mi a
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \to * \stackrel{a}{\to} A
              and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi I
                  %annotation{:encoding => "application/x-tex"} A^I
              is the
              %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
          .proof
            %h6 Proof
            %p
              Given a global point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi a
                        %mo{:stretchy => "false"} ^
                      %mo :
                      %mo *
                      %mo →
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %msub
                            %mi p
                            %mn 2
                      %msup
                        %mi A
                        %mi I
                    %annotation{:encoding => "application/x-tex"} \hat a : * \to \prod_{p_2} A^I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mo *
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a : * \to A
              for the corresponding composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo →
                              %mover
                                %mi a
                                %mo{:stretchy => "false"} ^
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %msub
                                  %mi p
                                  %mn 2
                            %msup
                              %mi A
                              %mi I
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi a
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    * &amp;\stackrel{\hat a}{\to} &amp; \prod_{p_2} A^I
                    \\\
                    \&amp;{}_{\mathllap{a}}\searrow &amp; \downarrow
                    \\\
                    \&amp;&amp; A
                    }
                    \\,.
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/hom+set"} hom set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %msub
                          %mi p
                          %mn 2
                    %msup
                      %mi A
                      %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/A}(a, \prod_{p_2} A^I)
              of the
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊣
                  %annotation{:encoding => "application/x-tex"} \dashv
              = succeed ")-" do
                %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              this is equivalently an element in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi A
                          %mo ×
                          %mi A
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi p
                        %mn 2
                        %mo *
                      %mi a
                      %mo ,
                      %msup
                        %mi A
                        %mi I
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/A \times A}( p_2^* a, A^I )
            %p
              Notice that the pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mn 2
                      %mo *
                    %mi a
                  %annotation{:encoding => "application/x-tex"} p_2^* a
              is the left morphism in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi const
                                    %mi a
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi a
                        %mtr
                          %mtd
                            %mi A
                            %mo ×
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mn 2
                          %mtd
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\to&amp; *
                    \\\
                    {}^{\mathllap{(id,const_a)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{a}}
                    \\\
                    A \times A &amp;\stackrel{p_2}{\to}&amp; A
                    }
                    \\,.
            %p
              Therefore a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mn 2
                      %mo *
                    %mi a
                    %mo →
                    %msup
                      %mi A
                      %mi I
                  %annotation{:encoding => "application/x-tex"} p_2^* a \to  A^I
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi A
                        %mo ×
                        %mi A
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/A \times A}
              is equivalently in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a diagram of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi η
                          %mtd
                          %mtd
                            %msup
                              %mi A
                              %mi I
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi const
                                    %mi a
                                  %mo{:stretchy => "false"} )
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                            %mo ×
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;&amp;\stackrel{\eta}{\to}&amp;&amp; A^I
                    \\\
                    \&amp; {}_{\mathllap{(id,const_a)}}\searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; A \times A
                    }
                    \\,.
            %p
              This is by definition a
              %a.existingWikiWord{:href => "/nlab/show/contraction"} contraction
              right
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
          .num_remark
            %h6 Remark
            %p
              Thus if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi isContr
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} isContr(A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} A\to 1
              is a (right)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/fibrant"} fibrant
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/acyclic+fibration"} acyclic fibration
            %p
              Conversely, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              are cofibrant, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} A\to 1
              is an acyclic fibration, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} A\to 1
              is a right homotopy equivalence, and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} isContr(A)
              has a global element. Thus, in most cases, the existence of a global element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} isContr(A)
              (which is unique up to homotopy, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} isContr(A)
              is an
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/h-proposition"} h-proposition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} A\to 1
              being an acyclic fibration.
            %p
              More generally, we may apply this locally. Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\to B
              is a fibration, which we can regard as a dependent type
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo ⊢
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Type
                    %mo .
                  %annotation{:encoding => "application/x-tex"} x\colon B \vdash A(x)\colon Type.
            %p Then we have a dependent type
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo ⊢
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} x\colon B \vdash isContr(A(x))\colon Type
            %p
              represented by a fibration
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi isContr
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} isContr(A)\to B
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} /
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}/B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a model category, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              are cofibrant)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} isContr(A)\to B
              has a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              exactly when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\to B
              is an acyclic fibration.
            %p We can also construct the type
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{x\colon B} isContr(A(x))
            %p
              in global context, which has a global element precisely when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} isContr(A)\to B
              has a section. Thus, a global element of this type is also equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A\to B
              being an acyclic fibration.
          %h2#examples Examples
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
                is a contractible type.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
                is a contractible type.
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/cone+type"} cone type
                is a contractible type, of which the unit type (cone type of the empty type) and the interval type (cone type of the unit type) are examples of cone types.
          %h2#related_concepts Related concepts
          %div
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+level"} homotopy level
