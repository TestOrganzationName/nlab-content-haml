                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi λ
                  %mi x
                  %mo .
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isEquiv}(\lambda c.(c(0), \lambda x.c(s(x))))
          %h3#generalized_induction_principle Generalized induction principle
          %p
            There is also a generalized induction principle (cf. the talk slides in
            = succeed ")," do
              %a{:href => "#LumsdaineShulman17"} LumsdaineShulman17
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi C
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} f:C \to \mathbb{N}
            instead of a type family
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℕ
                    %mo ⊢
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{N} \vdash P(x)
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi z
                      %mo :
                      %mi C
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi ℕ
                  %mi n
                %annotation{:encoding => "application/x-tex"} \sum_{z:C} f(z) =_\mathbb{N} n
            to express the generalized induction principle.
          %p
            Then the induction principle states that given a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi C
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} f:C \to \mathbb{N}
            along with
          %ul
            %li dependent pair
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 0
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi z
                      %mo :
                      %mi C
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi ℕ
                  %mn 0
                %annotation{:encoding => "application/x-tex"} c_0:\sum_{z:C} f(z) =_\mathbb{N} 0
          %ul
            %li dependent function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi s
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi n
                      %mo :
                      %mi ℕ
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi z
                        %mo :
                        %mi C
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℕ
                    %mi n
                    %mo )
                  %mo →
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi z
                        %mo :
                        %mi C
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℕ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} c_s:\prod_{n:\mathbb{N}} \left(\sum_{z:C} f(z) =_\mathbb{N} n\right) \to \left(\sum_{z:C} f(z) =_\mathbb{N} s(n)\right)
          %ul
            %li
              and natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo :
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n:\mathbb{N}
          %p one could construct the dependent pair
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} ind
                    %mi ℕ
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %msub
                    %mi c
                    %mn 0
                  %mo ,
                  %msub
                    %mi c
                    %mi s
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi z
                      %mo :
                      %mi C
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi ℕ
                  %mi n
                %annotation{:encoding => "application/x-tex"} \mathrm{ind}_\mathbb{N}^C(f, c_0, c_s, n):\sum_{z:C} f(z) =_\mathbb{N} n
          %p such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} ind
                    %mi ℕ
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %msub
                    %mi c
                    %mn 0
                  %mo ,
                  %msub
                    %mi c
                    %mi s
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi c
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathrm{ind}_\mathbb{N}^C(f, c_0, c_s, 0) \equiv c_0
          %p
            and for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo :
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n:\mathbb{N}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} ind
                    %mi ℕ
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %msub
                    %mi c
                    %mn 0
                  %mo ,
                  %msub
                    %mi c
                    %mi s
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi c
                    %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi{:mathvariant => "normal"} ind
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %msub
                    %mi c
                    %mn 0
                  %mo ,
                  %msub
                    %mi c
                    %mi s
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ind}_\mathbb{N}^C(f, c_0, c_s, s(n)) \equiv c_s(n, \mathrm{ind}(f, c_0, c_s, n))
          %p
            However, by the rules of dependent pair types, one could instead postulate separate elements and identifications instead of an element of a
            %a.existingWikiWord{:href => "/nlab/show/fiber+type"} fiber type
            throughout the generalized principle.
          %p
            Instead of the dependent pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 0
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi z
                      %mo :
                      %mi C
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi ℕ
                  %mn 0
                %annotation{:encoding => "application/x-tex"} c_0:\sum_{z:C} f(z) =_\mathbb{N} 0
            we have the element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 0
                  %mo :
                  %mi C
                %annotation{:encoding => "application/x-tex"} c_0:C
            and identification
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 0
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℕ
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p_0:f(c_0) =_\mathbb{N} 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %msub
                      %mi p
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c_0, p_0)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi s
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi n
                      %mo :
                      %mi ℕ
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi z
                        %mo :
                        %mi C
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℕ
                    %mi n
                    %mo )
                  %mo →
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi z
                        %mo :
                        %mi C
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℕ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} c_s:\prod_{n:\mathbb{N}} \left(\sum_{z:C} f(z) =_\mathbb{N} n\right) \to \left(\sum_{z:C} f(z) =_\mathbb{N} s(n)\right)
          %p by currying this is equivalent to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi s
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi n
                      %mo :
                      %mi ℕ
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi z
                      %mo :
                      %mi C
                  %mrow
                    %mo (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℕ
                    %mi n
                    %mo )
                  %mo →
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi z
                        %mo :
                        %mi C
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi ℕ
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} c_s:\prod_{n:\mathbb{N}} \prod_{z:C} \left(f(z) =_\mathbb{N} n\right) \to \left(\sum_{z:C} f(z) =_\mathbb{N} s(n)\right)
          %p
            and by the
            %a.existingWikiWord{:href => "/nlab/show/type+theoretic+axiom+of+choice"} type theoretic axiom of choice
            this is equivalent to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi s
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi n
                      %mo :
                      %mi ℕ
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mi C
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi g
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi ℕ
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi C
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi p
                      %mo :
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi ℕ
                      %mi n
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi ℕ
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c_s:\prod_{n:\mathbb{N}} \prod_{y:C} \sum_{g:(f(y) =_\mathbb{N} n) \to C} \prod_{p:f(y) =_\mathbb{N} n} f(g(p)) =_\mathbb{N} s(n)
          %p By the rules of dependent pair types, the family of dependent pair types could be split up into
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi s
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi n
                      %mo :
                      %mi ℕ
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mi C
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi ℕ
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} c_s:\prod_{n:\mathbb{N}} \prod_{y:C} (f(y) =_\mathbb{N} n) \to C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi s
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi n
                      %mo :
                      %mi ℕ
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mi C
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi p
                      %mo :
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi ℕ
                      %mi n
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi y
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi ℕ
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p_s:\prod_{n:\mathbb{N}} \prod_{y:C} \prod_{p:f(y) =_\mathbb{N} n} f(c_s(n, y, p)) =_\mathbb{N} s(n)
          %p where the original dependent funciton is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mi n
                  %mo :
                  %mi ℕ
                  %mo .
                  %mi λ
                  %mi y
                  %mo :
                  %mi C
                  %mo .
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi p
                    %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda n:\mathbb{N}.\lambda y:C.(c_s(n, y), p_s(n, y))
          %p
            Then the induction principle of the natural numbers states that given a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and a function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} f:C \to \mathbb{N}
          %ul
            %li
              %p
                an element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 0
                      %mo :
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c_0:C
            %li
              %p
                an identification
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 0
                      %mo :
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi ℕ
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} p_0:f(c_0) =_\mathbb{N} 0
            %li
              %p dependent functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi s
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi n
                      %mo :
                      %mi ℕ
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mi C
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi ℕ
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} c_s:\prod_{n:\mathbb{N}} \prod_{y:C} (f(y) =_\mathbb{N} n) \to C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
