              %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                %use{:x => "203.405212", "xlink:href" => "#rVIxdNn19xslb0jlaGuzz_8TdPs=-glyph15-1", :y => "62.300233"}
              %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
