                %use{:x => "225.220406", "xlink:href" => "#rVIxdNn19xslb0jlaGuzz_8TdPs=-glyph13-2", :y => "41.043184"}
          %p
            Here the
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commutativity
            of the top square means equivalently that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} rec
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mn 0
                    %mi D
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{rec}(0) \,=\, 0_D
          %p and
          #eq:FormulaForDependentRecursion.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} rec
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} succ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi{:mathvariant => "normal"} succ
                    %mi D
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi n
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} rec
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{rec}\big(
                  \\mathrm{succ}(n)
                  \\big)
                  \\;=\;
                  \\mathrm{succ}_D\big(n,\, \mathrm{rec}(n)\big)
                  \\,.
          %p
          #NeedForDependentRecursion.num_remark
            %h6 Remark
            %p
              (
              %strong the need for dependent recursion
              \&amp;lbrack;
              %a{:href => "#Paulin-Mohring93"}> cf. Paulin-Mohring (1993, p. 330)
              \&amp;rbrack;)
              %br/
              The appearance of the argument “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              ” on the right of
              %a.maruku-eqref{:href => "#eq:FormulaForDependentRecursion"} (5)
              – in contrast to formula
              %a.maruku-eqref{:href => "#eq:FormulaForNonDependentRecursion"} (3)
              for non-dependent recursion – means (in view of the argument “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi succ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} succ(n)
              ” on the left) that the recursor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi succ
                      %mi D
                  %annotation{:encoding => "application/x-tex"} succ_D
              has access to the
              %em
                %a.existingWikiWord{:href => "/nlab/show/predecessor"} predecessor
              %a.existingWikiWord{:href => "/nlab/show/partial+function"} partial function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi pred
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %mi succ
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ↦
                      %mspace{:width => "thinmathspace"}
                      %mi n
                    %annotation{:encoding => "application/x-tex"} pred \,\colon\,succ(n) \,\mapsto\, n
              %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependently typed
              recursion principle
              %a.maruku-eqref{:href => "#eq:AssumingUnderlyingScliceObjectToBeIndependent"} (4)
          %h4#Induction Induction
          %p
            Dropping the above constraint
            %a.maruku-eqref{:href => "#eq:AssumingUnderlyingScliceObjectToBeIndependent"} (4)
            on the dependent
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            satisfied Def.
            %a.maruku-ref{:href => "#InferenceRules"}
            is the classical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/induction+principle"} induction principle
          %p
            That principle says informally that if a
            %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            depending on the natural numbers is true at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n = 0
            and such that if it is true for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            then it is true for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
          %p
            Here is how this is formalized in type theory and then
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} interpreted
            in some suitable ambient category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            First of all, that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is a proposition depending on the natural numbers means that it is a
            %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi ℕ
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi Type
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  n \,\colon\, \mathbb{N}
                  \\;\;\vdash\;\;
                  P(n) \,\colon\, Type
                  \\,.
          %p
            The categorical interpretation of this is by a
            %a.existingWikiWord{:href => "/nlab/show/display+map"} display map
          #eq:DisplayMapInterpretingNDependentType.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi P
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %msup
                                %mo
                                %mrow
                                  %msub
                                    %mi π
                                    %mi P
                      %mtr
                        %mtd
                          %mi ℕ
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  P
                  \\\
                  \\big\downarrow\mathrlap{^{\pi_P}}
                  \\\
                  \\mathbb{N}
                  }
          %p
            in the given category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
