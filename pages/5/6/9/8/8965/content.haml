                  (
                  %a.existingWikiWord{:href => "/nlab/show/unit+type"}> unit type
                  )
            %p
          \&amp;lbrack;
          %a{:href => "#Martin-Löf84"}> Martin-Löf (1984)
          ,
          = succeed "," do
            %a{:href => "/nlab/files/MartinLofIntuitionisticTypeTheory.pdf#page=51"} pp. 45
          = succeed "&rbrack;" do
            %a{:href => "W-type#Dybjer97"} Dybjer (1997, p. 330, 333)
          %h3#relation_to_the_type_of_finite_types Relation to the type of finite types
          %p
            The natural numbers type is equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/set+truncation"} set truncation
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/type+of+finite+types"} type of finite types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mo ≃
                  %mo{:stretchy => "false"} [
                  %mi{:mathvariant => "normal"} FinType
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbb{N} \simeq [\mathrm{FinType}]_0
          %p
            This is the type theoretic analogue of the
            %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
            of the
            %a.existingWikiWord{:href => "/nlab/show/permutation+category"} permutation category
            resulting in the set of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
          %p This gives us an alternate definition of the natural numbers as the type of finite types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %mi{:mathvariant => "normal"} FinType
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbb{N} \coloneqq [\mathrm{FinType}]_0
          %p
            One has
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %mo :
                  %mi{:mathvariant => "normal"} FinType
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi{:mathvariant => "normal"} FinType
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                %annotation{:encoding => "application/x-tex"} [-]_0:\mathrm{FinType} \to [\mathrm{FinType}]_0
            by the introduction rules of set truncation.
          %p
            The arithmetic operations and order relations on the natural numbers type can be defined by induction on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/set+truncation"} set truncation
          %p
            For all finite types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi{:mathvariant => "normal"} FinType
                %annotation{:encoding => "application/x-tex"} A:\mathrm{FinType}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo :
                  %mi{:mathvariant => "normal"} FinType
                %annotation{:encoding => "application/x-tex"} B:\mathrm{FinType}
            and finite families
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo :
                    %mi A
                    %mo →
                    %mi{:mathvariant => "normal"} FinType
                  %annotation{:encoding => "application/x-tex"} C:A \to \mathrm{FinType}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %msub
                    %mo =
                    %mi ℕ
                  %mo{:stretchy => "false"} [
                  %mi ∅
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %mspace{:width => "1em"}
                  %mn 1
                  %msub
                    %mo =
                    %mi ℕ
                  %mo{:stretchy => "false"} [
                  %mi 𝟙
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                %annotation{:encoding => "application/x-tex"} 0 =_\mathbb{N} [\emptyset]_0 \quad 1 =_\mathbb{N} [\mathbb{1}]_0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %mo +
                  %mo{:stretchy => "false"} [
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %msub
                    %mo =
                    %mi ℕ
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo +
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                %annotation{:encoding => "application/x-tex"} [A]_0 + [B]_0 =_\mathbb{N} [A + B]_0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo =
                      %mn 1
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi A
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 0
                  %mo{:stretchy => "false"} [
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi ℕ
                  %msub
                    %mrow
                      %mo [
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ]
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \sum_{x = 1}^{[A]_0} [C]_0(x) =_\mathbb{N} \left[\sum_{x:A} C(x)\right]_0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %msub
                    %mo =
                    %mi ℕ
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ×
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                %annotation{:encoding => "application/x-tex"} [A]_0 \cdot [B]_0 =_\mathbb{N} [A \times B]_0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo =
                      %mn 1
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi A
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 0
                  %mo{:stretchy => "false"} [
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi ℕ
                  %msub
                    %mrow
                      %mo [
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ]
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \prod_{x = 1}^{[A]_0} [C]_0(x) =_\mathbb{N} \left[\prod_{x:A} C(x)\right]_0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi B
                  %msubsup
                    %mo{:stretchy => "false"} ]
                    %mn 0
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi A
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 0
                  %msub
                    %mo =
                    %mi ℕ
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo →
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                %annotation{:encoding => "application/x-tex"} [B]_0^{[A]_0} =_\mathbb{N} [A \to B]_0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %msub
                    %mo =
                    %mi ℕ
                  %mo{:stretchy => "false"} [
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ≃
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} or
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi A
                  %msub
                    %mo =
                    %mi{:mathvariant => "normal"} FinType
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} [A]_0 =_\mathbb{N} [B]_0 \coloneqq [A \simeq B]_{(-1)} \; \mathrm{or} \; [A =_\mathrm{FinType} B]_{(-1)}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %mo ≤
                  %mo{:stretchy => "false"} [
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ↪
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} [A]_0 \leq [B]_0 \coloneqq [A \hookrightarrow B]_{(-1)}
          %h3#CategoricalSemantics Categorical semantics
          %p
            We spell out how under the canonical
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+model+of+dependent+types"} categorical model of dependent types
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            of the natural numbers types yields a
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
            together with its expected
            %a.existingWikiWord{:href => "/nlab/show/recursion"} recursion
            and
            %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            principle.
          %p
            %br/
          %p
            Throughout, we consider an ambient
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            (e.g.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathcal{C} =
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          #eq:CategoryOfFAlgebras.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mi Alg
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi underlying
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"}
                  F Alg(\mathcal{C}) \xrightarrow{underlying} \mathcal{C}
          %p
            for the category of
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+endofunctor"} algebras over the endofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:TheEndofunctor"} (1)
          %h4#Recursion Recursion
          %p
            We spell out how the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            satisfies Def.
            %a.maruku-ref{:href => "#InferenceRules"}
            is the classical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/recursion+principle"} recursion principle
          %p
            %br/
          %p
            We begin with a simple special case of recursion (cf. Rem.
            = succeed ")," do
              %a.maruku-ref{:href => "#NeedForDependentRecursion"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            (we come to the general form of recursion further
            = succeed ")." do
              %a{:href => "#RecursionGenerally"} below
          %p
            So consider any
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi D
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 0
                    %mi D
                  %mo ,
                  %msub
                    %mi succ
                    %mi D
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi F
                  %mi Alg
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \big(D, (0_D, succ_D)\big) \,\in\, F Alg(\mathcal{C})
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:CategoryOfFAlgebras"} (2)
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ∈
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} D \in \mathcal{C}
            equipped with a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 0
                    %mi D
                  %mo{:lspace => "verythinmathspace"} :
                  %mo *
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"}
                  0_D \colon * \to D
          %p and a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi succ
                    %mi D
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo →
                  %mi D
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  succ_D \colon D \to D
                  \\,.
          %p
            By
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initiality
            of the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi rec
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi ℕ
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"}
                  rec \,\colon\, \mathbb{N} \to D
          %p
            such that the following
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mover
                            %mo ⟶
                            %mn 0
                        %mtd
                          %mi ℕ
                        %mtd
                          %mover
                            %mo ⟶
                            %mi succ
                        %mtd
                          %mi ℕ
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %msup
                                %mo
                                %mpadded{:width => "0"}
                                  %mi rec
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %msup
                                %mo
                                %mpadded{:width => "0"}
                                  %mi rec
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %munder
                            %mo ⟶
                            %mrow
                              %msub
                                %mn 0
                                %mi D
                        %mtd
                          %mi D
                        %mtd
                          %munder
                            %mo ⟶
                            %mrow
                              %msub
                                %mi succ
                                %mi D
                        %mtd
                          %mi D
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  *
                  \&amp;\stackrel{0}{\longrightarrow}&amp;
                  \\mathbb{N}
                  \&amp;\stackrel{succ}{\longrightarrow}&amp;
                  \\mathbb{N}
                  \\\
                  \\big\downarrow
                  \&amp;&amp;
                  \\big\downarrow\mathrlap{^\mathrlap{rec}}
                  \&amp;&amp;
                  \\big\downarrow\mathrlap{^\mathrlap{rec}}
                  \\\
                  *
                  \&amp;\underset{0_D}{\longrightarrow}&amp;
                  D
                  \&amp;\underset{succ_D}{\longrightarrow}&amp;
                  D
                  }
          %p
            This means precisely that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi rec
                %annotation{:encoding => "application/x-tex"} rec
            is the function
            %a.existingWikiWord{:href => "/nlab/show/recursive+definition"} defined recursively
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi rec
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mn 0
                    %mi D
                %annotation{:encoding => "application/x-tex"}
                  rec(0) \;=\; 0_D
          %p and
          #eq:FormulaForNonDependentRecursion.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi rec
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi succ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi succ
                    %mi D
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi rec
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  rec\big(succ(n)\big)
                  \\;=\;
                  succ_D\big(rec(n)\big)
                  \\,.
          %p#RecursionGenerally
            More generally, consider an
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
