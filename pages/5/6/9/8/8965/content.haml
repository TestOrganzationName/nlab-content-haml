          %h3#large_recursion_principle Large recursion principle
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            presented using only a single
            %a.existingWikiWord{:href => "/nlab/show/type"} type
            %a.existingWikiWord{:href => "/nlab/show/judgment"} judgment
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} type
                  %annotation{:encoding => "application/x-tex"} A \; \mathrm{type}
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory+with+type+variables"} type variables in the dependent type theory
            (see
            = succeed ")." do
              %a{:href => "#CTZulip"} Category Theory Zulip
          %p Given
          %ol
            %li
              %p
                a type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %annotation{:encoding => "application/x-tex"} T_0 \; \mathrm{type}
            %li
              %p
                a family of types
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo :
                      %mi ℕ
                      %mo ,
                      %mi X
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mo ⊢
                      %msub
                        %mi T
                        %mi s
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %annotation{:encoding => "application/x-tex"} n:\mathbb{N}, X \; \mathrm{type} \vdash T_s(n, X) \; \mathrm{type}
          %p one can construct a family of types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo :
                  %mi ℕ
                  %mo ⊢
                  %msubsup
                    %mi{:mathvariant => "normal"} rec
                    %mi ℕ
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                      %mo ,
                      %msub
                        %mi T
                        %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} n:\mathbb{N} \vdash \mathrm{rec}_\mathbb{N}^{T_0, T_s}(n) \; \mathrm{type}
          %p such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} rec
