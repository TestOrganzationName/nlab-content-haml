                        %mn 0
                      %mo ,
                      %msub
                        %mi T
                        %mi s
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi T
                    %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %msubsup
                    %mi{:mathvariant => "normal"} rec
                    %mi ℕ
                    %mrow
                      %msub
                        %mi T
                        %mn 0
                      %mo ,
                      %msub
                        %mi T
                        %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} n:\mathbb{N} \vdash \mathrm{rec}_\mathbb{N}^{T_0, T_s}(s(n)) \equiv T_s(n, \mathrm{rec}_\mathbb{N}^{T_0, T_s}(n) \; \mathrm{type}
          %p
            Without type variables, the second requirement in the large recursion principle that we have a family of types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo :
                  %mi ℕ
                  %mo ,
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} type
                  %mo ⊢
                  %msub
                    %mi T
                    %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} n:\mathbb{N}, X \; \mathrm{type} \vdash T_s(n, X) \; \mathrm{type}
            will not be possible.
          %h2#properties Properties
          %h3#general General
          %p
          #NaturalNumbersAsWType.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers+type"} natural numbers type
                as a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/W-type"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi 𝒲
                        %annotation{:encoding => "application/x-tex"} \mathcal{W}
                    \-type
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+type"} natural numbers type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mn 0
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi succ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{N},\, 0,\, succ)
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InferenceRules"}
              %a.existingWikiWord{:href => "/nlab/show/W-type"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝒲
                    %annotation{:encoding => "application/x-tex"} \mathcal{W}
                \-type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi 𝒲
                      %mrow
                        %mi c
                        %mo{:lspace => "verythinmathspace"} :
                        %mi C
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underset{c \colon C}{\mathcal{W}} A(c)
              with:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi C
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mi succ
                        %mo{:stretchy => "false"} }
                        %mspace{:width => "thinmathspace"}
                        %mo ≃
                        %mspace{:width => "thinmathspace"}
                        %mo *
                        %mo ⊔
                        %mo *
                      %annotation{:encoding => "application/x-tex"} C \,\coloneqq\, \{0, succ\} \,\simeq\, \ast \sqcup \ast
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mo ∅
                      %annotation{:encoding => "application/x-tex"} A_0 \,\coloneqq\, \varnothing
                  (
                  %a.existingWikiWord{:href => "/nlab/show/empty+type"}> empty type
                  );
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
