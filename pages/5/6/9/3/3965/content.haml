                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho_{SM}: Spin(p,q) \to \mathrm{Gl}(V)
              a representation with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
