                        %msub
                          %mi ω
                          %mn 2
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi P
                          %mn 1
                        %mo ∘
                        %msub
                          %mi P
                          %mn 2
                        %mo ,
                        %msub
                          %mi 𝔤
                          %mn 1
                        %mo ⊕
                        %msub
                          %mi 𝔤
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\omega_1 \circ \omega_2 := \mathrm{pr}_1^{*}\omega_1 \oplus \mathrm{pr}_2^{*}\omega_2 \in \Omega^1(P_1 \circ P_2,\mathfrak{g}_1 \oplus \mathfrak{g}_2)
                %p
                  is a connection on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
