                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mn 1
                        %mo ×
                        %msub
                          %mi ρ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \rho_1 \times \rho_2
                  is a representation of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 1
                        %mo ×
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} G_1 \times G_2
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
