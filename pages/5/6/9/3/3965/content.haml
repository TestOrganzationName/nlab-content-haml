                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \varphi \in \Omega^p(M,V)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ψ
                        %mo ∈
                        %msup
                          %mi Ω
                          %mi q
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo ,
                        %mi W
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \psi\in\Omega^q(M,W)
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi V
                        %mo ×
                        %mi W
                        %mo →
                        %mi U
                      %annotation{:encoding => "application/x-tex"} f: V \times W \to U
                  is a linear map, we have
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi φ
                          %msub
                            %mo ∧
                            %mi f
                          %mi ψ
                          %mo ∈
                          %msup
                            %mi Ω
                            %mrow
                              %mi p
                              %mo +
                              %mi q
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mo ,
                          %mi U
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \varphi \wedge_{f} \psi \in \Omega^{p+q}(M,U)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⋆
                      %annotation{:encoding => "application/x-tex"} \star
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Hodge-star+operator"} Hodge-star operator
                  determined by the
                  %a.existingWikiWord{:href => "/nlab/show/metric"} metric
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi M
                        %annotation{:encoding => "application/x-tex"} M
          .un_remark
            %h6#remark_2 Remark
            %p
              The
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"} Euler-Lagrange equation
              %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
              are called
              = succeed ":" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+equations"} Yang-Mills equations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} D
                      %mi ω
                    %mo ⋆
                    %msub
                      %mi F
                      %mi ω
                    %mo =
                    %mn 0
                    %mspace{:width => "1em"}
                    %mtext and
                    %mspace{:width => "1em"}
                    %msup
                      %mi{:mathvariant => "normal"} D
                      %mi ω
                    %msub
                      %mi F
                      %mi ω
                    %mo =
                    %mn 0
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{D}^{\omega}\star F_{\omega} = 0
                    \\quad\text{ and }\quad
                    \\mathrm{D}^{\omega}F_{\omega}=0,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} D
                      %mi ω
                  %annotation{:encoding => "application/x-tex"} \mathrm{D}^\omega
              denotes the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exterior+covariant+derivative"} covariant derivative
          .un_definition
            %h6#definition_2 Definition
            %p
              A
              %em gauge transformation
              is a smooth
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
              morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi P
                      %mo →
                      %mi P
                    %annotation{:encoding => "application/x-tex"} g: P \to P
          .un_remark
            %h6#remark_3 Remark
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi P
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} g: P \to P
              be a gauge transformation.
            %ul
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} \omega
                  is a connection on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                        %annotation{:encoding => "application/x-tex"} P
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi g
                          %mo *
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} g^{*}\omega
                  is another connection on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                        %annotation{:encoding => "application/x-tex"} P
              %li
                %p
                  One can identify
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  with a smooth map
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi g
                            %mo{:stretchy => "false"} ˜
                          %mo :
                          %mi P
                          %mo →
                          %mi G
                        %annotation{:encoding => "application/x-tex"} \tilde g: P \to G
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                          %mo =
                          %msub
                            %mi r
                            %mover
                              %mi g
                              %mo{:stretchy => "false"} ˜
                        %annotation{:encoding => "application/x-tex"} g=r_{\tilde g}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi p
                        %mo ⋅
                        %mover
                          %mi g
                          %mo{:stretchy => "false"} ˜
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} g(p) = p \cdot \tilde g(p)
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo ∈
                          %mi P
                        %annotation{:encoding => "application/x-tex"} p\in P
              %li
                %p
                  The pullback along a gauge transformation restricts to an
                  %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Ω
                            %mi ρ
                            %mi k
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo ,
                          %mi V
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \Omega^k_{\rho}(P,V)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi g
                            %mo{:stretchy => "false"} ˜
                        %annotation{:encoding => "application/x-tex"} \tilde g
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi g
                          %mo *
                        %mi ψ
                        %mo =
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %msup
                          %mover
                            %mi g
                            %mo{:stretchy => "false"} ˜
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mtext .
                      %annotation{:encoding => "application/x-tex"}
                        g^{*}\psi = \rho(\tilde g^{-1},\psi)\text{.}
          .un_theorem
            %h6#theorem Theorem
            %p
              The Yang-Mills action functional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi YM
                  %annotation{:encoding => "application/x-tex"} S_{YM}
              is gauge-invariant, i.e.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi YM
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi g
                      %mo *
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi S
                      %mi YM
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    S_{YM}(g^{*}\omega) = S_{YM}(\omega)
            %p
              for all gauge transformations
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi P
                      %mo →
                      %mi P
                    %annotation{:encoding => "application/x-tex"} g:P \to P
          .proof
            %h6#proof Proof
            %p
              We have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mo *
                    %mi ω
                    %mo =
                    %msubsup
                      %mi{:mathvariant => "normal"} Ad
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo −
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mo *
                    %mover
                      %mi θ
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} g^{*}\omega  = \mathrm{Ad}_{\tilde g}^{-1}(\omega) - \tilde g^{*}\bar\theta
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mo *
                      %mi Ω
                      %mo =
                      %msubsup
                        %mi{:mathvariant => "normal"} Ad
                        %mover
                          %mi g
                          %mo{:stretchy => "false"} ˜
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g^{*}\Omega = \mathrm{Ad}_{\tilde g}^{-1}(\Omega)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi{:mathvariant => "normal"} Ad
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msup
                      %mi Ω
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi{:mathvariant => "normal"} Ad
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^k(P,\mathrm{Ad}) \cong \Omega^2(M,\mathrm{Ad}(P))
              this corresponds to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mrow
                          %msup
                            %mi g
                            %mo *
                          %mi ω
                      %mo =
                      %msub
                        %mi{:mathvariant => "normal"} Ad
                        %mi g
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_{g^{*}\omega} = \mathrm{Ad}_{g} (F_{\omega})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              is
              = succeed "-invariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Ad
                    %annotation{:encoding => "application/x-tex"} \mathrm{Ad}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %msub
                      %mi F
                      %mrow
                        %msup
                          %mi g
                          %mo *
                        %mi ω
                    %mo{:stretchy => "false"} ‖
                    %mo =
                    %msub
                      %mi{:mathvariant => "normal"} Ad
                      %mi g
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi ω
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ∧
                      %mi κ
                    %msub
                      %mi{:mathvariant => "normal"} Ad
                      %mi g
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi ω
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi F
                      %mi ω
                    %msub
                      %mo ∧
                      %mi κ
                    %msub
                      %mi F
                      %mi ω
                    %mo =
                    %mo{:stretchy => "false"} ‖
                    %msub
                      %mi F
                      %mi ω
                    %mo{:stretchy => "false"} ‖
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\| F_{g^{*}\omega} \|
                    \= \mathrm{Ad}_{g} (F_{\omega}) \wedge_{\kappa} \mathrm{Ad}_{g} (F_{\omega})
                    \= F_{\omega} \wedge_{\kappa} F_{\omega}
                    \= \| F_{\omega}\|.
          .un_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              theory over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a Yang-Mills Theory over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              with gauge group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G=U(1)
            %ul
              %li
                %p
                  for an electromagnetic field theory given by a
                  = succeed "-bundle" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} U(1)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                  over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi M
                        %annotation{:encoding => "application/x-tex"} M
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi{:mathvariant => "normal"} Ad
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo{:stretchy => "false"} )
                          %mo ≅
                          %mi P
                          %mo ×
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                        %annotation{:encoding => "application/x-tex"} \mathrm{Ad}(P) \cong P \times \R
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Ω
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo ,
                        %mi{:mathvariant => "normal"} Ad
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ≅
                        %msup
                          %mi Ω
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Omega^k(M,\mathrm{Ad}(P)) \cong \Omega^k(M)
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Ω
                            %mi{:mathvariant => "normal"} Ad
                            %mi k
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo ,
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                          %mo ≅
                          %msubsup
                            %mi Ω
                            %mi{:mathvariant => "normal"} Ad
                            %mi k
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \Omega^k_{\mathrm{Ad}}(P,\mathfrak{g})\cong \Omega^k_{\mathrm{Ad}}(P)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi F
                            %mi ω
                          %mo ∈
                          %msup
                            %mi Ω
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} F_{\omega} \in \Omega^2(M)
              %li
                %p
                  Since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(1)
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mo{:stretchy => "false"} (
                        %mi{:mathvariant => "normal"} Ad
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \mathrm{d}(\mathrm{Ad}) = 0
                  and so
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi{:mathvariant => "normal"} D
                          %mi ω
                        %mo =
                        %mi{:mathvariant => "normal"} d
                      %annotation{:encoding => "application/x-tex"} \mathrm{D}^{\omega}=\mathrm{d}
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Ω
                            %mi{:mathvariant => "normal"} Ad
                            %mi k
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \Omega^{k}_{\mathrm{Ad}}(P)
              %li
                %p
                  Thus, the Yang-Mills equations reduce to Maxwell’s equations for an electromagnetic field on
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi M
                        %annotation{:encoding => "application/x-tex"} M
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mo ⋆
                        %msub
                          %mi F
                          %mi ω
                        %mo =
                        %mn 0
                        %mspace{:width => "1em"}
                        %mtext and
                        %mspace{:width => "1em"}
                        %mi{:mathvariant => "normal"} d
                        %msub
                          %mi F
                          %mi ω
                        %mo =
                        %mn 0
                        %mtext .
                      %annotation{:encoding => "application/x-tex"}
                        \\mathrm{d}\star F_{\omega} = 0
                        \\quad\text{ and }\quad
                        \\mathrm{d}F_{\omega}=0
                        \\text{.}
          %h2#general_matter_fields General Matter Fields
          .un_def
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a gauge group. A
              %em
                matter type for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              is a tuple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi h
                    %mo ,
                    %mi ρ
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V,h,\rho,f)
              consisting of:
            %ul
              %li
                %p
                  a finite-dimensional real
                  %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  called the
                  = succeed "." do
                    %em internal state space
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/scalar+product"} scalar product
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi h
                          %mo :
                          %mi V
                          %mo ×
                          %mi V
                          %mo →
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                        %annotation{:encoding => "application/x-tex"} h: V \times V \to \R
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/representation"} representation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mo :
                        %mi G
                        %mo ×
                        %mi V
                        %mo →
                        %mi V
                      %annotation{:encoding => "application/x-tex"} \rho: G \times V \to V
                  that is
                  %a.existingWikiWord{:href => "/nlab/show/isometry"} isometric
                  with respect to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                      %annotation{:encoding => "application/x-tex"} h
                  i.e.
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi h
                          %mo{:stretchy => "false"} (
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi w
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi h
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi w
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} h(\rho(g)(v),\rho(g)(w)) = h(v,w)
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi V
                        %mo →
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                      %annotation{:encoding => "application/x-tex"} f: V \to \R
                  that is
                  = succeed "-invariant," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ρ
                        %annotation{:encoding => "application/x-tex"} \rho
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} f(\rho(g)(v))=f(v)
          .un_def
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              be a principal
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi h
                    %mo ,
                    %mi ρ
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{T} =(V,h,\rho,f)
              be a matter type for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %em
                field for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                of type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒯
                    %annotation{:encoding => "application/x-tex"} \mathcal{T}
              is a smooth
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi M
                      %mo →
                      %mi P
                      %msub
                        %mo ×
                        %mi ρ
                      %mi V
                    %annotation{:encoding => "application/x-tex"} \phi: M \to P \times_{\rho} V
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi 𝒯
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mo ∫
                      %mi M
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} ‖
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi{:mathvariant => "normal"} D
                      %mi ω
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mo{:stretchy => "false"} ‖
                      %mi h
                      %mn 2
                    %mo +
                    %mo ⋆
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    S_{\mathcal{T}}(\omega,\phi) := \int_M  \;\|\, \mathrm{D}^{\omega}(\phi)\, \|^2_{h}  +  \star (f \circ \phi) \text{.}
          .un_theorem
            %h6#theorem_2 Theorem
            %p
              The action functional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} S_{\mathcal{T}}
              is gauge invariant, i.e.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi 𝒯
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi g
                      %mo *
                    %mi ω
                    %mo ,
                    %msup
                      %mi g
                      %mo *
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi S
                      %mi 𝒯
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    S_{\mathcal{T}}(g^{*}\omega,g^{*}\phi) = S_{\mathcal{T}}(\omega,\phi)
            %p
              for all gauge transformations
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi P
                      %mo →
                      %mi P
                    %annotation{:encoding => "application/x-tex"} g:P \to P
          .proof
            %h6#proof_2 Proof
            %p
              One calculates that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mo *
                      %mi ω
                      %mo =
                      %msubsup
                        %mi{:mathvariant => "normal"} Ad
                        %mover
                          %mi g
                          %mo{:stretchy => "false"} ˜
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi ω
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msup
                        %mover
                          %mi g
                          %mo{:stretchy => "false"} ˜
                        %mo *
                      %mover
                        %mi θ
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} g^{*}\omega = \mathrm{Ad}_{\tilde g}^{-1}(\omega) - \tilde g^{*}\bar\theta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi g
                      %mo{:stretchy => "false"} ˜
                    %mo :
                    %mi P
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \tilde g:P \to G
              is the smooth map associated to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              via
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi p
                      %mo ⋅
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g(p) = p\cdot  \tilde g(p)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mo *
                      %mi ψ
                      %mo =
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mover
                          %mi g
                          %mo{:stretchy => "false"} ˜
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g^{*}\psi = \rho(\tilde g^{-1})(\psi)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} d
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mo *
                    %mover
                      %mi θ
                      %mo{:stretchy => "false"} ¯
                    %msub
                      %mo ∧
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi ρ
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mtext ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{d}(\rho(\tilde g^{-1})(\psi)) = \rho(\tilde g^{-1})(\mathrm{d}\psi) + \tilde g^{*}\bar\theta\wedge_{\mathrm{d}\rho} \rho(\tilde g^{-1})(\psi)\text{,}
            %p
              where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} d
                      %mi ρ
                      %mo :
                      %mi 𝔤
                      %mo ⊗
                      %mi V
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} \mathrm{d}\rho: \mathfrak{g} \otimes V \to V
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %msup
                      %mi{:mathvariant => "normal"} d
                      %mrow
                        %msup
                          %mi g
                          %mo *
                        %mi ω
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi g
                      %mo *
                    %mi ψ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \quad\quad\mathrm{d}^{g^{*}\omega}(g^{*}\psi)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %mo =
                    %mi{:mathvariant => "normal"} d
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msup
                      %mi g
                      %mo *
                    %mi ω
                    %msub
                      %mo ∧
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi ρ
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \quad\quad\quad\quad= \mathrm{d}\rho(\tilde g^{-1},\psi) + g^{*}\omega \wedge_{\mathrm{d}\rho} \rho(\tilde g^{-1},\psi)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %mo =
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi{:mathvariant => "normal"} d
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mo *
                    %mover
                      %mi θ
                      %mo{:stretchy => "false"} ¯
                    %msub
                      %mo ∧
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi ρ
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} Ad
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo −
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mo *
                    %mover
                      %mi θ
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ∧
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi ρ
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \quad\quad\quad\quad= \rho(\tilde g^{-1},\mathrm{d}\psi) + \tilde g^{*}\bar\theta\wedge_{\mathrm{d}\rho} \rho(\tilde g^{-1},\psi) + (\mathrm{Ad}_{\tilde g}^{-1}(\omega) - \tilde g^{*}\bar\theta) \wedge_{\mathrm{d}\rho} \rho(\tilde g^{-1},\psi)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %mo =
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi{:mathvariant => "normal"} d
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %mi ω
                    %msub
                      %mo ∧
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi ρ
                    %mi ψ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \quad\quad\quad\quad= \rho(\tilde g^{-1},\mathrm{d}\psi)  + \rho(\tilde g^{-1},\omega\wedge_{\mathrm{d}\rho} \psi)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %mspace{:width => "1em"}
                    %mo =
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %msup
                      %mi{:mathvariant => "normal"} d
                      %mi ω
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mtext .
                  %annotation{:encoding => "application/x-tex"} \quad\quad\quad\quad= \rho(\tilde g^{-1},\mathrm{d}^{\omega}\psi)\text{.}
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is invariant, the invariance of the first term follows. The invariance of the second term is clear.
          .un_remark
            %h6#remark_4 Remark
            %p
              One can either keep a connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              fixed and consider
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi ω
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi S
                      %mi 𝒯
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    S_{\omega}(\phi) := S_{\mathcal{T}}(\omega,\phi)
            %p as a matter field in an “external gauge field”, or consider the combined action functional
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi S
                      %mrow
                        %mi Y
                        %mspace{:width => "negativethinmathspace"}
                        %mi M
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msub
                      %mi S
                      %mi 𝒯
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    S(\omega,\phi) := S_{Y\!M}(\omega) + S_{\mathcal{T}}(\omega,\phi)\text{.}
          .un_example
            %h6#example_2 Example
            %p
              %strong (Scalar particle in an external, trivial gauge field)
            %p
              We consider
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo =
                      %mrow
                        %mo {
                        %mi e
                        %mo }
                    %annotation{:encoding => "application/x-tex"} G=\left \lbrace e \right \rbrace
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo =
                      %mi M
                    %annotation{:encoding => "application/x-tex"} P=M
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \omega=0
              %em scalar field
              is field for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              of matter type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                    %mo ,
                    %mi h
                    %mo ,
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\R,h,\id,f)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mfrac
                      %mn 1
                      %mn 2
                    %msup
                      %mi m
                      %mn 2
                    %msup
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f(x) := -\frac{1}{2}m^2x^2
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                      %mi y
                    %annotation{:encoding => "application/x-tex"} h(x,y) = x y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mo ∫
                      %mi M
                    %mo{:stretchy => "false"} ‖
                    %mi{:mathvariant => "normal"} d
                    %mi ϕ
                    %msubsup
                      %mo{:stretchy => "false"} ‖
                      %mi h
                      %mn 2
                    %mo +
                    %mo ⋆
                    %msup
                      %mi m
                      %mn 2
                    %msup
                      %mi ϕ
                      %mn 2
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    S(0,\phi) =\frac{1}{2} \int_M  \| \mathrm{d}\phi \|_h^2 +\star m^{2}\phi^2\text{.}
            %p
              The Euler-Lagrange equation is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ▵
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msup
                      %mi m
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mi ϕ
                    %mo =
                    %mn 0
                    %mtext ,
                  %annotation{:encoding => "application/x-tex"}
                    (\triangle + m^2)\phi = 0\text{,}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ▵
                    %mo :
                    %mo =
                    %mi δ
                    %mo ∘
                    %mi{:mathvariant => "normal"} d
                    %mo :
                    %msup
                      %mi Ω
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \triangle := \delta \circ \mathrm{d}: \Omega^k(M) \to \Omega^{k}(M)
              is the Laplace operator and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo :
                    %mo =
                    %mo ⋆
                    %mi{:mathvariant => "normal"} d
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \delta := \star \mathrm{d} \star
              is the exterior coderivative.
          .un_example
            %h6#example_3 Example
            %p
              %strong
                (Charged particle in an electromagnetic field, e.g. a
                = succeed "-meson)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi π
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %annotation{:encoding => "application/x-tex"} \pi^{-}
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              be a
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %em
                field of charge
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Z
                    %annotation{:encoding => "application/x-tex"} n \in \Z
              is a field for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              of matter type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                      %mo ,
                      %mi h
                      %mo ,
                      %msub
                        %mi ρ
                        %mi n
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\C,h,\rho_n,f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi n
                    %mo :
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                    %mo →
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                  %annotation{:encoding => "application/x-tex"} \rho_n: U(1) \times \C \to \C
              is defined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo ,
                    %mi z
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msup
                      %mi z
                      %mi n
                    %mi z
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \rho_n(z,z') := z^n z'
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mfrac
                        %mn 1
                        %mn 2
                      %msup
                        %mi m
                        %mn 2
                      %mo{:stretchy => "false"} |
                      %mi z
                      %msup
                        %mo{:stretchy => "false"} |
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f(z) := -\frac{1}{2}m^2|z|^2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mo ∫
                      %mi M
                    %mo{:stretchy => "false"} ‖
                    %msup
                      %mi{:mathvariant => "normal"} D
                      %mi ω
                    %mi ϕ
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mn 2
                    %mo +
                    %mo ⋆
                    %msup
                      %mi m
                      %mn 2
                    %mo{:stretchy => "false"} ‖
                    %mi ϕ
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mn 2
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    S(\omega,\phi) =\frac{1}{2} \int_M  \| \mathrm{D}^{\omega}\phi \|^2 +\star m^{2} \| \phi \| ^2\text{.}
            %p
              The Euler-Lagrange equation is
              %em covariant Klein-Gordon equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ▵
                      %mi ω
                    %mo +
                    %msup
                      %mi m
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mi ϕ
                    %mo =
                    %mn 0
                    %mtext ,
                  %annotation{:encoding => "application/x-tex"}
                    (\triangle^{\omega} +m^2) \phi = 0\text{,}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ▵
                      %mi ω
                    %mo :
                    %mo =
                    %msup
                      %mi δ
                      %mi ω
                    %mo ∘
                    %msup
                      %mi{:mathvariant => "normal"} D
                      %mi ω
                  %annotation{:encoding => "application/x-tex"} \triangle^{\omega} :=\delta^{\omega}\circ \mathrm{D}^{\omega}
              is the
              %em covariant Laplace operator
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi δ
                      %mi ω
                    %mo :
                    %mo =
                    %mo ⋆
                    %msup
                      %mi{:mathvariant => "normal"} D
                      %mi ω
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \delta^{\omega} := \star \mathrm{D}^{\omega} \star
              is the
              = succeed "." do
                %em exterior covariant coderivative
          %h2#matter_fields_with_spin Matter Fields with Spin
          %p
            The
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
            %a.existingWikiWord{:href => "/nlab/show/Schr%C3%B6dinger+equation"} Schrödinger equation
            – of second order on time. Dirac’s motivation was to find a first order equation which upon iteration yields the Klein-Gordon equation. We first discuss free
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
          %h3#free_spinors Free Spinors
          .un_example
            %h6#example_4 Example
            %p
              We recall some facts about
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            %ul
              %li
                %p
                  We denote by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C(p,q)
                  the Clifford algebra on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                            %mrow
                              %mi p
                              %mo ,
                              %mi q
                        %annotation{:encoding => "application/x-tex"} \R^{p,q}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                      %annotation{:encoding => "application/x-tex"} \R^{p+q}
                  by the ideal generated by
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                          %mo ⊗
                          %mi w
                          %mo +
                          %mi w
                          %mo ⊗
                          %mi v
                          %mo +
                          %mn 2
                          %mrow
                            %mo ⟨
                            %mi v
                            %mo ,
                            %mi w
                            %mo ⟩
                          %mo ⋅
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} v \otimes w + w \otimes v + 2 \left \langle v,w  \right \rangle\cdot 1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo ⟨
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ⟩
                      %annotation{:encoding => "application/x-tex"} \left \langle -,-  \right \rangle
                  is the Minkowski scalar product of signature
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (p,q)
              %li
                %p
                  The map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo ↦
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi v
                      %annotation{:encoding => "application/x-tex"} v \mapsto -v
                  extends to an anti-automorphism
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi α
                          %mo :
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \alpha: C(p,q) \to C(p,q)
                  = succeed "-grading" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} Z
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \Z_2
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} C(p,q)
              %li
                %p
                  We have
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi dim
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msup
                            %mn 2
                            %mrow
                              %mi p
                              %mo +
                              %mi q
                        %annotation{:encoding => "application/x-tex"} \dim C(p,q) = 2^{p+q}
              %li
                %p
                  The Clifford algebra inherits a
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi w
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi v
                            %mi tr
                          %mi w
                          %msub
                            %mo{:stretchy => "false"} )
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} H(v,w) := (v^{tr}w)_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi tr
                      %annotation{:encoding => "application/x-tex"} ()^{tr}
                  is the anti-automorphism of the tensor algebra that reverts the order of
                  = succeed "s," do
                    %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo{:stretchy => "false"} )
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} ()_0
                  denotes the degree 0 part.
              %li
                %p
                  We denote by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SO(p,q)
                  the group of linear maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo →
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                      %annotation{:encoding => "application/x-tex"} \R^{p+q}\to \R^{p+q}
                  that preserve the product
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo ⟨
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ⟩
                        %annotation{:encoding => "application/x-tex"} \left \langle -,-  \right \rangle
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
                        %mrow
                          %mo {
                          %msub
                            %mi v
                            %mn 1
                          %mo ⋅
                          %mo .
                          %mo .
                          %mo .
                          %mo ⋅
                          %msub
                            %mi v
                            %mrow
                              %mn 2
                              %mi r
                          %mo ∈
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %msub
                            %mi v
                            %mi i
                          %mo ∈
                          %msup
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                            %mrow
                              %mi p
                              %mo +
                              %mi q
                          %mo ,
                          %mo{:stretchy => "false"} ‖
                          %msub
                            %mi v
                            %mi i
                          %mo{:stretchy => "false"} ‖
                          %mo =
                          %mn 1
                          %mo ,
                          %mi r
                          %mo ∈
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} N
                          %mo }
                        %mtext .
                      %annotation{:encoding => "application/x-tex"}
                        Spin(p,q) := \left \lbrace v_{1}\cdot ... \cdot v_{2r}\in C(p,q)\mid v_i \in \R^{p+q}, \| v_i \|=1,r \in \N \right \rbrace \text{.}
                %p
                  Then, we define a group homomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Λ
                        %mo :
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Lambda: Spin(p,q) \to SO(p,q)
                  by
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Λ
                          %mo{:stretchy => "false"} (
                          %mi φ
                          %mo{:stretchy => "false"} )
                          %mi v
                          %mo =
                          %mi α
                          %mo{:stretchy => "false"} (
                          %mi φ
                          %mo{:stretchy => "false"} )
                          %mi v
                          %msup
                            %mi φ
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} \Lambda(\varphi)v = \alpha(\varphi) v \varphi^{-1}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo →
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} Z
                          %mn 2
                        %mo →
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mn 1
                        %mtext .
                      %annotation{:encoding => "application/x-tex"}
                        1 \to \Z_2 \to Spin(p,q) \to SO(p,q) \to 1\text{.}
              %li
                %p
                  We denote by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                      %annotation{:encoding => "application/x-tex"} \C(p,q) := C(p,q) \otimes_{\R} \C
                  the complexification of the Clifford algebra. The bilinear form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C(p,q)
                  extends to a sesquilinear form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \C(p,q)
                  defined by
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi w
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi v
                            %mi tr
                          %mover
                            %mi w
                            %mo{:stretchy => "false"} ¯
                          %msub
                            %mo{:stretchy => "false"} )
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} H(v,w)=(v^{tr}\bar w)_0
              %li
                %p
                  Multiplication in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \C(p,q)
                  restricts to an action of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} spin
                        %mrow
                          %mi p
                          %mo ,
                          %mi q
                      %annotation{:encoding => "application/x-tex"} \spin{p,q}
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \C(p,q)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \C(p,q)
                  into
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  copies of a subrepresentation
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                        %annotation{:encoding => "application/x-tex"} \Sigma
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi Σ
                        %mo ⊕
                        %mo .
                        %mo .
                        %mo .
                        %mo ⊕
                        %mi Σ
                        %mtext .
                      %annotation{:encoding => "application/x-tex"}
                        \\C(p,q) = \Sigma \oplus ... \oplus  \Sigma \text{.}
              %li
                %p
                  The representation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                  is isometric with respect to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                      %annotation{:encoding => "application/x-tex"} p+q
                  is odd,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo =
                          %msup
                            %mn 2
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo +
                              %mi q
                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mn 2
                        %annotation{:encoding => "application/x-tex"} k=2^{(p+q-1)/2}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
                  is irreducible. If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                      %annotation{:encoding => "application/x-tex"} p+q
                  is even,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo =
                          %msup
                            %mn 2
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo +
                              %mi q
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mn 2
                        %annotation{:encoding => "application/x-tex"} k=2^{(p+q)/2}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                        %mo =
                        %msup
                          %mi Σ
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo ⊕
                        %msup
                          %mi Σ
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %annotation{:encoding => "application/x-tex"} \Sigma = \Sigma^{+} \oplus \Sigma^{-}
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Σ
                          %mo ±
                      %annotation{:encoding => "application/x-tex"} \Sigma^{\pm}
                  irreducible and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi dim
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                          %msup
                            %mi Σ
                            %mo ±
                          %mo =
                          %msup
                            %mn 2
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo +
                              %mi q
                              %mo −
                              %mn 2
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mn 2
                        %annotation{:encoding => "application/x-tex"} \dim_{\C}\Sigma^{\pm}=2^{(p+q-2)/2}
          .un_remark
            %h6#remark_5 Remark
            %p
              We also need some facts about
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
            %ul
              %li
                %p
                  Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                  with
                  %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"} pseudo-Riemannian metric
                  of
                  %a.existingWikiWord{:href => "/nlab/show/signature"} signature
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (p,q)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi FM
                      %annotation{:encoding => "application/x-tex"} FM
                  the principal
                  = succeed "-bundle" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SO(p,q)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                  of orthonormal frames, the
                  = succeed "." do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
              %li
                %p
                  A
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                  is a principal
                  = succeed "-bundle" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(p,q)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SM
                      %annotation{:encoding => "application/x-tex"} SM
                  over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                  together with a bundle morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                        %mo :
                        %mi SM
                        %mo →
                        %mi FM
                      %annotation{:encoding => "application/x-tex"} \lambda: SM \to FM
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ⋅
                        %mi φ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi λ
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi Λ
                        %mo{:stretchy => "false"} (
                        %mi φ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \lambda(X\cdot\varphi) = \lambda(X)\cdot\Lambda(\varphi)
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi SM
                      %annotation{:encoding => "application/x-tex"} X\in SM
                  and all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi φ
                          %mo ∈
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \varphi\in Spin(p,q)
              %li
                %p
                  Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi FM
                        %mo ,
                        %mi 𝔰𝔬
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \theta \in \Omega^1(FM,\mathfrak{so}(p,q))
                  be the Levi-Cevita connection on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi FM
                        %annotation{:encoding => "application/x-tex"} FM
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Θ
                        %mo :
                        %mo =
                        %mi{:mathvariant => "normal"} d
                        %msup
                          %mi Λ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi λ
                          %mo *
                        %mi θ
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi SM
                        %mo ,
                        %mi 𝔰𝔭𝔦𝔫
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\Theta := \mathrm{d}\Lambda^{-1}(\lambda^{*}\theta) \in \Omega^1(SM,\mathfrak{spin}(p,q))
                %p
                  is a connection on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SM
                        %annotation{:encoding => "application/x-tex"} SM
          .un_remark
            %h6#remark_6 Remark
            %p
              Finally, we recall the definition of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
            %ul
              %li
                %p
                  Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mo :
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi V
                        %mo →
                        %mi V
                      %annotation{:encoding => "application/x-tex"} \rho: C(p,q) \times V \to V
                  be a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/representation"} representation
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                          %mo ⊂
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} V \subset \C(p,q)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(p,q)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                      %annotation{:encoding => "application/x-tex"} \rho
                  restricts to a representation of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(p,q)
                  %em spinor bundle
                  is the vector bundle
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                          %mi M
                          %mo :
                          %mo =
                          %mi SM
                          %msub
                            %mo ×
                            %mi ρ
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V M := SM \times_{\rho} V
              %li
                %p
                  %em Clifford multiplication
                  is a map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi TM
                        %mo ⊗
                        %mi V
                        %mi M
                        %mo →
                        %mi V
                        %mi M
                        %mo :
                        %mi u
                        %mo ⊗
                        %mi s
                        %mo ↦
                        %mi u
                        %mo ⋅
                        %mi s
                        %mtext .
                      %annotation{:encoding => "application/x-tex"}
                        TM \otimes V M \to V M: u \otimes s \mapsto u \cdot s\text{.}
                %p
                  It is defined as follows. We write
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} s=(X,v)
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi SM
                      %annotation{:encoding => "application/x-tex"} X\in SM
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                          %mo ∈
                          %mi V
                        %annotation{:encoding => "application/x-tex"} v\in V
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi α
                            %mi X
                          %mo :
                          %mo =
                          %mi λ
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mi TM
                          %mo →
                          %msup
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \alpha_X := \lambda(X): TM \to \R^n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi α
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \alpha_X(u) \in \C(p,q)
                  and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mo ⋅
                        %mi s
                        %mo :
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msub
                          %mi α
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mtext .
                      %annotation{:encoding => "application/x-tex"}
                        u \cdot s := (X,\alpha_X(u)\cdot v)\text{.}
                %p
                  One can show using above-listed properties of the Clifford algebra that this definition does not depend on the choice of the representative
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X,v)
              %li
                %p
                  The
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
                  is
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo :
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo ,
                        %mi V
                        %mi M
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo ,
                        %mi V
                        %mi M
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi ψ
                        %mo ↦
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi i
                        %msub
                          %mi e
                          %mi i
                        %mo ⋅
                        %msup
                          %mi{:mathvariant => "normal"} D
                          %mi Θ
                        %mi ψ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi e
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        D: \Gamma(M,V M) \to \Gamma(M,V M) : \psi \mapsto \sum_{i} e_i \cdot  \mathrm{D}^{\Theta}\psi (e_i)
                %p
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi e
                          %mi i
                        %mo ∈
                        %mi TM
                      %annotation{:encoding => "application/x-tex"} e_i\in TM
                  runs over a local orthonormal basis.
          .un_def
            %h6#definition_5 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be a spacetime with spin structure
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SM
                    %annotation{:encoding => "application/x-tex"} SM
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(p,q)
              as a Yang-Mills theory over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %em free spinor
              is a field for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SM
                  %annotation{:encoding => "application/x-tex"} SM
              of type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi h
                      %mo ,
                      %mi ρ
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V,h,\rho,f)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ⊂
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V \subset \C(p,q)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mtext ,
                  %annotation{:encoding => "application/x-tex"}
                    h(v,w):=\frac{1}{2}(H(v,w) + H(w,v))\text{,}
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              is the restriction of the multiplication in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \C(p,q)
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(p,q)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mo ∫
                      %mi M
                    %mi D
                    %mi ψ
                    %msub
                      %mo ∧
                      %mi h
                    %mo ⋆
                    %mi ψ
                    %mo +
                    %mo ⋆
                    %mi f
                    %mo ∘
                    %mi ψ
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    S(\psi) := \int_M D \psi \wedge_{h} \star \psi  + \star f \circ \psi\text{.}
          .un_def
            %h6#definition_6 Definition
            %p
              The Euler-Lagrange equation determined by the action functional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(\psi)
              is the
              %em Dirac equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mi ψ
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi m
                    %mi ψ
                    %mo =
                    %mn 0
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    D\psi + \mathrm{i}m\psi = 0\text{.}
          .un_def
            %h6#definition_7 Definition
            %p
              %strong (Weyl spinors)
            %p
              We assume spacetime to have even dimension.
              %em
                %a.existingWikiWord{:href => "/nlab/show/Weyl+spinor"}> Weyl spinor
                s
              have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %msup
                        %mi Σ
                        %mo ±
                    %annotation{:encoding => "application/x-tex"} V=\Sigma^{\pm}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi dim
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \dim_{\C}(V)=2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f=0
              (they are massless). In the standard model, neutrinos are left-handed Weyl spinors.
          .un_def
            %h6#definition_8 Definition
            %p
              %strong (Dirac spinors)
            %p
              We assume spacetime to have signature
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1,3)
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Dirac+spinor"} Dirac spinor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %msup
                        %mi Σ
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mo ⊕
                      %msup
                        %mi Σ
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %annotation{:encoding => "application/x-tex"} V=\Sigma^{+} \oplus \Sigma^{-}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi dim
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} \dim_{\C}(V)=4
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is taken to be
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi mh
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(v)=-mh(v,v)
          .un_remark
            %h6#remark_7 Remark
            %p
              In the physical literature, the picture is slightly different: The representation space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              of a spinor is not a subspace of the Clifford algebra, but rather
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \C^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \C^n
              to the Clifford bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi VM
                  %annotation{:encoding => "application/x-tex"} VM
              using a representation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \C(p,q)
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \C^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)=(1,3)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %msup
                        %mi Σ
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mo ⊕
                      %msup
                        %mi Σ
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %annotation{:encoding => "application/x-tex"} V= \Sigma^{+} \oplus \Sigma^{-}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(1,3)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SL
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SL(2,\C)
            %ul
              %li
                %p
                  One starts with the following representation
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi γ
                          %mo :
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 3
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi{:mathvariant => "normal"} Gl
                          %mo{:stretchy => "false"} (
                          %mn 4
                          %mo ,
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \gamma: \C(1,3) \to \mathrm{Gl}(4,\C)
                  = succeed "-linear" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                        %annotation{:encoding => "application/x-tex"} \R
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo :
                        %msup
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                          %mn 4
                        %mo →
                        %mi{:mathvariant => "normal"} Gl
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mo ,
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi v
                        %mo ↦
                        %mrow
                          %mo (
                          %mrow
                            %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                              %mtr
                                %mtd
                                  %mn 0
                                %mtd
                                  %mi v
                                  %mo ′
                              %mtr
                                %mtd
                                  %mi v
                                  %mo ″
                                %mtd
                                  %mn 0
                          %mo )
                        %mtext ,
                      %annotation{:encoding => "application/x-tex"}
                        \\gamma: \R^4 \to \mathrm{Gl}(4,\C): v \mapsto \begin{pmatrix} 0 &amp; v' \\
                        v'' &amp; 0
                        \\end{pmatrix}\text{,}
                %p where
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo ′
                        %mo :
                        %mo =
                        %mrow
                          %mo (
                          %mrow
                            %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                              %mtr
                                %mtd
                                  %msub
                                    %mi v
                                    %mn 0
                                  %mo +
                                  %msub
                                    %mi v
                                    %mn 3
                                %mtd
                                  %msub
                                    %mi v
                                    %mn 1
                                  %mo −
                                  %msub
                                    %mi iv
                                    %mn 2
                              %mtr
                                %mtd
                                  %msub
                                    %mi v
                                    %mn 1
                                  %mo +
                                  %msub
                                    %mi iv
                                    %mn 2
                                %mtd
                                  %msub
                                    %mi v
                                    %mn 0
                                  %mo −
                                  %msub
                                    %mi v
                                    %mn 3
                              %mtr
                                %mtd
                          %mo )
                        %mspace{:width => "1em"}
                        %mtext and
                        %mspace{:width => "1em"}
                        %mi v
                        %mo ″
                        %mo =
                        %mrow
                          %mo (
                          %mrow
                            %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                              %mtr
                                %mtd
                                  %msub
                                    %mi v
                                    %mn 0
                                  %mo −
                                  %msub
                                    %mi v
                                    %mn 3
                                %mtd
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %msub
                                    %mi v
                                    %mn 1
                                  %mo +
                                  %msub
                                    %mi iv
                                    %mn 2
                              %mtr
                                %mtd
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %msub
                                    %mi v
                                    %mn 1
                                  %mo −
                                  %msub
                                    %mi iv
                                    %mn 2
                                %mtd
                                  %msub
                                    %mi v
                                    %mn 0
                                  %mo +
                                  %msub
                                    %mi v
                                    %mn 3
                              %mtr
                                %mtd
                          %mo )
                        %mtext .
                      %annotation{:encoding => "application/x-tex"}
                        v' := \begin{pmatrix} v_0 + v_3 &amp; v_1 - iv_2 \\
                        v_1 + iv_2 &amp; v_0 - v_3 \\
                        \\end{pmatrix}
                        \\quad\text{ and }\quad
                        v'' = \begin{pmatrix} v_0-v_3 &amp; -v_1 + iv_2 \\
                        \-v_1-iv_2 &amp; v_0+v_3 \\
                        \\end{pmatrix}\text{.}
                %p
                  It satisfies
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi γ
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi γ
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mrow
                            %mo ⟨
                            %mi v
                            %mo ,
                            %mi v
                            %mo ⟩
                          %msub
                            %mi I
                            %mn 4
                        %annotation{:encoding => "application/x-tex"} \gamma(v) \cdot \gamma(v)= - \left \langle v,v  \right \rangle I_4
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                      %annotation{:encoding => "application/x-tex"} \gamma
                  extends uniquely to a representation of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 3
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \C(1,3)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi e
                          %mn 0
                        %mo ,
                        %mo .
                        %mo .
                        %mo .
                        %mo ,
                        %msub
                          %mi e
                          %mn 3
                      %annotation{:encoding => "application/x-tex"} e_0,...,e_3
                  are often called
                  = succeed "," do
                    %em
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi γ
                          %annotation{:encoding => "application/x-tex"} \gamma
                      \-matrices
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi γ
                            %mi k
                          %mo :
                          %mo =
                          %mi γ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi e
                            %mi k
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \gamma_k := \gamma(e_k)
              %li
                %p
                  The restriction of the representation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                      %annotation{:encoding => "application/x-tex"} \gamma
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mn 3
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(1,3)
                  is a representation
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ρ
                          %mo :
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 3
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %msup
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                            %mn 4
                          %mo →
                          %msup
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                            %mn 4
                        %annotation{:encoding => "application/x-tex"} \rho: Spin(1,3) \times \C^4 \to \C^4
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Σ
                          %mo +
                      %annotation{:encoding => "application/x-tex"} \Sigma^+
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Σ
                            %mo −
                        %annotation{:encoding => "application/x-tex"} \Sigma^-
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ρ
                          %mo ∘
                          %mi α
                          %mo =
                          %mi α
                        %annotation{:encoding => "application/x-tex"} \rho\circ\alpha = \alpha
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Λ
                        %mo :
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Lambda: Spin(p,q) \to SO(p,q)
                  that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo{:stretchy => "false"} (
                        %mi Λ
                        %mo{:stretchy => "false"} (
                        %mi φ
                        %mo{:stretchy => "false"} )
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi φ
                        %mo{:stretchy => "false"} )
                        %mi γ
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi φ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mtext .
                      %annotation{:encoding => "application/x-tex"}
                        \\gamma(\Lambda(\varphi)v) = \rho(\varphi)\gamma(v)\rho(\varphi)^{-1}\text{.}
              %li
                %p
                  The above mentioned identification between
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mn 3
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(1,3)
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SL
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SL(2,\C)
                  is
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mn 3
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi SL
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %mi v
                          %mn 1
                        %mo ⋅
                        %mo .
                        %mo .
                        %mo .
                        %mo ⋅
                        %msub
                          %mi v
                          %mrow
                            %mn 2
                            %mi r
                        %mo ↦
                        %msub
                          %mi v
                          %mn 1
                        %mo ′
                        %msub
                          %mi v
                          %mn 2
                        %mo ″
                        %msub
                          %mi v
                          %mn 3
                        %mo ′
                        %mo ⋅
                        %mo .
                        %mo .
                        %mo .
                        %mo ⋅
                        %msub
                          %mi v
                          %mrow
                            %mn 2
                            %mi r
                        %mo ″
                        %mtext .
                      %annotation{:encoding => "application/x-tex"}
                        Spin(1,3) \to SL(2,\C) : v_1 \cdot...\cdot v_{2r} \mapsto v_1'v_2''v_3'\cdot...\cdot v_{2r}''\text{.}
                %p
                  Under this isomorphism,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                      %annotation{:encoding => "application/x-tex"} \rho
                  becomes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mo :
                        %mi SL
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi{:mathvariant => "normal"} Gl
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mo ,
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi A
                        %mo ↦
                        %mrow
                          %mo (
                          %mrow
                            %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                              %mtr
                                %mtd
                                  %mi A
                                %mtd
                                  %mn 0
                              %mtr
                                %mtd
                                  %mn 0
                                %mtd
                                  %msup
                                    %mi A
                                    %mrow
                                      %mo *
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                          %mo )
                        %mtext .
                      %annotation{:encoding => "application/x-tex"}
                        \\rho: SL(2,\C) \to \mathrm{Gl}(4,\C) : A \mapsto \begin{pmatrix}A &amp; 0 \\
                        0 &amp; A^{*-1}
                        \\end{pmatrix}\text{.}
                %p
                  Under this identification, the splitting of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                      %annotation{:encoding => "application/x-tex"} \rho
                  into a direct sum yields the defining representation, often called
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi D
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo ,
                            %mn 0
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} D^{(1/2,0)}
                  and its conjugate, often called
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi D
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} D^{(0,1/2)}
              %li
                %p
                  Finally, the bilinear form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                  becomes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi w
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
                        %msup
                          %mi v
                          %mi{:mathvariant => "normal"} tr
                        %msub
                          %mi γ
                          %mn 0
                        %mover
                          %mi w
                          %mo{:stretchy => "false"} ¯
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        H(v,w) := v^{\mathrm{tr}}\gamma_0\bar w.
          .un_remark
            %h6#remark_8 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo =
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 3
                  %annotation{:encoding => "application/x-tex"} M=\R^{1,3}
              one can take the trivial spin structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SM
                      %mo =
                      %mi M
                      %mo ×
                      %mi SL
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SM=M \times SL(2,\C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              can be identified with a map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo :
                      %mi M
                      %mo →
                      %msup
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} \psi: M \to \C^4
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mi ψ
                      %mo =
                      %msup
                        %mi γ
                        %mi i
                      %msub
                        %mo ∂
                        %mi i
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} D \psi = \gamma^{i}\partial_i \psi
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi γ
                        %mi i
                      %mo :
                      %mo =
                      %msup
                        %mi η
                        %mi ik
                      %msub
                        %mi γ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \gamma^i := \eta^{ik}\gamma_k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi γ
                      %mi i
                    %msub
                      %mo ∂
                      %mi i
                    %mi ψ
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi m
                    %mi ψ
                    %mo =
                    %mn 0
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma^i\partial_i \psi + \mathrm{i} m\psi = 0\text{.}
            %p Let’s go back to Dirac’s orginial motivation. Dirac was looking for a first order differential equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi α
                      %mi k
                    %msub
                      %mo ∂
                      %mi k
                    %mi ψ
                    %mo +
                    %mi im
                    %mi ψ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha^k\partial_k\psi +im\psi=0
            %p
              for functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                      %mo :
                      %msup
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                        %mn 4
                      %mo →
                      %msup
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \psi: \R^{4} \to \C^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ▵
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msup
                      %mi m
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mi ψ
                    %mo =
                    %mn 0
                    %mtext ,
                  %annotation{:encoding => "application/x-tex"}
                    (\triangle + m^2)\psi = 0\text{,}
            %p
              where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ▵
                      %mo =
                      %msup
                        %mo ∂
                        %mi k
                      %msub
                        %mo ∂
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \triangle= \partial^k\partial_k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              is a solution to the first equation,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi α
                      %mi j
                    %msub
                      %mo ∂
                      %mi j
                    %msup
                      %mi α
                      %mi k
                    %msub
                      %mo ∂
                      %mi k
                    %mi ψ
                    %mo =
                    %msup
                      %mi α
                      %mi j
                    %msub
                      %mo ∂
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi im
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mi m
                      %mn 2
                    %mi ψ
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha^{j}\partial_j\alpha^k\partial_k \psi = \alpha^{j}\partial_j(-im\psi) = - m^2\psi\text{.}
            %p
              This is the Klein-Gordon equation, if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi α
                        %mi i
                      %msup
                        %mi α
                        %mi j
                      %mo =
                      %msup
                        %mi η
                        %mi ij
                    %annotation{:encoding => "application/x-tex"} \alpha^{i}\alpha^{j}=\eta^{ij}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi α
                        %mi i
                      %msup
                        %mi α
                        %mi j
                      %mo =
                      %msup
                        %mi η
                        %mi ij
                      %msub
                        %mi I
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \alpha^{i}\alpha^{j}=\eta^{ij}I_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mi ij
                    %msub
                      %mi I
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \eta^{ij}I_n
              is a symmetric matrix, this can be written as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi α
                      %mi i
                    %msup
                      %mi α
                      %mi j
                    %mo +
                    %msup
                      %mi α
                      %mi j
                    %msup
                      %mi α
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi η
                      %mi ij
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{1}{2}(\alpha^{i}\alpha^j + \alpha^j\alpha^i)= \eta^{ij}\text{.}
            %p
              The smallest matrices satisfying this relation are the above “gamma matrices”. If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} m=0
          .un_remark
            %h6#remark_9 Remark
            %p
              For a general spacetime
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mn 2
                      %mo ≠
                      %mo ▵
                    %annotation{:encoding => "application/x-tex"} D^2 \neq \triangle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} D^2
              is given by the
              %em Lichnerowiz formula
              which has in fact been proved first by Schrödinger. So, Dirac’s motivation actually fails for “curved spacetimes”.
          %h3#charged_spinors Charged Spinors
          .un_remark
            %h6#remark_10 Remark
            %p
              %strong (Bundle Splicing)
            %ul
              %li
                %p
                  Consider principal
                  = succeed "-bundles" do
