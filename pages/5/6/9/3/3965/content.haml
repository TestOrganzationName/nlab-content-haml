                    %annotation{:encoding => "application/x-tex"} (V,h,\rho_{SM} \times \rho_P,f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊂
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \subset \C(p,q)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is given as before. Its action functional is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mo ∫
                      %mi M
                    %msup
                      %mi D
                      %mi ω
                    %mi ψ
                    %msub
                      %mo ∧
                      %mi h
                    %mo ⋆
                    %mi ψ
                    %mo +
                    %mo ⋆
                    %mi f
                    %mo ∘
                    %mi ψ
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    S(\omega, \psi) := \int_M D^{\omega} \psi \wedge_{h} \star \psi    + \star f \circ \psi\text{.}
          .un_def
            %h6#definition_10 Definition
            %p
              %strong (Spinor in an electromagnetic field)
            %p
              Here,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi SM
                    %mo :
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi{:mathvariant => "normal"} Gl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho_{SM}: Spin(p,q) \to \mathrm{Gl}(V)
              is some representation, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi P
                    %mo :
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi{:mathvariant => "normal"} Gl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho_P: U(1) \to \mathrm{Gl}(V)
              is given by complex multiplication with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi z
                        %mi n
                    %annotation{:encoding => "application/x-tex"} z^{n}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Z
                  %annotation{:encoding => "application/x-tex"} n\in \Z
              is the charge of the spinor. Obviously
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi SM
                  %annotation{:encoding => "application/x-tex"} \rho_{SM}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi P
                  %annotation{:encoding => "application/x-tex"} \rho_P
              commute. The Euler-Lagrange equation is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi ω
                    %mi ψ
                    %mo +
                    %mi im
                    %mi ψ
                    %mo =
                    %mn 0
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    D^{\omega}\psi + im\psi = 0\text{.}
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo =
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 3
                  %annotation{:encoding => "application/x-tex"} M=\R^{1,3}
              one can take
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SM
                      %mo =
                      %mi M
                      %mo ×
                      %mi SL
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SM=M \times SL(2,\C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              with a smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo :
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                      %mrow
                        %mn 3
                        %mo ,
                        %mn 1
                    %mo →
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} C
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \psi: \R^{3,1} \to \C^4
              and the connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              with a 1-form with components
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi i
                    %annotation{:encoding => "application/x-tex"} A_{i}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi ω
                    %mi ψ
                    %mo =
                    %msup
                      %mi γ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi i
                    %mo +
                    %msub
                      %mi A
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mi ψ
                    %mtext .
                  %annotation{:encoding => "application/x-tex"}
                    D^{\omega}\psi = \gamma^{i}(\partial_{i} + A_i)\psi\text{.}
            %p
              This gives the “
              %a.existingWikiWord{:href => "/nlab/show/Dirac+equation"}> Dirac equation
              ” one usually finds in a textbook.
