                        %mrow
                          %msub
                            %mi G
                            %mi k
                        %annotation{:encoding => "application/x-tex"} G_k
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi P
                          %mi k
                      %annotation{:encoding => "application/x-tex"} P_k
                  over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
