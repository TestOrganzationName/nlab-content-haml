                      %mrow
                        %msub
                          %mi ω
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \omega_1
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ω
                          %mn 2
