                  are connections on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi P
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} P_1
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi P
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} P_2
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ω
                          %mn 1
                        %mo ∘
                        %msub
                          %mi ω
                          %mn 2
                        %mo :
                        %mo =
                        %msubsup
                          %mi{:mathvariant => "normal"} pr
                          %mn 1
