                          %msub
                            %mi P
                            %mn 1
                          %mo ∘
                          %msub
                            %mi P
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} P_1 \circ P_2
              %li
                %p
                  Suppose
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
