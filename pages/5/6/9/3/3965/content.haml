                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi ω
                    %mo :
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi Σ
                    %mi M
                    %mo ∘
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
