              %a{:href => "http://users.cms.caltech.edu/~vidick/teaching/120_qcrypto/wiesner.pdf"}> original pdf
              ,
              = succeed ")" do
                %a{:href => "https://doi.org/10.1145/1008908.1008920"} doi:10.1145/1008908.1008920
          %p
