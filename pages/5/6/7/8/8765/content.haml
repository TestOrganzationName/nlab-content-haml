              %strong homogeneous
              if it contains a
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Θ
                      %mi A
                      %mi cov
                    %mo →
                    %msub
                      %mi Θ
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \Theta^{cov}_A \to \Theta_A
              of
              = succeed "-covers," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.maruku-ref{:href => "#CoversAndImmersions"}
              such that every morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Θ
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \Theta_A
              factors uniquely as an
              = succeed "-cover," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#CoversAndImmersions"}
              = succeed "." do
                %a.maruku-ref{:href => "#CoversAndImmersions"}
          %p
            (
            %a{:href => "#Berger"}> Berger, def. 1.15
            )
          %h2#properties Properties
          %h3#relation_to_graphs
            Relation to
            = succeed "-graphs" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          .num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              over the globular site is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to the category of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-graphs"} ∞-graphs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mi Graph
                    %mo ≃
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Θ
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega Graph \simeq Sh(\Theta_0)
                    \\,.
          %p
            (
            %a{:href => "#Berger"}> Berger, lemma 1.6
            )
          %h3#relation_to_globular_operads Relation to globular operads
          %p
            The (
            %a.existingWikiWord{:href => "/nlab/show/syntactic+categories"} syntactic categories
            of) homogenous globular theories, def.
            %a.maruku-ref{:href => "#HomogeneousTheory"}
            are the
            %a.existingWikiWord{:href => "/nlab/show/categories+of+operators"} categories of operators
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/globular+operads"} globular operads
          .num_prop
            %h6#proposition_2 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi A
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} \underline{A}
              on
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-graphs"} ∞-graphs
              encodes algebras over a
              %a.existingWikiWord{:href => "/nlab/show/globular+operad"} globular operad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              precisely if
            %ol
              %li
                %p
                  the induced globular theory
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Θ
                          %mi A
                        %mo ↪
                        %msub
                          %mi Alg
                          %munder
                            %mi A
                            %mo ̲
                      %annotation{:encoding => "application/x-tex"} \Theta_A \hookrightarrow Alg_{\underline{A}}
                  is homogeneous, def.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#HomogeneousTheory"}
              %li
                %p
                  every
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mi A
                            %mo ̲
                        %annotation{:encoding => "application/x-tex"} \underline{A}
                  %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"} algebras
                  factors uniquely into an
                  = succeed "-cover" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  = succeed "-free" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mi A
                            %mo ̲
                        %annotation{:encoding => "application/x-tex"} \underline{A}
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mi A
                            %mo ̲
                        %annotation{:encoding => "application/x-tex"} \underline{A}
          %p
            (
            %a{:href => "#Berger"}> Berger, prop. 1.16
            )
          %h2#examples Examples
          %h3#the_theory_of_categories
            The theory of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Theta+category"} Theta category
            itself, equipped with the definition inclusion
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Θ
                      %mn 0
                    %mo →
                    %mi Θ
                  %annotation{:encoding => "application/x-tex"} i \colon \Theta_0 \to \Theta
            = succeed "," do
              %a.maruku-ref{:href => "#CategoryOfGlobularSite"}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-categories"} ∞-categories
          %p In particular:
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Str
                    %mi ω
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Str\omega Cat
              of
              %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-categories"} strict ∞-categories
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to that of
              = succeed "-models," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Θ
                    %annotation{:encoding => "application/x-tex"} \Theta
              = succeed "." do
                %a.maruku-ref{:href => "#GlobularTheory"}
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of that of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-graphs"} ∞-graphs
              which satisfy the
              %a.existingWikiWord{:href => "/nlab/show/Segal+condition"} Segal condition
              with respect to the canonical inclusion
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Θ
                        %mn 0
                      %mo →
                      %mi Theta
                    %annotation{:encoding => "application/x-tex"} \Theta_0 \to Theta
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Str
                            %mi ω
                            %mi Cat
                          %mtd
                            %munderover
                              %mo →
                              %mo ≃
                              %mi N
                          %mtd
                            %msub
                              %mi Mod
                              %mi Θ
                          %mtd
                            %mo ↪
                          %mtd
                            %mi PSh
                            %mo{:stretchy => "false"} (
                            %mi Θ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi U
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi ω
                            %mi Graph
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Θ
                              %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %mi PSh
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Θ
                              %mn 0
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Str\omega Cat
                    \&amp;\underoverset{\simeq}{N}{\to}&amp; Mod_\Theta &amp;\hookrightarrow&amp;
                    PSh(\Theta)
                    \\\
                    \\downarrow^{\mathrlap{U}} &amp;&amp; \downarrow^{} &amp;&amp; \downarrow
                    \\\
                    \\omega Graph &amp;\stackrel{\simeq}{\to}&amp; Sh(\Theta_0) &amp;\hookrightarrow&amp; PSh(\Theta_0)
                    }
                    \\,.
          %p
            (
            %a{:href => "#Berger"}> Berger, theorem 1.12
            )
