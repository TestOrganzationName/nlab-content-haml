          %h2#definition Definition
          %p
            A
            %strong complex number
            is a
            %a.existingWikiWord{:href => "/nlab/show/number"} number
            of the form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a + \mathrm{i} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            are
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi{:mathvariant => "normal"} i
                    %mn 2
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \mathrm{i}^2 = - 1
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/imaginary+unit"} imaginary unit
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %p This can be thought of as:
          %ul
            %li
              the vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              made into an
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
              by the rule
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mi c
                      %mo −
                      %mi b
                      %mi d
                      %mo ,
                      %mi a
                      %mi d
                      %mo +
                      %mi b
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ;
                    %annotation{:encoding => "application/x-tex"} (a, b) \cdot (c, d) = (a c - b d, a d + b c) ;
            %li
              the subalgebra of those
              = succeed "-by-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
              real
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrices
              of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi a
                              %mtd
                                %mi b
                            %mtr
                              %mtd
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi b
                              %mtd
                                %mi a
                        %mo )
                      %mo ;
                    %annotation{:encoding => "application/x-tex"} \left(\array { a &amp; b \\ - b &amp; a } \right);
            %li
              the
              %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
              ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo{:stretchy => "false"} [
                    %mi{:mathvariant => "normal"} x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}[\mathrm{x}]
              modulo
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi{:mathvariant => "normal"} x
                        %mn 2
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathrm{x}^2 + 1
            %li
              the result of applying the
              %a.existingWikiWord{:href => "/nlab/show/Cayley%E2%80%93Dickson+construction"} Cayley–Dickson construction
              to
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %li
              the
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebra"} normed division algebra
              over
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %li
              the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Cl
                        %mrow
                          %mn 0
                          %mo ,
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cl_{0,1}(\mathbb{R})
            %li
              the elliptic
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/hypercomplex+numbers"} hypercomplex numbers
            %li
              the
              %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
              of
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %li
              In mathematics with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+countable+choice"} weak countable choice
              %a.existingWikiWord{:href => "/nlab/show/algebraic+closure"} algebraic closure
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              as a field;
          %p
            We think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            as a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            (in fact
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} {\mathbb{R}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            by identifying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a + \mathrm{i} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            is equipped with a
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/involution"} involution
            , called
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} i
                %annotation{:encoding => "application/x-tex"} \mathrm{i}
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi{:mathvariant => "normal"} i
                      %mo{:stretchy => "false"} ¯
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi{:mathvariant => "normal"} i
                  %annotation{:encoding => "application/x-tex"} \bar{\mathrm{i}} = -\mathrm{i}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi a
                        %mo +
                        %mi{:mathvariant => "normal"} i
                        %mi b
                      %mo ¯
                    %mo =
                    %mi a
                    %mo −
                    %mi{:mathvariant => "normal"} i
                    %mi b
                  %annotation{:encoding => "application/x-tex"} \overline{a + \mathrm{i} b} = a - \mathrm{i} b
          %p
            Complex conjugation is the nontrivial
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            which leaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} {\mathbb{R}}
            invariant. In other words, the Galois group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Gal
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} /
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Gal({\mathbb{C}}/\mathbb{R})
            is cyclic of order two and generated by complex conjugation.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            also has an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mrow
                    %mi a
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi b
                  %mo{:stretchy => "false"} |
                  %mo =
                  %msqrt
                    %mrow
                      %msup
                        %mi a
                        %mn 2
                      %mo +
                      %msup
                        %mi b
                        %mn 2
                  %mo ;
                %annotation{:encoding => "application/x-tex"}
                  |{a + \mathrm{i} b}| = \sqrt{a^2 + b^2} ;
          %p notice that the absolute value of a complex number is a nonnegative real number, with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi z
                  %msup
                    %mo{:stretchy => "false"} |
                    %mn 2
                  %mo =
                  %mi z
                  %mover
                    %mi z
                    %mo{:stretchy => "false"} ¯
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  |z|^2 = z \bar{z} .
          %p
            Most concepts in analysis can be extended from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            even works better, either because it is algebraically closed or because of Goursat's theorem. Even when the order in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            is important, often it is enough to order the absolute values of complex numbers. See
            %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            for some of the concepts whose precise definition may vary with the choice of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            (or even other possibilities).
          %h2#properties Properties
          %h3#automorphisms Automorphisms
          #AutomorphismsOfComplexNumbersIsZ2.num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              over the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Z%2F2"} Z/2
              %a.existingWikiWord{:href => "/nlab/show/action"} acting
              by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
          %p
            See also at
            = succeed "." do
              %em
                %a{:href => "normed+division+algebra#Automorphisms"} normed division algebra – automorphism
          %p
            Over other subfields, the automorphism group may be considerably larger. Over the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            has transcendence degree equal to the cardinality of the continuum, i.e., there is an algebraic extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}(X) \hookrightarrow \mathbb{C}
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi X
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mi 𝔠
                    %mo =
                    %msup
                      %mn 2
                      %mrow
                        %msub
                          %mi ℵ
                          %mn 0
                  %annotation{:encoding => "application/x-tex"} {|X|} = \mathfrak{c} = 2^{\aleph_0}
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} X \to X
            induces a field automorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℚ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}(X) \to \mathbb{Q}(X)
            which may be extended to an automorphism of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            is at least
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mn 2
                    %mi 𝔠
                %annotation{:encoding => "application/x-tex"} 2^\mathfrak{c}
            (and in fact at most this as well, since the number of functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C} \to \mathbb{C}
            is also
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 2
                      %mi 𝔠
                  %annotation{:encoding => "application/x-tex"} 2^\mathfrak{c}
          %p
            See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/automorphism+of+the+complex+numbers"} automorphism of the complex numbers
          %h3#geometry_of_complex_numbers Geometry of complex numbers
          %p
            The complex numbers form a plane, the
            = succeed "." do
              %strong complex plane
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo →
                  %msup
                    %mi ℝ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{C} \to \mathbb{R}^2
            given by sending
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} x
                  %mo +
                  %mi{:mathvariant => "normal"} i
                  %mi{:mathvariant => "normal"} y
                %annotation{:encoding => "application/x-tex"} \mathrm{x} + \mathrm{i}\mathrm{y}
            to the standard real-valued coordinates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} x
                  %mo ,
                  %mi{:mathvariant => "normal"} y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathrm{x},\mathrm{y})
            on this plane is a bijection. Much of
            %a.existingWikiWord{:href => "/nlab/show/complex+analysis"} complex analysis
            can be understood through
            %a.existingWikiWord{:href => "/nlab/show/differential+topology"} differential topology
            by identifying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} x
                %annotation{:encoding => "application/x-tex"} \mathrm{x}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} y
                %annotation{:encoding => "application/x-tex"} \mathrm{y}
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
