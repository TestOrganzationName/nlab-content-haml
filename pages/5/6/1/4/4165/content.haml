          %h2#in_set_theory In set theory
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/family"} family
              of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            consists of an
            %strong index set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            and, for each
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi k
                  %annotation{:encoding => "application/x-tex"} S_k
          %p
            Given
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} p\colon F \to I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi k
                %annotation{:encoding => "application/x-tex"} S_k
            to be the
            %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p^*(k)
          %p
            Conversely, given a family of sets, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            be the
            %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨄
                    %mi k
                  %msub
                    %mi S
                    %mi k
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi k
                  %mo ∈
                  %mi I
                  %mo ,
                  %mi x
                  %mo ∈
                  %msub
                    %mi S
                    %mi k
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \biguplus_k S_k = \{ (k,x) | k \in I, x \in S_k \}
          %p
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(k,x)
            be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            (We should talk about ways to formalise this concept in various forms of
            %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            and when the latter construction above requires the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+collection"} axiom of collection
          %h2#in_category_theory In category theory
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/family"} family
              of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            consists of an
            %a.existingWikiWord{:href => "/nlab/show/discrete+groupoid"} discrete groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            called the
            = succeed "," do
              %strong index set
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi I
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} F:I \to Set
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            is the large
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
          %h2#in_dependent_type_theory In dependent type theory
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/family"} family
              of
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            consists of a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            called the
            = succeed "," do
              %strong index type
            %a.existingWikiWord{:href => "/nlab/show/type+family"} type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S(x)
            indexed by elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x:I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S(x)
            is an
            %a.existingWikiWord{:href => "/nlab/show/h-set"} h-set
            by the typal
            %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
            definition or the typal
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            definition.
          %p
            Equivalently, it is a type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (I, S)
            which satisfies the familial
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
          %h2#inconsistency_of_the_universal_family_of_sets Inconsistency of the universal family of sets
          %p
            A
            %strong universal family of sets
            is a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            with a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            and a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo :
                  %mi U
                  %mo →
                  %mi I
                %annotation{:encoding => "application/x-tex"} E:U \to I
            such that for all sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mi A
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} i_A \in I
            and a
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi A
                  %mo :
                  %mi A
                  %mo ≅
                  %msup
                    %mi E
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi i
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \delta_A:A \cong E^*(i_A)
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to the
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi A
                  %annotation{:encoding => "application/x-tex"} i_A
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/set-theoretic+Girard%27s+paradox"} set-theoretic Girard's paradox
