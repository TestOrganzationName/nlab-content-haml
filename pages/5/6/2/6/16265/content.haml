          %title Without the axiom of choice
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            %a.existingWikiWord{:href => "/nlab/show/cardinal"} cardinal
            arithmetic. It uses the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            = succeed "," do
              %span.newWikiWord
                König's lemma
                %a{:href => "/nlab/new/K%C3%B6nig%27s+lemma"} ?
            %a.existingWikiWord{:href => "/nlab/show/dependent+choice"} dependent choice
            (and due to the son, Dénes Kőnig).
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong (König)
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi X
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|X|}
              be the cardinality of a set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi A
                        %mi i
                      %mo{:stretchy => "false"} |
                    %mo &lt;
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi B
                        %mi i
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|A_i|} \lt {|B_i|}
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i \in I
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi i
                        %msub
                          %mi A
                          %mi i
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mi i
                        %msub
                          %mi B
                          %mi i
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|\sum_i A_i|} \lt {|\prod_i B_i|}
          .proof
            %h6#proof Proof
            %p
              Suppose we have
              %em proper
              inclusions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi j
                      %mo :
                      %msub
                        %mi A
                        %mi j
                      %mo ↪
                      %msub
                        %mi B
                        %mi j
                    %annotation{:encoding => "application/x-tex"} f_j: A_j \hookrightarrow B_j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi j
                    %mo ∈
                    %msub
                      %mi B
                      %mi j
                    %mo ∖
                    %msub
                      %mi A
                      %mi j
                  %annotation{:encoding => "application/x-tex"} x_j \in B_j \setminus A_j
              and, letting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi i
                    %msub
                      %mi B
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi π
                          %mi j
                    %msub
                      %mi B
                      %mi j
                  %annotation{:encoding => "application/x-tex"} \prod_i B_i \stackrel{\pi_j}{\to} B_j
              be the product projection and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi j
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mi j
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi A
                      %mi i
                  %annotation{:encoding => "application/x-tex"} A_j \stackrel{i_j}{\to} \sum_i A_i
              the coproduct inclusion, define a map
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi j
                      %msub
                        %mi A
                        %mi j
                      %mo →
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mi j
                      %msub
                        %mi B
                        %mi j
                    %annotation{:encoding => "application/x-tex"} f: \sum_j A_j \to \prod_j B_j
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi π
                              %mi j
                            %mo ∘
                            %mi f
                            %mo ∘
                            %msub
                              %mi i
                              %mi k
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %msub
                              %mi f
                              %mi j
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %mi a
                            %mo ∈
                            %msub
                              %mi A
                              %mi k
                            %mspace{:width => "thickmathspace"}
                            %mi and
                            %mspace{:width => "thickmathspace"}
                            %mi j
                            %mo =
                            %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %msub
                              %mi x
                              %mi j
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %mi a
                            %mo ∈
                            %msub
                              %mi A
                              %mi k
                            %mspace{:width => "thickmathspace"}
                            %mi and
                            %mspace{:width => "thickmathspace"}
                            %mi j
                            %mo ≠
                            %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (\pi_j \circ f \circ i_k)(a) &amp; = &amp; f_j(a) &amp; \; if \; a \in A_k \; and \; j = k \\
                    \&amp; = &amp; x_j &amp; \; if \; a \in A_k \; and \; j \neq k
                    }
            %p
              It is immediate that this
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is injective, and so
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi i
                        %msub
                          %mi A
                          %mi i
                        %mo{:stretchy => "false"} |
                      %mo ≤
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mi i
                        %msub
                          %mi B
                          %mi i
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|\sum_i A_i|} \leq {|\prod_i B_i|}
            %p
              Now we prove the last inequality is strict. Suppose to the contrary that there exists a surjective function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                      %msub
                        %mi A
                        %mi i
                      %mo →
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mi i
                      %msub
                        %mi B
                        %mi i
                    %annotation{:encoding => "application/x-tex"} f: \sum_i A_i \to \prod_i B_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
