          .num_theorem
            %h6#proposition_2 Proposition
            %p
              The following conditions are each sufficient to construct an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⪰̸
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \nsucceq B
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                        %mo ∈
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ⪰̸
                        %mi B
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} m \in (A \nsucceq B')
                  and an injection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo :
                        %mi B
                        %mo ′
                        %mo ↪
                        %mi B
                      %annotation{:encoding => "application/x-tex"} i:B' \hookrightarrow B
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                        %mo ∈
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ′
                        %mo ⪰̸
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} m \in (A' \nsucceq B)
                  and an injection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo :
                        %mi A
                        %mo ↪
                        %mi A
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} i:A \hookrightarrow A'
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo =
                        %mi 𝒫
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B = \mathcal{P}(A)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                  has a wellorder
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo &lt;
                        %annotation{:encoding => "application/x-tex"} \lt
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A \to B
              %li
                %p
                  An element
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi B
                      %annotation{:encoding => "application/x-tex"} b \in B
                  and, for each total function
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo :
                          %mi A
                          %mo →
                          %mi B
                        %annotation{:encoding => "application/x-tex"} f:A \to B
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi B
                        %mo ∖
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} m(f) \in B \setminus im(f)
          .proof
            %h6#proof_4 Proof
            %ol
              %li
                %p
                  For
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo :
                          %mi A
                          %mo ⇀
                          %mi B
                        %annotation{:encoding => "application/x-tex"} f:A \rightharpoonup B
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  restricts to a partial function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ′
                        %mo :
                        %mi A
                        %mo ⇀
                        %mi B
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} f':A \rightharpoonup B'
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi b
                      %annotation{:encoding => "application/x-tex"} f'(a) = b
                  iff
                  = succeed ")," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi i
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} f(a) = i(b)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} m(f')
                  gives an element of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                          %mo ′
                          %mo ∖
                          %mi im
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ′
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} B'\setminus im(f')
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi m
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} n(f') = i(m(f'))
                  gives
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi m
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi B
                        %mo ∖
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} n(f') = i(m(f')) \in B \setminus im(f)
              %li
                %p
                  For
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo :
                          %mi A
                          %mo ⇀
                          %mi B
                        %annotation{:encoding => "application/x-tex"} f:A \rightharpoonup B
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  extends to a partial function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ′
                        %mo :
                        %mi A
                        %mo ′
                        %mo ⇀
                        %mi B
                      %annotation{:encoding => "application/x-tex"} f':A' \rightharpoonup B
                  (defined as
                  = succeed ")," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo ′
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} f'(i(a)) = f(a)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi m
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi B
                          %mo ∖
                          %mi im
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi B
                          %mo ∖
                          %mi im
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ′
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} m(f') \in B \setminus im(f) = B \setminus im(f')
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi m
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ′
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} n(f) = m(f')
              %li
                %p
                  Immediate from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ⪰̸
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 1 \nsucceq 2
                  and the above choiceless variant of König’s theorem, but can also be proven directly. Let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi A
                        %mo ⇀
                        %mi 𝒫
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f:A \rightharpoonup \mathcal{P}(A)
                  be a partial function, and let
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:stretchy => "false"} {
                          %mi a
                          %mo ∈
                          %mi A
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi a
                          %mo ∈
                          %mi dom
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mi and
                          %mi a
                          %mo ∉
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} n(f) = \{a \in A \mid a \in dom(f) and a \notin f(a)\}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} f(a) = n(f)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi n
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a \in n(f)
                  iff
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo ∈
                          %mi dom
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mi and
                          %mi a
                          %mo ∉
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} a \in dom(f) and a \notin f(a)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo ∉
                          %mi dom
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} a \notin dom(f)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} f(a) = n(f)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi 𝒫
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo ∖
                          %mi im
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} n(f) \in \mathcal{P}(A) \setminus im(f)
              %li
                %p
                  For
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo :
                          %mi A
                          %mo ⇀
                          %mi B
                        %annotation{:encoding => "application/x-tex"} f:A \rightharpoonup B
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi min
                          %mo{:stretchy => "false"} {
                          %mi α
                          %mo ∈
                          %mi B
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi α
                          %mo ∉
                          %mi im
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} n(f) = min \{ \alpha \in B \mid \alpha \notin im(f) \}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} n(f)
                  is uniquely defined as
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                  is wellordered and the set is nonempty (otherwise f is a partial surjection), and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi B
                          %mo ∖
                          %mi im
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} n(f) \in B \setminus im(f)
              %li
                %p
                  For
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo :
                          %mi A
                          %mo ⇀
                          %mi B
                        %annotation{:encoding => "application/x-tex"} f:A \rightharpoonup B
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ′
                        %mo :
                        %mi A
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} f':A \to B
                  by letting
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f'(x) = f(x)
                  where defined and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi b
                      %annotation{:encoding => "application/x-tex"} f'(x) = b
                  otherwise. Then
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi m
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi B
                          %mo ∖
                          %mi im
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo ⊆
                          %mi B
                          %mo ∖
                          %mi im
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} m(f') \in B \setminus im(f') \subseteq B \setminus im(f)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi m
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ′
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} n(f) = m(f')
