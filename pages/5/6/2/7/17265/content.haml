            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 0
                        %mo{:lspace => "verythinmathspace"} :
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒟
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        F_0 \colon Obj(\mathcal{C}) \longrightarrow Obj(\mathcal{D})
                %p
                  of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %li
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a,b \in Obj(\mathcal{C})
                  a
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
