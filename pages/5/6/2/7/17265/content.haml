                                  %mi Y
                                  %mi A
                            %msup
                              %mi X
                              %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msup
                              %mi Y
                              %mi B
                          %mtd
                          %mtd
