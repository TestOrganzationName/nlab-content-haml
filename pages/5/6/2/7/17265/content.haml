                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi n
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ∃
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n-1}  &amp;\longrightarrow &amp; \hat X
                    \\\
                    {}^{\mathllap{\iota_n}}\downarrow &amp;{}^{\mathllap{\exists}}\nearrow&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    D^n &amp;\longrightarrow&amp; X
                    }
            %p
              We check that the lifts in these diagrams exhibit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(f)
              as being an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              on all
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              = succeed ":" do
                %a.maruku-ref{:href => "#HomotopyGroupsOftopologicalSpaces"}
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
              the existence of these lifts says that every point of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is in the image of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(\hat X) \to \pi_0(X)
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/surjection"} surjective
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 0
                    %mo =
                    %mo *
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mo *
                    %mo ⟶
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} S^0 = \ast \coprod \ast \longrightarrow \hat X
              be a map that hits two connected components, then the existence of the lift says that if they have the same image in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(X)
              then they were already the same connected component in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(\hat X)\to \pi_0(X)
              is also
              %a.existingWikiWord{:href => "/nlab/show/injection"} injective
              and hence is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %p
              Similarly, for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} S^n \to \hat X
              represents an element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(\hat X)
              that becomes trivial in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_n(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(\hat X) \to \pi_n(X)
              has trivial
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              and so is injective.
            %p
              Finally, to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(\hat X) \to \pi_n(X)
              is also surjective, hence bijective, observe that every element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(X)
              is equivalently represented by a commuting diagram of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                          %mtd
                            %mo =
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n-1} &amp;\longrightarrow&amp; \ast &amp;\longrightarrow&amp; \hat X
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    D^n &amp;\longrightarrow&amp; X &amp;=&amp; X
                    }
                    \\,,
            %p
              and so here the lift gives a representative of a preimage in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_{n}(\hat X)
            %p
              %strong
                B)
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} I_{Top}
                %a.existingWikiWord{:href => "/nlab/show/injective+morphisms"} injective morphisms
                are in particular Serre fibrations
            %p
              By lemma
              %a.maruku-ref{:href => "#SaturationOfGeneratingCofibrations"}
              an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} I_{Top}
              %a.existingWikiWord{:href => "/nlab/show/injective+morphisms"} injective morphisms
              has also the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against all
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
              %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrationsAreRelativeCellComplexes"}
              it is also a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injective+morphism"} injective morphism
            %p
              %strong
                C) Acyclic Serre fibrations are in particular
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} I_{Top}
                %a.existingWikiWord{:href => "/nlab/show/injective+morphisms"} injective morphisms
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X \to Y
              be a Serre fibration that induces isomorphisms on homotopy groups. In degree 0 this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an isomorphism on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo =
                            %mi ∅
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mn 0
                            %mo =
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{-1} = \emptyset &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    D^0 = \ast &amp;\longrightarrow&amp; Y
                    }
            %p
              (this is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(f)
              being surjective) and in every commuting square of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 0
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mn 1
                            %mo =
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^0  &amp;\longrightarrow&amp; X
                    \\\
                    {}^{\mathllap{\iota_0}}\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    D^1 = \ast &amp;\longrightarrow&amp; Y
                    }
            %p
              (this is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(f)
              being injective). Hence we are reduced to showing that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              every diagram of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi α
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi n
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mi κ
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n-1}  &amp;\overset{\alpha}{\longrightarrow}&amp; X
                    \\\
                    {}^{\mathllap{\iota_n}}\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    D^n  &amp;\overset{\kappa}{\longrightarrow}&amp; Y
                    }
            %p has a lift.
            %p
              To that end, pick a basepoint on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{n-1}
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              for its images in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            %p
              Then the diagram above expresses that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                    %mo ∈
                    %msub
                      %mi π
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_\ast[\alpha] = 0 \in \pi_{n-1}(Y,y)
              and hence by assumption on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              it follows that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi α
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                      %mo ∈
                      %msub
                        %mi π
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [\alpha] = 0 \in \pi_{n-1}(X,x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \kappa'
              making the upper triangle of our lifting problem commute:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi α
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi n
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi κ
                                  %mo ′
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n-1} &amp;\overset{\alpha}{\longrightarrow}&amp; X
                    \\\
                    {}^{\mathllap{\iota_n}}\downarrow &amp; \nearrow_{\mathrlap{\kappa'}}
                    \\\
                    D^n
                    }
                    \\,.
            %p
              It is now sufficient to show that any such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \kappa'
              may be deformed to a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \rho'
              which keeps making this upper triangle commute but also makes the remaining lower triangle commute.
            %p To that end, notice that by the commutativity of the original square, we already have at least this commuting square:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ι
                                  %mi n
                          %mtd
                            %msup
                              %mi D
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi n
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi f
                                  %mo ∘
                                  %mi κ
                                  %mo ′
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %munder
                              %mo ⟶
                              %mi κ
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n-1} &amp;\overset{\iota_n}{\longrightarrow}&amp; D^n
                    \\\
                    {}^{\mathllap{\iota_n}}\downarrow &amp;&amp; \downarrow^{\mathrlap{f \circ \kappa'}}
                    \\\
                    D^n &amp;\underset{\kappa}{\longrightarrow}&amp; Y
                    }
                    \\,.
            %p
              This induces the universal map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi κ
                    %mo ,
                    %mi f
                    %mo ∘
                    %mi κ
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\kappa,f \circ \kappa')
              from the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              of its
              %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
              in the top left, which is the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              (see
              %a{:href => "Top#TopologicalnSphereIsPushoutOfBoundaryOfnBallInclusionAlongItself"} this
              example):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ι
                                  %mi n
                          %mtd
                            %msup
                              %mi D
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi n
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi f
                                  %mo ∘
                                  %mi κ
                                  %mo ′
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %munder
                              %mo ⟶
                              %mi κ
                          %mtd
                            %msup
                              %mi S
                              %mi n
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi κ
                                %mo ,
                                %mi f
                                %mo ∘
                                %mi κ
                                %mo ′
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n-1} &amp;\overset{\iota_n}{\longrightarrow}&amp; D^n
                    \\\
                    {}^{\mathllap{\iota_n}}\downarrow
                    \&amp;(po)&amp;
                    \\downarrow^{\mathrlap{f \circ \kappa'}}
                    \\\
                    D^n &amp;\underset{\kappa}{\longrightarrow}&amp; S^n
                    \\\
                    \&amp;&amp; &amp; \searrow^{(\kappa,f \circ \kappa')}
                    \\\
                    \&amp;&amp; &amp;&amp; Y
                    }
                    \\,.
            %p
              This universal morphism represents an element of the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi κ
                    %mo ,
                    %mi f
                    %mo ∘
                    %mi κ
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [(\kappa,f \circ \kappa')]
                    \\in
                    \\pi_n(Y,y)
                    \\,.
            %p
              By assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a weak homotopy equivalence, there is a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi ρ
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [\rho] \in \pi_{n}(X,x)
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mi ρ
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi κ
                    %mo ,
                    %mi f
                    %mo ∘
                    %mi κ
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    f_\ast [\rho] = [(\kappa,f \circ \kappa')]
            %p hence on representatives there is a lift up to homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi ρ
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mo ⇓
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mi n
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi κ
                                %mo ,
                                %mi f
                                %mo ∘
                                %mi κ
                                %mo ′
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X
                    \\\
                    \&amp;{}^{\mathllap{\rho}}\nearrow_{\mathrlap{\Downarrow}} &amp; \downarrow^{\mathrlap{f}}
                    \\\
                    S^n
                    \&amp;\underset{(\kappa,f\circ \kappa')}{\longrightarrow}&amp;
                    Y
                    }
                    \\,.
            %p
              Morever, we may always find
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo ′
                    %mo ,
                    %mi κ
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\rho', \kappa')
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo ′
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi D
                        %mi n
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \rho' \colon D^n \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \kappa'
              to the reverse of
              = succeed ".\u201D)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
            %p Consider then the map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ∘
                        %mi ρ
                        %mo ′
                        %mo ,
                        %mi κ
                        %mo{:stretchy => "false"} )
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    S^n \overset{(f\circ \rho', \kappa)}{\longrightarrow} Y
            %p and observe that this represents the trivial class:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ∘
                            %mi ρ
                            %mo ′
                            %mo ,
                            %mi κ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ∘
                            %mi ρ
                            %mo ′
                            %mo ,
                            %mi f
                            %mo ∘
                            %mi κ
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                            %mo +
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ∘
                            %mi κ
                            %mo ′
                            %mo ,
                            %mi κ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi f
                              %mo *
                            %munder
                              %munder
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mo{:stretchy => "false"} (
                                  %mi ρ
                                  %mo ′
                                  %mo ,
                                  %mi κ
                                  %mo ′
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} ]
                                %mo ⏟
                              %mrow
                                %mo =
                                %mo{:stretchy => "false"} [
                                %mi ρ
                                %mo{:stretchy => "false"} ]
                            %mo +
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ∘
                            %mi κ
                            %mo ′
                            %mo ,
                            %mi κ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} (
                            %mi κ
                            %mo ,
                            %mi f
                            %mo ∘
                            %mi κ
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                            %mo +
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ∘
                            %mi κ
                            %mo ′
                            %mo ,
                            %mi κ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    [(f \circ \rho', \kappa)]
                    \&amp; =
                    [(f\circ \rho', f\circ \kappa')]
                    +
                    [(f\circ \kappa', \kappa)]
                    \\\
                    \&amp; = f_\ast \underset{= [\rho]}{\underbrace{[(\rho',\kappa')]}}
                    +
                    [(f\circ \kappa', \kappa)]
                    \\\
                    \&amp; = [(\kappa,f \circ \kappa')]
                    +
                    [(f\circ \kappa', \kappa)]
                    \\\
                    \&amp; = 0
                    \\end{aligned}
                    \\,.
            %p This means equivalently that there is a homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo ∘
                    %mi ρ
                    %mo ′
                    %mo ⇒
                    %mi κ
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \; \colon \; f\circ \rho' \Rightarrow \kappa
            %p
              fixing the boundary of the
              = succeed "-disk." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p Hence if we denote homotopy by double arrows, then we have now achieved the following situation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi α
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi n
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mi ρ
                                %mo ′
                            %msub
                              %mo ↗
                              %mrow
                                %msup
                                  %mo ⇓
                                  %mi ϕ
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n-1} &amp;\overset{\alpha}{\longrightarrow}&amp; X
                    \\\
                    {}^{\mathllap{\iota_n}}\downarrow
                    \&amp;
                    {}^{\rho'}\nearrow_{\Downarrow^{\phi}}
                    \&amp;
                    \\downarrow^{\mathrlap{f}}
                    \\\
                    D^n &amp;\longrightarrow&amp; Y
                    }
            %p
              and it now suffices to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              may be lifted to a homotopy of just
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \rho'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} \rho''
              is the desired lift.
            %p
              To that end, notice that the condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi D
                      %mi n
                    %mo ×
                    %mi I
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \phi \colon D^n \times I \to Y
              fixes the boundary of the
              = succeed "-disk" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %munder
                      %mo ⊔
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo ×
                        %mi I
                    %msup
                      %mi D
                      %mi n
                    %mo ×
                    %mi I
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ∘
                        %mi α
                        %mo ,
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    S^{n-1} \underset{S^{n-1}\times I}{\sqcup} D^n \times I
                    \\overset{(f\circ \alpha,\phi)}{\longrightarrow}
                    Y
            %p
              out of the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              that identifies in the cylinder over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              all points lying over the boundary. Hence we are reduced to finding a lift in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi ρ
                                %mo ′
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %munder
                              %mo ⊔
                              %mrow
                                %msup
                                  %mi S
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mn 1
                                %mo ×
                                %mi I
                            %msup
                              %mi D
                              %mi n
                            %mo ×
                            %mi I
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo ∘
                                %mi α
                                %mo ,
                                %mi ϕ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D^n &amp;\overset{\rho'}{\longrightarrow}&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    S^{n-1}\underset{S^{n-1}\times I}{\sqcup} D^n \times I
                    \&amp;\overset{(f\circ \alpha,\phi)}{\longrightarrow}&amp;
                    Y
                    }
                    \\,.
            %p
              But inspection of the left map reveals that it is homeomorphic again to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi n
                      %mo →
                      %msup
                        %mi D
                        %mi n
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} D^n \to D^n \times I
          %h3#VerificationOfTopQuillen Verification of the axioms
          %p
            We use the lemmas
            %a{:href => "#TechnicalLemmas"} above
            to prove that the classes of morphisms in def.
            %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
            satify the conditions for a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on the category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          #QuillenWeakEquivalencesSatisfyTwoOutOfThree.num_prop
            %h6#proposition_5 Proposition
            %p
              The classical weak equivalences, def.
              = succeed "," do
                %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
          .proof
            %h6#proof_8 Proof
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              (of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              = succeed "." do
                %a.maruku-ref{:href => "#WeakHomotopyEquivalenceOfTopologicalSpaces"}
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X \longrightarrow Y
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              factors as a classical cofibration followed by an acyclic fibration, def.
              = succeed ":" do
                %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi Cof
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                        %mo ∩
                        %mi Fib
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    X
                    \\stackrel{\in Cof}{\longrightarrow}
                    \\hat X
                    \\stackrel{\in W \cap Fib}{\longrightarrow}
                    Y
                    \\,.
          .proof
            %h6#proof_9 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#CompactSubsetsAreSmallInCellComplexes"}
              the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi Top
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ↪
                    %msup
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I_{Top} = \{S^{n-1}\hookrightarrow D^n\}
              of topological
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/generating+cofibrations"} generating cofibrations
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalGeneratingCofibrations"}
              %a.maruku-ref{:href => "#ClassOfMorphismsWithSmallDomains"}
              (the
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              are
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              = succeed "," do
                %a.maruku-ref{:href => "#SmallObjectArgument"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              factors as an
              = succeed "-relative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} I_{Top}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} I_{Top}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injective+morphisms"} injective morphisms
              = succeed "." do
                %a.maruku-ref{:href => "#RightLiftingProperty"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi Cof
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi I
                          %mi top
                        %mi Inj
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    X
                    \\stackrel{\in Cof}{\longrightarrow}
                    \\hat X
                    \\stackrel{\in I_{top} Inj}{\longrightarrow}
                    Y
                    \\,.
            %p
              By lemma
              %a.maruku-ref{:href => "#AcyclicSerreFibrationsAreTheJTopFibrations"}
              the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \hat X \to Y
              is both a weak equivalence as well as a Serre fibration.
          #ContinuousFunctionsFactorAsQuillenAcyclicCofibrationFollowedBySerreFibration.num_prop
            %h6#proposition_7 Proposition
            %p
              Every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X \longrightarrow Y
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              factors as an acyclic classical cofibration followed by a classical fibration, def.
              = succeed ":" do
                %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                        %mo ∩
                        %mi Cof
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi Fib
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    X
                    \\stackrel{\in W \cap Cof}{\longrightarrow}
                    \\hat X
                    \\stackrel{\in Fib}{\longrightarrow}
                    Y
                    \\,.
          .proof
            %h6#proof_10 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#CompactSubsetsAreSmallInCellComplexes"}
              the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi Top
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi D
                      %mi n
                    %mo ↪
                    %msup
                      %mi D
                      %mi n
                    %mo ×
                    %mi I
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} J_{Top} = \{D^n \hookrightarrow D^n\times I\}
              of topological
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/generating+acyclic+cofibrations"} generating acyclic cofibrations
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
              %a.maruku-ref{:href => "#ClassOfMorphismsWithSmallDomains"}
              (the
              %a.existingWikiWord{:href => "/nlab/show/n-disks"} n-disks
              are
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              = succeed "," do
                %a.maruku-ref{:href => "#SmallObjectArgument"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              factors as an
              = succeed "-relative" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi top
                    %annotation{:encoding => "application/x-tex"} J_{top}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injective+morphisms"} injective morphisms
              = succeed ":" do
                %a.maruku-ref{:href => "#RightLiftingProperty"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi J
                          %mi Top
                        %mi Cell
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi J
                          %mi Top
                        %mi Inj
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    X
                    \\stackrel{\in J_{Top} Cell}{\longrightarrow}
                    \\hat X
                    \\stackrel{\in J_{Top} Inj}{\longrightarrow}
                    Y
                    \\,.
            %p
              By definition this makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \hat X \to Y
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
            %p
              By lemma
              %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrationsAreRelativeCellComplexes"}
              a relative
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} I_{Top}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} X \to \hat X
              is a cofibration. By lemma
              %a.maruku-ref{:href => "#JTopRelativeCellComplexesAreWeakHomotopyEquivalences"}
              it is also a weak equivalence.
          #LiftingPropertyInTheClassicalModelStructureOnTopologicalSpaces.num_prop
            %h6#proposition_8 Proposition
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting square
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              with the left morphism a classical cofibration and the right morphism a fibration, def.
              %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mrow
                                      %mi g
                                      %mo ∈
                                  %mrow
                                    %mi Cof
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mrow
                                      %mi f
                                      %mo ∈
                                  %mrow
                                    %mi Fib
                        %mtr
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;\longrightarrow&amp;
                    \\\
                    {}^{\mathllap{{g \in} \atop { Cof}}}\downarrow &amp;&amp; \downarrow^{\mathrlap{{f \in }\atop Fib}}
                    \\\
                    \&amp;\longrightarrow&amp;
                    }
            %p
              admits a
              %a.existingWikiWord{:href => "/nlab/show/lift"} lift
              as soon as one of the two is also a weak equivalence.
          .proof
            %h6#proof_11 Proof
            %p
              %strong A)
              If the fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is also a weak equivalence, then lemma
              %a.maruku-ref{:href => "#AcyclicSerreFibrationsAreTheJTopFibrations"}
              says that it has the right lifting property against the generating cofibrations
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} I_{Top}
              %a.maruku-ref{:href => "#SaturationOfGeneratingCofibrations"}
              implies the claim.
            %p
              %strong B)
              If the cofibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              on the left is also a weak equivalence, consider any factorization into a relative
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalCCellComplex"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi J
                          %mi Top
                        %mi Cell
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi Fib
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    g \;\colon\; \stackrel{\in J_{Top} Cell}{\longrightarrow} \stackrel{\in Fib}{\longrightarrow}
                    \\,,
            %p
              as in the proof of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ContinuousFunctionsFactorAsQuillenAcyclicCofibrationFollowedBySerreFibration"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              = succeed "," do
                %a.maruku-ref{:href => "#QuillenWeakEquivalencesSatisfyTwoOutOfThree"}
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against the cofibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              itself, and so the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
              %a.maruku-ref{:href => "#RetractArgument"}
              gives that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of a relative
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              %a.maruku-ref{:href => "#SaturationOfGeneratingCofibrations"}
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
          %p Finally:
          #LiftingExhausted.num_prop
            %h6#proposition_9 Proposition
            %p
              The systems
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Cof
                    %mo ,
                    %mi W
                    %mo ∩
                    %mi Fib
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Cof , W \cap Fib)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} W
                    %mo ∩
                    %mi Cof
                    %mo ,
                    %mi Fib
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\W \cap Cof, Fib)
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+factorization+systems"} weak factorization systems
          .proof
            %h6#proof_12 Proof
            %p We have already seen the factorization and the lifting property, it remains to see that the given left/right classes exhaust the class of morphisms with the given lifting property.
            %p
              For the fibrations this is by definition, for the the acyclic fibrations this is by lemma
              = succeed "." do
                %a.maruku-ref{:href => "#AcyclicSerreFibrationsAreTheJTopFibrations"}
            %p
              The remaining statement for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cof
                  %annotation{:encoding => "application/x-tex"} Cof
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ∩
                    %mi Cof
                  %annotation{:encoding => "application/x-tex"} W\cap Cof
              follows from a general argument (
              %a{:href => "cofibrantly+generated+model+category#RetractsOfCellComplexesExchaustLLPOfRLP"}> here
              ) for
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+categories"} cofibrantly generated model categories
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              be in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi I
                        %mi Top
                      %mi Inj
                      %mo{:stretchy => "false"} )
                      %mi Proj
                    %annotation{:encoding => "application/x-tex"} (I_{Top} Inj) Proj
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a retract of a relative cell complex. To that end, apply the
              %a.existingWikiWord{:href => "/nlab/show/small+object"} small object
              argument to factor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                    %mover
                      %mi Y
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi I
                        %mi Inj
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon \; X \overset{}{\longrightarrow} \hat Y \overset{\in I Inj}{\longrightarrow} Y
                    \\,.
            %p
              It follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has the left lefting property again
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Y
                        %mo{:stretchy => "false"} ^
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \hat Y \to Y
              %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
              it is a retract of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mover
                        %mi Y
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} X \to \hat Y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cof
                    %annotation{:encoding => "application/x-tex"} Cof
            %p
              The argument for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ∩
                    %mi Cof
                  %annotation{:encoding => "application/x-tex"} W \cap Cof
              is analogous, using the
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              now for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
          %p In conclusion:
          #TopQuillenModelStructure.num_theorem
            %h6#theorem Theorem
            %p
              The classes of morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mor(Top)
              of def.
              = succeed "," do
                %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mo =
                      %annotation{:encoding => "application/x-tex"} W =
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo =
                      %annotation{:encoding => "application/x-tex"} F =
                  %a.existingWikiWord{:href => "/nlab/show/Serre+fibrations"} Serre fibrations
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo =
                      %annotation{:encoding => "application/x-tex"} C =
                  %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                  of
                  %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
            %p
              define a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} Top_{Quillen}
          %h3#the_homotopy_category The homotopy category
          %p
            We may now pass to the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category of a model category
            and find
            %a.existingWikiWord{:href => "/nlab/show/Ho%28Top%29"} Ho(Top)
            the “
            %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"}> classical homotopy category
            ” (or maybe “Quillen-Serre homotopy category”). For discussion of the
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            to the
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
            (the “
            %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"}> homotopy hypothesis
            ”), see there.
          .num_remark
            %h6#remark_6 Remark
            %p
              Theorem
              %a.maruku-ref{:href => "#TopQuillenModelStructure"}
              in itself implies only that every topological space is weakly equivalent to a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalCellComplex"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW+approximations"} CW approximations
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+model+structure+on+simplicial+sets"} Quillen model structure on simplicial sets
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              of its
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              (and every geometric realization of a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              is (by
              = succeed ")" do
                %a{:href => "geometric+realization#mono"} this proposition
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalCellComplex"}
          %h2#properties Properties
          #Properness.num_prop
            %h6#proposition_10 Proposition
            %p
              The model categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} Top_{Quillen}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} (Top^{\ast/})_{Quillen}
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proper+model+categories"} proper model categories
          %p
            (
            %a{:href => "model+category#Hirschhorn02"}> Hirschhorn 02,theorem 13.1.10
            )
          %p Right properness is immediate from the fact that all objects are fibrant. Left properness needs an argument. First check that weak equivalences are preserved under pushout of inclusion maps along cell attachments. Then use that a general cofibration is a retract a relative cell complex inclusion. Observe that if weak equivalences are preserved under pushout along some class of morphisms, then also under pushout along retracts of these. Hence reduce to pushout along relative cell complexes. By the first statement these are a transfinite pasting composite along pushouts that preserve weak equivalences.
          %h2#RelatedModelStructures Related model structures
          %p
            We discuss various further
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structures whose existence follows by immediate variation of the above proof of theorem
            = succeed ":" do
              %a.maruku-ref{:href => "#TopQuillenModelStructure"}
          %ul
            %li
              %p
                %a{:href => "#ModelstructureOnPointedTopologicalSpaces"}> The model structure on pointed topological spaces
                ;
            %li
              %p
                %a{:href => "#ModelStructureOnCompactlyGeneratedTopologicalSpaces"}> The model structure on compactly generated topological spaces
                ;
            %li
              %p
                %a{:href => "#ModelStructureOnTopEnrichedFunctors"}> The model structure on topologically enriched functors
                \.
          %h3#ModelstructureOnPointedTopologicalSpaces Classical model structure on pointed topological spaces
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒞
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} \mathcal{C}^{X/}
            of a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            inherits the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coslice+model+structure"} coslice model structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            as seen by the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒞
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} U \colon \mathcal{C}^{X/}\longrightarrow \mathcal{C}
          %p
            Accordingly there is the induced
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Top
                      %mi Quillen
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{Quillen}
          #BasePointAdjoined.num_defn
            %h6#definition_18 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+colimits"} finite colimits
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} U \colon \mathcal{C}^{\ast/} \to \mathcal{C}
              from its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
              = succeed "," do
                %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi U
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo +
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}^{\ast/}
                    \\underoverset
                    {\underset{U}{\longrightarrow}}
                    {\overset{(-)_+}{\longleftarrow}}
                    {\bot}
                    \\mathcal{C}
            %p
              given by forming the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              (
              %a.existingWikiWord{:href => "/nlab/show/coproduct"}> coproduct
              ) with a base point (“adjoining a base point”).
          #LimitsAndColimitsOfPointedObjects.num_prop
            %h6#proposition_11 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with all
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              = succeed "," do
                %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
            %p Moreover:
            %ol
              %li
                %p
                  the limits are the limits of the underlying diagrams in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  the colimits are the limits in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  of the diagrams
                  = succeed "." do
                    %em with the basepoint adjoined
          .proof
            %h6#proof_13 Proof
            %p
              It is immediate to check the relevant
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              = succeed "." do
                %em
                  %a{:href => "overcategory#LimitsAndColimits"} slice category – limits and colimits
          #WedgeSumAsCoproduct.num_example
            %h6#example_3 Example
            %p
              Given two pointed objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Y,y)
            %ol
              %li
                %p
                  their
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                  is simply
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi Y
                          %mo ,
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X\times Y, (x,y))
              %li
                %p
                  their
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                  has to be computed using the second clause in prop.
                  = succeed ":" do
                    %a.maruku-ref{:href => "#LimitsAndColimitsOfPointedObjects"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                  has to be adjoined to the diagram, it is given not by the coproduct in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  of the form:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo *
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mi x
                              %mtd
                                %mi X
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mi y
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi po
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi Y
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi X
                                %mo ∨
                                %mi Y
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\ast &amp;\overset{x}{\longrightarrow}&amp; X
                        \\\
                        {}^{\mathllap{y}}\downarrow &amp;(po)&amp; \downarrow
                        \\\
                        Y &amp;\longrightarrow&amp; X \vee Y
                        }
                        \\,.
                %p
                  This is called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                  operation on pointed objects.
            %p
              Generally for a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{X_i\}_{i \in I}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top^{\ast/}
            %ol
              %li
                %p
                  their
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                  is formed in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Top
                      %annotation{:encoding => "application/x-tex"} Top
                  as in example
                  = succeed "," do
                    %a.maruku-ref{:href => "#ProductTopologicalSpace"}
              %li
                %p
                  their
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                  is formed by the
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Top
                      %annotation{:encoding => "application/x-tex"} Top
                  over the diagram with a basepoint adjoined, and is called the
                  %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mo ∨
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi X
                            %mi i
                        %annotation{:encoding => "application/x-tex"} \vee_{i \in I} X_i
