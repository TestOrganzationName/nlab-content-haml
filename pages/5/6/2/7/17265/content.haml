                      %mi cg
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Top_{cg}
                    \\underoverset
                    {\underset{(-)^X}{\longrightarrow}}
                    {\overset{X \times (-)}{\longleftarrow}}
                    {\;\;\;\; \bot \;\;\;\;}
                    Top_{cg}
                    \\,.
          %p
            e.g. (
            %a{:href => "#Strickland09"}> Strickland 09, prop. 2.12
            )
          %p
            Due to the
            %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotency
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ∘
                  %mi k
                  %mo ≃
                  %mi k
                %annotation{:encoding => "application/x-tex"} k \circ k \simeq k
            (cor.
            = succeed ")" do
              %a.maruku-ref{:href => "#kTopIsCoreflectiveSubcategory"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            to it does not change it.
          #CWComplexIsCompactlyGenerated.num_example
            %h6#example_8 Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+space"} compactly generated
          .proof
            %h6#proof_17 Proof
            %p
              Since
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/a+CW-complex+is+a+Hausdorff+space"} a CW-complex is a Hausdorff space
              %a.maruku-ref{:href => "#HausdorffImpliessWeaklyHausdorff"}
              and prop.
              %a.maruku-ref{:href => "#CharacterizationOfCompactClosedSetsInWeaklyHausdorffSpace"}
              its
              = succeed "-closed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/compact+subspace"} compact subspace
              is closed.
            %p
              Since a CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              over attachments of standard
              %a.existingWikiWord{:href => "/nlab/show/n-disks"} n-disks
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mi i
                  %annotation{:encoding => "application/x-tex"} D^{n_i}
              (its cells), by the characterization of colimits in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              (
              %a{:href => "Top#DescriptionOfLimitsAndColimitsInTop"}> prop.
              ) a subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is open or closed precisely if its restriction to each cell is open or closed, respectively. Since the
              = succeed "-disks" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              intersected with all compact subsets is closed, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is closed.
            %p
              For the converse direction, since
              %a.existingWikiWord{:href => "/nlab/show/a+CW-complex+is+a+Hausdorff+space"} a CW-complex is a Hausdorff space
              and since
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+subspaces+of+Hausdorff+spaces+are+closed"} compact subspaces of Hausdorff spaces are closed
          .num_example
            %h6#example_9 Example
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"} Top_{cg}
              of
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
              includes
            %ol
              %li
                %p
                  all
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+spaces"} locally compact topological spaces
              %li
                %p
                  all
                  %a.existingWikiWord{:href => "/nlab/show/first-countable+topological+spaces"} first-countable topological spaces
                %p hence in particular
                %ol
                  %li
                    %p
                      all
                      %a.existingWikiWord{:href => "/nlab/show/metrizable+topological+spaces"} metrizable topological spaces
                  %li
                    %p
                      all
                      %a.existingWikiWord{:href => "/nlab/show/discrete+topological+spaces"} discrete topological spaces
                  %li
                    %p
                      all
                      %a.existingWikiWord{:href => "/nlab/show/codiscrete+topological+spaces"} codiscrete topological spaces
          %p
            (
            %a{:href => "#Lewis78"}> Lewis 78, p. 148
            )
          %p
            Recall that by corollary
            = succeed "," do
              %a.maruku-ref{:href => "#kTopIsCoreflectiveSubcategory"}
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            of compactly generated spaces are again compactly generated.
          #ProductOfCWWithLocallyCompactCWIsCompactlyGenerated.num_example
            %h6#example_10 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              of a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              with a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              CW-complex is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+space"} compactly generated
          %p
            (
            %a{:href => "CW+complex#HatcherTopologyOfCellComplexes"}> Hatcher “Topology of cell complexes”, theorem A.6
            )
          %p More generally:
          .num_prop
            %h6#proposition_13 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              of a
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+space"} compactly generated topological space
              with a
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
              is itself compactly generated.
          %p
            (
            %a{:href => "#Strickland09"}> Strickland 09, prop. 2.6
            )
          #kificationComparisonIsWeakHomotopyEquivalence.num_prop
            %h6#proposition_14 Proposition
            %p
              For every topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} k(X) \longrightarrow X
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
          .proof
            %h6#proof_18 Proof
            %p
              By example
              = succeed "," do
                %a.maruku-ref{:href => "#CWComplexIsCompactlyGenerated"}
              %a.maruku-ref{:href => "#ProductOfCWWithLocallyCompactCWIsCompactlyGenerated"}
              and lemma
              = succeed "," do
                %a.maruku-ref{:href => "#ContinuousFunctionsOutOfCompactlyGeneratedFactorThroughCompactlyGeneratedClosureOfCodomain"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^n \to k(X)
              and their left homotopies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ×
                    %mi I
                    %mo →
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^n \times I \to k(X)
              are in bijection with functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S^n \to X
              and their homotopies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                      %mo ×
                      %mi I
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} S^n \times I \to X
          #ModelStructureOnTopcg.num_theorem
            %h6#theorem_3 Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+compactly+generated+topological+spaces"}> model structure on compactly generated topological spaces
                )
            %p
              The restriction of the
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} Top_{Quillen}
              from theorem
              %a.maruku-ref{:href => "#TopQuillenModelStructure"}
              along the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                    %mo ↪
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top_{cg} \hookrightarrow Top
              of def.
              %a.maruku-ref{:href => "#kTop"}
              is still a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure, which is
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
              by the same sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi Top
                  %annotation{:encoding => "application/x-tex"} I_{Top}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalGeneratingCofibrations"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi Top
                  %annotation{:encoding => "application/x-tex"} J_{Top}
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
              %a.existingWikiWord{:href => "/nlab/show/k-ification"} k-ification
              coreflection of cor.
              %a.maruku-ref{:href => "#kTopIsCoreflectiveSubcategory"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mrow
                        %mi cg
                        %mo ,
                        %mi Quillen
                    %mover
                      %munderover
                        %mo ⟵
                        %mi k
                        %mo ⊥
                      %mo ↪
                    %msub
                      %mi Top
                      %mi Quillen
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Top_{cg, Quillen}
                    \\stackrel{\hookrightarrow}{\underoverset{k}{\bot}{\longleftarrow}}
                    Top_{Quillen}
                    \\,.
          .proof
            %h6#proof_19 Proof
            %p
              By example
              = succeed "," do
                %a.maruku-ref{:href => "#CWComplexIsCompactlyGenerated"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi Top
                  %annotation{:encoding => "application/x-tex"} I_{Top}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi Top
                  %annotation{:encoding => "application/x-tex"} J_{Top}
              are indeed in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi cg
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Mor(Top_{cg})
              %a.maruku-ref{:href => "#ProductOfCWWithLocallyCompactCWIsCompactlyGenerated"}
              all arguments above about left homotopies between maps out of these basic cells go through verbatim in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
              = succeed "," do
                %a.maruku-ref{:href => "#CompactSubsetsAreSmallInCellComplexes"}
              %a.maruku-ref{:href => "#JTopRelativeCellComplexesAreWeakHomotopyEquivalences"}
              and lemma
              = succeed "," do
                %a.maruku-ref{:href => "#AcyclicSerreFibrationsAreTheJTopFibrations"}
              %a.maruku-ref{:href => "#TopQuillenModelStructure"}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} Top_{Quillen}
              follows by general abstract arguments from these, it also still goes through verbatim for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi cg
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} (Top_{cg})_{Quillen}
            %p
              Hence the (acyclic) cofibrations in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} (Top_{cg})_{Quillen}
              are identified with those in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} Top_{Quillen}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a compactly generated space then a continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WeakHomotopyEquivalenceOfTopologicalSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde f \colon X \to k(Y)
              is a weak homotopy equivalence. But, by lemma
              = succeed "," do
                %a.maruku-ref{:href => "#ContinuousFunctionsOutOfCompactlyGeneratedFactorThroughCompactlyGeneratedClosureOfCodomain"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              is the same function as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed "." do
                %a.maruku-ref{:href => "#kificationComparisonIsWeakHomotopyEquivalence"}
          %h4#pointed_compactly_generated_topological_spaces Pointed compactly generated topological spaces
          %p Moreover:
          .num_prop
            %h6#proposition_15 Proposition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top_{cg}^{\ast/}
              for the category of
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#kTop"}
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ×
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ⟶
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    (-)\wedge (-)
                    \\;\colon\;
                    Top_{cg}^{\ast/}
                    \\times
                    Top_{cg}^{\ast/}
                    \\longrightarrow
                    Top_{cg}^{\ast/}
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
              and the
              %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
              is a
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              for it, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %mo ∧
                    %mo ,
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Top_{cg}^{\ast/}, \wedge, S^0)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            %p
              Moreover together with the
              %a.existingWikiWord{:href => "/nlab/show/pointed+mapping+space"} pointed mapping space
              version
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mo *
                      %mi X
                  %annotation{:encoding => "application/x-tex"} (-)_\ast^X
              of the compactly generated mapping space of def.
              = succeed "," do
                %a.maruku-ref{:href => "#CompactlyGeneratedMappingSpaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Top
