            %a{:href => "weakly+Hausdorff+topological+space#McCord69"}> McCord 69
            ) is
            = succeed "," do
              %em weak Hausdorffness
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weakly+Hausdorff+topological+space"} weakly Hausdorff
            = succeed ")" do
              %a{:href => "compactly+generated+topological+space#Steenrod67"} Steenrod 67
            = succeed ")" do
              %a{:href => "weakly+Hausdorff+topological+space#McCord69"} McCord 69, section 2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quotient+spaces"} quotient spaces
          %p
            On the other hand, in the above we wouldn’t have imposed Hausdorffness in the first place. Possibly more intrinsic advantages of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
