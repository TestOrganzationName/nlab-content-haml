                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi Y
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\underset{c\in(C/f)}{\coprod} dom(c)
                  \&amp;\longrightarrow&amp;
                  X
                  \\\
                  {}^{\mathllap{id}}\downarrow
                  \&amp;&amp;
                  \\downarrow^{\mathrlap{}}
                  \\\
                  \\underset{c\in(C/f)}{\coprod} dom(c)
                  \&amp;&amp;
                  X_1
                  \\\
                  {}^{\mathllap{\underset{c\in(C/f)}{\coprod} c}}\downarrow
                  \&amp;\nearrow&amp; \downarrow
                  \\\
                  \\underset{c\in(C/f)}{\coprod} cod(c)
                  \&amp;\longrightarrow&amp;
                  Y
                  }
                  \\,.
          %p
            This shows that, finally, the colimiting
            %a.existingWikiWord{:href => "/nlab/show/co-cone"} co-cone
            map – the one that now appears diagonally –
            %strong almost
            exhibits the desired right lifting of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X_1 \to Y
            against the
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c\in C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c\in C
            into
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dom
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi X
                    %mn 1
                %annotation{:encoding => "application/x-tex"} dom(c) \to X_1
            factors through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X \to X_1
          %p
            The idea of the
            %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
            now is to fix this only remaining problem by iterating the construction: next factor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X_1 \to Y
            in the same way into
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mo ⟶
                  %msub
                    %mi X
                    %mn 2
                  %mo ⟶
                  %mi Y
                %annotation{:encoding => "application/x-tex"}
                  X_1 \longrightarrow X_2 \longrightarrow Y
          %p
            and so forth. Since relative
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            the resulting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⟶
                  %msub
                    %mi X
                    %mi n
                %annotation{:encoding => "application/x-tex"} X \longrightarrow X_n
            is still a
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi n
                  %mo ⟶
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X_n \longrightarrow Y
            to be a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/injective+morphism"} injective morphism
            becomes smaller and smaller, for it now lifts against all diagrams where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dom
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi X
                    %mi n
                %annotation{:encoding => "application/x-tex"} dom(c) \longrightarrow X_n
            factors through
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ⟶
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_{n-1}\longrightarrow X_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} X_{n-1}
            grow larger and larger.
          %p
            The concept of
            %em
              %a.existingWikiWord{:href => "/nlab/show/small+object"} small object
            is just what makes this intuition precise and finishes the small object argument. For the present purpose we just need the following simple version:
          #ClassOfMorphismsWithSmallDomains.num_defn
            %h6#definition_16 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C \subset Mor(\mathcal{C})
              a sub-
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of its morphisms, say that these have
              %em
                small
                %a.existingWikiWord{:href => "/nlab/show/domains"} domains
              if for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c\in C
              and for every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} f\colon X \longrightarrow \hat X
              every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
