                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi Top
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom_{Top}(I,Y)
            of continuous functions from the standard interval
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed "," do
              %a.maruku-ref{:href => "#TopologicalInterval"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is the set of continuous paths in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
            between its endpoints. Hence a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⟶
                  %msub
                    %mi Hom
                    %mi Top
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
