                            %mi I
                            %mi Top
                            %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} I_{Top}^{\mathcal{C}}
                  %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
                  (def.
                  = succeed "," do
                    %a.maruku-ref{:href => "#TopologicalCCellComplex"}
                  = succeed ")." do
                    %a.maruku-ref{:href => "#GeneratingCofibrationsForProjectiveStructureOnFunctors"}
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi Top
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}, Top_{Quillen}]_{proj}
            %p for the category of topologically enriched functors equipped with these classes of morphisms.
          #ProjectiveModelStructureOnTopEnrichedFunctors.num_theorem
            %h6#theorem_4 Theorem
            %p
              The classes of morphisms in def.
              %a.maruku-ref{:href => "#ClassesOfMorphismsInTheProjectiveModelStructureOnTopEnrichedFunctors"}
              constitute a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo ,
                      %mi Top
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top]
              %strong
                %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+enriched+functors"} projective model structure on enriched functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi Top
                        %mi Quillen
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top_{Quillen}]_{proj}
          %p
            (
            %a{:href => "#Piacenza91"}> Piacenza 91, theorem 5.4
            )
          .proof
            %h6#proof_29 Proof
            %p
              Via remark
              = succeed "," do
                %a.maruku-ref{:href => "#MorphismsFromTensoredRepresentableToTopologicallyEnrichedFunctor"}
              = succeed ":" do
                %a.maruku-ref{:href => "#TopQuillenModelStructure"}
            %p
              In particular, the technical lemmas
              = succeed "," do
                %a.maruku-ref{:href => "#CompactSubsetsAreSmallInCellComplexes"}
              %a.maruku-ref{:href => "#JTopRelativeCellComplexesAreWeakHomotopyEquivalences"}
              and
              %a.maruku-ref{:href => "#AcyclicSerreFibrationsAreTheJTopFibrations"}
              generalize immediately to the present situation, with the evident small change of wording.
            %p
              For instance the fact that a morphism of topologically enriched functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \eta \colon F \to G
              that has the right lifting property against the elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi I
                      %mi Top
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} I_{Top}^{\mathcal{C}}
              is a projective weak equivalence, follows by noticing that remark
              %a.maruku-ref{:href => "#MorphismsFromTensoredRepresentableToTopologicallyEnrichedFunctor"}
              gives a
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              of commuting diagrams (and their fillers) of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi y
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                              %mo ⋅
                              %msup
                                %mi S
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi F
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi id
                                    %mo ⋅
                                    %msub
                                      %mi ι
                                      %mi n
                                    %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi η
                          %mtr
                            %mtd
                              %mi y
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                              %mo ⋅
                              %msup
                                %mi D
                                %mi n
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi G
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi F
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi η
                                      %mi c
                          %mtr
                            %mtd
                              %msup
                                %mi D
                                %mi n
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi G
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    y(c) \cdot S^{n-1} &amp;\longrightarrow&amp; F
                    \\\
                    {}^{\mathllap{(id\cdot \iota_n)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\eta}}
                    \\\
                    y(c) \cdot D^n &amp;\longrightarrow&amp; G
                    }
                    \\right)
                    \\;\;\;\leftrightarrow\;\;\;
                    \\left(
                    \\array{
                    S^{n-1} &amp;\longrightarrow&amp; F(c)
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\eta_c}}
                    \\\
                    D^n &amp;\longrightarrow&amp; G(c)
                    }
                    \\right)
                    \\,,
            %p
              and hence the statement follows with part A) of the proof of lemma
              = succeed "." do
                %a.maruku-ref{:href => "#AcyclicSerreFibrationsAreTheJTopFibrations"}
            %p
              With these three lemmas in hand, the remaining formal part of the proof goes through verbatim as
              = succeed ":" do
                %a{:href => "#VerificationOfTopQuillen"} above
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              and the
              %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
              to establish the two weak factorization systems. (While again the structure of a
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
              is evident.)
          .num_remark
            %h6#remark_11 Remark
            %p
              The same argument applies to functors with values in the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi Quillen
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}, Top_{Quillen}^{\ast/}]
                    \\,.
          .num_example
            %h6#example_16 Example
            %p
              The
              %em strict
              %a.existingWikiWord{:href => "/nlab/show/Bousfield-Friedlander+model+structure"} Bousfield-Friedlander model structure
              on
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
              is equivalently the projective model structure on functors on the non-full subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top^{\ast/}
              on the “standard spheres” (see at
              = succeed ")" do
                %em
                  %a{:href => "sequential+spectrum#AsDiagramSpectra"} sequential spectrum – As diagram spectra
            %p
              The actual stable
              %a.existingWikiWord{:href => "/nlab/show/Bousfield-Friedlander+model+structure"} Bousfield-Friedlander model structure
              is then the
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
              of that at the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalences"} stable weak homotopy equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                    %mover
                      %mover
                        %mo ⟶
                        %mrow
                          %mi Bousf
                          %mo .
                          %mspace{:width => "thickmathspace"}
                          %mi loc
                          %mo .
                      %mo ⟵
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi strict
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi StdSpheres
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi Quillen
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    SeqSpec(Top)_{stable}
                    \\stackrel{\longleftarrow}{\overset{Bousf.\; loc.}{\longrightarrow}}
                    SeqSpec(Top)_{strict}
                    \\simeq
                    [StdSpheres, Top^{\ast/}_{Quillen}]_{proj}
                    \\,.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+topological+spaces"} model structure on topological spaces
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Str%C3%B8m+model+structure"} Strøm model structure
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+Delta-generated+topological+spaces"} model structure on Delta-generated topological spaces
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fine+model+structure+on+topological+G-spaces"} fine model structure on topological G-spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/coarse+model+structure+on+topological+G-spaces"} coarse model structure on topological G-spaces
                (
                %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"}> Borel model structure
                )
          %h2#references References
          %p The original article:
          %ul
            %li#Quillen67
              %a.existingWikiWord{:href => "/nlab/show/Dan+Quillen"}> Dan Quillen
              , chapter II, section 3 of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Homotopical+Algebra"} Homotopical Algebra
              = succeed "," do
                %strong 43
          %p An expository, concise and comprehensive writeup of the proof of the model category axioms:
          %ul
            %li#Hirschhorn15
              %a.existingWikiWord{:href => "/nlab/show/Philip+Hirschhorn"}> Philip Hirschhorn
              \:
              = succeed "," do
                %em The Quillen model category of topological spaces
              %strong 37
              1 (2019) 2-24 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/1508.01942"}> arXiv:1508.01942
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/j.exmath.2017.10.004"} doi:10.1016/j.exmath.2017.10.004
          %p
            Useful discussion of the issue of
            %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
            in the context of homotopy theory is in
          %ul
            %li#Lewis78
              %p
                %a.existingWikiWord{:href => "/nlab/show/L.+Gaunce+Lewis"}> L. Gaunce Lewis
                ,
                %em Compactly generated spaces
                (
                %a{:href => "http://www.math.uchicago.edu/~may/MISC/GaunceApp.pdf"}> pdf
                ), appendix A of
                %em The Stable Category and Generalized Thom Spectra
                PhD thesis Chicago, 1978
            %li#Strickland09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Neil+Strickland"}> Neil Strickland
                ,
                = succeed "," do
                  %em The category of CGWH spaces
                = succeed ")" do
                  %a{:href => "http://neil-strickland.staff.shef.ac.uk/courses/homotopy/cgwh.pdf"} pdf
          %p See also
          %ul
            %li#JoyalTierney08
              %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Myles+Tierney"} Myles Tierney
              = succeed "," do
                %em Notes on simplicial homotopy theory
              = succeed "," do
                %em
                  %a{:href => "https://lists.lehigh.edu/pipermail/algtop-l/2007q4/000017.html"} Advanced Course on Simplicial Methods in Higher Categories
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/JoyalTierneyNotesOnSimplicialHomotopyTheory.pdf", :title => "pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
            via the
            %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            (notably the
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Garth+Warner"}> Garth Warner
                \:
                %em Topics in Topology and Homotopy Theory
                (2003-7) [
                %a{:href => "https://sites.math.washington.edu//~warner/TTHT_Warner.pdf"}> pdf
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/2007.02467"} arXiv:2007.02467
            %li#SterlingKapulkin23
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sterling+Ebel"}> Sterling Ebel
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Chris+Kapulkin"} Chris Kapulkin
                %em Synthetic approach to the Quillen model structure on topological spaces
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2310.14235"}> arXiv:2310.14235
                \&amp;rbrack;
          %p
            The observation that the proof directly extends to give the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structures+on+enriched+functors"} projective model structures on enriched functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} Top_{Quillen}
          %ul
            %li#Piacenza91
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Piacenza"} Robert Piacenza
                section 5 of
                = succeed "," do
                  %em Homotopy theory of diagrams and CW-complexes over a category
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/Piazenza91.pdf", :title => "pdf"} pdf
              %p
                also chapter VI of
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                et al.,
                = succeed "," do
                  %em Equivariant homotopy and cohomology theory
                = succeed ")" do
                  %a{:href => "http://www.math.uchicago.edu/~may/BOOKS/alaska.pdf"} pdf
          %p The quick way to see the topological enrichment is indicated for instance in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              , pages 5-6 of
              %em Orbispaces, orthogonal spaces, and the universal compact Lie group
              (
              %a{:href => "http://www.math.uni-bonn.de/people/schwede/orbispaces.pdf"}> pdf
              )
