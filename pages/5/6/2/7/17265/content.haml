                              %mo{:stretchy => "false"} )
                          %mi dom
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                  %mrow
                                    %mi c
                                    %mo ∈
                                    %mo{:stretchy => "false"} (
                                    %mi C
                                    %mo{:stretchy => "false"} /
