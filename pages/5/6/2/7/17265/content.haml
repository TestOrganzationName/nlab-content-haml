              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi Top
                        %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} F \in [\mathcal{C}, Top_k]
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              between
            %ol
              %li
                %p
                  morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi X
                        %mo ⟶
                        %mi F
                      %annotation{:encoding => "application/x-tex"} y(c) \cdot X \longrightarrow F
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi 𝒞
                          %mo ,
                          %msub
                            %mi Top
                            %mi k
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top_k]
              %li
                %p
                  morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ⟶
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \longrightarrow F(c)
                  in
