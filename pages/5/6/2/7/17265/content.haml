                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi a
                            %mo ,
                            %mi b
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi 𝒟
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi F
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
