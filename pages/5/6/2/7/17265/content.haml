              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi κ
                    %mo ⇒
                    %msub
                      %mi const
                      %mi y
                  %annotation{:encoding => "application/x-tex"}
                    \\eta  \;\colon\; \kappa \Rightarrow const_y
            %p as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi α
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi n
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mi κ
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi id
                                %mo ,
                                %mn 0
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi D
                              %mi n
                            %mo ×
                            %mi I
                          %mtd
                            %mover
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi y
                          %mtd
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; S^{n-1} &amp;\overset{\alpha}{\longrightarrow}&amp; X
                    \\\
                    \&amp;&amp; {}^{\mathllap{\iota_n}}\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    \&amp;&amp; D^n &amp;\overset{\kappa}{\longrightarrow}&amp; Y
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{(id,1)}} &amp;&amp; \downarrow^{\mathrlap{id}}
                    \\\
                    D^n &amp;\overset{(id,0)}{\longrightarrow}&amp; D^n \times I &amp;\overset{\eta}{\longrightarrow}&amp; Y
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp;  \downarrow
                    \\\
                    \\ast &amp;&amp; \overset{y}{\longrightarrow} &amp;&amp; Y
                    }
            %p
              (for instance: regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              as embedded in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \in \mathbb{R}^n
              is identified with the basepoint on the boundary of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              and set
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} →
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi κ
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta(\vec v,t) \coloneqq \kappa(t \vec v)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              of the top two squares that have appeared this way is equivalent to the following commuting square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi α
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ×
                            %mi I
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi ι
                                  %mi n
                                %mo ,
                                %mi id
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi D
                              %mi n
                            %mo ×
                            %mi I
                          %mtd
                            %mover
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n-1} &amp;\longrightarrow&amp; &amp;\overset{\alpha}{\longrightarrow}&amp; X
                    \\\
                    {}^{\mathllap{(id,1)}}\downarrow
                    \&amp;&amp;
                    \&amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    S^{n-1} \times I
                    \&amp;\overset{(\iota_n, id)}{\longrightarrow}&amp;
                    D^n \times I
                    \&amp;\overset{\eta}{\longrightarrow}&amp;
                    Y
                    }
                    \\,.
            %p
              Because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo →
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} S^{n-1} \to S^{n-1}\times I
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
              %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              (see there), this has a
              %a.existingWikiWord{:href => "/nlab/show/lift"} lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ×
                    %mi I
                    %mo ⟶
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde \eta \;\colon\; S^{n-1} \times I \longrightarrow X
                    \\,.
            %p
              Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde \eta
              is a basepoint preserving
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ˜
                    %msub
                      %mo{:stretchy => "false"} |
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \alpha = \tilde \eta|_1
              to some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ′
                      %mo ≔
                      %mover
                        %mi η
                        %mo{:stretchy => "false"} ˜
                      %msub
                        %mo{:stretchy => "false"} |
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \alpha' \coloneqq \tilde \eta|_0
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_{n-1}(X,x)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo ′
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\alpha'] = [\alpha]
                    \\,.
            %p
              But the new representative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \alpha'
              has the special property that its image in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is not just trivializable, but trivialized: combining
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde \eta
              with the previous diagram shows that it sits in the following commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi α
                            %mo ′
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi id
                                %mo ,
                                %mn 0
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ×
                            %mi I
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi η
                                %mo{:stretchy => "false"} ˜
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi ι
                                  %mi n
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi ι
                                    %mi n
                                  %mo ,
                                  %mi id
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi id
                                %mo ,
                                %mn 0
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi D
                              %mi n
                            %mo ×
                            %mi I
                          %mtd
                            %mover
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                            %mo *
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi y
                          %mtd
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\alpha' \colon &amp; S^{n-1} &amp;\overset{(id,0)}{\longrightarrow}&amp; S^{n-1}\times I &amp;\overset{\tilde \eta}{\longrightarrow}&amp; X
                    \\\
                    \&amp; \downarrow^{\iota_n} &amp;&amp; \downarrow^{\mathrlap{(\iota_n,id)}} &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    \&amp; D^n &amp;\overset{(id,0)}{\longrightarrow}&amp; D^n \times I &amp;\overset{\eta}{\longrightarrow}&amp; Y
                    \\\
                    \&amp; \downarrow &amp;&amp; &amp;&amp;  \downarrow
                    \\\
                    \&amp; \ast &amp;&amp; \overset{y}{\longrightarrow} &amp;&amp; Y
                    }
                    \\,.
            %p
              The commutativity of the outer square says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mi α
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f_\ast \alpha'
              is constant, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \alpha'
              is entirely contained in the fiber
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi y
                    %annotation{:encoding => "application/x-tex"} F_y
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              gives that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \alpha'
              factors through
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi y
                      %mover
                        %mo ↪
                        %mi ι
                      %mi X
                    %annotation{:encoding => "application/x-tex"} F_y\overset{\iota}{\hookrightarrow} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo ′
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\alpha'] = [\alpha]
              is in the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \iota_\ast
          %h2#background_from_model_category_theory Background from model category theory
          %p
            This section recalls some standard arguments in
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            theory.
          #RetractsOfMorphisms.num_remark
            %h6#remark_5 Remark
            %p
              As usual, by a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \stackrel{f}{\longrightarrow} Y
              in some
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              we mean a retract in the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Delta[1]}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ⟶
                      %mi g
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \stackrel{g}{\longrightarrow} B
              such that in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\Delta[1]}
              there is a factorization of the identity on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo ⟶
                    %mi f
                    %mo ⟶
                    %mi g
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    id_g \;\colon\;
                    g \longrightarrow f \longrightarrow g
                    \\,.
            %p
              This means equivalently that in
