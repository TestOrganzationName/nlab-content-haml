                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y \colon \ast \to Y
              be any point and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
