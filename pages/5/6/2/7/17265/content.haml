          .proof
            %h6#proof_7 Proof
            %p We break this up into three sub-statements:
            %p
              %strong
                A)
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} I_{Top}
                %a.existingWikiWord{:href => "/nlab/show/injective+morphisms"} injective morphisms
                are in particular weak homotopy equivalences
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
