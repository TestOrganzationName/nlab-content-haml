                    %msup
                      %mi X
                      %mi Y
                    %mo ∈
                    %mi Top
                  %annotation{:encoding => "application/x-tex"}
                    X^Y \in Top
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %ul
              %li
                %p
                  whose underlying set is the set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi Top
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Hom_{Top}(Y,X)
                  of
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                          %mo →
                          %mi X
                        %annotation{:encoding => "application/x-tex"} Y \to X
              %li
                %p
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                  are
                  %a.existingWikiWord{:href => "/nlab/show/finitary+intersections"} finitary intersections
                  of
                  %a.existingWikiWord{:href => "/nlab/show/unions"} unions
                  of the following
                  %a.existingWikiWord{:href => "/nlab/show/topological+base"} subbase
                  of standard open subsets:
                %p
                  the standard open subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mrow
                            %mi K
                            %mo ,
                            %mi U
                        %mo ⊂
                        %msub
                          %mi Hom
                          %mi Top
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U_{K,U} \subset Hom_{Top}(Y,X)
                  for
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi K
                            %mo ↪
                            %mi Y
                          %annotation{:encoding => "application/x-tex"} K \hookrightarrow Y
                      a
                      %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
                      subset
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi U
                            %mo ↪
                            %mi X
                          %annotation{:encoding => "application/x-tex"} U \hookrightarrow X
                      an
                      %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                %p
                  is the subset of
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  of all those that fit into a
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi K
                              %mtd
                                %mo ↪
                              %mtd
                                %mi Y
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi f
                            %mtr
                              %mtd
                                %mi U
                              %mtd
                                %mo ↪
                              %mtd
                                %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        K &amp;\hookrightarrow&amp; Y
                        \\\
                        \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                        \\\
                        U &amp;\hookrightarrow&amp; X
                        }
                        \\,.
            %p
              Accordingly this is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
              on the set of functions.
            %p
              The construction extends to a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Top
                      %mi lcH
                      %mi op
                    %mo ×
                    %mi Top
                    %mo ⟶
                    %mi Top
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (-)^{(-)} \;\colon\; Top_{lcH}^{op} \times Top \longrightarrow Top
                    \\,.
          #MappingTopologicalSpaceIsExponentialObject.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              a
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
              %strong
                topological
                %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} X^Y
              from def.
              %a.maruku-ref{:href => "#CompactOpenTopology"}
              is an
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo ×
                    %mi Y
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo ,
                    %msup
                      %mi X
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{Top}(Z \times Y, X) \simeq Hom_{Top}(Z, X^Y)
            %p
              between continuous functions out of any
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              with any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo ∈
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Z \in Top
              and continuous functions from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              into the mapping space.
          .num_remark
            %h6#remark Remark
            %p
              Proposition
              %a.maruku-ref{:href => "#MappingTopologicalSpaceIsExponentialObject"}
              fails if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is not locally compact and Hausdorff. Therefore the plain category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of all topological spaces is not a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+closed+category"} Cartesian closed category
            %p
              This is no problem for the construction of the homotopy theory of topological spaces as such, but it becomes a technical nuisance when comparing it for instance to the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+theory"} simplicial homotopy theory
              via the singular
              %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
              adjunction, since it implies that
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              does not necessarily preserve
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            %p
              On the other hand, without changing any of the following discussion one may just pass to a more
              %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
              such as notably the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                    %mo ↪
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top_{cg} \hookrightarrow Top
              which is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+closed+category"} Cartesian closed
          #TopologicalPathSpace.num_defn
            %h6#definition_7 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %strong
                %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              is the topological
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
