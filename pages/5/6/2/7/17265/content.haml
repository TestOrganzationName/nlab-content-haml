                            %mi n
                            %mn 1
                      %mo ×
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} D^{n_1} \times D^{n_2} \times I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} S^{n_1} \times D^{n_2}
              is a subspace of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ×
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} D^{n_1} \times D^{n_2}
          #PullbackPowering.num_defn
            %h6#definition_26 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} i \colon A \to B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p \colon X \to Y
              be two morphisms in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
              = succeed "." do
                %a.maruku-ref{:href => "#kTop"}
              %strong pullback powering
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mo □
                        %mi i
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mi B
                    %mo ,
                    %msup
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    p^{\Box i}
                    \\coloneqq
                    (p^B, X^i)
            %p being the universal morphism in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi X
                              %mi B
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi p
                                    %mi B
                                  %mo ,
                                  %msup
                                    %mi X
                                    %mi i
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi Y
                              %mi B
                            %munder
                              %mo ×
                              %mrow
