                  %annotation{:encoding => "application/x-tex"} \eta \colon F \to G
              is
            %ul
              %li
                %p
                  a
                  = succeed "," do
                    %strong projective weak equivalence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} c\in Obj(\mathcal{C})
                  the component
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi c
                        %mo{:lspace => "verythinmathspace"} :
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \eta_c \colon F(c) \to G(c)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#WeakHomotopyEquivalenceOfTopologicalSpaces"}
              %li
                %p
                  a
                  %strong projective fibration
                  if for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} c\in Obj(\mathcal{C})
                  the component
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi c
                        %mo{:lspace => "verythinmathspace"} :
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \eta_c \colon F(c) \to G(c)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#SerreFibration"}
              %li
                %p
                  a
                  %strong projective cofibration
                  if it is a
                  %a.existingWikiWord{:href => "/nlab/show/retract"} retract
                  (rmk.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#RetractsOfMorphisms"}
                  = succeed "-" do
