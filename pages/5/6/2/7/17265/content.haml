              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C\subset Mor(\mathcal{C})
              be a sub-
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of its morphisms.
            %p
              Then every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injective+morphism"} injective morphism
              = succeed "," do
                %a.maruku-ref{:href => "#RightLiftingProperty"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              = succeed "," do
                %a.maruku-ref{:href => "#LiftingAndExtension"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
              %a.maruku-ref{:href => "#TopologicalCCellComplex"}
              and their
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
