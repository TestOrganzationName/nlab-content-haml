                    %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          .proof
            %h6#proof_28 Proof
            %p
              Given a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi X
                    %mo ⟶
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \eta \colon y(c) \cdot X \longrightarrow F
              consider its component
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi X
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_c \;\colon\; \mathcal{C}(c,c)\times X \longrightarrow F(c)
            %p
              and restrict that to the identity morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi c
                    %mo ∈
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} id_c \in \mathcal{C}(c,c)
              in the first argument
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_c(id_c,-) \;\colon\; X \longrightarrow F(c)
                    \\,.
            %p
              We claim that just this
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_c(id_c,-)
              already uniquely determines all components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi X
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d \;\colon\; \mathcal{C}(c,d)\times X \longrightarrow F(d)
            %p
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d \in Obj(\mathcal{C})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TopologicallyEnrichedFunctor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi η
                      %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    F(-) \circ \eta_c
                    \\;\colon\;
                    \\mathcal{C}(c,d)
                    \\longrightarrow
                    F(d)^{\mathcal{C}(c,c) \times X}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi d
                    %mo ∘
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_d  \circ \mathcal{C}(c,-) \times X
                    \\;\colon\;
                    \\mathcal{C}(c,d)
                    \\longrightarrow
                    F(d)^{\mathcal{C}(c,c) \times X}
            %p
              agree. This means that they may be thought of jointly as a function with values in commuting squares in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              of this form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi c
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi c
                                  %mo ,
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi d
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\;\;\;
                    \\mapsto
                    \\;\;\;\;
                    \\array{
                    \\mathcal{C}(c,c) \times X &amp;\overset{\eta_c}{\longrightarrow}&amp; F(c)
                    \\\
                    {}^{\mathllap{\mathcal{C}(c,f)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{F(f)}}
                    \\\
                    \\mathcal{C}(c,d) \times X &amp;\underset{\eta_d}{\longrightarrow}&amp; F(d)
                    }
            %p
              For any
              = succeed "," do
