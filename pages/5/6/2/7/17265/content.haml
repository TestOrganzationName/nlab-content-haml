                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon \hat X \to X
              have the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi Top
                  %annotation{:encoding => "application/x-tex"} I_{Top}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
