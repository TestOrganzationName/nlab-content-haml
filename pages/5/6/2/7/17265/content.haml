            %h6#example_11 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mn 1
                    %mo ↪
                    %msub
                      %mi Y
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} i_1 \colon X_1 \hookrightarrow Y_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mn 2
                    %mo ↪
                    %msub
                      %mi Y
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} i_2 \colon X_2 \hookrightarrow Y_2
              are inclusions, then their pushout product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 1
                    %mo □
                    %msub
                      %mi i
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} i_1 \Box i_2
              from def.
              %a.maruku-ref{:href => "#PushoutProduct"}
              is the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mi X
                        %mn 1
                      %mo ×
                      %msub
                        %mi Y
                        %mn 2
                      %mspace{:width => "thickmathspace"}
                      %mo ∪
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Y
                        %mn 1
