                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{Top}(I,X)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
          #CompactOpenTopology.num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              a
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
