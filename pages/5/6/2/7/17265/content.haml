                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a,b \in Obj(\mathcal{C})
            %p such that composition is respected, in the evident sense.
            %p
              For every object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
