            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            itself makes a
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi c
                              %mo ∈
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} /
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mi dom
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                  %mrow
                                    %mi c
                                    %mo ∈
                                    %mo{:stretchy => "false"} (
                                    %mi C
                                    %mo{:stretchy => "false"} /
                                    %mi f
                                    %mo{:stretchy => "false"} )
                                %mi c
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi f
                      %mtr
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi c
                              %mo ∈
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} /
                              %mi f
                              %mo{:stretchy => "false"} )
