          #kTopIsCoreflectiveSubcategory.num_cor
            %h6#corollary Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"} X \in Top_{cg}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %msub
                          %mi Top
                          %mi cg
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{Top}(X,Y) \simeq Hom_{Top_{cg}}(X, k(Y))
                    \\,,
            %p
              which means equivalently that the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#kfication"}
              %a.maruku-ref{:href => "#kTop"}
              forms an pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                    %mover
                      %munderover
                        %mo ⟵
                        %mi k
                        %mo ⊥
                      %mo ↪
                    %mi Top
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Top_{cg}
                    \\stackrel{\hookrightarrow}{\underoverset{k}{\bot}{\longleftarrow}}
                    Top
                    \\,.
            %p
              This in turn means equivalently that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                    %mo ↪
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top_{cg} \hookrightarrow Top
              is a
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
              with coreflector
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idemotent
              in that there are
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural
              %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    k(k(X))\simeq k(X)
                    \\,.
            %p
              Hence
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"} Top_{cg}
              exists and are computed as in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"} Top_{cg}
              exists, these are obtained by computing the limit in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              and then applying the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
