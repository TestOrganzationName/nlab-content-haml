            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mi cg
                %annotation{:encoding => "application/x-tex"} Top_{cg}
            are the following:
          %ul
            %li
              %p
                every
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                of a morphism in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cgwH
                      %mo ↪
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top_{cgwH} \hookrightarrow Top
                along a
                %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
                inclusion in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
                is again in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cgwH
                    %annotation{:encoding => "application/x-tex"} Top_{cgwH}
                (
                %a{:href => "http://mathoverflow.net/a/204221/381"}> MO comment by Peter May
                )
            %li
