                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/bulk+spacetime"} bulk
                    magnetic
                    %a.existingWikiWord{:href => "/nlab/show/flux+density"} flux density
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi G
                            %mn 4
                        %annotation{:encoding => "application/x-tex"} G_4
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi F
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} F_2
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/bulk+spacetime"} bulk
                    electric
                    %a.existingWikiWord{:href => "/nlab/show/flux+density"} flux density
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi G
                            %mn 7
                          %mo =
