            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mn 11
                %annotation{:encoding => "application/x-tex"} D=11
            supergravity; for more on this see:
          %ul
