            %p under construction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi X
                  %mrow
                    %mo (
                    %mfrac
                      %mn 1
                      %mn 6
                    %mrow
                      %mo (
                      %mi C
                      %mo ∧
                      %mi G
                      %mo ∧
                      %mi G
                      %mo −
                      %mi C
                      %mo ∧
                      %mfrac
                        %mn 1
                        %mn 8
                      %mrow
                        %mo (
                        %msub
                          %mi p
                          %mn 2
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mfrac
                          %mn 1
                          %mn 2
                        %msub
                          %mi p
                          %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                        %mo )
                      %mo )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\int_X
                  \\left(
                  \\frac{1}{6}
                  \\left(
                  C \wedge G \wedge G
                  \-
                  C \wedge
                  \\frac{1}{8}
                  \\left(
                  p_2 + (\frac{1}{2}p_1)^2
                  \\right)
                  \\right)
                  \\right)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi i
                %annotation{:encoding => "application/x-tex"} p_i
            is the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo ≔
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\lambda \coloneqq \frac{1}{2}p_1
                  \\,.
          %p
            Concerning the integrality of the
            = succeed "-term" do
              %a.existingWikiWord{:href => "/nlab/show/I8"} I8
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mn 8
                  %mo ≔
                  %mfrac
                    %mn 1
                    %mn 48
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mn 2
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  I_8 \coloneqq \frac{1}{48}(p_2 + (\lambda)^2)
          %p
            on a
            %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin manifold
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ")" do
              %a{:href => "#Witten96"} Witten96, p.9
          %p
            First, the
            %a.existingWikiWord{:href => "/nlab/show/index"} index
            of a
            %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 1440
                  %mo{:stretchy => "false"} (
                  %mn 7
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo −
                  %msub
                    %mi p
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  I = \frac{1}{1440}(7 (\frac{1}{2}p_1)^2 - p_2) \in \mathbb{Z}
                  \\,.
          %p
            Notice that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1440
                    %mo =
                    %mn 6
                    %mo ×
                    %mn 8
                    %mo ×
                    %mn 30
                  %annotation{:encoding => "application/x-tex"} 1440 = 6 \times 8 \times 30
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 2
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo =
                  %mn 6
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo −
                  %mn 30
                  %mo ×
                  %mn 8
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  p_2 - (\frac{1}{2}p_2)^2 = 6 ( (\frac{1}{2}p_1)^2 - 30 \times 8 I)
          %p is divisible by 6.
          %p
            Assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\frac{1}{2}p_1)
            is further divisible by 2 (see the relevant discussion at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 2
                  %mi x
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\frac{1}{2}p_1) = 2 x
                  \\,.
          %p Then the above becomes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 2
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo =
                  %mn 24
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi x
                    %mn 2
                  %mo −
                  %mn 30
                  %mo ×
                  %mn 2
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  p_2 - (\frac{1}{2}p_2)^2 = 24 ( x^2 - 30 \times 2 I)
          %p
            and hence then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 2
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                %annotation{:encoding => "application/x-tex"} p_2 + (\frac{1}{2}p_1)^2
            is divisible at least by 24.
          %p
            But moreover, on a
            %a.existingWikiWord{:href => "/nlab/show/spin+structure"} Spin manifold
            the
            %a.existingWikiWord{:href => "/nlab/show/first+fractional+Pontryagin+class"} first fractional Pontryagin class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}p_1
            is the
            %a.existingWikiWord{:href => "/nlab/show/Wu+class"} Wu class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ν
                    %mn 4
                %annotation{:encoding => "application/x-tex"} \nu_4
            (see there). By definition this means that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mn 2
                  %mo =
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi mod
                  %mspace{:width => "thickmathspace"}
                  %mn 2
                %annotation{:encoding => "application/x-tex"}
                  x^2 = x (\frac{1}{2}p_1) \; mod \; 2
          %p
            and so when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                %annotation{:encoding => "application/x-tex"} (\frac{1}{2}p_1)^2
            is further divisible by 2 we have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 2
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                %annotation{:encoding => "application/x-tex"} p_2 - (\frac{1}{2}p_1)^2
            is divisible by 48. Hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mn 8
                %annotation{:encoding => "application/x-tex"} I_8
            is integral.
          %h3#HigherCurvatureCorrection Higher curvature corrections
          %p
            Possible
            %a.existingWikiWord{:href => "/nlab/show/higher+curvature+corrections"} higher curvature corrections
            to 11-dimensional supergravity are discussed in the references listed
            = succeed "." do
              %a{:href => "#ReferencesOnHigherCurvatureCorrectionsIn11dSupergravity"} below
          %p
            The first correction is an
            = succeed "-term" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} R^4
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℓ
                    %mi P
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \ell^3_{P}
            (11d
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Planck+length"} Planck length
            %a{:href => "#Tsimpis04"} Tsimpis 04
            it is shown that part of this is a topological term (total derivative) which relates to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/shifted+C-field+flux+quantization"} shifted C-field flux quantization
          %p
            For effects of higher curvature corrections in a
            %a.existingWikiWord{:href => "/nlab/show/Starobinsky+model+of+cosmic+inflation"} Starobinsky model of cosmic inflation
            see
            = succeed "." do
              %a{:href => "Starobinsky+model+of+cosmic+inflation#EmbeddingIntoSupergravity"} there
          %h3#the_hidden_deformation The hidden deformation
          %p
            There is in fact a hidden 1-parameter deformation of the Lagrangian of 11d sugra. Mathematically this was maybe first noticed in (
            %a{:href => "#DAuriaFre"}> D’Auria-Fre 82
            ) around equation (4.25). This shows that there is a topological term which may be expressed as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∝
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi X
                          %mn 11
                    %msub
                      %mi G
                      %mn 4
                    %mo ∧
                    %msub
                      %mi G
                      %mn 7
                %annotation{:encoding => "application/x-tex"}
                  \\propto
                  \\;
                  \\textstyle{\int}_{X_11} G_4 \wedge G_7
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 4
                %annotation{:encoding => "application/x-tex"} G_4
            is the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            3-form of the
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 7
                %annotation{:encoding => "application/x-tex"} G_7
            that of the
            %a.existingWikiWord{:href => "/nlab/show/electric-magnetic+duality"} magnetically dual
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/C6-field"} C6-field
            = succeed ")" do
              %a{:href => "#DAuriaFre"} D’Auria-Fre 82
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/instanton+sector"} instanton sector
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
          %p
            The term then re-appears in the literatur in (
            %a{:href => "#BandosBerkovitsSorokin97"}> Bandos-Berkovits-Sorokin 97, equation (4.13)
            ). And it seems that this is the same term later also redicovered around equation (4.2) in (
            %a{:href => "#Tsimpis04"}> Tsimpis 04
            ).
          %blockquote
            %p (hm, check)
          %h2#properties Properties
          %h3#bps_states BPS states
          %p
            The basic
            %a.existingWikiWord{:href => "/nlab/show/BPS+states"} BPS states
            of 11d SuGra are
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
            %li
