                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \infty Grpd
          .num_prop
            %h6#proposition_15 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              are locally
              = succeed "-connected," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/petit+topos"} petit
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-toposes"} over-(∞,1)-toposes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
              are locally
              = succeed "-connected." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            %p
              The two notions of fundamental
              = succeed "-groupoids" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              induced this way do agree, in that there is a natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_X(X \in \mathbf{H}/X) \simeq \Pi(X \in \mathbf{H})
                    \\,.
          .proof
            %h6#proof_13 Proof
            %p
              By the general facts recalled at
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+geometric+morphism"} étale geometric morphism
              we have a composite
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Π
                      %mi X
                    %mo ⊣
                    %msub
                      %mi Δ
                      %mi X
                    %mo ⊣
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mrow
                            %msub
                              %mo{:lspace => "0em", :rspace => "thinmathspace"} X
                              %mo *
                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi X
                              %mo *
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi X
                            %mo !
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mi Γ
                        %mover
                          %mo ←
                          %mi Δ
                      %mover
                        %mo →
                        %mi Π
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi_X \dashv \Delta_X \dashv \Gamma_X) :
                    \\mathbf{H}_{/X}
                    \\stackrel{\overset{X_!}{\to}}{\stackrel{\overset{X^*}{\leftarrow}}{\underset{\X_*}{\to}}}
                    \\mathbf{H}
                    \\stackrel{\overset{\Pi}{\to}}{\stackrel{\overset{\Delta}{\leftarrow}}{\underset{\Gamma}{\to}}}
                    \\infty Grpd
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo !
                  %annotation{:encoding => "application/x-tex"} X_!
              is given by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} (Y \to X) \in \mathbf{H}/X
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} Y \in \mathbf{H}
          %h3#A1HomotopyContinuum
            Cohesive
            = succeed "-homotopy" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
          .num_defn
            %h6#definition_15 Definition
            %p
              An object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1 \in \mathbf{H}
              is called a
              %strong
                line object exhibiting the cohesion of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              if the
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ʃ
                  %annotation{:encoding => "application/x-tex"} &amp;#643;
              (hence the reflector
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo :
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo →
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \Pi : \mathbf{H} \to \infty Grpd
              %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization of an (∞,1)-category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              at the class of morphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi X
                      %mo ×
                      %msup
                        %mi 𝔸
                        %mn 1
                      %mo →
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi X
                          %mo ∈
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                    %annotation{:encoding => "application/x-tex"} \{ X \times \mathbb{A}^1 \to X \}_{X \in \mathbf{H}}
          #RealLineIsTheContinuum.num_example
            %h6#example Example
            %p
              The cohesion of
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              %em is exhibited
              (in the sense defined
              = succeed ")" do
                %a{:href => "cohesive+%28infinity%2C1%29-topos#A1ExhibitingCohesion"} here
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              (the standard
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/continuum"} continuum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} \mathbb{R} \in
              %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ↪
                  %annotation{:encoding => "application/x-tex"} \hookrightarrow
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
          %p
            This is (
            %a{:href => "#dcct"}> dcct, 3.9.1
            ).
          .num_remark
            %h6#remark_3 Remark
            %p
              The analogous notion in
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+cohesion"} infinitesimal cohesion
              is discussed in
              = succeed "-topos+\u2013+infinitesimal+cohesion#InfinitesimalA1Homotopy)." do
                %a{:href => "#cohesive+(infinity%2C1"} infinitesimal cohesion – infinitesimal A1-homotopy
          %p See also at
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/A1-homotopy+theory"} A1-homotopy theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/continuum"} continuum
          %h3#GaloisTheory Galois theory
          %p
            We discuss a canonical internal notion of
            %a.existingWikiWord{:href => "/nlab/show/Galois+theory"} Galois theory
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .num_defn
            %h6#definition_16 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              a
              %a.existingWikiWord{:href => "/nlab/show/regular+cardinal"} regular cardinal
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Core
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mi κ
                    %mo ∈
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    Core \infty Grpd_\kappa \in \infty Grpd
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "s:" do
                %a.existingWikiWord{:href => "/nlab/show/small+%28%E2%88%9E%2C1%29-category"} small ∞-groupoid
              %a.existingWikiWord{:href => "/nlab/show/core"} core
              of the full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              on the
              = succeed "-small" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
          .num_remark
            %h6#remark_4 Remark
            %p We have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Core
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mi κ
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Core \infty Grpd_\kappa \simeq
                    \\coprod_i \mathbf{B} Aut(F_i)
                    \\,,
            %p
              where the coproduct ranges over all
              = succeed "-small" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi F
                      %mi i
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [F_i]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aut(F_i)
              is the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-group"} automorphism ∞-group
              of any representative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi i
                  %annotation{:encoding => "application/x-tex"} F_i
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi F
                        %mi i
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [F_i]
          .num_defn
            %h6#definition_17 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LConst
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Disc
                    %mi Core
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mi κ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    LConst(X) := \mathbf{H}(X, Disc Core \infty Grpd_\kappa)
                    \\,.
            %p
              We call this the
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %strong
                %a.existingWikiWord{:href => "/nlab/show/locally+constant+%E2%88%9E-stack"}> locally constant ∞-stack
                s
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .num_observation
            %h6#observation_4 Observation
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              is
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              and
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              it commutes with
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              and therefore
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi Core
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mi κ
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Disc
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Disc Core \infty Grpd_\kappa
