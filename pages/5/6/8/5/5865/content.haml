          #DeRhamAdjunction.num_prop
            %h6#proposition_23 Proposition
            %p
              The construction in def.
              %a.maruku-ref{:href => "#drFlatAnddRShape"}
              yields a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functors"} adjoint (∞,1)-functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                    %mo ⊣
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %munder
                        %mo →
