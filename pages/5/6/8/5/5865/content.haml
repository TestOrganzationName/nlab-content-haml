              over each of the chosen points
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi dR
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} * \to \mathbf{H}_{dR}(X,\mathbf{B}^{n+1}A)
          #DiffCohomologyRestrictedToVanishingCurvature.num_prop
            %h6#proposition_30 Proposition
            %p
              When restricted to vanishing curvature, differential cohomology coincides with
              = succeed ":" do
                %a{:href => "#FlatDifferentialCohomology"} flat differential cohomology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi diff
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi F
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                    %mo ≃
                    %msub
                      %mi H
                      %mi flat
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_{diff}^n (X,A)|_{[F] = 0} \simeq H_{flat}(X,\mathbf{B}^n A)
                    \\,.
            %p
              Moreover this is true at the level of
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi diff
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi A
                      %mo{:stretchy => "false"} )
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %msubsup
                            %mi H
                            %mi dR
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} [
                      %mi F
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mn 0
                      %mo{:stretchy => "false"} }
                      %mo )
                    %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi flat
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\mathbf{H}_{diff}(X, \mathbf{B}^n A)
                    \\prod_{H_{dR}^{n+1}(X,A)} \{[F] = 0\}
                    \\right)
                    \\simeq
                    \\mathbf{H}_{flat}(X,\mathbf{B}^n A)
                    \\,.
          .proof
            %h6#proof_32 Proof
            %p
              By the
              %a{:href => "http://ncatlab.org/nlab/show/(infinity%2C1)-pullback#QuasiCatPastingLaw"} pasting law for (∞,1)-pullbacks
              the claim is equivalently that we have an
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi flat
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} {
                                  %mo{:stretchy => "false"} [
                                  %mi F
                                  %mo{:stretchy => "false"} ]
                                  %mo =
                                  %mn 0
                                  %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi diff
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi F
                                %mo{:stretchy => "false"} ]
                          %mtd
                            %msubsup
                              %mi H
                              %mi dR
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi η
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi curv
                                  %mo *
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi dR
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{H}_{flat}(X, \mathbf{B}^n A) &amp;\to&amp; {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\{[F] = 0\}}}
                    \\\
                    \\mathbf{H}_{diff}(X,\mathbf{B}^n A) &amp;\stackrel{[F]}{\to}&amp;
                    H_{dR}^{n+1}(X,A)
                    \\\
                    {}^{\mathllap{\eta}}\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{H}(X,\mathbf{B}^n A)
                    \&amp;\stackrel{curv_*}{\to}&amp;
                    \\mathbf{H}_{dR}(X,\mathbf{B}^{n+1} A)
                    }
                    \\,.
            %p
              By definition of flat cohomology and of intrinsic de Rham cohomology in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi curv
                                  %mo *
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{H}(X,\mathbf{\flat}\mathbf{B}^n A) &amp;\to&amp; {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{H}(X, \mathbf{B}^n A)
                    \&amp;\stackrel{curv_*}{\to}&amp;
                    \\mathbf{H}(X, \mathbf{\flat}_{dR}\mathbf{B}^{n+1} A)
                    }
                    \\,.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,-)
              preserves
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mo ♭
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi curv
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mo ♭
                              %mi dR
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{\flat} \mathbf{B}^n A &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{B}^n A
                    \&amp;\stackrel{curv}{\to}&amp;
                    \\mathbf{\flat}_{dR} \mathbf{B}^{n+1} A
                    }
            %p
              is. Indeed, this is one step in the
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %mstyle{:mathvariant => "bold"}
