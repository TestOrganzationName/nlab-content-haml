          %h3#InfinGroups
            Cohesive
            = succeed "-Groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            comes with a notion of
            %a.existingWikiWord{:href => "/nlab/show/group+object+in+an+%28%E2%88%9E%2C1%29-category"} ∞-group objects
            that generalizes the traditional notion of grouplike
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} A_\infty
            spaces in
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≃
                %annotation{:encoding => "application/x-tex"} \simeq
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
          .num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              an object and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x : * \to X
              a point, the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ω
                        %mi x
                      %mi X
                      %mo :
                      %mo =
                      %mo *
                      %msub
                        %mo ×
                        %mi X
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \Omega_x X := * \times_X *
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Ω
                              %mi x
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi x
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo →
                              %mi x
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Omega_x X &amp; \to &amp; {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{x}}
                    \\\
                    {*} &amp; \stackrel{x}{\to} &amp; X
                    }
                    \\,.
          %p
            This object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi x
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega_x X
            is canonically equipped with the structure of an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            obect.
          .num_remark
            %h6#remark_2 Remark
            %p
              Notice that every
              %a.existingWikiWord{:href => "/nlab/show/0-connected"} 0-connected
              object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in the cohesive
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              does have a global point (then necessarily essentially unique)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} * \to A
          %p
            This follows from the
            %a{:href => "#PointLike"} above proposition
            which says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            necessarily has
            %a.existingWikiWord{:href => "/nlab/show/homotopy+dimension"} homotopy dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \leq 0
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The operation of forming
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              establishes an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo :
                    %mi PointedConnected
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega : PointedConnected(\mathbf{H}) \stackrel{\simeq}{\to} Grp(\mathbf{H})
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/group+object+in+an+%28%E2%88%9E%2C1%29-category"} group object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              and the full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} */\mathbf{H}
              on those that are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/0-connected"} 0-connected
          .proof
            %h6#proof_3 Proof
            %p
              By the discussion at
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/groupoid+object+in+an+(infinity%2C1)-category#Delooping"} delooping
          %p We write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo :
                  %mi Grpd
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi PointedConnected
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B} : Grpd(\mathbf{H}) \to  PointedConnected(\mathbf{H})
          %p
            for the inverse to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∈
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \in Grp(\mathbf{H})
            we call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ∈
                  %mi PointedConnected
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in PointedConnected(\mathbf{H}) \hookrightarrow \mathbf{H}
            the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            Notice that since the cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            has
            %a.existingWikiWord{:href => "/nlab/show/homotopy+dimension"} homotopy dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            by the
            %a{:href => "#PointLike"} above proposition
            every 0-connected object has an essentially unique point, but nevertheless the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo{:stretchy => "false"} /
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} */\mathbf{H}(\mathbf{B}G, \mathbf{B}H)
            may differ from that of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(\mathbf{B}G, \mathbf{B}H)
          .num_prop
            %h6#observation Observation
            %p
              The delooping object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in \mathbf{H}
              is concrete precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is.
          %p
            We may therefore unambiguously speak of
            = succeed "." do
              %strong
                concrete cohesive
                = succeed "-groups" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          .num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Y
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} f : Y \to Z
              any morhism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo :
                    %mo *
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} z : * \to Z
              a point, the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} ∞-fiber
              or of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              over this point is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo :
                    %mo =
                    %mo *
                    %msub
                      %mo ×
                      %mi Z
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X := {*} \times_Z Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi z
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi Z
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp; \to &amp; {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{z}}
                    \\\
                    Y &amp; \stackrel{f}{\to} &amp; Z
                    }
                    \\,.
          .num_remark
            %h6#observation_2 Observation
            %p
              Suppose that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is pointed and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a morphism of pointed objects. Then the
              = succeed "-fiber" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-fiber" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
              of the base.
          %p This means that we have a diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi Ω
                            %mi z
                          %mi Z
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi Y
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi Z
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Omega_z Z  &amp; \to&amp; X &amp; \to &amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                  \\\
                  {*} &amp; \to &amp; Y &amp; \stackrel{f}{\to} &amp; Z
                  }
                  \\,,
          %p
            where the outer rectangle is an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            if the left square is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            = succeed "-pullbacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
          .num_prop
            %h6#proposition_5 Proposition
            %p
              If the cohesive
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              has an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
              of definition
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %ul
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
                  object has a presentation by a presheaf of
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi C
                          %mi op
                        %mo ,
                        %mi sGrp
                        %mo{:stretchy => "false"} ]
                        %mover
                          %mo →
                          %mi U
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi C
                          %mi op
                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        G \in [C^{op}, sGrp] \stackrel{U}{\to} [C^{op}, sSet]
                %p
                  which is fibrant in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi C
                            %mi op
                          %mo ,
                          %mi sSet
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mi proj
                        %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              %li
                %p
                  the corresponding
                  %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                  object is presented by the presheaf
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi W
                          %mo{:stretchy => "false"} ¯
                        %mi G
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi C
                          %mi op
                        %mo ,
                        %msub
                          %mi sSet
                          %mn 0
                        %mo{:stretchy => "false"} ]
                        %mo ↪
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi C
                          %mi op
                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        \\bar W G \in [C^{op}, sSet_0] \hookrightarrow [C^{op}, sSet]
                %p
                  which is given over each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} U \in C
                  by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi W
                          %mo{:stretchy => "false"} ¯
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \bar W (G(U))
                  (see
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
                  for the notation).
          .proof
            %h6#proof_4 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} * \to X \in [C^{op}, sSet]_{proj,loc}
              be a locally fibrant representative of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} * \to \mathbf{B}G
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              is indeed presented by the presheaf constant on the point we have functorial choices of basepoints in all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X(U)
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \in C
              and by assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X(U)
              are connected. Hence without loss of generality we may assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is presented by a presheaf of reduced simplicial sets
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %mi X
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} X \in [C^{op}, sSet_0] \hookrightarrow X \in [C^{op}, sSet]
            %p
              Then notice the
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              between the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+reduced+simplicial+sets"} model structure on reduced simplicial sets
              and the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+groups"} model structure on simplicial groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo ⊣
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi sGrp
                    %mover
                      %munder
                        %mo →
                        %mover
                          %mi W
                          %mo{:stretchy => "false"} ¯
                      %mover
                        %mo ←
                        %mi Ω
                    %msub
                      %mi sSet
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\Omega \dashv \bar W) : sGrp \stackrel{\overset{\Omega}{\leftarrow}}{\underset{\bar W}{\to}}
                    sSet_0
                    \\,.
            %p
              In particular its
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              is a weak equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi Ω
                    %mi Y
                    %mover
                      %mo →
                      %mo ≃
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\bar W \Omega Y \stackrel{\simeq}{\to} Y
            %p
              for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∈
                    %msub
                      %mi sSet
                      %mn 0
                    %mo ↪
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} Y \in sSet_0 \hookrightarrow sSet_{Quillen}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi Ω
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \bar W \Omega Y
              is always a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi Ω
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"}
                    \\bar W \Omega X \in [C^{op}, sSet]_{proj}
            %p
              is an equivalent representative for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              involved in forming
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Ω
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi W
                            %mi Ω
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo →
                          %mtd
                            %mover
                              %mi W
                              %mo{:stretchy => "false"} ¯
                            %mi Ω
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Omega X &amp;\to&amp; W \Omega X
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    * &amp;\to&amp; \bar W \Omega X
                    }
            %p is
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  diagram in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi C
                          %mi op
                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]
                  (because it is so over each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} U \in C
                  by the general discussion at
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
                  of the point along itself (since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mi G
                        %mo →
                        %mover
                          %mi W
                          %mo{:stretchy => "false"} ¯
                        %mi G
                      %annotation{:encoding => "application/x-tex"} W G \to \bar W G
                  is objectwise a fibration
                  %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
                  of the point inclusion).
          %h3#Cohomology
            Cohomology and principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            There is an intrinsic notion of
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            and of
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
            in any
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .num_defn
            %h6#definition_5 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi A
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X,A \in \mathbf{H}
              two
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H(X,A) := \pi_0 \mathbf{H}(X,A)
            %p
              is the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                set
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with coefficients in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi G
                  %annotation{:encoding => "application/x-tex"} A = G
              is an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^1(X,G) := \pi_0 \mathbf{H}(X, \mathbf{B}G)
            %p
              for cohomology with coefficients in its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} K \in \mathbf{H}
              has a
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi p
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^p(X,K) := \pi_0 \mathbf{H}(X, \mathbf{B}^p K)
                    \\,.
          %p
            In the context of cohomology on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            we we say that
          %ul
            %li
              %p
                the hom-space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,A)
                is the
                = succeed ";" do
                  %strong
                    cocycle
                    = succeed "-groupoid" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi X
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} g : X \to A
                is a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
                \:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ⇒
                      %mi h
                    %annotation{:encoding => "application/x-tex"} g \Rightarrow h
                is a
                %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
                between cocycles.
            %li
              %p
                a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} c : A \to B
                represents the
                %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi c
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      [c] : H(-,A) \to H(-,B)
                      \\,.
          .num_defn
            %h6#definition_6 Definition
            %p
              For every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi H
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} c : \mathbf{B}G \to \mathbf{B}H \in \mathbf{H}
              define the
              %strong
                long
                %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
                to the left
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %mi Ω
                    %mi G
                    %mo →
                    %mi Ω
                    %mi H
                    %mo →
                    %mi F
                    %mo →
                    %mi G
                    %mo →
