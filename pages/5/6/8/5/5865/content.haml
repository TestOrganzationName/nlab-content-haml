            \.
          %h3#TwistedCohomology Twisted cohomology and section
          %p
            A slight variant of
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            is often relevant:
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
          #TwistedCohomologyInOvertopos.num_defn
            %h6#definition_10 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{c} : B \to C
              a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              representing a
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [\mathbf{c}] \in H(B,C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \to B
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            %p
              We say that the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              relative to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              is the
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} intrinsic cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-topos"} over-(∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}/C
              with coefficients in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              is understood and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi X
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \phi : X \to B
              is any morphism, we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}_{\phi}(X, A)
                    \:=
                    \\mathbf{H}/C(\phi, \mathbf{c})
            %p
              and speak of the
              %em
                %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
                of twisted cohomology on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                with coefficients in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and twisting cocycle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                relative to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathbf{c}]
              \.
          %p
            For short we often say
            %em twist
            for
            %em twisting cocycle
            \.
          #DirectPropsOfTwistedCohomology.num_prop
            %h6#proposition_10 Proposition
            %p We have the following immediate properties of twisted cohomology:
            %ul
              %li
                %p
                  The
                  = succeed "-twisted" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                        %annotation{:encoding => "application/x-tex"} \phi
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                      %annotation{:encoding => "application/x-tex"} \mathbf{c}
                  depends, up to
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
                  %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo ,
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} [\mathbf{c}] \in H(B,C)
                  represented by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                      %annotation{:encoding => "application/x-tex"} \mathbf{c}
                  and also only on the equivalence class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi ϕ
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} [\phi] \in H(X,C)
                  of the twist.
              %li
                %p
                  If the characteristic class is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo :
                        %mi B
                        %mo →
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \mathbf{c} : B \to *
                  we have
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ≃
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A \simeq B
                  and the corresponding twisted cohomology is ordinary cohomology with coefficients in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
          #PullbackCharacterizationOfTwistedCohomology.num_prop
            %h6#proposition_11 Proposition
            %p
              Let the
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{c} : B \to C
              and a twist
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi X
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \phi : X \to C
              be given. Then the cocycle
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ϕ
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                                  %mo *
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi C
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{H}_{\phi}(X,A) &amp;\to&amp; {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\phi}}
                    \\\
                    \\mathbf{H}(X,B) &amp;\stackrel{\mathbf{c}_*}{\to}&amp;
                    \\mathbf{H}(X,C)
                    }
            %p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          .proof
            %h6#proof_9 Proof
            %p
              This is an application of the general pullback-formula for hom-spaces in an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-category"} over-(∞,1)-category
          #TrivialTwistYieldsOrdinaryCohomology.num_prop
            %h6#proposition_12 Proposition
            %p
              If the twist is trivial,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \phi = 0
              (meaning that it factors as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi X
                    %mo →
                    %mo *
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \phi : X \to * \to C
              through the point of the pointed object
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mi ϕ
                        %mo =
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}_{\phi = 0}(X,A)
                    \\simeq
                    \\mathbf{H}(X,A)
                    \\,.
          .proof
            %h6#proof_10 Proof
            %p
              In this case we have that the characterizing
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.maruku-ref{:href => "#PullbackCharacterizationOfTwistedCohomology"}
              is the image under the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,-) : \mathbf{H} \to \infty Grpd
              of the pullback diagram
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mover
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                      %mi C
                      %mo ←
                      %mo *
                    %annotation{:encoding => "application/x-tex"} B \stackrel{\mathbf{c}}{\to} C \leftarrow *
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                    %annotation{:encoding => "application/x-tex"} \mathbf{c}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,-)
              preserves
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullbacks"} (∞,1)-pullbacks
              the claim follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mi ϕ
                                %mo =
                                %mn 0
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi H
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi C
                                %mo{:stretchy => "false"} )
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mo *
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi B
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi C
                            %mo *
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{H}_{\phi = 0 }(X,A)
                    \&amp; \simeq
                    \\mathbf{H}(X,B) \prod_{\mathbf{H}(X,C)} \mathbf{H}(X,*)
                    \\\
                    \&amp; \simeq
                    \\mathbf{H}(X, B \prod_C *)
                    \\\
                    \&amp; \simeq
                    \\mathbf{H}(X,A)
                    \\end{aligned}
                    \\,.
          %p Often twisted cohomology is formulated in terms of homotopy classes of sections of a bundle. The following asserts that this is equivalent to the above definition.
          %p
            By the discussion at
            %a{:href => "#Cohomology"} Cohomology and principal ∞-bundles
            we may understand the twist
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi X
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \phi : X \to C
            as the cocycle for an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \Omega C
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            of the point inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} * \to C
            along
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \Omega C
            = succeed "-bundle." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} B \to C
            in turn we may think of as an
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Omega A
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            to this universal bundle. Accordingly the pullback of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi ϕ
                  %mo :
                  %mo =
                  %mi X
                  %msub
                    %mo ×
                    %mi C
                  %mi B
                %annotation{:encoding => "application/x-tex"} P_\phi := X \times_C B
            is the associated
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Omega A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            classified by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
          #TwistedCohomologyBySections.num_prop
            %h6#proposition_13 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi ϕ
                    %mo :
                    %mo =
                    %mi X
                    %msub
                      %mo ×
                      %mi C
                    %mi B
                  %annotation{:encoding => "application/x-tex"} P_\phi := X \times_C B
              be
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              of the
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              along the twisting cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi P
                              %mi ϕ
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi p
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi ϕ
                          %mtd
                            %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P_\phi &amp;\to&amp; B
                    \\\
                    {}^{\mathllap{p}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\mathbf{c}}}
                    \\\
                    X &amp;\stackrel{\phi}{\to}&amp; C
                    }
                    \\,.
            %p
              Then the
              = succeed "-twisted" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is equivalently the space of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/section"} section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi P
                      %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_X(P_\phi)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi ϕ
                  %annotation{:encoding => "application/x-tex"} P_\phi
              over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mi tw
                        %mo ,
                        %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi P
                      %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}_{tw,\phi}(X,A)
