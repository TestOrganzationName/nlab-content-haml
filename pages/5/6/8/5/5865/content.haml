                    \\coprod_i \mathbf{B} Disc Aut(F_i)
                    \\,.
            %p
              Therefore a cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi LConst
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \in LConst(X)
              may be identified on each geometric connected component of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                      %mi Aut
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Disc Aut(F_i)
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              for the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                      %mi Aut
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} Disc Aut(F_i) \in \mathbf{H}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \in \mathbf{H}/X
              in the
              %a.existingWikiWord{:href => "/nlab/show/little+topos"} little topos
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LConst
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} LConst(X)
              are indeed identified
              = succeed "-stacks" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            The following proposition says that the central statements of
            %a.existingWikiWord{:href => "/nlab/show/Galois+theory"} Galois theory
            hold for these canonical notions of geometric homotopy groups and locally constant
            = succeed "-stacks." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .num_prop
            %h6#proposition_16 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected
            %ul
              %li
                %p a natural equivalence
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi LConst
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mn ∞
                        %mi{:mathvariant => "normal"} Grpd
                        %mo{:stretchy => "false"} (
                        %mi Π
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mn ∞
                        %msub
                          %mi Grpd
                          %mi κ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        LConst(X) \simeq \infty \mathrm{Grpd}(\Pi(X), \infty Grpd_\kappa)
                %p
                  of locally constant
                  = succeed "-stacks" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  with
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
                  %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (
                  %a.existingWikiWord{:href => "/nlab/show/local+system"}> local system
                  s on
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  for every point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo :
                        %mo *
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x : * \to X
                  a natural equivalence of the endomorphisms of the fiber functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi x
                          %mo *
                      %annotation{:encoding => "application/x-tex"} x^*
                  and the
                  %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Π
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Pi(X)
                  at
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi End
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi x
                          %mo *
                        %mo :
                        %mi LConst
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mn ∞
                        %mi Grpd
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi Ω
                          %mi x
                        %mi Π
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        End( x^* : LConst(X) \to \infty Grpd ) \simeq \Omega_x \Pi(X)
                        \\,.
          .proof
            %h6#proof_14 Proof
            %p
              The first statement is just the adjunction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mo ⊣
                      %mi Disc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Pi \dashv Disc)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi LConst
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo :
                            %mo =
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi Disc
                            %mi Core
                            %mn ∞
                            %msub
                              %mi Grpd
                              %mi κ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mn ∞
                            %mi Grpd
                            %mo{:stretchy => "false"} (
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Core
                            %mn ∞
                            %msub
                              %mi Grpd
                              %mi κ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mn ∞
                            %mi Grpd
                            %mo{:stretchy => "false"} (
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mn ∞
                            %msub
                              %mi Grpd
                              %mi κ
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    LConst(X) &amp; := \mathbf{H}(X, Disc Core \infty Grpd_\kappa)
                    \\\
                    \&amp;  \simeq \infty Grpd(\Pi(X), Core \infty Grpd_\kappa)
                    \\\
                    \&amp;  \simeq \infty Grpd(\Pi(X), \infty Grpd_\kappa)
                    \\end{aligned}
                    \\,.
            %p
              Using this and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              preserves the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+an+%28%E2%88%9E%2C1%29-category"} terminal object
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo →
                    %mi X
                    %mo →
                    %mi Disc
                    %mi Core
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mi κ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (* \to X \to Disc Core \infty Grpd_\kappa)
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo →
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mi κ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (* \to \Pi(X) \to \infty Grpd_\kappa)
            %p
              the second statement follows with an iterated application of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
              (this is pure
              %a.existingWikiWord{:href => "/nlab/show/Tannaka+duality"} Tannaka duality
              as discussed there):
            %p
              The fiber functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %mo :
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} x^* : Func(\Pi(X), \infty Grpd) \to \infty Grpd
              evaluates an
              = succeed "-presheaf" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \Pi(X)^{op}
              at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \in \Pi(X)
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
              this is the same as homming out of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j : \Pi(X)^{op} \to Func(\Pi(X), \infty Grpd)
              is the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %mi Π
                        %mo{:stretchy => "false"} (
                        %mi X
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    x^* \simeq Hom_{PSh(\Pi(X)^{op})}(j(x), -)
                    \\,.
            %p
              This means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                  %annotation{:encoding => "application/x-tex"} x^*
              itself is a representable object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(PSh(\Pi(X)^{op})^{op})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ˜
                    %mo :
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde j : PSh(\Pi(X)^{op})^{op} \to PSh(PSh(\Pi(X)^{op})^{op})
              the corresponding Yoneda embedding, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %mo ≃
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    x^* \simeq \tilde j (j (x))
                    \\,.
            %p
              With this, we compute the endomorphisms of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                  %annotation{:encoding => "application/x-tex"} x^*
              by applying the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
              two more times:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi End
                            %msup
                              %mi x
                              %mo *
                          %mtd
                            %mo ≃
                            %msub
                              %mi End
                              %mrow
                                %mi PSh
                                %mo{:stretchy => "false"} (
                                %mi PSh
                                %mo{:stretchy => "false"} (
                                %mi Π
                                %mo{:stretchy => "false"} (
                                %mi X
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi op
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi op
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi j
                              %mo{:stretchy => "false"} ˜
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi End
                            %mo{:stretchy => "false"} (
                            %mi PSh
                            %mo{:stretchy => "false"} (
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi op
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi End
                              %mrow
                                %mi Π
                                %mo{:stretchy => "false"} (
                                %mi X
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi op
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Aut
                              %mi x
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo :
                            %msub
                              %mi Ω
                              %mi x
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    End x^*
                    \&amp; \simeq
                    End_{PSh(PSh(\Pi(X)^{op})^{op})} (\tilde j(j (x)))
                    \\\
                    \&amp; \simeq
                    End(PSh(\Pi(X))^{op}) (j(x))
                    \\\
                    \&amp; \simeq
                    End_{\Pi(X)^{op}}(x,x)
                    \\\
                    \&amp; \simeq
                    Aut_x \Pi(X)
                    \\\
                    \&amp; =: \Omega_x \Pi(X)
                    \\end{aligned}
                    \\,.
          %h3#vanKampenTheorem van Kampen theorem
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/higher+homotopy+van+Kampen+theorem"} higher
            %a.existingWikiWord{:href => "/nlab/show/van+Kampen+theorem"} van Kampen theorem
            asserts that passing to
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
          %p
            On a cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            the fundamental
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \Pi : \mathbf{H} \to \infty Grpd
            is a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            and hence preserves all
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
          %p
            More interesting is the question which
            = succeed "-colimits" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a{:href => "#ConcreteObjects"} concrete spaces
            in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Conc
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mover
                    %munder
                      %mo ↪
                      %mi inj
                    %mover
                      %mo ←
                      %mi conc
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"}
                  Conc(\mathbf{H})
                  \\stackrel{\overset{conc}{\leftarrow}}{\underset{inj}{\hookrightarrow}}
                  \\mathbf{H}
          %p
            are preserved by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo ∘
                    %mi inj
                    %mo :
                    %mi Conc
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \Pi \circ inj : Conc(\mathbf{H}) \to \infty Grpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            and then applying the concretization functor. So we have
          .num_lemma
            %h6#observation_5 Observation
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo •
                    %mo :
                    %mi K
                    %mo →
                    %mi Conc
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_\bullet : K \to Conc(\mathbf{H})
              be a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              such that the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mo →
                    %mi inj
                    %mo ∘
                    %msub
                      %mi U
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \lim_\to inj \circ U_\bullet
              is concrete,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ⋯
                      %mo ≃
                      %mi inj
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \cdots \simeq inj(X)
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is computed as the
              = succeed "-colimit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %munder
                        %mi lim
                        %mo →
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi(X) \simeq {\lim_\to} \Pi(U_\bullet)
                    \\,.
          %p
            In the
            %a{:href => "#Examples"} Examples
            we discuss the cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi TopBall
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H} = (\infty,1)Sh(TopBall)
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/topological+%E2%88%9E-groupoid"} topological ∞-groupoid
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/higher+van+Kampen+theorem"} higher van Kampen theorem
          .num_prop
            %h6#proposition_17 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact
              or
              %a.existingWikiWord{:href => "/nlab/show/locally+contractible+space"} locally contractible
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U_1 \hookrightarrow X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 2
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_2 \hookrightarrow X
              a
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              by two
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            %p
              Then under the
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mo :
                    %mi Top
                    %mo →
                  %annotation{:encoding => "application/x-tex"} Sing : Top \to
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              we have a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Sing
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mi Sing
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi Sing
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Sing
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi Sing
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Sing(U_1) \cap Sing(U_2) &amp;\to&amp; Sing(U_2)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    Sing(U_1) &amp;\to&amp; Sing(X)
                    }
                    \\,.
          .proof
            %h6#proof_15 Proof
            %p
              We inject the topological space via the external
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo ↪
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi TopBalls
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi OpenBalls
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Top \hookrightarrow Sh(TopBalls) \hookrightarrow
                    \\mathbf{H} := (\infty,1)Sh(OpenBalls)
            %p
              as a 0-
              %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
              %a.existingWikiWord{:href => "/nlab/show/topological+%E2%88%9E-groupoid"} topological ∞-groupoid
              in the cohesive
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
              this is
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} presented
              by the
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi TopBalls
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi inj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} Sh(TopBalls, sSet)_{inj,loc}
              of the injective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sheaves"} model structure on simplicial sheaves
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TopBalls
                  %annotation{:encoding => "application/x-tex"} TopBalls
              (as described at
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/models+for+%E2%88%9E-stack+%28%E2%88%9E%2C1%29-toposes"} models for ∞-stack (∞,1)-toposes
            %p
              Notice that the injection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo ↪
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi TopBalls
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Top \hookrightarrow Sh(TopBalls)
              of topological spaces as
              %a.existingWikiWord{:href => "/nlab/show/concrete+sheaves"} concrete sheaves
              on the site of open balls preserves the pushout
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %msub
                        %mi U
                        %mn 1
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %msub
                            %mi U
                            %mn 1
                          %mo ∩
                          %msub
                            %mi U
                            %mn 2
                      %msub
                        %mi U
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} X = U_1 \coprod_{U_1 \cap U_2} U_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as a
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              on
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
              is a
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi TopBall
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi TopBalls
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} Sh(TopBall,sSet) \simeq Sh(TopBalls)^{\Delta^{op}}
              as simplicially constant simplicial sheaves.
            %p
              Since cofibrations in that model structure are objectwise and degreewise injective maps, it follows that the ordinary
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mn 1
                            %mo ∩
                            %msub
                              %mi U
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi U
                              %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U_1 \cap U_2 &amp;\to&amp; U_2
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    U_1 &amp;\to&amp; X
                    }
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi TopBalls
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi inj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} Sh(TopBalls, sSet)_{inj,loc}
              has all objects cofibrant and is the pushout along a cofibration, hence is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
              (as described there). By the general theorem at
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              homotopy pushouts model
              = succeed "-pushouts," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              = succeed "-pushout" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %msub
                      %mi U
                      %mn 1
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi U
                          %mn 1
                        %mo ∩
                        %msub
                          %mi U
                          %mn 2
                    %msub
                      %mi U
                      %mn 2
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \simeq U_1 \coprod_{U_1 \cap U_2} U_2 \in \mathbf{H}
                    \\,.
            %p
              The proposition now follows with the above observation that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              preserves all
              = succeed "-colimits" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/topological+%E2%88%9E-groupoid"} topological ∞-groupoid
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mi X
                      %mo ≃
                      %mi Sing
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Pi X \simeq Sing X
          %h3#Paths Paths and geometric Postnikov towers
          %p
            The
            %a{:href => "#Homotopy"} above
            construction of the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid
            of objects in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            as an object in
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            may be reflected back into
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/path+n-groupoid"} path n-groupoid
