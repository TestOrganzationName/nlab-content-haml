                      %annotation{:encoding => "application/x-tex"} (n-k)
          %p In typical models we have an equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi conk
                    %mi k
                  %msub
                    %mi τ
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msub
                    %mi A
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mo ≃
