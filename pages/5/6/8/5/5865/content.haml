                    %mi conk
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %msub
                    %mi τ
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msub
                    %mi A
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [\Sigma, \mathbf{B}^n A_{conn}]
                  \\stackrel{conk_k \circ \tau_{n-k}}{\to}
                  conk_{n-k} \tau_{n-k}
                  [\Sigma, \mathbf{B}^n A_{conn}]
                  \\,.
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-,-]
                denotes the
                = succeed ";" do
                  %a{:href => "http://nlab.mathforge.org/nlab/show/%28infinity,1%29-topos#ClosedMonoidalStructure"} cartesian internal hom
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
