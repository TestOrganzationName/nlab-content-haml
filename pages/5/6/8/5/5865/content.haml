                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi P
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\vdots &amp;&amp; \vdots
                    \\\
                    P \times_X P \times_X P
                    \&amp;\stackrel{\simeq}{\to}&amp;
                    P \times G \times G
                    \\\
                    \\downarrow\downarrow\downarrow
                    \&amp;&amp; \downarrow\downarrow\downarrow
                    \\\
                    P \times_X P
                    \&amp;\stackrel{\simeq}{\to}&amp;
                    P \times G
                    \\\
                    \\downarrow\downarrow &amp;&amp; \downarrow\downarrow
                    \\\
                    P &amp;\stackrel{\simeq}{\to}&amp; P
                    }
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              This principality condition asserts that the groupoid object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} P//G
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28infinity%2C1%29-category"} effective
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} Giraud's axioms characterizing (∞,1)-toposes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is effective.
          .num_prop
            %h6#proposition_8 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}G
              any morphism, its
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \to X
              is canonically equipped with a principal
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_7 Proof
            %p By the above we need to show that we have a morphism of simplicial diagrams
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋮
                          %mtd
                          %mtd
                            %mi ⋮
                          %mtd
                          %mtd
                            %mi ⋮
                        %mtr
