              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ∈
                    %mi Top
                    %mo ≃
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} S^1 \in Top \simeq \infty Grpd
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild cohomology
              for details.)
            %p
              The second statement follows by observing that the
              = succeed "-hom-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,-)
              preserves all
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              = succeed "s" do
