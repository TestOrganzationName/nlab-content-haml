                  \\,.
          %p In this case we say that for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msub
                    %mi A
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\hat \mathbf{c} : \mathbf{B}G_{conn} \to \mathbf{B}^n A_{conn}
          %p a differential characteristic map, that the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mo ∫
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msub
                    %mi A
                    %mi conn
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %msub
                    %mi A
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i \int_{\Sigma}(-))
                  \:
                  [\Sigma, \mathbf{B} G_{conn}]
                  \\to
                  [\Sigma, \mathbf{B}^n A_{conn}]
                  \\to
                  \\mathbf{B}^{n-k}A_{conn}
          %p
            is the
