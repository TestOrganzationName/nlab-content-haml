                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ≃
                    %mi Γ
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \Gamma \mathbf{\flat}\mathbf{B}G \simeq \Gamma \mathbf{B}G
              says that over the point every
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
