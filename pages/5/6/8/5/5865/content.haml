          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo →
                %annotation{:encoding => "application/x-tex"} \Pi : \mathbf{H} \to
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            preserves products, we have for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ,
                  %mi Z
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X,Y, Z \in \mathbf{H}
            canonically induced a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Y
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Z
                    %mi Y
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Y
                    %mi X
                  %mo ×
                  %msup
                    %mi Z
                    %mi Y
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi comp
                        %mrow
                          %mi X
                          %mo ,
                          %mi Y
                          %mo ,
                          %mi Z
                      %mo{:stretchy => "false"} )
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Z
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Pi(Y^X) \times \Pi(Z^Y)
                  \\stackrel{\simeq}{\to}
                  \\Pi(Y^X \times Z^Y)
                  \\stackrel{\Pi(comp_{X,Y,Z})}{\to}
                  \\Pi(Z^X)
                  \\,.
          %p
            This should yield an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde \mathbf{H}
            with the same objects as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            and hom-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-groupoids defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
