                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                        %mtr
