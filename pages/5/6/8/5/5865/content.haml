                              %mo ×
                              %mi X
                            %mi P
                            %msub
                              %mo ×
                              %mi X
                            %mi P
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi P
                            %mo ×
                            %mi G
                            %mo ×
                            %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mi G
                            %mo ×
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi P
                            %msub
                              %mo ×
                              %mi X
                            %mi P
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi P
                            %mo ×
                            %mi G
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mn 2
                          %mtd
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi P
                          %mtd
                            %mover
                              %mo →
                              %mo =
                          %mtd
                            %mi P
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mo =
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\vdots &amp;&amp; \vdots &amp;&amp; \vdots
                    \\\
                    P \times_X P \times_X P
                    \&amp;\stackrel{\simeq}{\to}&amp; P \times G \times G
                    \&amp;\to&amp; G \times G
                    \\\
                    \\downarrow\downarrow\downarrow
                    \&amp;&amp;
                    \\downarrow\downarrow\downarrow
                    \&amp;&amp; \downarrow\downarrow\downarrow
                    \\\
                    P \times_X P &amp;\stackrel{\simeq}{\to}&amp; P \times G
                    \&amp;\stackrel{p_2}{\to}&amp; G
                    \\\
                    \\downarrow\downarrow
                    \&amp;&amp; \downarrow\downarrow &amp;&amp; \downarrow\downarrow
                    \\\
                    P &amp;\stackrel{=}{\to}&amp; P &amp;\stackrel{}{\to}&amp; {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    X &amp;\stackrel{=}{\to}&amp; X &amp;\stackrel{g}{\to}&amp; \mathbf{B}G
                    }
                    \\,,
            %p where the left horizontal morphisms are equivalences, as indicated. We proceed by induction through on the height of this diagram.
            %p
              The defining
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              square for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mi X
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P \times_X P
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                            %msub
                              %mo ×
                              %mi X
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mi P
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P \times_X P &amp;\to&amp; P
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    P &amp;\to&amp; X
                    }
            %p
              To compute this, we may attach the defining
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              to obtain the
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                            %msub
                              %mo ×
                              %mi X
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P \times_X P &amp;\to&amp; P &amp;\to&amp; {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    P &amp;\to&amp; X &amp;\to&amp; \mathbf{B}G
                    \\,.
                    }
            %p
              and use the
              = succeed "," do
                %a{:href => "http://ncatlab.org/nlab/show/pullback#Pasting"} pasting law for pullbacks
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mi X
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P \times_X P
              is the pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                            %msub
                              %mo ×
                              %mi X
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P \times_X P &amp;\to&amp; &amp;\to&amp; {*}
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow
                    \\\
                    P &amp;\to&amp; X &amp;\to&amp; \mathbf{B}G
                    \\,.
                    }
            %p
              By defnition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              as the homotopy fiber of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo →
                      %mo *
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} P \to {*} \to \mathbf{B}G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mi X
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P \times_X P
              is equivalent to the pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                            %msub
                              %mo ×
                              %mi X
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P \times_X P &amp;\to&amp; &amp;\to&amp; {*}
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow
                    \\\
                    P &amp;\to&amp; {*} &amp;\to&amp; \mathbf{B}G
                    \\,.
                    }
            %p This finally may be computed as the pasting of two pullbacks
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                            %msub
                              %mo ×
                              %mi X
                            %mi P
                          %mtd
                            %mo ≃
                          %mtd
                            %mi P
                            %mo ×
                            %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mi G
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P \times_X P &amp;\simeq&amp; P \times G &amp;\to&amp; G &amp;\to&amp; {*}
                    \\\
                    \&amp;&amp;\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \&amp;&amp;P &amp;\to&amp; {*} &amp;\to&amp; \mathbf{B}G
                    \\,.
                    }
            %p
              of which the one on the right is the defining one for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and the remaining one on the left is just an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-product"} (∞,1)-product
            %p
              Proceeding by induction from this case we find analogousy that
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi P
                        %mrow
                          %msubsup
                            %mo ×
                            %mi X
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                      %mo ≃
                      %mi P
                      %mo ×
                      %msup
                        %mi G
                        %mrow
                          %msub
                            %mo ×
                            %mi n
                    %annotation{:encoding => "application/x-tex"} P^{\times_X^{n+1}} \simeq P \times G^{\times_n}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi P
                      %mrow
                        %msubsup
                          %mo ×
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                  %annotation{:encoding => "application/x-tex"} P^{\times_X^{n+1}}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                            %msub
                              %mo ×
                              %mi X
                            %msup
                              %mi P
                              %mrow
                                %msubsup
                                  %mo ×
                                  %mi X
                                  %mi n
                          %mtd
                            %mo →
                          %mtd
                            %mi P
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi P
                              %mrow
                                %msubsup
                                  %mo ×
                                  %mi X
                                  %mi n
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P \times_X P^{\times_X^n}
                    \&amp;\to&amp;
                    P
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    P^{\times_X^n}&amp;\to&amp; X
                    }
                    \\,.
            %p We may again paste this to obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
