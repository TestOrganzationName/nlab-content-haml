                    }{
                    \\underset{\mathbf{\flat}_{dR}}{\to}
                    }
                    \\mathbf{H}
                    \\,.
          .proof
            %h6#proof_21 Proof
            %p We check the defining natural hom-equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
