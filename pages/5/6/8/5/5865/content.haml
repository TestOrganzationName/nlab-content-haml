                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma_X(P_\phi) &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrm{id}}
                    \\\
                    \\mathbf{H}(X,P_\phi) &amp;\stackrel{p_*}{\to}&amp; \mathbf{H}(X,X)
                    }
                    \\,.
          .proof
            %h6#proof_11 Proof
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/pasting+diagram"} pasting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ≃
                          %mtd
                            %msub
                              %mi Γ
                              %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                        %mtr
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msub
                              %mi P
                              %mi ϕ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi p
                                  %mo *
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mpadded{:width => "0"}
                                    %mi ϕ
                                  %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                                  %mo *
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi C
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{H}_{\phi}(X,A) \simeq &amp; \Gamma_\phi(X)
                    \&amp;\to&amp; {*}
                    \\\
                    \&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{id}}
                    \\\
                    \&amp; \mathbf{H}(X,P_{\phi}) &amp;\stackrel{p_*}{\to}&amp; \mathbf{H}(X,X)
                    \\\
                    \&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{\phi}_*}
                    \\\
                    \&amp; \mathbf{H}(X,B) &amp;\stackrel{\mathbf{c}_*}{\to}&amp;
                    \\mathbf{H}(X,C)
                    }
                    \\,.
            %p
              By the fact that the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
