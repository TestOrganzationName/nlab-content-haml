                denotes
                %a.existingWikiWord{:href => "/nlab/show/truncated+object+in+an+%28infinity%2C1%29-category"} truncation
                in degree
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                      %annotation{:encoding => "application/x-tex"} n-k
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
