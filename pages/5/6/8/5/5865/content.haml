                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %em defines
            this
            = succeed "-action." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .num_prop
            %h6#proposition_7 Proposition
            %p
              The
              = succeed "-principal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %strong principality condition
              in that we have an equivalence of groupoid objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋮
                          %mtd
                          %mtd
                            %mi ⋮
                        %mtr
                          %mtd
                            %mi P
                            %msub
                              %mo ×
                              %mi X
                            %mi P
                            %msub
                              %mo ×
                              %mi X
                            %mi P
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi P
                            %mo ×
                            %mi G
                            %mo ×
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                            %mo{:stretchy => "false"} ↓
                        %mtr
