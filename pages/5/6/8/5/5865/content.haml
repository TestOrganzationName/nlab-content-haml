          #NConcretification.num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
                \-concretification
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi conc
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \to conc_{n+1} X
            %p
              that is the left factor in the decomposition with respect to the
              %a.existingWikiWord{:href => "/nlab/show/n-connected%2Fn-truncated+factorization+system"} n-connected/n-truncated factorization system
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ⊣
                      %mi coDisc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Gamma \dashv coDisc)
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi conc
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mi coDisc
                            %mi Γ
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; conc_{n+1} X
                    \\\
                    \&amp; \nearrow &amp;&amp; \searrow
                    \\\
                    X &amp;&amp;\to&amp;&amp; coDisc \Gamma X
                    }
                    \\,.
          .num_remark
            %h6#remark Remark
            %p
              By that very
              %a.existingWikiWord{:href => "/nlab/show/n-connected%2Fn-truncated+factorization+system"} n-connected/n-truncated factorization system
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi conc
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi X
                  %annotation{:encoding => "application/x-tex"} conc_{n+1} X
              is an
              = succeed "-concrete" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
