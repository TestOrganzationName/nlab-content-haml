                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Π
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi dR
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{\Pi}(X) &amp;\to&amp; \mathbf{\Pi}_{dR}X
