                    %annotation{:encoding => "application/x-tex"} \mathbf{B}^n A
          .num_remark
            %h6#remark_13 Remark
            %p
              For every dR-projective
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              there is a canonical
              %a.existingWikiWord{:href => "/nlab/show/monomorphism+in+an+%28%E2%88%9E%2C1%29-category"} monomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
