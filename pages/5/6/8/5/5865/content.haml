                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^{\mathbf{(n+1)}}
              the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
