                    \\,.
          %h3#Transgression Transgression in differential cohomology
          %p
            We discuss an intrinsic notion of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+ordinary+differential+cohomology"} fiber integration in ordinary differential cohomology
            internal to any cohesive
            = succeed "-topos." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/higher+holonomy"} higher holonomy
            discussed above.
          %p
            Fix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            an abelian group object as above and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msub
                    %mi A
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^n A_{conn}
            a corresponding differential coefficient object. Then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \Sigma \in \mathbf{H}
            of
            %a.existingWikiWord{:href => "/nlab/show/cohomological+dimension"} cohomological dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ≤
                  %mi n
                %annotation{:encoding => "application/x-tex"} k \leq n
            consider the map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msub
                    %mi A
                    %mi conn
                  %mo{:stretchy => "false"} ]
