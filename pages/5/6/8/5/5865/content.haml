                        %mi n
                        %mo +
                        %mn 1
                    %mi A
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    \\mathbf{\flat} \mathbf{B}^n A
                    \\to
                    \\mathbf{B}^n A
                    \\stackrel{curv}{\to}
                    \\mathbf{\flat}_{dR} \mathbf{B}^{n+1}A
                    \\to
                    \\mathbf{\flat} \mathbf{B}^{n+1} A
                    \\to
                    \\mathbf{B}^{n+1} A
            %p
              that
              %a{:href => "#CurvatureCharacteristics"} defines
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi curv
                  %annotation{:encoding => "application/x-tex"} curv
              (using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                  %annotation{:encoding => "application/x-tex"} \mathbf{\flat}
              preserves limits and hence looping and delooping).
          %p
            The following establishes the characteristic
            %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
            that characterizes intrinsic
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            as an extension of curvature forms by flat
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          #CurvatureExactSequence.num_prop
            %h6#proposition_31 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mi F
                    %mo ⊂
                    %msubsup
                      %mi H
                      %mi dR
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} im F \subset H_{dR}^{n+1}(X, A)
              be the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of the curvatures. Then the differential cohomology group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi diff
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_{diff}^n(X,A)
              fits into a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %mi H
                      %mi flat
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi H
                      %mi diff
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi im
                    %mi F
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to H^n_{flat}(X, A) \to H^n_{diff}(X,A) \to im F \to 0
          .proof
            %h6#proof_33 Proof
            %p
              Apply the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              to the
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi flat
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi diff
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi F
                        %mo{:stretchy => "false"} ]
                    %msubsup
                      %mi H
                      %mi dR
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}_{flat}(X, \mathbf{B}^n A)
                    \\to
                    \\mathbf{H}_{diff}(X, \mathbf{B}^n A)
                    \\stackrel{[F]}{\to}
                    H_{dR}^{n+1}(X,A)
            %p
              of prop.
              %a.maruku-ref{:href => "#DiffCohomologyRestrictedToVanishingCurvature"}
              and use that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi dR
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_{dR}^{n+1}(X,A)
              is, as a set, a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} homotopy 0-type
              to get the
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi H
                              %mi dR
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi flat
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mi diff
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
