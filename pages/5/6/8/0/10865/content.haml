          %p
            Using this we have the mapping space of
            %a.existingWikiWord{:href => "/nlab/show/general+covariance"} covariant
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            formed in the
            %a.existingWikiWord{:href => "/nlab/show/context"} context
            of
            = succeed "-covariance/" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Diff
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Diff(\Sigma)
            %a.existingWikiWord{:href => "/nlab/show/equivariance"} equivariance
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi Diff
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo [
                    %mi Σ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi Diff
