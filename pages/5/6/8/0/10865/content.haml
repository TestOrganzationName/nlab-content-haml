                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}Diff(\Sigma)
                  \\;\;
                  \\vdash
                  \\;\;
                  \\left[
                  \\Sigma//Diff(\Sigma)
                  \\,,\;
                  X
                  \\right]
          %p
            %strong Theorem.
            Down in the absolute
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/context"} context
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi Diff
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                  %mrow
                    %mo [
                    %mi Σ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi Diff
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ]
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi Diff
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\vdash
                  \\;\;
                  \\underset{\mathbf{B}Diff(\Sigma)}{\sum}
                  \\left[
                  \\Sigma//Diff(\Sigma)
                  \\,,\;
                  X
                  \\right]
                  \\;\;
                  \\simeq
                  \\;\;
                  [\Sigma, X]//Diff(\Sigma)
                  \\,.
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\Sigma, X]
            is the space of fields on spacetime as one would find it in ordinary topos theory, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi Diff
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} [\Sigma,X]//Diff(\Sigma)
            is its
            %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
            by the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of the
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism+group"} diffeomorphism group
            by pullback of fields. This is precisely the group of
            %a.existingWikiWord{:href => "/nlab/show/gauge+equivalences"} gauge equivalences
            on fields in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/general+relativity"} general relativity
          %p
            So we obtain a formalization of the famous insight of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Einstein"} Einstein
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere"} Lawvere
            %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
            in
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            from
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+topos+theory"} higher topos theory
          %p
            In a slogan we may conclude, in view of the above table, that in the formalization of
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            in
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos+theory"} higher topos theory
            we have:
          %ul
            %li
              %em
                %a.existingWikiWord{:href => "/nlab/show/general+covariance"} general covariance
                is homotopy
                %a.existingWikiWord{:href => "/nlab/show/coinvariants"} coinvariants
          %p
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
          %h2#ii_toposes_of_laws_of_motion_and_hamiltonjacobilagrange_mechanics
            %strong II)
            Toposes of laws of motion and Hamilton-Jacobi-Lagrange mechanics
          %p
            In (
            %a{:href => "#Lawvere97"}> Lawvere 97
            ) it was observed that
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            in
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            can (almost, see below) be formalized in
            %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
            as follows.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be an ambient
            %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} synthetic differential
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            (such as the
            %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+spaces"} smooth spaces
            and
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+manifolds"} formal smooth manifolds
          %p
            The canonical
            %a.existingWikiWord{:href => "/nlab/show/line+object"} line object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔸
                    %mn 1
                  %mo =
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{A}^1 = \mathbb{R}
            of this models the
            %a.existingWikiWord{:href => "/nlab/show/continuum"} continuum
            line, the abstract
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/worldline"} worldline
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ↪
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  D \hookrightarrow \mathbb{R}
          %p
            be the inclusion of the first order
            %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+point"} infinitesimal
            neighbourhood of the origin of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            – in the
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
            this is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi ℝ
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi x
                      %mn 2
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} D = \{x \in \mathbb{R}| x^2 = 0\}
            %a.existingWikiWord{:href => "/nlab/show/spectrum+of+a+commutative+ring"} spectrum
            of the
            %a.existingWikiWord{:href => "/nlab/show/ring+of+dual+numbers"} ring of dual numbers
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          %p
            Then consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            any
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            which we are going to think of as a
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/physical+system"} physical system
            %a.existingWikiWord{:href => "/nlab/show/particle"} particle
            propagating on a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is that spacetime. Or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            may be the
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            of the system.
          %p
            Accordingly the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi ℝ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} [\mathbb{R}, X] \in \mathbf{H}
            is the
            %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth
            %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/physical+system"} physical system
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is thought of as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            %a.existingWikiWord{:href => "/nlab/show/trajectory"} trajectory
            starting at that point. This means that time evolution is then an
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            here might be any space, we have the collection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mi Act
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Topos
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{R}Act(\mathbf{H}) \in Topos
          %p
            of all
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/actions"} actions
            on objects in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/topos+of+laws+of+motion"} topos of laws of motion
          %p
            On the other hand, if we think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/physical+systems"} physical systems
            %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            that determines a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/trajectory"} trajectory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi D
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [D,X]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi ℝ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo ⟶
                  %mo{:stretchy => "false"} [
                  %mi D
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\mathbb{R},X] \longrightarrow [D,X]
            from the smooth
            %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
            to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} 0 \in \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of this map is hence an assignment that sends each tangent vector to a
            %a.existingWikiWord{:href => "/nlab/show/trajectory"} trajectory
            which starts out with this tangent. Specifying such a section is hence part of what it means to have
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            %em
              %a.existingWikiWord{:href => "/nlab/show/Toposes+of+laws+of+motion"} Toposes of laws of motion
            %a.existingWikiWord{:href => "/nlab/show/Lawvere"} Lawvere
            called the collection of such data a Galilean
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos+of+laws+of+motion"} topos of laws of motion
          %p
            Of course this is not quite yet what is actually used and needed in physics. On p. 9 of (
            %a{:href => "#Lawvere97"}> Lawvere 97
            ) this problem is briefly mentioned:
          %blockquote
            %p
              But what about actual dynamical systems in the spirit of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Galileo"} Galileo
              %a.existingWikiWord{:href => "/nlab/show/symplectic+geometry"} symplectic
              or
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+mechanics"} Hamiltonian systems
              that are also much studied do address this question of states of
              %a.existingWikiWord{:href => "/nlab/show/becoming"} Becoming
              versus locations of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/being"} Being
          %p
            We observe now (following
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Classical+field+theory+via+Cohesive+homotopy+types"} Classical field theory via Cohesive homotopy types
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/higher+topos+theory"} higher topos
          %p
            First notice that in
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            a
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            is not any space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped with a closed
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi cl
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^2_{cl}
            be the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of closed 2-forms, then this means that a phase space is really a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msubsup
                            %mstyle{:mathvariant => "bold"}
                              %mi Ω
                            %mi cl
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X
                  \\\
                  \&amp; \searrow
                  \\\
                  \&amp;&amp; \mathbf{\Omega}^2_{cl}
                  }
          %p
            In fact this is still not quite the accurate statement. Rather a phase space is a “
            %a.existingWikiWord{:href => "/nlab/show/prequantization"}> prequantization
            ” of such data. This means the following.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            naturally
            %a.existingWikiWord{:href => "/nlab/show/action"} acts
            on the space of
            %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^1
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mrow
                      %msup
                        %mi Ω
                        %mn 1
                  %mo ×
                  %msup
                    %mi S
                    %mn 1
                  %mo ⟶
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\Omega^1} \times S^1 \longrightarrow \mathbf{\Omega}^1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi A
                  %mo +
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi log
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (A, g) \mapsto A + \mathbf{d}log(g)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                %annotation{:encoding => "application/x-tex"} \mathbf{d}
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
            %a.existingWikiWord{:href => "/nlab/show/quotient+stack"} quotient stack
            we write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msubsup
                    %mi S
                    %mi conn
                    %mn 1
                  %mo =
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi S
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}S^1_{conn} = \mathbf{\Omega}^1//S^1
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mn 1
                  %mo ⟶
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi cl
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{d} \;\colon\; \mathbf{\Omega}^1 \longrightarrow \mathbf{\Omega}^2_{cl}
            descends to this quotient to yield a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msubsup
                    %mi S
                    %mi conn
                    %mn 1
                  %mo ⟶
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi cl
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F_{(-)} \;\colon\; \mathbf{B}S^1_{conn} \longrightarrow \mathbf{\Omega}^2_{cl}
                  \\,.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
            of a
            %a.existingWikiWord{:href => "/nlab/show/presymplectic+form"} presymplectic form
            is a lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            through this map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo ⟶
                            %mo ∇
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi ω
                          %mo ↘
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi F
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Ω
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\stackrel{\nabla}{\longrightarrow}&amp; \mathbf{B}U(1)_{conn}
                  \\\
                  \&amp; {}_{\mathllap{\omega}}\searrow &amp; \downarrow^{\mathrlap{F_{(-)}}}
                  \\\
                  \&amp;&amp; \mathbf{\Omega}^2
                  }
                  \\,.
          %p
            Now suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is actually a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
          %p
            %strong Theorem.
            Concrete actions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo ∇
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msubsup
                        %mi S
                        %mi conn
                        %mn 1
                %annotation{:encoding => "application/x-tex"} (X, \nabla) \in \mathbf{H}_{/\mathbf{B}S^1_{conn}}
            are equivalent to “
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonians"}> Hamiltonians
            ”
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} H \in [X,\mathbb{R}]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} t \in \mathbb{R}
            is sent to the slice automorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi t
                              %mo{:stretchy => "false"} {
                              %mi H
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} }
                              %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi θ
                          %mo ↘
                        %mtd
                          %msub
                            %mo ⇙
                            %mrow
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi i
                              %msub
                                %mi S
                                %mi t
                              %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mi θ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;&amp; \stackrel{\exp(t \{H,-\})}{\longrightarrow} &amp;&amp; X
                  \\\
                  \&amp; {}_{\mathllap{\theta}} \searrow
                  \&amp; \swArrow_{\exp( i S_t  )} &amp; \swarrow_{\mathrlap{\theta}}
                  \\\
                  \&amp;&amp; \mathbf{B}U(1)_{conn}
                  }
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} {
                  %mi H
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(t \{H,-\})
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/flow"} flow
            of
            %a.existingWikiWord{:href => "/nlab/show/Hamilton%27s+equations+of+motion"} Hamilton's equations of motion
            induced by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            and where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi t
                  %mo =
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mi t
                  %mi L
                  %mspace{:width => "thinmathspace"}
                  %mi d
                  %mi t
                %annotation{:encoding => "application/x-tex"} S_t = \int_0^t L \, d t
            is the
            %a.existingWikiWord{:href => "/nlab/show/Hamilton-Jacobi+action"} Hamilton-Jacobi action
            given by the
            %a.existingWikiWord{:href => "/nlab/show/integration"} integral
            of the
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian"} Lagrangian
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            (the
            %a.existingWikiWord{:href => "/nlab/show/Legendre+transform"} Legendre transform
            of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
          %p
            This statement subsumes the core ingredients of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classical+mechanics"} classical mechanics
            %em
              %a.existingWikiWord{:href => "/nlab/show/prequantized+Lagrangian+correspondence"} prequantized Lagrangian correspondence
            for details.
          %p
            In conclusion we find that
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/actions"} actions
            in the higher slice topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msubsup
                        %mi S
                        %mi conn
                        %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}S^1_{conn}}
            over the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            are equivalent to actual
            %a.existingWikiWord{:href => "/nlab/show/laws+of+motion"} laws of motion
            in
            %a.existingWikiWord{:href => "/nlab/show/classical+mechanics"} classical mechanics
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LawsOfMotion
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ℝ
                  %mi Act
                  %mrow
                    %mo (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msubsup
                          %mi S
                          %mi conn
                          %mn 1
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  LawsOfMotion(\mathbf{H})
                  \\simeq
                  \\mathbb{R}Act\left(
                  \\mathbf{H}_{/\mathbf{B}S^1_{conn}}
                  \\right)
                  \\,.
          %p
            More precisely, this applies to
            %a.existingWikiWord{:href => "/nlab/show/laws+of+motion"} laws of motion
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/mechanics"} mechanics
            %span.newWikiWord
              Hamilton-de Donder-Weyl equations of motion
              %a{:href => "/nlab/new/Hamilton-de+Donder-Weyl+equations+of+motion"} ?
            of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/local+field+theory"} local
            %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical field theory
            by replacing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msubsup
                    %mi S
                    %mi conn
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{B} S^1_{conn}
            here with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %msubsup
                    %mi S
                    %mi conn
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^n S^1_{conn}
            (
            %a{:href => "#dcct"}> Schreiber 13
            ,
            = succeed ")." do
              %a{:href => "#Schreiber"} Schreiber 13b
          %h2#iii_extensiveintensive_duality_and_cohomological_quantization
            %strong III)
            Extensive/intensive duality and Cohomological quantization
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            and especially in
            %a.existingWikiWord{:href => "/nlab/show/continuum+mechanics"} continuum mechanics
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/thermodynamics"} thermodynamics
            %a.existingWikiWord{:href => "/nlab/show/physical+system"} physical system
            extended in
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            is called
          %ul
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/intensive"} intensive
                if it is a
                %a.existingWikiWord{:href => "/nlab/show/function"} function
                on (the physical system extended in) space;
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/extensive"} extensive
                if it is a
                %a.existingWikiWord{:href => "/nlab/show/density"} density
                or
                %a.existingWikiWord{:href => "/nlab/show/linear+distribution"} linear distribution
                on (the physical system extended in) space.
          %p
            For instance for a
            %a.existingWikiWord{:href => "/nlab/show/solid+body"} solid body
            its
            %a.existingWikiWord{:href => "/nlab/show/temperature"} temperature
            is intensive, but its
            %a.existingWikiWord{:href => "/nlab/show/mass"} mass
            is extensive: there is a temperature assigned to every point of the body (in the idealization of
            %a.existingWikiWord{:href => "/nlab/show/classical+mechanics"} classical
            %a.existingWikiWord{:href => "/nlab/show/continuum+mechanics"} continuum mechanics
            anyway) but a mass is assigned only to every little “extended” piece of the body, not to a single point.
          %p
            This terminology in
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            apparently originates with
            %a.existingWikiWord{:href => "/nlab/show/Richard+Tolman"} Richard Tolman
            in 1917.
          %p
            In (
            %a{:href => "#Lawvere86"}> Lawvere 86
            ) it is amplified that this
            %a.existingWikiWord{:href => "/nlab/show/duality"} duality
            is generally a fundamental one also in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/mathematics"} mathematics
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            with a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative
            %a.existingWikiWord{:href => "/nlab/show/ring+object"} ring object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∈
                    %mi CRing
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R \in CRing(\mathbf{H})
          %ul
            %li
              %p
                the space of
                %em intensive quantities
                on an
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
                is the
                %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi R
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %mo ∈
                      %mi CRing
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [X,R]_{\mathbf{H}} \in CRing(\mathbf{H})
                formed in
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %li
              %p
                the space of
                %em extensive quantities
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is the
                = succeed "-linear" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi R
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mo *
                      %mo ≔
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mi R
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi R
                          %mi Mod
                    %annotation{:encoding => "application/x-tex"} [X,R]^\ast \coloneqq [[X,R], R]_{R Mod}
                formed in
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %a.existingWikiWord{:href => "/nlab/show/modules"} modules
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/integration"} integration
                map is the canonical
                %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
                pairing
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mi X
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} ]
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi R
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mo *
                      %mo ⟶
                      %mi R
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\int_X \;\colon\; [X,R] \times [X,R]^\ast  \longrightarrow R
                      \\,.
          %p
            Viewed this way, this naturally generalizes to the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is in fact an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ∈
                  %mi CRing
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R \in CRing(\mathbf{H})
            an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X,R]
            is called the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi R
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo *
                %annotation{:encoding => "application/x-tex"} [X,R]^\ast
            is the corresponding
            %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
            spectrum. In this form intensive and extensive properties appear in
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            in the context of
            %a.existingWikiWord{:href => "/nlab/show/motivic+quantization"} motivic quantization
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
          %p
            More generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                %annotation{:encoding => "application/x-tex"} \chi
            an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-line+bundle"} (∞,1)-line bundle
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            then the corresponding extensive object is the
            = succeed "-twisted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} \chi
            %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi χ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R_{\bullet + \chi}(X)
            and the intensive object is the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} \chi
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi χ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi R
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi χ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi R
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi R
                        %mi Mod
                  %annotation{:encoding => "application/x-tex"} R^{\bullet + \chi}(X) = [R_{\bullet+ \chi}(X),R]_{R Mod}
            %em
              %a.existingWikiWord{:href => "/nlab/show/motivic+quantization"} motivic quantization
            for how this appears in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
          %p
            In particular ordinary
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            is recovered by settin
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                %annotation{:encoding => "application/x-tex"} R =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/KU"} KU
            %a.existingWikiWord{:href => "/nlab/show/complex+K-theory"} complex K-theory
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            (
            %a{:href => "#Nuiten13"}> Nuiten 13
            ).
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/monoidal+%28infinity%2C1%29-category"} monoidal (infinity,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KU
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} KU Mod
            is the refined ambient home for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hilb
                  %mo =
                  %mi ℂ
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} Hilb = \mathbb{C} Mod
            (used for
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/finite+quantum+mechanics+in+terms+of+dagger-compact+categories"} finite quantum mechanics in terms of dagger-compact categories
          %h2#application_cohesion_and_superstring_anomaly_cancellation Application: Cohesion and Superstring anomaly cancellation
          %p
            On first sight, formalization of
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            in (
            %a.existingWikiWord{:href => "/nlab/show/higher+topos+theory"}> higher
            )
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            might seem like a fruitless exercise. But on the contrary, it is hardly possible to understand the deep structure of
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            without such (
            %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+theory"}> geometric
            )
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %p
            We close here by briefly indicating one example problem of recent interest, concerned with the fine-structure of
            %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly+cancellation"} quantum anomaly cancellation
            in 2d
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/QFT"} QFT
          %p
            One reason why the need for geometric homotopy theory in QFT is not mentioned in the bulk of the QFT literature is that traditionally the bulk of the discussion of
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            is in
            %a.existingWikiWord{:href => "/nlab/show/perturbation+theory"} perturbation theory
            (perturbative both in
            %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"} Planck's constant
            and in terms of the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative quantum field theory
          %p
            Phenomena that arise from the global structure of a
            %a.existingWikiWord{:href => "/nlab/show/moduli"} moduli
            of
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
            configurations in
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            are alien to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/perturbation+theory"} perturbation theory
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} anomalies
            %a{:href => "quantum+anomaly#AnomalousActionFunctional"} anomalous action functional
            is something that ought to be a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo ⟶
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} [\Sigma,X] \longrightarrow S^1
            on configuration space, but possibly comes out just as a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of a
            %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
            over configuration space (examples include
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gravitational+anomaly"} gravitational anomalies
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/conformal+anomaly"} conformal anomaly
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly"} Freed-Witten-Kapustin anomaly
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+anomaly"} Green-Schwarz anomaly
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Diaconescu-Moore-Witten+anomaly"} Diaconescu-Moore-Witten anomaly
          %p
            The anomaly bundles on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\Sigma,X]
            typically arise as the
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            of
            %a.existingWikiWord{:href => "/nlab/show/principal+infinity-bundles"} higher bundles
            on the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            itself (see at
            %a.existingWikiWord{:href => "/nlab/show/twisted+smooth+cohomology+in+string+theory"} twisted smooth cohomology in string theory
            for more on this). So these are phenomena which are intrinsically phenomena in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+theory"} geometric homotopy theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos+theory"} (infinity,1)-topos theory
          %p
            We consider now specifically a general aspect of what is called the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly"} Freed-Witten-Kapustin anomaly
          %p
            Just as above we saw that the basic example of a quantum field theory on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo =
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \Sigma = \mathbb{R}
            descibes the
            %a.existingWikiWord{:href => "/nlab/show/dynamics"} dynamics
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/particle"} particle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            describes the dynamics of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string"} string
            %a.existingWikiWord{:href => "/nlab/show/forces"} forces
            excerted in particular by two
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+fields"} background gauge fields
            called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            and the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
          %p
            The global nature of these fields is more subtle than for, say, the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+gauge+fields"} higher gauge fields
            %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            is a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twist
            is the
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            which in turn is a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
          %p
            But this is not the full story, in the full story these fields are cocycles in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            is a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted
            %a.existingWikiWord{:href => "/nlab/show/differential+K-theory"} differential K-theory
            twisted by the
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            which is a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %p
            In (
            %a{:href => "#DFM09"}> DFM 09
            ) is indicated the rich subtleties in the quantum anomaly consistency conditions on these
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/background+fields"} background fields
            %a.existingWikiWord{:href => "/nlab/show/twisted+differential+K-theory"} twisted differential K-theory
            exists with some properties, but without having constructed it.
          %p
            The infamous “
            %a.existingWikiWord{:href => "/nlab/show/landscape+of+string+theory+vacua"}> landscape of string theory vacua
            ” is essentially the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of certain 2d field theories satisfying consistency conditions like this.
          %p
            The central problem in showing the existence of a
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            theory is to show that this cohomology theory sits inside a double square diagram called the “differential cohomology diagram”.
          %p
            Now a miracle happens. After developing
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            (
            %a{:href => "#Lawvere94"}> Lawvere 94
            ,
            %a{:href => "#Lawvere07"} Lawvere 07
            ) (Earlier: “being and becoming” (
            %a{:href => "#Lawvere91"}> Lawvere 91
            )). Slightly paraphrased, cohesion means that the ambient
            %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            is equipped with an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            of (co-)
            %a.existingWikiWord{:href => "/nlab/show/modalities"} modalities
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∫
                  %mspace{:width => "thickmathspace"}
                  %mo ⊣
                  %mspace{:width => "thickmathspace"}
                  %mo ♭
                  %mspace{:width => "thickmathspace"}
                  %mo ⊣
                  %mspace{:width => "thickmathspace"}
                  %mo ♯
                %annotation{:encoding => "application/x-tex"}
                  \\int \;\dashv\; \flat \;\dashv\; \sharp
          %p
            called:
            %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊣
                %annotation{:encoding => "application/x-tex"} \dashv
            %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊣
                %annotation{:encoding => "application/x-tex"} \dashv
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
          %p
            This has an immediate extension to
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            (
            %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type+theory"}> cohesive homotopy type theory
            ). But there it has more dramatic consequences. In (
            %a{:href => "#BunkeNikolausVoelkl13"}> Bunke-Nikolaus-Völkl 13
            ) it was observed that on
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+types"} stable homotopy types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            cohesion implies that the canonical diagram formed from modality units and counits
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mo ∫
                            %mi dR
                          %mi Ω
                          %mi A
                        %mtd
                        %mtd
                          %mo ⟶
                        %mtd
                        %mtd
                          %msub
                            %mo ♭
                            %mi dR
                          %mi Σ
                          %mi A
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi θ
                                  %mi A
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo ♭
                          %msub
                            %mo ∫
                            %mi dR
                          %mi Ω
                          %mi A
                        %mtd
                        %mtd
