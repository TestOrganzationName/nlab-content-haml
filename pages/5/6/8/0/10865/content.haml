          %title Contents
          %blockquote
            %p
              In (
              %a{:href => "#Lawvere67"}> Lawvere 67
              ,
              = succeed "," do
                %a{:href => "#Lawvere86"} Lawvere 86
              = succeed ")" do
                %a{:href => "#Lawvere79"} Lawvere 97
              %em
                %a.existingWikiWord{:href => "/nlab/show/toposes+of+laws+of+motion"} toposes of laws of motion
              meant to formalize
              %a.existingWikiWord{:href => "/nlab/show/classical+mechanics"} classical
              %a.existingWikiWord{:href => "/nlab/show/continuum+mechanics"} continuum mechanics
              in
              = succeed "/in" do
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
              %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
              to
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos+theory"} higher topos theory
              and of the applications of the resulting formalism to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            %p
              This text originates in a
              %a{:href => "http://ncatlab.org/schreiber/show/differential+cohomology+in+a+cohesive+topos#TalkAt8thScottishCategorySeminar"} talk
              at the
              = succeed "." do
                %em
                  %a{:href => "http://homepages.inf.ed.ac.uk/als/SCT/sct131129.html"} Eighth Scottish Category Theory Seminar
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
              and
              %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
              and generally stick to a
              %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"} Lawverian
              perspective.
